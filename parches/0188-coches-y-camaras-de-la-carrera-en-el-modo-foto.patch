+    // The car step places from current in the race's order (the known positions first, then the rest in the game's
+    // order), round; from an empty place, the leader (or the last going back). -1 when there is none.
+    inline int stepPhotoModeCar(const std::vector<PhotoModeCar> &cars, int current, int step)
+    {
+        std::vector<int> order;
+        for (int i = 0; i < static_cast<int>(cars.size()); ++i)
+            if (cars[static_cast<size_t>(i)].valid)
+                order.push_back(i);
+        if (order.empty())
+            return -1;
+        std::stable_sort(order.begin(), order.end(), [&cars](int a, int b)
+                         {
+                             const int pa = cars[static_cast<size_t>(a)].position;
+                             const int pb = cars[static_cast<size_t>(b)].position;
+                             if ((pa < 0) != (pb < 0))
+                                 return pa >= 0;
+                             return pa >= 0 && pa < pb;
+                         });
+        const auto it = std::find(order.begin(), order.end(), current);
+        const int n = static_cast<int>(order.size());
+        if (it == order.end())
+            return step >= 0 ? order.front() : order.back();
+        const int rank = static_cast<int>(it - order.begin());
+        return order[static_cast<size_t>(((rank + step) % n + n) % n)];
+    }
+
+    // Foto y repeticion T5: the race's cameras in the photo mode: 0 to driving - 1 the game's driving cameras of the car
+    // (the ones triangle goes through in the race, in its order) and then, with tv, the TV camera (driving). The camera
+    // step places from current, round; from another of the game's cameras (the start's: -1, or out of range) the first
+    // (the last going back). -1 when there is none.
+    inline int stepPhotoModeCamera(int current, int driving, bool tv, int step)
+    {
+        const int total = std::max(driving, 0) + (tv ? 1 : 0);
+        if (total == 0)
+            return -1;
+        if (current < 0 || current >= total)
+            return step >= 0 ? 0 : total - 1;
+        return ((current + step) % total + total) % total;
+    }
