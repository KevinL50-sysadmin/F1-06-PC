diff --git a/ps2xRuntime/src/lib/ps2_ai_difficulty.h b/ps2xRuntime/src/lib/ps2_ai_difficulty.h
new file mode 100644
index 0000000..3688e4a
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_ai_difficulty.h
@@ -0,0 +1,91 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+// Fase 5 (T16, F1 06): a finer opponent AI level (opciones.ini dificultad_ia: 0 = the game's own three levels; 1 to
+// 100 = a level between them, where 0 is EASY, 50 MEDIUM and 100 HARD). The game keeps its own level (OPPONENT AI in
+// DIFFICULTY, game.aidifficulty: a byte of the profile per game mode, copied to the race setup *0x3FE588 + 0x11C);
+// the fine value only counts while the game's level is the nearest of the three to it, so a level changed somewhere
+// else (OVERALL DIFFICULTY, another profile) is never overridden by a stale value. The race reads the level in
+// func_1823C0 (offsets added to each AI driver's stats) and func_372E10 (constants of each AI car); src/f1_overrides.cpp
+// calls them as they are and then moves what they wrote to the blend of the two levels around the fine value.
+namespace ps2x
+{
+    constexpr int kAiDifficultyMax = 100;
+    constexpr int kAiDifficultyStep = 50; // fine units between two of the game's levels
+
+    // A value written by the game for each of its levels (0 EASY, 1 MEDIUM, 2 HARD) at an offset of its object.
+    struct AiDifficultyField
+    {
+        uint32_t offset;
+        float perLevel[3];
+    };
+
+    // func_1823C0: added to the AI driver's stats (the driver object, + 0x24 to + 0x38) for EASY and MEDIUM.
+    constexpr AiDifficultyField kAiDriverOffsets[] = {
+        {0x24u, {0.5f, 0.4f, 0.0f}},  {0x28u, {0.2f, 0.2f, 0.0f}},   {0x2Cu, {0.4f, 0.25f, 0.0f}},
+        {0x30u, {0.3f, 0.2f, 0.0f}},  {0x34u, {0.15f, 0.15f, 0.0f}}, {0x38u, {0.15f, 0.15f, 0.0f}},
+    };
+    // func_372E10: written to an AI car (the car object; + 0xD0 bit 0) for each level; the other values it writes are
+    // the same for the three.
+    constexpr AiDifficultyField kAiCarValues[] = {
+        {0x208u, {86.0f, 96.0f, 96.0f}},
+        {0x20Cu, {7.0f, 10.0f, 10.0f}},
+        {0x21Cu, {0.84f, 0.95f, 0.98f}},
+        {0x220u, {0.8f, 0.92f, 1.0f}},
+    };
+
+    // The game's level nearest to a fine value: 0-24 EASY (0), 25-74 MEDIUM (1), 75-100 HARD (2).
+    inline int aiDifficultyNearestLevel(int fine)
+    {
+        return (std::clamp(fine, 0, kAiDifficultyMax) + kAiDifficultyStep / 2) / kAiDifficultyStep;
+    }
+
+    // Where the race goes between the game's levels (0 = EASY, 1 = MEDIUM, 2 = HARD): fine / 50 when fine is 1..100
+    // and its nearest level is the game's; otherwise the game's level as it is. -1 for a level that is not one of the
+    // three (the game is left alone).
+    inline float aiDifficultyPosition(int fine, int gameLevel)
+    {
+        if (gameLevel < 0 || gameLevel > 2)
+            return -1.0f;
+        if (fine <= 0 || fine > kAiDifficultyMax || aiDifficultyNearestLevel(fine) != gameLevel)
+            return static_cast<float>(gameLevel);
+        return static_cast<float>(fine) / static_cast<float>(kAiDifficultyStep);
+    }
+
+    // A field's value at a position: exactly the game's at 0, 1 and 2, a straight line between them.
+    inline float aiDifficultyBlend(const AiDifficultyField &field, float position)
+    {
+        const float clamped = std::clamp(position, 0.0f, 2.0f);
+        const int low = std::min(static_cast<int>(std::floor(clamped)), 2);
+        const float fraction = clamped - static_cast<float>(low);
+        if (fraction <= 0.0f)
+            return field.perLevel[low];
+        return field.perLevel[low] + (field.perLevel[low + 1] - field.perLevel[low]) * fraction;
+    }
+
+    // The OPPONENT AI row of DIFFICULTY goes from 0 (EASY) to 100 (HARD) in steps of 10 (50 = MEDIUM). Its value for a
+    // fine value and the game's level: the fine value rounded to the step when it counts, otherwise the game's level.
+    inline int aiDifficultyRowValue(int fine, int gameLevel)
+    {
+        const float position = aiDifficultyPosition(fine, gameLevel);
+        if (position < 0.0f)
+            return 0;
+        return static_cast<int>(std::lround(position * kAiDifficultyStep / 10.0f)) * 10;
+    }
+
+    // What choosing a value of the row stores: the game's level (the nearest) and the fine value (0 for EASY, MEDIUM
+    // and HARD themselves: the game's own).
+    struct AiDifficultyChoice
+    {
+        int gameLevel;
+        int fine;
+    };
+    inline AiDifficultyChoice aiDifficultyChoice(int rowValue)
+    {
+        const int value = std::clamp(rowValue, 0, kAiDifficultyMax);
+        return {aiDifficultyNearestLevel(value), value % kAiDifficultyStep == 0 ? 0 : value};
+    }
+}
