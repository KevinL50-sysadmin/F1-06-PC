+    // T4 (user decision L14): PS2X_CAPTURA_LANZAMIENTOS=0 leaves out the vectored handler to measure its cost.
+    MiniTest::Case("CapturaLanzamientos", [](TestCase &tc)
+    {
+        tc.Run("on unless the variable is exactly 0", [](TestCase &t)
+        {
+            t.IsTrue(ps2x::fallo::capturaDeLanzamientosActiva(nullptr), "unset: on");
+            t.IsTrue(ps2x::fallo::capturaDeLanzamientosActiva(""), "empty: on");
+            t.IsTrue(ps2x::fallo::capturaDeLanzamientosActiva("1"), "1: on");
