@@ -7,6 +7,20 @@
 
 namespace ps2x::fallo
 {
+    bool capturaDeLanzamientosActiva(const char *valor)
+    {
+        if (valor == nullptr)
+            return true;
+        while (*valor == ' ')
+            ++valor;
+        if (*valor != '0')
+            return true;
+        ++valor;
+        while (*valor == ' ')
+            ++valor;
+        return *valor != 0;
+    }
+
