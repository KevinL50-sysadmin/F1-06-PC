+    bool guardarConsola()
+    {
+#if defined(_WIN32)
+        const HANDLE salida = GetStdHandle(STD_OUTPUT_HANDLE);
+        if (salida == nullptr || salida == INVALID_HANDLE_VALUE)
+            return false;
+        HANDLE copia = nullptr;
+        if (!DuplicateHandle(GetCurrentProcess(), salida, GetCurrentProcess(), &copia, 0, FALSE,
+                             DUPLICATE_SAME_ACCESS) ||
+            copia == nullptr)
+            return false;
+        // Una tuberia (RecompLauncher, o un programa que la lee) que nadie vacia no para el juego: sin espera, lo que
+        // no cabe se pierde (el registro lo tiene). Tras abrir el registro solo esta copia escribe en ella.
+        if (GetFileType(copia) == FILE_TYPE_PIPE)
+        {
+            DWORD modo = PIPE_READMODE_BYTE | PIPE_NOWAIT;
+            SetNamedPipeHandleState(copia, &modo, nullptr, nullptr);
+        }
+        if (const HANDLE antes = g_consola.exchange(copia))
+            CloseHandle(antes);
+        return true;
+#else
+        return false;
+#endif
+    }
+
+    void aLaConsola(const char *texto, size_t largo)
+    {
+#if defined(_WIN32)
+        const HANDLE consola = g_consola.load();
+        if (consola == nullptr || texto == nullptr)
+            return;
+        while (largo > 0u)
+        {
+            DWORD escritos = 0;
+            const DWORD pedazo = largo > 65536u ? 65536u : static_cast<DWORD>(largo);
+            if (!WriteFile(consola, texto, pedazo, &escritos, nullptr) || escritos == 0)
+                return; // sin lector (tuberia cerrada) o consola ya cerrada: el registro tiene lo mismo
+            texto += escritos;
+            largo -= escritos;
+        }
+#else
+        (void)texto, (void)largo;
+#endif
+    }
+
+    void aLaConsola(std::string_view texto)
+    {
+        aLaConsola(texto.data(), texto.size());
     }
 
