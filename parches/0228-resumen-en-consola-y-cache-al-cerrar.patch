+            escribir = nullptr;
+        }
+
+        ~ConsolaDePrueba()
+        {
+            ps2x::salida::reiniciarParaPruebas();
+            if (leer != nullptr)
+                CloseHandle(leer);
+        }
+
+        // What reached the pipe so far (without waiting).
+        std::string leido() const
+        {
+            std::string texto;
