+            resamplerPreroll(run, 2048u, frame);
+            run.run(1.0, 120.0, 30.0, frame);
+            t.Equals(run.resampler.dropped(), uint64_t{0}, "no input frame should be dropped");
+            t.Equals(run.resampler.overflows(), uint64_t{0}, "the overflow safety valve should not trigger");
+            t.IsTrue(run.maxDelta <= ResamplerRun::kSineDelta, "the output should have no discontinuity, max delta " +
+                                                                std::to_string(run.maxDelta));
+            t.IsTrue(std::abs(run.meanFill() - 4096.0) < 400.0,
+                     "the ring fill should settle near the raised target, mean " + std::to_string(run.meanFill()));
+            t.Equals(run.underruns, uint64_t{0}, "the device should never run dry");
+        });
