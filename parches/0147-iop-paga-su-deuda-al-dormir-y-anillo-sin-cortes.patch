+        tc.Run("SPU2 output consumer rebuffers to the target in silence, then fades in", [](TestCase &t)
+        {
+            using ps2x::iop::detail::Spu2OutputConsumer;
+            ConsumerRun run;
+            run.queued = 2048u;
+            t.Equals(run.pull(1024u), size_t{1024u}, "a ring at the target plays");
+            t.Equals(run.pull(1024u), size_t{1024u}, "until it is empty");
+            t.Equals(run.pull(1024u), size_t{0u}, "then it runs dry");
+            t.Equals(run.underruns, uint64_t{1}, "once");
+            const uint32_t target = run.target.load();
+            t.Equals(target, 2560u, "the target is now 53 ms");
+            run.queued = target - 1u;
+            const size_t before = run.left.size();
+            t.Equals(run.pull(1024u), size_t{0u}, "below the target the device keeps getting silence");
+            t.Equals(run.left[before + 1000u], int16_t{0}, "silence");
+            run.queued = target;
