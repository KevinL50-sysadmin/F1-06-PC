diff --git a/ps2xIOP/src/emulator/core/iop_spu2_output.h b/ps2xIOP/src/emulator/core/iop_spu2_output.h
new file mode 100644
index 0000000..0f28be2
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2_output.h
@@ -0,0 +1,128 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace ps2x::iop::detail
+{
+    // Device side of the host output ring (patch 0147). When the EE thread stalls longer than the ring holds, the
+    // device runs dry; it used to get whatever was left and zeros after it, a hard cut from full level to silence (the
+    // crackle heard from boot to the menu). Now the last frame played is held and faded out after the real frames (so
+    // a ring that runs dry exactly at a request boundary fades too), the device gets silence until the ring is back at
+    // the latency target, and playback resumes with a fade-in, so a stall is a short dip instead of a click. The target itself adapts: each underrun raises it (up to 128 ms) and 20 s of output without one lowers it
+    // slowly (never below the 43 ms of patch 0146); the producer's resampler steers the ring toward it.
+    // Single consumer: only the device thread touches this object; the target is written here and read by the producer.
+    class Spu2OutputConsumer
+    {
+    public:
+        static constexpr uint32_t MinTarget = 2048u;   // frames (43 ms; the device pulls 1024 at a time)
+        static constexpr uint32_t MaxTarget = 6144u;   // 128 ms
+        static constexpr uint32_t TargetRaise = 512u;  // per underrun
+        static constexpr uint32_t TargetLower = 256u;  // per LowerAfterFrames played without an underrun
+        static constexpr uint64_t LowerAfterFrames = 20u * 48000u;
+        static constexpr uint32_t FadeOutFrames = 128u;
+        static constexpr uint32_t FadeInFrames = 256u;
+
+        struct Result
+        {
+            size_t frames = 0;     // taken from the ring
+            size_t written = 0;    // written to `out` (those frames plus the fade-out tail); the caller zero-fills the rest
+            bool underrun = false; // the ring ran dry in this request (one per event, not per silent request)
+        };
+
+        // One device request of `frames` (interleaved stereo into `out`) with `available` frames in the ring;
+        // fetch(i) returns the packed frame i past the read position (left | right << 16).
+        template <typename Fetch>
+        Result read(int16_t *out, size_t frames, size_t available, std::atomic<uint32_t> &target, Fetch &&fetch)
+        {
+            Result result;
+            if (m_state == State::Rebuffering)
+            {
+                if (available < target.load(std::memory_order_relaxed))
+                {
+                    result.written = writeTail(out, frames);
+                    return result;
+                }
+                m_state = State::FadingIn;
+                m_fade = 0;
+                m_tail = 0;
+            }
+            const size_t count = std::min(frames, available);
+            for (size_t i = 0; i < count; ++i)
+            {
+                const uint32_t packed = fetch(i);
+                double gain = 1.0;
+                if (m_state == State::FadingIn)
+                {
+                    gain = static_cast<double>(m_fade) / FadeInFrames;
+                    if (++m_fade >= FadeInFrames)
+                        m_state = State::Playing;
+                }
+                m_lastLeft = scale(static_cast<int16_t>(packed & 0xFFFFu), gain);
+                m_lastRight = scale(static_cast<int16_t>(packed >> 16), gain);
+                out[i * 2u] = m_lastLeft;
+                out[i * 2u + 1u] = m_lastRight;
+            }
+            result.frames = count;
+            result.written = count;
+            if (count < frames)
+            {
+                result.underrun = true;
+                m_state = State::Rebuffering;
+                m_played = 0;
+                m_tail = FadeOutFrames;
+                result.written += writeTail(out + count * 2u, frames - count);
+                target.store(std::min(target.load(std::memory_order_relaxed) + TargetRaise, MaxTarget),
+                             std::memory_order_relaxed);
+                return result;
+            }
+            m_played += count;
+            if (m_played >= LowerAfterFrames)
+            {
+                m_played = 0;
+                const uint32_t current = target.load(std::memory_order_relaxed);
+                target.store(current > MinTarget + TargetLower ? current - TargetLower : MinTarget,
+                             std::memory_order_relaxed);
+            }
+            return result;
+        }
+
+    private:
+        enum class State : uint8_t
+        {
+            Rebuffering, // also the start: the device waits for the target before playing
+            FadingIn,
+            Playing,
+        };
+
+        [[nodiscard]] static int16_t scale(int16_t sample, double gain) noexcept
+        {
+            return gain >= 1.0 ? sample : static_cast<int16_t>(static_cast<double>(sample) * gain);
+        }
+
+        // The rest of the fade-out of the last frame played (it may span several requests); returns the frames written.
+        size_t writeTail(int16_t *out, size_t frames)
+        {
+            const size_t count = std::min<size_t>(frames, m_tail);
+            for (size_t i = 0; i < count; ++i)
+            {
+                const double gain = static_cast<double>(--m_tail) / FadeOutFrames;
+                out[i * 2u] = scale(m_lastLeft, gain);
+                out[i * 2u + 1u] = scale(m_lastRight, gain);
+            }
+            return count;
+        }
+
+        State m_state = State::Rebuffering;
+        uint32_t m_fade = 0;
+        uint32_t m_tail = 0;           // fade-out frames still to write
+        int16_t m_lastLeft = 0, m_lastRight = 0;
+        uint64_t m_played = 0; // frames taken from the ring since the last underrun or target change
+    };
+
+    // The host ring without the consumer above (no rebuffering or fades): the tests of the synthesis timing read it
+    // directly. Returns the frames written to `out`.
+    std::size_t readSpu2OutputRaw(int16_t *out, std::size_t frames) noexcept;
+}
