+        tc.Run("SPU2 output resampler overflow valve follows the latency target", [](TestCase &t)
+        {
+            using ps2x::iop::detail::Spu2OutputResampler;
+            Spu2OutputResampler resampler;
+            t.Equals(resampler.overflowFill(), size_t{2048u + 6144u}, "the valve sits 128 ms above the base target");
+            resampler.setTarget(4096.0);
+            t.Equals(resampler.overflowFill(), size_t{4096u + 6144u}, "and moves with a raised target");
+
+            ResamplerRun above; // 9000 frames trip the valve at the base target (see the gross overflow test)
+            above.resampler.setTarget(4096.0);
+            uint64_t frame = 0;
+            resamplerPreroll(above, 9000u, frame);
+            above.run(1.0, 60.0, 20.0, frame);
+            t.Equals(above.resampler.overflows(), uint64_t{0}, "9000 frames are under a raised target's valve");
+            t.Equals(above.resampler.dropped(), uint64_t{0}, "so nothing is skipped");
+
+            ResamplerRun gross;
+            gross.resampler.setTarget(4096.0);
+            frame = 0;
+            resamplerPreroll(gross, 11000u, frame);
+            gross.run(1.0, 60.0, 20.0, frame);
+            t.Equals(gross.resampler.overflows(), uint64_t{1}, "above the moved valve it triggers once");
+            t.IsTrue(std::abs(gross.meanFill() - 4096.0) < 400.0,
+                     "and skips back to the raised target, mean " + std::to_string(gross.meanFill()));
+            t.Equals(gross.underruns, uint64_t{0}, "the device should never run dry");
+        });
