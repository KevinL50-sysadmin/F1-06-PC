+    // Patch 0121: the lowest barycentric weight that still covers a pixel, for the edge (a, b) opposite vertex c. The GS
+    // fills with the top-left rule (PCSX2 GSRasterizer: columns [ceil(x left), ceil(x right)), rows [ceil(y top),
+    // ceil(y bottom))): a pixel exactly on a left or top edge is drawn, on a right or bottom edge it is not, so a pixel
+    // on an edge two triangles share is drawn once. All edges were inclusive (w >= -epsilon): translucent quads split
+    // in two blended their diagonal twice (a lighter line across the full-screen fades of the loading screens). The
+    // epsilon still absorbs the float error of w on either side. A/B mode 111: every edge inclusive, as before.
+    inline float edgeCoverageMin(float ax, float ay, float bx, float by, float cx, float cy)
+    {
+        constexpr float kEpsilon = 1.0e-4f;
+        if (g_ps2AbMode.load(std::memory_order_relaxed) == 111)
+            return -kEpsilon;
+        bool topLeft;
+        if (ay != by)
+            topLeft = cx > ax + (cy - ay) * (bx - ax) / (by - ay); // the inside is to the right: a left edge
+        else
+            topLeft = cy > ay; // horizontal with the inside below: a top edge
+        return topLeft ? -kEpsilon : kEpsilon;
+    }
