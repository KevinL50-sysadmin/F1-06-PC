+    // Vibracion del DualSense por HID (parche 0107): el DualSense no tiene XInput. Un hilo propio manda los motores
+    // solo cuando cambian (WriteFile puede tardar ~1 ms y la llamada viene del hilo del EE). USB: informe 0x02 de 48
+    // bytes; Bluetooth: informe 0x31 de 78 bytes con CRC32 (semilla 0xA2), como SDL (hidapi_ps5). Bits de efectos:
+    // 0x01 vibracion compatible, 0x02 sin hapticos de audio; motor derecho = agudo (pequeno), izquierdo = grave.
+    class DualSenseRumble
+    {
+    public:
+        void set(uint8_t agudo, uint8_t grave)
+        {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                if (!m_started)
+                {
+                    m_started = true;
+                    std::thread([this] { loop(); }).detach();
+                }
+                m_small = agudo;
+                m_large = grave;
+                m_pending = true;
+            }
+            m_cv.notify_one();
+        }
+
+    private:
+        static uint32_t crc32(uint32_t crc, const uint8_t *data, size_t size)
+        {
+            crc = ~crc;
+            for (size_t i = 0; i < size; ++i)
+            {
+                crc ^= data[i];
+                for (int k = 0; k < 8; ++k)
+                    crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+            }
+            return ~crc;
+        }
+
+        bool open()
+        {
+            GUID hidGuid;
+            HidD_GetHidGuid(&hidGuid);
+            HDEVINFO set = SetupDiGetClassDevsW(&hidGuid, nullptr, nullptr, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
+            if (set == INVALID_HANDLE_VALUE)
+                return false;
+            SP_DEVICE_INTERFACE_DATA iface{};
+            iface.cbSize = sizeof(iface);
+            for (DWORD index = 0;
+                 m_handle == INVALID_HANDLE_VALUE && SetupDiEnumDeviceInterfaces(set, nullptr, &hidGuid, index, &iface);
+                 ++index)
+            {
+                DWORD size = 0;
+                SetupDiGetDeviceInterfaceDetailW(set, &iface, nullptr, 0, &size, nullptr);
+                if (size == 0u)
+                    continue;
+                std::vector<uint8_t> buffer(size);
+                auto *detail = reinterpret_cast<SP_DEVICE_INTERFACE_DETAIL_DATA_W *>(buffer.data());
+                detail->cbSize = sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W);
+                if (!SetupDiGetDeviceInterfaceDetailW(set, &iface, detail, size, nullptr, nullptr))
+                    continue;
+                HANDLE handle = CreateFileW(detail->DevicePath, GENERIC_READ | GENERIC_WRITE,
+                                            FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, 0, nullptr);
+                if (handle == INVALID_HANDLE_VALUE)
+                    continue;
+                HIDD_ATTRIBUTES attributes{};
+                attributes.Size = sizeof(attributes);
+                PHIDP_PREPARSED_DATA preparsed = nullptr;
+                HIDP_CAPS caps{};
+                const bool dualSense = HidD_GetAttributes(handle, &attributes) && attributes.VendorID == 0x054C &&
+                                       (attributes.ProductID == 0x0CE6 || attributes.ProductID == 0x0DF2);
+                if (dualSense && HidD_GetPreparsedData(handle, &preparsed))
+                {
+                    HidP_GetCaps(preparsed, &caps);
+                    HidD_FreePreparsedData(preparsed);
+                }
+                if (dualSense && caps.OutputReportByteLength >= 48u)
+                {
+                    m_handle = handle;
+                    m_bluetooth = caps.OutputReportByteLength != 48u;
+                    std::fprintf(stderr, "[pad] DualSense por %s (HID %04x:%04x): vibracion por HID\n",
+                                 m_bluetooth ? "Bluetooth" : "USB", attributes.VendorID, attributes.ProductID);
+                }
+                else
+                    CloseHandle(handle);
+            }
+            SetupDiDestroyDeviceInfoList(set);
+            return m_handle != INVALID_HANDLE_VALUE;
+        }
+
+        bool send(uint8_t agudo, uint8_t grave)
+        {
+            uint8_t report[78] = {};
+            DWORD length = 48u;
+            uint8_t *effects = report + 1;
+            if (m_bluetooth)
+            {
+                report[0] = 0x31;
+                report[1] = 0x02;
+                effects = report + 2;
+                length = 78u;
+            }
+            else
+                report[0] = 0x02;
+            effects[0] = 0x01 | 0x02;
+            effects[2] = agudo;
+            effects[3] = grave;
+            if (m_bluetooth)
+            {
+                const uint8_t seed = 0xA2;
+                const uint32_t crc = crc32(crc32(0u, &seed, 1u), report, 74u);
+                std::memcpy(report + 74, &crc, sizeof(crc));
+            }
+            DWORD written = 0;
+            return WriteFile(m_handle, report, length, &written, nullptr) != FALSE;
+        }
+
+        void loop()
+        {
+            auto lastTry = std::chrono::steady_clock::now() - std::chrono::seconds(10);
+            for (;;)
+            {
+                uint8_t agudo = 0, grave = 0;
+                {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_cv.wait(lock, [this] { return m_pending; });
+                    m_pending = false;
+                    agudo = m_small;
+                    grave = m_large;
+                }
+                if (m_handle == INVALID_HANDLE_VALUE)
+                {
+                    // Se busca como mucho cada 5 s (se puede conectar con el juego en marcha).
+                    const auto now = std::chrono::steady_clock::now();
+                    if (now - lastTry < std::chrono::seconds(5))
+                        continue;
+                    lastTry = now;
+                    if (!open())
+                        continue;
+                    m_sentAgudo = m_sentGrave = 0xFFFFu;
+                }
+                if (agudo == m_sentAgudo && grave == m_sentGrave)
+                    continue;
+                if (send(agudo, grave))
+                {
+                    m_sentAgudo = agudo;
+                    m_sentGrave = grave;
+                }
+                else
+                {
+                    CloseHandle(m_handle); // desconectado
+                    m_handle = INVALID_HANDLE_VALUE;
+                }
+                std::this_thread::sleep_for(std::chrono::milliseconds(8)); // como mucho ~125 envios por segundo
+            }
+        }
+
+        std::mutex m_mutex;
+        std::condition_variable m_cv;
+        bool m_started = false, m_pending = false, m_bluetooth = false;
+        uint8_t m_small = 0, m_large = 0;
+        uint32_t m_sentAgudo = 0xFFFFu, m_sentGrave = 0xFFFFu;
+        HANDLE m_handle = INVALID_HANDLE_VALUE;
+    };
+
+    DualSenseRumble &dualSense()
+    {
+        static DualSenseRumble *s_instance = new DualSenseRumble(); // nunca se destruye: su hilo vive hasta el final
+        return *s_instance;
+    }
