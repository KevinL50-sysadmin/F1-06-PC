+++ b/ps2xRuntime/CMakeLists.txt
@@ -492,6 +492,31 @@ else()
     )
 endif()
 
+# F1 06: icon and file properties of the player's .exe (src/runner_resources.rc). The icon is made from the player's
+# game data by scripts/hacer-icono.ps1 and is not in the repository: without it the .exe keeps the default icon.
+if(WIN32 AND NOT PS2X_IS_ANDROID)
+    get_filename_component(PS2X_F1_PROJECT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../../.." ABSOLUTE)
+    set(PS2X_RUNNER_ICON "${PS2X_F1_PROJECT_DIR}/build/icono/F1-06.ico" CACHE FILEPATH
+        "Icon embedded in ps2EntryRunner (GLFW_ICON); ignored if the file does not exist")
+    set(PS2X_RUNNER_RC "${CMAKE_CURRENT_SOURCE_DIR}/src/runner_resources.rc")
+    target_sources(ps2EntryRunner PRIVATE "${PS2X_RUNNER_RC}")
+    set(PS2X_RUNNER_RC_DEFINES
+        PS2X_RUNNER_VERSION_MAJOR=${PS2Runtime_VERSION_MAJOR}
+        PS2X_RUNNER_VERSION_MINOR=${PS2Runtime_VERSION_MINOR}
+        PS2X_RUNNER_VERSION_PATCH=${PS2Runtime_VERSION_PATCH}
+        "PS2X_RUNNER_VERSION_STRING=\"${PS2Runtime_VERSION}\""
+    )
+    if(EXISTS "${PS2X_RUNNER_ICON}")
+        file(TO_CMAKE_PATH "${PS2X_RUNNER_ICON}" PS2X_RUNNER_ICON_PATH)
+        list(APPEND PS2X_RUNNER_RC_DEFINES "PS2X_RUNNER_ICON=\"${PS2X_RUNNER_ICON_PATH}\"")
+        set_source_files_properties("${PS2X_RUNNER_RC}" PROPERTIES OBJECT_DEPENDS "${PS2X_RUNNER_ICON_PATH}")
+        message(STATUS "ps2EntryRunner icon: ${PS2X_RUNNER_ICON_PATH}")
+    else()
+        message(STATUS "ps2EntryRunner icon: none (${PS2X_RUNNER_ICON} does not exist)")
+    endif()
+    set_source_files_properties("${PS2X_RUNNER_RC}" PROPERTIES COMPILE_DEFINITIONS "${PS2X_RUNNER_RC_DEFINES}")
+endif()
+
 if(PS2X_ENABLE_RUNNER_UNITY_BUILD)
     set_target_properties(ps2EntryRunner PROPERTIES
         UNITY_BUILD ON
