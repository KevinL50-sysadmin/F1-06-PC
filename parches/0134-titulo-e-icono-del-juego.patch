diff --git a/ps2xRuntime/src/runner_resources.rc b/ps2xRuntime/src/runner_resources.rc
new file mode 100644
index 0000000..45fe146
--- /dev/null
+++ b/ps2xRuntime/src/runner_resources.rc
@@ -0,0 +1,36 @@
+// F1 06: Windows resources of ps2EntryRunner (the player's F1-06.exe): the game's icon and the file properties.
+// PS2X_RUNNER_ICON (the .ico path) and PS2X_RUNNER_VERSION_* come from ps2xRuntime/CMakeLists.txt; without the icon
+// (scripts/hacer-icono.ps1 makes it from the player's game data) the .exe keeps the default Windows icon.
+#include <winver.h>
+
+#ifdef PS2X_RUNNER_ICON
+// GLFW loads the icon named GLFW_ICON for its window class: the window and the taskbar use it too.
+GLFW_ICON ICON PS2X_RUNNER_ICON
+#endif
+
+VS_VERSION_INFO VERSIONINFO
+FILEVERSION PS2X_RUNNER_VERSION_MAJOR, PS2X_RUNNER_VERSION_MINOR, PS2X_RUNNER_VERSION_PATCH, 0
+PRODUCTVERSION PS2X_RUNNER_VERSION_MAJOR, PS2X_RUNNER_VERSION_MINOR, PS2X_RUNNER_VERSION_PATCH, 0
+FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
+FILEFLAGS 0
+FILEOS VOS_NT_WINDOWS32
+FILETYPE VFT_APP
+FILESUBTYPE VFT2_UNKNOWN
+BEGIN
+    BLOCK "StringFileInfo"
+    BEGIN
+        BLOCK "040904B0"
+        BEGIN
+            VALUE "FileDescription", "Formula One 06"
+            VALUE "ProductName", "Formula One 06"
+            VALUE "FileVersion", PS2X_RUNNER_VERSION_STRING
+            VALUE "ProductVersion", PS2X_RUNNER_VERSION_STRING
+            VALUE "OriginalFilename", "F1-06.exe"
+            VALUE "InternalName", "F1-06"
+        END
+    END
+    BLOCK "VarFileInfo"
+    BEGIN
+        VALUE "Translation", 0x0409, 1200
+    END
+END
