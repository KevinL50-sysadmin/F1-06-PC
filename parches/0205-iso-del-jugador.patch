diff --git a/ps2xRuntime/include/ps2_disc_setup.h b/ps2xRuntime/include/ps2_disc_setup.h
new file mode 100644
index 0000000..059e532
--- /dev/null
+++ b/ps2xRuntime/include/ps2_disc_setup.h
@@ -0,0 +1,148 @@
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <functional>
+#include <ostream>
+#include <string>
+#include <vector>
+
+// Lanzamiento T1 (F1 06): the public package has no game data. The player's own disc (an .iso, or a folder with the
+// disc already extracted) is checked once and copied into a datos folder, which is what the game boots from. Ported
+// from scripts/iso_ps2.py (ISO 9660, read only): the same files empaquetar.ps1 -Iso extracts.
+namespace ps2x::disc
+{
+    // Formula One 06, PAL (SCES-53950): the BOOT2 file of its SYSTEM.CNF.
+    inline constexpr const char *kGameBootElf = "SCES_539.50";
+    inline constexpr const char *kGameCode = "SCES-53950";
+    inline constexpr const char *kDataFolderName = "datos";
+    // Written last into datos: the disc and every file with its size, so a later run can check datos cheaply.
+    inline constexpr const char *kMarkerName = "F1-06-disco.txt";
+    // Where an extraction is written before it becomes datos (never a half datos folder).
+    inline constexpr const char *kTempFolderName = "datos.extrayendo";
+    // A datos folder that was there but incomplete is renamed to this (with -2, -3... if taken), never deleted.
+    inline constexpr const char *kPreviousFolderName = "datos.anterior";
+
+    struct DiscFile
+    {
+        std::string path; // inside the disc, '/' separated, as named on the disc ("DATA2006/F12006.WAD")
+        uint32_t lsn = 0u; // ISO sector (0 for a folder source)
+        uint64_t size = 0u;
+    };
+
+    enum class DiscStatus
+    {
+        Valid,
+        Unreadable, // missing or cannot be opened
+        NotIso,     // no ISO 9660 volume descriptor (and not a disc folder)
+        NotPs2Disc, // no SYSTEM.CNF with a BOOT2 line
+        OtherGame,  // BOOT2 is another game
+        NotPal,     // VMODE is not PAL
+        Truncated   // the image (or folder) ends before its files do
+    };
+
+    struct DiscReport
+    {
+        DiscStatus status = DiscStatus::Unreadable;
+        bool folder = false;  // an extracted disc folder rather than an image
+        std::filesystem::path source; // the image, or the folder (a SYSTEM.CNF picked by hand gives its folder)
+        std::string volumeId;
+        std::string bootElf;   // BOOT2 file name ("SCES_539.50"), when there is one
+        std::string videoMode; // VMODE ("PAL"), when there is one
+        std::vector<DiscFile> files; // sorted by path
+        uint64_t totalBytes = 0u;
+        std::string fingerprint; // 16 hex digits: FNV-1a 64 of the volume id and the file list (no content hash)
+    };
+
+    // Reads only the volume descriptor, the directories and SYSTEM.CNF (a folder: its file list and SYSTEM.CNF).
+    DiscReport inspectDisc(const std::filesystem::path &source);
+
+    // The player's text for a report that is not Valid (UTF-8, Spanish or English).
+    std::string describeDiscProblem(const DiscReport &report, bool spanish);
+
+    enum class ExtractStatus
+    {
+        Done,
+        AlreadyThere, // datos is complete and from the same disc: nothing copied
+        Cancelled,
+        InvalidDisc,
+        NoSpace,
+        ReadFailed,
+        WriteFailed
+    };
+
+    struct ExtractResult
+    {
+        ExtractStatus status = ExtractStatus::InvalidDisc;
+        std::string detail; // for the log and the error message
+        std::filesystem::path dataDirectory;
+        std::filesystem::path previousData; // where an incomplete datos was moved, if any
+    };
+
+    // Called after every block with the bytes copied so far and the file being copied; false cancels.
+    using ExtractProgress = std::function<bool(uint64_t done, uint64_t total, const std::string &file)>;
+
+    // Copies every file of a Valid report into <parent>/datos.extrayendo, writes the marker and renames it to
+    // <parent>/datos (an existing incomplete datos is renamed to datos.anterior first). On failure or cancel nothing
+    // is left but what was there before. A complete datos from the same disc is kept (AlreadyThere).
+    ExtractResult extractDisc(const DiscReport &report, const std::filesystem::path &parent,
+                              const ExtractProgress &progress);
+
+    // The player's text for a failed or cancelled extraction (UTF-8).
+    std::string describeExtractProblem(const ExtractResult &result, bool spanish);
+
+    enum class DataState
+    {
+        Missing,    // no datos folder
+        Incomplete, // datos without a bootable SYSTEM.CNF, or with files of its marker missing or of another size
+        Complete    // bootable; with a marker, every file it lists is there with its size
+    };
+
+    // Cheap: SYSTEM.CNF, its BOOT2 file and (with a marker) one size check per listed file.
+    DataState checkDataFolder(const std::filesystem::path &dataDirectory);
+
+    // The fingerprint written in a datos marker (empty without one).
+    std::string dataFolderFingerprint(const std::filesystem::path &dataDirectory);
+
+    // Folders that may hold datos, in lookup order: the .exe's folder and, for an installed game (no portable.txt),
+    // <LocalAppData>/F1-06, used when the .exe's folder cannot be written (Program Files).
+    std::vector<std::filesystem::path> dataParents(const std::filesystem::path &exeDirectory,
+                                                   const std::filesystem::path &localAppDataDirectory);
+
+    // The first of dataParents() where a folder can be created (empty if none).
+    std::filesystem::path writableDataParent(const std::vector<std::filesystem::path> &parents);
+
+    // How the command line shows progress and errors: the console (null) or the Windows dialogs (--ventana).
+    struct DiscCommandUi
+    {
+        std::function<bool(uint64_t done, uint64_t total, const std::string &file)> progress;
+        std::function<void(const std::string &message)> error;
+    };
+
+    // F1-06.exe --extraer-iso <iso or folder> [--ventana] and --comprobar-iso <iso or folder>. Returns the exit code:
+    // 0 done (or already extracted / valid), 1 bad arguments, 2 not Formula One 06 PAL, 3 read, write or space
+    // failure, 4 cancelled. Returns -1 when args is not one of these commands.
+    int runDiscCommand(const std::vector<std::string> &args, const std::filesystem::path &exeDirectory,
+                       const std::filesystem::path &localAppDataDirectory, std::ostream &out,
+                       const DiscCommandUi *ui, bool spanish);
+
+    // Windows: the Spanish or English texts follow the Windows display language (the game's language is not known
+    // before it starts).
+    bool spanishUi();
+
+    enum class SetupOutcome
+    {
+        Ready,
+        Cancelled,
+        Failed
+    };
+
+    // The first run without datos: explains what is needed, offers an ISO found in the Downloads or Desktop folders
+    // (or next to the .exe), else the Open dialog (*.iso, or the SYSTEM.CNF of an extracted disc), checks the disc
+    // (retry or cancel), extracts it with a progress window that can cancel, and returns Ready when datos is there.
+    SetupOutcome runFirstRunSetup(const std::filesystem::path &exeDirectory,
+                                  const std::filesystem::path &localAppDataDirectory, std::ostream &log);
+
+    // The Windows dialogs for runDiscCommand(--ventana); null where there are none.
+    const DiscCommandUi *windowsDiscCommandUi();
+}
diff --git a/ps2xRuntime/src/lib/ps2_disc_setup.cpp b/ps2xRuntime/src/lib/ps2_disc_setup.cpp
new file mode 100644
index 0000000..7d5f4dc
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_disc_setup.cpp
@@ -0,0 +1,734 @@
+#include "ps2_disc_setup.h"
+#include "ps2_user_paths.h"
+#include "ps2x/iop/ps2_iso_image.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <optional>
+#include <sstream>
+#include <string_view>
+#include <system_error>
+#include <unordered_set>
+
+namespace ps2x::disc
+{
+    namespace
+    {
+        namespace fs = std::filesystem;
+
+        constexpr uint32_t kSector = 2048u;
+        constexpr uint32_t kPvdLsn = 16u;
+        constexpr size_t kCopyBlock = 4u << 20u;
+        // Room left on the drive besides the files (the marker, the file system).
+        constexpr uint64_t kSpareBytes = 64u << 20u;
+
+        bool equalsIgnoringCase(std::string_view left, std::string_view right)
+        {
+            return left.size() == right.size() &&
+                   std::equal(left.begin(), left.end(), right.begin(), [](unsigned char a, unsigned char b)
+                              { return std::toupper(a) == std::toupper(b); });
+        }
+
+        bool endsWithIgnoringCase(std::string_view text, std::string_view suffix)
+        {
+            return text.size() >= suffix.size() && equalsIgnoringCase(text.substr(text.size() - suffix.size()), suffix);
+        }
+
+        uint32_t readLe32(const uint8_t *bytes)
+        {
+            return static_cast<uint32_t>(bytes[0]) | (static_cast<uint32_t>(bytes[1]) << 8u) |
+                   (static_cast<uint32_t>(bytes[2]) << 16u) | (static_cast<uint32_t>(bytes[3]) << 24u);
+        }
+
+        std::string trim(std::string_view value)
+        {
+            while (!value.empty() && std::isspace(static_cast<unsigned char>(value.front())))
+                value.remove_prefix(1u);
+            while (!value.empty() && std::isspace(static_cast<unsigned char>(value.back())))
+                value.remove_suffix(1u);
+            return std::string(value);
+        }
+
+        // A "KEY = value" line of SYSTEM.CNF (key case ignored), or empty.
+        std::string systemCnfValue(std::string_view text, std::string_view key)
+        {
+            while (!text.empty())
+            {
+                const size_t end = text.find_first_of("\r\n");
+                const std::string_view line = text.substr(0u, end);
+                text.remove_prefix(end == std::string_view::npos ? text.size() : end + 1u);
+                const size_t equals = line.find('=');
+                if (equals != std::string_view::npos && equalsIgnoringCase(trim(line.substr(0u, equals)), key))
+                    return trim(line.substr(equals + 1u));
+            }
+            return {};
+        }
+
+        std::string fingerprintOf(const std::string &volumeId, const std::vector<DiscFile> &files)
+        {
+            uint64_t hash = 0xCBF29CE484222325ull;
+            const auto add = [&](std::string_view text)
+            {
+                for (const unsigned char ch : text)
+                {
+                    hash ^= ch;
+                    hash *= 0x100000001B3ull;
+                }
+            };
+            add("F1-06-disco\n");
+            add(volumeId);
+            add("\n");
+            for (const DiscFile &file : files)
+            {
+                add(file.path);
+                add("\t" + std::to_string(file.size) + "\t" + std::to_string(file.lsn) + "\n");
+            }
+            char text[17] = {};
+            std::snprintf(text, sizeof(text), "%016llx", static_cast<unsigned long long>(hash));
+            return text;
+        }
+
+        // SYSTEM.CNF checks shared by images and folders.
+        void checkSystemCnf(DiscReport &report, const std::optional<std::string> &cnf)
+        {
+            const std::optional<std::string> boot2 =
+                cnf ? ps2x::iop::parseSystemCnfBoot2(*cnf) : std::optional<std::string>{};
+            if (!boot2)
+            {
+                report.status = DiscStatus::NotPs2Disc;
+                return;
+            }
+            report.bootElf = ps2x::iop::bootElfName(*boot2);
+            report.videoMode = systemCnfValue(*cnf, "VMODE");
+            if (!equalsIgnoringCase(report.bootElf, kGameBootElf))
+                report.status = DiscStatus::OtherGame;
+            else if (!report.videoMode.empty() && !equalsIgnoringCase(report.videoMode, "PAL"))
+                report.status = DiscStatus::NotPal;
+            else
+                report.status = DiscStatus::Valid;
+        }
+
+        const DiscFile *findListed(const std::vector<DiscFile> &files, std::string_view path)
+        {
+            for (const DiscFile &file : files)
+                if (equalsIgnoringCase(file.path, path))
+                    return &file;
+            return nullptr;
+        }
+
+        void finishReport(DiscReport &report)
+        {
+            std::sort(report.files.begin(), report.files.end(),
+                      [](const DiscFile &a, const DiscFile &b) { return a.path < b.path; });
+            report.totalBytes = 0u;
+            for (const DiscFile &file : report.files)
+                report.totalBytes += file.size;
+            report.fingerprint = fingerprintOf(report.volumeId, report.files);
+        }
+
+        DiscReport inspectImage(const fs::path &path)
+        {
+            DiscReport report;
+            report.source = path;
+            std::error_code error;
+            const uint64_t imageSize = fs::file_size(path, error);
+            std::ifstream stream(path, std::ios::binary);
+            if (error || !stream)
+                return report; // Unreadable
+            const auto read = [&](uint64_t offset, uint8_t *destination, size_t size)
+            {
+                stream.clear();
+                stream.seekg(static_cast<std::streamoff>(offset), std::ios::beg);
+                stream.read(reinterpret_cast<char *>(destination), static_cast<std::streamsize>(size));
+                return static_cast<size_t>(stream.gcount()) == size;
+            };
+
+            std::vector<uint8_t> pvd(kSector);
+            if (!read(static_cast<uint64_t>(kPvdLsn) * kSector, pvd.data(), pvd.size()) || pvd[0] != 1u ||
+                std::memcmp(pvd.data() + 1u, "CD001", 5u) != 0)
+            {
+                report.status = DiscStatus::NotIso;
+                return report;
+            }
+            report.volumeId = trim(std::string_view(reinterpret_cast<const char *>(pvd.data() + 40u), 32u));
+
+            // The directory tree, as scripts/iso_ps2.py walks it (multi-extent files keep their first extent).
+            struct Pending
+            {
+                std::string prefix;
+                uint32_t lsn;
+                uint32_t size;
+            };
+            std::vector<Pending> pending{{std::string{}, readLe32(pvd.data() + 156u + 2u),
+                                          readLe32(pvd.data() + 156u + 10u)}};
+            std::unordered_set<uint32_t> visited;
+            std::unordered_set<std::string> seen;
+            while (!pending.empty())
+            {
+                const Pending directory = pending.back();
+                pending.pop_back();
+                if (!visited.insert(directory.lsn).second)
+                    continue;
+                const uint64_t sectors = (static_cast<uint64_t>(directory.size) + kSector - 1u) / kSector;
+                std::vector<uint8_t> bytes(static_cast<size_t>(sectors) * kSector);
+                if (sectors == 0u || sectors > 4096u ||
+                    !read(static_cast<uint64_t>(directory.lsn) * kSector, bytes.data(), bytes.size()))
+                {
+                    report.status = DiscStatus::Truncated;
+                    return report;
+                }
+                size_t offset = 0u;
+                while (offset < directory.size)
+                {
+                    const uint8_t length = bytes[offset];
+                    if (length == 0u)
+                    {
+                        offset = (offset / kSector + 1u) * kSector;
+                        continue;
+                    }
+                    if (length < 34u || offset + length > bytes.size())
+                    {
+                        report.status = DiscStatus::Truncated;
+                        return report;
+                    }
+                    const uint8_t *record = bytes.data() + offset;
+                    offset += length;
+                    const uint8_t nameLength = record[32];
+                    if (33u + nameLength > length)
+                    {
+                        report.status = DiscStatus::Truncated;
+                        return report;
+                    }
+                    if (nameLength == 1u && (record[33] == 0u || record[33] == 1u))
+                        continue;
+                    std::string name(reinterpret_cast<const char *>(record + 33u), nameLength);
+                    if (const size_t semicolon = name.rfind(';'); semicolon != std::string::npos)
+                        name.resize(semicolon);
+                    while (!name.empty() && name.back() == '.')
+                        name.pop_back();
+                    if (name.empty() || name == "." || name == ".." || name.find_first_of("/\\:") != std::string::npos)
+                        continue;
+                    const std::string path = directory.prefix + name;
+                    const uint32_t lsn = readLe32(record + 2u);
+                    const uint32_t size = readLe32(record + 10u);
+                    if (record[25] & 0x02u)
+                        pending.push_back({path + "/", lsn, size});
+                    else if (seen.insert(path).second)
+                        report.files.push_back({path, lsn, size});
+                }
+            }
+
+            for (const DiscFile &file : report.files)
+            {
+                if (static_cast<uint64_t>(file.lsn) * kSector + file.size > imageSize)
+                {
+                    report.status = DiscStatus::Truncated;
+                    return report;
+                }
+            }
+            std::optional<std::string> cnf;
+            if (const DiscFile *file = findListed(report.files, "SYSTEM.CNF"); file && file->size <= 64u * 1024u)
+            {
+                std::string text(static_cast<size_t>(file->size), '\0');
+                if (read(static_cast<uint64_t>(file->lsn) * kSector, reinterpret_cast<uint8_t *>(text.data()),
+                         text.size()))
+                    cnf = text;
+            }
+            checkSystemCnf(report, cnf);
+            if (report.status == DiscStatus::Valid && !findListed(report.files, report.bootElf))
+                report.status = DiscStatus::Truncated;
+            finishReport(report);
+            return report;
+        }
+
+        DiscReport inspectFolder(const fs::path &folder)
+        {
+            DiscReport report;
+            report.folder = true;
+            report.source = folder;
+            std::error_code error;
+            const std::optional<fs::path> cnfPath = ps2x::iop::findFileIgnoringCase(folder, "SYSTEM.CNF");
+            if (!cnfPath)
+            {
+                report.status = fs::is_directory(folder, error) ? DiscStatus::NotPs2Disc : DiscStatus::Unreadable;
+                return report;
+            }
+            // The disc files: not the cards, logs or marker an older package or this extractor left there.
+            for (fs::recursive_directory_iterator it(folder, fs::directory_options::skip_permission_denied, error), end;
+                 !error && it != end; it.increment(error))
+            {
+                std::error_code entryError;
+                const std::string name = it->path().filename().string();
+                if (it.depth() == 0 && it->is_directory(entryError) &&
+                    (equalsIgnoringCase(name, "mc0") || equalsIgnoringCase(name, "mc1")))
+                {
+                    it.disable_recursion_pending();
+                    continue;
+                }
+                if (!it->is_regular_file(entryError) || endsWithIgnoringCase(name, ".log") ||
+                    (it.depth() == 0 && equalsIgnoringCase(name, kMarkerName)))
+                    continue;
+                const uint64_t size = it->file_size(entryError);
+                if (entryError)
+                    continue;
+                report.files.push_back({it->path().lexically_relative(folder).generic_string(), 0u, size});
+            }
+            if (error)
+            {
+                report.status = DiscStatus::Unreadable;
+                return report;
+            }
+            std::ifstream stream(*cnfPath, std::ios::binary);
+            checkSystemCnf(report, std::string((std::istreambuf_iterator<char>(stream)), std::istreambuf_iterator<char>()));
+            if (report.status == DiscStatus::Valid && !findListed(report.files, report.bootElf))
+                report.status = DiscStatus::Truncated;
+            finishReport(report);
+            return report;
+        }
+
+        struct Marker
+        {
+            std::string fingerprint;
+            std::vector<DiscFile> files;
+        };
+
+        std::optional<Marker> readMarker(const fs::path &dataDirectory)
+        {
+            std::ifstream stream(dataDirectory / kMarkerName, std::ios::binary);
+            if (!stream)
+                return std::nullopt;
+            Marker marker;
+            std::string line;
+            while (std::getline(stream, line))
+            {
+                if (!line.empty() && line.back() == '\r')
+                    line.pop_back();
+                const size_t equals = line.find('=');
+                if (line.empty() || line[0] == '#' || equals == std::string::npos)
+                    continue;
+                const std::string key = trim(std::string_view(line).substr(0u, equals));
+                const std::string value = trim(std::string_view(line).substr(equals + 1u));
+                if (key == "huella")
+                    marker.fingerprint = value;
+                else if (key == "archivo")
+                {
+                    const size_t space = value.find(' ');
+                    if (space == std::string::npos)
+                        continue;
+                    DiscFile file;
+                    file.path = value.substr(space + 1u);
+                    try
+                    {
+                        file.size = std::stoull(value.substr(0u, space));
+                    }
+                    catch (const std::exception &)
+                    {
+                        continue;
+                    }
+                    marker.files.push_back(std::move(file));
+                }
+            }
+            return marker;
+        }
+
+        bool writeMarker(const fs::path &dataDirectory, const DiscReport &report)
+        {
+            std::ofstream out(dataDirectory / kMarkerName, std::ios::binary);
+            out << "# Formula One 06: archivos copiados de tu disco. El juego lo usa para comprobar que datos esta\r\n"
+                << "# completo; no lo cambies (sin el, datos se usa igual, pero sin esa comprobacion).\r\n"
+                << "disco = " << report.bootElf << "\r\n"
+                << "modo = " << report.videoMode << "\r\n"
+                << "volumen = " << report.volumeId << "\r\n"
+                << "origen = " << (report.folder ? "carpeta" : "iso") << "\r\n"
+                << "huella = " << report.fingerprint << "\r\n"
+                << "archivos = " << report.files.size() << "\r\n"
+                << "bytes = " << report.totalBytes << "\r\n";
+            for (const DiscFile &file : report.files)
+                out << "archivo = " << file.size << " " << file.path << "\r\n";
+            out.close();
+            return static_cast<bool>(out);
+        }
+
+        std::string gigabytes(uint64_t bytes)
+        {
+            char text[32] = {};
+            std::snprintf(text, sizeof(text), "%.1f", static_cast<double>(bytes) / (1024.0 * 1024.0 * 1024.0));
+            return text;
+        }
+
+        bool sameFolder(const fs::path &a, const fs::path &b)
+        {
+            std::error_code error;
+            return fs::exists(a, error) && fs::exists(b, error) && fs::equivalent(a, b, error);
+        }
+    }
+
+    DiscReport inspectDisc(const fs::path &source)
+    {
+        std::error_code error;
+        if (fs::is_directory(source, error))
+            return inspectFolder(source);
+        if (equalsIgnoringCase(source.filename().string(), "SYSTEM.CNF"))
+            return inspectFolder(source.parent_path());
+        return inspectImage(source);
+    }
+
+    std::string describeDiscProblem(const DiscReport &report, bool spanish)
+    {
+        const std::string name = pathForLog(report.source.filename().empty() ? report.source : report.source.filename());
+        const std::string wanted = std::string(kGameCode) + ", " + kGameBootElf;
+        switch (report.status)
+        {
+        case DiscStatus::Valid:
+            return {};
+        case DiscStatus::Unreadable:
+            return spanish ? "No se puede abrir " + pathForLog(report.source) + "."
+                           : "Cannot open " + pathForLog(report.source) + ".";
+        case DiscStatus::NotIso:
+            return spanish ? name + " no es una imagen de disco ISO (ISO 9660). Si tu copia está en otro formato "
+                                    "(.bin/.cue, .mdf, .nrg...), conviértela antes a .iso."
+                           : name + " is not an ISO disc image (ISO 9660). If your copy is in another format "
+                                    "(.bin/.cue, .mdf, .nrg...), convert it to .iso first.";
+        case DiscStatus::NotPs2Disc:
+            return spanish ? name + " no es un disco de PS2: no tiene un SYSTEM.CNF con la línea BOOT2."
+                           : name + " is not a PS2 disc: it has no SYSTEM.CNF with a BOOT2 line.";
+        case DiscStatus::OtherGame:
+            return spanish ? "Este disco es de otro juego (" + report.bootElf +
+                                 "). Hace falta Formula One 06 de PS2, versión europea PAL (" + wanted + ")."
+                           : "This disc is another game (" + report.bootElf +
+                                 "). Formula One 06 for PS2 is needed, European PAL version (" + wanted + ").";
+        case DiscStatus::NotPal:
+            return spanish ? "Este disco no es la versión PAL (VMODE = " + report.videoMode +
+                                 "). Hace falta Formula One 06 europeo PAL (" + wanted + ")."
+                           : "This disc is not the PAL version (VMODE = " + report.videoMode +
+                                 "). The European PAL Formula One 06 is needed (" + wanted + ").";
+        case DiscStatus::Truncated:
+            return spanish ? name + " está incompleto o dañado: se acaba antes que sus archivos. Vuelve a copiarlo "
+                                    "o a crearlo desde el disco."
+                           : name + " is incomplete or damaged: it ends before its files do. Copy it again or make "
+                                    "it again from the disc.";
+        }
+        return {};
+    }
+
+    ExtractResult extractDisc(const DiscReport &report, const fs::path &parent, const ExtractProgress &progress)
+    {
+        ExtractResult result;
+        const fs::path data = parent / kDataFolderName;
+        const fs::path temp = parent / kTempFolderName;
+        result.dataDirectory = data;
+        if (report.status != DiscStatus::Valid)
+        {
+            result.status = ExtractStatus::InvalidDisc;
+            result.detail = describeDiscProblem(report, true);
+            return result;
+        }
+        if (checkDataFolder(data) == DataState::Complete && dataFolderFingerprint(data) == report.fingerprint)
+        {
+            result.status = ExtractStatus::AlreadyThere;
+            return result;
+        }
+        if (report.folder && sameFolder(report.source, data))
+        {
+            result.status = checkDataFolder(data) == DataState::Complete ? ExtractStatus::AlreadyThere
+                                                                         : ExtractStatus::InvalidDisc;
+            result.detail = "la carpeta elegida es la propia carpeta datos";
+            return result;
+        }
+
+        std::error_code error;
+        const auto fail = [&](ExtractStatus status, std::string detail)
+        {
+            std::error_code ignored;
+            fs::remove_all(temp, ignored);
+            result.status = status;
+            result.detail = std::move(detail);
+            return result;
+        };
+        // A temporary folder of an extraction that never finished (the PC went off): only this code writes it.
+        fs::remove_all(temp, error);
+        if (error || !fs::create_directories(temp, error) || error)
+            return fail(ExtractStatus::WriteFailed, "no se puede crear " + pathForLog(temp) +
+                                                        (error ? ": " + error.message() : std::string{}));
+        const fs::space_info space = fs::space(parent, error);
+        if (!error && space.available < report.totalBytes + kSpareBytes)
+            return fail(ExtractStatus::NoSpace, gigabytes(report.totalBytes + kSpareBytes) + " GB / " +
+                                                    gigabytes(space.available) + " GB");
+
+        std::ifstream image;
+        if (!report.folder)
+        {
+            image.open(report.source, std::ios::binary);
+            if (!image)
+                return fail(ExtractStatus::ReadFailed, "no se puede abrir " + pathForLog(report.source));
+        }
+        std::vector<char> buffer(kCopyBlock);
+        uint64_t done = 0u;
+        for (const DiscFile &file : report.files)
+        {
+            const fs::path relative = fs::path(file.path);
+            const fs::path target = temp / relative;
+            fs::create_directories(target.parent_path(), error);
+            std::ofstream out(target, std::ios::binary);
+            if (error || !out)
+                return fail(ExtractStatus::WriteFailed, "no se puede crear " + pathForLog(target));
+            std::ifstream folderFile;
+            std::istream *in = &image;
+            if (report.folder)
+            {
+                folderFile.open(report.source / relative, std::ios::binary);
+                if (!folderFile)
+                    return fail(ExtractStatus::ReadFailed, "no se puede abrir " + pathForLog(report.source / relative));
+                in = &folderFile;
+            }
+            else
+            {
+                image.clear();
+                image.seekg(static_cast<std::streamoff>(static_cast<uint64_t>(file.lsn) * kSector), std::ios::beg);
+            }
+            uint64_t left = file.size;
+            while (left != 0u)
+            {
+                const size_t want = static_cast<size_t>(std::min<uint64_t>(left, buffer.size()));
+                in->read(buffer.data(), static_cast<std::streamsize>(want));
+                const size_t got = static_cast<size_t>(in->gcount());
+                if (got != want)
+                {
+                    out.close();
+                    return fail(ExtractStatus::ReadFailed, "el disco se acaba antes de tiempo en " + file.path);
+                }
+                out.write(buffer.data(), static_cast<std::streamsize>(got));
+                if (!out)
+                {
+                    out.close();
+                    return fail(ExtractStatus::WriteFailed, "no se puede escribir " + pathForLog(target));
+                }
+                left -= got;
+                done += got;
+                if (progress && !progress(done, report.totalBytes, file.path))
+                {
+                    out.close();
+                    return fail(ExtractStatus::Cancelled, {});
+                }
+            }
+            out.close();
+            if (!out)
+                return fail(ExtractStatus::WriteFailed, "no se puede escribir " + pathForLog(target));
+        }
+        image.close();
+        if (!writeMarker(temp, report))
+            return fail(ExtractStatus::WriteFailed, "no se puede escribir " + pathForLog(temp / kMarkerName));
+
+        // The old datos (incomplete, or another dump) is kept under a new name: it may hold something of the player's.
+        if (fs::exists(data, error))
+        {
+            fs::path previous = parent / kPreviousFolderName;
+            for (int number = 2; fs::exists(previous, error); ++number)
+                previous = parent / (std::string(kPreviousFolderName) + "-" + std::to_string(number));
+            fs::rename(data, previous, error);
+            if (error)
+                return fail(ExtractStatus::WriteFailed, "no se puede apartar " + pathForLog(data) + ": " + error.message());
+            result.previousData = previous;
+        }
+        fs::rename(temp, data, error);
+        if (error)
+        {
+            const std::string message = error.message();
+            if (!result.previousData.empty())
+            {
+                std::error_code ignored;
+                fs::rename(result.previousData, data, ignored);
+                result.previousData.clear();
+            }
+            return fail(ExtractStatus::WriteFailed, "no se puede renombrar " + pathForLog(temp) + ": " + message);
+        }
+        result.status = ExtractStatus::Done;
+        return result;
+    }
+
+    std::string describeExtractProblem(const ExtractResult &result, bool spanish)
+    {
+        switch (result.status)
+        {
+        case ExtractStatus::Done:
+        case ExtractStatus::AlreadyThere:
+            return {};
+        case ExtractStatus::Cancelled:
+            return spanish ? "Copia cancelada. No se ha guardado nada: el juego volverá a pedir el disco."
+                           : "Copy cancelled. Nothing was kept: the game will ask for the disc again.";
+        case ExtractStatus::InvalidDisc:
+            return result.detail;
+        case ExtractStatus::NoSpace:
+            return spanish ? "No hay espacio suficiente en el disco duro (necesario / libre: " + result.detail + ")."
+                           : "Not enough free disk space (needed / free: " + result.detail + ").";
+        case ExtractStatus::ReadFailed:
+            return spanish ? "No se pudo leer el disco: " + result.detail + ". No se ha guardado nada."
+                           : "The disc could not be read: " + result.detail + ". Nothing was kept.";
+        case ExtractStatus::WriteFailed:
+            return spanish ? "No se pudo escribir la carpeta datos: " + result.detail + ". No se ha guardado nada."
+                           : "The datos folder could not be written: " + result.detail + ". Nothing was kept.";
+        }
+        return {};
+    }
+
+    DataState checkDataFolder(const fs::path &dataDirectory)
+    {
+        std::error_code error;
+        if (!fs::is_directory(dataDirectory, error))
+            return DataState::Missing;
+        const std::optional<fs::path> cnfPath = ps2x::iop::findFileIgnoringCase(dataDirectory, "SYSTEM.CNF");
+        if (!cnfPath)
+            return DataState::Incomplete;
+        std::ifstream stream(*cnfPath, std::ios::binary);
+        const std::string text((std::istreambuf_iterator<char>(stream)), std::istreambuf_iterator<char>());
+        const std::optional<std::string> boot2 = ps2x::iop::parseSystemCnfBoot2(text);
+        if (!boot2 || !ps2x::iop::findFileIgnoringCase(dataDirectory, ps2x::iop::bootElfName(*boot2)))
+            return DataState::Incomplete;
+        const std::optional<Marker> marker = readMarker(dataDirectory);
+        if (!marker)
+            return DataState::Complete; // copied by hand or by an older package: boots as before
+        if (marker->files.empty())
+            return DataState::Incomplete;
+        for (const DiscFile &file : marker->files)
+        {
+            const uint64_t size = fs::file_size(dataDirectory / fs::path(file.path), error);
+            if (error || size != file.size)
+                return DataState::Incomplete;
+        }
+        return DataState::Complete;
+    }
+
+    std::string dataFolderFingerprint(const fs::path &dataDirectory)
+    {
+        const std::optional<Marker> marker = readMarker(dataDirectory);
+        return marker ? marker->fingerprint : std::string{};
+    }
+
+    std::vector<fs::path> dataParents(const fs::path &exeDirectory, const fs::path &localAppDataDirectory)
+    {
+        std::vector<fs::path> parents{exeDirectory};
+        std::error_code error;
+        if (!localAppDataDirectory.empty() && !fs::exists(exeDirectory / "portable.txt", error))
+            parents.push_back(localAppDataDirectory / "F1-06");
+        return parents;
+    }
+
+    fs::path writableDataParent(const std::vector<fs::path> &parents)
+    {
+        for (const fs::path &parent : parents)
+        {
+            std::error_code error;
+            fs::create_directories(parent, error);
+            const fs::path probe = parent / "datos.prueba-escritura";
+            if (!error && fs::create_directory(probe, error) && !error)
+            {
+                fs::remove(probe, error);
+                return parent;
+            }
+        }
+        return {};
+    }
+
+    int runDiscCommand(const std::vector<std::string> &args, const fs::path &exeDirectory,
+                       const fs::path &localAppDataDirectory, std::ostream &out, const DiscCommandUi *ui, bool spanish)
+    {
+        if (args.empty() || (args[0] != "--extraer-iso" && args[0] != "--comprobar-iso"))
+            return -1;
+        const bool extract = args[0] == "--extraer-iso";
+        bool window = false;
+        for (size_t i = 2u; i < args.size(); ++i)
+            window = window || args[i] == "--ventana";
+        if (args.size() < 2u || args[1].empty() || args[1].rfind("--", 0u) == 0u ||
+            std::any_of(args.begin() + 2, args.end(), [](const std::string &arg) { return arg != "--ventana"; }))
+        {
+            out << "[disco] uso: --extraer-iso <ruta.iso o carpeta del disco> [--ventana] | --comprobar-iso <ruta>"
+                << std::endl;
+            return 1;
+        }
+        const DiscCommandUi *dialogs = window ? ui : nullptr;
+        const auto error = [&](const std::string &message)
+        {
+            out << "[disco] " << message << std::endl;
+            if (dialogs && dialogs->error)
+                dialogs->error(message);
+        };
+
+        const DiscReport report = inspectDisc(fs::path(args[1]));
+        out << "[disco] " << pathForLog(report.source) << ": " << (report.folder ? "carpeta" : "imagen") << ", "
+            << report.files.size() << " archivos, " << report.totalBytes << " bytes, BOOT2 "
+            << (report.bootElf.empty() ? "-" : report.bootElf) << ", VMODE "
+            << (report.videoMode.empty() ? "-" : report.videoMode) << ", huella "
+            << (report.fingerprint.empty() ? "-" : report.fingerprint) << std::endl;
+        if (report.status != DiscStatus::Valid)
+        {
+            error(describeDiscProblem(report, spanish));
+            return 2;
+        }
+        if (!extract)
+        {
+            out << "[disco] valido: Formula One 06 PAL (" << kGameCode << ")" << std::endl;
+            return 0;
+        }
+
+        const std::vector<fs::path> parents = dataParents(exeDirectory, localAppDataDirectory);
+        for (const fs::path &parent : parents)
+        {
+            const fs::path data = parent / kDataFolderName;
+            if (checkDataFolder(data) == DataState::Complete && dataFolderFingerprint(data) == report.fingerprint)
+            {
+                out << "[disco] " << pathForLog(data) << " ya tiene este disco: no se copia otra vez" << std::endl;
+                return 0;
+            }
+        }
+        const fs::path parent = writableDataParent(parents);
+        if (parent.empty())
+        {
+            ExtractResult failed;
+            failed.status = ExtractStatus::WriteFailed;
+            failed.detail = "no se puede escribir en " + pathForLog(exeDirectory);
+            error(describeExtractProblem(failed, spanish));
+            return 3;
+        }
+        int lastTenth = -1;
+        const ExtractProgress console = [&](uint64_t done, uint64_t total, const std::string &file)
+        {
+            const int tenth = total == 0u ? 10 : static_cast<int>(done * 10u / total);
+            if (tenth != lastTenth)
+            {
+                lastTenth = tenth;
+                out << "[disco] " << tenth * 10 << " % (" << done / (1024u * 1024u) << " de " << total / (1024u * 1024u)
+                    << " MB) " << file << std::endl;
+            }
+            return !(dialogs && dialogs->progress) || dialogs->progress(done, total, file);
+        };
+        out << "[disco] copiando en " << pathForLog(parent / kDataFolderName) << " (pasa por "
+            << kTempFolderName << ")" << std::endl;
+        const ExtractResult result = extractDisc(report, parent, console);
+        if (!result.previousData.empty())
+            out << "[disco] la carpeta datos anterior (incompleta) queda en " << pathForLog(result.previousData)
+                << std::endl;
+        switch (result.status)
+        {
+        case ExtractStatus::Done:
+            out << "[disco] listo: " << report.files.size() << " archivos en " << pathForLog(result.dataDirectory)
+                << std::endl;
+            return 0;
+        case ExtractStatus::AlreadyThere:
+            out << "[disco] " << pathForLog(result.dataDirectory) << " ya tiene este disco" << std::endl;
+            return 0;
+        case ExtractStatus::Cancelled:
+            error(describeExtractProblem(result, spanish));
+            return 4;
+        case ExtractStatus::InvalidDisc:
+            error(describeExtractProblem(result, spanish));
+            return 2;
+        default:
+            error(describeExtractProblem(result, spanish));
+            return 3;
+        }
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_disc_setup_win.cpp b/ps2xRuntime/src/lib/ps2_disc_setup_win.cpp
new file mode 100644
index 0000000..99d7e9f
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_disc_setup_win.cpp
@@ -0,0 +1,371 @@
+#include "ps2_disc_setup.h"
+#include "ps2_user_paths.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cwctype>
+#include <optional>
+#include <string>
+#include <system_error>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <knownfolders.h>
+#include <shlobj.h>
+#include <shobjidl.h>
+#endif
+
+namespace ps2x::disc
+{
+#if defined(_WIN32)
+    namespace
+    {
+        namespace fs = std::filesystem;
+
+        // CLSID_ProgressDialog (shlguid.h), here so no import library is needed for it.
+        constexpr CLSID kProgressDialogClsid = {0xF8383852u, 0xFCD3u, 0x11D1u,
+                                                {0xA6u, 0xB9u, 0x00u, 0x60u, 0x97u, 0xDFu, 0x5Bu, 0xD4u}};
+        constexpr const wchar_t *kTitle = L"Formula One 06";
+        // Folders looked at for an ISO: their files and the files of their direct subfolders, up to these counts.
+        constexpr size_t kMaxSearchedFolders = 400u;
+        constexpr size_t kMaxInspectedImages = 24u;
+
+        std::wstring wide(const std::string &utf8)
+        {
+            if (utf8.empty())
+                return {};
+            const int length = MultiByteToWideChar(CP_UTF8, 0, utf8.data(), static_cast<int>(utf8.size()), nullptr, 0);
+            std::wstring text(static_cast<size_t>(std::max(length, 0)), L'\0');
+            if (length > 0)
+                MultiByteToWideChar(CP_UTF8, 0, utf8.data(), static_cast<int>(utf8.size()), text.data(), length);
+            return text;
+        }
+
+        // Once per process; a thread already initialised in another mode can still create the dialogs.
+        void comReady()
+        {
+            static const HRESULT result = CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED | COINIT_DISABLE_OLE1DDE);
+            (void)result;
+        }
+
+        int ask(const std::wstring &text, UINT flags)
+        {
+            return MessageBoxW(nullptr, text.c_str(), kTitle, flags | MB_SETFOREGROUND | MB_TOPMOST);
+        }
+
+        fs::path knownFolder(const KNOWNFOLDERID &id)
+        {
+            PWSTR raw = nullptr;
+            fs::path result;
+            if (SUCCEEDED(SHGetKnownFolderPath(id, KF_FLAG_DEFAULT, nullptr, &raw)) && raw != nullptr)
+                result = fs::path(raw);
+            CoTaskMemFree(raw);
+            return result;
+        }
+
+        bool isIso(const fs::path &path)
+        {
+            std::wstring extension = path.extension().wstring();
+            std::transform(extension.begin(), extension.end(), extension.begin(),
+                           [](wchar_t ch) { return static_cast<wchar_t>(std::towlower(ch)); });
+            return extension == L".iso";
+        }
+
+        // The first Formula One 06 PAL image in the folders (and their direct subfolders).
+        std::optional<DiscReport> findGameImage(const std::vector<fs::path> &folders, std::ostream &log)
+        {
+            std::vector<fs::path> images;
+            size_t searched = 0u;
+            for (const fs::path &folder : folders)
+            {
+                std::vector<fs::path> pending{folder};
+                for (size_t i = 0u; i < pending.size() && searched < kMaxSearchedFolders; ++i, ++searched)
+                {
+                    std::error_code error;
+                    for (fs::directory_iterator it(pending[i], fs::directory_options::skip_permission_denied, error), end;
+                         !error && it != end; it.increment(error))
+                    {
+                        std::error_code entryError;
+                        if (i == 0u && it->is_directory(entryError))
+                            pending.push_back(it->path());
+                        else if (it->is_regular_file(entryError) && isIso(it->path()))
+                            images.push_back(it->path());
+                    }
+                }
+            }
+            for (size_t i = 0u; i < images.size() && i < kMaxInspectedImages; ++i)
+            {
+                DiscReport report = inspectDisc(images[i]);
+                log << "[disco] buscado " << pathForLog(images[i]) << ": "
+                    << (report.status == DiscStatus::Valid ? "Formula One 06 PAL" : "no vale") << std::endl;
+                if (report.status == DiscStatus::Valid)
+                    return report;
+            }
+            return std::nullopt;
+        }
+
+        // The Open dialog: an .iso, or the SYSTEM.CNF of an extracted disc. Empty if closed.
+        fs::path pickDisc(bool spanish, const fs::path &startFolder)
+        {
+            comReady();
+            IFileOpenDialog *dialog = nullptr;
+            if (FAILED(CoCreateInstance(__uuidof(FileOpenDialog), nullptr, CLSCTX_INPROC_SERVER, IID_PPV_ARGS(&dialog))))
+                return {};
+            const COMDLG_FILTERSPEC types[] = {
+                {spanish ? L"Imagen de disco de PS2 (*.iso)" : L"PS2 disc image (*.iso)", L"*.iso"},
+                {spanish ? L"Disco ya extraído en una carpeta (SYSTEM.CNF)" : L"Disc already extracted to a folder (SYSTEM.CNF)",
+                 L"SYSTEM.CNF"}};
+            dialog->SetFileTypes(2u, types);
+            dialog->SetFileTypeIndex(1u);
+            dialog->SetTitle(spanish ? L"Elige tu copia de Formula One 06 (ISO)" : L"Choose your copy of Formula One 06 (ISO)");
+            DWORD options = 0u;
+            if (SUCCEEDED(dialog->GetOptions(&options)))
+                dialog->SetOptions(options | FOS_FORCEFILESYSTEM | FOS_FILEMUSTEXIST | FOS_PATHMUSTEXIST);
+            IShellItem *start = nullptr;
+            if (!startFolder.empty() &&
+                SUCCEEDED(SHCreateItemFromParsingName(startFolder.c_str(), nullptr, IID_PPV_ARGS(&start))))
+            {
+                dialog->SetFolder(start);
+                start->Release();
+            }
+            fs::path chosen;
+            if (SUCCEEDED(dialog->Show(nullptr)))
+            {
+                IShellItem *item = nullptr;
+                if (SUCCEEDED(dialog->GetResult(&item)))
+                {
+                    PWSTR raw = nullptr;
+                    if (SUCCEEDED(item->GetDisplayName(SIGDN_FILESYSPATH, &raw)) && raw != nullptr)
+                        chosen = fs::path(raw);
+                    CoTaskMemFree(raw);
+                    item->Release();
+                }
+            }
+            dialog->Release();
+            return chosen;
+        }
+
+        // The shell's progress window (its own thread draws it; Cancel is polled).
+        class ProgressWindow
+        {
+        public:
+            ~ProgressWindow() { close(); }
+
+            void open(bool spanish)
+            {
+                if (m_dialog)
+                    return;
+                comReady();
+                if (FAILED(CoCreateInstance(kProgressDialogClsid, nullptr, CLSCTX_INPROC_SERVER,
+                                            __uuidof(IProgressDialog), reinterpret_cast<void **>(&m_dialog))))
+                {
+                    m_dialog = nullptr;
+                    return;
+                }
+                m_dialog->SetTitle(kTitle);
+                m_dialog->SetLine(1u,
+                                  spanish ? L"Copiando tu disco (solo la primera vez)..."
+                                          : L"Copying your disc (first time only)...",
+                                  FALSE, nullptr);
+                m_dialog->SetCancelMsg(spanish ? L"Cancelando..." : L"Cancelling...", nullptr);
+                m_dialog->StartProgressDialog(nullptr, nullptr, PROGDLG_NORMAL | PROGDLG_AUTOTIME | PROGDLG_NOMINIMIZE,
+                                              nullptr);
+                // In front of the installer's wizard (which waits for this process) and of the console.
+                IOleWindow *window = nullptr;
+                if (SUCCEEDED(m_dialog->QueryInterface(IID_PPV_ARGS(&window))))
+                {
+                    HWND handle = nullptr;
+                    if (SUCCEEDED(window->GetWindow(&handle)) && handle != nullptr)
+                    {
+                        SetWindowPos(handle, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_SHOWWINDOW);
+                        SetForegroundWindow(handle);
+                    }
+                    window->Release();
+                }
+            }
+
+            // False once the player pressed Cancel.
+            bool update(uint64_t done, uint64_t total, const std::string &file)
+            {
+                if (!m_dialog)
+                    return true;
+                if (file != m_file)
+                {
+                    m_file = file;
+                    m_dialog->SetLine(2u, wide(file).c_str(), TRUE, nullptr);
+                }
+                m_dialog->SetProgress64(done, total == 0u ? 1u : total);
+                return !m_dialog->HasUserCancelled();
+            }
+
+            void close()
+            {
+                if (!m_dialog)
+                    return;
+                m_dialog->StopProgressDialog();
+                m_dialog->Release();
+                m_dialog = nullptr;
+                m_file.clear();
+            }
+
+        private:
+            IProgressDialog *m_dialog = nullptr;
+            std::string m_file;
+        };
+
+        ProgressWindow g_commandProgress;
+    }
+
+    bool spanishUi()
+    {
+        return PRIMARYLANGID(GetUserDefaultUILanguage()) == LANG_SPANISH;
+    }
+
+    SetupOutcome runFirstRunSetup(const fs::path &exeDirectory, const fs::path &localAppDataDirectory,
+                                  std::ostream &log)
+    {
+        const bool spanish = spanishUi();
+        comReady();
+        const std::vector<fs::path> parents = dataParents(exeDirectory, localAppDataDirectory);
+        bool incomplete = false;
+        for (const fs::path &parent : parents)
+            incomplete = incomplete || checkDataFolder(parent / kDataFolderName) == DataState::Incomplete;
+        log << "[disco] primer arranque: no hay datos" << (incomplete ? " completos" : "") << "; se pide el disco"
+            << std::endl;
+
+        const fs::path downloads = knownFolder(FOLDERID_Downloads);
+        std::optional<DiscReport> found = findGameImage({downloads, knownFolder(FOLDERID_Desktop), exeDirectory}, log);
+        const std::wstring needed =
+            spanish ? L"Para jugar hace falta tu copia de Formula One 06 de PS2 (versión europea PAL, SCES-53950).\n\n"
+                      L"Solo se lee una vez: sus archivos se copian en la carpeta datos (unos 4,2 GB) y después el juego "
+                      L"arranca directamente."
+                    : L"To play you need your copy of Formula One 06 for PS2 (European PAL version, SCES-53950).\n\n"
+                      L"It is read only once: its files are copied to the datos folder (about 4.2 GB) and from then on "
+                      L"the game starts directly.";
+        const std::wstring incompleteText = incomplete ? (spanish ? L"La carpeta datos está incompleta.\n\n"
+                                                                  : L"The datos folder is incomplete.\n\n")
+                                                       : L"";
+        bool introShown = false;
+        while (true)
+        {
+            fs::path chosen;
+            if (found)
+            {
+                const std::wstring text =
+                    incompleteText + needed + (spanish ? L"\n\nSe ha encontrado tu copia:\n\n" : L"\n\nYour copy was found:\n\n") +
+                    found->source.wstring() +
+                    (spanish ? L"\n\n¿Usarla?\nSí: usar esta.   No: elegir otra.   Cancelar: salir."
+                             : L"\n\nUse it?\nYes: use this one.   No: choose another.   Cancel: quit.");
+                introShown = true;
+                const int answer = ask(text, MB_YESNOCANCEL | MB_ICONQUESTION);
+                if (answer == IDCANCEL)
+                    return SetupOutcome::Cancelled;
+                if (answer == IDYES)
+                    chosen = found->source;
+                found.reset();
+            }
+            if (chosen.empty())
+            {
+                if (!introShown)
+                {
+                    introShown = true;
+                    const std::wstring text =
+                        incompleteText + needed +
+                        (spanish ? L"\n\nElige el archivo .iso de tu copia en la ventana siguiente. ¿Ya tienes el disco "
+                                   L"extraído en una carpeta? Elige su SYSTEM.CNF."
+                                 : L"\n\nChoose the .iso file of your copy in the next window. Already have the disc "
+                                   L"extracted to a folder? Choose its SYSTEM.CNF.");
+                    if (ask(text, MB_OKCANCEL | MB_ICONINFORMATION) != IDOK)
+                        return SetupOutcome::Cancelled;
+                }
+                chosen = pickDisc(spanish, downloads);
+                if (chosen.empty())
+                {
+                    log << "[disco] no se eligio ningun disco" << std::endl;
+                    return SetupOutcome::Cancelled;
+                }
+            }
+
+            const DiscReport report = inspectDisc(chosen);
+            log << "[disco] elegido " << pathForLog(chosen) << ": " << report.files.size() << " archivos, BOOT2 "
+                << (report.bootElf.empty() ? "-" : report.bootElf) << ", huella "
+                << (report.fingerprint.empty() ? "-" : report.fingerprint) << std::endl;
+            if (report.status != DiscStatus::Valid)
+            {
+                log << "[disco] no vale: " << describeDiscProblem(report, true) << std::endl;
+                if (ask(wide(describeDiscProblem(report, spanish)) +
+                            (spanish ? L"\n\n¿Elegir otro archivo?" : L"\n\nChoose another file?"),
+                        MB_RETRYCANCEL | MB_ICONWARNING) != IDRETRY)
+                    return SetupOutcome::Cancelled;
+                continue;
+            }
+
+            const fs::path parent = writableDataParent(parents);
+            if (parent.empty())
+            {
+                log << "[disco] no se puede escribir en " << pathForLog(exeDirectory) << std::endl;
+                ask(spanish ? L"No se puede escribir la carpeta datos junto al juego (" + exeDirectory.wstring() +
+                                  L"). Mueve el juego a una carpeta tuya o ábrelo como administrador una vez."
+                            : L"The datos folder cannot be written next to the game (" + exeDirectory.wstring() +
+                                  L"). Move the game to one of your folders or run it once as administrator.",
+                    MB_OK | MB_ICONERROR);
+                return SetupOutcome::Failed;
+            }
+            ProgressWindow window;
+            window.open(spanish);
+            const ExtractResult result = extractDisc(report, parent, [&](uint64_t done, uint64_t total, const std::string &file)
+                                                     { return window.update(done, total, file); });
+            window.close();
+            log << "[disco] copia en " << pathForLog(result.dataDirectory) << ": "
+                << (result.status == ExtractStatus::Done || result.status == ExtractStatus::AlreadyThere ? "lista"
+                                                                                                          : result.detail)
+                << std::endl;
+            if (!result.previousData.empty())
+                log << "[disco] la carpeta datos anterior queda en " << pathForLog(result.previousData) << std::endl;
+            if (result.status == ExtractStatus::Done || result.status == ExtractStatus::AlreadyThere)
+                return SetupOutcome::Ready;
+            if (ask(wide(describeExtractProblem(result, spanish)) +
+                        (spanish ? L"\n\n¿Probar otra vez?" : L"\n\nTry again?"),
+                    MB_RETRYCANCEL | (result.status == ExtractStatus::Cancelled ? MB_ICONINFORMATION : MB_ICONERROR)) !=
+                IDRETRY)
+                return result.status == ExtractStatus::Cancelled ? SetupOutcome::Cancelled : SetupOutcome::Failed;
+            found = report; // the same disc is offered again
+        }
+    }
+
+    const DiscCommandUi *windowsDiscCommandUi()
+    {
+        static const DiscCommandUi ui{
+            [](uint64_t done, uint64_t total, const std::string &file)
+            {
+                g_commandProgress.open(spanishUi());
+                const bool keepGoing = g_commandProgress.update(done, total, file);
+                if (done >= total || !keepGoing)
+                    g_commandProgress.close();
+                return keepGoing;
+            },
+            [](const std::string &message)
+            {
+                g_commandProgress.close();
+                ask(wide(message), MB_OK | MB_ICONWARNING);
+            }};
+        return &ui;
+    }
+#else
+    bool spanishUi() { return true; }
+
+    SetupOutcome runFirstRunSetup(const std::filesystem::path &, const std::filesystem::path &, std::ostream &log)
+    {
+        log << "[disco] no hay datos: usa --extraer-iso <ruta.iso>" << std::endl;
+        return SetupOutcome::Failed;
+    }
+
+    const DiscCommandUi *windowsDiscCommandUi() { return nullptr; }
+#endif
+}
