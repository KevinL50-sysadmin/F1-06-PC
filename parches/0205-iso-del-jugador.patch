@@ -0,0 +1,440 @@
+#include "MiniTest.h"
+#include "ps2_disc_setup.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace
+{
+    namespace fs = std::filesystem;
+    using ps2x::disc::DataState;
+    using ps2x::disc::DiscReport;
+    using ps2x::disc::DiscStatus;
+    using ps2x::disc::ExtractResult;
+    using ps2x::disc::ExtractStatus;
+
+    constexpr uint32_t kSector = 2048u;
+    // A tiny Formula One 06 disc: SYSTEM.CNF, the BOOT2 ELF and two files in nested folders.
+    constexpr uint32_t kRootLsn = 18u;
+    constexpr uint32_t kDataLsn = 19u;
+    constexpr uint32_t kSubLsn = 20u;
+    constexpr uint32_t kCnfLsn = 21u;
+    constexpr uint32_t kElfLsn = 22u; // 3000 bytes, two sectors
+    constexpr uint32_t kElfSize = 3000u;
+    constexpr uint32_t kBinLsn = 24u; // DATA/A.BIN, 5000 bytes over three sectors
+    constexpr uint32_t kBinSize = 5000u;
+    constexpr uint32_t kTxtLsn = 27u; // DATA/SUB/B.TXT
+    constexpr uint32_t kImageSectors = 28u;
+    const std::string kTxt = "hola disco";
+    const std::string kGameCnf = "BOOT2 = cdrom0:\\SCES_539.50;1\r\nVER = 1.01\r\nVMODE = PAL\r\n";
+
+    void putBoth32(std::vector<uint8_t> &image, size_t at, uint32_t value)
+    {
+        for (uint32_t i = 0u; i < 4u; ++i)
+        {
+            image[at + i] = static_cast<uint8_t>(value >> (i * 8u));
+            image[at + 4u + i] = static_cast<uint8_t>(value >> ((3u - i) * 8u));
+        }
+    }
+
+    size_t putRecord(std::vector<uint8_t> &image, size_t at, uint32_t lsn, uint32_t size, bool directory,
+                     const std::string &name)
+    {
+        const size_t length = (33u + name.size() + 1u) & ~size_t{1u};
+        image[at] = static_cast<uint8_t>(length);
+        putBoth32(image, at + 2u, lsn);
+        putBoth32(image, at + 10u, size);
+        image[at + 25u] = directory ? 2u : 0u;
+        image[at + 28u] = 1u;
+        image[at + 31u] = 1u;
+        image[at + 32u] = static_cast<uint8_t>(name.size());
+        std::memcpy(image.data() + at + 33u, name.data(), name.size());
+        return at + length;
+    }
+
+    std::vector<uint8_t> pattern(uint32_t size, uint32_t seed)
+    {
+        std::vector<uint8_t> bytes(size);
+        for (uint32_t i = 0u; i < size; ++i)
+            bytes[i] = static_cast<uint8_t>((i * 7u + seed + i / kSector) & 0xFFu);
+        return bytes;
+    }
+
+    // An ISO 9660 image of the disc; an empty cnf leaves SYSTEM.CNF out.
+    std::vector<uint8_t> buildDisc(const std::string &cnf)
+    {
+        std::vector<uint8_t> image(static_cast<size_t>(kImageSectors) * kSector, 0u);
+        const size_t pvd = 16u * kSector;
+        image[pvd] = 1u;
+        std::memcpy(image.data() + pvd + 1u, "CD001", 5u);
+        image[pvd + 6u] = 1u;
+        std::memcpy(image.data() + pvd + 40u, "FORMULAONE06                    ", 32u);
+        putBoth32(image, pvd + 80u, kImageSectors);
+        image[pvd + 128u] = 0x00u;
+        image[pvd + 129u] = 0x08u;
+        image[pvd + 130u] = 0x08u;
+        (void)putRecord(image, pvd + 156u, kRootLsn, kSector, true, std::string(1u, '\0'));
+        image[17u * kSector] = 255u;
+        std::memcpy(image.data() + 17u * kSector + 1u, "CD001", 5u);
+
+        size_t at = kRootLsn * kSector;
+        at = putRecord(image, at, kRootLsn, kSector, true, std::string(1u, '\0'));
+        at = putRecord(image, at, kRootLsn, kSector, true, std::string(1u, '\1'));
+        at = putRecord(image, at, kDataLsn, kSector, true, "DATA");
+        if (!cnf.empty())
+            at = putRecord(image, at, kCnfLsn, static_cast<uint32_t>(cnf.size()), false, "SYSTEM.CNF;1");
+        (void)putRecord(image, at, kElfLsn, kElfSize, false, "SCES_539.50;1");
+
+        at = kDataLsn * kSector;
+        at = putRecord(image, at, kDataLsn, kSector, true, std::string(1u, '\0'));
+        at = putRecord(image, at, kRootLsn, kSector, true, std::string(1u, '\1'));
+        at = putRecord(image, at, kBinLsn, kBinSize, false, "A.BIN;1");
+        (void)putRecord(image, at, kSubLsn, kSector, true, "SUB");
+
+        at = kSubLsn * kSector;
+        at = putRecord(image, at, kSubLsn, kSector, true, std::string(1u, '\0'));
+        at = putRecord(image, at, kDataLsn, kSector, true, std::string(1u, '\1'));
+        (void)putRecord(image, at, kTxtLsn, static_cast<uint32_t>(kTxt.size()), false, "B.TXT;1");
+
+        std::memcpy(image.data() + kCnfLsn * kSector, cnf.data(), cnf.size());
+        const std::vector<uint8_t> elf = pattern(kElfSize, 1u);
+        std::memcpy(image.data() + kElfLsn * kSector, elf.data(), elf.size());
+        const std::vector<uint8_t> bin = pattern(kBinSize, 2u);
+        std::memcpy(image.data() + kBinLsn * kSector, bin.data(), bin.size());
+        std::memcpy(image.data() + kTxtLsn * kSector, kTxt.data(), kTxt.size());
+        return image;
+    }
+
+    struct TempDir
+    {
+        fs::path path;
+
+        TempDir()
+        {
+            const auto stamp = std::chrono::steady_clock::now().time_since_epoch().count();
+            path = fs::temp_directory_path() / ("ps2x-disc-setup-" + std::to_string(stamp));
+            fs::create_directories(path);
+        }
+
+        ~TempDir()
+        {
+            std::error_code error;
+            fs::remove_all(path, error);
+        }
+    };
+
+    void writeBytes(const fs::path &path, const std::vector<uint8_t> &bytes)
+    {
+        fs::create_directories(path.parent_path());
+        std::ofstream out(path, std::ios::binary);
+        out.write(reinterpret_cast<const char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    }
+
+    void writeText(const fs::path &path, const std::string &text)
+    {
+        writeBytes(path, std::vector<uint8_t>(text.begin(), text.end()));
+    }
+
+    std::vector<uint8_t> readBytes(const fs::path &path)
+    {
+        std::ifstream in(path, std::ios::binary);
+        return std::vector<uint8_t>(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+    }
+
+    fs::path writeDisc(const TempDir &dir, const std::string &cnf, size_t keepBytes = 0u)
+    {
+        std::vector<uint8_t> image = buildDisc(cnf);
+        if (keepBytes != 0u)
+            image.resize(keepBytes);
+        const fs::path path = dir.path / "juego.iso";
+        writeBytes(path, image);
+        return path;
+    }
+
+    // Every file under a folder as "relative path:size", sorted.
+    std::vector<std::string> listTree(const fs::path &root)
+    {
+        std::vector<std::string> files;
+        for (const auto &entry : fs::recursive_directory_iterator(root))
+            if (entry.is_regular_file())
+                files.push_back(entry.path().lexically_relative(root).generic_string() + ":" +
+                                std::to_string(entry.file_size()));
+        std::sort(files.begin(), files.end());
+        return files;
+    }
+
+    bool contains(const std::string &text, const std::string &part) { return text.find(part) != std::string::npos; }
+}
+
+void register_ps2_disc_setup_tests()
+{
+    MiniTest::Case("PS2DiscSetup", [](TestCase &tc)
+                   {
+        tc.Run("a Formula One 06 PAL image is valid and lists every file", [](TestCase &t)
+        {
+            TempDir dir;
+            const DiscReport report = ps2x::disc::inspectDisc(writeDisc(dir, kGameCnf));
+            t.IsTrue(report.status == DiscStatus::Valid, "the disc is valid");
+            t.IsFalse(report.folder, "an image, not a folder");
+            t.Equals(report.bootElf, std::string("SCES_539.50"), "BOOT2 file name");
+            t.Equals(report.videoMode, std::string("PAL"), "VMODE");
+            t.Equals(report.volumeId, std::string("FORMULAONE06"), "volume id without padding");
+            t.Equals(report.files.size(), size_t{4u}, "four files");
+            if (report.files.size() == 4u)
+            {
+                t.Equals(report.files[0].path, std::string("DATA/A.BIN"), "sorted by path, ';1' removed");
+                t.Equals(report.files[0].size, uint64_t{kBinSize}, "A.BIN size");
+                t.Equals(report.files[0].lsn, kBinLsn, "A.BIN sector");
+                t.Equals(report.files[1].path, std::string("DATA/SUB/B.TXT"), "nested folder");
+                t.Equals(report.files[2].path, std::string("SCES_539.50"), "the ELF");
+                t.Equals(report.files[3].path, std::string("SYSTEM.CNF"), "SYSTEM.CNF");
+            }
+            t.Equals(report.totalBytes, uint64_t{kBinSize + kTxt.size() + kElfSize + kGameCnf.size()}, "total bytes");
+            t.Equals(report.fingerprint.size(), size_t{16u}, "16 hex digits");
+            t.Equals(ps2x::disc::inspectDisc(writeDisc(dir, kGameCnf)).fingerprint, report.fingerprint,
+                     "the same disc gives the same fingerprint");
+        });
+
+        tc.Run("another game's BOOT2 is refused with its code in the message", [](TestCase &t)
+        {
+            TempDir dir;
+            const DiscReport report =
+                ps2x::disc::inspectDisc(writeDisc(dir, "BOOT2 = cdrom0:\\SLES_123.45;1\r\nVMODE = PAL\r\n"));
+            t.IsTrue(report.status == DiscStatus::OtherGame, "other game");
+            t.Equals(report.bootElf, std::string("SLES_123.45"), "its BOOT2");
+            const std::string es = ps2x::disc::describeDiscProblem(report, true);
+            const std::string en = ps2x::disc::describeDiscProblem(report, false);
+            t.IsTrue(contains(es, "SLES_123.45") && contains(es, "SCES-53950"), "Spanish text names both: " + es);
+            t.IsTrue(contains(en, "SLES_123.45") && contains(en, "SCES-53950"), "English text names both: " + en);
+            t.IsFalse(es == en, "two languages");
+        });
+
+        tc.Run("NTSC, no SYSTEM.CNF, not an ISO and a missing file are each refused", [](TestCase &t)
+        {
+            TempDir dir;
+            t.IsTrue(ps2x::disc::inspectDisc(writeDisc(dir, "BOOT2 = cdrom0:\\SCES_539.50;1\r\nVMODE = NTSC\r\n"))
+                             .status == DiscStatus::NotPal,
+                     "NTSC");
+            t.IsTrue(ps2x::disc::inspectDisc(writeDisc(dir, "")).status == DiscStatus::NotPs2Disc, "no SYSTEM.CNF");
+            t.IsTrue(ps2x::disc::inspectDisc(writeDisc(dir, "VER = 1.00\r\n")).status == DiscStatus::NotPs2Disc,
+                     "no BOOT2");
+            const fs::path junk = dir.path / "otro.iso";
+            writeBytes(junk, std::vector<uint8_t>(40u * kSector, 0x5Au));
+            t.IsTrue(ps2x::disc::inspectDisc(junk).status == DiscStatus::NotIso, "not ISO 9660");
+            t.IsTrue(ps2x::disc::inspectDisc(dir.path / "no-existe.iso").status == DiscStatus::Unreadable, "missing");
+            for (const DiscStatus status : {DiscStatus::NotPal, DiscStatus::NotPs2Disc, DiscStatus::NotIso,
+                                            DiscStatus::Unreadable, DiscStatus::Truncated})
+            {
+                DiscReport report;
+                report.status = status;
+                t.IsFalse(ps2x::disc::describeDiscProblem(report, true).empty(), "every problem has a text");
+            }
+        });
+
+        tc.Run("a truncated image is refused before anything is written", [](TestCase &t)
+        {
+            TempDir dir;
+            const size_t cut = static_cast<size_t>(kBinLsn) * kSector + 1000u; // inside A.BIN
+            const DiscReport report = ps2x::disc::inspectDisc(writeDisc(dir, kGameCnf, cut));
+            t.IsTrue(report.status == DiscStatus::Truncated, "truncated");
+            const fs::path parent = dir.path / "juego";
+            fs::create_directories(parent);
+            const ExtractResult result = ps2x::disc::extractDisc(report, parent, nullptr);
+            t.IsTrue(result.status == ExtractStatus::InvalidDisc, "not extracted");
+            t.IsTrue(fs::is_empty(parent), "nothing written");
+        });
+
+        tc.Run("extraction goes through a temporary folder and leaves a complete datos with its marker", [](TestCase &t)
+        {
+            TempDir dir;
+            const DiscReport report = ps2x::disc::inspectDisc(writeDisc(dir, kGameCnf));
+            const fs::path parent = dir.path / "juego";
+            fs::create_directories(parent);
+            uint64_t lastDone = 0u, lastTotal = 0u;
+            bool sawTemp = false;
+            const ExtractResult result = ps2x::disc::extractDisc(
+                report, parent, [&](uint64_t done, uint64_t total, const std::string &)
+                {
+                    lastDone = done;
+                    lastTotal = total;
+                    sawTemp = sawTemp || (fs::exists(parent / "datos.extrayendo") && !fs::exists(parent / "datos"));
+                    return true; });
+            const fs::path data = parent / "datos";
+            t.IsTrue(result.status == ExtractStatus::Done, "done: " + result.detail);
+            t.Equals(result.dataDirectory, data, "datos next to the .exe");
+            t.IsTrue(sawTemp, "written into datos.extrayendo first");
+            t.Equals(lastDone, report.totalBytes, "progress reaches the total");
+            t.Equals(lastTotal, report.totalBytes, "progress total");
+            t.IsFalse(fs::exists(parent / "datos.extrayendo"), "no temporary folder left");
+            t.Equals(readBytes(data / "DATA" / "A.BIN"), pattern(kBinSize, 2u), "A.BIN bytes");
+            t.Equals(readBytes(data / "SCES_539.50"), pattern(kElfSize, 1u), "ELF bytes");
+            const std::vector<uint8_t> txt = readBytes(data / "DATA" / "SUB" / "B.TXT");
+            t.Equals(std::string(txt.begin(), txt.end()), kTxt, "B.TXT bytes");
+            t.IsTrue(fs::exists(data / "F1-06-disco.txt"), "marker");
+            t.Equals(listTree(data).size(), size_t{5u}, "the four files and the marker");
+            t.IsTrue(ps2x::disc::checkDataFolder(data) == DataState::Complete, "complete");
+            t.Equals(ps2x::disc::dataFolderFingerprint(data), report.fingerprint, "marker fingerprint");
+
+            const ExtractResult again = ps2x::disc::extractDisc(report, parent, nullptr);
+            t.IsTrue(again.status == ExtractStatus::AlreadyThere, "the same disc is not copied twice");
+        });
+
+        tc.Run("a cancelled extraction leaves nothing", [](TestCase &t)
+        {
+            TempDir dir;
+            const DiscReport report = ps2x::disc::inspectDisc(writeDisc(dir, kGameCnf));
+            const fs::path parent = dir.path / "juego";
+            fs::create_directories(parent);
+            const ExtractResult result =
+                ps2x::disc::extractDisc(report, parent, [](uint64_t, uint64_t, const std::string &) { return false; });
+            t.IsTrue(result.status == ExtractStatus::Cancelled, "cancelled");
+            t.IsTrue(fs::is_empty(parent), "no datos and no temporary folder");
+            t.IsFalse(ps2x::disc::describeExtractProblem(result, false).empty(), "a text for it");
+        });
+
+        tc.Run("an image that changes under the extraction fails and leaves nothing", [](TestCase &t)
+        {
+            TempDir dir;
+            const fs::path iso = writeDisc(dir, kGameCnf);
+            const DiscReport report = ps2x::disc::inspectDisc(iso);
+            std::vector<uint8_t> image = readBytes(iso);
+            image.resize(static_cast<size_t>(kBinLsn) * kSector + 100u);
+            writeBytes(iso, image);
+            const fs::path parent = dir.path / "juego";
+            fs::create_directories(parent);
+            const ExtractResult result = ps2x::disc::extractDisc(report, parent, nullptr);
+            t.IsTrue(result.status == ExtractStatus::ReadFailed, "read failure");
+            t.IsTrue(fs::is_empty(parent), "nothing left");
+            t.Equals(readBytes(iso).size(), image.size(), "the image is only read");
+        });
+
+        tc.Run("an incomplete datos is moved aside, not deleted, and a stale temporary folder is replaced", [](TestCase &t)
+        {
+            TempDir dir;
+            const DiscReport report = ps2x::disc::inspectDisc(writeDisc(dir, kGameCnf));
+            const fs::path parent = dir.path / "juego";
+            writeText(parent / "datos" / "mio.txt", "no borrar");
+            writeText(parent / "datos.extrayendo" / "SCES_539.50", "a half copy of an earlier run");
+            t.IsTrue(ps2x::disc::checkDataFolder(parent / "datos") == DataState::Incomplete, "no SYSTEM.CNF");
+            const ExtractResult result = ps2x::disc::extractDisc(report, parent, nullptr);
+            t.IsTrue(result.status == ExtractStatus::Done, "done: " + result.detail);
+            t.Equals(result.previousData, parent / "datos.anterior", "moved aside");
+            t.IsTrue(fs::exists(parent / "datos.anterior" / "mio.txt"), "the old files are kept");
+            t.IsFalse(fs::exists(parent / "datos.extrayendo"), "stale temporary folder gone");
+            t.Equals(readBytes(parent / "datos" / "SCES_539.50"), pattern(kElfSize, 1u), "fresh ELF");
+        });
+
+        tc.Run("datos state: missing, legacy without marker, and a marker file gone or resized", [](TestCase &t)
+        {
+            TempDir dir;
+            t.IsTrue(ps2x::disc::checkDataFolder(dir.path / "datos") == DataState::Missing, "missing");
+            writeText(dir.path / "antiguo" / "datos" / "SYSTEM.CNF", kGameCnf);
+            writeText(dir.path / "antiguo" / "datos" / "sces_539.50", "elf");
+            t.IsTrue(ps2x::disc::checkDataFolder(dir.path / "antiguo" / "datos") == DataState::Complete,
+                     "a datos copied by hand still boots");
+            t.IsTrue(ps2x::disc::dataFolderFingerprint(dir.path / "antiguo" / "datos").empty(), "no marker");
+
+            const DiscReport report = ps2x::disc::inspectDisc(writeDisc(dir, kGameCnf));
+            const fs::path parent = dir.path / "juego";
+            fs::create_directories(parent);
+            (void)ps2x::disc::extractDisc(report, parent, nullptr);
+            writeText(parent / "datos" / "DATA" / "SUB" / "B.TXT", "x");
+            t.IsTrue(ps2x::disc::checkDataFolder(parent / "datos") == DataState::Incomplete, "resized file");
+            fs::remove(parent / "datos" / "DATA" / "SUB" / "B.TXT");
+            t.IsTrue(ps2x::disc::checkDataFolder(parent / "datos") == DataState::Incomplete, "missing file");
+        });
+
+        tc.Run("an extracted disc folder is accepted and copied without cards or logs", [](TestCase &t)
+        {
+            TempDir dir;
+            const fs::path disc = dir.path / "disco";
+            writeText(disc / "SYSTEM.CNF", kGameCnf);
+            writeBytes(disc / "SCES_539.50", pattern(kElfSize, 1u));
+            writeBytes(disc / "DATA" / "A.BIN", pattern(kBinSize, 2u));
+            writeText(disc / "mc0" / "tarjeta.bin", "card");
+            writeText(disc / "juego.log", "log");
+            const DiscReport report = ps2x::disc::inspectDisc(disc / "SYSTEM.CNF");
+            t.IsTrue(report.status == DiscStatus::Valid, "valid folder");
+            t.IsTrue(report.folder, "a folder");
+            t.Equals(report.source, disc, "SYSTEM.CNF gives its folder");
+            t.Equals(report.files.size(), size_t{3u}, "no mc0 or .log");
+            const fs::path parent = dir.path / "juego";
+            fs::create_directories(parent);
+            const ExtractResult result = ps2x::disc::extractDisc(report, parent, nullptr);
+            t.IsTrue(result.status == ExtractStatus::Done, "done: " + result.detail);
+            t.Equals(listTree(parent / "datos"),
+                     std::vector<std::string>{"DATA/A.BIN:5000", "F1-06-disco.txt:" +
+                                                  std::to_string(fs::file_size(parent / "datos" / "F1-06-disco.txt")),
+                                              "SCES_539.50:3000", "SYSTEM.CNF:" + std::to_string(kGameCnf.size())},
+                     "the same files");
+            t.IsTrue(ps2x::disc::inspectDisc(parent / "datos").status == DiscStatus::Valid,
+                     "the target can be inspected");
+            const ExtractResult self = ps2x::disc::extractDisc(ps2x::disc::inspectDisc(parent / "datos"), parent, nullptr);
+            t.IsTrue(self.status == ExtractStatus::AlreadyThere || self.status == ExtractStatus::InvalidDisc,
+                     "datos is never copied onto itself");
+            t.IsTrue(ps2x::disc::checkDataFolder(parent / "datos") == DataState::Complete, "still complete");
+        });
+
+        tc.Run("data parents: the .exe folder, and LocalAppData only when installed", [](TestCase &t)
+        {
+            TempDir dir;
+            const fs::path exe = dir.path / "F1-06";
+            const fs::path local = dir.path / "local";
+            fs::create_directories(exe);
+            t.Equals(ps2x::disc::dataParents(exe, local), std::vector<fs::path>{exe, local / "F1-06"}, "installed");
+            t.Equals(ps2x::disc::dataParents(exe, {}), std::vector<fs::path>{exe}, "no LocalAppData");
+            writeText(exe / "portable.txt", "x");
+            t.Equals(ps2x::disc::dataParents(exe, local), std::vector<fs::path>{exe}, "portable");
+            t.Equals(ps2x::disc::writableDataParent({exe}), exe, "writable");
+            t.IsFalse(fs::exists(exe / "datos.extrayendo"), "no probe left");
+        });
+
+        tc.Run("command line: --comprobar-iso and --extraer-iso exit codes", [](TestCase &t)
+        {
+            TempDir dir;
+            const fs::path iso = writeDisc(dir, kGameCnf);
+            const fs::path exe = dir.path / "F1-06";
+            fs::create_directories(exe);
+            writeText(exe / "portable.txt", "x");
+            std::ostringstream out;
+            const auto run = [&](std::vector<std::string> args)
+            { return ps2x::disc::runDiscCommand(args, exe, {}, out, nullptr, true); };
+
+            t.Equals(run({"--anfitrion"}), -1, "not a disc command");
+            t.Equals(run({"--extraer-iso"}), 1, "missing path");
+            t.Equals(run({"--comprobar-iso", iso.string()}), 0, "valid");
+            t.IsFalse(fs::exists(exe / "datos"), "checking writes nothing");
+            const fs::path other = dir.path / "otro.iso";
+            {
+                const std::vector<uint8_t> image = buildDisc("BOOT2 = cdrom0:\\SLES_123.45;1\r\n");
+                writeBytes(other, image);
+            }
+            out.str("");
+            t.Equals(run({"--extraer-iso", other.string()}), 2, "another game");
+            t.IsTrue(contains(out.str(), "SLES_123.45"), "says which: " + out.str());
+            t.IsFalse(fs::exists(exe / "datos"), "nothing extracted");
+            t.Equals(run({"--extraer-iso", iso.string()}), 0, "extracted");
+            t.IsTrue(ps2x::disc::checkDataFolder(exe / "datos") == DataState::Complete, "complete datos");
+            out.str("");
+            t.Equals(run({"--extraer-iso", iso.string()}), 0, "already there");
+            t.IsTrue(contains(out.str(), "ya"), "says so: " + out.str());
+
+            const ps2x::disc::DiscCommandUi cancel{[](uint64_t, uint64_t, const std::string &) { return false; },
+                                                   [](const std::string &) {}};
+            const fs::path exe2 = dir.path / "F1-06b";
+            fs::create_directories(exe2);
+            writeText(exe2 / "portable.txt", "x");
+            t.Equals(ps2x::disc::runDiscCommand({"--extraer-iso", iso.string(), "--ventana"}, exe2, {}, out, &cancel,
+                                                false),
+                     4, "cancelled");
+            t.IsFalse(fs::exists(exe2 / "datos"), "nothing left after cancel");
+        });
+    });
+}
