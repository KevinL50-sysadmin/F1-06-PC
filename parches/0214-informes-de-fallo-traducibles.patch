+        thread_local const char *t_tipo = nullptr; // su nombre decorado (datos RTTI del modulo: no caducan)
+        TablaModulos g_tablaFallo; // la del vigilante es de su hilo
+        volatile LONG g_informando = 0;
+
+        // El tipo lanzado es EeDispatcherTransfer (el "longjmp" del planificador, ee_scheduler.h: no es un error y
+        // se lanza muchas veces por segundo). ThrowInfo de x64: RVAs desde la base de la imagen; el primer tipo de su
+        // CatchableTypeArray es el exacto, con el nombre decorado tras dos punteros (".?AUEeDispatcherTransfer@@").
+        // Tambien da ese nombre (nullptr si no se pudo leer).
+        bool esTransferencia(ULONG_PTR throwInfo, ULONG_PTR imagen, const char *&nombre)
+        {
+            nombre = nullptr;
+            if (throwInfo == 0u || imagen == 0u)
+                return false;
+            __try
+            {
+                const auto *info = reinterpret_cast<const int32_t *>(throwInfo);
+                const auto *tipos = reinterpret_cast<const int32_t *>(imagen + static_cast<uint32_t>(info[3]));
+                if (tipos[0] < 1)
+                    return false;
+                const auto *tipo = reinterpret_cast<const int32_t *>(imagen + static_cast<uint32_t>(tipos[1]));
+                nombre = reinterpret_cast<const char *>(imagen + static_cast<uint32_t>(tipo[1])) + 16;
+                return std::strstr(nombre, "EeDispatcherTransfer") != nullptr;
+            }
+            __except (EXCEPTION_EXECUTE_HANDLER)
+            {
+                nombre = nullptr;
+                return false;
+            }
+        }
+
+        // Primera oportunidad de cada excepcion del proceso: solo los throw de C++ (0xE06D7363) guardan la pila en el
+        // hilo. Un "throw;" (p. ej. el catch (...) de EeScheduler::run) sale primero sin ThrowInfo y el runtime de
+        // C++ (VCRUNTIME140_1) lo vuelve a lanzar con el mismo objeto: esa no cuenta, se queda la pila del throw
+        // original. Nunca maneja nada.
+        LONG CALLBACK capturarLanzamiento(EXCEPTION_POINTERS *info)
+        {
+            const EXCEPTION_RECORD *r = info->ExceptionRecord;
+            if (r->ExceptionCode != 0xE06D7363u || r->NumberParameters < 4u)
+                return EXCEPTION_CONTINUE_SEARCH;
+            const ULONG_PTR magia = r->ExceptionInformation[0];
+            if (magia != 0x19930520u && magia != 0x19930521u && magia != 0x19930522u)
+                return EXCEPTION_CONTINUE_SEARCH;
+            if (r->ExceptionInformation[2] == 0u)
+            {
+                t_relanzando = true;
+                return EXCEPTION_CONTINUE_SEARCH;
+            }
+            const bool relanzada = t_relanzando && r->ExceptionInformation[1] == t_objeto;
+            t_relanzando = false;
+            const char *tipo = nullptr;
+            if (relanzada || esTransferencia(r->ExceptionInformation[2], r->ExceptionInformation[3], tipo))
+                return EXCEPTION_CONTINUE_SEARCH;
+            t_numLanzamiento = RtlCaptureStackBackTrace(1, kMaxLanzamiento, t_lanzamiento, nullptr);
+            t_objeto = r->ExceptionInformation[1];
+            t_tipo = tipo;
+            return EXCEPTION_CONTINUE_SEARCH;
+        }
+
+        EstadoEe leerEe()
+        {
+            const LectorEe lector = g_lectorEe.load(std::memory_order_acquire);
+            EstadoEe ee{};
+            if (lector == nullptr)
+                return ee;
+            __try
+            {
+                ee = lector(g_datoEe.load(std::memory_order_relaxed));
+            }
+            __except (EXCEPTION_EXECUTE_HANDLER)
+            {
+                ee = EstadoEe{};
+            }
+            return ee;
+        }
+
+        HANDLE salidaDeErrores()
+        {
+            HANDLE salida = reinterpret_cast<HANDLE>(_get_osfhandle(2));
+            if (salida == INVALID_HANDLE_VALUE || salida == nullptr)
+                salida = GetStdHandle(STD_ERROR_HANDLE);
+            return salida;
+        }
+
+        void escribirPila(HANDLE salida, const char *prefijo, const char *titulo, void *const *marcos, int n)
+        {
+            Linea l(salida);
+            l.texto(prefijo).texto(titulo != nullptr ? titulo : "pila").texto(" (").decimal(n > 0 ? n : 0)
+                .texto(" marcos):").escribir();
+            char bufer[600];
+            for (int i = 0; i < n; ++i)
+            {
+                const uint64_t direccion = reinterpret_cast<uint64_t>(marcos[i]);
+                const Modulo *m = ps2x::vigilante::moduloDe(g_tablaFallo, direccion);
+                lineaMarco(bufer, sizeof(bufer), prefijo, i, m != nullptr ? m->nombre : nullptr,
+                           m != nullptr ? direccion - m->base : 0u, direccion);
+                l.texto(bufer).escribir();
+            }
+        }
+
+        // Desarrollo (PDB junto al .exe): las mismas pilas con nombres, despues de "fin del informe".
+        void escribirNombres(HANDLE salida, const char *prefijo, void *const *marcos, int n, void *const *marcos2,
+                             int n2)
+        {
+            const ps2x::vigilante::Dbghelp *d = ps2x::vigilante::dbghelp();
+            if (d == nullptr)
+                return;
+            wchar_t carpeta[MAX_PATH] = {};
+            GetModuleFileNameW(nullptr, carpeta, MAX_PATH);
+            if (wchar_t *barra = wcsrchr(carpeta, L'\\'))
+                *barra = L'\0';
+            d->opciones(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_FAIL_CRITICAL_ERRORS | SYMOPT_NO_PROMPTS);
+            if (!d->iniciar(GetCurrentProcess(), carpeta, TRUE))
+                return;
+            Linea l(salida);
+            l.texto(prefijo).texto("nombres (con el PDB junto al .exe):").escribir();
+            for (int pila = 0; pila < 2; ++pila)
+            {
+                void *const *m = pila == 0 ? marcos : marcos2;
+                const int cuantos = pila == 0 ? n : n2;
+                for (int i = 0; m != nullptr && i < cuantos; ++i)
+                {
+                    const uint64_t direccion = reinterpret_cast<uint64_t>(m[i]);
+                    l.texto(prefijo).texto(pila == 0 ? "  #" : "  pila 2 #").decimal(static_cast<uint64_t>(i))
+                        .texto(" ");
+                    alignas(SYMBOL_INFO) char bufer[sizeof(SYMBOL_INFO) + 256] = {};
+                    auto *simbolo = reinterpret_cast<SYMBOL_INFO *>(bufer);
+                    simbolo->SizeOfStruct = sizeof(SYMBOL_INFO);
+                    simbolo->MaxNameLen = 255;
+                    DWORD64 desplazamiento = 0;
+                    if (d->simbolo(GetCurrentProcess(), direccion, &desplazamiento, simbolo))
+                        l.texto(simbolo->Name).texto("+0x").hex(desplazamiento);
+                    else
+                        l.texto("?");
+                    l.escribir();
+                }
+            }
+            l.texto(prefijo).texto("fin de los nombres").escribir();
+            d->soltar(GetCurrentProcess());
+        }
+    }
+
+    void instalarCapturaDeLanzamientos()
+    {
+        static const bool s_instalado = AddVectoredExceptionHandler(1, capturarLanzamiento) != nullptr;
+        (void)s_instalado;
+    }
+
+    int pilaDelLanzamiento(void **marcos, int max, bool olvidar)
+    {
+        const int n = std::min(t_numLanzamiento, max);
+        for (int i = 0; i < n; ++i)
+            marcos[i] = t_lanzamiento[i];
+        if (olvidar)
+        {
+            t_numLanzamiento = 0;
+            t_objeto = 0u;
+            t_tipo = nullptr;
+        }
+        return n > 0 ? n : 0;
+    }
+
+    const char *tipoDelLanzamiento()
+    {
+        return t_numLanzamiento > 0 ? t_tipo : nullptr;
+    }
+
+    int pilaActual(void **marcos, int max, int saltar)
+    {
+        if (max <= 0)
+            return 0;
+        return RtlCaptureStackBackTrace(static_cast<DWORD>(saltar + 1), static_cast<DWORD>(max), marcos, nullptr);
+    }
+
+    void escribirLinea(const char *prefijo, const char *texto)
+    {
+        std::fflush(stdout);
+        std::fflush(stderr);
+        Linea l(salidaDeErrores());
+        l.texto(prefijo).texto(texto).escribir();
+    }
+
+    void escribirInforme(const char *prefijo, const char *titulo, void *const *marcos, int n, const char *titulo2,
+                         void *const *marcos2, int n2)
+    {
+        // Un informe cada vez (dos hilos que caen a la vez no mezclan sus lineas ni la tabla de modulos).
+        while (InterlockedCompareExchange(&g_informando, 1, 0) != 0)
+            Sleep(1);
+        std::fflush(stdout); // lo que el CRT aun tenia, antes que el informe
+        std::fflush(stderr);
+        const HANDLE salida = salidaDeErrores();
+        Linea l(salida);
+        l.texto(prefijo).texto("compilacion: ");
+        ps2x::vigilante::identidad(l);
+        l.escribir();
+        char nombre[96] = {};
+        ps2x::vigilante::nombreDelHilo(GetCurrentThread(), nombre, sizeof(nombre));
+        char bufer[600];
+        lineaHilo(bufer, sizeof(bufer), prefijo, GetCurrentThreadId(), nombre);
+        l.texto(bufer).escribir();
+        lineaEe(bufer, sizeof(bufer), prefijo, leerEe());
+        l.texto(bufer).escribir();
+        ps2x::vigilante::leerModulos(g_tablaFallo);
+        escribirPila(salida, prefijo, titulo, marcos, n);
+        if (marcos2 != nullptr && n2 > 0)
+            escribirPila(salida, prefijo, titulo2, marcos2, n2);
+        l.texto(prefijo).texto("fin del informe").escribir();
+        escribirNombres(salida, prefijo, marcos, n, marcos2, n2);
+        InterlockedExchange(&g_informando, 0);
+    }
+#else
+    void instalarCapturaDeLanzamientos()
+    {
+    }
+
+    int pilaDelLanzamiento(void **marcos, int max, bool olvidar)
+    {
+        (void)marcos, (void)max, (void)olvidar;
+        return 0;
+    }
+
+    const char *tipoDelLanzamiento()
+    {
+        return nullptr;
+    }
+
+    int pilaActual(void **marcos, int max, int saltar)
+    {
+        (void)marcos, (void)max, (void)saltar;
+        return 0;
+    }
+
+    void escribirLinea(const char *prefijo, const char *texto)
+    {
+        std::fprintf(stderr, "%s%s\n", prefijo, texto);
+    }
+
+    void escribirInforme(const char *prefijo, const char *titulo, void *const *marcos, int n, const char *titulo2,
+                         void *const *marcos2, int n2)
+    {
+        (void)prefijo, (void)titulo, (void)marcos, (void)n, (void)titulo2, (void)marcos2, (void)n2;
+    }
+#endif
+}
