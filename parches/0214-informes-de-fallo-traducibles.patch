diff --git a/ps2xRuntime/include/ps2_fallo.h b/ps2xRuntime/include/ps2_fallo.h
new file mode 100644
index 0000000..85cc291
--- /dev/null
+++ b/ps2xRuntime/include/ps2_fallo.h
@@ -0,0 +1,95 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// Informes de fallo traducibles (odd/tasks/fallos-con-log.md T3b, S3): lo que escriben el filtro de excepciones sin
+// manejar ("[fallo]", src/f1_fallos.cpp del proyecto), el catch del hilo del juego ("[excepcion]", ps2_runtime.cpp) y
+// el manejador de std::terminate ("[terminate]", main.cpp), con el mismo formato que el vigilante (ps2_vigilante.h):
+//   [fallo] compilacion: F1-06.exe fecha_pe=6736A0F1 tam_imagen=04B2D000 pdb=ps2EntryRunner.pdb guid=... edad=1 base=0x...
+//   [fallo] hilo 1234 GameThread
+//   [fallo] ee pc=0x00123456 ra=0x00123400 hilo_ee=1
+//   [fallo] pila (12 marcos):
+//   [fallo]   #0 ntdll.dll+0x9F0C4
+//   [fallo]   #1 F1-06.exe+0x1A2B3C
+//   [fallo] fin del informe
+// modulo+desplazamiento y la linea "compilacion:" bastan para traducirlo en casa con scripts/simbolizar.ps1 y el PDB
+// guardado de esa version (el paquete no lo lleva). Solo con el PDB junto al .exe (desarrollo) siguen los nombres.
+// Este archivo no incluye windows.h: lo usa src/f1_fallos.cpp, que se compila por lotes con raylib.
+namespace ps2x::fallo
+{
+    // PS2X_PRUEBA_FALLO=<tipo>:<segundos> (solo para probar los informes, T4): a los <segundos> del arranque, en el
+    // hilo del juego al dibujar un fotograma (src/f1_overrides.cpp), acceso = escritura en la direccion 0 (informe
+    // "[fallo]", sale con 0xC0000005), excepcion = std::runtime_error (informe "[excepcion]", sale con 10) y
+    // terminate = std::runtime_error en un hilo auxiliar "PruebaFallo" (informe "[terminate]", abort).
+    enum class Prueba
+    {
+        Ninguna,
+        Acceso,
+        Excepcion,
+        Terminate,
+    };
+
+    struct PruebaFallo
+    {
+        Prueba tipo = Prueba::Ninguna;
+        double segundos = 0.0;
+    };
+
+    // El valor de PS2X_PRUEBA_FALLO: "<tipo>:<segundos>" con tipo acceso, excepcion o terminate y segundos un numero
+    // >= 0 (decimales con punto). nullptr, vacio o cualquier otra cosa: Ninguna (no se provoca nada).
+    PruebaFallo leerPrueba(const char *valor);
+
+    // Lo que se sabe del EE al caer: el pc y el ra que publico el planificador por ultima vez (EeScheduler,
+    // m_debugPc / m_debugRa) y el hilo del EE que corria (0: ninguno).
+    struct EstadoEe
+    {
+        bool hay = false; // el juego ya corre (registrarEe se llamo)
+        uint32_t pc = 0u;
+        uint32_t ra = 0u;
+        int hilo = 0;
+    };
+
+    // Las lineas del informe, en destino (acaban en '\0', sin salto de linea; se cortan si no caben). Devuelven la
+    // longitud escrita. No reservan memoria ni usan el CRT: valen dentro de un filtro de excepciones.
+    //   "<prefijo>  #<i> <modulo>+0x<DESPL>" (hexadecimal en mayusculas, como el vigilante); sin modulo:
+    //   "<prefijo>  #<i> 0x<DIRECCION de 16 cifras>"
+    size_t lineaMarco(char *destino, size_t tam, const char *prefijo, int indice, const char *modulo,
+                      uint64_t desplazamiento, uint64_t direccion);
+    //   "<prefijo>hilo <id> <nombre>"; nombre vacio o nullptr: "<prefijo>hilo <id> (sin nombre)"
+    size_t lineaHilo(char *destino, size_t tam, const char *prefijo, uint32_t id, const char *nombre);
+    //   "<prefijo>ee pc=0x<8 cifras> ra=0x<8 cifras> hilo_ee=<n>"; sin datos: "<prefijo>ee sin datos (el juego aun no
+    //   corre)"
+    size_t lineaEe(char *destino, size_t tam, const char *prefijo, const EstadoEe &ee);
+
+    // El runtime dice como leer el estado del EE (PS2Runtime::run). La funcion se llama desde el informe, en el hilo
+    // que cae: solo debe leer atomicos.
+    using LectorEe = EstadoEe (*)(const void *dato);
+    void registrarEe(LectorEe lector, const void *dato);
+
+    // Windows: el manejador de excepciones vectorizado que guarda, en cada hilo, la pila del ultimo throw de C++ (no
+    // los relanzamientos "throw;" ni las EeDispatcherTransfer del planificador, que no son errores). Sin el, en el
+    // catch la pila del throw ya no existe. Una vez, al arrancar (main.cpp).
+    void instalarCapturaDeLanzamientos();
+
+    // La pila del ultimo throw de C++ de este hilo (instalarCapturaDeLanzamientos). Devuelve cuantos marcos copio en
+    // marcos (0: ninguno). olvidar: la borra despues (un informe no repite una pila vieja).
+    int pilaDelLanzamiento(void **marcos, int max, bool olvidar);
+
+    // El tipo de ese throw, decorado como lo guarda el compilador (".?AVruntime_error@std@@"; datos del modulo, no
+    // caducan); nullptr sin pila guardada o si no se pudo leer. Antes de pilaDelLanzamiento(..., true), que lo olvida.
+    const char *tipoDelLanzamiento();
+
+    // La pila de quien llama (saltar: marcos de arriba que no se escriben).
+    int pilaActual(void **marcos, int max, int saltar);
+
+    // El informe en stderr (el registro), sin el CRT ni reservar memoria: vacia antes stdout y stderr del CRT para que
+    // lo ya escrito salga antes, y luego escribe compilacion, hilo, ee, la pila (titulo "pila" si es nullptr) y "fin del
+    // informe"; con el PDB junto al .exe, tambien los nombres. marcos2 (opcional): una segunda pila, con su titulo,
+    // despues de la primera. Un informe cada vez en todo el proceso. Fuera de Windows no hace nada.
+    void escribirInforme(const char *prefijo, const char *titulo, void *const *marcos, int n,
+                         const char *titulo2 = nullptr, void *const *marcos2 = nullptr, int n2 = 0);
+
+    // Una linea suelta "<prefijo><texto>" en stderr, por el mismo camino que el informe.
+    void escribirLinea(const char *prefijo, const char *texto);
+}
diff --git a/ps2xRuntime/src/lib/ps2_fallo.cpp b/ps2xRuntime/src/lib/ps2_fallo.cpp
new file mode 100644
index 0000000..5a2e8cb
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_fallo.cpp
@@ -0,0 +1,135 @@
+// Informes de fallo (ps2_fallo.h): lo que no depende de Windows. La parte de Windows (pila, modulos, escritura) esta
+// en ps2_vigilante_win.cpp, junto a la del vigilante, de la que reutiliza la lectura de modulos y la identidad.
+#include "ps2_fallo.h"
+
+#include <cstdlib>
+#include <cstring>
+
+namespace ps2x::fallo
+{
+    namespace
+    {
+        // Escribe en un bufer fijo, sin reservar memoria ni usar el CRT (sirve dentro de un filtro de excepciones).
+        class Texto
+        {
+        public:
+            Texto(char *destino, size_t tam) : m_destino(destino), m_tam(tam)
+            {
+                if (m_tam > 0u)
+                    m_destino[0] = '\0';
+            }
+            Texto &texto(const char *s)
+            {
+                while (s != nullptr && *s != '\0')
+                    poner(*s++);
+                return *this;
+            }
+            Texto &decimal(uint64_t v)
+            {
+                char cifras[24];
+                int n = 0;
+                do
+                {
+                    cifras[n++] = static_cast<char>('0' + v % 10u);
+                    v /= 10u;
+                } while (v != 0u);
+                while (n > 0)
+                    poner(cifras[--n]);
+                return *this;
+            }
+            // Mayusculas, con al menos 'ancho' cifras (como Linea::hex del vigilante).
+            Texto &hex(uint64_t v, int ancho = 1)
+            {
+                char cifras[16];
+                int n = 0;
+                do
+                {
+                    cifras[n++] = "0123456789ABCDEF"[v & 0xFu];
+                    v >>= 4;
+                } while (v != 0u || n < ancho);
+                while (n > 0)
+                    poner(cifras[--n]);
+                return *this;
+            }
+            size_t largo() const
+            {
+                return m_n;
+            }
+
+        private:
+            void poner(char c)
+            {
+                if (m_n + 1u < m_tam)
+                {
+                    m_destino[m_n++] = c;
+                    m_destino[m_n] = '\0';
+                }
+            }
+            char *m_destino;
+            size_t m_tam;
+            size_t m_n = 0u;
+        };
+    }
+
+    PruebaFallo leerPrueba(const char *valor)
+    {
+        PruebaFallo prueba;
+        if (valor == nullptr)
+            return prueba;
+        const char *dos = std::strchr(valor, ':');
+        if (dos == nullptr)
+            return prueba;
+        const size_t largo = static_cast<size_t>(dos - valor);
+        Prueba tipo = Prueba::Ninguna;
+        if (largo == 6u && std::strncmp(valor, "acceso", largo) == 0)
+            tipo = Prueba::Acceso;
+        else if (largo == 9u && std::strncmp(valor, "excepcion", largo) == 0)
+            tipo = Prueba::Excepcion;
+        else if (largo == 9u && std::strncmp(valor, "terminate", largo) == 0)
+            tipo = Prueba::Terminate;
+        const char *numero = dos + 1;
+        // Solo cifras y un punto: sin signo, espacios ni exponentes.
+        if (tipo == Prueba::Ninguna || *numero == '\0' || std::strspn(numero, "0123456789.") != std::strlen(numero))
+            return prueba;
+        char *fin = nullptr;
+        const double segundos = std::strtod(numero, &fin);
+        if (fin == numero || *fin != '\0' || !(segundos >= 0.0))
+            return prueba;
+        prueba.tipo = tipo;
+        prueba.segundos = segundos;
+        return prueba;
+    }
+
+    size_t lineaMarco(char *destino, size_t tam, const char *prefijo, int indice, const char *modulo,
+                      uint64_t desplazamiento, uint64_t direccion)
+    {
+        Texto t(destino, tam);
+        t.texto(prefijo).texto("  #").decimal(static_cast<uint64_t>(indice < 0 ? 0 : indice)).texto(" ");
+        if (modulo != nullptr)
+            t.texto(modulo).texto("+0x").hex(desplazamiento);
+        else
+            t.texto("0x").hex(direccion, 16);
+        return t.largo();
+    }
+
+    size_t lineaHilo(char *destino, size_t tam, const char *prefijo, uint32_t id, const char *nombre)
+    {
+        Texto t(destino, tam);
+        t.texto(prefijo).texto("hilo ").decimal(id).texto(" ");
+        t.texto(nombre != nullptr && nombre[0] != '\0' ? nombre : "(sin nombre)");
+        return t.largo();
+    }
+
+    size_t lineaEe(char *destino, size_t tam, const char *prefijo, const EstadoEe &ee)
+    {
+        Texto t(destino, tam);
+        t.texto(prefijo);
+        if (!ee.hay)
+            return t.texto("ee sin datos (el juego aun no corre)").largo();
+        t.texto("ee pc=0x").hex(ee.pc, 8).texto(" ra=0x").hex(ee.ra, 8).texto(" hilo_ee=");
+        if (ee.hilo < 0)
+            t.texto("-");
+        t.decimal(static_cast<uint64_t>(ee.hilo < 0 ? -static_cast<int64_t>(ee.hilo) : ee.hilo));
+        return t.largo();
+    }
+}
