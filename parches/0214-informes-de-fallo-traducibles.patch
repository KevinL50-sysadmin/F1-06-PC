+    ps2x::fallo::registrarEe(
+        [](const void *data) -> ps2x::fallo::EstadoEe
+        {
+            const auto *runtime = static_cast<const PS2Runtime *>(data);
+            ps2x::fallo::EstadoEe ee;
+            ee.hay = true;
+            ee.pc = runtime->m_debugPc.load(std::memory_order_relaxed);
+            ee.ra = runtime->m_debugRa.load(std::memory_order_relaxed);
+            ee.hilo = runtime->m_eeScheduler ? runtime->m_eeScheduler->currentThreadId() : 0;
+            return ee;
+        },
+        this);
+
     std::thread gameThread([&]()
                            {
         ThreadNaming::SetCurrentThreadName("GameThread");
@@ -3842,12 +3873,14 @@ void PS2Runtime::run()
         catch (const std::exception &e)
         {
             std::cerr << "Error during program execution: " << e.what() << std::endl;
+            ReportGameThreadException(); // T3b
             // odd/tasks/fallos-con-log.md T2: el proceso sale distinto de 0 (RecompLauncher adjunta el registro).
             ps2x::salida::anotarFallo(ps2x::salida::kExcepcionJuego, "excepcion-hilo-juego");
         }
         catch (...)
         {
             std::cerr << "Error during program execution: unknown exception" << std::endl;
+            ReportGameThreadException(); // T3b
             ps2x::salida::anotarFallo(ps2x::salida::kExcepcionJuego, "excepcion-hilo-juego");
