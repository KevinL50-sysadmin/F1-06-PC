diff --git a/ps2xTest/src/ps2_fallo_tests.cpp b/ps2xTest/src/ps2_fallo_tests.cpp
new file mode 100644
index 0000000..0dd29bd
--- /dev/null
+++ b/ps2xTest/src/ps2_fallo_tests.cpp
@@ -0,0 +1,102 @@
+#include "MiniTest.h"
+#include "ps2_fallo.h"
+
+#include <cstring>
+#include <string>
+
+// odd/tasks/fallos-con-log.md T3b (S3): the crash reports use the vigilante's module+offset format, and
+// PS2X_PRUEBA_FALLO=<tipo>:<segundos> triggers each kind of crash for the T4 tests.
+namespace
+{
+    using ps2x::fallo::Prueba;
+
+    std::string marco(const char *prefijo, int i, const char *modulo, uint64_t desp, uint64_t dir, size_t tam = 256)
+    {
+        char bufer[256];
+        const size_t n = ps2x::fallo::lineaMarco(bufer, tam, prefijo, i, modulo, desp, dir);
+        if (std::strlen(bufer) != n)
+            return "length mismatch";
+        return bufer;
+    }
+
+    std::string hilo(const char *prefijo, uint32_t id, const char *nombre)
+    {
+        char bufer[256];
+        ps2x::fallo::lineaHilo(bufer, sizeof(bufer), prefijo, id, nombre);
+        return bufer;
+    }
+
+    std::string ee(const char *prefijo, const ps2x::fallo::EstadoEe &estado)
+    {
+        char bufer[256];
+        ps2x::fallo::lineaEe(bufer, sizeof(bufer), prefijo, estado);
+        return bufer;
+    }
+}
+
+void register_ps2_fallo_tests()
+{
+    MiniTest::Case("Fallo", [](TestCase &tc)
+    {
+        tc.Run("PS2X_PRUEBA_FALLO: the three kinds with their seconds", [](TestCase &t)
+        {
+            const auto a = ps2x::fallo::leerPrueba("acceso:15");
+            t.IsTrue(a.tipo == Prueba::Acceso, "acceso");
+            t.Equals(a.segundos, 15.0, "15 s");
+            const auto e = ps2x::fallo::leerPrueba("excepcion:2.5");
+            t.IsTrue(e.tipo == Prueba::Excepcion, "excepcion");
+            t.Equals(e.segundos, 2.5, "2.5 s");
+            const auto m = ps2x::fallo::leerPrueba("terminate:0");
+            t.IsTrue(m.tipo == Prueba::Terminate, "terminate");
+            t.Equals(m.segundos, 0.0, "0 s");
+        });
+
+        tc.Run("PS2X_PRUEBA_FALLO: anything else triggers nothing", [](TestCase &t)
+        {
+            for (const char *valor : {"", "acceso", "acceso:", "acceso:-1", "acceso:15x", "acceso:15:3", "Acceso:15",
+                                      "otro:15", ":15", "acceso: ", "acceso:abc"})
+                t.IsTrue(ps2x::fallo::leerPrueba(valor).tipo == Prueba::Ninguna, std::string("rejected: ") + valor);
+            t.IsTrue(ps2x::fallo::leerPrueba(nullptr).tipo == Prueba::Ninguna, "unset");
+        });
+
+        tc.Run("frame line: module+offset like the vigilante", [](TestCase &t)
+        {
+            t.Equals(marco("[fallo] ", 0, "F1-06.exe", 0x1A2B3Cu, 0x7FF6A134B3Cull),
+                     std::string("[fallo]   #0 F1-06.exe+0x1A2B3C"), "game module");
+            t.Equals(marco("[terminate] ", 12, "ntdll.dll", 0x0u, 0x7FFA00000000ull),
+                     std::string("[terminate]   #12 ntdll.dll+0x0"), "offset 0, two-digit index");
+        });
+
+        tc.Run("frame line: an address outside every module", [](TestCase &t)
+        {
+            t.Equals(marco("[fallo] ", 3, nullptr, 0u, 0x1234ull), std::string("[fallo]   #3 0x0000000000001234"),
+                     "16 hex digits");
+        });
+
+        tc.Run("frame line: cut to the buffer, always terminated", [](TestCase &t)
+        {
+            t.Equals(marco("[fallo] ", 0, "F1-06.exe", 0x1A2B3Cu, 0u, 12), std::string("[fallo]   #"),
+                     "11 characters and the terminator");
+        });
+
+        tc.Run("thread line with and without a name", [](TestCase &t)
+        {
+            t.Equals(hilo("[fallo] ", 1234u, "GameThread"), std::string("[fallo] hilo 1234 GameThread"), "named");
+            t.Equals(hilo("[fallo] ", 77u, ""), std::string("[fallo] hilo 77 (sin nombre)"), "empty name");
+            t.Equals(hilo("[fallo] ", 77u, nullptr), std::string("[fallo] hilo 77 (sin nombre)"), "no name");
+        });
+
+        tc.Run("EE line: pc, ra and guest thread, or no data yet", [](TestCase &t)
+        {
+            ps2x::fallo::EstadoEe estado;
+            estado.hay = true;
+            estado.pc = 0x00123456u;
+            estado.ra = 0x1A00u;
+            estado.hilo = 3;
+            t.Equals(ee("[excepcion] ", estado), std::string("[excepcion] ee pc=0x00123456 ra=0x00001A00 hilo_ee=3"),
+                     "8 hex digits each");
+            t.Equals(ee("[fallo] ", ps2x::fallo::EstadoEe{}),
+                     std::string("[fallo] ee sin datos (el juego aun no corre)"), "before the game runs");
+        });
+    });
+}
