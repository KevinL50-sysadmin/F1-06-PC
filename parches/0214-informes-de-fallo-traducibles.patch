+// odd/tasks/fallos-con-log.md T3b: the report of an exception that reached GameThread's catch, with the stack of its
+// throw (kept by ps2x::fallo's vectored handler: in the catch it is gone). An exception rethrown with "throw;" keeps
+// the stack of its first throw; one from code that saw no throw of C++ (none kept) gets the catch's own stack.
+static void ReportGameThreadException()
+{
+    void *frames[48];
+    int count = ps2x::fallo::pilaDelLanzamiento(frames, 48, true);
+    if (count > 0)
+    {
+        ps2x::fallo::escribirInforme("[excepcion] ", "pila del throw", frames, count);
+        return;
+    }
+    count = ps2x::fallo::pilaActual(frames, 48, 0);
+    ps2x::fallo::escribirInforme("[excepcion] ", "pila del catch (no se guardo la del throw)", frames, count);
+}
