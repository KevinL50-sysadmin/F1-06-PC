@@ -16,6 +16,31 @@ namespace
             return std::numeric_limits<int32_t>::min();
         return static_cast<int32_t>(scaled);
     }
+
+    // MAX/MINI compare the raw bit patterns as signed integers and return one of the operands
+    // untouched (PCSX2 fp_max/fp_min). Games use "max vfD, vfS, vfS" to move integer data (for
+    // example FTOI4 texture coordinates), which float normalisation would flush to zero.
+    float vuMaxBits(float a, float b)
+    {
+        int32_t ia = 0, ib = 0;
+        std::memcpy(&ia, &a, sizeof(ia));
+        std::memcpy(&ib, &b, sizeof(ib));
+        const int32_t r = (ia < 0 && ib < 0) ? (ia < ib ? ia : ib) : (ia > ib ? ia : ib);
+        float out;
+        std::memcpy(&out, &r, sizeof(out));
+        return out;
+    }
+
+    float vuMinBits(float a, float b)
+    {
+        int32_t ia = 0, ib = 0;
+        std::memcpy(&ia, &a, sizeof(ia));
+        std::memcpy(&ib, &b, sizeof(ib));
+        const int32_t r = (ia < 0 && ib < 0) ? (ia > ib ? ia : ib) : (ia < ib ? ia : ib);
+        float out;
+        std::memcpy(&out, &r, sizeof(out));
+        return out;
+    }
 }
 
