+        asleep[i] = static_cast<double>(s.sleepNs.exchange(0u, std::memory_order_relaxed)) / 1e9;
+        sleeps[i] = static_cast<double>(s.sleeps.exchange(0u, std::memory_order_relaxed));
+        wakes[i] = static_cast<double>(s.wakes.exchange(0u, std::memory_order_relaxed));
+    }
+    const auto rate = [](double count, double s) { return s > 0.0 ? count / s : 0.0; };
+    std::snprintf(text, size,
+                  " | hilo GIF, esperas por tiempo: %.1f s, dormido %.0f %%, dormidas=%.0f/s despertares=%.0f/s; "
+                  "por pausas (A/B 187): %.1f s, dormido %.0f %%, dormidas=%.0f/s despertares=%.0f/s",
+                  seconds[0], 100.0 * rate(asleep[0], seconds[0]), rate(sleeps[0], seconds[0]),
+                  rate(wakes[0], seconds[0]), seconds[1], 100.0 * rate(asleep[1], seconds[1]),
+                  rate(sleeps[1], seconds[1]), rate(wakes[1], seconds[1]));
