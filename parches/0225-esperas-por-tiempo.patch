 // hyper-threads) and every other thread of the process off that core, with 7 cores or more; false undoes it (the EE
 // thread on every performance core). Returns the core index used, or -1.
 int ps2EeOwnCore(bool own);
+
+// Patch 0225 (T3 of 1.1.3): spin-then-sleep waits that last a time instead of a number of PAUSE instructions. PAUSE
+// takes 34 ns on this PC's P cores, 16 ns on its E cores and ~3 ns on Sandy Bridge (logs/rend-t1/pausa.txt), so the
+// waits that counted pauses (GS GIF worker 4000, GIF sync and room 2000, IOP hand-off 256) lasted ~10 times less on an
+// old Xeon and its threads fell asleep (and paid the wake-up) sooner. Now each lasts what its count lasted on the P
+// cores (budgetNs), the clock read every kClockEvery pauses. A/B mode 187: the pause count of before.
+namespace ps2spin
+{
+    constexpr int kAbPauseCount = 187;
+    constexpr int64_t kPauseNs = 34;     // one PAUSE on this PC's P cores
+    constexpr uint32_t kClockEvery = 16u; // pauses between clock reads (steady_clock is QueryPerformanceCounter)
+
+    constexpr int64_t budgetNs(uint32_t pauses) { return static_cast<int64_t>(pauses) * kPauseNs; }
+    constexpr bool byTime(int abMode) { return abMode != kAbPauseCount; }
+
+    struct SteadyNs
+    {
+        int64_t operator()() const
+        {
+            return std::chrono::duration_cast<std::chrono::nanoseconds>(
+                       std::chrono::steady_clock::now().time_since_epoch())
+                .count();
+        }
+    };
+
+    // spend() before each pause: false once the budget is gone (byTime: budgetNs(pauses) since the timer was made;
+    // otherwise `pauses` pauses), and from then on. No budget (pauses = 0): no pause at all.
+    template <typename NowNs = SteadyNs>
+    class SpinTimer
+    {
+    public:
+        SpinTimer(uint32_t pauses, bool byTime, NowNs now = NowNs{})
+            : m_now(now), m_pauses(pauses), m_byTime(byTime), m_spent(pauses == 0u)
+        {
+            if (m_byTime && !m_spent)
+                m_end = m_now() + budgetNs(pauses);
+        }
+
+        bool spend()
+        {
+            if (m_spent)
+                return false;
+            ++m_count;
+            if (!m_byTime)
+                m_spent = m_count > m_pauses;
+            else if (m_count % kClockEvery == 1u && m_count > 1u) // after every kClockEvery pauses
+                m_spent = m_now() >= m_end;
+            return !m_spent;
+        }
+
+    private:
+        NowNs m_now;
+        int64_t m_end = 0;
+        uint32_t m_pauses;
+        uint32_t m_count = 0u;
+        bool m_byTime;
+        bool m_spent;
+    };
+}
