+void ps2GsGifStatsText(char *text, size_t size)
+{
+    double seconds[2], asleep[2], sleeps[2], wakes[2];
+    for (int i = 0; i < 2; ++i)
+    {
+        GifWaitStats &s = g_gifWaitStats[i];
