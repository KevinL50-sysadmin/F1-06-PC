diff --git a/ps2xIOP/src/emulator/core/iop_cpu_fast.h b/ps2xIOP/src/emulator/core/iop_cpu_fast.h
new file mode 100644
index 0000000..b9463fa
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_cpu_fast.h
@@ -0,0 +1,562 @@
+#pragma once
+
+// Patch 0113: the IOP interpreter's instruction, inline. Same semantics as IopCpuCore::executeInstruction (load and
+// branch delays, exceptions, register 0), but the instruction word comes from the caller (already fetched from RAM)
+// and the loads and stores to RAM go straight to the RAM array without IopMemory's calls. Everything else (scratchpad,
+// hardware, SPU2, unaligned words) still goes through IopMemory. With the sound driver's software mixer ticking
+// (patch 0112), the IOP runs millions of instructions a second on the EE thread and the calls per instruction cost
+// more than the instructions themselves.
+
+#include "iop_cpu.h"
+#include "iop_memory.h"
+
+#include <cstring>
+#include <limits>
+
+#if defined(_MSC_VER)
+#define PS2X_IOP_FORCEINLINE __forceinline
+#else
+#define PS2X_IOP_FORCEINLINE inline __attribute__((always_inline))
+#endif
+
+namespace ps2x::iop::detail
+{
+    struct IopFastMemory
+    {
+        uint8_t *ram;
+        uint8_t *owned;
+        IopMemory &memory;
+
+        PS2X_IOP_FORCEINLINE uint8_t read8(uint32_t address) const
+        {
+            const uint32_t phys = address & 0x1FFFFFFFu;
+            if (phys < IopMemory::RamSize)
+                return ram[phys];
+            return memory.read8(address);
+        }
+
+        PS2X_IOP_FORCEINLINE uint16_t read16(uint32_t address) const
+        {
+            const uint32_t phys = address & 0x1FFFFFFFu;
+            if (phys + 1u < IopMemory::RamSize)
+            {
+                uint16_t value;
+                std::memcpy(&value, ram + phys, sizeof(value));
+                return value;
+            }
+            return memory.read16(address);
+        }
+
+        PS2X_IOP_FORCEINLINE uint32_t read32(uint32_t address) const
+        {
+            const uint32_t phys = address & 0x1FFFFFFFu;
+            if ((phys & 3u) == 0u && phys + 3u < IopMemory::RamSize)
+            {
+                uint32_t value;
+                std::memcpy(&value, ram + phys, sizeof(value));
+                return value;
+            }
+            return memory.read32(address);
+        }
+
+        PS2X_IOP_FORCEINLINE void write8(uint32_t address, uint8_t value) const
+        {
+            const uint32_t phys = address & 0x1FFFFFFFu;
+            if (phys < IopMemory::RamSize)
+            {
+                ram[phys] = value;
+                owned[phys] = 1u;
+                return;
+            }
+            memory.write8(address, value);
+        }
+
+        PS2X_IOP_FORCEINLINE void write16(uint32_t address, uint16_t value) const
+        {
+            const uint32_t phys = address & 0x1FFFFFFFu;
+            if (phys + 1u < IopMemory::RamSize)
+            {
+                std::memcpy(ram + phys, &value, sizeof(value));
+                owned[phys] = 1u;
+                owned[phys + 1u] = 1u;
+                return;
+            }
+            memory.write16(address, value);
+        }
+
+        PS2X_IOP_FORCEINLINE void write32(uint32_t address, uint32_t value) const
+        {
+            const uint32_t phys = address & 0x1FFFFFFFu;
+            if ((phys & 3u) == 0u && phys + 3u < IopMemory::RamSize)
+            {
+                std::memcpy(ram + phys, &value, sizeof(value));
+                constexpr uint32_t kOwned = 0x01010101u;
+                std::memcpy(owned + phys, &kOwned, sizeof(kOwned));
+                return;
+            }
+            memory.write32(address, value);
+        }
+    };
+
+    // Runs one instruction already fetched from cpu.pc. Returns !cpu.stopped, like executeInstruction.
+    PS2X_IOP_FORCEINLINE bool iopExecuteFast(IopCpuState &cpu, uint32_t instruction, const IopFastMemory &mem,
+                                             const IopCpuCore &core)
+    {
+        const uint32_t pc = cpu.pc;
+        const bool wasDelaySlot = cpu.branchPending;
+
+        cpu.branchPending = false;
+        cpu.exception = false;
+        cpu.yielded = false;
+
+        const uint32_t opcode = instruction >> 26u;
+        const uint32_t rs = (instruction >> 21u) & 31u;
+        const uint32_t rt = (instruction >> 16u) & 31u;
+        const uint32_t rd = (instruction >> 11u) & 31u;
+        const uint32_t imm = instruction & 0xFFFFu;
+        const uint32_t simm = static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(imm)));
+        const uint32_t nextPc = pc + 4u;
+        uint32_t *const gpr = cpu.gpr.data();
+
+        // writtenReg: the register this instruction wrote (it wins over a load still in its delay slot).
+        uint32_t writtenReg = 0u;
+        bool scheduledLoad = false;
+        uint32_t scheduledReg = 0u;
+        uint32_t scheduledValue = 0u;
+        bool newBranch = false;
+        uint32_t newBranchTarget = 0u;
+
+#define IOP_WRITE(reg, value)          \
+    do                                 \
+    {                                  \
+        const uint32_t r_ = (reg);     \
+        const uint32_t v_ = (value);   \
+        if (r_ != 0u)                  \
+        {                              \
+            gpr[r_] = v_;              \
+            writtenReg = r_;           \
+        }                              \
+    } while (0)
+#define IOP_LOAD(reg, value)           \
+    do                                 \
+    {                                  \
+        const uint32_t r_ = (reg);     \
+        const uint32_t v_ = (value);   \
+        if (r_ != 0u)                  \
+        {                              \
+            scheduledLoad = true;      \
+            scheduledReg = r_;         \
+            scheduledValue = v_;       \
+        }                              \
+    } while (0)
+#define IOP_BRANCH(condition)                               \
+    do                                                      \
+    {                                                       \
+        if (condition)                                      \
+        {                                                   \
+            newBranch = true;                               \
+            newBranchTarget = nextPc + (simm << 2u);        \
+        }                                                   \
+    } while (0)
+
+        switch (opcode)
+        {
+        case 0x00:
+        {
+            const uint32_t sa = (instruction >> 6u) & 31u;
+            switch (instruction & 63u)
+            {
+            case 0x00:
+                IOP_WRITE(rd, gpr[rt] << sa);
+                break;
+            case 0x02:
+                IOP_WRITE(rd, gpr[rt] >> sa);
+                break;
+            case 0x03:
+                IOP_WRITE(rd, static_cast<uint32_t>(static_cast<int32_t>(gpr[rt]) >> sa));
+                break;
+            case 0x04:
+                IOP_WRITE(rd, gpr[rt] << (gpr[rs] & 31u));
+                break;
+            case 0x06:
+                IOP_WRITE(rd, gpr[rt] >> (gpr[rs] & 31u));
+                break;
+            case 0x07:
+                IOP_WRITE(rd, static_cast<uint32_t>(static_cast<int32_t>(gpr[rt]) >> (gpr[rs] & 31u)));
+                break;
+            case 0x08:
+                newBranch = true;
+                newBranchTarget = gpr[rs];
+                break;
+            case 0x09:
+                // As executeInstruction: the target is read after the link (jalr with rd == rs jumps to pc + 8).
+                IOP_WRITE(rd ? rd : 31u, pc + 8u);
+                newBranch = true;
+                newBranchTarget = gpr[rs];
+                break;
+            case 0x0C:
+                core.raiseException(cpu, 8u, pc, wasDelaySlot);
+                break;
+            case 0x0D:
+                core.raiseException(cpu, 9u, pc, wasDelaySlot);
+                break;
+            case 0x10:
+                IOP_WRITE(rd, cpu.hi);
+                break;
+            case 0x11:
+                cpu.hi = gpr[rs];
+                break;
+            case 0x12:
+                IOP_WRITE(rd, cpu.lo);
+                break;
+            case 0x13:
+                cpu.lo = gpr[rs];
+                break;
+            case 0x18:
+            {
+                const int64_t result = static_cast<int64_t>(static_cast<int32_t>(gpr[rs])) *
+                                       static_cast<int64_t>(static_cast<int32_t>(gpr[rt]));
+                cpu.lo = static_cast<uint32_t>(result);
+                cpu.hi = static_cast<uint32_t>(static_cast<uint64_t>(result) >> 32u);
+                break;
+            }
+            case 0x19:
+            {
+                const uint64_t result = static_cast<uint64_t>(gpr[rs]) * gpr[rt];
+                cpu.lo = static_cast<uint32_t>(result);
+                cpu.hi = static_cast<uint32_t>(result >> 32u);
+                break;
+            }
+            case 0x1A:
+            {
+                const int32_t lhs = static_cast<int32_t>(gpr[rs]);
+                const int32_t rhs = static_cast<int32_t>(gpr[rt]);
+                if (rhs == 0)
+                {
+                    cpu.lo = lhs >= 0 ? 0xFFFFFFFFu : 1u;
+                    cpu.hi = static_cast<uint32_t>(lhs);
+                }
+                else if (lhs == std::numeric_limits<int32_t>::min() && rhs == -1)
+                {
+                    cpu.lo = static_cast<uint32_t>(lhs);
+                    cpu.hi = 0u;
+                }
+                else
+                {
+                    cpu.lo = static_cast<uint32_t>(lhs / rhs);
+                    cpu.hi = static_cast<uint32_t>(lhs % rhs);
+                }
+                break;
+            }
+            case 0x1B:
+                if (gpr[rt] == 0u)
+                {
+                    cpu.lo = 0xFFFFFFFFu;
+                    cpu.hi = gpr[rs];
+                }
+                else
+                {
+                    cpu.lo = gpr[rs] / gpr[rt];
+                    cpu.hi = gpr[rs] % gpr[rt];
+                }
+                break;
+            case 0x20:
+            {
+                const int64_t result = static_cast<int64_t>(static_cast<int32_t>(gpr[rs])) + static_cast<int32_t>(gpr[rt]);
+                if (result > std::numeric_limits<int32_t>::max() || result < std::numeric_limits<int32_t>::min())
+                    core.raiseException(cpu, 12u, pc, wasDelaySlot);
+                else
+                    IOP_WRITE(rd, static_cast<uint32_t>(static_cast<int32_t>(result)));
+                break;
+            }
+            case 0x21:
+                IOP_WRITE(rd, gpr[rs] + gpr[rt]);
+                break;
+            case 0x22:
+            {
+                const int64_t result = static_cast<int64_t>(static_cast<int32_t>(gpr[rs])) - static_cast<int32_t>(gpr[rt]);
+                if (result > std::numeric_limits<int32_t>::max() || result < std::numeric_limits<int32_t>::min())
+                    core.raiseException(cpu, 12u, pc, wasDelaySlot);
+                else
+                    IOP_WRITE(rd, static_cast<uint32_t>(static_cast<int32_t>(result)));
+                break;
+            }
+            case 0x23:
+                IOP_WRITE(rd, gpr[rs] - gpr[rt]);
+                break;
+            case 0x24:
+                IOP_WRITE(rd, gpr[rs] & gpr[rt]);
+                break;
+            case 0x25:
+                IOP_WRITE(rd, gpr[rs] | gpr[rt]);
+                break;
+            case 0x26:
+                IOP_WRITE(rd, gpr[rs] ^ gpr[rt]);
+                break;
+            case 0x27:
+                IOP_WRITE(rd, ~(gpr[rs] | gpr[rt]));
+                break;
+            case 0x2A:
+                IOP_WRITE(rd, static_cast<int32_t>(gpr[rs]) < static_cast<int32_t>(gpr[rt]) ? 1u : 0u);
+                break;
+            case 0x2B:
+                IOP_WRITE(rd, gpr[rs] < gpr[rt] ? 1u : 0u);
+                break;
+            default:
+                core.raiseException(cpu, 10u, pc, wasDelaySlot);
+                break;
+            }
+            break;
+        }
+        case 0x01:
+            // As executeInstruction, BLTZAL and BGEZAL test rs after the link.
+            switch (rt)
+            {
+            case 0x00:
+                IOP_BRANCH(static_cast<int32_t>(gpr[rs]) < 0);
+                break;
+            case 0x01:
+                IOP_BRANCH(static_cast<int32_t>(gpr[rs]) >= 0);
+                break;
+            case 0x10:
+                IOP_WRITE(31u, pc + 8u);
+                IOP_BRANCH(static_cast<int32_t>(gpr[rs]) < 0);
+                break;
+            case 0x11:
+                IOP_WRITE(31u, pc + 8u);
+                IOP_BRANCH(static_cast<int32_t>(gpr[rs]) >= 0);
+                break;
+            default:
+                core.raiseException(cpu, 10u, pc, wasDelaySlot);
+                break;
+            }
+            break;
+        case 0x02:
+            newBranch = true;
+            newBranchTarget = (nextPc & 0xF0000000u) | ((instruction & 0x03FFFFFFu) << 2u);
+            break;
+        case 0x03:
+            IOP_WRITE(31u, pc + 8u);
+            newBranch = true;
+            newBranchTarget = (nextPc & 0xF0000000u) | ((instruction & 0x03FFFFFFu) << 2u);
+            break;
+        case 0x04:
+            IOP_BRANCH(gpr[rs] == gpr[rt]);
+            break;
+        case 0x05:
+            IOP_BRANCH(gpr[rs] != gpr[rt]);
+            break;
+        case 0x06:
+            IOP_BRANCH(static_cast<int32_t>(gpr[rs]) <= 0);
+            break;
+        case 0x07:
+            IOP_BRANCH(static_cast<int32_t>(gpr[rs]) > 0);
+            break;
+        case 0x08:
+        {
+            const int64_t result = static_cast<int64_t>(static_cast<int32_t>(gpr[rs])) + static_cast<int32_t>(simm);
+            if (result > std::numeric_limits<int32_t>::max() || result < std::numeric_limits<int32_t>::min())
+                core.raiseException(cpu, 12u, pc, wasDelaySlot);
+            else
+                IOP_WRITE(rt, static_cast<uint32_t>(static_cast<int32_t>(result)));
+            break;
+        }
+        case 0x09:
+            IOP_WRITE(rt, gpr[rs] + simm);
+            break;
+        case 0x0A:
+            IOP_WRITE(rt, static_cast<int32_t>(gpr[rs]) < static_cast<int32_t>(simm) ? 1u : 0u);
+            break;
+        case 0x0B:
+            IOP_WRITE(rt, gpr[rs] < simm ? 1u : 0u);
+            break;
+        case 0x0C:
+            IOP_WRITE(rt, gpr[rs] & imm);
+            break;
+        case 0x0D:
+            IOP_WRITE(rt, gpr[rs] | imm);
+            break;
+        case 0x0E:
+            IOP_WRITE(rt, gpr[rs] ^ imm);
+            break;
+        case 0x0F:
+            IOP_WRITE(rt, imm << 16u);
+            break;
+        case 0x10:
+            if (rs == 0x00)
+                IOP_LOAD(rt, cpu.cop0[rd]);
+            else if (rs == 0x04)
+                cpu.cop0[rd] = gpr[rt];
+            else if (rs == 0x10 && (instruction & 63u) == 0x10)
+            {
+                const uint32_t status = cpu.cop0[12];
+                cpu.cop0[12] = (status & ~0x0Fu) | ((status >> 2u) & 0x0Fu);
+            }
+            else
+                core.raiseException(cpu, 10u, pc, wasDelaySlot);
+            break;
+        case 0x20:
+            IOP_LOAD(rt, static_cast<uint32_t>(static_cast<int32_t>(static_cast<int8_t>(mem.read8(gpr[rs] + simm)))));
+            break;
+        case 0x24:
+            IOP_LOAD(rt, mem.read8(gpr[rs] + simm));
+            break;
+        case 0x21:
+        case 0x25:
+        {
+            const uint32_t address = gpr[rs] + simm;
+            if (address & 1u)
+            {
+                core.raiseException(cpu, 4u, pc, wasDelaySlot, address);
+                break;
+            }
+            const uint16_t value = mem.read16(address);
+            IOP_LOAD(rt, opcode == 0x21 ? static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(value))) : value);
+            break;
+        }
+        case 0x22:
+        {
+            const uint32_t address = gpr[rs] + simm;
+            const uint32_t memory = mem.read32(address & ~3u);
+            const uint32_t old = gpr[rt];
+            static constexpr uint32_t masks[4] = {0x00FFFFFFu, 0x0000FFFFu, 0x000000FFu, 0x00000000u};
+            static constexpr uint32_t shifts[4] = {24u, 16u, 8u, 0u};
+            IOP_LOAD(rt, (old & masks[address & 3u]) | (memory << shifts[address & 3u]));
+            break;
+        }
+        case 0x23:
+        {
+            const uint32_t address = gpr[rs] + simm;
+            if (address & 3u)
+            {
+                core.raiseException(cpu, 4u, pc, wasDelaySlot, address);
+                break;
+            }
+            IOP_LOAD(rt, mem.read32(address));
+            break;
+        }
+        case 0x26:
+        {
+            const uint32_t address = gpr[rs] + simm;
+            const uint32_t memory = mem.read32(address & ~3u);
+            const uint32_t old = gpr[rt];
+            static constexpr uint32_t masks[4] = {0x00000000u, 0xFF000000u, 0xFFFF0000u, 0xFFFFFF00u};
+            static constexpr uint32_t shifts[4] = {0u, 8u, 16u, 24u};
+            IOP_LOAD(rt, (old & masks[address & 3u]) | (memory >> shifts[address & 3u]));
+            break;
+        }
+        case 0x28:
+            mem.write8(gpr[rs] + simm, static_cast<uint8_t>(gpr[rt]));
+            break;
+        case 0x29:
+        {
+            const uint32_t address = gpr[rs] + simm;
+            if (address & 1u)
+            {
+                core.raiseException(cpu, 5u, pc, wasDelaySlot, address);
+                break;
+            }
+            mem.write16(address, static_cast<uint16_t>(gpr[rt]));
+            break;
+        }
+        case 0x2A:
+        {
+            const uint32_t address = gpr[rs] + simm;
+            const uint32_t aligned = address & ~3u;
+            const uint32_t old = mem.read32(aligned);
+            const uint32_t value = gpr[rt];
+            uint32_t result = old;
+            switch (address & 3u)
+            {
+            case 0u:
+                result = (old & 0xFFFFFF00u) | (value >> 24u);
+                break;
+            case 1u:
+                result = (old & 0xFFFF0000u) | (value >> 16u);
+                break;
+            case 2u:
+                result = (old & 0xFF000000u) | (value >> 8u);
+                break;
+            case 3u:
+                result = value;
+                break;
+            }
+            mem.write32(aligned, result);
+            break;
+        }
+        case 0x2B:
+        {
+            const uint32_t address = gpr[rs] + simm;
+            if (address & 3u)
+            {
+                core.raiseException(cpu, 5u, pc, wasDelaySlot, address);
+                break;
+            }
+            mem.write32(address, gpr[rt]);
+            break;
+        }
+        case 0x2E:
+        {
+            const uint32_t address = gpr[rs] + simm;
+            const uint32_t aligned = address & ~3u;
+            const uint32_t old = mem.read32(aligned);
+            const uint32_t value = gpr[rt];
+            uint32_t result = old;
+            switch (address & 3u)
+            {
+            case 0u:
+                result = value;
+                break;
+            case 1u:
+                result = (old & 0x000000FFu) | (value << 8u);
+                break;
+            case 2u:
+                result = (old & 0x0000FFFFu) | (value << 16u);
+                break;
+            case 3u:
+                result = (old & 0x00FFFFFFu) | (value << 24u);
+                break;
+            }
+            mem.write32(aligned, result);
+            break;
+        }
+        default:
+            core.raiseException(cpu, 10u, pc, wasDelaySlot);
+            break;
+        }
+
+#undef IOP_WRITE
+#undef IOP_LOAD
+#undef IOP_BRANCH
+
+        gpr[0] = 0u;
+        if (cpu.exception)
+            return !cpu.stopped;
+
+        if (cpu.pendingLoad)
+        {
+            if (cpu.pendingLoadReg != 0u && cpu.pendingLoadReg != writtenReg)
+                gpr[cpu.pendingLoadReg] = cpu.pendingLoadValue;
+            cpu.pendingLoad = false;
+        }
+        if (scheduledLoad)
+        {
+            cpu.pendingLoad = true;
+            cpu.pendingLoadReg = scheduledReg;
+            cpu.pendingLoadValue = scheduledValue;
+        }
+
+        if (wasDelaySlot)
+        {
+            cpu.pc = cpu.branchTarget;
+            cpu.branchPending = false;
+        }
+        else
+        {
+            cpu.pc = nextPc;
+            cpu.branchPending = newBranch;
+            cpu.branchTarget = newBranchTarget;
+        }
+        return !cpu.stopped;
+    }
+}
