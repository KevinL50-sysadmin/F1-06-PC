+    std::string launcherProgressFraction(uint64_t done, uint64_t total)
+    {
+        if (total == 0u || done >= total)
+            return "1";
+        const uint64_t hundredths = done * 100u / total; // below 100: done < total, far from overflowing
+        if (hundredths == 0u)
+            return "0";
+        std::string digits = std::to_string(hundredths / 10u) + std::to_string(hundredths % 10u);
+        if (digits.back() == '0')
+            digits.pop_back();
+        return "0." + digits; // integers only: no locale decimal separator
+    }
+
+    std::string launcherProgressLine(uint64_t done, uint64_t total)
+    {
+        return "progress " + launcherProgressFraction(done, total) + " Copying the game data (" +
+               std::to_string(done / (1024u * 1024u)) + " of " + std::to_string(total / (1024u * 1024u)) + " MB)";
+    }
