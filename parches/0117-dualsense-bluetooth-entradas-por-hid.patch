+        // Informe simple 0x01 (Bluetooth sin activar) o completo 0x31 (Bluetooth activado), como SDL (hidapi_ps5).
+        static bool parseInput(const uint8_t *r, DWORD size, ps2_pad_win::DualSenseInput &o)
+        {
+            uint8_t lx, ly, rx, ry, l2, r2, b0, b1, b2;
+            if (r[0] == 0x31 && size >= 13u)
+            {
+                const uint8_t *p = r + 2; // r[1]: secuencia y banderas
+                lx = p[0], ly = p[1], rx = p[2], ry = p[3], l2 = p[4], r2 = p[5]; // p[6]: contador
+                b0 = p[7], b1 = p[8], b2 = p[9];
+            }
+            else if (r[0] == 0x01 && size >= 10u)
+            {
+                const uint8_t *p = r + 1;
+                lx = p[0], ly = p[1], rx = p[2], ry = p[3];
+                b0 = p[4], b1 = p[5], b2 = p[6], l2 = p[7], r2 = p[8];
+            }
+            else
+                return false;
+            auto stick = [](uint8_t v) { return std::clamp((static_cast<float>(v) - 128.0f) / 127.0f, -1.0f, 1.0f); };
+            o.lx = stick(lx);
+            o.ly = stick(ly);
+            o.rx = stick(rx);
+            o.ry = stick(ry);
+            o.l2 = static_cast<float>(l2) / 255.0f;
+            o.r2 = static_cast<float>(r2) / 255.0f;
+            const unsigned hat = b0 & 0x0Fu; // 0 arriba, en el sentido del reloj; 8 suelta
+            o.up = hat == 0u || hat == 1u || hat == 7u;
+            o.right = hat >= 1u && hat <= 3u;
+            o.down = hat >= 3u && hat <= 5u;
+            o.left = hat >= 5u && hat <= 7u;
+            o.square = (b0 & 0x10u) != 0u;
+            o.cross = (b0 & 0x20u) != 0u;
+            o.circle = (b0 & 0x40u) != 0u;
+            o.triangle = (b0 & 0x80u) != 0u;
+            o.l1 = (b1 & 0x01u) != 0u;
+            o.r1 = (b1 & 0x02u) != 0u;
+            o.l2Button = (b1 & 0x04u) != 0u;
+            o.r2Button = (b1 & 0x08u) != 0u;
+            o.create = (b1 & 0x10u) != 0u;
+            o.options = (b1 & 0x20u) != 0u;
+            o.l3 = (b1 & 0x40u) != 0u;
+            o.r3 = (b1 & 0x80u) != 0u;
+            o.ps = (b2 & 0x01u) != 0u;
+            return true;
+        }
