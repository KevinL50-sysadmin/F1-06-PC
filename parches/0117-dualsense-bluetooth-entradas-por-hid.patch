+            std::vector<uint8_t> buffer(std::max<DWORD>(reportSize, 78u));
+            bool first = true;
+            while (handle != INVALID_HANDLE_VALUE)
+            {
+                DWORD read = 0;
+                if (!ReadFile(handle, buffer.data(), reportSize, &read, nullptr))
+                    break;
+                ps2_pad_win::DualSenseInput input;
+                if (!parseInput(buffer.data(), read, input))
