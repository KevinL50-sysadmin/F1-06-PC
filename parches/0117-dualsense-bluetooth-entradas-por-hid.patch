+                    std::fprintf(stderr, "[pad] DualSense por Bluetooth: entradas por HID (informe 0x%02x)\n", buffer[0]);
+                }
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_input = input;
+                m_inputValid = true;
+            }
+            if (handle != INVALID_HANDLE_VALUE)
+                CloseHandle(handle);
+            std::fprintf(stderr, "[pad] DualSense por Bluetooth: se dejan de leer sus entradas (desconectado)\n");
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_inputValid = false;
+                m_readerRunning = false;
+                m_lost = true;
+            }
+            m_cv.notify_one();
+        }
