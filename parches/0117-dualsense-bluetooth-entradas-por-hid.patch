+        bool create = false, options = false, ps = false;
+        bool up = false, down = false, left = false, right = false;
+    };
+    // true si hay un DualSense por Bluetooth mandando entradas (y deja en out las ultimas).
+    bool readDualSenseBluetooth(DualSenseInput &out);
 }
