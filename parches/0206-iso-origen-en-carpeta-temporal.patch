+        // path is folder or somewhere under it (the same folder however it is spelled: case, junctions, "..").
+        bool insideFolder(const fs::path &path, const fs::path &folder)
+        {
+            std::error_code error;
+            if (!fs::is_directory(folder, error))
+                return false;
+            fs::path at = fs::absolute(path, error);
+            if (error)
+                return false;
+            for (;;)
+            {
+                if (sameFolder(at, folder))
+                    return true;
+                const fs::path up = at.parent_path();
+                if (up == at || up.empty())
+                    return false;
+                at = up;
+            }
+        }
