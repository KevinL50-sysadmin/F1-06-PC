+namespace
+{
+    // PS2X_EE_DESPACHOS=1: see EeScheduler::run.
+    bool eeDispatchCounting()
+    {
+        static const bool s_on = []()
+        {
+            const char *value = std::getenv("PS2X_EE_DESPACHOS");
+            return value != nullptr && value[0] == '1';
+        }();
+        return s_on;
+    }
+    // table 0: dispatches (kind 0xFF: thread code), 1: exits (kind 0 returned, 1 transfer), 2: postponed dispatches.
+    bool eeDispatchCount(int table, uint32_t pc, uint32_t kind, int thread)
+    {
+        static std::unordered_map<uint64_t, uint64_t> s_counts[3];
+        static uint64_t s_total = 0u;
+        static auto s_start = std::chrono::steady_clock::now();
+        ++s_counts[table][static_cast<uint64_t>(pc) | (static_cast<uint64_t>(kind & 0xFFu) << 32) |
+                          (static_cast<uint64_t>(static_cast<uint32_t>(thread) & 0xFFFFu) << 40)];
+        if (table != 0 || (++s_total & 4095u) != 0u)
+            return false;
+        const auto now = std::chrono::steady_clock::now();
+        const double seconds = std::chrono::duration<double>(now - s_start).count();
+        if (seconds < 5.0)
+            return false;
+        static const char *const kNames[3] = {"despachos", "salidas", "aplazados"};
+        for (int k = 0; k < 3; ++k)
+        {
+            std::vector<std::pair<uint64_t, uint64_t>> top(s_counts[k].begin(), s_counts[k].end());
+            std::sort(top.begin(), top.end(), [](const auto &a, const auto &b) { return a.second > b.second; });
+            uint64_t all = 0u;
+            for (const auto &item : top)
+                all += item.second;
+            std::fprintf(stderr, "[ee:%s] %.0f/s en %zu sitios:", kNames[k], static_cast<double>(all) / seconds,
+                         top.size());
+            for (size_t i = 0; i < top.size() && i < 10u; ++i)
+            {
+                const uint32_t code = static_cast<uint32_t>((top[i].first >> 32) & 0xFFu);
+                const char *tag = k == 1 ? (code == 0u ? "r" : "t") : k == 2 ? "" : (code == 0xFFu ? "h" : "inv");
+                std::fprintf(stderr, " pc=0x%x hilo=%u %s", static_cast<uint32_t>(top[i].first),
+                             static_cast<uint32_t>(top[i].first >> 40), tag);
+                if (k == 0 && code != 0xFFu)
+                    std::fprintf(stderr, "%u", code);
+                std::fprintf(stderr, " x%llu", static_cast<unsigned long long>(top[i].second));
+            }
+            std::fprintf(stderr, "\n");
+            s_counts[k].clear();
+        }
+        s_total = 0u;
+        s_start = now;
+        return true;
+    }
+}
 
