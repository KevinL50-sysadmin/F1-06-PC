+            t.IsTrue(waitFor([&] { return guest.status().state == GuestState::Connected; }), "guest connected");
+            t.IsTrue(waitFor([&] { return host.guestConnected() && remotePadActive(); }), "host has the guest");
+            t.Equals(padPortState(rdram, 1), 6u, "port 2 STABLE (a pad) with the guest");
