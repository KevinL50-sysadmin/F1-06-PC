+// Fase 5 (T15, netplay N1): the host and the guest over TCP (Winsock 2). One thread per side; the game thread only
+// reads the guest's last pad (readRemotePad). Nothing received is ever executed or loaded: the frames are fixed-size
+// records (ps2_netplay_protocol.h) checked before they are read.
+namespace ps2x::netplay
+{
+    namespace
+    {
+        using Clock = std::chrono::steady_clock;
+
+        constexpr int kHandshakeTimeoutMs = 5000; // from the connection to WELCOME
+        constexpr int kIdleTimeoutMs = 5000;      // nothing received for this long: the other side is gone
+        constexpr int kPingIntervalMs = 1000;
+        constexpr int kPadIntervalUs = 16667;     // ~60 Hz
+        constexpr int kAuthFailureDelayMs = 1000; // no new connection is taken for this long after a wrong password
+        constexpr int kStatsIntervalMs = 10000;
+        constexpr int kConnectTimeoutMs = 5000;
+        constexpr int kSendTimeoutMs = 2000;
+        constexpr int kPollMs = 20;
+
+        void logLine(const char *format, ...)
+        {
+            char text[512];
+            va_list args;
+            va_start(args, format);
+            std::vsnprintf(text, sizeof(text), format, args);
+            va_end(args);
+            std::fprintf(stderr, "[red] %s\n", text);
+            std::fflush(stderr);
+        }
+
+        int elapsedMs(Clock::time_point since, Clock::time_point now)
+        {
+            return static_cast<int>(std::chrono::duration_cast<std::chrono::milliseconds>(now - since).count());
+        }
+
+        uint32_t clockMs()
+        {
+            return static_cast<uint32_t>(
+                std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now().time_since_epoch()).count());
+        }
+
+        // The guest's pad for the second port, owned by the host that has a guest.
+        std::mutex g_remoteMutex;
+        const void *g_remoteOwner = nullptr;
+        PadWire g_remotePad;
+
+        void setRemote(const void *owner, const PadWire &pad)
+        {
+            std::lock_guard<std::mutex> lock(g_remoteMutex);
+            g_remoteOwner = owner;
+            g_remotePad = pad;
+        }
+
+        void clearRemote(const void *owner)
+        {
+            std::lock_guard<std::mutex> lock(g_remoteMutex);
+            if (g_remoteOwner == owner)
+            {
+                g_remoteOwner = nullptr;
+                g_remotePad = PadWire{};
+            }
+        }
+
+        void put32(uint8_t *out, uint32_t value)
+        {
+            for (int i = 0; i < 4; ++i)
+                out[i] = static_cast<uint8_t>(value >> (8 * i));
+        }
+
+        uint32_t get32(const uint8_t *in)
+        {
+            return uint32_t(in[0]) | (uint32_t(in[1]) << 8) | (uint32_t(in[2]) << 16) | (uint32_t(in[3]) << 24);
+        }
+
+#if defined(_WIN32)
+        bool ensureWinsock()
+        {
+            static const bool s_ready = []
+            {
+                WSADATA data;
+                return WSAStartup(MAKEWORD(2, 2), &data) == 0;
+            }();
+            return s_ready;
+        }
+
+        std::string socketError(int code)
+        {
+            char text[256] = {};
+            if (FormatMessageA(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, nullptr,
+                               static_cast<DWORD>(code), MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT), text,
+                               sizeof(text), nullptr) == 0)
+                return "error " + std::to_string(code);
+            std::string s(text);
+            while (!s.empty() && (s.back() == '\n' || s.back() == '\r' || s.back() == ' ' || s.back() == '.'))
+                s.pop_back();
+            return s + " (" + std::to_string(code) + ")";
+        }
+
+        // "1.2.3.4:5" or "[fd7a::1]:5" (an IPv4 client of a dual-stack socket shows as IPv4).
+        std::string addressText(const sockaddr *address, int length, bool withPort = true)
+        {
+            char host[NI_MAXHOST] = {}, service[NI_MAXSERV] = {};
+            if (getnameinfo(address, length, host, sizeof(host), service, sizeof(service),
+                            NI_NUMERICHOST | NI_NUMERICSERV) != 0)
+                return "?";
+            std::string h(host);
+            if (h.rfind("::ffff:", 0) == 0 && h.find('.') != std::string::npos)
+                h = h.substr(7);
+            const bool v6 = h.find(':') != std::string::npos;
+            if (!withPort)
+                return h;
+            return (v6 ? "[" + h + "]" : h) + ":" + service;
+        }
+
+        void closeSocket(SOCKET &s)
+        {
+            if (s != INVALID_SOCKET)
+            {
+                closesocket(s);
+                s = INVALID_SOCKET;
+            }
+        }
+
+        void setNonBlocking(SOCKET s)
+        {
+            u_long on = 1;
+            ioctlsocket(s, FIONBIO, &on);
+        }
+
+        void setNoDelay(SOCKET s)
+        {
+            BOOL on = TRUE;
+            setsockopt(s, IPPROTO_TCP, TCP_NODELAY, reinterpret_cast<const char *>(&on), sizeof(on));
+        }
+
+        // Sends every byte, waiting for room up to kSendTimeoutMs.
+        bool sendAll(SOCKET s, const std::vector<uint8_t> &bytes)
+        {
+            size_t sent = 0;
+            const Clock::time_point start = Clock::now();
+            while (sent < bytes.size())
+            {
+                const int n = send(s, reinterpret_cast<const char *>(bytes.data() + sent),
+                                   static_cast<int>(bytes.size() - sent), 0);
+                if (n > 0)
+                {
+                    sent += static_cast<size_t>(n);
+                    continue;
+                }
+                if (n == SOCKET_ERROR && WSAGetLastError() != WSAEWOULDBLOCK)
+                    return false;
+                if (elapsedMs(start, Clock::now()) > kSendTimeoutMs)
+                    return false;
+                fd_set writable;
+                FD_ZERO(&writable);
+                FD_SET(s, &writable);
+                timeval wait{0, kPollMs * 1000};
+                select(0, nullptr, &writable, nullptr, &wait);
+            }
+            return true;
+        }
+
+        // Reads what is there: >0 bytes, 0 = closed by the other side, -1 = nothing yet, -2 = error.
+        int receiveSome(SOCKET s, uint8_t *buffer, int size)
+        {
+            const int n = recv(s, reinterpret_cast<char *>(buffer), size, 0);
+            if (n > 0)
+                return n;
+            if (n == 0)
+                return 0;
+            return WSAGetLastError() == WSAEWOULDBLOCK ? -1 : -2;
+        }
+
+        // The machine's addresses, to tell the guest where to connect.
+        std::string localAddresses()
+        {
+            char name[256] = {};
+            if (gethostname(name, sizeof(name)) != 0)
+                return "?";
+            addrinfo hints{};
+            hints.ai_family = AF_UNSPEC;
+            hints.ai_socktype = SOCK_STREAM;
+            addrinfo *list = nullptr;
+            if (getaddrinfo(name, nullptr, &hints, &list) != 0)
+                return "?";
+            std::string out;
+            std::vector<std::string> seen;
+            for (addrinfo *a = list; a != nullptr; a = a->ai_next)
+            {
+                const std::string text = addressText(a->ai_addr, static_cast<int>(a->ai_addrlen), false);
+                bool repeated = false;
+                for (const std::string &s : seen)
+                    repeated = repeated || s == text;
+                if (repeated)
+                    continue;
+                seen.push_back(text);
+                out += (out.empty() ? "" : ", ") + text;
+            }
+            freeaddrinfo(list);
+            return out.empty() ? "?" : out;
+        }
+#endif
+    }
+
+    bool remotePadActive()
+    {
+        std::lock_guard<std::mutex> lock(g_remoteMutex);
+        return g_remoteOwner != nullptr;
+    }
+
+    bool readRemotePad(PadWire &pad)
+    {
+        std::lock_guard<std::mutex> lock(g_remoteMutex);
+        if (g_remoteOwner == nullptr)
+            return false;
+        pad = g_remotePad;
+        return true;
+    }
+
+#if defined(_WIN32)
+    struct Host::Impl
+    {
+        HostSettings settings;
+        SOCKET listener = INVALID_SOCKET;
+        std::thread thread;
+        std::atomic<bool> running{false};
+        std::atomic<uint16_t> port{0};
+        std::atomic<bool> connected{false};
+        std::atomic<uint64_t> padMessages{0};
+        std::atomic<uint64_t> rejected{0};
+
+        // The connection (thread only).
+        enum class Phase
+        {
+            None,
+            Handshake,
+            Session,
+        };
+        SOCKET client = INVALID_SOCKET;
+        std::string clientAddress;
+        Phase phase = Phase::None;
+        MessageAuth auth;
+        FrameReader reader{auth};
+        std::unique_ptr<HostHandshake> handshake;
+        Clock::time_point accepted, lastReceived, lastPing, statsStart, acceptAfter;
+        uint32_t pingToken = 0;
+        uint64_t statsPads = 0;
+        uint32_t roundTripMs = 0;
+
+        bool listen(std::string &error);
+        void run();
+        void acceptOne();
+        void drop(const std::string &why, bool sendBye, ByeReason reason);
+        bool sendFrame(MessageType type, const uint8_t *payload, size_t size);
+        void readClient();
+        void onSessionFrame(const Frame &frame);
+        void timers();
+    };
+
+    bool Host::Impl::listen(std::string &error)
+    {
+        if (!ensureWinsock())
+        {
+            error = "Winsock no arranca";
+            return false;
+        }
+        auto bindTo = [&](const sockaddr *address, int length, int family) -> bool
+        {
+            SOCKET s = socket(family, SOCK_STREAM, IPPROTO_TCP);
+            if (s == INVALID_SOCKET)
+            {
+                error = socketError(WSAGetLastError());
+                return false;
+            }
+            BOOL exclusive = TRUE; // nobody else may take the port while it is ours
+            setsockopt(s, SOL_SOCKET, SO_EXCLUSIVEADDRUSE, reinterpret_cast<const char *>(&exclusive), sizeof(exclusive));
+            if (family == AF_INET6)
+            {
+                DWORD v6only = 0; // IPv4 too
+                setsockopt(s, IPPROTO_IPV6, IPV6_V6ONLY, reinterpret_cast<const char *>(&v6only), sizeof(v6only));
+            }
+            if (bind(s, address, length) == SOCKET_ERROR || ::listen(s, 4) == SOCKET_ERROR)
+            {
+                error = socketError(WSAGetLastError());
+                closesocket(s);
+                return false;
+            }
+            setNonBlocking(s);
+            listener = s;
+            sockaddr_storage bound{};
+            int boundLength = sizeof(bound);
+            getsockname(s, reinterpret_cast<sockaddr *>(&bound), &boundLength);
+            port = ntohs(bound.ss_family == AF_INET6 ? reinterpret_cast<sockaddr_in6 *>(&bound)->sin6_port
+                                                     : reinterpret_cast<sockaddr_in *>(&bound)->sin_port);
+            return true;
+        };
+
+        if (settings.listenAddress.empty())
+        {
+            sockaddr_in6 any6{};
+            any6.sin6_family = AF_INET6;
+            any6.sin6_addr = in6addr_any;
+            any6.sin6_port = htons(settings.port);
+            if (!bindTo(reinterpret_cast<sockaddr *>(&any6), sizeof(any6), AF_INET6))
+            {
+                sockaddr_in any4{};
+                any4.sin_family = AF_INET;
+                any4.sin_addr.s_addr = htonl(INADDR_ANY);
+                any4.sin_port = htons(settings.port);
+                if (!bindTo(reinterpret_cast<sockaddr *>(&any4), sizeof(any4), AF_INET))
+                    return false;
+            }
+            logLine("anfitrion escuchando en el puerto TCP %u de todas las interfaces; direcciones de este PC: %s",
+                    static_cast<unsigned>(port.load()), localAddresses().c_str());
+            return true;
+        }
+        // --escuchar: a numeric address only (no name lookups).
+        addrinfo hints{};
+        hints.ai_family = AF_UNSPEC;
+        hints.ai_socktype = SOCK_STREAM;
+        hints.ai_flags = AI_PASSIVE | AI_NUMERICHOST | AI_NUMERICSERV;
+        addrinfo *list = nullptr;
+        const std::string service = std::to_string(settings.port);
+        if (getaddrinfo(settings.listenAddress.c_str(), service.c_str(), &hints, &list) != 0 || list == nullptr)
+        {
+            error = "direccion para escuchar no valida: " + settings.listenAddress;
+            return false;
+        }
+        const bool ok = bindTo(list->ai_addr, static_cast<int>(list->ai_addrlen), list->ai_family);
+        if (ok)
+            logLine("anfitrion escuchando en %s:%u (TCP)", settings.listenAddress.c_str(),
+                    static_cast<unsigned>(port.load()));
+        freeaddrinfo(list);
+        return ok;
+    }
+
+    bool Host::Impl::sendFrame(MessageType type, const uint8_t *payload, size_t size)
+    {
+        const std::vector<uint8_t> frame = encodeFrame(type, payload, size, phase == Phase::Session ? &auth : nullptr);
+        return !frame.empty() && sendAll(client, frame);
+    }
+
+    void Host::Impl::drop(const std::string &why, bool sendBye, ByeReason reason)
+    {
+        if (sendBye && phase == Phase::Session)
+        {
+            const uint8_t payload[1] = {static_cast<uint8_t>(reason)};
+            sendFrame(MessageType::Bye, payload, 1);
+        }
+        if (phase == Phase::Session)
+        {
+            clearRemote(this);
+            connected = false;
+            logLine("invitado %s desconectado (%s); el puerto 2 vuelve a [jugador2] de controles.ini o queda sin mando",
+                    clientAddress.c_str(), why.c_str());
+        }
+        else
+            logLine("conexion de %s cerrada en el saludo (%s)", clientAddress.c_str(), why.c_str());
+        closeSocket(client);
+        phase = Phase::None;
+        handshake.reset();
+        auth.reset();
+        reader.reset();
+    }
+
+    void Host::Impl::acceptOne()
+    {
+        sockaddr_storage from{};
+        int fromLength = sizeof(from);
+        SOCKET s = accept(listener, reinterpret_cast<sockaddr *>(&from), &fromLength);
+        if (s == INVALID_SOCKET)
+            return;
+        const std::string address = addressText(reinterpret_cast<sockaddr *>(&from), fromLength);
+        setNonBlocking(s);
+        setNoDelay(s);
+        if (phase != Phase::None)
+        {
+            uint8_t payload[3] = {static_cast<uint8_t>(RejectReason::Busy), static_cast<uint8_t>(kProtocolVersion & 0xFF),
+                                  static_cast<uint8_t>(kProtocolVersion >> 8)};
+            sendAll(s, encodeFrame(MessageType::Reject, payload, sizeof(payload), nullptr));
+            closesocket(s);
+            logLine("conexion de %s rechazada: ya hay un invitado", address.c_str());
+            return;
+        }
+        client = s;
+        clientAddress = address;
+        phase = Phase::Handshake;
+        auth.reset();
+        reader.reset();
+        handshake = std::make_unique<HostHandshake>(settings.password, auth);
+        accepted = lastReceived = Clock::now();
+        logLine("conexion desde %s: esperando la contrasena", address.c_str());
+    }
+
+    void Host::Impl::onSessionFrame(const Frame &frame)
+    {
+        switch (static_cast<MessageType>(frame.type))
+        {
+        case MessageType::Pad:
+        {
+            uint32_t counter = 0;
+            PadWire pad;
+            if (decodePad(frame.payload.data(), frame.size, counter, pad))
+            {
+                setRemote(this, pad);
+                ++padMessages;
+                ++statsPads;
+            }
+            return;
+        }
+        case MessageType::Ping:
+            sendFrame(MessageType::Pong, frame.payload.data(), frame.size);
+            return;
+        case MessageType::Pong:
+            if (get32(frame.payload.data()) == pingToken)
+                roundTripMs = clockMs() - get32(frame.payload.data() + 4);
+            return;
+        case MessageType::Bye:
+            drop(std::string("el invitado se fue: ") + byeReasonText(frame.payload[0]), false, ByeReason::Quit);
+            return;
+        default:
+            drop("mensaje fuera de lugar en la sesion", true, ByeReason::Protocol);
+            return;
+        }
+    }
+
+    void Host::Impl::readClient()
+    {
+        uint8_t buffer[512];
+        const int n = receiveSome(client, buffer, sizeof(buffer));
+        if (n == -1)
+            return;
+        if (n <= 0)
+        {
+            reader.finish();
+            drop(n == 0 ? (reader.error() == FrameError::Truncated ? "cerro a mitad de un mensaje" : "cerro la conexion")
+                        : "error de red",
+                 false, ByeReason::Quit);
+            return;
+        }
+        lastReceived = Clock::now();
+        if (!reader.feed(buffer, static_cast<size_t>(n)))
+        {
+            drop(std::string("mensaje no valido: ") + frameErrorText(reader.error()), true, ByeReason::Protocol);
+            return;
+        }
+        Frame frame;
+        while (client != INVALID_SOCKET)
+        {
+            const FrameReader::Result result = reader.next(frame);
+            if (result == FrameReader::Result::NeedMore)
+                return;
+            if (result == FrameReader::Result::Error)
+            {
+                drop(std::string("mensaje no valido: ") + frameErrorText(reader.error()), true, ByeReason::Protocol);
+                return;
+            }
+            if (phase == Phase::Session)
+            {
+                onSessionFrame(frame);
+                continue;
+            }
+            std::vector<std::vector<uint8_t>> out;
+            const HostHandshake::Result step = handshake->onFrame(frame, out);
+            for (const std::vector<uint8_t> &bytes : out)
+                sendAll(client, bytes);
+            if (step == HostHandshake::Result::Accepted)
+            {
+                phase = Phase::Session;
+                handshake.reset();
+                connected = true;
+                lastPing = statsStart = Clock::now();
+                statsPads = 0;
+                setRemote(this, PadWire{});
+                logLine("invitado conectado desde %s: es el jugador 2 (puerto 2 conectado al mando remoto)",
+                        clientAddress.c_str());
+            }
+            else if (step == HostHandshake::Result::Rejected)
+            {
+                if (handshake->rejectReason() == RejectReason::Password)
+                {
+                    ++rejected;
+                    acceptAfter = Clock::now() + std::chrono::milliseconds(kAuthFailureDelayMs);
+                    logLine("contrasena incorrecta desde %s: conexion rechazada", clientAddress.c_str());
+                }
+                const std::string why = handshake->reason();
+                drop(why, false, ByeReason::Protocol);
+                return;
+            }
+            else if (step == HostHandshake::Result::Invalid)
+            {
+                const std::string why = handshake->reason();
+                drop(why, false, ByeReason::Protocol);
+                return;
+            }
+        }
+    }
+
+    void Host::Impl::timers()
+    {
+        if (phase == Phase::None)
+            return;
+        const Clock::time_point now = Clock::now();
+        if (phase == Phase::Handshake)
+        {
+            if (elapsedMs(accepted, now) > kHandshakeTimeoutMs)
+                drop("saludo sin terminar en 5 s", false, ByeReason::Timeout);
+            return;
+        }
+        if (elapsedMs(lastReceived, now) > kIdleTimeoutMs)
+        {
+            drop("tiempo agotado: nada recibido en 5 s", true, ByeReason::Timeout);
+            return;
+        }
+        if (elapsedMs(lastPing, now) >= kPingIntervalMs)
+        {
+            lastPing = now;
+            uint8_t payload[8];
+            put32(payload, ++pingToken);
+            put32(payload + 4, clockMs());
+            if (!sendFrame(MessageType::Ping, payload, sizeof(payload)))
+            {
+                drop("no se puede enviar", false, ByeReason::Quit);
+                return;
+            }
+        }
+        const int statsMs = elapsedMs(statsStart, now);
+        if (statsMs >= kStatsIntervalMs)
+        {
+            logLine("mando del invitado: %.1f mensajes/s, ida y vuelta %u ms",
+                    static_cast<double>(statsPads) * 1000.0 / statsMs, static_cast<unsigned>(roundTripMs));
+            statsStart = now;
+            statsPads = 0;
+        }
+    }
+
+    void Host::Impl::run()
+    {
+        while (running)
+        {
+            fd_set readable;
+            FD_ZERO(&readable);
+            const bool canAccept = Clock::now() >= acceptAfter;
+            if (canAccept)
+                FD_SET(listener, &readable);
+            if (client != INVALID_SOCKET)
+                FD_SET(client, &readable);
+            timeval wait{0, kPollMs * 1000};
+            if (readable.fd_count == 0)
+                std::this_thread::sleep_for(std::chrono::milliseconds(kPollMs));
+            else if (select(0, &readable, nullptr, nullptr, &wait) > 0)
+            {
+                if (client != INVALID_SOCKET && FD_ISSET(client, &readable))
+                    readClient();
+                if (canAccept && FD_ISSET(listener, &readable))
+                    acceptOne();
+            }
+            timers();
+        }
+        if (client != INVALID_SOCKET)
+            drop("el anfitrion se cierra", true, ByeReason::Shutdown);
+        closeSocket(listener);
+    }
+
+    Host::Host() : m_impl(std::make_unique<Impl>()) {}
+
+    Host::~Host()
+    {
+        stop();
+    }
+
+    bool Host::start(const HostSettings &settings, std::string &error)
+    {
+        stop();
+        if (settings.password.size() < kMinPasswordSize || settings.password.size() > kMaxPasswordSize)
+        {
+            error = "contrasena de longitud no valida";
+            return false;
+        }
+        m_impl->settings = settings;
+        if (!m_impl->listen(error))
+            return false;
+        if (settings.password.size() < 8)
+            logLine("aviso: contrasena corta (%u caracteres); mejor 8 o mas",
+                    static_cast<unsigned>(settings.password.size()));
+        m_impl->running = true;
+        m_impl->thread = std::thread([impl = m_impl.get()] { impl->run(); });
+        return true;
+    }
+
+    void Host::stop()
+    {
+        if (!m_impl->running.exchange(false))
+            return;
+        if (m_impl->thread.joinable())
+            m_impl->thread.join();
+        clearRemote(m_impl.get());
+    }
+
+    uint16_t Host::port() const
+    {
+        return m_impl->port;
+    }
+
+    bool Host::guestConnected() const
+    {
+        return m_impl->connected;
+    }
+
+    uint64_t Host::padMessages() const
+    {
+        return m_impl->padMessages;
+    }
+
+    uint64_t Host::rejectedLogins() const
+    {
+        return m_impl->rejected;
+    }
+
+    struct Guest::Impl
+    {
+        GuestSettings settings;
+        std::thread thread;
+        std::atomic<bool> running{false};
+        mutable std::mutex mutex;
+        GuestStatus status;
+        PadWire pad;
+
+        void setStatus(GuestState state, const std::string &text)
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            status.state = state;
+            status.text = text;
+        }
+
+        SOCKET connectToHost();
+        void run();
+    };
+
+    SOCKET Guest::Impl::connectToHost()
+    {
+        const std::string target = (settings.host.find(':') != std::string::npos ? "[" + settings.host + "]"
+                                                                                  : settings.host) +
+                                   ":" + std::to_string(settings.port);
+        setStatus(GuestState::Connecting, "Conectando con " + target + "...");
+        logLine("conectando con el anfitrion %s", target.c_str());
+        if (!ensureWinsock())
+        {
+            setStatus(GuestState::Failed, "Winsock no arranca");
+            return INVALID_SOCKET;
+        }
+        addrinfo hints{};
+        hints.ai_family = AF_UNSPEC;
+        hints.ai_socktype = SOCK_STREAM;
+        hints.ai_protocol = IPPROTO_TCP;
+        hints.ai_flags = AI_NUMERICSERV;
+        addrinfo *list = nullptr;
+        const std::string service = std::to_string(settings.port);
+        if (getaddrinfo(settings.host.c_str(), service.c_str(), &hints, &list) != 0 || list == nullptr)
+        {
+            setStatus(GuestState::Failed, "No se encuentra la direccion " + settings.host);
+            logLine("no se encuentra la direccion %s", settings.host.c_str());
+            return INVALID_SOCKET;
+        }
+        std::string lastError = "sin respuesta";
+        SOCKET connected = INVALID_SOCKET;
+        for (addrinfo *a = list; a != nullptr && connected == INVALID_SOCKET && running; a = a->ai_next)
+        {
+            SOCKET s = socket(a->ai_family, a->ai_socktype, a->ai_protocol);
+            if (s == INVALID_SOCKET)
+                continue;
+            setNonBlocking(s);
+            if (connect(s, a->ai_addr, static_cast<int>(a->ai_addrlen)) == SOCKET_ERROR &&
+                WSAGetLastError() != WSAEWOULDBLOCK)
+            {
+                lastError = socketError(WSAGetLastError());
+                closesocket(s);
+                continue;
+            }
+            const Clock::time_point start = Clock::now();
+            bool done = false;
+            while (running && !done && elapsedMs(start, Clock::now()) < kConnectTimeoutMs)
+            {
+                fd_set writable, failed;
+                FD_ZERO(&writable);
+                FD_ZERO(&failed);
+                FD_SET(s, &writable);
+                FD_SET(s, &failed);
+                timeval wait{0, 50 * 1000};
+                if (select(0, nullptr, &writable, &failed, &wait) > 0)
+                {
+                    int code = 0;
+                    int length = sizeof(code);
+                    getsockopt(s, SOL_SOCKET, SO_ERROR, reinterpret_cast<char *>(&code), &length);
+                    if (FD_ISSET(s, &writable) && code == 0)
+                        connected = s;
+                    else
+                        lastError = socketError(code != 0 ? code : WSAECONNREFUSED);
+                    done = true;
+                }
+            }
+            if (connected == INVALID_SOCKET)
+            {
+                if (!done)
+                    lastError = "sin respuesta en 5 s";
+                closesocket(s);
+            }
+        }
+        freeaddrinfo(list);
+        if (connected == INVALID_SOCKET && running)
+        {
+            setStatus(GuestState::Failed, "No se puede conectar con " + target + ": " + lastError);
+            logLine("no se puede conectar con %s: %s", target.c_str(), lastError.c_str());
+        }
+        return connected;
+    }
+
+    void Guest::Impl::run()
+    {
+        SOCKET s = connectToHost();
+        if (s == INVALID_SOCKET)
+            return;
+        setNoDelay(s);
+        setStatus(GuestState::Authenticating, "Conectado; comprobando la contrasena...");
+        MessageAuth auth;
+        FrameReader reader(auth);
+        GuestHandshake handshake(settings.password, auth);
+        bool session = false;
+        bool finished = false;
+        const Clock::time_point started = Clock::now();
+        Clock::time_point lastReceived = started, lastPing = started, statsStart = started;
+        Clock::time_point nextPad = started;
+        uint32_t padCounter = 0, pingToken = 0, sentPads = 0;
+
+        auto end = [&](GuestState state, const std::string &text, bool bye, ByeReason reason)
+        {
+            if (bye && session)
+            {
+                const uint8_t payload[1] = {static_cast<uint8_t>(reason)};
+                sendAll(s, encodeFrame(MessageType::Bye, payload, 1, &auth));
+            }
+            setStatus(state, text);
+            logLine("%s", text.c_str());
+            finished = true;
+        };
+
+        if (!sendAll(s, handshake.hello()))
+            end(GuestState::Failed, "No se puede enviar el saludo", false, ByeReason::Quit);
+        while (!finished)
+        {
+            if (!running)
+            {
+                end(GuestState::Disconnected, "Desconectado: cerrado por el invitado", true, ByeReason::Quit);
+                break;
+            }
+            fd_set readable;
+            FD_ZERO(&readable);
+            FD_SET(s, &readable);
+            timeval wait{0, 5 * 1000};
+            if (select(0, &readable, nullptr, nullptr, &wait) > 0)
+            {
+                uint8_t buffer[512];
+                const int n = receiveSome(s, buffer, sizeof(buffer));
+                if (n == 0 || n == -2)
+                {
+                    end(session ? GuestState::Disconnected : GuestState::Failed,
+                        session ? "El anfitrion cerro la conexion" : "El anfitrion cerro la conexion en el saludo",
+                        false, ByeReason::Quit);
+                    break;
+                }
+                if (n > 0)
+                {
+                    lastReceived = Clock::now();
+                    if (!reader.feed(buffer, static_cast<size_t>(n)))
+                    {
+                        end(GuestState::Failed, std::string("Mensaje no valido del anfitrion: ") +
+                                                    frameErrorText(reader.error()),
+                            true, ByeReason::Protocol);
+                        break;
+                    }
+                    Frame frame;
+                    FrameReader::Result result;
+                    while (!finished && (result = reader.next(frame)) != FrameReader::Result::NeedMore)
+                    {
+                        if (result == FrameReader::Result::Error)
+                        {
+                            end(GuestState::Failed, std::string("Mensaje no valido del anfitrion: ") +
+                                                        frameErrorText(reader.error()),
+                                true, ByeReason::Protocol);
+                            break;
+                        }
+                        if (!session)
+                        {
+                            std::vector<std::vector<uint8_t>> out;
+                            const GuestHandshake::Result step = handshake.onFrame(frame, out);
+                            for (const std::vector<uint8_t> &bytes : out)
+                                sendAll(s, bytes);
+                            if (step == GuestHandshake::Result::Accepted)
+                            {
+                                session = true;
+                                lastPing = statsStart = nextPad = Clock::now();
+                                setStatus(GuestState::Connected, "Conectado: eres el jugador 2");
+                                logLine("conectado al anfitrion: jugador 2");
+                            }
+                            else if (step == GuestHandshake::Result::Rejected)
+                                end(GuestState::Rejected, "El anfitrion rechaza la conexion: " + handshake.reason(),
+                                    false, ByeReason::Quit);
+                            else if (step == GuestHandshake::Result::Failed)
+                                end(GuestState::Failed, "Saludo fallido: " + handshake.reason(), false,
+                                    ByeReason::Protocol);
+                            continue;
+                        }
+                        switch (static_cast<MessageType>(frame.type))
+                        {
+                        case MessageType::Ping:
+                            sendAll(s, encodeFrame(MessageType::Pong, frame.payload.data(), frame.size, &auth));
+                            break;
+                        case MessageType::Pong:
+                            if (get32(frame.payload.data()) == pingToken)
+                            {
+                                std::lock_guard<std::mutex> lock(mutex);
+                                status.roundTripMs = clockMs() - get32(frame.payload.data() + 4);
+                            }
+                            break;
+                        case MessageType::Bye:
+                            end(GuestState::Disconnected,
+                                std::string("El anfitrion cerro la sesion: ") + byeReasonText(frame.payload[0]), false,
+                                ByeReason::Quit);
+                            break;
+                        default:
+                            end(GuestState::Failed, "Mensaje fuera de lugar del anfitrion", true, ByeReason::Protocol);
+                            break;
+                        }
+                    }
+                }
+            }
+            if (finished)
+                break;
+            const Clock::time_point now = Clock::now();
+            if (!session)
+            {
+                if (elapsedMs(started, now) > kHandshakeTimeoutMs)
+                    end(GuestState::Failed, "El anfitrion no termina el saludo en 5 s", false, ByeReason::Timeout);
+                continue;
+            }
+            if (elapsedMs(lastReceived, now) > kIdleTimeoutMs)
+            {
+                end(GuestState::Disconnected, "Tiempo agotado: el anfitrion no responde", true, ByeReason::Timeout);
+                break;
+            }
+            if (now >= nextPad)
+            {
+                nextPad += std::chrono::microseconds(kPadIntervalUs);
+                if (now > nextPad)
+                    nextPad = now + std::chrono::microseconds(kPadIntervalUs);
+                PadWire current;
+                {
+                    std::lock_guard<std::mutex> lock(mutex);
+                    current = pad;
+                }
+                const auto payload = encodePad(++padCounter, current);
+                if (!sendAll(s, encodeFrame(MessageType::Pad, payload.data(), payload.size(), &auth)))
+                {
+                    end(GuestState::Disconnected, "No se puede enviar al anfitrion", false, ByeReason::Quit);
+                    break;
+                }
+                ++sentPads;
+            }
+            if (elapsedMs(lastPing, now) >= kPingIntervalMs)
+            {
+                lastPing = now;
+                uint8_t payload[8];
+                put32(payload, ++pingToken);
+                put32(payload + 4, clockMs());
+                sendAll(s, encodeFrame(MessageType::Ping, payload, sizeof(payload), &auth));
+            }
+            const int statsMs = elapsedMs(statsStart, now);
+            if (statsMs >= kStatsIntervalMs)
+            {
+                uint32_t rtt;
+                {
+                    std::lock_guard<std::mutex> lock(mutex);
+                    rtt = status.roundTripMs;
+                }
+                logLine("mando enviado: %.1f mensajes/s, ida y vuelta %u ms",
+                        static_cast<double>(sentPads) * 1000.0 / statsMs, static_cast<unsigned>(rtt));
+                statsStart = now;
+                sentPads = 0;
+            }
+        }
+        closesocket(s);
+    }
+
+    Guest::Guest() : m_impl(std::make_unique<Impl>()) {}
+
+    Guest::~Guest()
+    {
+        stop();
+    }
+
+    void Guest::start(const GuestSettings &settings)
+    {
+        stop();
+        m_impl->settings = settings;
+        m_impl->status = GuestStatus{};
+        m_impl->running = true;
+        m_impl->thread = std::thread([impl = m_impl.get()] { impl->run(); });
+    }
+
+    void Guest::setPad(const PadWire &pad)
+    {
+        std::lock_guard<std::mutex> lock(m_impl->mutex);
+        m_impl->pad = pad;
+    }
+
+    GuestStatus Guest::status() const
+    {
+        std::lock_guard<std::mutex> lock(m_impl->mutex);
+        return m_impl->status;
+    }
+
+    void Guest::stop()
+    {
+        m_impl->running = false;
+        if (m_impl->thread.joinable())
+            m_impl->thread.join();
+    }
+#else
+    struct Host::Impl
+    {
+    };
+    Host::Host() : m_impl(std::make_unique<Impl>()) {}
+    Host::~Host() = default;
+    bool Host::start(const HostSettings &, std::string &error)
+    {
+        error = "netplay solo en Windows";
+        return false;
+    }
+    void Host::stop() {}
+    uint16_t Host::port() const { return 0; }
+    bool Host::guestConnected() const { return false; }
+    uint64_t Host::padMessages() const { return 0; }
+    uint64_t Host::rejectedLogins() const { return 0; }
+    struct Guest::Impl
+    {
+        GuestStatus status;
+    };
+    Guest::Guest() : m_impl(std::make_unique<Impl>()) {}
+    Guest::~Guest() = default;
+    void Guest::start(const GuestSettings &)
+    {
+        m_impl->status = {GuestState::Failed, "netplay solo en Windows", 0};
+    }
+    void Guest::setPad(const PadWire &) {}
+    GuestStatus Guest::status() const { return m_impl->status; }
+    void Guest::stop() {}
+#endif
+}
diff --git a/ps2xRuntime/src/lib/ps2_netplay.h b/ps2xRuntime/src/lib/ps2_netplay.h
new file mode 100644
index 0000000..6f076db
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_netplay.h
@@ -0,0 +1,96 @@
+#pragma once
+
+#include "ps2_netplay_protocol.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+// Fase 5 (T15, netplay N1): own netplay inside F1-06.exe, by IP (LAN or a VPN like Tailscale/ZeroTier, no router
+// ports). The host runs the game and listens on one TCP port for one guest; the guest (no game, a small window) sends
+// its pad, which the host's game reads on the second PS2 port. N2/N3 add the host's picture and sound.
+// Logs: "[red] ...".
+namespace ps2x::netplay
+{
+    struct HostSettings
+    {
+        std::string listenAddress; // empty: every interface (IPv6 and IPv4)
+        uint16_t port = kDefaultPort; // 0: any free port (tests)
+        std::string password;
+    };
+
+    class Host
+    {
+    public:
+        Host();
+        ~Host();
+        Host(const Host &) = delete;
+        Host &operator=(const Host &) = delete;
+
+        // Listens and serves in its own thread; false (error) if it cannot listen.
+        bool start(const HostSettings &settings, std::string &error);
+        void stop();
+        uint16_t port() const;
+        bool guestConnected() const;
+        uint64_t padMessages() const;
+        uint64_t rejectedLogins() const;
+
+    private:
+        struct Impl;
+        std::unique_ptr<Impl> m_impl;
+    };
+
+    enum class GuestState
+    {
+        Idle,
+        Connecting,
+        Authenticating,
+        Connected,
+        Rejected,     // the host said no (wrong password, busy, version)
+        Disconnected, // the session ended
+        Failed,       // could not connect, or the host broke the protocol
+    };
+
+    struct GuestStatus
+    {
+        GuestState state = GuestState::Idle;
+        std::string text; // for the window and the log
+        uint32_t roundTripMs = 0;
+    };
+
+    struct GuestSettings
+    {
+        std::string host;
+        uint16_t port = kDefaultPort;
+        std::string password;
+    };
+
+    class Guest
+    {
+    public:
+        Guest();
+        ~Guest();
+        Guest(const Guest &) = delete;
+        Guest &operator=(const Guest &) = delete;
+
+        // Connects and serves in its own thread (status() follows it).
+        void start(const GuestSettings &settings);
+        // The pad sent from now on (~60 times per second).
+        void setPad(const PadWire &pad);
+        GuestStatus status() const;
+        // Says goodbye to the host and closes.
+        void stop();
+
+    private:
+        struct Impl;
+        std::unique_ptr<Impl> m_impl;
+    };
+
+    // The guest's pad while a guest is connected to this process's host (the second PS2 port reads it).
+    bool remotePadActive();
+    bool readRemotePad(PadWire &pad);
+
+    // Guest mode of F1-06.exe: its window (state of the connection) and the local pad (player 1 of the guest's own
+    // controles.ini) sent to the host. Returns the process exit code.
+    int runGuestWindow(const GuestSettings &settings);
+}
diff --git a/ps2xRuntime/src/lib/ps2_netplay_crypto.cpp b/ps2xRuntime/src/lib/ps2_netplay_crypto.cpp
new file mode 100644
index 0000000..ce2056f
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_netplay_crypto.cpp
@@ -0,0 +1,232 @@
+#include "ps2_netplay_crypto.h"
+
+#include <algorithm>
+#include <cstring>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <bcrypt.h>
+#else
+#include <fstream>
+#endif
+
+// Fase 5 (T15, netplay N1): see ps2_netplay_crypto.h.
+namespace ps2x::netplay
+{
+    namespace
+    {
+        constexpr uint32_t kRound[64] = {
+            0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+            0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+            0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+            0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+            0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+            0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+            0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+            0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
+
+        inline uint32_t rotr(uint32_t x, int n)
+        {
+            return (x >> n) | (x << (32 - n));
+        }
+    }
+
+    Sha256::Sha256()
+        : m_state{0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19},
+          m_buffer{}
+    {
+    }
+
+    void Sha256::block(const uint8_t *data)
+    {
+        uint32_t w[64];
+        for (int i = 0; i < 16; ++i)
+            w[i] = (uint32_t(data[i * 4]) << 24) | (uint32_t(data[i * 4 + 1]) << 16) | (uint32_t(data[i * 4 + 2]) << 8) |
+                   uint32_t(data[i * 4 + 3]);
+        for (int i = 16; i < 64; ++i)
+        {
+            const uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+            const uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+        }
+        uint32_t a = m_state[0], b = m_state[1], c = m_state[2], d = m_state[3];
+        uint32_t e = m_state[4], f = m_state[5], g = m_state[6], h = m_state[7];
+        for (int i = 0; i < 64; ++i)
+        {
+            const uint32_t s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
+            const uint32_t ch = (e & f) ^ (~e & g);
+            const uint32_t t1 = h + s1 + ch + kRound[i] + w[i];
+            const uint32_t s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
+            const uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+            const uint32_t t2 = s0 + maj;
+            h = g;
+            g = f;
+            f = e;
+            e = d + t1;
+            d = c;
+            c = b;
+            b = a;
+            a = t1 + t2;
+        }
+        m_state[0] += a;
+        m_state[1] += b;
+        m_state[2] += c;
+        m_state[3] += d;
+        m_state[4] += e;
+        m_state[5] += f;
+        m_state[6] += g;
+        m_state[7] += h;
+    }
+
+    void Sha256::update(const void *data, size_t size)
+    {
+        const uint8_t *bytes = static_cast<const uint8_t *>(data);
+        m_length += size;
+        if (m_buffered > 0)
+        {
+            const size_t take = std::min(size, sizeof(m_buffer) - m_buffered);
+            std::memcpy(m_buffer + m_buffered, bytes, take);
+            m_buffered += take;
+            bytes += take;
+            size -= take;
+            if (m_buffered < sizeof(m_buffer))
+                return;
+            block(m_buffer);
+            m_buffered = 0;
+        }
+        while (size >= 64)
+        {
+            block(bytes);
+            bytes += 64;
+            size -= 64;
+        }
+        if (size > 0)
+        {
+            std::memcpy(m_buffer, bytes, size);
+            m_buffered = size;
+        }
+    }
+
+    Digest Sha256::finish()
+    {
+        const uint64_t bits = m_length * 8u;
+        const uint8_t one = 0x80;
+        update(&one, 1);
+        const uint8_t zero = 0;
+        while (m_buffered != 56)
+            update(&zero, 1);
+        uint8_t length[8];
+        for (int i = 0; i < 8; ++i)
+            length[i] = static_cast<uint8_t>(bits >> (56 - 8 * i));
+        update(length, 8);
+        Digest out;
+        for (int i = 0; i < 8; ++i)
+            for (int j = 0; j < 4; ++j)
+                out[static_cast<size_t>(i * 4 + j)] = static_cast<uint8_t>(m_state[i] >> (24 - 8 * j));
+        return out;
+    }
+
+    HmacSha256::HmacSha256(const void *key, size_t keySize) : m_outerKey{}
+    {
+        uint8_t block[64] = {};
+        if (keySize > sizeof(block))
+        {
+            const Digest hashed = sha256(key, keySize);
+            std::memcpy(block, hashed.data(), hashed.size());
+        }
+        else if (keySize > 0)
+            std::memcpy(block, key, keySize);
+        uint8_t inner[64];
+        for (int i = 0; i < 64; ++i)
+        {
+            inner[i] = static_cast<uint8_t>(block[i] ^ 0x36);
+            m_outerKey[i] = static_cast<uint8_t>(block[i] ^ 0x5c);
+        }
+        m_inner.update(inner, sizeof(inner));
+    }
+
+    void HmacSha256::update(const void *data, size_t size)
+    {
+        m_inner.update(data, size);
+    }
+
+    Digest HmacSha256::finish()
+    {
+        const Digest inner = m_inner.finish();
+        Sha256 outer;
+        outer.update(m_outerKey, sizeof(m_outerKey));
+        outer.update(inner.data(), inner.size());
+        return outer.finish();
+    }
+
+    Digest sha256(const void *data, size_t size)
+    {
+        Sha256 h;
+        h.update(data, size);
+        return h.finish();
+    }
+
+    Digest hmacSha256(const void *key, size_t keySize, const void *data, size_t size)
+    {
+        HmacSha256 h(key, keySize);
+        h.update(data, size);
+        return h.finish();
+    }
+
+    void pbkdf2Sha256(const void *password, size_t passwordSize, const void *salt, size_t saltSize, uint32_t iterations,
+                      uint8_t *out, size_t outSize)
+    {
+        // The keyed state is computed once and copied for every HMAC of the chain.
+        const HmacSha256 keyed(password, passwordSize);
+        for (uint32_t blockIndex = 1; outSize > 0; ++blockIndex)
+        {
+            const uint8_t counter[4] = {static_cast<uint8_t>(blockIndex >> 24), static_cast<uint8_t>(blockIndex >> 16),
+                                        static_cast<uint8_t>(blockIndex >> 8), static_cast<uint8_t>(blockIndex)};
+            HmacSha256 first = keyed;
+            first.update(salt, saltSize);
+            first.update(counter, sizeof(counter));
+            Digest u = first.finish();
+            Digest t = u;
+            for (uint32_t i = 1; i < iterations; ++i)
+            {
+                HmacSha256 next = keyed;
+                next.update(u.data(), u.size());
+                u = next.finish();
+                for (size_t j = 0; j < t.size(); ++j)
+                    t[j] ^= u[j];
+            }
+            const size_t take = std::min(outSize, t.size());
+            std::memcpy(out, t.data(), take);
+            out += take;
+            outSize -= take;
+        }
+    }
+
+    bool constantTimeEqual(const void *a, const void *b, size_t size)
+    {
+        const volatile uint8_t *x = static_cast<const volatile uint8_t *>(a);
+        const volatile uint8_t *y = static_cast<const volatile uint8_t *>(b);
+        uint8_t difference = 0;
+        for (size_t i = 0; i < size; ++i)
+            difference = static_cast<uint8_t>(difference | (x[i] ^ y[i]));
+        return difference == 0;
+    }
+
+    bool randomBytes(void *out, size_t size)
+    {
+#if defined(_WIN32)
+        return size <= 0xFFFFFFFFu &&
+               BCryptGenRandom(nullptr, static_cast<PUCHAR>(out), static_cast<ULONG>(size),
+                               BCRYPT_USE_SYSTEM_PREFERRED_RNG) == 0;
+#else
+        std::ifstream random("/dev/urandom", std::ios::binary);
+        return random.read(static_cast<char *>(out), static_cast<std::streamsize>(size)).good();
+#endif
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_netplay_crypto.h b/ps2xRuntime/src/lib/ps2_netplay_crypto.h
new file mode 100644
index 0000000..33e7cc1
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_netplay_crypto.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+// Fase 5 (T15, netplay N1): the hashes the netplay session needs, implemented here so the game takes no new
+// dependency: SHA-256 (FIPS 180-4), HMAC-SHA256 (RFC 2104), PBKDF2-HMAC-SHA256 (RFC 8018), a comparison that does not
+// stop at the first difference and random bytes from the system (BCryptGenRandom).
+namespace ps2x::netplay
+{
+    using Digest = std::array<uint8_t, 32>;
+
+    class Sha256
+    {
+    public:
+        Sha256();
+        void update(const void *data, size_t size);
+        Digest finish();
+
+    private:
+        void block(const uint8_t *data);
+
+        uint32_t m_state[8];
+        uint8_t m_buffer[64];
+        size_t m_buffered = 0;
+        uint64_t m_length = 0; // bytes
+    };
+
+    class HmacSha256
+    {
+    public:
+        HmacSha256(const void *key, size_t keySize);
+        void update(const void *data, size_t size);
+        Digest finish();
+
+    private:
+        Sha256 m_inner;
+        uint8_t m_outerKey[64];
+    };
+
+    Digest sha256(const void *data, size_t size);
+    Digest hmacSha256(const void *key, size_t keySize, const void *data, size_t size);
+    void pbkdf2Sha256(const void *password, size_t passwordSize, const void *salt, size_t saltSize, uint32_t iterations,
+                      uint8_t *out, size_t outSize);
+    // Constant time over size bytes.
+    bool constantTimeEqual(const void *a, const void *b, size_t size);
+    // False if the system has no random source.
+    bool randomBytes(void *out, size_t size);
+}
diff --git a/ps2xRuntime/src/lib/ps2_netplay_guest.cpp b/ps2xRuntime/src/lib/ps2_netplay_guest.cpp
new file mode 100644
index 0000000..043878d
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_netplay_guest.cpp
@@ -0,0 +1,116 @@
+#include "ps2_netplay.h"
+#include "ps2_host_backend.h"
+#include "runtime/ps2_pad.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#if defined(_WIN32)
+// Declared by hand: <windows.h> clashes with raylib names (as in ps2_runtime.cpp).
+extern "C" __declspec(dllimport) int __stdcall SetWindowPos(void *hWnd, void *hWndInsertAfter, int x, int y, int cx,
+                                                            int cy, unsigned int flags);
+#endif
+
+// Fase 5 (T15, netplay N1): the guest's window. It does not run the game: it shows the connection and sends the local
+// pad (player 1 of this PC's controles.ini: keys, gamepad, wheel) to the host ~60 times per second. N2 draws the
+// host's picture here.
+namespace ps2x::netplay
+{
+    namespace
+    {
+        const char *stateName(GuestState state)
+        {
+            switch (state)
+            {
+            case GuestState::Idle: return "SIN CONEXION";
+            case GuestState::Connecting: return "CONECTANDO";
+            case GuestState::Authenticating: return "COMPROBANDO LA CONTRASENA";
+            case GuestState::Connected: return "CONECTADO";
+            case GuestState::Rejected: return "RECHAZADO";
+            case GuestState::Disconnected: return "DESCONECTADO";
+            case GuestState::Failed: return "ERROR";
+            }
+            return "?";
+        }
+
+        std::string pressedNames(const PadWire &pad)
+        {
+            static const char *const kNames[16] = {"SELECT", "L3", "R3", "START", "ARRIBA", "DERECHA", "ABAJO",
+                                                   "IZQUIERDA", "L2", "R2", "L1", "R1", "TRIANGULO", "CIRCULO",
+                                                   "CRUZ", "CUADRADO"};
+            std::string out;
+            for (int b = 0; b < 16; ++b)
+                if ((pad.pressed >> b) & 1u)
+                    out += (out.empty() ? "" : " ") + std::string(kNames[b]);
+            return out.empty() ? "-" : out;
+        }
+    }
+
+    int runGuestWindow(const GuestSettings &settings)
+    {
+        // PS2X_BACKGROUND_WINDOW=1 (automated runs), as the game's window: never takes the focus, off-screen.
+        const char *background = std::getenv("PS2X_BACKGROUND_WINDOW");
+        const bool backgroundWindow = background && background[0] != '\0' && background[0] != '0';
+        unsigned int flags = FLAG_WINDOW_RESIZABLE;
+        if (backgroundWindow)
+            flags |= FLAG_WINDOW_HIDDEN | FLAG_WINDOW_UNFOCUSED | FLAG_WINDOW_ALWAYS_RUN;
+        SetConfigFlags(flags);
+        SetTraceLogLevel(LOG_WARNING);
+        InitWindow(640, 360, "Formula One 06 - invitado (jugador 2)");
+#if defined(_WIN32)
+        if (backgroundWindow)
+            SetWindowPos(GetWindowHandle(), reinterpret_cast<void *>(1) /* HWND_BOTTOM */, -4000, 0, 0, 0,
+                         0x0001u /* SWP_NOSIZE */ | 0x0010u /* SWP_NOACTIVATE */ | 0x0040u /* SWP_SHOWWINDOW */);
+#endif
+        SetExitKey(KEY_NULL); // ESC may be one of the player's controls
+        SetTargetFPS(60);
+
+        Guest guest;
+        guest.start(settings);
+        PSPadBackend pad;
+        uint8_t report[32] = {};
+        GuestState lastState = GuestState::Idle;
+        while (!WindowShouldClose())
+        {
+            pad.readState(0, 0, report, sizeof(report));
+            const PadWire wire = padWireFromReport(report);
+            guest.setPad(wire);
+            const GuestStatus status = guest.status();
+            if (status.state != lastState)
+            {
+                lastState = status.state;
+                std::fprintf(stderr, "[red] invitado: %s - %s\n", stateName(status.state), status.text.c_str());
+                std::fflush(stderr);
+            }
+
+            BeginDrawing();
+            ClearBackground(Color{18, 22, 30, 255});
+            DrawText("FORMULA ONE 06 - JUEGO EN RED", 24, 20, 24, RAYWHITE);
+            DrawText("Invitado: tu mando es el del jugador 2 del anfitrion", 24, 56, 18, LIGHTGRAY);
+            const Color stateColor = status.state == GuestState::Connected ? GREEN
+                                     : status.state == GuestState::Connecting ||
+                                             status.state == GuestState::Authenticating
+                                         ? YELLOW
+                                         : RED;
+            DrawText(stateName(status.state), 24, 100, 32, stateColor);
+            DrawText(status.text.c_str(), 24, 142, 18, RAYWHITE);
+            if (status.state == GuestState::Connected)
+            {
+                DrawText(TextFormat("Ida y vuelta: %u ms", static_cast<unsigned>(status.roundTripMs)), 24, 176, 18,
+                         LIGHTGRAY);
+                DrawText(TextFormat("Botones: %s", pressedNames(wire).c_str()), 24, 206, 18, LIGHTGRAY);
+                DrawText(TextFormat("Stick izq: %3u %3u   Stick der: %3u %3u", wire.lx, wire.ly, wire.rx, wire.ry), 24,
+                         236, 18, LIGHTGRAY);
+            }
+            DrawText("La imagen del anfitrion llegara en una version proxima. Cierra la ventana para salir.", 24, 320,
+                     14, GRAY);
+            EndDrawing();
+        }
+        guest.stop();
+        const GuestStatus last = guest.status();
+        std::fprintf(stderr, "[red] invitado cerrado: %s - %s\n", stateName(last.state), last.text.c_str());
+        CloseWindow();
+        return last.state == GuestState::Rejected || last.state == GuestState::Failed ? 2 : 0;
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_netplay_protocol.cpp b/ps2xRuntime/src/lib/ps2_netplay_protocol.cpp
new file mode 100644
index 0000000..d75d36f
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_netplay_protocol.cpp
@@ -0,0 +1,606 @@
+#include "ps2_netplay_protocol.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+
+// Fase 5 (T15, netplay N1): see ps2_netplay_protocol.h.
+namespace ps2x::netplay
+{
+    namespace
+    {
+        // Report order of the pressures (bytes 8-19) and the PS2 button of each.
+        constexpr int kPressureButton[12] = {5, 7, 4, 6, 12, 13, 14, 15, 10, 8, 11, 9};
+
+        constexpr char kKeySalt[] = "F1-06 netplay v1";
+
+        void put16(uint8_t *out, uint16_t value)
+        {
+            out[0] = static_cast<uint8_t>(value & 0xFFu);
+            out[1] = static_cast<uint8_t>(value >> 8);
+        }
+
+        uint16_t get16(const uint8_t *in)
+        {
+            return static_cast<uint16_t>(in[0] | (in[1] << 8));
+        }
+
+        void put32(uint8_t *out, uint32_t value)
+        {
+            for (int i = 0; i < 4; ++i)
+                out[i] = static_cast<uint8_t>(value >> (8 * i));
+        }
+
+        uint32_t get32(const uint8_t *in)
+        {
+            return uint32_t(in[0]) | (uint32_t(in[1]) << 8) | (uint32_t(in[2]) << 16) | (uint32_t(in[3]) << 24);
+        }
+
+        Digest deriveKey(const std::string &password, const uint8_t *hostNonce)
+        {
+            uint8_t salt[sizeof(kKeySalt) - 1 + kNonceSize];
+            std::memcpy(salt, kKeySalt, sizeof(kKeySalt) - 1);
+            std::memcpy(salt + sizeof(kKeySalt) - 1, hostNonce, kNonceSize);
+            Digest key{};
+            pbkdf2Sha256(password.data(), password.size(), salt, sizeof(salt), kKeyIterations, key.data(), key.size());
+            return key;
+        }
+
+        // HMAC(key, label || host nonce || guest nonce).
+        Digest labelled(const Digest &key, const char *label, const uint8_t *hostNonce, const uint8_t *guestNonce)
+        {
+            HmacSha256 h(key.data(), key.size());
+            h.update(label, std::strlen(label));
+            h.update(hostNonce, kNonceSize);
+            h.update(guestNonce, kNonceSize);
+            return h.finish();
+        }
+
+        std::vector<uint8_t> reject(RejectReason reason)
+        {
+            uint8_t payload[3] = {static_cast<uint8_t>(reason)};
+            put16(payload + 1, kProtocolVersion);
+            return encodeFrame(MessageType::Reject, payload, sizeof(payload), nullptr);
+        }
+    }
+
+    int payloadSizeOf(uint8_t type)
+    {
+        switch (static_cast<MessageType>(type))
+        {
+        case MessageType::Hello: return 12;
+        case MessageType::Challenge: return 4 + static_cast<int>(kNonceSize);
+        case MessageType::Auth: return static_cast<int>(kNonceSize) + 32;
+        case MessageType::Welcome: return 33;
+        case MessageType::Reject: return 3;
+        case MessageType::Pad: return static_cast<int>(kPadPayloadSize);
+        case MessageType::Ping: return 8;
+        case MessageType::Pong: return 8;
+        case MessageType::Bye: return 1;
+        }
+        return -1;
+    }
+
+    bool isReservedType(uint8_t type)
+    {
+        return type >= 0x20 && type <= 0x3F;
+    }
+
+    const char *rejectReasonText(uint8_t reason)
+    {
+        switch (static_cast<RejectReason>(reason))
+        {
+        case RejectReason::Version: return "version del protocolo distinta";
+        case RejectReason::Password: return "contrasena incorrecta";
+        case RejectReason::Busy: return "el anfitrion ya tiene un invitado";
+        case RejectReason::Protocol: return "mensaje no valido";
+        }
+        return "motivo desconocido";
+    }
+
+    const char *byeReasonText(uint8_t reason)
+    {
+        switch (static_cast<ByeReason>(reason))
+        {
+        case ByeReason::Quit: return "salio";
+        case ByeReason::Timeout: return "tiempo agotado";
+        case ByeReason::Protocol: return "mensaje no valido";
+        case ByeReason::Shutdown: return "cierre del programa";
+        }
+        return "motivo desconocido";
+    }
+
+    PadWire padWireFromReport(const uint8_t *report)
+    {
+        PadWire pad;
+        pad.pressed = static_cast<uint16_t>(~(report[2] | (report[3] << 8)));
+        pad.rx = report[4];
+        pad.ry = report[5];
+        pad.lx = report[6];
+        pad.ly = report[7];
+        for (int i = 0; i < 12; ++i)
+            pad.pressure[static_cast<size_t>(i)] = (pad.pressed >> kPressureButton[i]) & 1u ? report[8 + i] : 0u;
+        return pad;
+    }
+
+    void padWireToReport(const PadWire &pad, uint8_t *report)
+    {
+        const uint16_t buttons = static_cast<uint16_t>(~pad.pressed);
+        report[2] = static_cast<uint8_t>(buttons & 0xFFu);
+        report[3] = static_cast<uint8_t>(buttons >> 8);
+        report[4] = pad.rx;
+        report[5] = pad.ry;
+        report[6] = pad.lx;
+        report[7] = pad.ly;
+        for (int i = 0; i < 12; ++i)
+            report[8 + i] = (pad.pressed >> kPressureButton[i]) & 1u ? pad.pressure[static_cast<size_t>(i)] : 0u;
+        report[20] = 1u; // pressures valid (Pad.cpp)
+    }
+
+    std::array<uint8_t, kPadPayloadSize> encodePad(uint32_t counter, const PadWire &pad)
+    {
+        std::array<uint8_t, kPadPayloadSize> out{};
+        put32(out.data(), counter);
+        put16(out.data() + 4, pad.pressed);
+        out[6] = pad.rx;
+        out[7] = pad.ry;
+        out[8] = pad.lx;
+        out[9] = pad.ly;
+        std::memcpy(out.data() + 10, pad.pressure.data(), pad.pressure.size());
+        return out;
+    }
+
+    bool decodePad(const uint8_t *payload, size_t size, uint32_t &counter, PadWire &pad)
+    {
+        if (payload == nullptr || size != kPadPayloadSize)
+            return false;
+        counter = get32(payload);
+        pad.pressed = get16(payload + 4);
+        pad.rx = payload[6];
+        pad.ry = payload[7];
+        pad.lx = payload[8];
+        pad.ly = payload[9];
+        std::memcpy(pad.pressure.data(), payload + 10, pad.pressure.size());
+        return true;
+    }
+
+    void MessageAuth::start(const Digest &sessionKey, bool host)
+    {
+        m_key = sessionKey;
+        m_host = host;
+        m_sent = m_received = 0;
+        m_active = true;
+    }
+
+    void MessageAuth::reset()
+    {
+        m_key.fill(0);
+        m_sent = m_received = 0;
+        m_active = false;
+    }
+
+    void MessageAuth::compute(char direction, uint64_t counter, const uint8_t *header, const uint8_t *payload,
+                              size_t size, uint8_t *tag) const
+    {
+        uint8_t prefix[1 + 8];
+        prefix[0] = static_cast<uint8_t>(direction);
+        for (int i = 0; i < 8; ++i)
+            prefix[1 + i] = static_cast<uint8_t>(counter >> (8 * i));
+        HmacSha256 h(m_key.data(), m_key.size());
+        h.update(prefix, sizeof(prefix));
+        h.update(header, kHeaderSize);
+        if (size > 0)
+            h.update(payload, size);
+        const Digest full = h.finish();
+        std::memcpy(tag, full.data(), kTagSize);
+    }
+
+    void MessageAuth::sign(const uint8_t *header, const uint8_t *payload, size_t size, uint8_t *tag)
+    {
+        compute(m_host ? 'H' : 'G', m_sent++, header, payload, size, tag);
+    }
+
+    bool MessageAuth::verify(const uint8_t *header, const uint8_t *payload, size_t size, const uint8_t *tag)
+    {
+        uint8_t expected[kTagSize];
+        compute(m_host ? 'G' : 'H', m_received, header, payload, size, expected);
+        if (!constantTimeEqual(expected, tag, kTagSize))
+            return false;
+        ++m_received;
+        return true;
+    }
+
+    std::vector<uint8_t> encodeFrame(MessageType type, const uint8_t *payload, size_t size, MessageAuth *auth)
+    {
+        const int expected = payloadSizeOf(static_cast<uint8_t>(type));
+        if (expected < 0 || size != static_cast<size_t>(expected) || (size > 0 && payload == nullptr))
+            return {};
+        const bool tagged = auth != nullptr && auth->active();
+        std::vector<uint8_t> out(kHeaderSize + size + (tagged ? kTagSize : 0));
+        out[0] = static_cast<uint8_t>(type);
+        out[1] = 0;
+        put16(out.data() + 2, static_cast<uint16_t>(size));
+        if (size > 0)
+            std::memcpy(out.data() + kHeaderSize, payload, size);
+        if (tagged)
+            auth->sign(out.data(), out.data() + kHeaderSize, size, out.data() + kHeaderSize + size);
+        return out;
+    }
+
+    const char *frameErrorText(FrameError error)
+    {
+        switch (error)
+        {
+        case FrameError::None: return "ninguno";
+        case FrameError::UnknownType: return "tipo desconocido";
+        case FrameError::ReservedType: return "tipo reservado (no existe en esta version)";
+        case FrameError::BadFlags: return "banderas no validas";
+        case FrameError::BadLength: return "longitud no valida";
+        case FrameError::BadTag: return "firma no valida";
+        case FrameError::Overflow: return "demasiados datos pendientes";
+        case FrameError::Truncated: return "mensaje cortado";
+        }
+        return "?";
+    }
+
+    bool FrameReader::feed(const uint8_t *data, size_t size)
+    {
+        if (m_error != FrameError::None)
+            return false;
+        if (size > kPendingLimit || m_pending.size() > kPendingLimit - size)
+        {
+            m_error = FrameError::Overflow;
+            return false;
+        }
+        m_pending.insert(m_pending.end(), data, data + size);
+        return true;
+    }
+
+    FrameReader::Result FrameReader::next(Frame &out)
+    {
+        if (m_error != FrameError::None)
+            return Result::Error;
+        if (m_pending.size() < kHeaderSize)
+            return Result::NeedMore;
+        const uint8_t *h = m_pending.data();
+        const uint8_t type = h[0];
+        const uint16_t length = get16(h + 2);
+        const int expected = payloadSizeOf(type);
+        if (expected < 0)
+            m_error = isReservedType(type) ? FrameError::ReservedType : FrameError::UnknownType;
+        else if (h[1] != 0)
+            m_error = FrameError::BadFlags;
+        else if (length != static_cast<uint16_t>(expected))
+            m_error = FrameError::BadLength;
+        if (m_error != FrameError::None)
+            return Result::Error;
+        const bool tagged = m_auth.active();
+        const size_t total = kHeaderSize + length + (tagged ? kTagSize : 0);
+        if (m_pending.size() < total)
+            return Result::NeedMore;
+        if (tagged && !m_auth.verify(h, h + kHeaderSize, length, h + kHeaderSize + length))
+        {
+            m_error = FrameError::BadTag;
+            return Result::Error;
+        }
+        out.type = type;
+        out.size = static_cast<uint8_t>(length);
+        out.payload.fill(0);
+        std::memcpy(out.payload.data(), h + kHeaderSize, length);
+        m_pending.erase(m_pending.begin(), m_pending.begin() + static_cast<std::ptrdiff_t>(total));
+        return Result::Frame;
+    }
+
+    void FrameReader::finish()
+    {
+        if (m_error == FrameError::None && !m_pending.empty())
+            m_error = FrameError::Truncated;
+    }
+
+    void FrameReader::reset()
+    {
+        m_pending.clear();
+        m_error = FrameError::None;
+    }
+
+    HostHandshake::HostHandshake(std::string password, MessageAuth &auth, RandomSource random)
+        : m_password(std::move(password)), m_auth(auth), m_random(std::move(random))
+    {
+    }
+
+    HostHandshake::Result HostHandshake::onFrame(const Frame &frame, std::vector<std::vector<uint8_t>> &send)
+    {
+        const auto type = static_cast<MessageType>(frame.type);
+        if (m_step == Step::Hello && type == MessageType::Hello)
+        {
+            if (std::memcmp(frame.payload.data(), kMagic, sizeof(kMagic)) != 0)
+            {
+                m_reason = "no es un invitado de F1 06";
+                m_step = Step::Done;
+                return Result::Invalid;
+            }
+            const uint16_t version = get16(frame.payload.data() + 8);
+            if (version != kProtocolVersion)
+            {
+                m_reason = "version del invitado " + std::to_string(version) + ", la nuestra " +
+                           std::to_string(kProtocolVersion);
+                m_rejectReason = RejectReason::Version;
+                send.push_back(reject(RejectReason::Version));
+                m_step = Step::Done;
+                return Result::Rejected;
+            }
+            if (!m_random(m_hostNonce, kNonceSize))
+            {
+                m_reason = "sin fuente de numeros aleatorios";
+                m_step = Step::Done;
+                return Result::Invalid;
+            }
+            uint8_t payload[4 + kNonceSize] = {};
+            put16(payload, kProtocolVersion);
+            std::memcpy(payload + 4, m_hostNonce, kNonceSize);
+            send.push_back(encodeFrame(MessageType::Challenge, payload, sizeof(payload), nullptr));
+            m_step = Step::Auth;
+            return Result::Continue;
+        }
+        if (m_step == Step::Auth && type == MessageType::Auth)
+        {
+            m_step = Step::Done;
+            const uint8_t *guestNonce = frame.payload.data();
+            const Digest key = deriveKey(m_password, m_hostNonce);
+            const Digest expected = labelled(key, "guest", m_hostNonce, guestNonce);
+            if (!constantTimeEqual(expected.data(), frame.payload.data() + kNonceSize, expected.size()))
+            {
+                m_reason = "contrasena incorrecta";
+                m_rejectReason = RejectReason::Password;
+                send.push_back(reject(RejectReason::Password));
+                return Result::Rejected;
+            }
+            const Digest proof = labelled(key, "host", m_hostNonce, guestNonce);
+            uint8_t payload[33];
+            std::memcpy(payload, proof.data(), proof.size());
+            payload[32] = 2; // the second PS2 port
+            send.push_back(encodeFrame(MessageType::Welcome, payload, sizeof(payload), nullptr));
+            m_auth.start(labelled(key, "session", m_hostNonce, guestNonce), true);
+            return Result::Accepted;
+        }
+        m_reason = std::string("mensaje 0x") + "0123456789abcdef"[frame.type >> 4] + "0123456789abcdef"[frame.type & 15] +
+                   " fuera de orden en el saludo";
+        m_step = Step::Done;
+        return Result::Invalid;
+    }
+
+    GuestHandshake::GuestHandshake(std::string password, MessageAuth &auth, RandomSource random)
+        : m_password(std::move(password)), m_auth(auth), m_random(std::move(random))
+    {
+    }
+
+    std::vector<uint8_t> GuestHandshake::hello() const
+    {
+        uint8_t payload[12] = {};
+        std::memcpy(payload, kMagic, sizeof(kMagic));
+        put16(payload + 8, kProtocolVersion);
+        return encodeFrame(MessageType::Hello, payload, sizeof(payload), nullptr);
+    }
+
+    GuestHandshake::Result GuestHandshake::onFrame(const Frame &frame, std::vector<std::vector<uint8_t>> &send)
+    {
+        const auto type = static_cast<MessageType>(frame.type);
+        if (m_step != Step::Done && type == MessageType::Reject)
+        {
+            m_step = Step::Done;
+            m_rejectReason = frame.payload[0];
+            m_hostVersion = get16(frame.payload.data() + 1);
+            m_reason = rejectReasonText(m_rejectReason);
+            return Result::Rejected;
+        }
+        if (m_step == Step::Challenge && type == MessageType::Challenge)
+        {
+            m_hostVersion = get16(frame.payload.data());
+            if (m_hostVersion != kProtocolVersion)
+            {
+                m_step = Step::Done;
+                m_reason = "el anfitrion usa la version " + std::to_string(m_hostVersion) + " del protocolo";
+                return Result::Failed;
+            }
+            std::memcpy(m_hostNonce, frame.payload.data() + 4, kNonceSize);
+            if (!m_random(m_guestNonce, kNonceSize))
+            {
+                m_step = Step::Done;
+                m_reason = "sin fuente de numeros aleatorios";
+                return Result::Failed;
+            }
+            m_key = deriveKey(m_password, m_hostNonce);
+            const Digest proof = labelled(m_key, "guest", m_hostNonce, m_guestNonce);
+            uint8_t payload[kNonceSize + 32];
+            std::memcpy(payload, m_guestNonce, kNonceSize);
+            std::memcpy(payload + kNonceSize, proof.data(), proof.size());
+            send.push_back(encodeFrame(MessageType::Auth, payload, sizeof(payload), nullptr));
+            m_step = Step::Welcome;
+            return Result::Continue;
+        }
+        if (m_step == Step::Welcome && type == MessageType::Welcome)
+        {
+            m_step = Step::Done;
+            const Digest expected = labelled(m_key, "host", m_hostNonce, m_guestNonce);
+            if (!constantTimeEqual(expected.data(), frame.payload.data(), expected.size()))
+            {
+                m_reason = "el anfitrion no conoce la contrasena";
+                return Result::Failed;
+            }
+            if (frame.payload[32] != 2)
+            {
+                m_reason = "puerto del mando no valido";
+                return Result::Failed;
+            }
+            m_auth.start(labelled(m_key, "session", m_hostNonce, m_guestNonce), false);
+            m_key.fill(0);
+            return Result::Accepted;
+        }
+        m_step = Step::Done;
+        m_reason = "mensaje fuera de orden en el saludo";
+        return Result::Failed;
+    }
+
+    bool splitHostPort(const std::string &text, std::string &host, uint16_t &port, bool &hasPort, std::string &error)
+    {
+        hasPort = false;
+        std::string portText;
+        if (!text.empty() && text.front() == '[')
+        {
+            const size_t close = text.find(']');
+            if (close == std::string::npos)
+            {
+                error = "falta ']' en " + text;
+                return false;
+            }
+            host = text.substr(1, close - 1);
+            if (close + 1 < text.size())
+            {
+                if (text[close + 1] != ':')
+                {
+                    error = "direccion no valida: " + text;
+                    return false;
+                }
+                portText = text.substr(close + 2);
+                hasPort = true;
+            }
+        }
+        else
+        {
+            const size_t colon = text.find(':');
+            if (colon != std::string::npos && text.find(':', colon + 1) == std::string::npos)
+            {
+                host = text.substr(0, colon);
+                portText = text.substr(colon + 1);
+                hasPort = true;
+            }
+            else
+                host = text; // no port, or a bare IPv6 address
+        }
+        if (host.empty() || host.size() > 253)
+        {
+            error = "direccion no valida: " + text;
+            return false;
+        }
+        for (char c : host)
+            if (!(std::isalnum(static_cast<unsigned char>(c)) || c == '.' || c == '-' || c == ':' || c == '_' || c == '%'))
+            {
+                error = "direccion no valida: " + text;
+                return false;
+            }
+        if (hasPort)
+        {
+            unsigned long value = 0;
+            bool ok = !portText.empty() && portText.size() <= 5;
+            for (char c : portText)
+                ok = ok && c >= '0' && c <= '9';
+            if (ok)
+                value = std::stoul(portText);
+            if (!ok || value < 1 || value > 65535)
+            {
+                error = "puerto no valido: " + portText;
+                return false;
+            }
+            port = static_cast<uint16_t>(value);
+        }
+        return true;
+    }
+
+    bool parseNetplayArguments(std::vector<std::string> &args, const char *environmentPassword, NetplayOptions &options,
+                               std::string &error)
+    {
+        std::vector<std::string> rest;
+        bool host = false, guest = false, portGiven = false, listenGiven = false, passwordGiven = false;
+        std::string guestAddress, portText;
+        for (size_t i = 0; i < args.size(); ++i)
+        {
+            const std::string &a = args[i];
+            auto value = [&](std::string &out) -> bool
+            {
+                if (i + 1 >= args.size() || args[i + 1].rfind("--", 0) == 0)
+                {
+                    error = a + " necesita un valor";
+                    return false;
+                }
+                out = args[++i];
+                return true;
+            };
+            if (a == "--anfitrion")
+                host = true;
+            else if (a == "--invitado")
+            {
+                guest = true;
+                if (!value(guestAddress))
+                    return false;
+            }
+            else if (a == "--puerto")
+            {
+                portGiven = true;
+                if (!value(portText))
+                    return false;
+            }
+            else if (a == "--escuchar")
+            {
+                listenGiven = true;
+                if (!value(options.listenAddress))
+                    return false;
+            }
+            else if (a == "--clave")
+            {
+                passwordGiven = true;
+                if (!value(options.password))
+                    return false;
+            }
+            else
+                rest.push_back(a);
+        }
+        if (!host && !guest)
+        {
+            if (portGiven || listenGiven || passwordGiven)
+            {
+                error = "--puerto, --escuchar y --clave van con --anfitrion o --invitado";
+                return false;
+            }
+            options.mode = NetplayMode::Off;
+            return true;
+        }
+        if (host && guest)
+        {
+            error = "--anfitrion y --invitado no van juntos";
+            return false;
+        }
+        if (guest && listenGiven)
+        {
+            error = "--escuchar es solo para el anfitrion";
+            return false;
+        }
+        if (portGiven)
+        {
+            std::string ignored;
+            bool hasPort = false;
+            if (!splitHostPort("x:" + portText, ignored, options.port, hasPort, error))
+                return false;
+        }
+        if (guest)
+        {
+            std::string address;
+            uint16_t port = options.port;
+            bool hasPort = false;
+            if (!splitHostPort(guestAddress, address, port, hasPort, error))
+                return false;
+            options.hostAddress = address;
+            options.port = port;
+        }
+        if (!passwordGiven && environmentPassword != nullptr)
+            options.password = environmentPassword;
+        if (options.password.size() < kMinPasswordSize || options.password.size() > kMaxPasswordSize)
+        {
+            error = "la contrasena (--clave o PS2X_RED_CLAVE) debe tener entre " + std::to_string(kMinPasswordSize) +
+                    " y " + std::to_string(kMaxPasswordSize) + " caracteres";
+            return false;
+        }
+        options.mode = host ? NetplayMode::Host : NetplayMode::Guest;
+        args = std::move(rest);
+        return true;
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_netplay_protocol.h b/ps2xRuntime/src/lib/ps2_netplay_protocol.h
new file mode 100644
index 0000000..9beb576
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_netplay_protocol.h
@@ -0,0 +1,270 @@
+#pragma once
+
+#include "ps2_netplay_crypto.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+// Fase 5 (T15, netplay N1): the netplay protocol, without sockets (ps2_netplay.cpp carries it over TCP).
+//
+// Frame: type (1 byte), flags (1, always 0), payload length (2, little endian), payload, and once the session is
+// authenticated a 16-byte tag: HMAC-SHA256(session key, direction 'G'/'H' || frame counter (8, LE) || header ||
+// payload), cut to 16 bytes. Every type has one exact payload size; anything else (unknown or reserved type, flags,
+// another length, a wrong tag) closes the connection before the payload is read.
+//
+// Handshake: guest HELLO (magic "F1-06NP\0", version) -> host CHALLENGE (version, 32-byte host nonce) -> guest AUTH
+// (32-byte guest nonce, proof) -> host WELCOME (proof, port) or REJECT (reason, host version). Both sides derive
+// key = PBKDF2-HMAC-SHA256(password, "F1-06 netplay v1" || host nonce, kKeyIterations); the guest proof is
+// HMAC(key, "guest" || nonces), the host proof HMAC(key, "host" || nonces), the session key HMAC(key, "session" ||
+// nonces). The password never travels; a guest without it gets REJECT, a host without it is refused by the guest.
+//
+// After WELCOME: PAD (guest -> host, ~60 Hz), PING/PONG (keepalive and round trip), BYE. Reserved for later
+// milestones: 0x20-0x2F video (N2), 0x30-0x3F audio (N3); this version rejects them.
+namespace ps2x::netplay
+{
+    constexpr uint16_t kProtocolVersion = 1;
+    constexpr uint16_t kDefaultPort = 50650;
+    constexpr size_t kHeaderSize = 4;
+    constexpr size_t kTagSize = 16;
+    constexpr size_t kNonceSize = 32;
+    constexpr size_t kMaxPayload = 64; // the largest payload of this version (AUTH)
+    constexpr size_t kMaxFrame = kHeaderSize + kMaxPayload + kTagSize;
+    constexpr uint32_t kKeyIterations = 20000;
+    constexpr size_t kMinPasswordSize = 4;
+    constexpr size_t kMaxPasswordSize = 256;
+    constexpr char kMagic[8] = {'F', '1', '-', '0', '6', 'N', 'P', '\0'};
+
+    enum class MessageType : uint8_t
+    {
+        Hello = 0x01,     // guest: magic (8), version (2), reserved (2)
+        Challenge = 0x02, // host: version (2), reserved (2), host nonce (32)
+        Auth = 0x03,      // guest: guest nonce (32), guest proof (32)
+        Welcome = 0x04,   // host: host proof (32), PS2 port of the guest (1: 2 = the second port)
+        Reject = 0x05,    // host: reason (1), host version (2)
+        Pad = 0x10,       // guest: counter (4), pressed buttons (2), rx ry lx ly (4), pressures (12)
+        Ping = 0x11,      // either: token (4), sender time in ms (4)
+        Pong = 0x12,      // either: the ping's payload
+        Bye = 0x13,       // either: reason (1)
+    };
+
+    enum class RejectReason : uint8_t
+    {
+        Version = 1,
+        Password = 2,
+        Busy = 3,
+        Protocol = 4,
+    };
+
+    enum class ByeReason : uint8_t
+    {
+        Quit = 1,
+        Timeout = 2,
+        Protocol = 3,
+        Shutdown = 4,
+    };
+
+    // The payload size of a type of this version; -1 for unknown and reserved types.
+    int payloadSizeOf(uint8_t type);
+    // 0x20-0x3F: video (N2) and audio (N3).
+    bool isReservedType(uint8_t type);
+    const char *rejectReasonText(uint8_t reason);
+    const char *byeReasonText(uint8_t reason);
+
+    // The DualShock 2 state the guest sends: what the game reads from bytes 2-19 of the pad report.
+    struct PadWire
+    {
+        uint16_t pressed = 0;                     // bit = PS2 button (1 = pressed; the report is active low)
+        uint8_t rx = 0x80, ry = 0x80, lx = 0x80, ly = 0x80;
+        std::array<uint8_t, 12> pressure{};       // report order: right left up down triangle circle cross square
+                                                  // l1 l2 r1 r2
+        bool operator==(const PadWire &other) const = default;
+    };
+    constexpr size_t kPadPayloadSize = 22;
+
+    // From / to a pad report (at least 21 bytes, PSPadBackend::readState's layout). A pressure whose button is not
+    // pressed reads 0, as on the real pad.
+    PadWire padWireFromReport(const uint8_t *report);
+    void padWireToReport(const PadWire &pad, uint8_t *report);
+    std::array<uint8_t, kPadPayloadSize> encodePad(uint32_t counter, const PadWire &pad);
+    bool decodePad(const uint8_t *payload, size_t size, uint32_t &counter, PadWire &pad);
+
+    // Per-message tags of an authenticated session (one counter per direction).
+    class MessageAuth
+    {
+    public:
+        void start(const Digest &sessionKey, bool host);
+        void reset();
+        bool active() const { return m_active; }
+        // Tag of the next frame sent / check of the next frame received (each advances its counter).
+        void sign(const uint8_t *header, const uint8_t *payload, size_t size, uint8_t *tag);
+        bool verify(const uint8_t *header, const uint8_t *payload, size_t size, const uint8_t *tag);
+
+    private:
+        void compute(char direction, uint64_t counter, const uint8_t *header, const uint8_t *payload, size_t size,
+                     uint8_t *tag) const;
+
+        bool m_active = false;
+        bool m_host = false;
+        Digest m_key{};
+        uint64_t m_sent = 0;
+        uint64_t m_received = 0;
+    };
+
+    // One frame, tagged when auth is active. The payload must have its type's exact size (otherwise: empty result).
+    std::vector<uint8_t> encodeFrame(MessageType type, const uint8_t *payload, size_t size, MessageAuth *auth);
+
+    enum class FrameError
+    {
+        None,
+        UnknownType,
+        ReservedType,
+        BadFlags,
+        BadLength,
+        BadTag,
+        Overflow,  // more bytes waiting than a frame can hold (the reader is not being drained)
+        Truncated, // the connection closed in the middle of a frame
+    };
+    const char *frameErrorText(FrameError error);
+
+    struct Frame
+    {
+        uint8_t type = 0;
+        uint8_t size = 0;
+        std::array<uint8_t, kMaxPayload> payload{};
+    };
+
+    // Splits the TCP stream into validated frames. Each header is checked before its payload is waited for; the tag
+    // is checked with the auth state of the moment the frame is taken, so a frame that starts the session (WELCOME)
+    // and the tagged ones after it may arrive in the same read.
+    class FrameReader
+    {
+    public:
+        enum class Result
+        {
+            Frame,
+            NeedMore,
+            Error,
+        };
+
+        explicit FrameReader(MessageAuth &auth) : m_auth(auth) {}
+        // False (and error()) if more than kPendingLimit bytes would wait.
+        bool feed(const uint8_t *data, size_t size);
+        Result next(Frame &out);
+        // The connection closed: Truncated if part of a frame was waiting.
+        void finish();
+        FrameError error() const { return m_error; }
+        void reset();
+
+        static constexpr size_t kPendingLimit = 4096;
+
+    private:
+        MessageAuth &m_auth;
+        std::vector<uint8_t> m_pending;
+        FrameError m_error = FrameError::None;
+    };
+
+    using RandomSource = std::function<bool(void *, size_t)>;
+
+    // The handshake of each side, frame by frame. On success both MessageAuth objects are started with the same key.
+    class HostHandshake
+    {
+    public:
+        enum class Result
+        {
+            Continue,
+            Accepted,
+            Rejected, // send the frames and close
+            Invalid,  // close at once
+        };
+
+        HostHandshake(std::string password, MessageAuth &auth, RandomSource random = randomBytes);
+        Result onFrame(const Frame &frame, std::vector<std::vector<uint8_t>> &send);
+        // What went wrong (Rejected / Invalid), for the log.
+        const std::string &reason() const { return m_reason; }
+        RejectReason rejectReason() const { return m_rejectReason; }
+
+    private:
+        enum class Step
+        {
+            Hello,
+            Auth,
+            Done,
+        };
+
+        std::string m_password;
+        MessageAuth &m_auth;
+        RandomSource m_random;
+        Step m_step = Step::Hello;
+        uint8_t m_hostNonce[kNonceSize]{};
+        std::string m_reason;
+        RejectReason m_rejectReason = RejectReason::Protocol;
+    };
+
+    class GuestHandshake
+    {
+    public:
+        enum class Result
+        {
+            Continue,
+            Accepted,
+            Rejected, // the host said no (rejectReason())
+            Failed,   // the host broke the protocol or does not know the password: close
+        };
+
+        GuestHandshake(std::string password, MessageAuth &auth, RandomSource random = randomBytes);
+        std::vector<uint8_t> hello() const;
+        Result onFrame(const Frame &frame, std::vector<std::vector<uint8_t>> &send);
+        const std::string &reason() const { return m_reason; }
+        uint8_t rejectReason() const { return m_rejectReason; }
+        uint16_t hostVersion() const { return m_hostVersion; }
+
+    private:
+        enum class Step
+        {
+            Challenge,
+            Welcome,
+            Done,
+        };
+
+        std::string m_password;
+        MessageAuth &m_auth;
+        RandomSource m_random;
+        Step m_step = Step::Challenge;
+        uint8_t m_hostNonce[kNonceSize]{};
+        uint8_t m_guestNonce[kNonceSize]{};
+        Digest m_key{};
+        std::string m_reason;
+        uint8_t m_rejectReason = 0;
+        uint16_t m_hostVersion = 0;
+    };
+
+    // Command line of the netplay (the game's other arguments stay in args, in order):
+    //   --anfitrion [--escuchar <address>] [--puerto N] --clave <password>
+    //   --invitado <address>[:port] [--puerto N] --clave <password>
+    // Without --clave the password comes from environmentPassword (PS2X_RED_CLAVE), if any. Returns false with
+    // error set when a netplay argument is wrong.
+    enum class NetplayMode
+    {
+        Off,
+        Host,
+        Guest,
+    };
+
+    struct NetplayOptions
+    {
+        NetplayMode mode = NetplayMode::Off;
+        std::string listenAddress; // host: empty = every interface
+        std::string hostAddress;   // guest
+        uint16_t port = kDefaultPort;
+        std::string password;
+    };
+
+    bool parseNetplayArguments(std::vector<std::string> &args, const char *environmentPassword, NetplayOptions &options,
+                               std::string &error);
+    // "1.2.3.4", "1.2.3.4:5000", "name:5000", "[::1]:5000", "::1" (a bare IPv6 address has no port).
+    bool splitHostPort(const std::string &text, std::string &host, uint16_t &port, bool &hasPort, std::string &error);
+}
