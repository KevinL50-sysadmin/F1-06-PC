+// Fase 5 (T15, netplay N1): hashes (published vectors), frames, handshake, pad state, command line and a host and a
+// guest talking over 127.0.0.1 in this process.
+namespace
+{
+    using namespace ps2x::netplay;
+
+    std::string hex(const uint8_t *data, size_t size)
+    {
+        static const char *const kDigits = "0123456789abcdef";
+        std::string out;
+        for (size_t i = 0; i < size; ++i)
+        {
+            out += kDigits[data[i] >> 4];
+            out += kDigits[data[i] & 15];
+        }
+        return out;
+    }
+
+    std::string hex(const Digest &d)
+    {
+        return hex(d.data(), d.size());
+    }
+
+    std::string sha(const std::string &text)
+    {
+        return hex(sha256(text.data(), text.size()));
+    }
+
+    std::string hmac(const std::string &key, const std::string &data)
+    {
+        return hex(hmacSha256(key.data(), key.size(), data.data(), data.size()));
+    }
+
+    // Deterministic "random" bytes for the handshakes.
+    RandomSource counting(uint8_t start)
+    {
+        auto next = std::make_shared<uint8_t>(start);
+        return [next](void *out, size_t size)
+        {
+            uint8_t *bytes = static_cast<uint8_t *>(out);
+            for (size_t i = 0; i < size; ++i)
+                bytes[i] = (*next)++;
+            return true;
+        };
+    }
+
+    std::vector<uint8_t> header(uint8_t type, uint8_t flags, uint16_t length)
+    {
+        return {type, flags, static_cast<uint8_t>(length & 0xFFu), static_cast<uint8_t>(length >> 8)};
+    }
+
+    // Feeds bytes and takes one frame.
+    FrameReader::Result readOne(FrameReader &reader, const std::vector<uint8_t> &bytes, Frame &frame)
+    {
+        if (!reader.feed(bytes.data(), bytes.size()))
+            return FrameReader::Result::Error;
+        return reader.next(frame);
+    }
+
+    // Delivers every frame of one side to the other's handshake.
+    struct Pipe
+    {
+        MessageAuth hostAuth, guestAuth;
+        FrameReader toHost{hostAuth}, toGuest{guestAuth};
+    };
+
+    bool deliver(FrameReader &reader, const std::vector<uint8_t> &bytes, Frame &frame)
+    {
+        return readOne(reader, bytes, frame) == FrameReader::Result::Frame;
+    }
+
+    PadWire crossPressed()
+    {
+        PadWire pad;
+        pad.pressed = 1u << 14; // cross
+        pad.pressure[6] = 200;  // cross pressure
+        pad.lx = 0x10;
+        return pad;
+    }
+
+    template <typename Predicate>
+    bool waitFor(Predicate predicate, int milliseconds = 4000)
+    {
+        const auto end = std::chrono::steady_clock::now() + std::chrono::milliseconds(milliseconds);
+        while (std::chrono::steady_clock::now() < end)
+        {
+            if (predicate())
+                return true;
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+        return predicate();
+    }
+
+    void setRegU32(R5900Context &ctx, int reg, uint32_t value)
+    {
+        ctx.r[reg] = _mm_set_epi64x(0, static_cast<int64_t>(value));
+    }
+
+    uint32_t padPortState(std::vector<uint8_t> &rdram, int port)
+    {
+        R5900Context ctx;
+        setRegU32(ctx, 4, static_cast<uint32_t>(port));
+        setRegU32(ctx, 5, 0u);
+        ps2_stubs::scePadGetState(rdram.data(), &ctx, nullptr);
+        return static_cast<uint32_t>(getRegU32(&ctx, 2));
+    }
+
+    // The game's pad on a test: no physical pads, and a controles.ini that does not exist (no [jugador2]: port 2
+    // is empty without a guest, as in patch 0123).
+    void isolatePads()
+    {
+        static const bool s_done = []
+        {
+            const std::filesystem::path missing =
+                std::filesystem::temp_directory_path() / "ps2x-netplay-tests-sin-controles.ini";
+            std::error_code error;
+            std::filesystem::remove(missing, error);
+            _putenv_s("PS2X_CONTROLES", missing.string().c_str());
+            _putenv_s("PS2X_SIN_MANDOS", "1");
+            return true;
+        }();
+        (void)s_done;
+    }
+}
