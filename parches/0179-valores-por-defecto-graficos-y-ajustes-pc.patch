+    const std::vector<std::string> &gameOptionsPageKeys(int page)
+    {
+        static const std::vector<std::vector<std::string>> pages = {
+            {},
+            {"filtro", "supersampling", "alta_resolucion", "vsync", "mostrar_fps", "pantalla", "volumen"},
+            {"saltar_intro", "latencia_audio", "audio_mono", "vibracion", "daltonismo", "tecla_foto", "hud", "tecla_hud",
+             "cargas_rapidas", "fov", "tecla_modo_foto"},
+            {"aspecto", "tamano_ventana", "gs"},
+            {"red_puerto", "red_calidad", "red_publicas"},
+        };
+        return page > 0 && static_cast<size_t>(page) < pages.size() ? pages[static_cast<size_t>(page)] : pages[0];
+    }
