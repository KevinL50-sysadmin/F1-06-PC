+    namespace
+    {
+        bool integerChoices(const OptionSpec &spec)
+        {
+            for (const OptionChoice &choice : spec.choices)
+                for (const char *c = choice.value; *c != '\0'; ++c)
+                    if (!std::isdigit(static_cast<unsigned char>(*c)))
+                        return false;
+            return true;
+        }
+    }
+
+    bool menuOptionNumber(const OptionsMenuModel &model, const std::string &key, float &number)
+    {
+        const OptionSpec *spec = findSpec(key);
+        const auto found = model.current.find(key);
+        if (spec == nullptr || spec->isValid != nullptr || found == model.current.end())
+            return false;
+        if (integerChoices(*spec))
+        {
+            number = static_cast<float>(std::atoi(found->second.c_str()));
+            return true;
+        }
+        for (size_t i = 0; i < spec->choices.size(); ++i)
+            if (found->second == spec->choices[i].value)
+            {
+                number = static_cast<float>(i);
+                return true;
+            }
+        return false;
+    }
+
+    bool setMenuOptionNumber(OptionsMenuModel &model, const std::string &key, float number)
+    {
+        const OptionSpec *spec = findSpec(key);
+        if (spec == nullptr || spec->isValid != nullptr || !(number > -1e6f && number < 1e6f))
+            return false;
+        const long rounded = std::lround(number);
+        std::string value;
+        if (integerChoices(*spec))
+            value = std::to_string(rounded);
+        else if (rounded >= 0 && static_cast<size_t>(rounded) < spec->choices.size())
+            value = spec->choices[static_cast<size_t>(rounded)].value;
+        else
+            return false;
+        if (key == "alta_resolucion" && value != "0" && !highResolutionAvailable(model))
+            return false;
+        return setMenuOption(model, key, value);
+    }
