+    State &s = *g_gameMenu->m_state;
+    ensureModel(s);
+    return ps2x::setMenuOptionNumber(s.model, key, number);
+}
+
+void PS2OptionsMenu::syncGameOptions(PS2Runtime &runtime)
+{
+    std::lock_guard<std::mutex> lock(g_modelMutex);
+    if (g_gameMenu == nullptr)
+        return;
+    State &s = *g_gameMenu->m_state;
+    ensureModel(s);
+    syncFromRuntime(s.model, s.applied, runtime);
+}
+
+bool PS2OptionsMenu::saveGameOptions()
+{
+    std::lock_guard<std::mutex> lock(g_modelMutex);
+    if (g_gameMenu == nullptr)
+        return false;
+    State &s = *g_gameMenu->m_state;
+    ensureModel(s);
+    saveAndReport(s.model, s.file, s.status, s.statusError);
+    return !s.statusError;
+}
