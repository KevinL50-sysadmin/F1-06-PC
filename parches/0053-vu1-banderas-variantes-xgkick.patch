     PS2_VU_FORCEINLINE void applyFlagSlot(const FlagSlot &e, VU1State &s)
+    {
+        const uint8_t kind = e.kind;
+        const uint32_t mac = e.mac;
+        const uint32_t entryStatus = e.status;
+        const uint32_t sticky = e.sticky;
+        const uint32_t clip = e.clip;
+        if ((kind & (kFlagStatus | kFlagSticky)) != 0u)
+        {
+            uint32_t status = s.status;
+            if ((kind & kFlagStatus) != 0u)
+            {
+                const uint32_t current = entryStatus & 0xFu;
+                status = (status & 0xFF0u) | current | ((current | sticky) << 6);
+            }
