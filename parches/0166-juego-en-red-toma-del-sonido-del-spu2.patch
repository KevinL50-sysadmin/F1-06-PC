+            t.IsTrue(loud > 400, "and they are the sound (" + std::to_string(loud) + " loud frames)");
+            const size_t before = tapped.size();
+            rig.fillHalf(0x2400u, 1000);
+            rig.setSample(1200);
+            t.IsTrue(rig.collect(500u).size() >= 500u, "the host goes on playing");
+            std::lock_guard<std::mutex> lock(s_mutex);
+            t.Equals(s_tapped.size(), before, "nothing tapped after the tap is removed");
