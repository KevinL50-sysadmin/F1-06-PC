+        tc.Run("the SPU2 output tap gets exactly the frames the host plays", [](TestCase &t)
+        {
+            static std::mutex s_mutex;
+            static std::vector<int16_t> s_tapped;
+            {
+                std::lock_guard<std::mutex> lock(s_mutex);
+                s_tapped.clear();
+            }
+            Spu2InputRig rig;
+            ps2x::iop::setSpu2OutputTap([](const int16_t *stereo, std::size_t frames) noexcept
+            {
+                std::lock_guard<std::mutex> lock(s_mutex);
+                for (std::size_t i = 0; i < frames; ++i)
+                    s_tapped.push_back(stereo[i * 2u]);
+            });
+            rig.setSample(0);
+            rig.fillHalf(0x2400u, 1500);
+            rig.fillHalf(0x2500u, -2500);
+            rig.setSample(600);
+            const std::vector<int16_t> played = rig.collect(560u);
+            ps2x::iop::setSpu2OutputTap(nullptr);
+            std::this_thread::sleep_for(std::chrono::milliseconds(50)); // a chunk in flight may still use the old tap
+            std::vector<int16_t> tapped;
+            {
+                std::lock_guard<std::mutex> lock(s_mutex);
+                tapped = s_tapped;
+            }
+            t.IsTrue(played.size() >= 560u, "the host plays the frames");
+            t.IsTrue(tapped.size() >= played.size(), "the tap got them too (" + std::to_string(tapped.size()) + ")");
+            const size_t n = std::min(played.size(), tapped.size());
+            t.IsTrue(n > 0 && std::equal(played.begin(), played.begin() + static_cast<std::ptrdiff_t>(n), tapped.begin()),
