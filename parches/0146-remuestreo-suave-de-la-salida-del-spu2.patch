diff --git a/ps2xIOP/src/emulator/core/iop_spu2_resampler.h b/ps2xIOP/src/emulator/core/iop_spu2_resampler.h
new file mode 100644
index 0000000..f41041c
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2_resampler.h
@@ -0,0 +1,133 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+namespace ps2x::iop::detail
+{
+    // Host output drift correction (patch 0146). The synthesis follows the IOP clock and the audio device its own, so
+    // the host ring slowly fills or drains (~0.06 % in F1 06). Dropping or repeating whole frames to hold the latency
+    // made one click each (~29 per second, the rasp the user heard). Instead, the output stream is resampled
+    // continuously (cubic Hermite between consecutive synthesized frames) with a step that a slow proportional
+    // controller on the smoothed ring fill steers toward the target, clamped to +-0.5 % (under 9 cents, inaudible).
+    // A gross overflow (the IOP catching up after a stall) is the only case that skips input: it fades out, skips until
+    // the ring is back at the target and fades in, so it is a short dip instead of a click.
+    class Spu2OutputResampler
+    {
+    public:
+        static constexpr double TargetFill = 2048.0;             // frames (43 ms; the device pulls 1024 at a time)
+        static constexpr double MaxDeviation = 0.005;            // +-0.5 % of speed
+        static constexpr double FillSmoothing = 1.0 / 16384.0;   // per input frame (0.34 s time constant)
+        static constexpr size_t OverflowFill = 8192u;            // 171 ms: safety valve
+        static constexpr uint32_t FadeFrames = 256u;
+
+        // One synthesized frame; `fill` = frames in the host ring now. Calls emit(left, right) zero, one or two times
+        // (one on average, give or take the ratio).
+        template <typename Emit>
+        void push(int16_t left, int16_t right, size_t fill, Emit &&emit)
+        {
+            const double level = static_cast<double>(fill);
+            if (!m_primed)
+            {
+                m_primed = true;
+                m_fill = level;
+                for (int i = 0; i < 4; ++i)
+                {
+                    m_left[i] = left;
+                    m_right[i] = right;
+                }
+            }
+            for (int i = 0; i < 3; ++i)
+            {
+                m_left[i] = m_left[i + 1];
+                m_right[i] = m_right[i + 1];
+            }
+            m_left[3] = left;
+            m_right[3] = right;
+            ++m_inputFrames;
+
+            if (m_state == State::Skipping)
+            {
+                if (level > TargetFill)
+                {
+                    ++m_dropped;
+                    return;
+                }
+                m_state = State::FadingIn;
+                m_fade = 0;
+                m_fill = level; // the controller starts again from the fill it finds
+            }
+            else if (m_state == State::Normal && fill >= OverflowFill)
+            {
+                m_state = State::FadingOut;
+                m_fade = FadeFrames;
+                ++m_overflows;
+            }
+            m_fill += (level - m_fill) * FillSmoothing;
+            // Input frames consumed per output frame: above the target, play slightly faster to drain the ring.
+            m_step = 1.0 + std::clamp((m_fill - TargetFill) * (MaxDeviation / TargetFill), -MaxDeviation, MaxDeviation);
+
+            while (m_phase < 1.0)
+            {
+                double gain = 1.0;
+                if (m_state == State::FadingOut)
+                {
+                    gain = static_cast<double>(m_fade) / FadeFrames;
+                    if (m_fade == 0u || --m_fade == 0u)
+                        m_state = State::Skipping;
+                }
+                else if (m_state == State::FadingIn)
+                {
+                    gain = static_cast<double>(m_fade) / FadeFrames;
+                    if (++m_fade >= FadeFrames)
+                        m_state = State::Normal;
+                }
+                emit(interpolate(m_left, m_phase, gain), interpolate(m_right, m_phase, gain));
+                ++m_outputFrames;
+                m_phase += m_step;
+                if (m_state == State::Skipping)
+                {
+                    m_phase = 0.0;
+                    return;
+                }
+            }
+            m_phase -= 1.0;
+        }
+
+        // Current output speed against the synthesis, in parts per million (+ = more output frames than input).
+        [[nodiscard]] double ratioPpm() const noexcept { return (1.0 / m_step - 1.0) * 1e6; }
+        [[nodiscard]] uint64_t dropped() const noexcept { return m_dropped; }      // input frames the valve skipped
+        [[nodiscard]] uint64_t overflows() const noexcept { return m_overflows; }  // times the valve triggered
+        [[nodiscard]] uint64_t inputFrames() const noexcept { return m_inputFrames; }
+        [[nodiscard]] uint64_t outputFrames() const noexcept { return m_outputFrames; }
+
+    private:
+        enum class State : uint8_t
+        {
+            Normal,
+            FadingOut,
+            Skipping,
+            FadingIn,
+        };
+
+        // Catmull-Rom between p[1] and p[2] at t in [0, 1).
+        [[nodiscard]] static int16_t interpolate(const int16_t (&p)[4], double t, double gain) noexcept
+        {
+            const double p0 = p[0], p1 = p[1], p2 = p[2], p3 = p[3];
+            const double value =
+                p1 + 0.5 * t * (p2 - p0 + t * (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3 + t * (3.0 * (p1 - p2) + p3 - p0)));
+            return static_cast<int16_t>(std::clamp<long>(std::lround(value * gain), -32768L, 32767L));
+        }
+
+        int16_t m_left[4]{}, m_right[4]{};
+        bool m_primed = false;
+        State m_state = State::Normal;
+        uint32_t m_fade = 0;
+        double m_fill = 0.0;
+        double m_step = 1.0;
+        double m_phase = 0.0;
+        uint64_t m_dropped = 0, m_overflows = 0, m_inputFrames = 0, m_outputFrames = 0;
+    };
+}
