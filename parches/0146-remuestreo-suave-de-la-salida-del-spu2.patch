+    // Patch 0146: a 441 Hz sine (amplitude 8000) through the SPU2 output resampler into a simulated host ring that a
+    // device drains 1024 frames at a time at `consumerRate` frames per synthesized frame (its clock against the IOP's).
+    struct ResamplerRun
+    {
+        static constexpr double kAmplitude = 8000.0;
+        static constexpr double kStep = 2.0 * 3.14159265358979323846 * 441.0 / 48000.0;
+        // Largest sample-to-sample change of the sine itself (played up to 0.5 % faster) plus rounding.
+        static constexpr double kSineDelta = kAmplitude * kStep * 1.006 + 2.0;
+
+        ps2x::iop::detail::Spu2OutputResampler resampler;
+        uint64_t written = 0, read = 0, underruns = 0;
+        double device = 0.0;
+        bool havePrevious = false;
+        int16_t previous = 0;
+        double maxDelta = 0.0;
+        double fillSum = 0.0;
+        uint64_t fillCount = 0;
+
+        // `seconds` of input; the fill is averaged over the last `measureSeconds`.
+        void run(double consumerRate, double seconds, double measureSeconds, uint64_t &frame)
+        {
+            const auto frames = static_cast<uint64_t>(std::llround(seconds * 48000.0));
+            const uint64_t measureFrom = frames - static_cast<uint64_t>(std::llround(measureSeconds * 48000.0));
+            for (uint64_t i = 0; i < frames; ++i, ++frame)
+            {
+                const auto value = static_cast<int16_t>(std::lround(kAmplitude * std::sin(kStep * static_cast<double>(frame))));
+                resampler.push(value, value, static_cast<size_t>(written - read), [&](int16_t left, int16_t)
+                {
+                    if (havePrevious)
+                        maxDelta = std::max(maxDelta, std::abs(static_cast<double>(left) - previous));
+                    previous = left;
+                    havePrevious = true;
+                    ++written;
+                });
+                device += consumerRate;
+                if (device >= 1024.0)
+                {
+                    device -= 1024.0;
+                    if (written - read < 1024u)
+                    {
+                        ++underruns;
+                        read = written;
+                    }
+                    else
+                    {
+                        read += 1024u;
+                    }
+                }
+                if (i >= measureFrom)
+                {
+                    fillSum += static_cast<double>(written - read);
+                    ++fillCount;
+                }
+            }
+        }
+
+        [[nodiscard]] double meanFill() const { return fillCount ? fillSum / static_cast<double>(fillCount) : 0.0; }
+    };
+
+    // Synthesizes `frames` before the device starts (the IOP running ahead, or a stall).
+    void resamplerPreroll(ResamplerRun &run, uint64_t frames, uint64_t &frame)
+    {
+        run.run(0.0, static_cast<double>(frames) / 48000.0, 0.0, frame);
+    }
 }
 
