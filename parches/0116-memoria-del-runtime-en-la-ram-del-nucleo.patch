+
+    // F1 06 (phase 5): memory below the game's ELF (kernel RAM on the console, which a game does not use) for the
+    // runtime's own needs, so the game keeps all of its RAM as on the console. With a low heap set, SetupHeap puts the
+    // runtime heap there and a heap of "rest of RAM" ends where the main thread's stack begins (EndOfHeap reports it),
+    // instead of at 0x1F00000 minus the top reserve. Low stack areas hold the EE invocation stacks (interrupt
+    // handlers and callbacks run on them; on the console they use the kernel's stack), which otherwise are carved from
+    // the end of RAM. Call them from a game override before the game runs SetupThread/SetupHeap.
+    void setRuntimeLowHeap(uint32_t base, uint32_t end);
+    void addRuntimeLowStackArea(uint32_t base, uint32_t end);
+    // A stack of `size` bytes from the low areas: returns its top (16-byte aligned, minus 0x10 like
+    // PS2Runtime::reserveAsyncCallbackStack) or 0 when they are exhausted or not set.
+    uint32_t reserveRuntimeLowStack(uint32_t size);
+    [[nodiscard]] bool runtimeLowStacksActive();
 }
 
 #endif // PS2_HEAP_RESERVE_H
