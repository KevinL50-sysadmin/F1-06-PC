+    std::vector<std::string> windowSizeChoices(const std::vector<std::string> &include, int desktopWidth,
+                                               int desktopHeight)
+    {
+        static constexpr int kCommon[][2] = {{960, 720},   {1280, 720},  {1280, 960},  {1440, 1080}, {1600, 900},
+                                             {1600, 1200}, {1920, 1080}, {1920, 1440}, {2560, 1440}, {3840, 2160}};
+        std::vector<std::pair<int, int>> sizes;
+        const bool desktopKnown = desktopWidth > 0 && desktopHeight > 0;
+        for (const auto &size : kCommon)
+            if (!desktopKnown || (size[0] <= desktopWidth && size[1] <= desktopHeight) ||
+                (size[0] == DisplaySettings{}.windowWidth && size[1] == DisplaySettings{}.windowHeight))
+                sizes.push_back({size[0], size[1]});
+        int width = 0, height = 0;
+        if (desktopKnown && parseWindowSize(windowSizeText(desktopWidth, desktopHeight), width, height))
+            sizes.push_back({width, height});
+        for (const std::string &value : include)
+            if (parseWindowSize(value, width, height))
+                sizes.push_back({width, height});
+        std::sort(sizes.begin(), sizes.end());
+        sizes.erase(std::unique(sizes.begin(), sizes.end()), sizes.end());
+        std::vector<std::string> choices;
+        for (const auto &[w, h] : sizes)
+            choices.push_back(windowSizeText(w, h));
+        return choices;
+    }
