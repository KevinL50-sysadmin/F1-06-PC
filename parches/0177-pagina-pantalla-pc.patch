+
+bool PS2OptionsMenu::gameOptionText(const std::string &key, std::string &value)
+{
+    std::lock_guard<std::mutex> lock(g_modelMutex);
+    if (g_gameMenu == nullptr)
+        return false;
+    State &s = *g_gameMenu->m_state;
+    ensureModel(s);
+    const auto found = s.model.current.find(key);
+    if (found == s.model.current.end())
+        return false;
+    value = found->second;
+    return true;
+}
+
+bool PS2OptionsMenu::setGameOptionText(const std::string &key, const std::string &value)
+{
+    std::lock_guard<std::mutex> lock(g_modelMutex);
+    if (g_gameMenu == nullptr)
+        return false;
+    State &s = *g_gameMenu->m_state;
+    ensureModel(s);
+    return ps2x::setMenuOption(s.model, key, value);
+}
+
+void PS2OptionsMenu::resetGameOptions(const std::vector<std::string> &keys)
+{
+    std::lock_guard<std::mutex> lock(g_modelMutex);
+    if (g_gameMenu == nullptr)
+        return;
+    State &s = *g_gameMenu->m_state;
+    ensureModel(s);
+    ps2x::resetMenuOptionsToDefaults(s.model, keys);
+}
+
+std::vector<std::string> PS2OptionsMenu::gameWindowSizes()
+{
+    std::lock_guard<std::mutex> lock(g_modelMutex);
+    std::vector<std::string> inUse;
+    if (g_gameMenu != nullptr)
+    {
+        State &s = *g_gameMenu->m_state;
+        ensureModel(s);
+        inUse = {valueOf(s.model.saved, "tamano_ventana"), valueOf(s.model.current, "tamano_ventana")};
+    }
+    return ps2x::windowSizeChoices(inUse, g_desktopWidth.load(), g_desktopHeight.load());
+}
+
+std::string PS2OptionsMenu::gameGsInUse()
+{
+    std::lock_guard<std::mutex> lock(g_modelMutex);
+    if (g_gameMenu == nullptr)
+        return ps2GsActiveGpuBackend() != nullptr ? "gpu" : "cpu";
+    State &s = *g_gameMenu->m_state;
+    ensureModel(s);
+    return s.runningGs;
+}
