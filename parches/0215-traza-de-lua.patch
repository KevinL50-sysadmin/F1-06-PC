diff --git a/ps2xRuntime/include/ps2_lua_traza.h b/ps2xRuntime/include/ps2_lua_traza.h
new file mode 100644
index 0000000..a44e08a
--- /dev/null
+++ b/ps2xRuntime/include/ps2_lua_traza.h
@@ -0,0 +1,122 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+// Traza de Lua en los errores de Lua (odd/tasks/fallos-con-log.md T3c, S3): que script, que funcion y que instruccion
+// estaban en marcha cuando el juego lanzo un error de Lua (luaD_throw, src/f1_overrides.cpp del proyecto). Se lee la
+// memoria del invitado (la RAM del EE) sin llamar al juego, comprobando cada direccion: un puntero roto da un marco
+// "ilegible", nunca un fallo del proceso mientras se informa de otro.
+//
+// El Lua del juego es una 5.1-work (los trozos llevan "LuaQ" 0x51; scripts/lua50_ram.py, analisis/listado-ee-crudo.txt):
+//   lua_State: top +0x08, base +0x0C, ci +0x14, base_ci +0x28, errorJmp +0x50.
+//   CallInfo (16 bytes, sin campo de estado): base +0, top +4, savedpc +8, tailcalls +12. La funcion del marco es el
+//     TObject anterior a base (tipo 6 = funcion); la VM guarda su pc en ci->savedpc antes de cada llamada o error
+//     (luaV_execute 0x2A9DD0), apuntando a la instruccion siguiente.
+//   Closure: isC +6, proto (Lua) o funcion (C) +12.
+//   Proto: code +12, p (hijas) +16, lineinfo +20, source +32, sizecode +44, sizelineinfo +52, sizep +56,
+//     lineDefined +60.
+//   TString: tt +4 (4 = cadena), len +12, puntero al texto +16.
+// Los trozos del juego van sin depuracion: fuente "@X" y sin lineinfo (pero con lineDefined). Por eso el nombre del
+// script sale de lua_load (Nombres) y la posicion es la ruta de la funcion en el trozo (F0.3.1, la misma numeracion
+// que scripts/lua_volcados.py pseudo y lua50_ram.py --archivo) con su instruccion; la linea solo si hay lineinfo
+// (trozos de texto de los mods).
+namespace ps2x::luatraza
+{
+    // La RAM del invitado: solo se lee dentro de [0, tam).
+    struct Memoria
+    {
+        const uint8_t *datos = nullptr;
+        uint32_t tam = 0u;
+
+        // dir != 0 y [dir, dir + n) dentro de la RAM (sin desbordar).
+        bool valida(uint32_t dir, uint32_t n) const;
+        // Palabra de 32 bits (little endian) alineada a 4; false si no es valida.
+        bool leer32(uint32_t dir, uint32_t &valor) const;
+        bool leer8(uint32_t dir, uint8_t &valor) const;
+    };
+
+    // El texto de un TString (tipo 4), cortado a maximo caracteres (los no imprimibles salen como '.'); nullopt si la
+    // direccion o su texto no son validos o no es una cadena.
+    std::optional<std::string> cadena(const Memoria &mem, uint32_t tstring, size_t maximo = 200u);
+
+    // Donde va una funcion de Lua: pc = indice de la instruccion en curso ((savedpc - code) / 4 - 1), -1 si savedpc no
+    // cae en el codigo del Proto; linea = lineinfo[pc], -1 sin lineinfo o fuera de sizelineinfo.
+    struct Posicion
+    {
+        int pc = -1;
+        int linea = -1;
+    };
+    Posicion posicion(const Memoria &mem, uint32_t proto, uint32_t savedpc);
+
+    // Nombre del trozo (el de lua_load) de cada Proto cargado y su ruta dentro del trozo ("0" la principal, "0.2" su
+    // tercera hija...). code (el puntero al codigo del Proto) descarta entradas viejas de un Proto ya liberado cuya
+    // direccion se reutilizo.
+    class Nombres
+    {
+    public:
+        struct Entrada
+        {
+            std::string nombre;
+            std::string ruta;
+            uint32_t code = 0u;
+        };
+
+        // Registra el Proto principal de un trozo y todas sus hijas (hasta 32 niveles y 4096 Protos por trozo; los
+        // punteros no validos se saltan). Devuelve cuantos Protos registro. Con mas de kMaximo entradas empieza de cero.
+        size_t registrar(const Memoria &mem, uint32_t protoPrincipal, const std::string &nombre);
+        // La entrada de ese Proto si su code coincide; nullopt si no se conoce.
+        std::optional<Entrada> buscar(uint32_t proto, uint32_t code) const;
+        size_t tam() const;
+
+        static constexpr size_t kMaximo = 65536u;
+
+    private:
+        mutable std::mutex m_mutex;
+        std::unordered_map<uint32_t, Entrada> m_protos;
+    };
+
+    struct Marco
+    {
+        enum class Tipo
+        {
+            Lua,
+            C,
+            Ilegible,
+        };
+        Tipo tipo = Tipo::Ilegible;
+        uint32_t ci = 0u;
+        uint32_t funcion = 0u;   // Lua: el Proto; C: la funcion; Ilegible: 0
+        std::string fuente;      // Lua: Proto->source ("" si no se puede leer)
+        std::string nombre;      // Lua: nombre del trozo (Nombres) o ""
+        std::string ruta;        // Lua: ruta de la funcion en el trozo o ""
+        int lineaDefinida = 0;   // Lua: lineDefined
+        Posicion pos;            // Lua
+        uint32_t llamadasCola = 0u; // Lua: tailcalls perdidas bajo este marco
+    };
+
+    struct Traza
+    {
+        std::vector<Marco> marcos; // de L->ci (el mas reciente) hacia abajo, sin base_ci
+        size_t omitidos = 0u;      // marcos que no caben en maximo
+    };
+
+    // Recorre los CallInfo de L desde L->ci hasta base_ci (sin incluirlo), como mucho maximo marcos. Un marco que no se
+    // puede leer (ci fuera de [base_ci, base_ci + 16 * 4096] o desalineado, base o funcion no validas) acaba la traza con
+    // un marco Ilegible. L no valido: un solo marco Ilegible. nombres puede ser nullptr.
+    Traza recorrer(const Memoria &mem, uint32_t L, size_t maximo, const Nombres *nombres);
+
+    // Una linea por marco (sin prefijo ni salto de linea):
+    //   "#0 FrontEnd/Scripts/X.lua F0.3 instruccion 15 (funcion de la linea 120)"
+    //   "#0 Mod.lua:42 F0.3 instruccion 15 (funcion de la linea 40)"         (con lineinfo)
+    //   "#0 @X proto=0x00ABCDEF instruccion ? (funcion de la linea 120)"     (trozo no registrado, pc desconocido)
+    //   " (+2 llamadas de cola)" al final si hubo llamadas de cola
+    //   "#1 [C] 0x00149FB0"
+    //   "#2 marco ilegible ci=0x0012ABC0"
+    std::string lineaMarco(size_t indice, const Marco &marco);
+}
