diff --git a/ps2xTest/src/ps2_lua_traza_tests.cpp b/ps2xTest/src/ps2_lua_traza_tests.cpp
new file mode 100644
index 0000000..77a86c1
--- /dev/null
+++ b/ps2xTest/src/ps2_lua_traza_tests.cpp
@@ -0,0 +1,316 @@
+#include "MiniTest.h"
+#include "ps2_lua_traza.h"
+
+#include <cstring>
+#include <string>
+#include <vector>
+
+// odd/tasks/fallos-con-log.md T3c (S3): a Lua error in the log names the script, the function and the instruction
+// (the line when the chunk has line info), read from guest memory without ever trusting a pointer.
+namespace
+{
+    using namespace ps2x::luatraza;
+
+    // A small fake guest RAM with the game's Lua layout (ps2_lua_traza.h).
+    struct Ram
+    {
+        std::vector<uint8_t> b = std::vector<uint8_t>(0x10000u, 0u);
+        Memoria mem() const { return Memoria{b.data(), static_cast<uint32_t>(b.size())}; }
+        void w32(uint32_t dir, uint32_t v) { std::memcpy(&b[dir], &v, 4); }
+        void w8(uint32_t dir, uint8_t v) { b[dir] = v; }
+
+        // TString at dir with its text right after it (+20).
+        void tstring(uint32_t dir, const std::string &texto)
+        {
+            w8(dir + 4u, 4u);
+            w32(dir + 12u, static_cast<uint32_t>(texto.size()));
+            w32(dir + 16u, dir + 20u);
+            std::memcpy(&b[dir + 20u], texto.data(), texto.size());
+        }
+        // Proto at dir: tt 9, code, children, lineinfo, source...
+        void proto(uint32_t dir, uint32_t code, uint32_t sizecode, uint32_t source, int lineDefined,
+                   uint32_t hijas = 0u, uint32_t sizep = 0u, uint32_t lineinfo = 0u, uint32_t sizelineinfo = 0u)
+        {
+            w8(dir + 4u, 9u);
+            w32(dir + 12u, code);
+            w32(dir + 16u, hijas);
+            w32(dir + 20u, lineinfo);
+            w32(dir + 32u, source);
+            w32(dir + 44u, sizecode);
+            w32(dir + 52u, sizelineinfo);
+            w32(dir + 56u, sizep);
+            w32(dir + 60u, static_cast<uint32_t>(lineDefined));
+        }
+        // Lua closure at dir for proto; its TObject (type 6) at stack slot funcObj.
+        void funcion(uint32_t funcObj, uint32_t cierre, uint32_t protoOFuncion, bool esC)
+        {
+            w32(funcObj, 6u);
+            w32(funcObj + 4u, cierre);
+            w8(cierre + 6u, esC ? 1u : 0u);
+            w32(cierre + 12u, protoOFuncion);
+        }
+        void ci(uint32_t dir, uint32_t base, uint32_t savedpc, uint32_t tailcalls = 0u)
+        {
+            w32(dir, base);
+            w32(dir + 4u, base + 0x100u);
+            w32(dir + 8u, savedpc);
+            w32(dir + 12u, tailcalls);
+        }
+    };
+
+    constexpr uint32_t kL = 0x100u;
+    constexpr uint32_t kBaseCi = 0x200u;
+    constexpr uint32_t kStack = 0x1000u;
+
+    // Three frames above base_ci: #0 Lua (MainMenu.lua F0.1, pc 3), #1 C 0x149FB0, #2 Lua (F0, pc 7, unknown chunk).
+    Ram escena(Nombres &nombres, bool registrar = true)
+    {
+        Ram r;
+        r.tstring(0x3000u, "@X");
+        r.proto(0x4000u, 0x5000u, 20u, 0x3000u, 0, 0x4100u, 1u); // main F0
+        r.w32(0x4100u, 0x4200u);
+        r.proto(0x4200u, 0x5100u, 10u, 0x3000u, 120); // F0.0
+        r.proto(0x4400u, 0x5300u, 12u, 0x3000u, 33);  // another chunk, not registered
+        if (registrar)
+            nombres.registrar(r.mem(), 0x4000u, "FrontEnd/Scripts/Offline/MainMenu.lua");
+        r.w32(kL + 0x28u, kBaseCi);
+        r.ci(kBaseCi, kStack + 8u, 0u);
+        r.funcion(kStack + 0x10u, 0x6000u, 0x4400u, false); // #2
+        r.ci(kBaseCi + 0x10u, kStack + 0x18u, 0x5300u + 4u * 8u);
+        r.funcion(kStack + 0x40u, 0x6100u, 0x00149FB0u, true); // #1
+        r.ci(kBaseCi + 0x20u, kStack + 0x48u, 0u);
+        r.funcion(kStack + 0x80u, 0x6200u, 0x4200u, false); // #0
+        r.ci(kBaseCi + 0x30u, kStack + 0x88u, 0x5100u + 4u * 4u, 2u);
+        r.w32(kL + 0x14u, kBaseCi + 0x30u);
+        return r;
+    }
+}
+
+void register_ps2_lua_traza_tests()
+{
+    MiniTest::Case("LuaTraza", [](TestCase &tc)
+    {
+        tc.Run("memory: every address is range-checked", [](TestCase &t)
+        {
+            Ram r;
+            const Memoria m = r.mem();
+            t.IsFalse(m.valida(0u, 4u), "null");
+            t.IsTrue(m.valida(0xFFFCu, 4u), "last word");
+            t.IsFalse(m.valida(0xFFFDu, 4u), "crosses the end");
+            t.IsFalse(m.valida(0xFFFFFFFCu, 8u), "wraps around");
+            t.IsFalse(m.valida(0x20000u, 1u), "past the end");
+            r.w32(0x40u, 0x12345678u);
+            uint32_t v = 0u;
+            t.IsTrue(m.leer32(0x40u, v) && v == 0x12345678u, "aligned read");
+            t.IsFalse(m.leer32(0x42u, v), "unaligned word");
+            uint8_t c = 0u;
+            t.IsTrue(m.leer8(0x41u, c) && c == 0x56u, "byte");
+            t.IsFalse(Memoria{}.valida(0x10u, 1u), "no memory");
+        });
+
+        tc.Run("TString: text, cut to the maximum, rejected when not a string", [](TestCase &t)
+        {
+            Ram r;
+            r.tstring(0x100u, "@LaunchScripts/febootscript.lua");
+            t.Equals(cadena(r.mem(), 0x100u).value_or("<none>"), std::string("@LaunchScripts/febootscript.lua"), "text");
+            t.Equals(cadena(r.mem(), 0x100u, 7u).value_or("<none>"), std::string("@Launch"), "cut");
+            r.tstring(0x200u, std::string("a\nb", 3));
+            t.Equals(cadena(r.mem(), 0x200u).value_or("<none>"), std::string("a.b"), "non-printable as '.'");
+            r.w8(0x204u, 5u);
+            t.IsFalse(cadena(r.mem(), 0x200u).has_value(), "type 5 is not a string");
+            r.tstring(0x300u, "x");
+            r.w32(0x310u, 0xFFFFF0u);
+            t.IsFalse(cadena(r.mem(), 0x300u).has_value(), "text pointer outside RAM");
+            r.tstring(0x400u, "y");
+            r.w32(0x40Cu, 0x7FFFFFFFu);
+            t.IsFalse(cadena(r.mem(), 0x400u).has_value(), "absurd length");
+            t.IsFalse(cadena(r.mem(), 0u).has_value(), "null");
+            t.IsFalse(cadena(r.mem(), 0xFFF0u).has_value(), "header past the end");
+        });
+
+        tc.Run("position: instruction from savedpc, line from lineinfo", [](TestCase &t)
+        {
+            Ram r;
+            r.proto(0x100u, 0x1000u, 10u, 0u, 5, 0u, 0u, 0x2000u, 10u);
+            for (uint32_t i = 0; i < 10u; ++i)
+                r.w32(0x2000u + 4u * i, 50u + i);
+            Posicion p = posicion(r.mem(), 0x100u, 0x1000u + 4u * 4u);
+            t.Equals(p.pc, 3, "savedpc points after the running instruction");
+            t.Equals(p.linea, 53, "lineinfo[3]");
+            p = posicion(r.mem(), 0x100u, 0x1000u + 4u * 10u);
+            t.Equals(p.pc, 9, "last instruction");
+            t.Equals(p.linea, 59, "last line");
+            t.Equals(posicion(r.mem(), 0x100u, 0x1000u).pc, -1, "savedpc at code: nothing ran yet");
+            t.Equals(posicion(r.mem(), 0x100u, 0x1000u + 4u * 11u).pc, -1, "past the code");
+            t.Equals(posicion(r.mem(), 0x100u, 0x1002u).pc, -1, "unaligned savedpc");
+            t.Equals(posicion(r.mem(), 0x100u, 0x0FF0u).pc, -1, "before the code");
+        });
+
+        tc.Run("position: stripped chunk or short lineinfo gives no line", [](TestCase &t)
+        {
+            Ram r;
+            r.proto(0x100u, 0x1000u, 10u, 0u, 5);
+            Posicion p = posicion(r.mem(), 0x100u, 0x1000u + 4u * 2u);
+            t.Equals(p.pc, 1, "pc still known");
+            t.Equals(p.linea, -1, "no lineinfo");
+            r.proto(0x200u, 0x1000u, 10u, 0u, 5, 0u, 0u, 0x2000u, 2u);
+            p = posicion(r.mem(), 0x200u, 0x1000u + 4u * 5u);
+            t.Equals(p.pc, 4, "pc");
+            t.Equals(p.linea, -1, "pc beyond sizelineinfo");
+            r.proto(0x300u, 0x1000u, 10u, 0u, 5, 0u, 0u, 0xFFF0u, 10u);
+            t.Equals(posicion(r.mem(), 0x300u, 0x1000u + 4u * 8u).linea, -1, "lineinfo entry outside RAM");
+            t.Equals(posicion(r.mem(), 0xFFFCu, 0x1004u).pc, -1, "proto outside RAM");
+        });
+
+        tc.Run("names: the chunk tree gets lua_volcados paths, stale entries are ignored", [](TestCase &t)
+        {
+            Ram r;
+            r.proto(0x100u, 0x1000u, 4u, 0u, 0, 0x800u, 2u);
+            r.w32(0x800u, 0x200u);
+            r.w32(0x804u, 0x300u);
+            r.proto(0x200u, 0x1100u, 4u, 0u, 3);
+            r.proto(0x300u, 0x1200u, 4u, 0u, 9, 0x900u, 1u);
+            r.w32(0x900u, 0x400u);
+            r.proto(0x400u, 0x1300u, 4u, 0u, 10);
+            Nombres n;
+            t.Equals(n.registrar(r.mem(), 0x100u, "A.lua"), size_t{4}, "four protos");
+            t.Equals(n.buscar(0x100u, 0x1000u).value_or(Nombres::Entrada{}).ruta, std::string("0"), "main");
+            t.Equals(n.buscar(0x300u, 0x1200u).value_or(Nombres::Entrada{}).ruta, std::string("0.1"), "second child");
+            const auto nieta = n.buscar(0x400u, 0x1300u).value_or(Nombres::Entrada{});
+            t.Equals(nieta.ruta, std::string("0.1.0"), "grandchild");
+            t.Equals(nieta.nombre, std::string("A.lua"), "chunk name");
+            t.IsFalse(n.buscar(0x400u, 0x9999u).has_value(), "same address, other code: freed and reused");
+            t.IsFalse(n.buscar(0x500u, 0x1300u).has_value(), "unknown");
+            // Reloading another chunk at the same address replaces the entry.
+            n.registrar(r.mem(), 0x200u, "B.lua");
+            t.Equals(n.buscar(0x200u, 0x1100u).value_or(Nombres::Entrada{}).nombre, std::string("B.lua"), "replaced");
+        });
+
+        tc.Run("names: bad pointers and cycles are bounded", [](TestCase &t)
+        {
+            Ram r;
+            r.proto(0x100u, 0x1000u, 4u, 0u, 0, 0x800u, 3u);
+            r.w32(0x800u, 0x100u);     // itself: a cycle
+            r.w32(0x804u, 0xFFFFFF0u); // outside RAM
+            r.w32(0x808u, 0x600u);     // not a Proto (tt 0)
+            Nombres n;
+            t.Equals(n.registrar(r.mem(), 0x100u, "C.lua"), size_t{1}, "only the main proto");
+            t.Equals(n.registrar(r.mem(), 0xFFFF0u, "D.lua"), size_t{0}, "main outside RAM");
+            r.proto(0x200u, 0x1000u, 4u, 0u, 0, 0xFFF0u, 100u); // children array runs past the end
+            t.Equals(n.registrar(r.mem(), 0x200u, "E.lua"), size_t{1}, "children array outside RAM");
+        });
+
+        tc.Run("walk: Lua and C frames from L->ci down, without base_ci", [](TestCase &t)
+        {
+            Nombres nombres;
+            const Ram r = escena(nombres);
+            const Traza tr = recorrer(r.mem(), kL, 20u, &nombres);
+            t.Equals(tr.marcos.size(), size_t{3}, "three frames");
+            t.Equals(tr.omitidos, size_t{0}, "none left out");
+            if (tr.marcos.size() != 3u)
+                return;
+            const Marco &m0 = tr.marcos[0];
+            t.IsTrue(m0.tipo == Marco::Tipo::Lua, "#0 Lua");
+            t.Equals(m0.nombre, std::string("FrontEnd/Scripts/Offline/MainMenu.lua"), "#0 chunk");
+            t.Equals(m0.ruta, std::string("0.0"), "#0 path");
+            t.Equals(m0.fuente, std::string("@X"), "#0 source");
+            t.Equals(m0.pos.pc, 3, "#0 pc");
+            t.Equals(m0.lineaDefinida, 120, "#0 lineDefined");
+            t.Equals(m0.llamadasCola, 2u, "#0 tail calls");
+            t.IsTrue(tr.marcos[1].tipo == Marco::Tipo::C, "#1 C");
+            t.Equals(tr.marcos[1].funcion, 0x00149FB0u, "#1 function");
+            t.IsTrue(tr.marcos[2].tipo == Marco::Tipo::Lua, "#2 Lua");
+            t.Equals(tr.marcos[2].nombre, std::string(""), "#2 not registered");
+            t.Equals(tr.marcos[2].funcion, 0x4400u, "#2 proto");
+            t.Equals(tr.marcos[2].pos.pc, 7, "#2 pc");
+        });
+
+        tc.Run("walk: bounded to the maximum", [](TestCase &t)
+        {
+            Nombres nombres;
+            const Ram r = escena(nombres);
+            const Traza tr = recorrer(r.mem(), kL, 2u, &nombres);
+            t.Equals(tr.marcos.size(), size_t{2}, "two frames");
+            t.Equals(tr.omitidos, size_t{1}, "one left out");
+        });
+
+        tc.Run("walk: a broken frame ends the trace, never a crash", [](TestCase &t)
+        {
+            Nombres nombres;
+            Ram r = escena(nombres);
+            r.w32(kBaseCi + 0x20u, 0xFFFFF00u); // #1 base outside RAM
+            Traza tr = recorrer(r.mem(), kL, 20u, &nombres);
+            t.Equals(tr.marcos.size(), size_t{2}, "#0 and the broken one");
+            if (tr.marcos.size() == 2u)
+            {
+                t.IsTrue(tr.marcos[1].tipo == Marco::Tipo::Ilegible, "#1 unreadable");
+                t.Equals(tr.marcos[1].ci, kBaseCi + 0x20u, "#1 ci");
+            }
+            r = escena(nombres);
+            r.w32(kStack + 0x80u, 5u); // #0 function object is a table
+            tr = recorrer(r.mem(), kL, 20u, &nombres);
+            t.Equals(tr.marcos.size(), size_t{1}, "stops at #0");
+            t.IsTrue(!tr.marcos.empty() && tr.marcos[0].tipo == Marco::Tipo::Ilegible, "#0 unreadable");
+            r = escena(nombres);
+            r.w32(kL + 0x14u, kBaseCi + 0x34u); // ci not on a CallInfo boundary
+            tr = recorrer(r.mem(), kL, 20u, &nombres);
+            t.Equals(tr.marcos.size(), size_t{1}, "misaligned ci");
+            r = escena(nombres);
+            r.w32(kL + 0x14u, kBaseCi - 0x10u); // ci below base_ci: nothing to show
+            t.Equals(recorrer(r.mem(), kL, 20u, &nombres).marcos.size(), size_t{0}, "ci below base_ci");
+            tr = recorrer(r.mem(), 0xFFFFFF00u, 20u, &nombres);
+            t.Equals(tr.marcos.size(), size_t{1}, "L outside RAM");
+            r = escena(nombres);
+            r.w32(0x4200u + 12u, 0xFFFF00u); // #0 proto code outside RAM: frame kept, pc unknown
+            tr = recorrer(r.mem(), kL, 20u, &nombres);
+            t.Equals(tr.marcos.size(), size_t{3}, "still three frames");
+            t.Equals(tr.marcos.empty() ? 0 : tr.marcos[0].pos.pc, -1, "pc unknown");
+        });
+
+        tc.Run("walk: without names the source is shown", [](TestCase &t)
+        {
+            Nombres nombres;
+            const Ram r = escena(nombres, false);
+            const Traza tr = recorrer(r.mem(), kL, 20u, nullptr);
+            t.Equals(tr.marcos.size(), size_t{3}, "three frames");
+            t.Equals(tr.marcos.empty() ? std::string() : tr.marcos[0].nombre, std::string(""), "no name");
+        });
+
+        tc.Run("frame lines", [](TestCase &t)
+        {
+            Marco m;
+            m.tipo = Marco::Tipo::Lua;
+            m.funcion = 0x00ABCDEFu;
+            m.fuente = "@X";
+            m.nombre = "FrontEnd/Scripts/X.lua";
+            m.ruta = "0.3";
+            m.lineaDefinida = 120;
+            m.pos = {15, -1};
+            t.Equals(lineaMarco(0, m), std::string("#0 FrontEnd/Scripts/X.lua F0.3 instruccion 15 (funcion de la linea 120)"),
+                     "registered chunk without lines");
+            m.nombre = "Mod.lua";
+            m.pos = {15, 42};
+            m.lineaDefinida = 40;
+            m.llamadasCola = 2u;
+            t.Equals(lineaMarco(0, m), std::string("#0 Mod.lua:42 F0.3 instruccion 15 (funcion de la linea 40) (+2 llamadas de cola)"),
+                     "with line info and tail calls");
+            m.nombre.clear();
+            m.ruta.clear();
+            m.pos = {-1, -1};
+            m.lineaDefinida = 120;
+            m.llamadasCola = 0u;
+            t.Equals(lineaMarco(0, m), std::string("#0 @X proto=0x00ABCDEF instruccion ? (funcion de la linea 120)"),
+                     "unregistered chunk, unknown pc");
+            m.fuente.clear();
+            t.Equals(lineaMarco(4, m), std::string("#4 ? proto=0x00ABCDEF instruccion ? (funcion de la linea 120)"),
+                     "unreadable source");
+            Marco c;
+            c.tipo = Marco::Tipo::C;
+            c.funcion = 0x00149FB0u;
+            t.Equals(lineaMarco(1, c), std::string("#1 [C] 0x00149FB0"), "C function");
+            Marco x;
+            x.ci = 0x0012ABC0u;
+            t.Equals(lineaMarco(12, x), std::string("#12 marco ilegible ci=0x0012ABC0"), "unreadable frame");
+        });
+    });
+}
