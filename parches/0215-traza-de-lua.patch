diff --git a/ps2xRuntime/src/lib/ps2_lua_traza.cpp b/ps2xRuntime/src/lib/ps2_lua_traza.cpp
new file mode 100644
index 0000000..a88ff79
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_lua_traza.cpp
@@ -0,0 +1,280 @@
+// Traza de Lua (ps2_lua_traza.h): solo lee la RAM del invitado, comprobando cada direccion.
+#include "ps2_lua_traza.h"
+
+#include <cstdio>
+#include <cstring>
+#include <unordered_set>
+#include <utility>
+
+namespace ps2x::luatraza
+{
+    namespace
+    {
+        // lua_State
+        constexpr uint32_t kLCi = 0x14u;
+        constexpr uint32_t kLBaseCi = 0x28u;
+        // CallInfo
+        constexpr uint32_t kCiTam = 16u;
+        constexpr uint32_t kCiBase = 0u;
+        constexpr uint32_t kCiSavedpc = 8u;
+        constexpr uint32_t kCiTailcalls = 12u;
+        constexpr uint32_t kCiMaximos = 4096u; // ningun Lua del juego llega a tantos marcos
+        // TObject
+        constexpr uint32_t kTipoFuncion = 6u;
+        // Closure
+        constexpr uint32_t kClIsC = 6u;
+        constexpr uint32_t kClProto = 12u;
+        // Proto
+        constexpr uint32_t kPTt = 4u;
+        constexpr uint8_t kTipoProto = 9u;
+        constexpr uint32_t kPCode = 12u;
+        constexpr uint32_t kPHijas = 16u;
+        constexpr uint32_t kPLineinfo = 20u;
+        constexpr uint32_t kPSource = 32u;
+        constexpr uint32_t kPSizecode = 44u;
+        constexpr uint32_t kPSizelineinfo = 52u;
+        constexpr uint32_t kPSizep = 56u;
+        constexpr uint32_t kPLineDefined = 60u;
+        constexpr uint32_t kPTam = 72u;
+        // TString
+        constexpr uint32_t kTsTt = 4u;
+        constexpr uint8_t kTipoCadena = 4u;
+        constexpr uint32_t kTsLen = 12u;
+        constexpr uint32_t kTsTexto = 16u;
+        constexpr uint32_t kTsTam = 20u;
+
+        constexpr uint32_t kMaxNiveles = 32u;
+        constexpr size_t kMaxProtosPorTrozo = 4096u;
+
+        bool esProto(const Memoria &mem, uint32_t p)
+        {
+            uint8_t tt = 0u;
+            return (p & 3u) == 0u && mem.valida(p, kPTam) && mem.leer8(p + kPTt, tt) && tt == kTipoProto;
+        }
+
+        std::string hex8(uint32_t v)
+        {
+            char texto[16];
+            std::snprintf(texto, sizeof(texto), "0x%08X", v);
+            return texto;
+        }
+    }
+
+    bool Memoria::valida(uint32_t dir, uint32_t n) const
+    {
+        return datos != nullptr && dir != 0u && n <= tam && dir <= tam - n;
+    }
+
+    bool Memoria::leer32(uint32_t dir, uint32_t &valor) const
+    {
+        if ((dir & 3u) != 0u || !valida(dir, 4u))
+            return false;
+        std::memcpy(&valor, datos + dir, sizeof(valor));
+        return true;
+    }
+
+    bool Memoria::leer8(uint32_t dir, uint8_t &valor) const
+    {
+        if (!valida(dir, 1u))
+            return false;
+        valor = datos[dir];
+        return true;
+    }
+
+    std::optional<std::string> cadena(const Memoria &mem, uint32_t tstring, size_t maximo)
+    {
+        uint8_t tt = 0u;
+        uint32_t largo = 0u, texto = 0u;
+        if ((tstring & 3u) != 0u || !mem.valida(tstring, kTsTam) || !mem.leer8(tstring + kTsTt, tt) || tt != kTipoCadena ||
+            !mem.leer32(tstring + kTsLen, largo) || !mem.leer32(tstring + kTsTexto, texto))
+            return std::nullopt;
+        if (largo > mem.tam || (largo != 0u && !mem.valida(texto, largo)))
+            return std::nullopt;
+        const size_t n = largo < maximo ? largo : maximo;
+        std::string s;
+        s.reserve(n);
+        for (size_t i = 0; i < n; ++i)
+        {
+            const char c = static_cast<char>(mem.datos[texto + i]);
+            s.push_back(c >= 0x20 && c < 0x7F ? c : '.');
+        }
+        return s;
+    }
+
+    Posicion posicion(const Memoria &mem, uint32_t proto, uint32_t savedpc)
+    {
+        Posicion p;
+        uint32_t code = 0u, sizecode = 0u;
+        if (!esProto(mem, proto) || !mem.leer32(proto + kPCode, code) || !mem.leer32(proto + kPSizecode, sizecode))
+            return p;
+        if (code == 0u || (savedpc & 3u) != 0u || savedpc <= code || sizecode > (mem.tam / 4u))
+            return p;
+        const uint32_t siguiente = (savedpc - code) / 4u; // instruccion despues de la que corre
+        if (siguiente > sizecode)
+            return p;
+        p.pc = static_cast<int>(siguiente - 1u);
+        uint32_t lineinfo = 0u, sizelineinfo = 0u, linea = 0u;
+        if (mem.leer32(proto + kPLineinfo, lineinfo) && lineinfo != 0u && mem.leer32(proto + kPSizelineinfo, sizelineinfo) &&
+            static_cast<uint32_t>(p.pc) < sizelineinfo && mem.leer32(lineinfo + 4u * static_cast<uint32_t>(p.pc), linea))
+            p.linea = static_cast<int>(linea);
+        return p;
+    }
+
+    size_t Nombres::registrar(const Memoria &mem, uint32_t protoPrincipal, const std::string &nombre)
+    {
+        if (!esProto(mem, protoPrincipal))
+            return 0u;
+        std::vector<std::pair<uint32_t, std::pair<std::string, uint32_t>>> encontrados; // proto, (ruta, code)
+        std::unordered_set<uint32_t> vistos;
+        // Recorrido en profundidad con pila explicita: (proto, ruta, nivel).
+        struct Pendiente
+        {
+            uint32_t proto;
+            std::string ruta;
+            uint32_t nivel;
+        };
+        std::vector<Pendiente> pila{{protoPrincipal, "0", 0u}};
+        while (!pila.empty() && encontrados.size() < kMaxProtosPorTrozo)
+        {
+            Pendiente actual = std::move(pila.back());
+            pila.pop_back();
+            if (!esProto(mem, actual.proto) || !vistos.insert(actual.proto).second)
+                continue;
+            uint32_t code = 0u;
+            mem.leer32(actual.proto + kPCode, code);
+            encontrados.push_back({actual.proto, {actual.ruta, code}});
+            uint32_t hijas = 0u, sizep = 0u;
+            if (actual.nivel + 1u >= kMaxNiveles || !mem.leer32(actual.proto + kPHijas, hijas) ||
+                !mem.leer32(actual.proto + kPSizep, sizep) || hijas == 0u)
+                continue;
+            if (sizep > kMaxProtosPorTrozo)
+                sizep = kMaxProtosPorTrozo;
+            // Al reves, para sacar las hijas en orden.
+            for (uint32_t i = sizep; i-- > 0u;)
+            {
+                uint32_t hija = 0u;
+                if (!mem.leer32(hijas + 4u * i, hija) || hija == 0u)
+                    continue;
+                pila.push_back({hija, actual.ruta + "." + std::to_string(i), actual.nivel + 1u});
+            }
+        }
+        std::lock_guard<std::mutex> cerrojo(m_mutex);
+        if (m_protos.size() + encontrados.size() > kMaximo)
+            m_protos.clear();
+        for (auto &[proto, datos] : encontrados)
+            m_protos[proto] = Entrada{nombre, std::move(datos.first), datos.second};
+        return encontrados.size();
+    }
+
+    std::optional<Nombres::Entrada> Nombres::buscar(uint32_t proto, uint32_t code) const
+    {
+        std::lock_guard<std::mutex> cerrojo(m_mutex);
+        const auto it = m_protos.find(proto);
+        if (it == m_protos.end() || it->second.code != code)
+            return std::nullopt;
+        return it->second;
+    }
+
+    size_t Nombres::tam() const
+    {
+        std::lock_guard<std::mutex> cerrojo(m_mutex);
+        return m_protos.size();
+    }
+
+    Traza recorrer(const Memoria &mem, uint32_t L, size_t maximo, const Nombres *nombres)
+    {
+        Traza traza;
+        uint32_t ci = 0u, baseCi = 0u;
+        if ((L & 3u) != 0u || !mem.leer32(L + kLCi, ci) || !mem.leer32(L + kLBaseCi, baseCi))
+        {
+            Marco roto;
+            traza.marcos.push_back(roto);
+            return traza;
+        }
+        if (ci <= baseCi)
+            return traza;
+        for (; ci > baseCi; ci -= kCiTam)
+        {
+            if (traza.marcos.size() >= maximo)
+            {
+                traza.omitidos = (ci - baseCi) / kCiTam;
+                break;
+            }
+            Marco marco;
+            marco.ci = ci;
+            uint32_t base = 0u, tipoFuncion = 0u, cierre = 0u;
+            uint8_t esC = 0u;
+            const bool legible = (ci - baseCi) % kCiTam == 0u && (ci - baseCi) / kCiTam <= kCiMaximos &&
+                                 mem.valida(ci, kCiTam) && mem.leer32(ci + kCiBase, base) && base >= 8u &&
+                                 mem.leer32(base - 8u, tipoFuncion) && tipoFuncion == kTipoFuncion &&
+                                 mem.leer32(base - 4u, cierre) && mem.leer8(cierre + kClIsC, esC) &&
+                                 mem.leer32(cierre + kClProto, marco.funcion);
+            if (!legible)
+            {
+                marco.tipo = Marco::Tipo::Ilegible;
+                marco.funcion = 0u;
+                traza.marcos.push_back(std::move(marco));
+                break;
+            }
+            if (esC != 0u)
+            {
+                marco.tipo = Marco::Tipo::C;
+                traza.marcos.push_back(std::move(marco));
+                continue;
+            }
+            marco.tipo = Marco::Tipo::Lua;
+            const uint32_t proto = marco.funcion;
+            uint32_t source = 0u, lineDefined = 0u, savedpc = 0u, code = 0u;
+            if (esProto(mem, proto))
+            {
+                if (mem.leer32(proto + kPSource, source))
+                    marco.fuente = cadena(mem, source, 120u).value_or("");
+                if (mem.leer32(proto + kPLineDefined, lineDefined))
+                    marco.lineaDefinida = static_cast<int>(lineDefined);
+                mem.leer32(proto + kPCode, code);
+            }
+            if (mem.leer32(ci + kCiSavedpc, savedpc))
+                marco.pos = posicion(mem, proto, savedpc);
+            mem.leer32(ci + kCiTailcalls, marco.llamadasCola);
+            if (marco.llamadasCola > 1000000u)
+                marco.llamadasCola = 0u; // no es un contador de verdad
+            if (nombres != nullptr)
+                if (const auto entrada = nombres->buscar(proto, code))
+                {
+                    marco.nombre = entrada->nombre;
+                    marco.ruta = entrada->ruta;
+                }
+            traza.marcos.push_back(std::move(marco));
+        }
+        return traza;
+    }
+
+    std::string lineaMarco(size_t indice, const Marco &marco)
+    {
+        std::string s = "#" + std::to_string(indice) + " ";
+        switch (marco.tipo)
+        {
+        case Marco::Tipo::C:
+            return s + "[C] " + hex8(marco.funcion);
+        case Marco::Tipo::Ilegible:
+            return s + "marco ilegible ci=" + hex8(marco.ci);
+        case Marco::Tipo::Lua:
+            break;
+        }
+        if (!marco.nombre.empty())
+            s += marco.nombre;
+        else
+            s += marco.fuente.empty() ? "?" : marco.fuente;
+        if (marco.pos.linea >= 0)
+            s += ":" + std::to_string(marco.pos.linea);
+        if (!marco.ruta.empty())
+            s += " F" + marco.ruta;
+        else
+            s += " proto=" + hex8(marco.funcion);
+        s += " instruccion " + (marco.pos.pc >= 0 ? std::to_string(marco.pos.pc) : std::string("?"));
+        s += " (funcion de la linea " + std::to_string(marco.lineaDefinida) + ")";
+        if (marco.llamadasCola != 0u)
+            s += " (+" + std::to_string(marco.llamadasCola) + " llamadas de cola)";
+        return s;
+    }
+}
