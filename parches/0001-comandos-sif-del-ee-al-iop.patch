+    bool IopRpcBridge::handleEeCommand(uint32_t commandId,
+                                       const void *packet,
+                                       uint32_t packetSize,
+                                       IopGuestExecutor &executor)
+    {
+        constexpr uint32_t kMaxPacketSize = 112u;
+        const auto handler = m_cmdHandlers.find(commandId);
+        if (handler == m_cmdHandlers.end() || handler->second.function == 0u ||
+            !packet || packetSize == 0u || packetSize > kMaxPacketSize)
+            return false;
+
+        // Real sifcmd leaves the packet in its receive buffer and passes that address to the handler,
+        // so handlers copy what they need before the next packet arrives.
+        if (m_cmdPacketBuffer == 0u)
+            m_cmdPacketBuffer = m_memory.allocate(kMaxPacketSize, 16u);
+        if (m_cmdPacketBuffer == 0u || !m_memory.writeRam(m_cmdPacketBuffer, packet, packetSize))
+            return false;
+
+        const CmdHandler target = handler->second;
+        (void)executor.executeGuestFunction(target.function, m_cmdPacketBuffer, target.argument, 0u, 0u, target.gp);
+        return true;
+    }
