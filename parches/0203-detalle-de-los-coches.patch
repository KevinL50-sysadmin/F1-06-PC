+        // Lejania T4: the cars' level of detail (detalle_coches = 1, as on the PS2, or 0, the port's old reduced one),
+        // on in development too.
+        tc.Run("the detalle_coches option has its default, variable, checks and number", [](TestCase &t)
+        {
+            t.Equals(ps2x::parseOptions("").values.at("detalle_coches"), std::string("1"), "as on the PS2 by default");
+            t.Equals(fileValue("", "detalle_coches", true), std::string("1"), "also in development");
+            t.IsTrue(contains(ps2x::defaultOptionsText(false), "detalle_coches = 1\n"), "the template has it");
+            t.IsTrue(contains(ps2x::defaultOptionsText(false), "fov = 0\n"), "and keeps fov");
+
+            const ps2x::OptionsFile file = ps2x::parseOptions("detalle_coches = 0\n");
+            t.IsTrue(file.warnings.empty(), "a valid value gives no warning");
+            const std::vector<ps2x::EnvironmentSetting> settings = ps2x::optionsEnvironment(file, environmentOf({}));
+            std::string variable = "<none>";
+            for (const ps2x::EnvironmentSetting &setting : settings)
+                if (setting.variable == "PS2X_DETALLE_COCHES")
+                    variable = setting.value;
+            t.Equals(variable, std::string("0"), "detalle_coches -> PS2X_DETALLE_COCHES");
+
+            const ps2x::OptionsFile bad = ps2x::parseOptions("detalle_coches = 2\n");
+            t.Equals(bad.warnings.size(), size_t{1u}, "a bad value warns");
+            t.Equals(bad.values.at("detalle_coches"), std::string("1"), "and takes the default");
+
+            const Environment environment = {{"PS2X_DETALLE_COCHES", "0"}};
+            const ps2x::OptionsMenuModel forced = ps2x::makeOptionsMenuModel(
+                "", false, ps2x::optionsForcedByEnvironment(environmentOf(environment)), environmentOf(environment));
+            t.Equals(forced.current.at("detalle_coches"), std::string("0"), "the variable wins over the file");
+
+            ps2x::OptionsMenuModel model = ps2x::makeOptionsMenuModel("", false, {}, environmentOf({}));
+            float value = -99.0f;
+            t.IsTrue(ps2x::menuOptionNumber(model, "detalle_coches", value), "a number for the game's row");
+            t.Equals(value, 1.0f, "as on the PS2");
+            t.IsTrue(ps2x::setMenuOptionNumber(model, "detalle_coches", 0.0f), "reduced");
+            t.Equals(model.current.at("detalle_coches"), std::string("0"), "is 0");
+            t.IsFalse(ps2x::setMenuOptionNumber(model, "detalle_coches", 2.0f), "past as on the PS2");
+            const std::string saved = ps2x::rewriteOptionsText("", ps2x::menuValuesToSave(model), false);
+            t.Equals(fileValue(saved, "detalle_coches"), std::string("0"), "CONFIRM writes it");
+            t.Equals(fileValue(saved, "fov"), std::string("0"), "the other options keep their values");
+        });
