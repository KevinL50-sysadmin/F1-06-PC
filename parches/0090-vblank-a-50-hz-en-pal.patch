+// Patch 0090: called by sceGsResetGraph with the video mode the game asks for (omode 3 = PAL).
+void ps2SetVideoModePal(bool pal)
+{
+    const uint32_t period = pal ? 20000u : 16667u;
+    if (g_vblankPeriodUs.exchange(period, std::memory_order_relaxed) != period)
+        std::fprintf(stderr, "[ee:vblank] %s: %u us%s\n", pal ? "PAL" : "NTSC", period,
+                     forcedVBlankPeriodUs() != 0u ? " (PS2X_VBLANK_HZ manda)" : "");
+}
