diff --git a/ps2xRuntime/src/lib/ps2_hud.h b/ps2xRuntime/src/lib/ps2_hud.h
new file mode 100644
index 0000000..e716366
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_hud.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <cctype>
+#include <string>
+#include <string_view>
+
+// Fase 5 (T9, F1 06): the race HUD (opciones.ini hud: completo, minimo or oculto; AJUSTES PC and the F2 menu). The game
+// draws it in src/f1_overrides.cpp (func_1F6BB0), which reads the mode every frame; tecla_hud (h, f7, f6 or no) moves it
+// to the next mode while playing (ps2_options_menu.cpp).
+namespace ps2x
+{
+    // The numbers are the choices' order in the option (the game's row works with them).
+    enum class HudMode : int
+    {
+        Full = 0,
+        Minimal = 1,
+        Hidden = 2,
+    };
+
+    // completo, minimo or oculto, any case; false (mode unchanged) for anything else.
+    inline bool parseHudMode(std::string_view text, HudMode &mode)
+    {
+        std::string lower;
+        for (const char c : text)
+            lower.push_back(static_cast<char>(std::tolower(static_cast<unsigned char>(c))));
+        if (lower == "completo")
+            mode = HudMode::Full;
+        else if (lower == "minimo")
+            mode = HudMode::Minimal;
+        else if (lower == "oculto")
+            mode = HudMode::Hidden;
+        else
+            return false;
+        return true;
+    }
+
+    inline const char *hudModeOption(HudMode mode)
+    {
+        return mode == HudMode::Minimal ? "minimo" : mode == HudMode::Hidden ? "oculto" : "completo";
+    }
+
+    // The key: completo -> minimo -> oculto -> completo.
+    inline HudMode nextHudMode(HudMode mode)
+    {
+        return mode == HudMode::Full ? HudMode::Minimal : mode == HudMode::Minimal ? HudMode::Hidden : HudMode::Full;
+    }
+}
