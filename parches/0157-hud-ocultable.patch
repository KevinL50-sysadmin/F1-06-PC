+    // Fase 5 (T9): tecla_hud moves the HUD to its next mode (not saved; CONFIRM or Guardar save it), not while this menu
+    // is open. The game reads the mode in its next frame.
+    if (!s.open)
+    {
+        ensureModel(s);
+        if (const int key = hudKeyCode(valueOf(s.model.current, "tecla_hud")); key != KEY_NULL && IsKeyPressed(key))
+        {
+            ps2x::HudMode mode = ps2x::HudMode::Full;
+            ps2x::parseHudMode(valueOf(s.model.current, "hud"), mode);
+            const char *next = ps2x::hudModeOption(ps2x::nextHudMode(mode));
+            const bool done = ps2x::setMenuOption(s.model, "hud", next);
+            applyLive(s.model, s.applied, runtime);
+            std::cout << "[menu] tecla del HUD: hud = " << valueOf(s.model.current, "hud") << (done ? "" : " (forzada)")
+                      << std::endl;
+        }
+    }
