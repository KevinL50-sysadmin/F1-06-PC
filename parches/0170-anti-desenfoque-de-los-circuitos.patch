@@ -6814,3 +6817,46 @@ PresentationFrame GSCpuBackend::PresentFromLocalMemory(const GSPresentationReque
     result.sourceFbp = selected.fbp;
     return result;
 }
+
+uint64_t ps2GsAntiBlurDispfb2(uint64_t pmode, uint64_t dispfb1, uint64_t dispfb2, bool enabled)
+{
+    constexpr uint64_t kDbyShift = 43u;
+    constexpr uint64_t kDbyMask = 0x7FFull << kDbyShift;
+    constexpr uint64_t kBufferMask = 0xFFFFFull | (0x7FFull << 32u); // FBP, FBW, PSM, DBX
+    if (!enabled || (pmode & 3u) != 3u || (dispfb1 & kBufferMask) != (dispfb2 & kBufferMask))
+        return dispfb2;
+    const uint64_t dby1 = (dispfb1 & kDbyMask) >> kDbyShift;
+    const uint64_t dby2 = (dispfb2 & kDbyMask) >> kDbyShift;
+    if (dby1 + 1u != dby2 && dby2 + 1u != dby1)
+        return dispfb2;
+    return (dispfb2 & ~kDbyMask) | (dispfb1 & kDbyMask);
+}
+
+bool ps2GsAntiBlurFromEnvironment(const char *value)
+{
+    return value == nullptr || std::strcmp(value, "0") != 0;
+}
+
+bool ps2GsAntiBlurEnabled()
+{
+    static const bool s_enabled = []
+    {
+        const bool on = ps2GsAntiBlurFromEnvironment(std::getenv("F1_GS_ANTIDESENFOQUE"));
+        std::fprintf(stderr, "[gs] antidesenfoque de los circuitos: %s\n",
+                     on ? "activo" : "desactivado (F1_GS_ANTIDESENFOQUE=0)");
+        return on;
+    }();
+    return s_enabled;
+}
+
+bool ps2GsSkipFlipSnapshot(uint64_t pmode, uint64_t dispfb1, uint64_t dispfb2, bool skippedLast, bool enabled)
+{
+    constexpr uint64_t kFbpMask = 0x1FFull;
+    constexpr uint64_t kOtherBufferMask = (0xFFFFFull & ~kFbpMask) | (0x7FFull << 32u); // FBW, PSM, DBX
+    if (!enabled || skippedLast || (pmode & 3u) != 3u || (dispfb1 & kFbpMask) == (dispfb2 & kFbpMask) ||
+        (dispfb1 & kOtherBufferMask) != (dispfb2 & kOtherBufferMask))
+        return false;
+    const uint64_t dby1 = (dispfb1 >> 43u) & 0x7FFu;
+    const uint64_t dby2 = (dispfb2 >> 43u) & 0x7FFu;
+    return dby1 + 1u == dby2 || dby2 + 1u == dby1;
+}
