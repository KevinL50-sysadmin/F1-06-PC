--- a/ps2xRuntime/include/runtime/gs/gs_cpu_backend.h
+++ b/ps2xRuntime/include/runtime/gs/gs_cpu_backend.h
@@ -126,3 +126,18 @@ private:
 
     std::unique_ptr<BandState> m_bands; // null: no band workers
 };
+
+// Patch 0170: anti-blur, as PCSX2's PCRTC Anti-Blur. With both read circuits enabled (PMODE EN1, EN2) reading the
+// same buffer (FBP, FBW, PSM, DBX) one line apart (DBY), the flicker filter of an interlaced TV: circuit 2 gets
+// circuit 1's DBY, so the merge blends the same lines. Returns DISPFB2 as presented (unchanged otherwise).
+uint64_t ps2GsAntiBlurDispfb2(uint64_t pmode, uint64_t dispfb1, uint64_t dispfb2, bool enabled);
+// On unless value is "0" (F1_GS_ANTIDESENFOQUE=0, diagnosis).
+bool ps2GsAntiBlurFromEnvironment(const char *value);
+// F1_GS_ANTIDESENFOQUE, read once (the first call prints it).
+bool ps2GsAntiBlurEnabled();
+// Patch 0170: whether the flip snapshot (patch 0104, ps2GsBeforeDisplayChange) of these display registers is skipped.
+// A game showing both circuits rewrites the DISPFB pair at each flip (F1 06: DISPFB2, then DISPFB1); the snapshot
+// before the second write is a half flip (circuit 1 on the buffer left, circuit 2 one line off on the next one) and,
+// being the last one, was the one presented. It is skipped when anti-blur is on: both circuits enabled, other FBP,
+// same FBW, PSM and DBX, DBY one line apart; never twice in a row (skippedLast), so such a display never freezes.
+bool ps2GsSkipFlipSnapshot(uint64_t pmode, uint64_t dispfb1, uint64_t dispfb2, bool skippedLast, bool enabled);
