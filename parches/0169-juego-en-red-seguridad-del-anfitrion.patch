+    void Host::Impl::recordFailure(const Attempt &attempt)
+    {
+        ++rejected;
+        const Clock::time_point now = Clock::now();
+        auto found = failures.find(attempt.peer);
+        if (found == failures.end())
+        {
+            if (failures.size() >= kMaxFailureRecords)
+                for (auto i = failures.begin(); i != failures.end();)
+                    i = elapsedMs(i->second.last, now) > kAuthFailureMemoryMs ? failures.erase(i) : std::next(i);
+            if (failures.size() >= kMaxFailureRecords)
+                failures.erase(std::min_element(failures.begin(), failures.end(), [](const auto &a, const auto &b)
+                                                { return a.second.last < b.second.last; }));
+            found = failures.emplace(attempt.peer, Failure{}).first;
+        }
+        Failure &f = found->second;
+        if (f.count > 0 && elapsedMs(f.last, now) > kAuthFailureMemoryMs)
+            f.count = 0;
+        ++f.count;
+        f.last = now;
+        const int delay = std::min(kAuthFailureFirstMs << std::min(f.count - 1u, 5u), kAuthFailureMaxMs);
+        f.until = now + std::chrono::milliseconds(delay);
+        logLine("contrasena incorrecta desde %s: su direccion espera %d ms al siguiente intento", attempt.address.c_str(),
+                delay);
     }
 
