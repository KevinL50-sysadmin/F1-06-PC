+    // A plain TCP connection to a host on 127.0.0.1 from a chosen loopback address (Windows answers the whole
+    // 127/8): what a stranger can do before it knows the password.
+    struct RawConnection
+    {
+        SOCKET s = INVALID_SOCKET;
+        MessageAuth auth;
+        FrameReader reader{auth};
+
+        RawConnection(uint16_t port, const char *from)
+        {
+            WSADATA data;
+            WSAStartup(MAKEWORD(2, 2), &data);
+            s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+            sockaddr_in local{};
+            local.sin_family = AF_INET;
+            inet_pton(AF_INET, from, &local.sin_addr);
+            sockaddr_in remote{};
+            remote.sin_family = AF_INET;
+            remote.sin_port = htons(port);
+            inet_pton(AF_INET, "127.0.0.1", &remote.sin_addr);
+            if (s == INVALID_SOCKET || bind(s, reinterpret_cast<sockaddr *>(&local), sizeof(local)) != 0 ||
+                connect(s, reinterpret_cast<sockaddr *>(&remote), sizeof(remote)) != 0)
+                close();
+        }
+        ~RawConnection() { close(); }
+        RawConnection(const RawConnection &) = delete;
+        RawConnection &operator=(const RawConnection &) = delete;
+
+        void close()
+        {
+            if (s != INVALID_SOCKET)
+                closesocket(s);
+            s = INVALID_SOCKET;
+        }
+        bool connected() const { return s != INVALID_SOCKET; }
+        bool send(const std::vector<uint8_t> &bytes)
+        {
+            return connected() && ::send(s, reinterpret_cast<const char *>(bytes.data()), static_cast<int>(bytes.size()),
+                                         0) == static_cast<int>(bytes.size());
+        }
+        // 1: a frame (type), 0: the host closed, -1: nothing within the time.
+        int next(int milliseconds, uint8_t &type)
+        {
+            const auto end = std::chrono::steady_clock::now() + std::chrono::milliseconds(milliseconds);
+            Frame frame;
+            while (connected())
+            {
+                if (reader.next(frame) == FrameReader::Result::Frame)
+                {
+                    type = frame.type;
+                    return 1;
+                }
+                const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(end -
+                                                                                        std::chrono::steady_clock::now());
+                if (left.count() <= 0)
+                    return -1;
+                fd_set readable;
+                FD_ZERO(&readable);
+                FD_SET(s, &readable);
+                timeval wait{0, static_cast<long>(left.count()) * 1000};
+                if (select(0, &readable, nullptr, nullptr, &wait) <= 0)
+                    return -1;
+                uint8_t buffer[512];
+                const int n = recv(s, reinterpret_cast<char *>(buffer), sizeof(buffer), 0);
+                if (n <= 0 || !reader.feed(buffer, static_cast<size_t>(n)))
+                    return 0;
+            }
+            return 0;
+        }
+        // The host closes this connection within the time (after any frames it sent).
+        bool closedWithin(int milliseconds)
+        {
+            const auto end = std::chrono::steady_clock::now() + std::chrono::milliseconds(milliseconds);
+            uint8_t type = 0;
+            while (std::chrono::steady_clock::now() < end)
+            {
+                const int left = static_cast<int>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                                      end - std::chrono::steady_clock::now())
+                                                      .count());
+                const int r = next(std::max(left, 1), type);
+                if (r == 0)
+                    return true;
+                if (r < 0)
+                    return false;
+            }
+            return false;
+        }
+    };
