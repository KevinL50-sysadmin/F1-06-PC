+    // Patch 0076: the frame and Z buffer accesses of the fast paths below with the byte address worked out once per
+    // pixel (four lanes at a time by texelLanes) for both the read and the write: the address PixelStorageTraits<P>::
+    // Read and Write compute for (x, y) of the buffer at block `base` with width `bw`, from TexturePageTable<P>() as
+    // pipelineRead/pipelineWrite.
+    struct BufferLanes
+    {
+        const uint16_t *blockTable;
+        __m128i basePage, rowPages;
+    };
+
+    template <GSMem::PixelStorageMode P>
+    BufferLanes makeBufferLanes(uint32_t base, uint32_t bw)
+    {
+        using Traits = GSMem::PixelStorageTraits<P>;
+        constexpr GSMem::Extent2D kExtent = Traits::PageExtent();
+        const auto &table = GSMem::TexturePageTable<P>();
+        BufferLanes bl;
+        bl.blockTable = reinterpret_cast<const uint16_t *>(&table[base % Traits::BlocksPerPage()]);
+        bl.basePage = _mm_set1_epi32(static_cast<int>(static_cast<uint32_t>(base / Traits::BlocksPerPage())));
+        bl.rowPages = _mm_set1_epi32(static_cast<int>((bw * 64u) / static_cast<uint32_t>(kExtent.x)));
+        return bl;
+    }
+
+    template <GSMem::PixelStorageMode P>
+    PS2_GS_INLINE uint32_t pixelByteAddr(const uint16_t *blockTable, uint32_t pre, uint32_t idx)
+    {
+        using Packed = typename GSMem::PixelStorageTraits<P>::PackedT;
+        const uint32_t bits = pre + static_cast<uint32_t>(blockTable[idx]) * static_cast<uint32_t>(GSMem::UnpackedBitWidth(P));
+        return (bits / 8u) & static_cast<uint32_t>(GSMem::MEMORY_SIZE - sizeof(Packed));
+    }
+
+    // What the fast paths need to write through writePixelCt32Z24At (nullptr: writePixelBody, as patch 0075; A/B mode 61).
+    struct FastWrite
+    {
+        BlendLanes blend;
+        BufferLanes frame, depth;
+    };
+
+    FastWrite makeFastWrite(const PixelPipeline &pp)
+    {
+        FastWrite fw;
+        fw.blend = makeBlendLanes(pp);
+        fw.frame = makeBufferLanes<GSMem::C32>(pp.fbp, pp.fbw);
+        fw.depth = makeBufferLanes<GSMem::Z24>(pp.zbp, pp.fbw);
+        return fw;
+    }
