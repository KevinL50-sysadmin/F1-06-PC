+    // R | G << 8 | B << 16 of the blend of source `cs` and destination `cd` (their R, G, B bytes) with factor cAlpha.
+    PS2_GS_INLINE uint32_t blendRgbLanes(const BlendLanes &bl, uint32_t cs, uint32_t cd, int cAlpha)
+    {
+        const __m128i zero = _mm_setzero_si128();
+        const __m128i s = _mm_unpacklo_epi8(_mm_cvtsi32_si128(static_cast<int>(cs)), zero);
+        const __m128i d = _mm_unpacklo_epi8(_mm_cvtsi32_si128(static_cast<int>(cd)), zero);
+        const __m128i a = _mm_or_si128(_mm_and_si128(s, bl.aSrc), _mm_and_si128(d, bl.aDst));
+        const __m128i b = _mm_or_si128(_mm_and_si128(s, bl.bSrc), _mm_and_si128(d, bl.bDst));
+        const __m128i dd = _mm_or_si128(_mm_and_si128(s, bl.dSrc), _mm_and_si128(d, bl.dDst));
+        const __m128i diff = _mm_sub_epi16(a, b);
+        const __m128i c = _mm_set1_epi16(static_cast<short>(cAlpha));
+        const __m128i product = _mm_unpacklo_epi16(_mm_mullo_epi16(diff, c), _mm_mulhi_epi16(diff, c));
+        const __m128i shifted = _mm_srai_epi32(product, 7);
+        const __m128i sum = _mm_add_epi16(_mm_packs_epi32(shifted, shifted), dd);
+        return static_cast<uint32_t>(_mm_cvtsi128_si32(_mm_packus_epi16(sum, sum))) & 0x00FFFFFFu;
+    }
