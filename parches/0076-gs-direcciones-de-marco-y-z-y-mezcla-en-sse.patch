+    // Patch 0076: the alpha blend of writePixelTyped on the R, G and B lanes at once. A, B and D (ALPHA's asel, bsel,
+    // dsel: 0 the source colour, 1 the destination, 2 and 3 zero) as lane masks worked out once per job; per channel
+    // clampU8(((A - B) * C >> 7) + D) with the exact 32-bit product (mullo/mulhi), the arithmetic shift and the unsigned
+    // saturating pack (the shifted product is within +-509, so the signed pack to 16 bits keeps it).
+    struct BlendLanes
+    {
+        __m128i aSrc, aDst, bSrc, bDst, dSrc, dDst;
+    };
+
+    BlendLanes makeBlendLanes(const PixelPipeline &pp)
+    {
+        const auto lanes = [](bool on) { return on ? _mm_setr_epi16(-1, -1, -1, 0, 0, 0, 0, 0) : _mm_setzero_si128(); };
+        BlendLanes bl;
+        bl.aSrc = lanes(pp.asel == 0), bl.aDst = lanes(pp.asel == 1);
+        bl.bSrc = lanes(pp.bsel == 0), bl.bDst = lanes(pp.bsel == 1);
+        bl.dSrc = lanes(pp.dsel == 0), bl.dDst = lanes(pp.dsel == 1);
+        return bl;
+    }
