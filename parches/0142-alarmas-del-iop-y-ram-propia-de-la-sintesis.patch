+    int32_t IopKernel::setAlarm(uint32_t clockAddress, uint32_t handler, uint32_t common, uint32_t gp, uint64_t currentCycle)
+    {
+        for (const Alarm &alarm : m_alarms)
+            if (alarm.handler == handler && alarm.common == common)
+                return kErrorFoundHandler;
+        if (m_alarms.size() >= kMaxAlarms)
+            return kErrorNoMemory;
+        const uint64_t clock = static_cast<uint64_t>(m_memory.read32(clockAddress)) |
+                               (static_cast<uint64_t>(m_memory.read32(clockAddress + 4u)) << 32u);
+        m_alarms.push_back(Alarm{handler, common, gp, currentCycle + std::max(clock, kMinAlarmCycles)});
+        return 0;
+    }
+
+    int32_t IopKernel::cancelAlarm(uint32_t handler, uint32_t common)
+    {
+        const auto it = std::find_if(m_alarms.begin(), m_alarms.end(), [&](const Alarm &alarm)
+                                     { return alarm.handler == handler && alarm.common == common; });
+        if (it == m_alarms.end())
+            return kErrorNotFoundHandler;
+        m_alarms.erase(it);
+        return 0;
+    }
+
+    void IopKernel::serviceAlarms(uint64_t currentCycle, IopGuestExecutor &executor)
+    {
+        if (m_servicingAlarms || m_alarms.empty())
+            return;
+        m_servicingAlarms = true;
+        // Earliest first; a handler may set or cancel alarms (its own included), so each one is taken out before it
+        // runs and only goes back if it asked for another call and nobody set it again meanwhile.
+        for (;;)
+        {
+            const auto due = std::min_element(m_alarms.begin(), m_alarms.end(), [](const Alarm &a, const Alarm &b)
+                                              { return a.dueCycle < b.dueCycle; });
+            if (due == m_alarms.end() || due->dueCycle > currentCycle)
+                break;
+            const Alarm alarm = *due;
+            m_alarms.erase(due);
+            const uint32_t next = executor.executeGuestFunctionWithBudget(alarm.handler, alarm.common, 0u, 0u, 0u,
+                                                                          alarm.gp, 100000u);
+            const bool setAgain = std::any_of(m_alarms.begin(), m_alarms.end(), [&](const Alarm &a)
+                                              { return a.handler == alarm.handler && a.common == alarm.common; });
+            if (next != 0u && !setAgain && m_alarms.size() < kMaxAlarms)
+            {
+                Alarm again = alarm;
+                again.dueCycle = alarm.dueCycle + std::max<uint64_t>(next, kMinAlarmCycles);
+                if (again.dueCycle <= currentCycle)
+                    again.dueCycle = currentCycle + kMinAlarmCycles; // at most one call per alarm and service
+                m_alarms.push_back(again);
+            }
+        }
+        m_servicingAlarms = false;
+    }
+
+    uint64_t IopKernel::nextAlarmCycle(uint64_t fallback) const noexcept
+    {
+        uint64_t next = fallback;
+        for (const Alarm &alarm : m_alarms)
+            next = std::min(next, alarm.dueCycle);
+        return next;
+    }
