diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index bcb99e6..8cbecf0 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -371,6 +371,39 @@ void EeScheduler::run()
             running->invocations.push_back(std::move(invocation));
             continue;
         }
+        // Patch 0112: interrupt-like invocations (INTC handlers, alarms, GS callbacks, SIF commands from the IOP) also
+        // enter on top of a thread-level invocation (an HLE call or a callback that guest code runs in the thread's
+        // name), as a real interrupt would; only not on top of another interrupt-like one. Before, they waited for the
+        // invocation to finish: F1 06's video audio callback (run by sceMpeg in the video thread) polls until CORE.IRX
+        // answers, and that answer is a SIF command, so the intro hung ("cid 1 sin respuesta").
+        if (!m_pendingInvocations.empty() && !running->invocations.empty())
+        {
+            const auto interruptLike = [](GuestInvocationKind kind)
+            {
+                return kind == GuestInvocationKind::Interrupt || kind == GuestInvocationKind::Alarm ||
+                       kind == GuestInvocationKind::GsCallback || kind == GuestInvocationKind::SifCommand;
+            };
+            const bool insideInterruptLike = std::any_of(running->invocations.begin(), running->invocations.end(),
+                                                         [&](const GuestInvocation &invocation)
+                                                         { return interruptLike(invocation.kind); });
+            if (!insideInterruptLike)
+            {
+                const auto pending = std::find_if(m_pendingInvocations.begin(), m_pendingInvocations.end(),
+                                                  [&](const GuestInvocation &invocation)
+                                                  { return interruptLike(invocation.kind); });
+                if (pending != m_pendingInvocations.end())
+                {
+                    GuestInvocation invocation = std::move(*pending);
+                    m_pendingInvocations.erase(pending);
+                    if (getRegU32(&invocation.context, 29) == 0u)
+                    {
+                        SET_GPR_U32(&invocation.context, 29, invocationStackTop());
+                    }
+                    running->invocations.push_back(std::move(invocation));
+                    continue;
+                }
+            }
+        }
 
         // Traza temporal (F1 06): ultimas reanudaciones del planificador, volcadas si falta la funcion.
         struct TrazaDespacho
@@ -2532,3 +2565,10 @@ void ps2SetVideoModePal(bool pal)
         std::fprintf(stderr, "[ee:vblank] %s: %u us%s\n", pal ? "PAL" : "NTSC", period,
                      forcedVBlankPeriodUs() != 0u ? " (PS2X_VBLANK_HZ manda)" : "");
 }
+
+// Patch 0112: VBLANK period in microseconds (PAL 20000, NTSC 16667, or PS2X_VBLANK_HZ), for the sceMpeg HLE's picture
+// clock, which counts in VBLANK ticks.
+uint32_t ps2VBlankPeriodUs()
+{
+    return static_cast<uint32_t>(vblankPeriod().count());
+}
