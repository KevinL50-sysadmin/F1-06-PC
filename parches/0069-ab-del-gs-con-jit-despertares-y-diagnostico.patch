+int ps2EeOwnCore(bool own)
+{
+    const HostCores &c = hostCores();
+    if (!own)
+    {
+        s_eeOwnCore.store(-1, std::memory_order_relaxed);
+        SetProcessDefaultCpuSets(GetCurrentProcess(), nullptr, 0u);
+        if (c.hybrid)
+            SetThreadSelectedCpuSets(GetCurrentThread(), c.performanceIds, c.performanceCount);
+        else
+            SetThreadSelectedCpuSets(GetCurrentThread(), nullptr, 0u);
+        return -1;
+    }
+    // Only with enough cores for the EE thread, the GS thread and its four band workers on cores of their own.
+    uint8_t seen[256] = {};
+    unsigned cores = 0u;
+    for (unsigned long i = 0u; i < c.allCount; ++i)
+        if (seen[c.allCore[i]]++ == 0u)
+            ++cores;
+    if (cores < 7u)
+        return -1;
+    // The core the EE thread is on, if it is a performance one other than core 0 (where most interrupts go);
+    // otherwise the last performance core.
+    int core = -1;
+    const uint8_t logical = static_cast<uint8_t>(GetCurrentProcessorNumber() & 255u);
+    if (c.efficiency[logical] == c.best && c.coreOf[logical] != 0u)
+        core = c.coreOf[logical];
+    for (unsigned long i = 0u; core < 0 && i < c.allCount; ++i)
+        if (c.allClass[c.allCount - 1u - i] == c.best)
+            core = c.allCore[c.allCount - 1u - i];
+    if (core < 0)
+        return -1;
+    // The EE thread on both hyper-threads of that core (it may move between them, nobody else of the process uses
+    // them), everything else of the process off it.
+    unsigned long mine[8];
+    unsigned long mineCount = 0u;
+    unsigned long others[256];
+    unsigned long count = 0u;
+    for (unsigned long i = 0u; i < c.allCount; ++i)
+    {
+        if (static_cast<int>(c.allCore[i]) != core)
+            others[count++] = c.allIds[i];
+        else if (mineCount < 8u)
+            mine[mineCount++] = c.allIds[i];
+    }
+    s_eeOwnCore.store(core, std::memory_order_relaxed);
+    SetProcessDefaultCpuSets(GetCurrentProcess(), others, count);
+    SetThreadSelectedCpuSets(GetCurrentThread(), mine, mineCount);
+    return core;
