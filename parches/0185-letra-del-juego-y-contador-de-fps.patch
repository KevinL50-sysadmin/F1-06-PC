diff --git a/ps2xRuntime/src/lib/ps2_game_font.cpp b/ps2xRuntime/src/lib/ps2_game_font.cpp
new file mode 100644
index 0000000..96d22be
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_game_font.cpp
@@ -0,0 +1,366 @@
+#include "ps2_game_font.h"
+#include "runtime/gs/ps2_gs_psmct32.h"
+#include "runtime/gs/ps2_gs_psmt4.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstring>
+#include <map>
+#include <mutex>
+
+namespace ps2x
+{
+    const GameFontGlyph *GameFont::glyph(uint32_t codepoint) const
+    {
+        for (const GameFontGlyph &g : glyphs)
+            if (g.codepoint == codepoint)
+                return &g;
+        return nullptr;
+    }
+
+    namespace
+    {
+        constexpr size_t kGlyphRecord = 0x48u;
+        constexpr size_t kPairRecord = 0x28u;
+        constexpr size_t kPageHeader = 7u * 4u;
+        constexpr uint32_t kMaxRecords = 0x10000u;
+
+        struct Reader
+        {
+            const uint8_t *data;
+            size_t size;
+
+            bool has(size_t at, size_t n) const
+            {
+                return at <= size && n <= size - at;
+            }
+            uint32_t u32(size_t at) const
+            {
+                uint32_t v = 0;
+                std::memcpy(&v, data + at, 4);
+                return v;
+            }
+            uint64_t u64(size_t at) const
+            {
+                uint64_t v = 0;
+                std::memcpy(&v, data + at, 8);
+                return v;
+            }
+            float f32(size_t at) const
+            {
+                float v = 0.0f;
+                std::memcpy(&v, data + at, 4);
+                return v;
+            }
+        };
+
+        // A page: 7 u32 (records - 2 first), the (records) u32 pointers, then (records) records. Its end, or 0.
+        size_t skipPage(const Reader &r, size_t at, size_t recordSize, uint32_t &records)
+        {
+            if (!r.has(at, kPageHeader))
+                return 0u;
+            const uint32_t count = r.u32(at);
+            if (count > kMaxRecords)
+                return 0u;
+            records = count + 2u;
+            const size_t bytes = kPageHeader + size_t(records) * (4u + recordSize);
+            return r.has(at, bytes) ? at + bytes : 0u;
+        }
+
+        struct Upload
+        {
+            uint32_t width = 0, height = 0;
+            size_t data = 0, bytes = 0, end = 0;
+        };
+
+        // The next GS upload from `from` on: the A+D writes of TRXREG (0x52) and TRXDIR (0x53, host to local) and the
+        // IMAGE GIF tag right after them, with exactly the bytes of a width x height CT32 rectangle.
+        bool nextUpload(const Reader &r, size_t from, Upload &upload)
+        {
+            for (size_t at = from; r.has(at, 48u); ++at)
+            {
+                // at: TRXREG's data; +8 its address; +16 TRXDIR's data; +24 its address; +32 the IMAGE tag.
+                if (r.u64(at + 8u) != 0x52u || r.u64(at + 24u) != 0x53u || r.u64(at + 16u) != 0u)
+                    continue;
+                const uint64_t trxreg = r.u64(at), tag = r.u64(at + 32u);
+                if (((tag >> 58) & 3u) != 2u)
+                    continue;
+                upload.width = static_cast<uint32_t>(trxreg & 0xFFFu);
+                upload.height = static_cast<uint32_t>((trxreg >> 32) & 0xFFFu);
+                upload.data = at + 48u;
+                upload.bytes = size_t(tag & 0x7FFFu) * 16u;
+                upload.end = upload.data + upload.bytes;
+                return upload.width != 0u && upload.height != 0u &&
+                       upload.bytes == size_t(upload.width) * upload.height * 4u && r.has(upload.data, upload.bytes);
+            }
+            return false;
+        }
+    }
+
+    bool decodeGameFont(const uint8_t *data, size_t size, GameFont &font)
+    {
+        if (data == nullptr)
+            return false;
+        const Reader r{data, size};
+        if (!r.has(0u, 8u))
+            return false;
+        GameFont out;
+        out.lineHeight = static_cast<int>(r.u32(4u));
+        if (out.lineHeight <= 0 || out.lineHeight > 256)
+            return false;
+
+        // The glyph page.
+        uint32_t records = 0u;
+        size_t at = skipPage(r, 8u, kGlyphRecord, records);
+        if (at == 0u)
+            return false;
+        const size_t glyphsAt = 8u + kPageHeader + size_t(records) * 4u;
+        struct Raw
+        {
+            uint32_t code;
+            float width, height, u0, v1, advance, offsetX;
+        };
+        std::vector<Raw> raw;
+        for (uint32_t i = 0; i < records; ++i)
+        {
+            const size_t g = glyphsAt + size_t(i) * kGlyphRecord;
+            if ((r.u32(g + 0x44u) & 0xFFu) != 0u) // a sentinel
+                continue;
+            raw.push_back({r.u32(g) & 0xFFFFu, r.f32(g + 4u), r.f32(g + 8u), r.f32(g + 12u), r.f32(g + 24u),
+                           r.f32(g + 28u), r.f32(g + 32u)});
+            // Its pair adjustment page (not used: the pen moves by the advance).
+            if (static_cast<int32_t>(r.u32(g + 0x24u)) != -1)
+            {
+                uint32_t pairs = 0u;
+                at = skipPage(r, at, kPairRecord, pairs);
+                if (at == 0u)
+                    return false;
+            }
+        }
+        if (raw.empty())
+            return false;
+
+        // The texture: the picture and then its 16 colour palette.
+        Upload picture, palette;
+        if (!nextUpload(r, at, picture) || !nextUpload(r, picture.end, palette))
+            return false;
+        if (picture.width % 64u != 0u || picture.height % 32u != 0u || picture.width > 1024u ||
+            picture.height > 1024u || palette.width * palette.height != 16u)
+            return false;
+
+        // GS memory as the game leaves it: the CT32 rectangle (buffer width in 64 pixel units), read back as PSMT4,
+        // twice as wide and four times as high (the same pages).
+        const uint32_t cw = picture.width, ch = picture.height;
+        std::vector<uint8_t> gs(size_t(cw) * ch * 4u, 0u);
+        for (uint32_t y = 0; y < ch; ++y)
+            for (uint32_t x = 0; x < cw; ++x)
+            {
+                const uint32_t address = GSPSMCT32::addrPSMCT32(0u, cw / 64u, x, y);
+                if (address + 4u > gs.size())
+                    return false;
+                std::memcpy(&gs[address], data + picture.data + (size_t(y) * cw + x) * 4u, 4u);
+            }
+        uint8_t colours[16][4];
+        for (int i = 0; i < 16; ++i)
+        {
+            const uint32_t c = r.u32(palette.data + size_t(i) * 4u);
+            const uint32_t alpha = c >> 24;
+            colours[i][0] = static_cast<uint8_t>(c);
+            colours[i][1] = static_cast<uint8_t>(c >> 8);
+            colours[i][2] = static_cast<uint8_t>(c >> 16);
+            colours[i][3] = static_cast<uint8_t>(alpha >= 0x80u ? 255u : alpha * 2u);
+        }
+        out.width = static_cast<int>(cw * 2u);
+        out.height = static_cast<int>(ch * 4u);
+        out.rgba.resize(size_t(out.width) * out.height * 4u);
+        for (int y = 0; y < out.height; ++y)
+            for (int x = 0; x < out.width; ++x)
+            {
+                const uint32_t nibble = GSPSMT4::addrPSMT4(0u, static_cast<uint32_t>(out.width) / 64u, x, y);
+                if ((nibble >> 1) >= gs.size())
+                    return false;
+                const uint8_t b = gs[nibble >> 1];
+                const uint8_t index = (nibble & 1u) ? static_cast<uint8_t>(b >> 4) : static_cast<uint8_t>(b & 0x0Fu);
+                std::memcpy(&out.rgba[(size_t(y) * out.width + x) * 4u], colours[index], 4u);
+            }
+
+        // The glyphs' rectangles in the atlas.
+        for (const Raw &g : raw)
+        {
+            if (!std::isfinite(g.width) || !std::isfinite(g.height) || !std::isfinite(g.u0) || !std::isfinite(g.v1) ||
+                !std::isfinite(g.advance) || !std::isfinite(g.offsetX))
+                continue;
+            GameFontGlyph glyph;
+            glyph.codepoint = g.code;
+            glyph.x = static_cast<int>(std::lround(g.u0 * out.width));
+            glyph.y = static_cast<int>(std::lround((1.0f - g.v1) * out.height));
+            glyph.width = static_cast<int>(std::lround(g.width));
+            glyph.height = static_cast<int>(std::lround(g.height));
+            glyph.offsetX = static_cast<int>(std::lround(g.offsetX));
+            glyph.advance = g.advance;
+            if (glyph.x < 0 || glyph.y < 0 || glyph.width < 0 || glyph.height < 0 ||
+                glyph.x + glyph.width > out.width || glyph.y + glyph.height > out.height ||
+                out.glyph(glyph.codepoint) != nullptr)
+                continue;
+            out.glyphs.push_back(glyph);
+        }
+        if (out.glyphs.empty())
+            return false;
+        // The rows of the line the digits and capitals cover (the cells hang from the top of the line).
+        out.inkTop = out.lineHeight;
+        out.inkBottom = -1;
+        for (const GameFontGlyph &g : out.glyphs)
+        {
+            const bool digitOrCapital = (g.codepoint >= '0' && g.codepoint <= '9') || (g.codepoint >= 'A' && g.codepoint <= 'Z');
+            if (!digitOrCapital)
+                continue;
+            for (int row = 0; row < g.height; ++row)
+                for (int col = 0; col < g.width; ++col)
+                    if (out.rgba[(size_t(g.y + row) * out.width + g.x + col) * 4u + 3u] != 0u)
+                    {
+                        out.inkTop = std::min(out.inkTop, row);
+                        out.inkBottom = std::max(out.inkBottom, row);
+                    }
+        }
+        if (out.inkBottom < out.inkTop) // no digit nor capital: the whole line
+        {
+            out.inkTop = 0;
+            out.inkBottom = out.lineHeight - 1;
+        }
+        font = std::move(out);
+        return true;
+    }
+
+    namespace
+    {
+        struct StoredFont
+        {
+            std::vector<uint8_t> bytes;
+            uint32_t version = 0u;
+        };
+        std::mutex g_storeMutex;
+        std::map<std::string, StoredFont, std::less<>> g_store;
+    }
+
+    bool storeGameFontFile(std::string_view name, std::vector<uint8_t> bytes)
+    {
+        std::lock_guard<std::mutex> lock(g_storeMutex);
+        auto it = g_store.find(name);
+        if (it == g_store.end())
+            it = g_store.emplace(std::string(name), StoredFont{}).first;
+        if (it->second.version != 0u && it->second.bytes == bytes)
+            return false;
+        it->second.bytes = std::move(bytes);
+        ++it->second.version;
+        return true;
+    }
+
+    bool gameFontFile(std::string_view name, std::vector<uint8_t> &bytes, uint32_t &version)
+    {
+        std::lock_guard<std::mutex> lock(g_storeMutex);
+        const auto it = g_store.find(name);
+        if (it == g_store.end())
+            return false;
+        bytes = it->second.bytes;
+        version = it->second.version;
+        return true;
+    }
+
+    int nearestGameFont(const std::vector<int> &lineHeights, float size)
+    {
+        int best = -1;
+        for (int i = 0; i < static_cast<int>(lineHeights.size()); ++i)
+        {
+            if (best < 0)
+            {
+                best = i;
+                continue;
+            }
+            const float d = std::fabs(lineHeights[i] - size), bestD = std::fabs(lineHeights[best] - size);
+            if (d < bestD || (d == bestD && lineHeights[i] > lineHeights[best]))
+                best = i;
+        }
+        return best;
+    }
+
+    HostFontKind hostFontKind(bool raceOnScreen, bool raceFontReady, bool menuFontReady, bool builtInReady)
+    {
+        if (raceOnScreen ? raceFontReady : !menuFontReady && raceFontReady)
+            return HostFontKind::RaceHud;
+        if (menuFontReady)
+            return HostFontKind::Menu;
+        return builtInReady ? HostFontKind::BuiltIn : HostFontKind::Default;
+    }
+
+    bool raceCameraRecent(double lastCameraAt, double now)
+    {
+        return lastCameraAt >= 0.0 && now >= lastCameraAt && now - lastCameraAt <= kRaceCameraWindow;
+    }
+
+    namespace
+    {
+        const auto g_raceClockStart = std::chrono::steady_clock::now();
+        std::atomic<double> g_lastRaceCamera{-1.0};
+
+        double raceClock()
+        {
+            return std::chrono::duration<double>(std::chrono::steady_clock::now() - g_raceClockStart).count();
+        }
+    }
+
+    void noteRaceCameraFrame()
+    {
+        g_lastRaceCamera.store(raceClock(), std::memory_order_relaxed);
+    }
+
+    bool raceOnScreen()
+    {
+        return raceCameraRecent(g_lastRaceCamera.load(std::memory_order_relaxed), raceClock());
+    }
+
+    GamePictureScale gamePictureScale(float pictureWidth, float pictureHeight, int windowHeight)
+    {
+        if (!(pictureWidth > 0.0f) || !(pictureHeight > 0.0f))
+        {
+            pictureHeight = static_cast<float>(std::max(windowHeight, 1));
+            pictureWidth = pictureHeight * 4.0f / 3.0f;
+        }
+        return {pictureWidth / kGameFrameWidth, pictureHeight / kGameFrameHeight};
+    }
+
+    namespace
+    {
+        std::atomic<float> g_pictureWidth{0.0f}, g_pictureHeight{0.0f};
+    }
+
+    void noteGamePicture(float width, float height)
+    {
+        g_pictureWidth.store(width, std::memory_order_relaxed);
+        g_pictureHeight.store(height, std::memory_order_relaxed);
+    }
+
+    GamePictureScale currentGamePictureScale(int windowHeight)
+    {
+        return gamePictureScale(g_pictureWidth.load(std::memory_order_relaxed),
+                                g_pictureHeight.load(std::memory_order_relaxed), windowHeight);
+    }
+
+    float gameFontPixelSize(int lineHeight, int windowHeight)
+    {
+        return lineHeight > 0 && windowHeight > 0 ? static_cast<float>(lineHeight) * windowHeight / kGameFrameHeight
+                                                  : 0.0f;
+    }
+
+    std::string gameFpsValue(double framesPerSecond)
+    {
+        const double fps = std::isfinite(framesPerSecond) ? std::clamp(framesPerSecond, 0.0, 999.0) : 0.0;
+        return std::to_string(std::lround(fps));
+    }
+
+    std::string gameFpsText(double framesPerSecond)
+    {
+        return gameFpsValue(framesPerSecond) + " " + kGameFpsLabel;
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_game_font.h b/ps2xRuntime/src/lib/ps2_game_font.h
new file mode 100644
index 0000000..2ce6ee3
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_game_font.h
@@ -0,0 +1,105 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Aspecto T2: the game's own letters (Fonts/eurostyle*Px.bft) for the host's notices. The port copies each .bft as the
+// game reads it from the user's disc (func_264888 in src/f1_overrides.cpp); nothing of the game goes in the package.
+//
+// The .bft format (little endian), as the game's reader func_264888 takes it:
+//   u32 0, u32 line height in pixels
+//   glyph page: 7 u32 (count, count, first = 2, last, 'A', -1, last), (count + 2) u32 (the tool's pointers, unused),
+//     (count + 2) glyphs of 0x48 bytes: u32 code (low 16 bits: the Unicode character, Latin-1 and a few more),
+//     8 float (width, height, u0, u1, v0, v1, advance, x offset), 8 int32 (+0x24: its pair adjustment page or -1),
+//     u32 (+0x44, low byte: 0 for a glyph, 1 for the two sentinels at 0 and 1)
+//   for every glyph with a pair adjustment page: 7 u32 (n, ...), (n + 2) u32, (n + 2) records of 0x28 bytes
+//   the texture, as the GS packets that load it: A+D (BITBLTBUF, TRXPOS, TRXREG, TRXDIR) and an IMAGE GIF tag, first
+//     the picture (PSMT4 sent as CT32, w x h: the atlas is 2w x 4h) and then its palette (8 x 2 CT32, 16 colours;
+//     white with the PS2 alpha, 0x80 = opaque).
+// A glyph is the atlas rectangle (u0 * atlas width, (1 - v1) * atlas height, width, height): cells hang from the top of
+// the line, and the pen moves by the advance (the x offset moves the picture only).
+namespace ps2x
+{
+    struct GameFontGlyph
+    {
