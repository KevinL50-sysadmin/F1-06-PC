+        {
+            const float room = static_cast<float>(band.height) - c.edge - 2.0f;
+            const float shrink = std::min(1.0f, room / (ink->bottom - ink->top));
+            c.fontSize = ink->fontSize * shrink;
+            inkTop = ink->top * shrink;
+            inkHeight = (ink->bottom - ink->top) * shrink;
