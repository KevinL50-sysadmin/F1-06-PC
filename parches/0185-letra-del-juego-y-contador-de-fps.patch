+#include "MiniTest.h"
+#include "ps2_display.h"
+#include "ps2_game_font.h"
+#include "ps2_host_overlay.h"
+#include "runtime/gs/ps2_gs_psmct32.h"
+#include "runtime/gs/ps2_gs_psmt4.h"
+
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <string>
+#include <vector>
+
+// Aspecto T2-T3: the game's letters (.bft) for the host's notices and the "50 FPS" counter. The samples are built here
+// (a small made-up font with the layout of the game's files); no byte of the game is in the tests.
+namespace
+{
+    struct SampleGlyph
+    {
+        uint32_t codepoint;
+        int x, y, width, height;
+        float advance, offsetX;
+        int pairPage; // records in its pair adjustment page, or -1
+    };
+
+    constexpr int kAtlasWidth = 128, kAtlasHeight = 128; // PSMT4: one GS page, sent as 64 x 32 CT32
+    constexpr int kLineHeight = 10;
+
+    const std::vector<SampleGlyph> &sampleGlyphs()
+    {
+        static const std::vector<SampleGlyph> glyphs = {
+            {0x41u, 4, 0, 6, 8, 7.0f, 1.0f, 1},       // A, with a pair adjustment page
+            {0xD1u, 20, 16, 7, 10, 8.0f, 0.0f, -1},   // N with tilde
+            {0x35u, 100, 40, 5, 9, 6.0f, -1.0f, 3},   // 5
+            {0x20u, 0, 0, 0, 10, 3.0f, 0.0f, -1},     // space
+        };
+        return glyphs;
+    }
+
+    // The palette index of an atlas pixel: inside a glyph, below its two clear top rows (the game's cells have room
+    // above the capitals), a pattern of 15 colours; elsewhere, 0 (clear).
+    constexpr int kClearTopRows = 2;
+    uint8_t sampleIndex(int x, int y)
+    {
+        for (const SampleGlyph &g : sampleGlyphs())
+            if (x >= g.x && x < g.x + g.width && y >= g.y + kClearTopRows && y < g.y + g.height)
+                return static_cast<uint8_t>(1 + (x * 3 + y * 5) % 15);
+        return 0u;
+    }
+
+    // White with the PS2 alpha: entry i, i * 8; the last one, 0x80 (opaque).
+    uint32_t samplePalette(int i)
+    {
+        const uint32_t alpha = i == 15 ? 0x80u : static_cast<uint32_t>(i) * 8u;
+        return 0x00FFFFFFu | (alpha << 24);
+    }
+
+    void put32(std::vector<uint8_t> &out, uint32_t v)
+    {
+        for (int i = 0; i < 4; ++i)
+            out.push_back(static_cast<uint8_t>(v >> (8 * i)));
+    }
+
+    void put64(std::vector<uint8_t> &out, uint64_t v)
+    {
+        for (int i = 0; i < 8; ++i)
+            out.push_back(static_cast<uint8_t>(v >> (8 * i)));
+    }
+
+    void putFloat(std::vector<uint8_t> &out, float f)
+    {
+        uint32_t v = 0;
+        std::memcpy(&v, &f, 4);
+        put32(out, v);
+    }
+
+    // A+D (BITBLTBUF, TRXPOS, TRXREG, TRXDIR) and an IMAGE tag with the CT32 data of a w x h rectangle.
+    void putUpload(std::vector<uint8_t> &out, uint32_t w, uint32_t h, const std::vector<uint8_t> &data)
+    {
+        put64(out, (1ull << 60) | (0ull << 58) | 4u); // GIF tag: 4 loops of A+D
+        put64(out, 0xEu);
+        put64(out, 0u);
+        put64(out, 0x50u);
+        put64(out, 0u);
+        put64(out, 0x51u);
+        put64(out, (uint64_t(h) << 32) | w);
+        put64(out, 0x52u);
+        put64(out, 0u);
+        put64(out, 0x53u);
+        put64(out, (2ull << 58) | (1ull << 15) | (data.size() / 16u)); // IMAGE, end of packet
+        put64(out, 0u);
+        out.insert(out.end(), data.begin(), data.end());
+    }
+
+    std::vector<uint8_t> sampleFont()
+    {
+        const std::vector<SampleGlyph> &glyphs = sampleGlyphs();
+        const uint32_t count = static_cast<uint32_t>(glyphs.size()), records = count + 2u;
+        std::vector<uint8_t> out;
+        put32(out, 0u);
+        put32(out, kLineHeight);
+        for (uint32_t v : {count, count, 2u, count + 1u, 0x41u, 0xFFFFFFFFu, count + 1u})
+            put32(out, v);
+        for (uint32_t i = 0; i < records; ++i)
+            put32(out, 0x00A44790u + i * 16u); // the tool's pointers
+        for (uint32_t i = 0; i < 2u; ++i)      // the two sentinels: junk, low byte of +0x44 = 1
+        {
+            for (int k = 0; k < 17; ++k)
+                put32(out, 0x00FFFFFFu);
+            put32(out, 0x00FFFF01u);
+        }
+        for (const SampleGlyph &g : glyphs)
+        {
+            put32(out, 0x00FF0000u | g.codepoint);
+            putFloat(out, static_cast<float>(g.width));
+            putFloat(out, static_cast<float>(g.height));
+            putFloat(out, g.x / float(kAtlasWidth));
+            putFloat(out, (g.x + g.width) / float(kAtlasWidth));
+            putFloat(out, 1.0f - (g.y + g.height) / float(kAtlasHeight));
+            putFloat(out, 1.0f - g.y / float(kAtlasHeight));
+            putFloat(out, g.advance);
+            putFloat(out, g.offsetX);
+            for (int v : {g.pairPage < 0 ? -1 : 0, 1, -1, 2, -1, 1, -2, 1})
+                put32(out, static_cast<uint32_t>(v));
+            put32(out, 0x00FFFF00u);
+        }
+        for (const SampleGlyph &g : glyphs) // pair adjustment pages (skipped by the decoder)
+        {
+            if (g.pairPage < 0)
+                continue;
+            const uint32_t n = static_cast<uint32_t>(g.pairPage);
+            for (uint32_t v : {n, n, 2u, n + 1u, 3u, 0xFFFFFFFFu, n + 1u})
+                put32(out, v);
+            for (uint32_t i = 0; i < (n + 2u) * (4u + 0x28u); ++i)
+                out.push_back(static_cast<uint8_t>(i * 7u));
+        }
+        // The texture: a header of an odd length (in the game's files the packets are not aligned either) ...
+        for (int i = 0; i < 0x2D; ++i)
+            out.push_back(static_cast<uint8_t>(0x78 + i));
+        // ... the picture: the PSMT4 atlas in GS memory, sent as 64 x 32 CT32 ...
+        std::vector<uint8_t> gs(8192u, 0u);
+        for (int y = 0; y < kAtlasHeight; ++y)
+            for (int x = 0; x < kAtlasWidth; ++x)
+            {
+                const uint32_t nibble = GSPSMT4::addrPSMT4(0u, 2u, x, y);
+                uint8_t &b = gs[nibble >> 1];
+                b = (nibble & 1u) ? static_cast<uint8_t>((b & 0x0Fu) | (sampleIndex(x, y) << 4))
+                                  : static_cast<uint8_t>((b & 0xF0u) | sampleIndex(x, y));
+            }
+        std::vector<uint8_t> picture;
+        for (uint32_t y = 0; y < 32u; ++y)
+            for (uint32_t x = 0; x < 64u; ++x)
+            {
+                const uint32_t at = GSPSMCT32::addrPSMCT32(0u, 1u, x, y);
+                picture.insert(picture.end(), gs.begin() + at, gs.begin() + at + 4);
+            }
+        putUpload(out, 64u, 32u, picture);
+        // ... and the palette, 8 x 2 CT32.
+        std::vector<uint8_t> palette;
+        for (int i = 0; i < 16; ++i)
+            put32(palette, samplePalette(i));
+        putUpload(out, 8u, 2u, palette);
+        return out;
+    }
+
+    bool decode(const std::vector<uint8_t> &bytes, ps2x::GameFont &font)
+    {
+        return ps2x::decodeGameFont(bytes.data(), bytes.size(), font);
+    }
+}
+
+void register_ps2_game_font_tests()
+{
+    MiniTest::Case("GameFont", [](TestCase &tc)
+    {
+        tc.Run("a .bft: line height, atlas and every glyph", [](TestCase &t)
+        {
+            ps2x::GameFont font;
+            t.IsTrue(decode(sampleFont(), font), "the sample decodes");
+            t.Equals(font.lineHeight, kLineHeight, "line height");
+            t.Equals(font.width, kAtlasWidth, "atlas width: twice the CT32 upload's");
+            t.Equals(font.height, kAtlasHeight, "atlas height: four times the CT32 upload's");
+            t.Equals(font.rgba.size(), static_cast<size_t>(kAtlasWidth * kAtlasHeight * 4), "RGBA atlas");
+            t.Equals(font.glyphs.size(), sampleGlyphs().size(), "the sentinels are not glyphs");
+            for (const SampleGlyph &s : sampleGlyphs())
+            {
+                const ps2x::GameFontGlyph *g = font.glyph(s.codepoint);
+                const std::string name = "glyph " + std::to_string(s.codepoint);
+                t.IsTrue(g != nullptr, name + " found");
+                if (g == nullptr)
+                    continue;
+                t.Equals(g->codepoint, s.codepoint, name + " codepoint (the low 16 bits)");
+                t.Equals(g->x, s.x, name + " x");
+                t.Equals(g->y, s.y, name + " y (from v1, the top of the atlas is v = 1)");
+                t.Equals(g->width, s.width, name + " width");
+                t.Equals(g->height, s.height, name + " height");
+                t.Equals(g->advance, s.advance, name + " advance");
+                t.Equals(g->offsetX, static_cast<int>(s.offsetX), name + " x offset");
+            }
+            t.IsTrue(font.glyph(0x42u) == nullptr, "no B in the sample");
+            // The rows the digits and capitals cover (A: 8 high, 5: 9 high; N with tilde is not one of them).
+            t.Equals(font.inkTop, kClearTopRows, "ink of the digits and capitals: from the first row with colour");
+            t.Equals(font.inkBottom, 8, "to the last one (the 5, 9 rows high)");
+        });
+
+        tc.Run("the atlas pixels: PSMT4 out of the CT32 upload, through the palette", [](TestCase &t)
+        {
+            ps2x::GameFont font;
+            t.IsTrue(decode(sampleFont(), font), "decodes");
+            if (font.rgba.size() != static_cast<size_t>(kAtlasWidth * kAtlasHeight * 4))
+                return;
+            int wrong = 0;
+            for (int y = 0; y < kAtlasHeight; ++y)
+                for (int x = 0; x < kAtlasWidth; ++x)
+                {
+                    const uint32_t c = samplePalette(sampleIndex(x, y));
+                    const uint32_t alpha = c >> 24;
+                    const uint8_t expected[4] = {0xFF, 0xFF, 0xFF,
+                                                 static_cast<uint8_t>(alpha >= 0x80u ? 255u : alpha * 2u)};
+                    if (std::memcmp(&font.rgba[(y * kAtlasWidth + x) * 4], expected, 4) != 0)
+                        ++wrong;
+                }
+            t.Equals(wrong, 0, "every pixel: white, PS2 alpha doubled (0x80 = 255)");
+            t.Equals(static_cast<int>(font.rgba[(0 * kAtlasWidth + 0) * 4 + 3]), 0, "outside the glyphs: clear");
+        });
+
+        tc.Run("bytes after the palette do not matter", [](TestCase &t)
+        {
+            std::vector<uint8_t> bytes = sampleFont();
+            bytes.insert(bytes.end(), 0x60, 0u);
+            ps2x::GameFont font;
+            t.IsTrue(decode(bytes, font), "decodes");
+            t.Equals(font.glyphs.size(), sampleGlyphs().size(), "all the glyphs");
+        });
+
+        tc.Run("a cut or damaged file is refused and the font is left as it was", [](TestCase &t)
+        {
+            const std::vector<uint8_t> whole = sampleFont();
+            int accepted = 0;
+            for (size_t size = 0; size < whole.size(); ++size)
+            {
+                ps2x::GameFont font;
+                font.lineHeight = 77;
+                if (ps2x::decodeGameFont(whole.data(), size, font) || font.lineHeight != 77 || !font.glyphs.empty())
+                    ++accepted;
+            }
+            t.Equals(accepted, 0, "every cut of the file refused, font untouched");
+
+            std::vector<uint8_t> huge = whole;
+            huge[8] = huge[9] = huge[10] = 0xFF; // count 0xFFFFFF glyphs
+            ps2x::GameFont font;
+            t.IsFalse(decode(huge, font), "a glyph count past the end");
+
+            std::vector<uint8_t> badPicture = whole;
+            const size_t image = whole.size() - (16u * 6u + 64u) - (16u * 6u + 8192u) + 16u * 5u;
+            badPicture[image] = 0x03; // IMAGE tag: 3 qwords instead of the 512 of a 64 x 32 CT32 picture
+            badPicture[image + 1] = 0x80;
+            t.IsFalse(decode(badPicture, font), "a picture of the wrong size");
+
+            t.IsFalse(ps2x::decodeGameFont(nullptr, 0u, font), "nothing");
+            const std::vector<uint8_t> noise(4096u, 0xA5u);
+            t.IsFalse(decode(noise, font), "noise");
+        });
+
+        tc.Run("the font files the game read: by name, with a version that changes with the bytes", [](TestCase &t)
+        {
+            std::vector<uint8_t> bytes;
+            uint32_t version = 99u;
+            t.IsFalse(ps2x::gameFontFile("Fonts/test-none.bft", bytes, version), "not read yet");
+            t.Equals(version, 99u, "version untouched");
+
+            t.IsTrue(ps2x::storeGameFontFile("Fonts/test-a.bft", {1u, 2u, 3u}), "new: stored");
+            t.IsTrue(ps2x::gameFontFile("Fonts/test-a.bft", bytes, version), "stored");
+            t.IsTrue(bytes == std::vector<uint8_t>{1u, 2u, 3u}, "its bytes");
+            t.Equals(version, 1u, "first version");
+
+            t.IsFalse(ps2x::storeGameFontFile("Fonts/test-a.bft", {1u, 2u, 3u}), "the same bytes: no change");
+            t.IsTrue(ps2x::gameFontFile("Fonts/test-a.bft", bytes, version), "read again by the game");
+            t.Equals(version, 1u, "the same bytes: the same version");
+
+            t.IsTrue(ps2x::storeGameFontFile("Fonts/test-a.bft", {4u}), "other bytes: a change");
+            t.IsTrue(ps2x::gameFontFile("Fonts/test-a.bft", bytes, version), "changed");
+            t.IsTrue(bytes == std::vector<uint8_t>{4u}, "the new bytes");
+            t.Equals(version, 2u, "a new version");
+            t.IsFalse(ps2x::gameFontFile("Fonts/test-b.bft", bytes, version), "another name is apart");
+        });
+
+        tc.Run("which game letter for a text size, and the fallback", [](TestCase &t)
+        {
+            const std::vector<int> heights = {15, 20, 25}; // Small, Medium, Large
+            t.Equals(ps2x::nearestGameFont(heights, 18.0f), 1, "18 px: Medium");
+            t.Equals(ps2x::nearestGameFont(heights, 17.5f), 1, "a tie: the larger");
+            t.Equals(ps2x::nearestGameFont(heights, 12.0f), 0, "small text: Small");
+            t.Equals(ps2x::nearestGameFont(heights, 54.0f), 2, "large text: Large");
+            t.Equals(ps2x::nearestGameFont({}, 18.0f), -1, "none read yet");
+
+            using K = ps2x::HostFontKind;
+            // hostFontKind(race on screen, race HUD letter read, menu letter read, built-in letter loaded)
+            t.IsTrue(ps2x::hostFontKind(true, true, true, true) == K::RaceHud, "in a race: the race HUD's letter");
+            t.IsTrue(ps2x::hostFontKind(false, true, true, true) == K::Menu, "in the menus: the menus' letter");
+            t.IsTrue(ps2x::hostFontKind(true, false, true, true) == K::Menu,
+                     "in a race before the HUD's letter is read: the menus' (still the game's)");
+            t.IsTrue(ps2x::hostFontKind(false, true, false, true) == K::RaceHud,
+                     "in the menus without the menus' letter: the HUD's (still the game's)");
+            t.IsTrue(ps2x::hostFontKind(true, false, false, true) == K::BuiltIn,
+                     "before the game reads any (or if none decodes): the built-in one");
+            t.IsTrue(ps2x::hostFontKind(false, false, false, true) == K::BuiltIn, "the same in the menus");
+            t.IsTrue(ps2x::hostFontKind(true, false, false, false) == K::Default, "else raylib's");
+            t.IsTrue(ps2x::hostFontKind(false, false, false, false) == K::Default, "else raylib's (menus)");
+        });
+
+        tc.Run("a race is on screen while its cameras draw", [](TestCase &t)
+        {
+            t.IsFalse(ps2x::raceCameraRecent(-1.0, 10.0), "no race camera yet");
+            t.IsTrue(ps2x::raceCameraRecent(10.0, 10.0), "a camera this frame");
+            t.IsTrue(ps2x::raceCameraRecent(10.0, 10.0 + ps2x::kRaceCameraWindow), "within the window");
+            t.IsFalse(ps2x::raceCameraRecent(10.0, 10.01 + ps2x::kRaceCameraWindow), "after it: back in the menus");
+            t.IsTrue(ps2x::kRaceCameraWindow >= 0.1 && ps2x::kRaceCameraWindow <= 1.0,
+                     "a short window (a few frames at 25-60 fps)");
+            ps2x::noteRaceCameraFrame();
+            t.IsTrue(ps2x::raceOnScreen(), "a camera noted now: a race on screen");
+        });
+
+        tc.Run("the game's letters at the game picture's scale", [](TestCase &t)
+        {
+            t.Equals(ps2x::gameFontPixelSize(16, ps2x::kGameFrameHeight), 16.0f, "the game's own frame: its size");
+            t.Equals(ps2x::gameFontPixelSize(16, 720), 22.5f, "a 720 row window: 720 / 512 times");
+            t.Equals(ps2x::gameFontPixelSize(16, 1440), 45.0f, "twice the window, twice the letter");
+            t.Equals(ps2x::gameFontPixelSize(0, 720), 0.0f, "no letter");
+
+            const ps2x::GamePictureScale four3 = ps2x::gamePictureScale(960.0f, 720.0f, 720);
+            t.Equals(four3.x, 1.875f, "4:3 in 960 x 720: 960 / 512 across");
+            t.Equals(four3.y, 1.40625f, "and 720 / 512 down");
+            const ps2x::GamePictureScale wide = ps2x::gamePictureScale(1280.0f, 720.0f, 720);
+            t.Equals(wide.x, 2.5f, "16:9: wider across");
+            t.Equals(wide.y, 1.40625f, "the same down");
+            const ps2x::GamePictureScale none = ps2x::gamePictureScale(0.0f, 0.0f, 720);
+            t.Equals(none.x, 1.875f, "no picture yet: 4:3 as high as the window");
+            t.Equals(none.y, 1.40625f, "no picture yet: the window's height");
+            ps2x::noteGamePicture(1280.0f, 720.0f);
+            t.Equals(ps2x::currentGamePictureScale(1080).x, 2.5f, "the picture noted, not the window");
+        });
+
+        tc.Run("the FPS counter: only the game's frames per second, as 50 FPS", [](TestCase &t)
+        {
+            t.Equals(ps2x::gameFpsText(50.0), std::string("50 FPS"), "50");
+            t.Equals(ps2x::gameFpsText(49.6), std::string("50 FPS"), "rounded");
+            t.Equals(ps2x::gameFpsText(59.94), std::string("60 FPS"), "NTSC");
+            t.Equals(ps2x::gameFpsText(30.4), std::string("30 FPS"), "rounded down");
+            t.Equals(ps2x::gameFpsText(0.0), std::string("0 FPS"), "stopped");
+            t.Equals(ps2x::gameFpsText(-3.0), std::string("0 FPS"), "never negative");
+            t.Equals(ps2x::gameFpsText(std::numeric_limits<double>::quiet_NaN()), std::string("0 FPS"), "not a number");
+            t.Equals(ps2x::gameFpsText(1e9), std::string("999 FPS"), "three digits at most");
+            t.Equals(ps2x::gameFpsValue(49.6), std::string("50"), "the number apart");
+            t.Equals(std::string(ps2x::kGameFpsLabel), std::string("FPS"), "and the label");
+        });
+
+        tc.Run("the FPS counter's boxes: the number, then FPS, top right, above the game's HUD", [](TestCase &t)
+        {
+            const ps2x::HostTextMeasure measure = [](const std::string &text, float size)
+            { return static_cast<float>(text.size()) * size * 0.6f; };
+            for (int height : {240, 480, 720, 1080, 2160})
+            {
+                const int width = height * 4 / 3;
+                const ps2x::OverlayLayout band = ps2x::fpsOverlayLayout(height);
+                const ps2x::HostFpsCounterLayout c = ps2x::hostFpsCounterLayout("50", "FPS", width, height, measure);
+                const std::string at = " (" + std::to_string(height) + " rows)";
+                t.Equals(c.fontSize, static_cast<float>(band.fontSize), "the counter's text size" + at);
+                t.Equals(c.label.y, static_cast<float>(band.margin), "at the top" + at);
+                t.Equals(c.label.height, static_cast<float>(band.height), "the band's height" + at);
+                t.Equals(c.value.y, c.label.y, "both boxes on one line" + at);
+                t.Equals(c.value.height, c.label.height, "both boxes as high" + at);
+                t.Equals(c.label.x + c.label.width, static_cast<float>(width - band.margin), "on the right" + at);
+                t.Equals(c.value.x + c.value.width, c.label.x, "the number just left of FPS" + at);
+                t.IsTrue(c.value.width >= measure("50", c.fontSize) + 2.0f * c.padding, "the number fits" + at);
+                t.IsTrue(c.label.width >= measure("FPS", c.fontSize) + 2.0f * c.padding, "FPS fits" + at);
+                t.IsTrue(c.value.x >= 0.0f, "inside the window" + at);
+                if (height >= 480) // fpsOverlayLayout: a 10 pixel letter at least, so 4 % from 480 rows up
+                    t.IsTrue(c.label.y + c.label.height <= height * 4 / 100 + 1, "above the game's HUD (4 %)" + at);
+                t.IsTrue(c.edge >= 1.0f && c.edge < c.label.height / 2.0f, "a thin edge under the boxes" + at);
+                t.Equals(c.textY, std::round(c.label.y + c.padding - c.edge / 2.0f), "text at the padding" + at);
+            }
+        });
+
+        tc.Run("the FPS counter in a race: the tower's letter size, its ink centred in the boxes", [](TestCase &t)
+        {
+            const ps2x::HostTextMeasure measure = [](const std::string &text, float size)
+            { return static_cast<float>(text.size()) * size * 0.45f; };
+            // fruitigerMedium: a 16 row line, capitals from row 4 to row 12 (9 rows), at the scale of a 720 row window.
+            const float size = ps2x::gameFontPixelSize(16, 720), scale = size / 16.0f;
+            const ps2x::HostTextInk ink{size, 4.0f * scale, 13.0f * scale};
+            const ps2x::OverlayLayout band = ps2x::fpsOverlayLayout(720);
+            const ps2x::HostFpsCounterLayout c = ps2x::hostFpsCounterLayout("50", "FPS", 960, 720, measure, &ink);
+            t.Equals(c.fontSize, size, "the tower's letter size");
+            t.Equals(c.label.height, static_cast<float>(band.height), "the band's height");
+            t.Equals(c.label.x + c.label.width, static_cast<float>(960 - band.margin), "on the right");
+            t.IsTrue(c.value.width >= measure("50", size) + 2.0f * c.padding, "the number fits at that size");
+            const float inkTop = c.textY + ink.top, inkBottom = c.textY + ink.bottom;
+            const float boxBottom = c.label.y + c.label.height - c.edge;
+            t.IsTrue(inkTop >= c.label.y && inkBottom <= boxBottom, "the ink inside the boxes, above the edge");
+            t.IsTrue(std::fabs((inkTop - c.label.y) - (boxBottom - inkBottom)) <= 1.0f, "centred (to a pixel)");
+            t.Equals(c.textY, std::round(c.textY), "on a whole pixel");
+
+            const ps2x::HostTextInk tall{60.0f, 10.0f, 50.0f}; // ink 40 rows high: more than the box
+            const ps2x::HostFpsCounterLayout s = ps2x::hostFpsCounterLayout("50", "FPS", 960, 720, measure, &tall);
+            const float shrink = s.fontSize / tall.fontSize;
+            t.IsTrue(s.fontSize < tall.fontSize, "too tall for the band: smaller");
+            t.IsTrue(s.textY + tall.top * shrink >= s.label.y - 0.5f &&
+                         s.textY + tall.bottom * shrink <= s.label.y + s.label.height - s.edge + 0.5f,
+                     "and then its ink fits");
+        });
+    });
+}
