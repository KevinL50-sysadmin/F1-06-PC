+    std::string resumen(const Partida &partida)
+    {
+        const double media =
+            partida.segundos > 0.0 ? static_cast<double>(partida.fotogramas) / partida.segundos : 0.0;
+        char texto[192];
+        int n = std::snprintf(texto, sizeof(texto), "estado=%s", partida.enCarrera ? "carrera" : "menu");
+        if (partida.circuito >= 0)
+            n += std::snprintf(texto + n, sizeof(texto) - n, " circuito=%d", partida.circuito);
+        n += std::snprintf(texto + n, sizeof(texto) - n, " duracion=%.0fs fotogramas=%llu fps_media=%.1f",
+                           std::floor(partida.segundos + 0.5), static_cast<unsigned long long>(partida.fotogramas),
+                           media);
+        if (partida.fpsMinimo >= 0.0)
+            std::snprintf(texto + n, sizeof(texto) - n, " fps_min_10s=%.1f", partida.fpsMinimo);
+        return texto;
+    }
+
+    void registrarPartida(FuentePartida fuente)
+    {
+        g_fuente.store(fuente);
+    }
+
     void escribir(int codigo, const char *motivo)
