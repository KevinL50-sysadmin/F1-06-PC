--- a/ps2xRuntime/include/ps2_salida.h
+++ b/ps2xRuntime/include/ps2_salida.h
@@ -1,5 +1,8 @@
 #pragma once
 
+#include <cstdint>
+#include <string>
+
 // Salida del proceso (odd/tasks/fallos-con-log.md T2). RecompLauncher solo adjunta el .log mas reciente a un informe
 // de fallo cuando el juego termina con un codigo distinto de 0, asi que un fallo anota aqui su codigo y su motivo, y la
 // salida (main.cpp, o el plazo de cierre de ps2_runtime.cpp) termina con el y escribe una ultima linea en el registro:
@@ -20,10 +23,29 @@ namespace ps2x::salida
     int codigo();         // 0 si no se ha anotado ningun fallo
     const char *motivo(); // "normal" si no se ha anotado ningun fallo
 
-    // Escribe "[salida] motivo=<motivo> codigo=<codigo>" en std::cout y vacia std::cout y std::cerr (std::_Exit no
-    // vacia nada).
+    // Donde estaba el jugador y como fue la partida (T3d): lo da el juego (f1_overrides.cpp) al salir.
+    struct Partida
+    {
+        bool enCarrera = false;   // si no, menu (front-end)
+        int circuito = -1;        // indice del ultimo circuito elegido; -1 = desconocido (no se escribe)
+        double segundos = 0.0;    // desde el arranque
+        uint64_t fotogramas = 0u; // fotogramas que el juego termino
+        double fpsMinimo = -1.0;  // peor ventana de 10 s con la carrera en pantalla; < 0 = ninguna (no se escribe)
+    };
+
+    // "estado=<carrera|menu> [circuito=<n> ]duracion=<s>s fotogramas=<n> fps_media=<x.x>[ fps_min_10s=<x.x>]"
+    std::string resumen(const Partida &partida);
+
+    // Fuente de la partida para escribir(). Se llama al salir, tambien con el hilo del juego colgado: no debe tomar
+    // cerrojos ni tocar nada que ese hilo pueda tener a medias (solo atomicos). nullptr la quita.
+    using FuentePartida = Partida (*)();
+    void registrarPartida(FuentePartida fuente);
+
+    // Con una fuente registrada, escribe primero "[salida] partida: <resumen>"; despues, siempre,
+    // "[salida] motivo=<motivo> codigo=<codigo>" en std::cout, y vacia std::cout y std::cerr (std::_Exit no vacia
+    // nada).
     void escribir(int codigo, const char *motivo);
 
-    // Solo para las pruebas: vuelve al estado sin fallo.
+    // Solo para las pruebas: vuelve al estado sin fallo y sin fuente de la partida.
     void reiniciarParaPruebas();
 }
