+    bool writeTextFileAtomically(const std::filesystem::path &file, std::string_view text, std::string &error)
+    {
+        std::error_code ignored;
+        if (file.has_parent_path())
+            std::filesystem::create_directories(file.parent_path(), ignored);
+        std::filesystem::path temporary = file;
+        temporary += ".tmp";
+        {
+            std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+            if (out)
+            {
+                out.write(text.data(), static_cast<std::streamsize>(text.size()));
+                out.flush();
+            }
+            if (!out)
+            {
+                error = "no se pudo escribir " + pathForLog(temporary);
+                out.close();
+                std::filesystem::remove(temporary, ignored);
+                return false;
+            }
+        }
+        std::error_code renameError;
+        std::filesystem::rename(temporary, file, renameError);
+        if (renameError)
+        {
+            error = "no se pudo sustituir " + pathForLog(file) + ": " + renameError.message();
+            std::filesystem::remove(temporary, ignored);
+            return false;
+        }
+        error.clear();
+        return true;
