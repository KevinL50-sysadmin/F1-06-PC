@@ -0,0 +1,321 @@
+#include "MiniTest.h"
+#include "ps2_options.h"
+#include "ps2_options_menu.h"
+#include "ps2_user_paths.h"
+
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <map>
+#include <sstream>
+#include <string>
+
+// Phase 3 (T3): the in-game options menu. Its pure parts: rewriting opciones.ini, the menu's values and the variables
+// that fix some of them, the pad combo that opens it, the guest's input while it is open and the debug panel's mode.
+namespace
+{
+    namespace fs = std::filesystem;
+    using Environment = std::map<std::string, std::string>;
+
+    struct TempDir
+    {
+        fs::path path;
+
+        TempDir()
+        {
+            const auto stamp = std::chrono::steady_clock::now().time_since_epoch().count();
+            path = fs::temp_directory_path() / ("ps2x-options-menu-" + std::to_string(stamp));
+            fs::create_directories(path);
+        }
+
+        ~TempDir()
+        {
+            std::error_code error;
+            fs::remove_all(path, error);
+        }
+    };
+
+    std::function<const char *(const char *)> environmentOf(const Environment &environment)
+    {
+        return [&environment](const char *name) -> const char *
+        {
+            const auto found = environment.find(name);
+            return found == environment.end() ? nullptr : found->second.c_str();
+        };
+    }
+
+    std::string readText(const fs::path &path)
+    {
+        std::ifstream in(path, std::ios::binary);
+        std::stringstream text;
+        text << in.rdbuf();
+        return text.str();
+    }
+
+    void writeText(const fs::path &path, const std::string &text)
+    {
+        std::ofstream out(path, std::ios::binary);
+        out << text;
+    }
+
+    // The value of key in an opciones.ini text, as the game reads it.
+    std::string fileValue(const std::string &text, const char *key, bool development = false)
+    {
+        return ps2x::parseOptions(text, "opciones.ini", development).values.at(key);
+    }
+
+    bool contains(const std::string &text, const std::string &part)
+    {
+        return text.find(part) != std::string::npos;
+    }
+}
+
+void register_ps2_options_menu_tests()
+{
+    MiniTest::Case("OptionsMenu", [](TestCase &tc)
+    {
+        tc.Run("rewriteOptionsText replaces the values and keeps the template's comments", [](TestCase &t)
+        {
+            std::map<std::string, std::string> values = ps2x::parseOptions("").values;
+            values["filtro"] = "crt";
+            values["supersampling"] = "1";
+            values["alta_resolucion"] = "0";
+            const std::string text = ps2x::rewriteOptionsText("", values, false);
+            t.IsTrue(contains(text, "filtro = crt\n"), "filtro written");
+            t.IsTrue(contains(text, "supersampling = 1\n"), "supersampling written");
+            t.IsTrue(!contains(text, "filtro = fsr"), "the old value is gone");
+            t.Equals(fileValue(text, "filtro"), std::string("crt"), "the game reads crt");
+            t.Equals(fileValue(text, "volumen"), std::string("100"), "the other options keep their values");
+            // Every comment line of the template is still there, in order.
+            const std::string defaults = ps2x::defaultOptionsText(false);
+            std::istringstream lines(defaults);
+            std::string line;
+            size_t position = 0u;
+            bool inOrder = true;
+            while (std::getline(lines, line))
+            {
+                if (line.empty() || line[0] != '#')
+                    continue;
+                const size_t found = text.find(line + "\n", position);
+                inOrder = inOrder && found != std::string::npos;
+                if (found != std::string::npos)
+                    position = found + line.size();
+            }
+            t.IsTrue(inOrder, "the template's comments are kept, in order");
+            t.Equals(ps2x::rewriteOptionsText("", ps2x::parseOptions("").values, false), defaults,
+                     "the default values give the default file");
+        });
+
+        tc.Run("rewriteOptionsText keeps the keys the game does not know, at the end", [](TestCase &t)
+        {
+            const std::string existing =
+                "# my notes\r\nfiltro = nitido\r\nmi_opcion = 7   # mine\r\npantalla_completa = 1\r\nOtra=si\r\n";
+            const ps2x::OptionsFile parsed = ps2x::parseOptions(existing);
+            const std::string text = ps2x::rewriteOptionsText(existing, parsed.values, false);
+            t.IsTrue(contains(text, "filtro = nitido\n"), "the known value is written in its place");
+            const size_t mine = text.find("mi_opcion = 7   # mine\n");
+            const size_t other = text.find("Otra=si\n");
+            t.IsTrue(mine != std::string::npos && other != std::string::npos && mine < other,
+                     "unknown keys kept as written, in order");
+            t.IsTrue(mine > text.find("alta_resolucion = "), "after every known option");
+            t.IsTrue(!contains(text, "pantalla_completa"), "the old alias is replaced by pantalla");
+            t.Equals(fileValue(text, "pantalla"), std::string("sin_bordes"), "with the value it stood for");
+            t.IsTrue(!contains(text, "\r"), "the file is written with LF");
+            t.IsTrue(!contains(text, "# my notes"), "comments outside the template are not kept");
+            t.Equals(ps2x::rewriteOptionsText(text, ps2x::parseOptions(text).values, false), text,
+                     "rewriting the rewritten file changes nothing");
+        });
+
+        tc.Run("writeTextFileAtomically replaces the file and leaves no temporary file", [](TestCase &t)
+        {
+            TempDir dir;
+            const fs::path file = dir.path / "config" / "opciones.ini";
+            std::string error;
+            t.IsTrue(ps2x::writeTextFileAtomically(file, "a = 1\n", error), "a new file in a new folder");
+            t.Equals(readText(file), std::string("a = 1\n"), "its text");
+            t.IsTrue(ps2x::writeTextFileAtomically(file, "b = 2\n", error), "over the existing file");
+            t.Equals(readText(file), std::string("b = 2\n"), "replaced");
+            size_t entries = 0u;
+            for (const auto &entry : fs::directory_iterator(file.parent_path()))
+            {
+                (void)entry;
+                ++entries;
+            }
+            t.Equals(entries, static_cast<size_t>(1u), "only opciones.ini in the folder");
+            t.IsTrue(error.empty(), "no error");
+
+            fs::create_directories(dir.path / "carpeta.ini");
+            t.IsFalse(ps2x::writeTextFileAtomically(dir.path / "carpeta.ini", "c = 3\n", error),
+                      "a folder in the way fails");
+            t.IsTrue(!error.empty(), "with the reason");
+            t.IsTrue(!fs::exists(dir.path / "carpeta.ini.tmp"), "and removes its temporary file");
+        });
+
+        tc.Run("the menu starts from the file and shows the forced options with their variable's value", [](TestCase &t)
+        {
+            const Environment environment = {{"PS2X_FILTRO", "0"}, {"PS2X_GS", "GPU"}};
+            const std::map<std::string, std::string> forced =
+                ps2x::optionsForcedByEnvironment(environmentOf(environment));
+            t.Equals(forced.size(), static_cast<size_t>(2u), "two forced options");
+            t.Equals(forced.at("filtro"), std::string("PS2X_FILTRO"), "filtro by PS2X_FILTRO");
+            t.Equals(forced.at("gs"), std::string("PS2X_GS"), "gs by PS2X_GS");
+            ps2x::OptionsMenuModel model = ps2x::makeOptionsMenuModel(
+                "filtro = crt\nvolumen = 40\ngs = cpu\n", false, forced, environmentOf(environment));
+            t.Equals(model.saved.at("filtro"), std::string("crt"), "saved: the file's value");
+            t.Equals(model.current.at("filtro"), std::string("cercano"), "current: PS2X_FILTRO=0 is cercano");
+            t.Equals(model.current.at("gs"), std::string("gpu"), "PS2X_GS=GPU is gpu");
+            t.Equals(model.current.at("volumen"), std::string("40"), "the file's volume");
+            t.IsFalse(ps2x::setMenuOption(model, "filtro", "bilineal"), "a forced option does not change");
+            t.Equals(model.current.at("filtro"), std::string("cercano"), "still cercano");
+            t.IsFalse(ps2x::menuHasChanges(model), "the forced values are not changes");
+            const std::map<std::string, std::string> saved = ps2x::menuValuesToSave(model);
+            t.Equals(saved.at("filtro"), std::string("crt"), "the file keeps its filtro");
+            t.Equals(saved.at("gs"), std::string("cpu"), "and its gs");
+
+            const std::map<std::string, std::string> alias =
+                ps2x::optionsForcedByEnvironment(environmentOf({{"PS2X_PANTALLA_COMPLETA", "1"}}));
+            t.Equals(alias.at("pantalla"), std::string("PS2X_PANTALLA_COMPLETA"), "the old variable fixes pantalla");
+            const Environment old = {{"PS2X_PANTALLA_COMPLETA", "1"}};
+            const ps2x::OptionsMenuModel oldModel =
+                ps2x::makeOptionsMenuModel("pantalla = ventana\n", false, alias, environmentOf(old));
+            t.Equals(oldModel.current.at("pantalla"), std::string("sin_bordes"), "PS2X_PANTALLA_COMPLETA=1 is sin_bordes");
+            t.IsTrue(ps2x::optionsForcedByEnvironment(environmentOf({})).empty(), "no variables, nothing forced");
+        });
+
+        tc.Run("setMenuOption validates the value and supersampling under 4 turns alta_resolucion off", [](TestCase &t)
+        {
+            ps2x::OptionsMenuModel model = ps2x::makeOptionsMenuModel("", false, {}, environmentOf({}));
+            t.Equals(model.current.at("supersampling"), std::string("4"), "the player's x4");
+            t.Equals(model.current.at("alta_resolucion"), std::string("1"), "and double resolution");
+            t.IsTrue(ps2x::highResolutionAvailable(model), "available with x4 and the GPU GS");
+            t.IsFalse(ps2x::setMenuOption(model, "filtro", "borroso"), "an invalid value is refused");
+            t.IsFalse(ps2x::setMenuOption(model, "no_existe", "1"), "an unknown key is refused");
+            t.IsFalse(ps2x::menuHasChanges(model), "nothing changed");
+            t.IsTrue(ps2x::setMenuOption(model, "supersampling", "2"), "x2");
+            t.Equals(model.current.at("alta_resolucion"), std::string("0"), "alta_resolucion goes off under x4");
+            t.IsFalse(ps2x::highResolutionAvailable(model), "and is not available");
+            t.IsTrue(ps2x::setMenuOption(model, "supersampling", "8"), "x8");
+            t.Equals(model.current.at("alta_resolucion"), std::string("0"), "it stays off when going back up");
+            t.IsTrue(ps2x::highResolutionAvailable(model), "available again");
+            t.IsTrue(ps2x::setMenuOption(model, "gs", "cpu"), "the CPU GS");
+            t.IsFalse(ps2x::highResolutionAvailable(model), "not available with gs = cpu");
+            t.IsTrue(ps2x::setMenuOption(model, "tamano_ventana", "1920x1080"), "a window size");
+            t.IsFalse(ps2x::setMenuOption(model, "tamano_ventana", "10x10"), "too small");
+            t.IsTrue(ps2x::setMenuOption(model, "volumen", "35"), "a volume");
+            t.IsFalse(ps2x::setMenuOption(model, "volumen", "101"), "over 100");
+            t.IsTrue(ps2x::menuHasChanges(model), "changes to save");
+        });
+
+        tc.Run("discard goes back to the saved values and defaults to the mode's defaults", [](TestCase &t)
+        {
+            const Environment environment = {{"PS2X_VOLUMEN", "10"}};
+            ps2x::OptionsMenuModel model = ps2x::makeOptionsMenuModel(
+                "filtro = nitido\nvsync = 0\n", false, ps2x::optionsForcedByEnvironment(environmentOf(environment)),
+                environmentOf(environment));
+            ps2x::setMenuOption(model, "filtro", "crt");
+            ps2x::resetMenuToDefaults(model);
+            t.Equals(model.current.at("filtro"), std::string("fsr"), "the player's default filter");
+            t.Equals(model.current.at("vsync"), std::string("1"), "the player's VSync");
+            t.Equals(model.current.at("volumen"), std::string("10"), "a forced option keeps its variable's value");
+            ps2x::discardMenuChanges(model);
+            t.Equals(model.current.at("filtro"), std::string("nitido"), "discard: the saved filter");
+            t.Equals(model.current.at("vsync"), std::string("0"), "and VSync");
+            t.IsFalse(ps2x::menuHasChanges(model), "no changes");
+
+            ps2x::OptionsMenuModel development = ps2x::makeOptionsMenuModel("", true, {}, environmentOf({}));
+            ps2x::setMenuOption(development, "gs", "gpu");
+            ps2x::resetMenuToDefaults(development);
+            t.Equals(development.current.at("gs"), std::string("cpu"), "development: its own defaults");
+        });
+
+        tc.Run("saveOptionsMenu writes the menu's values, keeps unknown keys and the forced options' file values", [](TestCase &t)
+        {
+            TempDir dir;
+            const fs::path file = dir.path / "opciones.ini";
+            writeText(file, "filtro = fsr\nvolumen = 70\nmi_opcion = 1\n");
+            const Environment environment = {{"PS2X_VOLUMEN", "5"}};
+            ps2x::OptionsMenuModel model = ps2x::makeOptionsMenuModel(
+                readText(file), false, ps2x::optionsForcedByEnvironment(environmentOf(environment)),
+                environmentOf(environment));
+            ps2x::setMenuOption(model, "filtro", "crt");
+            ps2x::setMenuOption(model, "supersampling", "1");
+            std::string error;
+            t.IsTrue(ps2x::saveOptionsMenu(model, file, error), "saved");
+            const std::string text = readText(file);
+            t.Equals(fileValue(text, "filtro"), std::string("crt"), "filtro = crt");
+            t.Equals(fileValue(text, "supersampling"), std::string("1"), "supersampling = 1");
+            t.Equals(fileValue(text, "alta_resolucion"), std::string("0"), "alta_resolucion = 0");
+            t.Equals(fileValue(text, "volumen"), std::string("70"), "the forced volume keeps the file's value");
+            t.IsTrue(contains(text, "mi_opcion = 1\n"), "the unknown key is kept");
+            t.IsTrue(contains(text, "# Filtro al ampliar la imagen"), "with the template's comments");
+            t.IsFalse(ps2x::menuHasChanges(model), "saved: no changes left");
+            t.Equals(model.saved.at("filtro"), std::string("crt"), "the saved values follow");
+            t.IsTrue(!fs::exists(dir.path / "opciones.ini.tmp"), "no temporary file left");
+        });
+
+        tc.Run("the pad combo fires once after being held for its time", [](TestCase &t)
+        {
+            ps2x::HoldComboDetector combo(0.5);
+            t.IsFalse(combo.update(false, 0.0), "not held");
+            t.IsFalse(combo.update(true, 1.0), "held: starts");
+            t.IsFalse(combo.update(true, 1.49), "not yet at 0.49 s");
+            t.IsTrue(combo.update(true, 1.5), "fires at 0.5 s");
+            t.IsFalse(combo.update(true, 3.0), "only once while held");
+            t.IsFalse(combo.update(false, 3.1), "released");
+            t.IsFalse(combo.update(true, 3.2), "held again: starts over");
+            t.IsFalse(combo.update(false, 3.5), "released before the time");
+            t.IsFalse(combo.update(true, 3.6), "held again");
+            t.IsFalse(combo.update(true, 4.0), "0.4 s");
+            t.IsTrue(combo.update(true, 4.1), "fires at 0.5 s from the new press");
+        });
+
+        tc.Run("maskMenuCombo hides L3 and R3 from the game only while both are held", [](TestCase &t)
+        {
+            constexpr uint16_t l3 = 1u << 1, r3 = 1u << 2, cross = 1u << 14;
+            t.Equals(static_cast<int>(ps2x::maskMenuCombo(l3 | r3 | cross)), static_cast<int>(cross), "both: hidden");
+            t.Equals(static_cast<int>(ps2x::maskMenuCombo(l3 | cross)), static_cast<int>(l3 | cross), "L3 alone stays");
+            t.Equals(static_cast<int>(ps2x::maskMenuCombo(r3)), static_cast<int>(r3), "R3 alone stays");
+        });
+
+        tc.Run("the guest gets no input while the menu is open, nor until everything is released", [](TestCase &t)
+        {
+            ps2x::GuestInputGate gate;
+            t.IsTrue(gate.passes(false, true), "menu closed: the input passes");
+            t.IsFalse(gate.passes(true, false), "menu open: neutral");
+            t.IsFalse(gate.passes(true, true), "menu open and held: neutral");
+            t.IsFalse(gate.passes(false, true), "closed with a button still held (the one that closed it): neutral");
+            t.IsTrue(gate.passes(false, false), "everything released: passes");
+            t.IsTrue(gate.passes(false, true), "a new press passes");
+        });
+
+        tc.Run("the debug panel only in development mode", [](TestCase &t)
+        {
+            t.IsTrue(ps2x::debugPanelAllowed(ps2x::UserPathsMode::Development), "development: F1 opens it");
+            t.IsFalse(ps2x::debugPanelAllowed(ps2x::UserPathsMode::Portable), "portable: no");
+            t.IsFalse(ps2x::debugPanelAllowed(ps2x::UserPathsMode::Installed), "installed: no");
+        });
+
+        tc.Run("Esc opens the menu for the player and never quits; development keeps Esc = quit", [](TestCase &t)
+        {
+            t.IsTrue(ps2x::escapeOpensMenu(ps2x::UserPathsMode::Portable), "portable: Esc opens the menu");
+            t.IsTrue(ps2x::escapeOpensMenu(ps2x::UserPathsMode::Installed), "installed: Esc opens the menu");
+            t.IsFalse(ps2x::escapeOpensMenu(ps2x::UserPathsMode::Development), "development: Esc quits as before");
+        });
+
+        tc.Run("parseMenuScript reads the steps of PS2X_MENU_GUION", [](TestCase &t)
+        {
+            const std::vector<ps2x::MenuScriptStep> steps =
+                ps2x::parseMenuScript(" 40:abrir, 41.5:filtro=crt,42:supersampling=1 ,43:guardar,44:cerrar,x:mal,45");
+            t.Equals(steps.size(), static_cast<size_t>(5u), "five valid steps");
+            if (steps.size() == 5u)
+            {
+                t.IsTrue(steps[0].seconds == 40.0 && steps[0].action == "abrir", "40 s: abrir");
+                t.IsTrue(steps[1].seconds == 41.5 && steps[1].action == "filtro=crt", "41.5 s: filtro=crt");
+                t.Equals(steps[2].action, std::string("supersampling=1"), "trimmed");
+                t.Equals(steps[4].action, std::string("cerrar"), "44 s: cerrar");
+            }
+            t.IsTrue(ps2x::parseMenuScript("").empty(), "empty: no steps");
+        });
+    });
+}
