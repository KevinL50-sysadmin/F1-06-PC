+++ b/ps2xRuntime/include/ps2_options_menu.h
@@ -0,0 +1,144 @@
+#pragma once
+
+#include "ps2_options.h"
+#include "ps2_user_paths.h"
+
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+class PS2Runtime;
+
+// Phase 3 (T3, F1 06): the in-game options menu (ImGui, in Spanish). F2, or L3+R3 held for half a second on the pad,
+// opens and closes it; Esc, circle or triangle close it. While it is open the game keeps running but its pad reads
+// neutral (keyboard, pad and wheel), until every button is released after closing. Its values come from opciones.ini
+// (ps2_options.h, OptionsMenuModel) and apply at once where the runtime can change them live; Guardar rewrites the file.
+namespace ps2x
+{
+    constexpr double kMenuComboSeconds = 0.5;
+    constexpr uint16_t kPadL3 = 1u << 1, kPadR3 = 1u << 2; // pressed-button bits, in the PS2's order
+
+    // Fires once when held has been true for holdSeconds without a break; then it needs a release to fire again.
+    class HoldComboDetector
+    {
+    public:
+        explicit HoldComboDetector(double holdSeconds = kMenuComboSeconds) : m_holdSeconds(holdSeconds) {}
+
+        bool update(bool held, double now)
+        {
+            if (!held)
+            {
+                m_since = -1.0;
+                m_fired = false;
+                return false;
+            }
+            if (m_since < 0.0)
+                m_since = now;
+            if (m_fired || now - m_since + 1e-9 < m_holdSeconds) // 1e-9: 4.1 - 3.6 is a hair under 0.5
+                return false;
+            m_fired = true;
+            return true;
+        }
+
+    private:
+        double m_holdSeconds;
+        double m_since = -1.0;
+        bool m_fired = false;
+    };
+
+    // pressed: pressed-button bits (1 = pressed). L3 and R3 held together are the menu's combo: the game sees neither.
+    inline uint16_t maskMenuCombo(uint16_t pressed)
+    {
+        constexpr uint16_t combo = kPadL3 | kPadR3;
+        return (pressed & combo) == combo ? static_cast<uint16_t>(pressed & ~combo) : pressed;
+    }
+
+    // The guest's pad: neutral while the menu is open and, after it closes, until no input is held (so the button that
+    // closed it does not reach the game).
+    class GuestInputGate
+    {
+    public:
+        bool passes(bool menuOpen, bool anyInputHeld)
+        {
+            if (menuOpen)
+            {
+                m_waitRelease = true;
+                return false;
+            }
+            if (m_waitRelease && anyInputHeld)
+                return false;
+            m_waitRelease = false;
+            return true;
+        }
+
+    private:
+        bool m_waitRelease = false;
+    };
+
+    // S4: the debug panel (F1) is for development runs only; the player's modes never draw it.
+    inline bool debugPanelAllowed(UserPathsMode mode)
+    {
+        return mode == UserPathsMode::Development;
+    }
+
+    // Esc in the player's modes opens and closes the menu, like a PC game, and never quits (one press too many would
+    // lose a race); the window's close button still quits. Development keeps raylib's Esc = quit.
+    inline bool escapeOpensMenu(UserPathsMode mode)
+    {
+        return mode != UserPathsMode::Development;
+    }
+
+    // PS2X_MENU_GUION (tests): "<seconds>:<action>,..." from the first frame of the window. Actions: abrir, cerrar,
+    // guardar, descartar, defecto, seccion=<pantalla|graficos|sonido>, tecla=<arriba|abajo|izquierda|derecha|aceptar>
+    // or <option>=<value> (as the menu sets it). PS2X_MENU_PETICION=<file>: the actions written in that file
+    // ("<action>,...") run when it appears, and the file is deleted (scripts that wait for a screen of the game).
+    struct MenuScriptStep
+    {
+        double seconds = 0.0;
+        std::string action;
+    };
+    std::vector<MenuScriptStep> parseMenuScript(std::string_view text);
+
+    // The pad side (ps2_pad.cpp). setOptionsMenuOpen/optionsMenuOpen: any thread. readMenuPad: the main thread; the pad
+    // and wheel inputs of controles.ini (not the keys) as PS2 buttons, whatever the controller (raylib, the DualSense
+    // over HID, the wheel's last state).
+    void setOptionsMenuOpen(bool open);
+    bool optionsMenuOpen();
+    struct MenuPadState
+    {
+        uint16_t pressed = 0u; // PS2 button bits, 1 = pressed
+        float leftX = 0.0f;    // the left stick, -1 to 1 (up = -1)
+        float leftY = 0.0f;
+    };
+    MenuPadState readMenuPad();
+}
+
+// The menu window (ps2_options_menu.cpp, built with the ImGui UI). It owns the ImGui context, shared with the debug
+// panel: beginFrame/endFrame wrap whatever is drawn in a frame.
+class PS2OptionsMenu
+{
+public:
+    PS2OptionsMenu();
+    ~PS2OptionsMenu();
+
+    // file: opciones.ini; mode: the user paths' mode (development defaults, the ImGui .ini file).
+    void configure(const std::filesystem::path &file, ps2x::UserPathsMode mode);
+    void initialize();
+    void shutdown();
+
+    // F2, the pad combo, Esc / circle / triangle and PS2X_MENU_GUION; every frame, before drawing.
+    void update(PS2Runtime &runtime);
+    bool isVisible() const;
+    // F1 was pressed in development mode (debugPanelAllowed): the debug panel shows or hides. Player modes: never.
+    bool takeDebugPanelToggle();
+    void beginFrame();
+    void draw(PS2Runtime &runtime);
+    void endFrame();
+
+private:
+    struct State;
+    std::unique_ptr<State> m_state;
+};
