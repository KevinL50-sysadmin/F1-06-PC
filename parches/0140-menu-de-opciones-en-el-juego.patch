+        model.saved = parseOptions(fileText, "opciones.ini", development).values;
+        model.current = model.saved;
+        model.forced = forced;
+        for (const auto &[key, variable] : forced)
+        {
+            const OptionSpec *spec = findSpec(key);
+            const char *setting = getEnvironment(variable.c_str());
+            if (spec == nullptr || setting == nullptr)
+                continue;
+            std::string value;
+            if (variable == spec->environment)
+                value = optionValueFromEnvironment(*spec, setting);
+            else
+                for (const OptionAlias &alias : optionAliases())
+                    if (variable == alias.environment)
+                        for (const OptionChoice &choice : alias.values)
+                            if (lower(trim(setting)) == choice.value)
+                                value = choice.environment;
+            if (!value.empty())
+                model.current[key] = value;
+        }
+        return model;
+    }
+
+    bool setMenuOption(OptionsMenuModel &model, const std::string &key, const std::string &value)
+    {
+        const OptionSpec *spec = findSpec(key);
+        const std::string text = lower(trim(value));
+        if (spec == nullptr || model.forced.count(key) != 0u || !validValue(*spec, text))
+            return false;
+        model.current[key] = text;
+        if (key == "supersampling" && std::atoi(text.c_str()) < 4 && model.forced.count("alta_resolucion") == 0u)
+            model.current["alta_resolucion"] = "0";
+        return true;
+    }
+
+    void discardMenuChanges(OptionsMenuModel &model)
+    {
+        for (const OptionSpec &spec : optionSpecs())
+            if (model.forced.count(spec.key) == 0u)
+                model.current[spec.key] = model.saved[spec.key];
+    }
+
+    void resetMenuToDefaults(OptionsMenuModel &model)
+    {
+        for (const OptionSpec &spec : optionSpecs())
+            if (model.forced.count(spec.key) == 0u)
+                model.current[spec.key] = optionDefault(spec, model.development);
+    }
+
+    std::map<std::string, std::string> menuValuesToSave(const OptionsMenuModel &model)
+    {
+        std::map<std::string, std::string> values = model.current;
+        for (const auto &[key, variable] : model.forced)
+        {
+            (void)variable;
+            const auto saved = model.saved.find(key);
+            if (saved != model.saved.end())
+                values[key] = saved->second;
+        }
+        return values;
+    }
+
+    bool menuHasChanges(const OptionsMenuModel &model)
+    {
+        return menuValuesToSave(model) != model.saved;
+    }
+
+    bool highResolutionAvailable(const OptionsMenuModel &model)
+    {
+        const auto value = [&model](const char *key)
+        {
+            const auto found = model.current.find(key);
+            return found == model.current.end() ? std::string() : found->second;
+        };
+        return std::atoi(value("supersampling").c_str()) >= 4 && value("gs") == "gpu";
+    }
+
+    bool saveOptionsMenu(OptionsMenuModel &model, const std::filesystem::path &file, std::string &error)
+    {
+        std::string existing;
+        if (std::ifstream in(file, std::ios::binary); in)
+        {
+            std::stringstream content;
+            content << in.rdbuf();
+            existing = content.str();
+        }
+        const std::map<std::string, std::string> values = menuValuesToSave(model);
+        if (!writeTextFileAtomically(file, rewriteOptionsText(existing, values, model.development), error))
+            return false;
+        model.saved = values;
+        return true;
+    }
+
+    std::vector<MenuScriptStep> parseMenuScript(std::string_view text)
+    {
+        std::vector<MenuScriptStep> steps;
+        size_t position = 0u;
+        while (position <= text.size())
+        {
+            const size_t comma = text.find(',', position);
+            const std::string item =
+                trim(text.substr(position, comma == std::string_view::npos ? std::string_view::npos : comma - position));
+            position = comma == std::string_view::npos ? text.size() + 1u : comma + 1u;
+            const size_t colon = item.find(':');
+            if (colon == std::string::npos)
+                continue;
+            const std::string seconds = trim(std::string_view(item).substr(0, colon));
+            const std::string action = trim(std::string_view(item).substr(colon + 1u));
+            char *end = nullptr;
+            const double value = std::strtod(seconds.c_str(), &end);
+            if (seconds.empty() || end == nullptr || *end != '\0' || action.empty())
+                continue;
+            steps.push_back({value, action});
+        }
+        return steps;
+    }
 }
