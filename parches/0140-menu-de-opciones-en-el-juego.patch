+
+void PS2OptionsMenu::draw(PS2Runtime &runtime)
+{
+    State &s = *m_state;
+    if (!s.initialized || !s.open)
+        return;
+
+    const float screenWidth = static_cast<float>(GetScreenWidth());
+    const float screenHeight = static_cast<float>(GetScreenHeight());
+    // Readable from 960x720 to 4K: the text follows the window's height.
+    const float fontSize = std::clamp(std::round(screenHeight / 32.0f), 14.0f, 96.0f);
+    if (fontSize != s.styleFontSize)
+    {
+        s.style = menuStyle(fontSize / 18.0f);
+        s.styleFontSize = fontSize;
+    }
+    const ImGuiStyle savedStyle = ImGui::GetStyle();
+    ImGui::GetStyle() = s.style;
+    ImGui::PushFont(s.font, fontSize);
+
+    ImGui::GetBackgroundDrawList()->AddRectFilled(ImVec2(0.0f, 0.0f), ImVec2(screenWidth, screenHeight),
+                                                  IM_COL32(0, 0, 0, 110));
+    // A fixed width; the height follows the contents (the same for every section).
+    const float width = std::min(screenWidth * 0.94f, fontSize * 32.0f);
+    ImGui::SetNextWindowPos(ImVec2(screenWidth * 0.5f, screenHeight * 0.5f), ImGuiCond_Always, ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowSizeConstraints(ImVec2(width, 0.0f), ImVec2(width, screenHeight * 0.96f));
+    if (s.focusFirstRow)
+        ImGui::SetNextWindowFocus();
+    const ImGuiWindowFlags flags = ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+                                   ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoSavedSettings |
+                                   ImGuiWindowFlags_AlwaysAutoResize;
+    if (ImGui::Begin("##opciones", nullptr, flags))
+    {
+        ps2x::OptionsMenuModel &model = s.model;
+        ImGui::PushFont(s.bold, fontSize * 1.3f);
+        ImGui::TextUnformatted("OPCIONES");
+        ImGui::PopFont();
+
+        // The sections.
+        const std::vector<Section> &list = sections();
+        const float tabWidth = (ImGui::GetContentRegionAvail().x - ImGui::GetStyle().ItemSpacing.x * (list.size() - 1)) /
+                               static_cast<float>(list.size());
+        for (size_t i = 0; i < list.size(); ++i)
+        {
+            if (i != 0u)
+                ImGui::SameLine();
+            const bool selected = static_cast<int>(i) == s.section;
+            ImGui::PushStyleColor(ImGuiCol_Button, selected ? ImGui::GetStyle().Colors[ImGuiCol_ButtonActive]
+                                                            : ImVec4(0.06f, 0.14f, 0.36f, 1.0f));
+            if (ImGui::Button(list[i].title, ImVec2(tabWidth, 0.0f)))
+                s.section = static_cast<int>(i);
+            ImGui::PopStyleColor();
+        }
+        ImGui::Separator();
+
+        // The options of the section: "<label>   < value >". Up and down choose; left and right (or the arrows with
+        // the mouse) change; activating (Space, Enter, cross, a click) takes the next value.
+        s.hint = nullptr;
+        s.hintNote.clear();
+        {
+            size_t mostRows = 0u;
+            for (const Section &section : list)
+                mostRows = std::max(mostRows, section.rows.size());
+            const float rowHeight = ImGui::GetFrameHeight() + ImGui::GetStyle().CellPadding.y * 2.0f;
+            const float tableTop = ImGui::GetCursorPosY();
+            if (ImGui::BeginTable("##tabla", 2, ImGuiTableFlags_RowBg))
+            {
+                ImGui::TableSetupColumn("##nombre", ImGuiTableColumnFlags_WidthStretch, 0.52f);
+                ImGui::TableSetupColumn("##valor", ImGuiTableColumnFlags_WidthStretch, 0.48f);
+                bool firstRow = true;
+                for (const Row &row : list[s.section].rows)
+                {
+                    const auto forced = model.forced.find(row.key);
+                    const bool isForced = forced != model.forced.end();
+                    const bool highResolution = std::string(row.key) == "alta_resolucion";
+                    const bool disabled = isForced || (highResolution && !ps2x::highResolutionAvailable(model));
+                    const std::string value = valueOf(model.current, row.key);
+
+                    // The value as shown, and its position among the choices.
+                    std::vector<Choice> choices = row.choices;
+                    std::string sizeText;
+                    if (std::string(row.key) == "tamano_ventana" &&
+                        std::none_of(choices.begin(), choices.end(), [&](const Choice &c) { return value == c.value; }))
+                    {
+                        sizeText = sizeLabel(value);
+                        choices.insert(choices.begin(), Choice{value.c_str(), sizeText.c_str()});
+                    }
+                    int index = 0;
+                    for (size_t i = 0; i < choices.size(); ++i)
+                        if (value == choices[i].value)
+                            index = static_cast<int>(i);
+                    const int volume = std::clamp(std::atoi(value.c_str()), 0, 100);
+
+                    ImGui::TableNextRow();
+                    ImGui::TableSetColumnIndex(0);
+                    ImGui::PushID(row.key);
+                    ImGui::BeginDisabled(disabled);
+                    if (firstRow && s.focusFirstRow)
+                    {
+                        ImGui::SetKeyboardFocusHere();
+                        s.focusFirstRow = false;
+                    }
+                    firstRow = false;
+                    const bool activated = ImGui::Selectable(row.label, false,
+                                                             ImGuiSelectableFlags_SpanAllColumns |
+                                                                 ImGuiSelectableFlags_AllowOverlap,
+                                                             ImVec2(0.0f, ImGui::GetFrameHeight()));
+                    const bool focused = ImGui::IsItemFocused();
+                    if (focused || ImGui::IsItemHovered(ImGuiHoveredFlags_AllowWhenDisabled))
+                    {
+                        s.hint = row.hint;
+                        if (isForced)
+                            s.hintNote = "Fijada por la variable de entorno " + forced->second +
+                                         ": el menú no la cambia.";
+                        else if (highResolution && disabled)
+                            s.hintNote = "Necesita supersampling x4 o más y gráficos por GPU.";
+                    }
+                    int step = activated ? (choices.empty() ? 1 : 2) : 0; // 2: the next value, wrapping
+                    if (focused && !disabled)
+                    {
+                        if (ImGui::IsKeyPressed(ImGuiKey_LeftArrow))
+                            step = -1;
+                        if (ImGui::IsKeyPressed(ImGuiKey_RightArrow))
+                            step = 1;
+                    }
+
+                    ImGui::TableSetColumnIndex(1);
+                    const float arrow = ImGui::GetFrameHeight();
+                    const float valueWidth = ImGui::GetContentRegionAvail().x - 2.0f * arrow -
+                                             2.0f * ImGui::GetStyle().ItemSpacing.x;
+                    ImGui::PushItemFlag(ImGuiItemFlags_NoNav, true);
+                    if (isForced)
+                    {
+                        ImGui::AlignTextToFramePadding();
+                        const std::string shown = choices.empty() ? std::to_string(volume) + " %"
+                                                                  : std::string(choices[index].label);
+                        ImGui::TextDisabled("%s (fijado por %s)", shown.c_str(), forced->second.c_str());
+                    }
+                    else
+                    {
+                        if (ImGui::ArrowButton("##menos", ImGuiDir_Left))
+                            step = -1;
+                        ImGui::SameLine();
+                        if (choices.empty())
+                        {
+                            const std::string text = std::to_string(volume) + " %";
+                            ImGui::ProgressBar(static_cast<float>(volume) / 100.0f, ImVec2(valueWidth, 0.0f),
+                                               text.c_str());
+                        }
+                        else
+                        {
+                            std::string text = choices[index].label;
+                            if (std::string(row.key) == "gs" && value != s.runningGs)
+                                text += "  (al reiniciar)";
+                            const ImVec2 textSize = ImGui::CalcTextSize(text.c_str());
+                            const ImVec2 start = ImGui::GetCursorScreenPos();
+                            ImGui::Dummy(ImVec2(valueWidth, ImGui::GetFrameHeight()));
+                            ImGui::GetWindowDrawList()->AddText(
+                                ImVec2(start.x + std::max(0.0f, (valueWidth - textSize.x) * 0.5f),
+                                       start.y + ImGui::GetStyle().FramePadding.y),
+                                ImGui::GetColorU32(ImGuiCol_Text), text.c_str());
+                        }
+                        ImGui::SameLine();
+                        if (ImGui::ArrowButton("##mas", ImGuiDir_Right))
+                            step = 1;
+                    }
+                    ImGui::PopItemFlag();
+                    ImGui::EndDisabled();
+                    ImGui::PopID();
+
+                    if (step != 0 && !disabled)
+                    {
+                        std::string next;
+                        if (choices.empty())
+                            next = std::to_string(std::clamp(volume + (step == 2 ? 5 : step * 5), 0, 100));
+                        else
+                        {
+                            const int count = static_cast<int>(choices.size());
+                            const int to = step == 2 ? (index + 1) % count : std::clamp(index + step, 0, count - 1);
+                            next = choices[to].value;
+                        }
+                        ps2x::setMenuOption(model, row.key, next);
+                    }
+                }
+                ImGui::EndTable();
+            }
+            // Room for the longest section, so the window keeps its height.
+            ImGui::SetCursorPosY(std::max(ImGui::GetCursorPosY(),
+                                          tableTop + rowHeight * static_cast<float>(mostRows) +
+                                              ImGui::GetStyle().ItemSpacing.y));
+            // Notes for the section.
+            ImGui::PushFont(nullptr, fontSize * 0.85f);
+            if (s.section == 1 && s.runningGs == "cpu")
+                ImGui::TextDisabled("Con el dibujo por CPU no se usan el supersampling ni la doble resolución.");
+            else if (s.section == 2 && !runtime.outputVolumeLive())
+                ImGui::TextDisabled("El volumen se aplica al reiniciar el juego.");
+            else
+                ImGui::TextUnformatted(" ");
+            ImGui::PopFont();
+        }
+
+        // The hint of the option under the cursor (room for three lines).
+        ImGui::Separator();
+        ImGui::PushFont(nullptr, fontSize * 0.85f);
+        const float hintTop = ImGui::GetCursorPosY();
+        ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.80f, 0.86f, 1.0f, 1.0f));
+        ImGui::PushTextWrapPos(0.0f);
+        ImGui::TextUnformatted(s.hint != nullptr ? s.hint : " ");
+        if (!s.hintNote.empty())
+            ImGui::TextColored(ImVec4(1.0f, 0.85f, 0.35f, 1.0f), "%s", s.hintNote.c_str());
+        ImGui::PopTextWrapPos();
+        ImGui::PopStyleColor();
+        ImGui::SetCursorPosY(std::max(ImGui::GetCursorPosY(), hintTop + ImGui::GetTextLineHeightWithSpacing() * 3.0f));
+        ImGui::PopFont();
+        ImGui::Separator();
+
+        // The buttons.
+        // Natural widths, the extra room shared out.
+        const char *const labels[] = {"Guardar", "Descartar", "Valores por defecto", "Cerrar"};
+        float textWidth = 0.0f;
+        for (const char *label : labels)
+            textWidth += ImGui::CalcTextSize(label).x;
+        const float extra = std::max(0.0f, (ImGui::GetContentRegionAvail().x - textWidth -
+                                            ImGui::GetStyle().ItemSpacing.x * 3.0f) / 4.0f);
+        bool pressed[4] = {};
+        for (int i = 0; i < 4; ++i)
+        {
+            if (i != 0)
+                ImGui::SameLine();
+            pressed[i] = ImGui::Button(labels[i], ImVec2(ImGui::CalcTextSize(labels[i]).x + extra, 0.0f));
+        }
+        if (pressed[0])
+            saveAndReport(model, s.file, s.status, s.statusError);
+        if (pressed[1])
+        {
+            ps2x::discardMenuChanges(model);
+            s.status = "Cambios descartados: vuelven los valores guardados.";
+            s.statusError = false;
+        }
+        if (pressed[2])
+        {
+            ps2x::resetMenuToDefaults(model);
+            s.status = "Valores por defecto (sin guardar todavía).";
+            s.statusError = false;
+        }
+        const bool close = pressed[3];
+
+        // Status and the file.
+        ImGui::PushFont(nullptr, fontSize * 0.8f);
+        if (!s.status.empty())
+            ImGui::TextColored(s.statusError ? ImVec4(1.0f, 0.45f, 0.45f, 1.0f) : ImVec4(0.55f, 1.0f, 0.6f, 1.0f), "%s",
+                               s.status.c_str());
+        else if (ps2x::menuHasChanges(model))
+            ImGui::TextColored(ImVec4(1.0f, 0.85f, 0.35f, 1.0f), "Hay cambios sin guardar (ya se ven en el juego).");
+        else
+            ImGui::TextUnformatted(" ");
+        ImGui::TextDisabled("F2 o L3+R3 (mantener): abrir y cerrar. Esc, círculo o triángulo: cerrar. L1/R1: sección.");
+        if (!model.forced.empty())
+            ImGui::TextDisabled("Las variables de entorno PS2X_* mandan sobre opciones.ini al arrancar.");
+        ImGui::TextDisabled("%s", ps2x::pathForLog(s.file).c_str());
+        ImGui::PopFont();
+
+        if (close)
+        {
+            s.open = false;
+            std::cout << "[menu] cerrado" << std::endl;
+        }
+    }
+    ImGui::End();
+
+    ImGui::PopFont();
+    ImGui::GetStyle() = savedStyle;
+    applyLive(s.model, s.applied, runtime);
+    ps2x::setOptionsMenuOpen(s.open);
+}
