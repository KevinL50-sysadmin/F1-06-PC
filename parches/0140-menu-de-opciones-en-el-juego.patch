+namespace
+{
+    // The values the game uses: those set live, a forced option's variable and the window mode and aspect F11 and F10
+    // may have changed.
+    void syncFromRuntime(ps2x::OptionsMenuModel &model, std::map<std::string, std::string> &applied, PS2Runtime &runtime)
+    {
+        const std::map<std::string, std::string> display = ps2x::displayOptionValues(runtime.displaySettings());
+        for (const char *key : {"pantalla", "aspecto"})
+        {
+            const std::string value =
+                std::string(key) == "pantalla" ? display.at("pantalla") : runtime.presentAspectOption();
+            applied[key] = value;
+            if (model.forced.count(key) == 0u)
+                model.current[key] = value;
+        }
+    }
+
+    // Applies what changed since the last time, where the runtime can do it live.
+    void applyLive(ps2x::OptionsMenuModel &model, std::map<std::string, std::string> &applied, PS2Runtime &runtime)
+    {
+        const auto changed = [&](const char *key) { return valueOf(model.current, key) != valueOf(applied, key); };
+        bool display = false;
+        for (const char *key : kDisplayKeys)
+            display = display || changed(key);
+        if (display)
+            runtime.applyDisplaySettings(ps2x::displaySettingsFromOptionValues(model.current));
+        if (changed("aspecto"))
+            runtime.setPresentAspect(valueOf(model.current, "aspecto"));
+        if (changed("supersampling") || changed("alta_resolucion"))
+            if (GSGpuBackend *gpu = ps2GsActiveGpuBackend())
+            {
+                GSGpuQuality quality = gpu->Quality();
+                quality.superSampling = static_cast<uint32_t>(std::atoi(valueOf(model.current, "supersampling").c_str()));
+                quality.highResolution = valueOf(model.current, "alta_resolucion") == "1" && quality.superSampling >= 4u;
+                gpu->SetQuality(quality);
+            }
+        if (changed("volumen"))
+            runtime.setOutputVolume(std::atoi(valueOf(model.current, "volumen").c_str()));
+        for (const auto &[key, value] : model.current)
+            if (key != "gs") // gs stays as the game started
+                applied[key] = value;
+    }
+
+    std::string readFile(const std::filesystem::path &file)
+    {
+        std::ifstream in(file, std::ios::binary);
+        std::stringstream text;
+        text << in.rdbuf();
+        return text.str();
+    }
+
+    // Guardar: the status line and one line in the log.
+    void saveAndReport(ps2x::OptionsMenuModel &model, const std::filesystem::path &file, std::string &status,
+                       bool &statusError)
+    {
+        std::string error;
+        statusError = !ps2x::saveOptionsMenu(model, file, error);
+        status = statusError ? "No se pudo guardar: " + error : std::string("Guardado en opciones.ini.");
+        if (statusError)
+            std::cerr << "[menu] no se pudo guardar: " << error << std::endl;
+        else
+            std::cout << "[menu] opciones guardadas en " << ps2x::pathForLog(file) << std::endl;
+    }
+}
+
+void PS2OptionsMenu::update(PS2Runtime &runtime)
+{
+    State &s = *m_state;
+    if (!s.initialized)
+        return;
+    const double now = GetTime();
+
+    const auto ensureModel = [&]()
+    {
+        if (s.modelReady)
+            return;
+        const ps2x::StartupOptions &startup = ps2x::startupOptions();
+        s.model = ps2x::makeOptionsMenuModel(readFile(s.file), s.mode == ps2x::UserPathsMode::Development,
+                                             startup.forced,
+                                             [](const char *name) { return static_cast<const char *>(std::getenv(name)); });
+        s.applied = s.model.current;
+        s.runningGs = ps2GsActiveGpuBackend() != nullptr ? "gpu" : "cpu";
+        s.applied["gs"] = s.runningGs;
+        s.modelReady = true;
+    };
+    const auto setOpen = [&](bool open)
+    {
+        if (open == s.open)
+            return;
+        s.open = open;
+        if (open)
+        {
+            ensureModel();
+            syncFromRuntime(s.model, s.applied, runtime);
+            s.focusFirstRow = true;
+            s.status.clear();
+            ImGui::GetIO().ClearInputKeys();
+            // Held buttons (the combo) must not act in the menu.
+            const ps2x::MenuPadState pad = ps2x::readMenuPad();
+            s.padPressed = pad.pressed;
+        }
+        std::cout << "[menu] " << (open ? "abierto" : "cerrado") << std::endl;
+    };
+
+    // The automated checks of the menu: PS2X_MENU_GUION (seconds from the first frame) and PS2X_MENU_PETICION (a file
+    // with steps "<action>,...", run when it appears and then deleted, like PS2X_CAPTURA_PETICION). tecla=<arriba|
+    // abajo|izquierda|derecha|aceptar> presses a key for ImGui, as the keyboard or the pad would.
+    const auto runAction = [&](const std::string &action)
+    {
+        bool done = true;
+        ensureModel();
+        if (action == "abrir")
+            setOpen(true);
+        else if (action == "cerrar")
+            setOpen(false);
+        else if (action == "guardar")
+            saveAndReport(s.model, s.file, s.status, s.statusError);
+        else if (action == "descartar")
+            ps2x::discardMenuChanges(s.model);
+        else if (action == "defecto")
+            ps2x::resetMenuToDefaults(s.model);
+        else if (action.rfind("seccion=", 0) == 0)
+        {
+            const std::string name = action.substr(8);
+            s.section = name == "graficos" ? 1 : name == "sonido" ? 2 : 0;
+        }
+        else if (action.rfind("tecla=", 0) == 0)
+        {
+            const std::string name = action.substr(6);
+            const ImGuiKey key = name == "arriba"      ? ImGuiKey_UpArrow
+                                 : name == "abajo"     ? ImGuiKey_DownArrow
+                                 : name == "izquierda" ? ImGuiKey_LeftArrow
+                                 : name == "derecha"   ? ImGuiKey_RightArrow
+                                 : name == "aceptar"   ? ImGuiKey_Space
+                                                       : ImGuiKey_None;
+            done = key != ImGuiKey_None && s.open;
+            if (done)
+            {
+                ImGui::GetIO().AddKeyEvent(key, true);
+                ImGui::GetIO().AddKeyEvent(key, false);
+            }
+        }
+        else if (const size_t equals = action.find('='); equals != std::string::npos)
+            done = ps2x::setMenuOption(s.model, action.substr(0, equals), action.substr(equals + 1u));
+        else
+            done = false;
+        applyLive(s.model, s.applied, runtime);
+        std::cout << "[menu] guion " << action << (done ? "" : " (no se pudo)") << std::endl;
+    };
+    if (!s.script.empty())
+    {
+        if (s.scriptStart < 0.0)
+            s.scriptStart = now;
+        while (s.scriptNext < s.script.size() && now - s.scriptStart >= s.script[s.scriptNext].seconds)
+            runAction(s.script[s.scriptNext++].action);
+    }
+    if (!s.request.empty() && ++s.requestPolls >= 10u)
+    {
+        s.requestPolls = 0u;
+        std::error_code error;
+        if (std::filesystem::exists(s.request, error))
+        {
+            std::stringstream items(readFile(s.request));
+            std::filesystem::remove(s.request, error);
+            std::string item;
+            while (std::getline(items, item, ','))
+            {
+                item.erase(0, item.find_first_not_of(" \t\r\n\xEF\xBB\xBF"));
+                item.erase(item.find_last_not_of(" \t\r\n") + 1u);
+                if (!item.empty())
+                    runAction(item);
+            }
+        }
+    }
+
+    // F1: the debug panel, in development mode only (S4).
+    if (ps2x::debugPanelAllowed(s.mode) && IsKeyPressed(KEY_F1))
+        s.debugToggle = true;
+
+    const ps2x::MenuPadState pad = ps2x::readMenuPad();
+    const uint16_t pressedNow = static_cast<uint16_t>(pad.pressed & ~s.padPressed);
+    s.padPressed = pad.pressed;
+    const bool comboFired = s.combo.update((pad.pressed & (ps2x::kPadL3 | ps2x::kPadR3)) == (ps2x::kPadL3 | ps2x::kPadR3), now);
+    const bool escapeToggles = ps2x::escapeOpensMenu(s.mode) && IsKeyPressed(KEY_ESCAPE);
+    if (IsKeyPressed(KEY_F2) || comboFired || escapeToggles)
+        setOpen(!s.open);
+    else if (s.open && (IsKeyPressed(KEY_ESCAPE) || (pressedNow & ((1u << 12) | (1u << 13))) != 0u)) // triangle, circle
+        setOpen(false);
+
+    if (s.open)
+    {
+        // The pad navigates as the arrow keys and Space (cross); L1 and R1 change the section.
+        ImGuiIO &io = ImGui::GetIO();
+        const bool direction[4] = {(pad.pressed & (1u << 4)) != 0u || pad.leftY < -0.5f,
+                                   (pad.pressed & (1u << 6)) != 0u || pad.leftY > 0.5f,
+                                   (pad.pressed & (1u << 7)) != 0u || pad.leftX < -0.5f,
+                                   (pad.pressed & (1u << 5)) != 0u || pad.leftX > 0.5f};
+        constexpr ImGuiKey kDirectionKeys[4] = {ImGuiKey_UpArrow, ImGuiKey_DownArrow, ImGuiKey_LeftArrow,
+                                                ImGuiKey_RightArrow};
+        for (int i = 0; i < 4; ++i)
+            if (direction[i] != s.padDirection[i])
+            {
+                io.AddKeyEvent(kDirectionKeys[i], direction[i]);
+                s.padDirection[i] = direction[i];
+            }
+        const bool activate = (pad.pressed & (1u << 14)) != 0u;
+        if (activate != s.padActivate)
+        {
+            io.AddKeyEvent(ImGuiKey_Space, activate);
+            s.padActivate = activate;
+        }
+        const int sectionCount = static_cast<int>(sections().size());
+        if ((pressedNow & (1u << 10)) != 0u)
+            s.section = (s.section + sectionCount - 1) % sectionCount;
+        if ((pressedNow & (1u << 11)) != 0u)
+            s.section = (s.section + 1) % sectionCount;
+    }
+    else
+    {
+        for (bool &direction : s.padDirection)
+            direction = false;
+        s.padActivate = false;
+    }
+
+    // Esc closes the menu, not the game, while it is open; in the player's modes Esc never quits (escapeOpensMenu).
+    const bool clearExitKey = s.open || ps2x::escapeOpensMenu(s.mode);
+    if (clearExitKey != s.exitKeyCleared)
+    {
+        SetExitKey(clearExitKey ? KEY_NULL : KEY_ESCAPE);
+        s.exitKeyCleared = clearExitKey;
+    }
+    ps2x::setOptionsMenuOpen(s.open);
+    if (s.modelReady)
+        applyLive(s.model, s.applied, runtime);
+}
