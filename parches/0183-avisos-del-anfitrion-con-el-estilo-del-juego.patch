diff --git a/ps2xRuntime/include/ps2_host_overlay.h b/ps2xRuntime/include/ps2_host_overlay.h
new file mode 100644
index 0000000..34ea7c4
--- /dev/null
+++ b/ps2xRuntime/include/ps2_host_overlay.h
@@ -0,0 +1,86 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Nativizacion T11 (option C of T8): the host's own notices over the game's window (the FPS counter, the 3 second line
+// at the bottom and the netplay notice) with one look close to the game's: Michroma (a free letter like the game's
+// Eurostile, SIL OFL 1.1, built into the .exe), upper case, the game's white and red on a dark translucent band and a
+// short fade. They are drawn over the window only: never in the F12 photo nor in PS2X_CAPTURA_PETICION's frame.
+namespace ps2x
+{
+    struct HostOverlayColor
+    {
+        uint8_t r = 0, g = 0, b = 0, a = 255;
+    };
+
+    // Sampled from the game's own menus (logs/explorar-nat-es-ajustes-08-DisplaySettings_1_4.png, 512x512): the white
+    // of the page title and the rows (60,32 and 300,215), the red of the selection arrow and the value bar (28,138 and
+    // 380,215) and the black of the bottom band (200,445), here a little translucent.
+    inline constexpr HostOverlayColor kHostOverlayText{0xFB, 0xFB, 0xFC, 0xFF};
+    inline constexpr HostOverlayColor kHostOverlayRed{0xFC, 0x01, 0x01, 0xFF};
+    inline constexpr HostOverlayColor kHostOverlayPanel{0x0E, 0x0E, 0x0E, 0xC8};
+    // The netplay notice keeps telling its state by colour, now on the band's stripe: guest connected, cannot host.
+    inline constexpr HostOverlayColor kHostOverlayGreen{0x3C, 0xC8, 0x3C, 0xFF};
+    inline constexpr HostOverlayColor kHostOverlayOrange{0xFF, 0x96, 0x00, 0xFF};
+
+    // The text in upper case as the game writes it: ASCII and the Latin-1 letters of UTF-8 (a-z, U+00E0-U+00FE but
+    // U+00F7: n with tilde -> N with tilde, u with diaeresis -> U with diaeresis); anything else, the inverted question
+    // and exclamation marks too, as it is. From keepFrom on the text stays as it is (the netplay
+    // password, where case matters).
+    std::string hostOverlayCaps(std::string_view utf8, size_t keepFrom = std::string_view::npos);
+
+    // Timed notices fade in and out instead of a hard cut: 0..1 at elapsed seconds of a duration seconds notice.
+    inline constexpr double kHostNoticeFadeIn = 0.15;
+    inline constexpr double kHostNoticeFadeOut = 0.4;
+    float hostNoticeAlpha(double elapsed, double duration);
+    // When a notice starts at now: a new one fades in; one that replaces a notice still on screen (the replay's
+    // position line, say) is shown at once, without fading in again. previousStart < 0: none before.
+    double hostNoticeStart(double now, double previousStart, double previousDuration);
+
+    enum class HostOverlayPlace
+    {
+        TopRight,     // the FPS counter: in the top band, above the game's HUD (fpsOverlayLayout)
+        TopLeft,      // the netplay notice: in the top band, under the FPS counter if they would meet
+        BottomCentre, // the 3 second line: between the menus' button hints, over the car in the race
+    };
+
+    struct HostOverlayBox
+    {
+        float x = 0.0f, y = 0.0f, width = 0.0f, height = 0.0f;
+        float fontSize = 10.0f;
+        float padding = 2.0f; // from the box to the text
+        float stripe = 2.0f;  // the red stripe on the box's left, as the game's selection arrow
+        std::vector<std::string> lines;
+    };
+
+    // Width in pixels of a text at a font size.
+    using HostTextMeasure = std::function<float(const std::string &text, float fontSize)>;
+
+    // Where a notice goes in a windowWidth x windowHeight window: one line at fpsOverlayLayout's size; if it does not
+    // fit the window it gets smaller (down to kHostOverlayShrink of that size, never below kHostOverlayMinFont) and then
+    // wraps at the spaces. avoid: a box already on screen (the FPS counter) the TopLeft one goes under if they would
+    // meet.
+    inline constexpr float kHostOverlayMinFont = 10.0f;
+    inline constexpr float kHostOverlayShrink = 0.75f;
+    HostOverlayBox hostOverlayBox(const std::string &text, HostOverlayPlace place, int windowWidth, int windowHeight,
+                                  const HostTextMeasure &measure, const HostOverlayBox *avoid = nullptr);
+
+    // A TrueType blob raylib (stb_truetype, which does not check bounds) can read: the 0x00010000 or "true" tag, its
+    // table directory inside the blob and the tables a TrueType letter needs. Otherwise the default font is used.
+    bool hostFontBlobUsable(const unsigned char *data, size_t size);
+    // The letter built into the .exe.
+    const unsigned char *hostOverlayFontData();
+    size_t hostOverlayFontSize();
+
+    // Drawing (raylib, main thread, between BeginDrawing and EndDrawing). The letter loads on first use; if it cannot,
+    // the default font. alpha: hostNoticeAlpha.
+    HostOverlayBox drawHostOverlay(const std::string &text, HostOverlayPlace place, float alpha = 1.0f,
+                                   HostOverlayColor stripe = kHostOverlayRed, size_t keepCaseFrom = std::string::npos);
+    // The FPS counter's box if it was drawn in the last 0.25 s (for the netplay notice to go under it).
+    bool recentHostOverlayBox(HostOverlayPlace place, HostOverlayBox &box);
+}
