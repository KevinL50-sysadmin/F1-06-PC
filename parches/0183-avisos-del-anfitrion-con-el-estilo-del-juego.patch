diff --git a/ps2xRuntime/src/lib/ps2_host_overlay.cpp b/ps2xRuntime/src/lib/ps2_host_overlay.cpp
new file mode 100644
index 0000000..2d55b17
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_host_overlay.cpp
@@ -0,0 +1,286 @@
+#include "ps2_host_overlay.h"
+#include "ps2_display.h"
+#include "fonts/michroma_regular_ttf.h"
+
+#include "raylib.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <iostream>
+#include <iterator>
+#include <vector>
+
+namespace ps2x
+{
+    std::string hostOverlayCaps(std::string_view utf8, size_t keepFrom)
+    {
+        const size_t end = std::min(keepFrom, utf8.size());
+        std::string out;
+        out.reserve(utf8.size());
+        for (size_t i = 0; i < end; ++i)
+        {
+            const unsigned char c = static_cast<unsigned char>(utf8[i]);
+            if (c >= 'a' && c <= 'z')
+            {
+                out += static_cast<char>(c - ('a' - 'A'));
+                continue;
+            }
+            out += static_cast<char>(c);
+            // U+00E0-U+00FE (C3 A0-BE) but U+00F7: the capital is 0x20 lower (C3 80-9E).
+            if (c == 0xC3u && i + 1 < end)
+            {
+                const unsigned char next = static_cast<unsigned char>(utf8[i + 1]);
+                out += static_cast<char>(next >= 0xA0u && next <= 0xBEu && next != 0xB7u ? next - 0x20u : next);
+                ++i;
+            }
+        }
+        out.append(utf8.substr(end));
+        return out;
+    }
+
+    float hostNoticeAlpha(double elapsed, double duration)
+    {
+        if (!(duration > 0.0) || elapsed < 0.0 || elapsed >= duration)
+            return 0.0f;
+        const double alpha = std::min(elapsed / kHostNoticeFadeIn, (duration - elapsed) / kHostNoticeFadeOut);
+        return static_cast<float>(std::clamp(alpha, 0.0, 1.0));
+    }
+
+    double hostNoticeStart(double now, double previousStart, double previousDuration)
+    {
+        const bool onScreen = previousStart >= 0.0 && now - previousStart < previousDuration;
+        return onScreen ? now - kHostNoticeFadeIn : now;
+    }
+
+    namespace
+    {
+        std::vector<std::string> words(const std::string &text)
+        {
+            std::vector<std::string> out;
+            size_t at = 0;
+            while (at < text.size())
+            {
+                const size_t start = text.find_first_not_of(' ', at);
+                if (start == std::string::npos)
+                    break;
+                const size_t stop = std::min(text.find(' ', start), text.size());
+                out.push_back(text.substr(start, stop - start));
+                at = stop;
+            }
+            return out;
+        }
+    }
+
+    HostOverlayBox hostOverlayBox(const std::string &text, HostOverlayPlace place, int windowWidth, int windowHeight,
+                                  const HostTextMeasure &measure, const HostOverlayBox *avoid)
+    {
+        const OverlayLayout band = fpsOverlayLayout(windowHeight);
+        HostOverlayBox box;
+        box.padding = static_cast<float>(band.padding);
+        box.stripe = std::max(2.0f, std::round(band.fontSize / 6.0f));
+        const float margin = static_cast<float>(band.margin);
+        const float room = std::max(1.0f, windowWidth - 2.0f * margin - box.stripe - 2.0f * box.padding);
+
+        // One line at the counter's size; smaller if it does not fit; then wrapped.
+        const float base = static_cast<float>(band.fontSize);
+        const float smallest = std::max(kHostOverlayMinFont, base * kHostOverlayShrink);
+        float size = base;
+        float width = measure(text, size);
+        if (width > room)
+        {
+            size = std::max(smallest, std::floor(base * room / width));
+            while (size > smallest && measure(text, size) > room)
+                size = std::max(smallest, size - 1.0f);
+        }
+        box.fontSize = size;
+        if (measure(text, size) <= room)
+            box.lines.push_back(text);
+        else
+        {
+            std::string line;
+            for (const std::string &word : words(text))
+            {
+                const std::string longer = line.empty() ? word : line + " " + word;
+                if (!line.empty() && measure(longer, size) > room)
+                {
+                    box.lines.push_back(line);
+                    line = word;
+                }
+                else
+                    line = longer;
+            }
+            if (!line.empty() || box.lines.empty())
+                box.lines.push_back(line);
+        }
+        width = 0.0f;
+        for (const std::string &line : box.lines)
+            width = std::max(width, measure(line, size));
+        box.width = std::ceil(box.stripe + 2.0f * box.padding + width);
+        box.height = box.lines.size() * size + 2.0f * box.padding;
+
+        switch (place)
+        {
+        case HostOverlayPlace::TopRight:
+            box.x = std::max(0.0f, windowWidth - margin - box.width);
+            box.y = margin;
+            break;
+        case HostOverlayPlace::TopLeft:
+            box.x = margin;
+            box.y = margin;
+            if (avoid != nullptr && box.x < avoid->x + avoid->width && avoid->x < box.x + box.width &&
+                box.y < avoid->y + avoid->height && avoid->y < box.y + box.height)
+                box.y = avoid->y + avoid->height + margin;
+            break;
+        case HostOverlayPlace::BottomCentre:
+            box.x = std::max(0.0f, std::floor((windowWidth - box.width) / 2.0f));
+            box.y = std::max(0.0f, windowHeight - 2.0f * margin - box.height);
+            break;
+        }
+        return box;
+    }
+
+    namespace
+    {
+        uint32_t bigEndian32(const unsigned char *p)
+        {
+            return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+        }
+    }
+
+    bool hostFontBlobUsable(const unsigned char *data, size_t size)
+    {
+        if (data == nullptr || size < 12u)
+            return false;
+        const uint32_t tag = bigEndian32(data);
+        if (tag != 0x00010000u && tag != 0x74727565u) // "true"
+            return false;
+        const size_t tables = (size_t(data[4]) << 8) | data[5];
+        if (tables == 0u || 12u + 16u * tables > size)
+            return false;
+        constexpr const char *kNeeded[] = {"cmap", "glyf", "head", "hhea", "hmtx", "loca", "maxp"};
+        bool found[std::size(kNeeded)] = {};
+        for (size_t i = 0; i < tables; ++i)
+        {
+            const unsigned char *record = data + 12u + 16u * i;
+            const size_t offset = bigEndian32(record + 8), length = bigEndian32(record + 12);
+            if (offset > size || length > size - offset)
+                return false;
+            for (size_t n = 0; n < std::size(kNeeded); ++n)
+                found[n] = found[n] || std::equal(record, record + 4, kNeeded[n]);
+        }
+        return std::all_of(std::begin(found), std::end(found), [](bool f) { return f; });
+    }
+
+    const unsigned char *hostOverlayFontData()
+    {
+        return fonts::kMichromaRegularTtf;
+    }
+
+    size_t hostOverlayFontSize()
+    {
+        return fonts::kMichromaRegularTtfSize;
+    }
+
+    namespace
+    {
+        // The atlas is made at this size and scaled down with mipmaps (the notices are 10-54 pixels high).
+        constexpr int kAtlasSize = 64;
+
+        struct OverlayFont
+        {
+            bool tried = false;
+            bool own = false; // Michroma; false: raylib's default font
+            Font font{};
+        };
+
+        OverlayFont &overlayFont()
+        {
+            static OverlayFont s;
+            if (s.tried)
+                return s;
+            s.tried = true;
+            const unsigned char *data = hostOverlayFontData();
+            const size_t size = hostOverlayFontSize();
+            if (hostFontBlobUsable(data, size))
+            {
+                // ASCII and Latin-1 (the Spanish letters and the inverted marks, both cases).
+                std::vector<int> codepoints;
+                for (int c = 0x20; c <= 0x7E; ++c)
+                    codepoints.push_back(c);
+                for (int c = 0xA0; c <= 0xFF; ++c)
+                    codepoints.push_back(c);
+                Font font = LoadFontFromMemory(".ttf", data, static_cast<int>(size), kAtlasSize, codepoints.data(),
+                                               static_cast<int>(codepoints.size()));
+                if (font.texture.id != 0u && font.texture.id != GetFontDefault().texture.id && font.glyphCount > 0)
+                {
+                    GenTextureMipmaps(&font.texture);
+                    SetTextureFilter(font.texture, TEXTURE_FILTER_TRILINEAR);
+                    s.font = font;
+                    s.own = true;
+                    std::cout << "[avisos] letra Michroma (" << font.glyphCount << " glifos, atlas "
+                              << font.texture.width << "x" << font.texture.height << ")" << std::endl;
+                    return s;
+                }
+                UnloadFont(font);
+            }
+            std::cerr << "[avisos] no se pudo cargar la letra Michroma: letra por defecto" << std::endl;
+            return s;
+        }
+
+        Color toColor(HostOverlayColor c, float alpha)
+        {
+            return Color{c.r, c.g, c.b, static_cast<unsigned char>(std::lround(c.a * std::clamp(alpha, 0.0f, 1.0f)))};
+        }
+
+        HostOverlayBox g_recentTopRight;
+        double g_recentTopRightAt = -1.0;
+    }
+
+    HostOverlayBox drawHostOverlay(const std::string &text, HostOverlayPlace place, float alpha, HostOverlayColor stripe,
+                                   size_t keepCaseFrom)
+    {
+        if (!(alpha > 0.0f) || text.empty())
+            return {};
+        OverlayFont &loaded = overlayFont();
+        const Font font = loaded.own ? loaded.font : GetFontDefault();
+        // The default font is drawn as DrawText does (a pixel of spacing every 10 of size); Michroma is wide already.
+        const float spacingPerSize = loaded.own ? 0.0f : 0.1f;
+        const HostTextMeasure measure = [&](const std::string &line, float size)
+        { return MeasureTextEx(font, line.c_str(), size, size * spacingPerSize).x; };
+        HostOverlayBox avoid;
+        const bool avoiding = place == HostOverlayPlace::TopLeft && recentHostOverlayBox(HostOverlayPlace::TopRight, avoid);
+        const HostOverlayBox box = hostOverlayBox(hostOverlayCaps(text, keepCaseFrom), place, GetScreenWidth(),
+                                                  GetScreenHeight(), measure, avoiding ? &avoid : nullptr);
+
+        DrawRectangle(static_cast<int>(box.x), static_cast<int>(box.y), static_cast<int>(box.width),
+                      static_cast<int>(box.height), toColor(kHostOverlayPanel, alpha));
+        DrawRectangle(static_cast<int>(box.x), static_cast<int>(box.y), static_cast<int>(box.stripe),
+                      static_cast<int>(box.height), toColor(stripe, alpha));
+        // A drop shadow under the white, as the game's rows.
+        const float shadow = std::max(1.0f, std::round(box.fontSize / 12.0f));
+        for (size_t i = 0; i < box.lines.size(); ++i)
+        {
+            const Vector2 at{std::round(box.x + box.stripe + box.padding),
+                             std::round(box.y + box.padding + i * box.fontSize)};
+            const float spacing = box.fontSize * spacingPerSize;
+            DrawTextEx(font, box.lines[i].c_str(), Vector2{at.x + shadow, at.y + shadow}, box.fontSize, spacing,
+                       toColor(HostOverlayColor{0, 0, 0, 0xA0}, alpha));
+            DrawTextEx(font, box.lines[i].c_str(), at, box.fontSize, spacing, toColor(kHostOverlayText, alpha));
+        }
+        if (place == HostOverlayPlace::TopRight)
+        {
+            g_recentTopRight = box;
+            g_recentTopRightAt = GetTime();
+        }
+        return box;
+    }
+
+    bool recentHostOverlayBox(HostOverlayPlace place, HostOverlayBox &box)
+    {
+        if (place != HostOverlayPlace::TopRight || g_recentTopRightAt < 0.0 || GetTime() - g_recentTopRightAt > 0.25)
+            return false;
+        box = g_recentTopRight;
+        return true;
+    }
+}
