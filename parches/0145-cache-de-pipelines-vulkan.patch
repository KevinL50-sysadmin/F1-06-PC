+bool ps2GsGpuSameDevice(const GSGpuDeviceIdentity &a, const GSGpuDeviceIdentity &b)
+{
+    return a.vendorId == b.vendorId && a.deviceId == b.deviceId && a.driverVersion == b.driverVersion &&
+           std::memcmp(a.pipelineCacheUuid, b.pipelineCacheUuid, sizeof(a.pipelineCacheUuid)) == 0;
+}
+
+// Header: 0 magic, 8 format, 12 header size, 16 vendor, 20 device, 24 driver, 28 UUID, 44 zero, 48 payload size,
+// 56 payload hash.
+std::vector<uint8_t> ps2GsGpuEncodePipelineCache(const GSGpuDeviceIdentity &device, const std::vector<uint8_t> &payload)
+{
+    std::vector<uint8_t> file(kPipelineCacheHeaderSize + payload.size(), 0u);
+    std::memcpy(file.data(), kPipelineCacheMagic, sizeof(kPipelineCacheMagic));
+    putAt(file, 8u, kPipelineCacheFormat);
+    putAt(file, 12u, kPipelineCacheHeaderSize);
+    putAt(file, 16u, device.vendorId);
+    putAt(file, 20u, device.deviceId);
+    putAt(file, 24u, device.driverVersion);
+    std::memcpy(file.data() + 28u, device.pipelineCacheUuid, sizeof(device.pipelineCacheUuid));
+    putAt(file, 48u, static_cast<uint64_t>(payload.size()));
+    putAt(file, 56u, fnv1a64(payload.data(), payload.size()));
+    if (!payload.empty())
+        std::memcpy(file.data() + kPipelineCacheHeaderSize, payload.data(), payload.size());
+    return file;
+}
+
+GSGpuPipelineCacheStatus ps2GsGpuDecodePipelineCache(const std::vector<uint8_t> &file, const GSGpuDeviceIdentity *device,
+                                                     GSGpuDeviceIdentity &fileDevice, std::vector<uint8_t> &payload)
+{
+    payload.clear();
+    fileDevice = GSGpuDeviceIdentity{};
+    if (file.empty())
+        return GSGpuPipelineCacheStatus::Missing;
+    if (file.size() < kPipelineCacheHeaderSize ||
+        std::memcmp(file.data(), kPipelineCacheMagic, sizeof(kPipelineCacheMagic)) != 0 ||
+        getAt<uint32_t>(file, 8u) != kPipelineCacheFormat || getAt<uint32_t>(file, 12u) != kPipelineCacheHeaderSize)
+        return GSGpuPipelineCacheStatus::Corrupt;
+    const uint64_t size = getAt<uint64_t>(file, 48u);
+    if (size == 0u || size != file.size() - kPipelineCacheHeaderSize ||
+        getAt<uint64_t>(file, 56u) != fnv1a64(file.data() + kPipelineCacheHeaderSize, static_cast<size_t>(size)))
+        return GSGpuPipelineCacheStatus::Corrupt;
+    fileDevice.vendorId = getAt<uint32_t>(file, 16u);
+    fileDevice.deviceId = getAt<uint32_t>(file, 20u);
+    fileDevice.driverVersion = getAt<uint32_t>(file, 24u);
+    std::memcpy(fileDevice.pipelineCacheUuid, file.data() + 28u, sizeof(fileDevice.pipelineCacheUuid));
+    if (device != nullptr && !ps2GsGpuSameDevice(fileDevice, *device))
+        return GSGpuPipelineCacheStatus::OtherDevice;
+    payload.assign(file.begin() + kPipelineCacheHeaderSize, file.end());
+    return GSGpuPipelineCacheStatus::Valid;
+}
+
+std::filesystem::path ps2GsGpuPipelineCachePath(const char *variable, const std::filesystem::path &cacheDirectory)
+{
+    if (variable != nullptr && variable[0] != '\0')
+        return std::strcmp(variable, "0") == 0 ? std::filesystem::path{} : std::filesystem::path(variable);
+    if (cacheDirectory.empty())
+        return {};
+    return cacheDirectory / "vulkan-pipelines.bin";
+}
+
+std::filesystem::path ps2GsGpuPipelineCachePath()
+{
+    return ps2GsGpuPipelineCachePath(std::getenv("PS2X_GS_GPU_CACHE"), ps2x::userCacheDirectory());
+}
+
+// As opciones.ini is saved (ps2_options.cpp), for bytes.
+bool ps2GsGpuWriteFileAtomically(const std::filesystem::path &file, const std::vector<uint8_t> &bytes,
+                                 std::string &error)
+{
+    std::error_code ignored;
+    if (file.has_parent_path())
+        std::filesystem::create_directories(file.parent_path(), ignored);
+    std::filesystem::path temporary = file;
+    temporary += ".tmp";
+    {
+        std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+        if (out)
+        {
+            out.write(reinterpret_cast<const char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+            out.flush();
+        }
+        if (!out)
+        {
+            error = "no se pudo escribir " + ps2x::pathForLog(temporary);
+            out.close();
+            std::filesystem::remove(temporary, ignored);
+            return false;
+        }
+    }
+    std::error_code renameError;
+    std::filesystem::rename(temporary, file, renameError);
+    if (renameError)
+    {
+        error = "no se pudo sustituir " + ps2x::pathForLog(file) + ": " + renameError.message();
+        std::filesystem::remove(temporary, ignored);
+        return false;
+    }
+    error.clear();
+    return true;
+}
