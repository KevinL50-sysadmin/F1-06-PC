+    inline uint8_t jitBlendImm(uint8_t lanes) // x = bit 3 -> lane i = bit i
+    {
+        return static_cast<uint8_t>(((lanes >> 3) & 1u) | (((lanes >> 2) & 1u) << 1) | (((lanes >> 1) & 1u) << 2) |
+                                    ((lanes & 1u) << 3));
+    }
