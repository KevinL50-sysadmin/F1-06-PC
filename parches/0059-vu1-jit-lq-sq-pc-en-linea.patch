+    // XGKICK brought up to cycle st.cycle + issue first, as store() does: the call only when it is behind.
+    template <typename Host>
+    void jitEmitCatchUp(JitEmitter &e, const BlockPair &p)
+    {
+        using B = JitEmitter;
+        e.bytes({0x48, 0x8B}); // mov rax, [rsi + cycle]
+        e.modrm(0, B::St, static_cast<uint32_t>(offsetof(BlockState, cycle)));
+        e.bytes({0x48, 0x05}); // add rax, issue
+        e.imm32(p.issue);
+        e.bytes({0x48, 0x39}); // cmp [rsi + xgkickThrough], rax
+        e.modrm(0, B::St, static_cast<uint32_t>(offsetof(BlockState, xgkickThrough)));
+        const size_t skip = e.jae32();
+        e.call(reinterpret_cast<const void *>(&jitCatchUpPair<Host>), &p);
+        e.bind(skip);
+    }
