+    // SQ.dest vfS, imm(viT) inline (FastSq). False: not this case.
+    template <typename Host>
+    bool jitEmitSq(JitEmitter &e, const JitHostLayout &h, const BlockPair &p)
+    {
+        using B = JitEmitter;
+        if (p.lowerExec != LowerFast || p.fastOp != FastSq || !s_jitSse41)
+            return false;
+        jitEmitCatchUp<Host>(e, p);
+        jitDataAddress(e, h, p.fastB, p.fastImm);
+        e.loadXmm(1, B::Vu, offsetof(VU1State, vf) + 16u * p.fastA);
+        const uint8_t imm = jitBlendImm(p.fastDest);
+        if (imm == 0xFu)
+            e.bytes({0x0F, 0x11, 0x0C, 0x01}); // movups [rcx + rax], xmm1
+        else if (imm != 0u)
+        {
+            e.bytes({0x0F, 0x10, 0x04, 0x01}); // movups xmm0, [rcx + rax]
+            e.blendXmm0Xmm1(imm);
+            e.bytes({0x0F, 0x11, 0x04, 0x01}); // movups [rcx + rax], xmm0
+        }
+        return true;
+    }
