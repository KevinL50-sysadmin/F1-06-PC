+    // eax = (vi[base] + imm) * 16 & (dataBytes - 1); rcx = data (offsetAddress of fastLowerBody).
+    inline void jitDataAddress(JitEmitter &e, const JitHostLayout &h, uint8_t base, int16_t imm)
+    {
+        using B = JitEmitter;
+        e.load32(0, B::Vu, offsetof(VU1State, vi) + 4u * base);
+        e.bytes({0x05}); // add eax, imm
+        e.imm32(static_cast<uint32_t>(static_cast<int32_t>(imm)));
+        e.bytes({0xC1, 0xE0, 0x04}); // shl eax, 4
+        e.load32(1, B::HostReg, h.dataBytes);
+        e.bytes({0xFF, 0xC9}); // dec ecx
+        e.bytes({0x21, 0xC8}); // and eax, ecx
+        e.bytes({0x48, 0x8B}); // mov rcx, [rdi + data]
+        e.modrm(1, B::HostReg, h.data);
+    }
