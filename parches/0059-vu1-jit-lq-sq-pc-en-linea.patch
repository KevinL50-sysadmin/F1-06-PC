+        const size_t target = p.lowerDst == DstVf ? offsetof(VU1State, vf) + 16u * p.lowerReg
+                                                  : offsetof(BlockState, pendingVf) + 16u * p.lowerReg;
+        const uint8_t imm = jitBlendImm(p.lowerLanes);
