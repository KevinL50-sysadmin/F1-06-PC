+    // jitEnd inline: the cycle and the timing state, then XGKICK up to the end (the call only when it is behind).
+    template <typename Host>
+    void jitEmitEnd(JitEmitter &e, const Schedule &s)
+    {
+        using B = JitEmitter;
+        e.bytes({0x48, 0x81}); // add qword [rsi + cycle], exitCycle
