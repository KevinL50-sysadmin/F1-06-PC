+    // jitPc inline: the next pc, then the pending branch (rare) through jitPcPending.
+    template <typename Host>
+    void jitEmitPc(JitEmitter &e, const JitHostLayout &h, const BlockPair &p)
+    {
+        using B = JitEmitter;
+        uint32_t nextPc = p.pc + 8u;
+        if (nextPc >= h.codeSize)
+            nextPc = 0u;
+        e.bytes({0xC7}); // mov dword [rbx + pc], nextPc
+        e.modrm(0, B::Vu, static_cast<uint32_t>(offsetof(VU1State, pc)));
+        e.imm32(nextPc);
+        e.bytes({0x80}); // cmp byte [rbx + branchPending], 0
+        e.modrm(7, B::Vu, static_cast<uint32_t>(offsetof(VU1State, branchPending)));
+        e.bytes({0x00});
+        const size_t skip = e.je32();
+        e.call(reinterpret_cast<const void *>(&jitPcPending<Host>), &p);
+        e.bind(skip);
+    }
