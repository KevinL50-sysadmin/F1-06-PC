+    FastWrite4 makeFastWrite4(const PixelPipeline &pp)
+    {
+        FastWrite4 w;
+        const auto lanes = [](bool on) { return on ? _mm_setr_epi16(-1, -1, -1, 0, -1, -1, -1, 0) : _mm_setzero_si128(); };
+        w.aSrc = lanes(pp.asel == 0), w.aDst = lanes(pp.asel == 1);
+        w.bSrc = lanes(pp.bsel == 0), w.bDst = lanes(pp.bsel == 1);
+        w.dSrc = lanes(pp.dsel == 0), w.dDst = lanes(pp.dsel == 1);
+        w.fogColor = _mm_setr_epi16(pp.fogR, pp.fogG, pp.fogB, 0, pp.fogR, pp.fogG, pp.fogB, 0);
+        w.fbmsk = _mm_set1_epi32(static_cast<int>(pp.fbmsk));
+        w.aref = _mm_set1_epi32(static_cast<int>((pp.test >> 4) & 0xFFu));
+        w.atst = (pp.test & 0x1u) != 0u ? static_cast<uint8_t>((pp.test >> 1) & 0x7u) : 1u;
+        PixelWriteMask fail{false, false, false};
+        switch (static_cast<uint8_t>((pp.test >> 12) & 0x3u)) // classifyAlphaTest's
+        {
+        case 1: fail = {true, true, false}; break;
+        case 2: fail = {false, false, true}; break;
+        case 3: fail = static_cast<uint8_t>(pp.fpsm) == GS_PSM_CT32 ? PixelWriteMask{true, false, false}
+                                                                     : PixelWriteMask{true, true, false};
+            break;
+        default: break;
+        }
+        w.failRgb = fail.writeRgb, w.failAlpha = fail.writeAlpha, w.failDepth = fail.writeDepth;
+        w.fge = pp.fge, w.abe = pp.abe, w.pabe = pp.pabe, w.fbaSetsAlpha = pp.fbaSetsAlpha;
+        // passesDestinationAlphaTest: only CT32 can fail here (frame16 goes through writePixelCt32Z24At).
+        w.dateCt32 = ((pp.test >> 14) & 0x1u) != 0u && static_cast<uint8_t>(pp.fpsm) == GS_PSM_CT32;
+        w.datm = ((pp.test >> 15) & 0x1u) != 0u;
+        w.readAlways = pp.dateNeedsRead;
+        w.readForFrame = pp.fbmsk != 0u || pp.abe;
+        w.fbmskOn = pp.fbmsk != 0u;
+        w.frameCt32 = pp.frameCt32, w.frameCt24 = pp.frameCt24;
+        w.writeZ = !pp.zmask;
+        w.csel = pp.csel, w.fix = pp.fix;
