+    // Patch 0086: combineTexturePacked for four pixels (lane i: vertex[i] and texel[i]), two per register with the
+    // same 16-bit operations; `masks` (combineMasks4) are the combiner's masks for both halves.
+    struct CombineMasks4
+    {
+        __m128i product, texel, vertex, addAlpha;
+    };
+
+    CombineMasks4 combineMasks4(const TextureCombiner &tc)
+    {
+        return {_mm_unpacklo_epi64(tc.product, tc.product), _mm_unpacklo_epi64(tc.texel, tc.texel),
+                _mm_unpacklo_epi64(tc.vertex, tc.vertex), _mm_unpacklo_epi64(tc.addAlpha, tc.addAlpha)};
+    }
+
+    PS2_GS_INLINE __m128i combineTexture4(const CombineMasks4 &m, __m128i vertex, __m128i texel)
+    {
+        const __m128i zero = _mm_setzero_si128();
+        const auto pair = [&](__m128i v, __m128i t)
+        {
+            const __m128i product = _mm_srli_epi16(_mm_mullo_epi16(t, v), 7);
+            const __m128i va = _mm_shufflehi_epi16(_mm_shufflelo_epi16(v, 0xFF), 0xFF);
+            const __m128i out = _mm_or_si128(_mm_or_si128(_mm_and_si128(product, m.product), _mm_and_si128(t, m.texel)),
+                                             _mm_and_si128(v, m.vertex));
+            return _mm_add_epi16(out, _mm_and_si128(va, m.addAlpha));
+        };
+        return _mm_packus_epi16(pair(_mm_unpacklo_epi8(vertex, zero), _mm_unpacklo_epi8(texel, zero)),
+                                pair(_mm_unpackhi_epi8(vertex, zero), _mm_unpackhi_epi8(texel, zero)));
+    }
+#endif
