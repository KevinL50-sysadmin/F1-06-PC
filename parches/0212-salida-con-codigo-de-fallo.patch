diff --git a/ps2xRuntime/include/ps2_salida.h b/ps2xRuntime/include/ps2_salida.h
new file mode 100644
index 0000000..9149986
--- /dev/null
+++ b/ps2xRuntime/include/ps2_salida.h
@@ -0,0 +1,29 @@
+#pragma once
+
+// Salida del proceso (odd/tasks/fallos-con-log.md T2). RecompLauncher solo adjunta el .log mas reciente a un informe
+// de fallo cuando el juego termina con un codigo distinto de 0, asi que un fallo anota aqui su codigo y su motivo, y la
+// salida (main.cpp, o el plazo de cierre de ps2_runtime.cpp) termina con el y escribe una ultima linea en el registro:
+//   [salida] motivo=<motivo> codigo=<codigo>
+// El cierre normal sale con 0 (motivo=normal). Ningun codigo de aqui va en exit_codes de recomplauncher.json: eso
+// cambiaria el informe por un mensaje.
+namespace ps2x::salida
+{
+    // Distintos de los de --extraer-iso (0-4), del error fatal (1), del invitado de red (2) y de abort() (3).
+    constexpr int kExcepcionJuego = 10;  // excepcion C++ en el hilo del juego
+    constexpr int kExitDelJuego = 11;    // el juego llamo a exit() (p. ej. un error de Lua sin pcall)
+    constexpr int kCuelgueAlCerrar = 12; // el EE seguia colgado al cerrar, o el juego no se paro al cerrar
+
+    // Anota un fallo; gana el primero (los siguientes solo quedan en el registro de quien los detecta). Un codigo 0 no
+    // es un fallo y no hace nada. Seguro entre hilos; motivo se copia (sin espacios, para buscarlo en el registro).
+    void anotarFallo(int codigo, const char *motivo);
+
+    int codigo();         // 0 si no se ha anotado ningun fallo
+    const char *motivo(); // "normal" si no se ha anotado ningun fallo
+
+    // Escribe "[salida] motivo=<motivo> codigo=<codigo>" en std::cout y vacia std::cout y std::cerr (std::_Exit no
+    // vacia nada).
+    void escribir(int codigo, const char *motivo);
+
+    // Solo para las pruebas: vuelve al estado sin fallo.
+    void reiniciarParaPruebas();
+}
