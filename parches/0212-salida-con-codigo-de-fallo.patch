diff --git a/ps2xRuntime/src/lib/ps2_salida.cpp b/ps2xRuntime/src/lib/ps2_salida.cpp
new file mode 100644
index 0000000..80b914a
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_salida.cpp
@@ -0,0 +1,53 @@
+#include "ps2_salida.h"
+
+#include <cstring>
+#include <iostream>
+#include <mutex>
+
+namespace ps2x::salida
+{
+    namespace
+    {
+        std::mutex g_mutex;
+        int g_codigo = 0;
+        char g_motivo[64] = "normal";
+    }
+
+    void anotarFallo(int codigo, const char *motivo)
+    {
+        if (codigo == 0)
+            return;
+        std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_codigo != 0)
+            return;
+        g_codigo = codigo;
+        std::strncpy(g_motivo, motivo != nullptr && motivo[0] != '\0' ? motivo : "fallo", sizeof(g_motivo) - 1u);
+        g_motivo[sizeof(g_motivo) - 1u] = '\0';
+    }
+
+    int codigo()
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        return g_codigo;
+    }
+
+    const char *motivo()
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        return g_motivo; // solo cambia una vez, de "normal" al primer fallo
+    }
+
+    void escribir(int codigo, const char *motivo)
+    {
+        std::cout << "[salida] motivo=" << (motivo != nullptr ? motivo : "normal") << " codigo=" << codigo << "\n";
+        std::cout.flush();
+        std::cerr.flush();
+    }
+
+    void reiniciarParaPruebas()
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_codigo = 0;
+        std::strcpy(g_motivo, "normal");
+    }
+}
