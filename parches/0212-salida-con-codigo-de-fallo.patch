diff --git a/ps2xTest/src/ps2_salida_tests.cpp b/ps2xTest/src/ps2_salida_tests.cpp
new file mode 100644
index 0000000..eae5629
--- /dev/null
+++ b/ps2xTest/src/ps2_salida_tests.cpp
@@ -0,0 +1,140 @@
+#include "MiniTest.h"
+#include "ps2_salida.h"
+#include "ps2_vigilante.h"
+
+#include <cstdint>
+#include <iostream>
+#include <sstream>
+#include <string>
+
+// odd/tasks/fallos-con-log.md T2 (S1, S2): a failure exits non-zero so RecompLauncher attaches F1-06.log; a hang
+// counts only while it is still going on when the player closes the game.
+namespace
+{
+    using ps2x::vigilante::Detector;
+
+    // Captures what ps2x::salida::escribir sends to std::cout.
+    std::string written(int codigo, const char *motivo)
+    {
+        std::ostringstream out;
+        std::streambuf *old = std::cout.rdbuf(out.rdbuf());
+        ps2x::salida::escribir(codigo, motivo);
+        std::cout.rdbuf(old);
+        return out.str();
+    }
+
+    void sample(Detector &detector, double now, uint64_t counter)
+    {
+        (void)detector.muestra(now, &counter);
+    }
+}
+
+void register_ps2_salida_tests()
+{
+    MiniTest::Case("Salida", [](TestCase &tc)
+    {
+        tc.BeforeEach([]() { ps2x::salida::reiniciarParaPruebas(); });
+
+        tc.Run("no failure: exit code 0 and reason normal", [](TestCase &t)
+        {
+            t.Equals(ps2x::salida::codigo(), 0, "code 0");
+            t.Equals(std::string(ps2x::salida::motivo()), std::string("normal"), "reason normal");
+        });
+
+        tc.Run("a noted failure gives its code and reason", [](TestCase &t)
+        {
+            ps2x::salida::anotarFallo(ps2x::salida::kExcepcionJuego, "excepcion-hilo-juego");
+            t.Equals(ps2x::salida::codigo(), 10, "game thread exception: 10");
+            t.Equals(std::string(ps2x::salida::motivo()), std::string("excepcion-hilo-juego"), "its reason");
+        });
+
+        tc.Run("the first failure wins", [](TestCase &t)
+        {
+            ps2x::salida::anotarFallo(ps2x::salida::kExitDelJuego, "exit-del-juego");
+            ps2x::salida::anotarFallo(ps2x::salida::kCuelgueAlCerrar, "cuelgue-al-cerrar");
+            t.Equals(ps2x::salida::codigo(), 11, "still the game's exit: 11");
+            t.Equals(std::string(ps2x::salida::motivo()), std::string("exit-del-juego"), "still its reason");
+        });
+
+        tc.Run("codes are distinct, non-zero and outside the disc and guest codes", [](TestCase &t)
+        {
+            t.Equals(ps2x::salida::kExcepcionJuego, 10, "game thread exception");
+            t.Equals(ps2x::salida::kExitDelJuego, 11, "game's exit()");
+            t.Equals(ps2x::salida::kCuelgueAlCerrar, 12, "hang when closing");
+        });
+
+        tc.Run("code 0 is not a failure and changes nothing", [](TestCase &t)
+        {
+            ps2x::salida::anotarFallo(0, "nada");
+            t.Equals(ps2x::salida::codigo(), 0, "still 0");
+            t.Equals(std::string(ps2x::salida::motivo()), std::string("normal"), "still normal");
+            ps2x::salida::anotarFallo(ps2x::salida::kCuelgueAlCerrar, "cuelgue-al-cerrar");
+            t.Equals(ps2x::salida::codigo(), 12, "a later real failure still counts");
+        });
+
+        tc.Run("the final log line names reason and code", [](TestCase &t)
+        {
+            t.Equals(written(0, "normal"), std::string("[salida] motivo=normal codigo=0\n"), "normal close");
+            t.Equals(written(12, "cuelgue-al-cerrar"), std::string("[salida] motivo=cuelgue-al-cerrar codigo=12\n"),
+                     "hang when closing");
+        });
+    });
+
+    MiniTest::Case("VigilanteParado", [](TestCase &tc)
+    {
+        tc.Run("not stalled while advancing or before the threshold", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            for (int s = 0; s <= 5; ++s)
+                sample(detector, s, static_cast<uint64_t>(s));
+            t.IsFalse(detector.parado(0u), "advancing: not stalled");
+            sample(detector, 14.0, 5u);
+            t.IsFalse(detector.parado(0u), "9 s without advancing: not yet");
+        });
+
+        tc.Run("stalled from the threshold while the stall goes on", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            for (int s = 0; s <= 5; ++s)
+                sample(detector, s, static_cast<uint64_t>(s));
+            sample(detector, 15.0, 5u);
+            t.IsTrue(detector.parado(0u), "10 s: stalled");
+            sample(detector, 300.0, 5u);
+            t.IsTrue(detector.parado(0u), "still stalled at 300 s");
+        });
+
+        tc.Run("a stall the game recovered from no longer counts (S2)", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            for (int s = 0; s <= 5; ++s)
+                sample(detector, s, static_cast<uint64_t>(s));
+            sample(detector, 20.0, 5u);
+            t.IsTrue(detector.parado(0u), "stalled");
+            sample(detector, 21.0, 6u);
+            t.IsFalse(detector.parado(0u), "advanced again: not stalled");
+        });
+
+        tc.Run("each heartbeat on its own; out of range is not stalled", [](TestCase &t)
+        {
+            Detector detector(2u, 10);
+            uint64_t values[2] = {0u, 0u};
+            for (int s = 0; s <= 5; ++s)
+            {
+                values[0] = static_cast<uint64_t>(s);
+                values[1] = static_cast<uint64_t>(s);
+                (void)detector.muestra(s, values);
+            }
+            values[1] = 100u; // only the second one keeps advancing
+            (void)detector.muestra(16.0, values);
+            t.IsTrue(detector.parado(0u), "first stalled");
+            t.IsFalse(detector.parado(1u), "second advancing");
+            t.IsFalse(detector.parado(2u), "no third heartbeat");
+        });
+
+        tc.Run("not stalled by name when the watchdog is not running", [](TestCase &t)
+        {
+            t.IsFalse(ps2x::vigilante::latidoParado("EE"), "EE");
+            t.IsFalse(ps2x::vigilante::latidoParado("no-existe"), "unknown name");
+        });
+    });
+}
