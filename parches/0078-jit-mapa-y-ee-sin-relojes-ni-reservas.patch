+namespace
+{
+    // Patch 0078: the clock of the per-run host time ([vu1:ritmo], g_ps2Vu1HostNs): the time-stamp counter scaled to
+    // nanoseconds (calibrated once against steady_clock over 20 ms, and counted from the same origin), instead of a
+    // QueryPerformanceCounter call at both ends of every run (~0.8 % of the EE thread). A/B mode 66: steady_clock.
+    struct VuRunClock
+    {
+        using rep = int64_t;
+        using period = std::nano;
+        using duration = std::chrono::nanoseconds;
+        using time_point = std::chrono::time_point<VuRunClock>;
+        static constexpr bool is_steady = true;
+
+        static time_point now()
+        {
+            struct Calibration
+            {
+                int64_t steadyNs;
+                uint64_t tsc;
+                double nsPerTick;
+            };
+            static const Calibration c = []()
+            {
+                const auto t0 = std::chrono::steady_clock::now();
+                const uint64_t c0 = __rdtsc();
+                auto t1 = t0;
+                while (t1 - t0 < std::chrono::milliseconds(20))
+                    t1 = std::chrono::steady_clock::now();
+                const uint64_t c1 = __rdtsc();
+                const double ns = static_cast<double>(std::chrono::duration_cast<std::chrono::nanoseconds>(t1 - t0).count());
+                return Calibration{std::chrono::duration_cast<std::chrono::nanoseconds>(t1.time_since_epoch()).count(), c1,
+                                   c1 > c0 ? ns / static_cast<double>(c1 - c0) : 1.0};
+            }();
+            if ((g_ps2AbMode.load(std::memory_order_relaxed) == 66 || g_ps2AbMode.load(std::memory_order_relaxed) == 69))
+                return time_point(std::chrono::duration_cast<duration>(std::chrono::steady_clock::now().time_since_epoch()));
+            const int64_t ticks = static_cast<int64_t>(__rdtsc() - c.tsc);
+            return time_point(duration(c.steadyNs + static_cast<int64_t>(static_cast<double>(ticks) * c.nsPerTick)));
+        }
+    };
+}
