+bool GSThreadedBackend::HasRoom(uint64_t cost, bool reload)
+{
+    if (reload)
+    {
+        // Stale values only make the check stricter: m_head and m_costOut only grow.
+        m_seenHead = m_head.load(std::memory_order_acquire);
+        m_seenCostOut = m_costOut.load(std::memory_order_acquire);
+    }
+    // A command larger than the bound still goes in when the queue is empty.
+    return m_tail - m_seenHead < kCapacity &&
+           (m_seenHead == m_tail || m_costIn - m_seenCostOut + cost <= kMaxPendingCost);
+}
