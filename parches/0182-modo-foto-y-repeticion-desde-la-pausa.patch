+    class PhotoModeRequest
+    {
+    public:
+        static constexpr double kTimeout = 5.0;
+        enum class Step
+        {
+            None,    // nothing asked, or still waiting
+            Entered, // the photo mode went on now
+            Expired  // not served in time: dropped
+        };
+
+        void request(double now) { m_since = now; }
+        bool pending() const { return m_since >= 0.0; }
+        Step serve(PhotoModeSwitch &photoMode, double now, bool pauseMenuOpen)
+        {
+            if (m_since < 0.0)
+                return Step::None;
+            if (now - m_since > kTimeout)
+            {
+                m_since = -1.0;
+                return Step::Expired;
+            }
