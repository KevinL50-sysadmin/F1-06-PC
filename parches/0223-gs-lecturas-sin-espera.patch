+            t.IsTrue(nextSlot(2u, false) == 3u && nextSlot(pgs_readback::kSlots - 1u, false) == 0u,
+                     "the new mode cycles through the whole ring");
+            t.IsTrue(slotToUse(3u, true) == 0u, "switching to the previous mode on slot 3 goes back to slot 0");
+            t.IsTrue(slotToUse(2u, true) == 2u && slotToUse(3u, false) == 3u, "a slot in range is kept");
