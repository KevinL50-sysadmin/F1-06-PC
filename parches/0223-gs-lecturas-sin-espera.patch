+        tc.Run("the readback ring harvests a finished oldest readback and never waits for an unfinished one", [](TestCase &t)
+        {
+            using pgs_readback::SlotAction;
+            using pgs_readback::slotAction;
+            // T4 (S2): with a slow GPU (~50 ms per readback) waiting for the oldest readback cost ~18 ms per scanout.
+            t.IsTrue(pgs_readback::kSlots >= 4u && pgs_readback::kSlots <= 6u, "a ring of 4 to 6 readbacks");
+            t.IsTrue(slotAction(false, false, false) == SlotAction::Use, "a free slot is used");
+            t.IsTrue(slotAction(false, false, true) == SlotAction::Use, "a free slot is used also in the previous mode");
+            t.IsTrue(slotAction(true, true, false) == SlotAction::HarvestThenUse,
+                     "a finished oldest readback is harvested before its slot is reused");
+            t.IsTrue(slotAction(true, false, false) == SlotAction::Skip,
+                     "an unfinished oldest readback is not waited for: the scanout is not read back");
+            t.IsTrue(slotAction(true, true, true) == SlotAction::WaitThenUse,
+                     "the previous mode reuses the slot as before, without harvesting (its fence wait returns at once)");
+            t.IsTrue(slotAction(true, false, true) == SlotAction::WaitThenUse,
+                     "the previous mode (A/B 185, PGS_SCANOUT_WAIT_OLDEST_READBACK) waits for the oldest");
+        });
+        tc.Run("the previous readback mode keeps 3 readbacks in flight, the new one the whole ring", [](TestCase &t)
