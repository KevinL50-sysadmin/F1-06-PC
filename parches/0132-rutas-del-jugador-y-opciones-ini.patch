diff --git a/ps2xRuntime/src/lib/ps2_user_paths.cpp b/ps2xRuntime/src/lib/ps2_user_paths.cpp
new file mode 100644
index 0000000..48668d5
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_user_paths.cpp
@@ -0,0 +1,220 @@
+#include "ps2_user_paths.h"
+
+#include <mutex>
+#include <system_error>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <knownfolders.h>
+#include <shlobj.h>
+#endif
+
+namespace ps2x
+{
+    namespace
+    {
+        namespace fs = std::filesystem;
+
+        constexpr const char *kGameFolder = "F1-06";
+
+        std::mutex g_configMutex;
+        fs::path g_configDirectory;
+
+        bool pathExists(const fs::path &path)
+        {
+            std::error_code error;
+            return fs::exists(path, error);
+        }
+
+        // Moves source to target; across volumes (rename fails) it copies and leaves the source in place.
+        bool moveOrCopy(const fs::path &source, const fs::path &target, bool move, std::error_code &error)
+        {
+            fs::create_directories(target.parent_path(), error);
+            if (error)
+                return false;
+            if (move)
+            {
+                fs::rename(source, target, error);
+                if (!error)
+                    return true;
+                error.clear();
+            }
+            fs::copy(source, target, fs::copy_options::recursive, error);
+            return !error;
+        }
+
+#if defined(_WIN32)
+        fs::path knownFolder(const KNOWNFOLDERID &id)
+        {
+            PWSTR raw = nullptr;
+            fs::path result;
+            if (SUCCEEDED(SHGetKnownFolderPath(id, KF_FLAG_DEFAULT, nullptr, &raw)) && raw != nullptr)
+                result = fs::path(raw);
+            CoTaskMemFree(raw);
+            return result;
+        }
+#endif
+    }
+
+    UserPathsMode chooseUserPathsMode(bool development, const fs::path &exeDirectory)
+    {
+        if (development)
+            return UserPathsMode::Development;
+        return pathExists(exeDirectory / "portable.txt") ? UserPathsMode::Portable : UserPathsMode::Installed;
+    }
+
+    UserPaths resolveUserPaths(UserPathsMode mode, const fs::path &exeDirectory, const fs::path &documentsDirectory,
+                               const fs::path &localAppDataDirectory)
+    {
+        UserPaths paths;
+        if (mode == UserPathsMode::Installed && (documentsDirectory.empty() || localAppDataDirectory.empty()))
+            mode = UserPathsMode::Portable;
+        paths.mode = mode;
+        switch (mode)
+        {
+        case UserPathsMode::Development:
+            paths.configDirectory = exeDirectory;
+            paths.logsDirectory = exeDirectory;
+            break;
+        case UserPathsMode::Portable:
+            paths.configDirectory = exeDirectory / "config";
+            paths.savesDirectory = exeDirectory / "partidas";
+            paths.logsDirectory = exeDirectory / "registros";
+            paths.modsDirectory = exeDirectory / "mods";
+            break;
+        case UserPathsMode::Installed:
+        {
+            // "My Games" is the physical folder name ("Mis juegos" is only how Explorer shows it in Spanish).
+            const fs::path root = documentsDirectory / "My Games" / kGameFolder;
+            paths.configDirectory = root / "config";
+            paths.savesDirectory = root / "partidas";
+            paths.modsDirectory = root / "mods";
+            paths.logsDirectory = localAppDataDirectory / kGameFolder / "registros";
+            break;
+        }
+        }
+        return paths;
+    }
+
+    std::vector<MigrationStep> planUserDataMigration(const fs::path &exeDirectory, const std::string &exeStem,
+                                                     const UserPaths &paths)
+    {
+        std::vector<MigrationStep> plan;
+        if (paths.mode == UserPathsMode::Development)
+            return plan;
+        const MigrationAction action =
+            paths.mode == UserPathsMode::Portable ? MigrationAction::Move : MigrationAction::Copy;
+        const auto add = [&](MigrationItem item, const fs::path &source, const fs::path &target)
+        {
+            if (pathExists(source) && !pathExists(target))
+                plan.push_back({item, action, source, target});
+        };
+        add(MigrationItem::Cards, exeDirectory / "mc0", paths.savesDirectory / "mc0");
+        add(MigrationItem::Cards, exeDirectory / "mc1", paths.savesDirectory / "mc1");
+        add(MigrationItem::Controls, exeDirectory / "controles.ini", paths.configDirectory / "controles.ini");
+        for (const std::string name : {exeStem + ".log", exeStem + ".anterior.log"})
+            add(MigrationItem::Log, exeDirectory / name, paths.logsDirectory / name);
+        return plan;
+    }
+
+    std::vector<std::string> runUserDataMigration(const std::vector<MigrationStep> &steps)
+    {
+        std::vector<std::string> lines;
+        for (const MigrationStep &step : steps)
+        {
+            if (pathExists(step.target))
+            {
+                lines.push_back("[rutas] no se migra " + pathForLog(step.source) + ": ya existe " +
+                                pathForLog(step.target));
+                continue;
+            }
+            std::error_code error;
+            const bool move = step.action == MigrationAction::Move;
+            if (moveOrCopy(step.source, step.target, move, error))
+            {
+                const bool moved = move && !pathExists(step.source);
+                lines.push_back("[rutas] migrado " + pathForLog(step.source) + " -> " + pathForLog(step.target) +
+                                (moved ? " (movido)" : " (copiado)"));
+            }
+            else
+            {
+                lines.push_back("[rutas] no se pudo migrar " + pathForLog(step.source) + " -> " +
+                                pathForLog(step.target) + ": " + error.message());
+            }
+        }
+        return lines;
+    }
+
+    void createUserDirectories(const UserPaths &paths)
+    {
+        std::error_code error;
+        for (const fs::path &folder : {paths.configDirectory, paths.logsDirectory, paths.modsDirectory})
+            if (!folder.empty())
+                fs::create_directories(folder, error);
+        if (!paths.savesDirectory.empty())
+        {
+            fs::create_directories(paths.savesDirectory / "mc0", error);
+            fs::create_directories(paths.savesDirectory / "mc1", error);
+        }
+    }
+
+    std::string describeUserPaths(const UserPaths &paths)
+    {
+        const char *mode = paths.mode == UserPathsMode::Portable    ? "portable"
+                           : paths.mode == UserPathsMode::Installed ? "instalado"
+                                                                    : "desarrollo";
+        const std::string saves = paths.savesDirectory.empty() ? "(junto al ELF)" : pathForLog(paths.savesDirectory);
+        const std::string mods = paths.modsDirectory.empty() ? "(ninguna)" : pathForLog(paths.modsDirectory);
+        return std::string("[rutas] modo ") + mode + ": config=" + pathForLog(paths.configDirectory) +
+               " partidas=" + saves + " registros=" + pathForLog(paths.logsDirectory) + " mods=" + mods;
+    }
+
+    std::string pathForLog(const fs::path &path)
+    {
+        try
+        {
+            return path.string();
+        }
+        catch (const std::exception &)
+        {
+            const std::u8string text = path.u8string();
+            return std::string(text.begin(), text.end());
+        }
+    }
+
+    fs::path knownDocumentsDirectory()
+    {
+#if defined(_WIN32)
+        return knownFolder(FOLDERID_Documents);
+#else
+        return {};
+#endif
+    }
+
+    fs::path knownLocalAppDataDirectory()
+    {
+#if defined(_WIN32)
+        return knownFolder(FOLDERID_LocalAppData);
+#else
+        return {};
+#endif
+    }
+
+    void setUserConfigDirectory(const fs::path &directory)
+    {
+        std::lock_guard<std::mutex> lock(g_configMutex);
+        g_configDirectory = directory;
+    }
+
+    fs::path userConfigDirectory()
+    {
+        std::lock_guard<std::mutex> lock(g_configMutex);
+        return g_configDirectory;
+    }
+}
