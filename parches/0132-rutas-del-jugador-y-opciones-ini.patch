diff --git a/ps2xRuntime/include/ps2_user_paths.h b/ps2xRuntime/include/ps2_user_paths.h
new file mode 100644
index 0000000..5a387e8
--- /dev/null
+++ b/ps2xRuntime/include/ps2_user_paths.h
@@ -0,0 +1,82 @@
+#pragma once
+
+#include <filesystem>
+#include <string>
+#include <vector>
+
+// Phase 1 (F1 06): where the player's files live. A packaged game (datos folder or ISO) keeps them in its own folder
+// with portable.txt next to the .exe, or in Documents\My Games\F1-06 and LocalAppData\F1-06\registros without it.
+// Development runs (an ELF path argument) keep the old layout: cards next to the ELF, controles.ini and the log next
+// to the .exe.
+namespace ps2x
+{
+    enum class UserPathsMode
+    {
+        Development,
+        Portable,
+        Installed
+    };
+
+    struct UserPaths
+    {
+        UserPathsMode mode = UserPathsMode::Development;
+        std::filesystem::path configDirectory; // controles.ini, opciones.ini
+        std::filesystem::path savesDirectory;  // mc0, mc1 (empty: next to the ELF)
+        std::filesystem::path logsDirectory;
+        std::filesystem::path modsDirectory; // empty in development mode
+    };
+
+    // Development when booting an ELF given by path; otherwise portable if portable.txt sits next to the .exe.
+    UserPathsMode chooseUserPathsMode(bool development, const std::filesystem::path &exeDirectory);
+
+    // Pure: the folders of each mode. Installed mode without a Documents folder falls back to the portable layout.
+    UserPaths resolveUserPaths(UserPathsMode mode, const std::filesystem::path &exeDirectory,
+                               const std::filesystem::path &documentsDirectory,
+                               const std::filesystem::path &localAppDataDirectory);
+
+    enum class MigrationItem
+    {
+        Cards,
+        Controls,
+        Log
+    };
+
+    enum class MigrationAction
+    {
+        Move,
+        Copy
+    };
+
+    struct MigrationStep
+    {
+        MigrationItem item = MigrationItem::Cards;
+        MigrationAction action = MigrationAction::Move;
+        std::filesystem::path source;
+        std::filesystem::path target;
+    };
+
+    // The old layout next to the .exe (mc0, mc1, controles.ini, <exe>.log, <exe>.anterior.log) that exists and whose
+    // new place does not: moved in portable mode, copied in installed mode, nothing in development mode.
+    std::vector<MigrationStep> planUserDataMigration(const std::filesystem::path &exeDirectory,
+                                                     const std::string &exeStem, const UserPaths &paths);
+
+    // Runs the plan, never overwriting a target that exists by then. One "[rutas] ..." line per step.
+    std::vector<std::string> runUserDataMigration(const std::vector<MigrationStep> &steps);
+
+    // Creates the folders of the mode (config, partidas\mc0 and mc1, registros, mods).
+    void createUserDirectories(const UserPaths &paths);
+
+    // "[rutas] modo portable|instalado|desarrollo: config=... partidas=... registros=... mods=..."
+    std::string describeUserPaths(const UserPaths &paths);
+
+    // A path for the log that never throws on characters outside the console code page.
+    std::string pathForLog(const std::filesystem::path &path);
+
+    // Documents and LocalAppData of the current user (empty if unknown).
+    std::filesystem::path knownDocumentsDirectory();
+    std::filesystem::path knownLocalAppDataDirectory();
+
+    // The folder of controles.ini and opciones.ini for the rest of the runtime (empty: next to the .exe).
+    void setUserConfigDirectory(const std::filesystem::path &directory);
+    std::filesystem::path userConfigDirectory();
+}
diff --git a/ps2xRuntime/src/lib/ps2_options.cpp b/ps2xRuntime/src/lib/ps2_options.cpp
new file mode 100644
index 0000000..fa5f099
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_options.cpp
@@ -0,0 +1,207 @@
+#include "ps2_options.h"
+#include "ps2_user_paths.h"
+
+#include <cctype>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <system_error>
+
+namespace ps2x
+{
+    namespace
+    {
+        const char *const kOptionsHeader =
+            "# Opciones de F1 06 (PC). Este archivo se crea solo la primera vez; borralo para volver a los valores por\n"
+            "# defecto. Formato: <opcion> = <valor>. Lo que va detras de # es un comentario.\n"
+            "# Las variables de entorno PS2X_* (pruebas) mandan sobre este archivo.\n";
+
+        std::string trim(std::string_view text)
+        {
+            size_t begin = 0u, end = text.size();
+            while (begin < end && std::isspace(static_cast<unsigned char>(text[begin])))
+                ++begin;
+            while (end > begin && std::isspace(static_cast<unsigned char>(text[end - 1u])))
+                --end;
+            return std::string(text.substr(begin, end - begin));
+        }
+
+        std::string lower(std::string text)
+        {
+            for (char &c : text)
+                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+            return text;
+        }
+
+        bool validValue(const OptionSpec &spec, const std::string &value)
+        {
+            if (!spec.choices.empty())
+            {
+                for (const OptionChoice &choice : spec.choices)
+                    if (value == choice.value)
+                        return true;
+                return false;
+            }
+            if (value.empty() || value.size() > 9u)
+                return false;
+            for (char c : value)
+                if (!std::isdigit(static_cast<unsigned char>(c)))
+                    return false;
+            const int number = std::atoi(value.c_str());
+            return number >= spec.minimum && number <= spec.maximum;
+        }
+
+        std::string allowedValues(const OptionSpec &spec)
+        {
+            if (spec.choices.empty())
+                return std::to_string(spec.minimum) + " a " + std::to_string(spec.maximum);
+            std::string text;
+            for (const OptionChoice &choice : spec.choices)
+                text += (text.empty() ? "" : ", ") + std::string(choice.value);
+            return text;
+        }
+    }
+
+    // One line per option. A new option needs its PS2X_* variable to be read by the runtime as usual.
+    const std::vector<OptionSpec> &optionSpecs()
+    {
+        static const std::vector<OptionSpec> specs = {
+            {"pantalla_completa", "PS2X_PANTALLA_COMPLETA", "0", {{"0", "0"}, {"1", "1"}}, 0, 0,
+             "Pantalla completa sin bordes al arrancar: 0 = ventana, 1 = pantalla completa (F11 la cambia jugando)."},
+            {"aspecto", "PS2X_ASPECTO", "auto", {{"auto", nullptr}, {"4:3", "4:3"}, {"16:9", "16:9"}, {"pixel", "pixel"}}, 0, 0,
+             "Forma de la imagen: auto (la que se elija en las opciones del juego), 4:3, 16:9 o pixel (pixeles\n"
+             "cuadrados, sin ajustar). F10 la cambia jugando."},
+            {"filtro", "PS2X_FILTRO", "bilineal", {{"bilineal", "1"}, {"cercano", "0"}}, 0, 0,
+             "Filtro al ampliar la imagen a la ventana: bilineal (suave) o cercano (pixeles nitidos)."},
+            {"volumen", "PS2X_VOLUMEN", "100", {}, 0, 100, "Volumen del sonido, de 0 (sin sonido) a 100."},
+            {"registro", "PS2X_LOG", "1", {{"0", "0"}, {"1", "1"}}, 0, 0,
+             "Registro del juego (F1-06.log en la carpeta registros) al abrirlo con doble clic: 1 = si, 0 = no."},
+        };
+        return specs;
+    }
+
+    std::string defaultOptionsText()
+    {
+        std::string text = kOptionsHeader;
+        for (const OptionSpec &spec : optionSpecs())
+        {
+            text += "\n";
+            std::istringstream comment(spec.comment);
+            std::string line;
+            while (std::getline(comment, line))
+                text += "# " + line + "\n";
+            text += std::string(spec.key) + " = " + spec.defaultValue + "\n";
+        }
+        return text;
+    }
+
+    OptionsFile parseOptions(std::string_view text, std::string_view fileName)
+    {
+        OptionsFile result;
+        for (const OptionSpec &spec : optionSpecs())
+            result.values[spec.key] = spec.defaultValue;
+        if (text.substr(0, 3) == "\xEF\xBB\xBF")
+            text.remove_prefix(3);
+
+        const std::string where = "[opciones] " + std::string(fileName) + ":";
+        int lineNumber = 0;
+        size_t position = 0u;
+        while (position <= text.size())
+        {
+            const size_t newline = text.find('\n', position);
+            std::string_view line = text.substr(position, newline == std::string_view::npos ? std::string_view::npos
+                                                                                             : newline - position);
+            position = newline == std::string_view::npos ? text.size() + 1u : newline + 1u;
+            ++lineNumber;
+            if (const size_t hash = line.find('#'); hash != std::string_view::npos)
+                line = line.substr(0, hash);
+            if (trim(line).empty())
+                continue;
+            const size_t equals = line.find('=');
+            if (equals == std::string_view::npos)
+            {
+                result.warnings.push_back(where + std::to_string(lineNumber) + ": linea sin '=' ('" + trim(line) +
+                                          "'); se ignora");
+                continue;
+            }
+            const std::string key = lower(trim(line.substr(0, equals)));
+            const std::string value = lower(trim(line.substr(equals + 1u)));
+            const OptionSpec *spec = nullptr;
+            for (const OptionSpec &candidate : optionSpecs())
+                if (key == candidate.key)
+                    spec = &candidate;
+            if (spec == nullptr)
+            {
+                result.warnings.push_back(where + std::to_string(lineNumber) + ": opcion desconocida '" + key +
+                                          "'; se ignora");
+                continue;
+            }
+            if (!validValue(*spec, value))
+            {
+                result.warnings.push_back(where + std::to_string(lineNumber) + ": valor no valido '" + value +
+                                          "' para " + spec->key + "; se usa " + spec->defaultValue + " (valores: " +
+                                          allowedValues(*spec) + ")");
+                result.values[spec->key] = spec->defaultValue;
+                continue;
+            }
+            result.values[spec->key] = value;
+        }
+        return result;
+    }
+
+    std::vector<EnvironmentSetting> optionsEnvironment(
+        const OptionsFile &options, const std::function<const char *(const char *)> &getEnvironment)
+    {
+        std::vector<EnvironmentSetting> settings;
+        for (const OptionSpec &spec : optionSpecs())
+        {
+            if (getEnvironment(spec.environment) != nullptr)
+                continue;
+            const auto found = options.values.find(spec.key);
+            const std::string value = found == options.values.end() ? spec.defaultValue : found->second;
+            if (spec.choices.empty())
+            {
+                settings.push_back({spec.environment, value});
+                continue;
+            }
+            for (const OptionChoice &choice : spec.choices)
+                if (value == choice.value && choice.environment != nullptr)
+                    settings.push_back({spec.environment, choice.environment});
+        }
+        return settings;
+    }
+
+    void applyOptionsFile(const std::filesystem::path &file, std::vector<std::string> &messages)
+    {
+        std::string text;
+        if (std::ifstream in(file, std::ios::binary); in)
+        {
+            std::stringstream content;
+            content << in.rdbuf();
+            text = content.str();
+            messages.push_back("[opciones] " + pathForLog(file));
+        }
+        else
+        {
+            text = defaultOptionsText();
+            std::error_code error;
+            std::filesystem::create_directories(file.parent_path(), error);
+            std::ofstream out(file, std::ios::binary);
+            out << text;
+            messages.push_back("[opciones] " + pathForLog(file) +
+                               (out ? " creado con los valores por defecto" : " no se pudo crear; valores por defecto"));
+        }
+
+        const OptionsFile options = parseOptions(text, file.filename().string());
+        messages.insert(messages.end(), options.warnings.begin(), options.warnings.end());
+        for (const EnvironmentSetting &setting :
+             optionsEnvironment(options, [](const char *name) { return static_cast<const char *>(std::getenv(name)); }))
+        {
+#if defined(_WIN32)
+            _putenv_s(setting.variable.c_str(), setting.value.c_str());
+#else
+            setenv(setting.variable.c_str(), setting.value.c_str(), 0);
+#endif
+        }
+    }
+}
