+
+namespace
+{
+    namespace fs = std::filesystem;
+    using ps2x::MigrationAction;
+    using ps2x::MigrationItem;
+    using ps2x::MigrationStep;
+    using ps2x::UserPaths;
+    using ps2x::UserPathsMode;
+
+    struct TempDir
+    {
+        fs::path path;
+
+        TempDir()
+        {
+            const auto stamp = std::chrono::steady_clock::now().time_since_epoch().count();
+            path = fs::temp_directory_path() / ("ps2x-user-paths-" + std::to_string(stamp));
+            fs::create_directories(path);
+        }
+
+        ~TempDir()
+        {
+            std::error_code error;
+            fs::remove_all(path, error);
+        }
+    };
+
+    struct IoPathsGuard
+    {
+        PS2Runtime::IoPaths saved = PS2Runtime::getIoPaths();
+        ~IoPathsGuard() { PS2Runtime::setIoPaths(saved); }
+    };
+
+    // Sets (or clears, with nullptr) environment variables and restores them at the end of the test.
+    struct EnvironmentGuard
+    {
+        std::map<std::string, std::string> saved;
+        std::vector<std::string> unset;
+
+        void set(const char *name, const char *value)
+        {
+            if (saved.count(name) == 0u && std::find(unset.begin(), unset.end(), name) == unset.end())
+            {
+                if (const char *old = std::getenv(name))
+                    saved[name] = old;
+                else
+                    unset.emplace_back(name);
+            }
+            _putenv_s(name, value ? value : "");
+        }
+
+        ~EnvironmentGuard()
+        {
+            for (const auto &[name, value] : saved)
+                _putenv_s(name.c_str(), value.c_str());
+            for (const std::string &name : unset)
+                _putenv_s(name.c_str(), "");
+        }
+    };
+
+    void writeText(const fs::path &path, const std::string &text)
+    {
+        fs::create_directories(path.parent_path());
+        std::ofstream out(path, std::ios::binary);
+        out << text;
+    }
+
+    std::string readText(const fs::path &path)
+    {
+        std::ifstream in(path, std::ios::binary);
+        std::stringstream text;
+        text << in.rdbuf();
+        return text.str();
+    }
+
+    std::string normal(const fs::path &path)
+    {
+        return path.lexically_normal().string();
+    }
+
+    // The old layout of a packaged game next to its .exe.
+    void writeOldLayout(const fs::path &exe)
+    {
+        writeText(exe / "mc0" / "BESCES-53950" / "save.bin", "card0");
+        writeText(exe / "mc1" / "keep.bin", "card1");
+        writeText(exe / "controles.ini", "cruz = tecla:X\n");
+        writeText(exe / "F1-06.log", "old log\n");
+        writeText(exe / "F1-06.anterior.log", "older log\n");
+    }
+
+    std::map<std::string, std::string> environmentMap(const std::vector<ps2x::EnvironmentSetting> &settings)
+    {
+        std::map<std::string, std::string> result;
+        for (const ps2x::EnvironmentSetting &setting : settings)
+            result[setting.variable] = setting.value;
+        return result;
+    }
+}
+
+void register_ps2_user_paths_tests()
+{
+    MiniTest::Case("UserPaths", [](TestCase &tc)
+    {
+        tc.Run("portable mode keeps config, partidas, registros and mods next to the .exe", [](TestCase &t)
+        {
+            const fs::path exe = "C:/Games/F1-06";
+            const UserPaths paths = ps2x::resolveUserPaths(UserPathsMode::Portable, exe, "C:/Users/p/Documents",
+                                                           "C:/Users/p/AppData/Local");
+            t.IsTrue(paths.mode == UserPathsMode::Portable, "the mode is portable");
+            t.Equals(normal(paths.configDirectory), normal(exe / "config"), "config next to the .exe");
+            t.Equals(normal(paths.savesDirectory), normal(exe / "partidas"), "partidas next to the .exe");
+            t.Equals(normal(paths.logsDirectory), normal(exe / "registros"), "registros next to the .exe");
+            t.Equals(normal(paths.modsDirectory), normal(exe / "mods"), "mods next to the .exe");
+        });
+
+        tc.Run("installed mode uses Documents\\My Games\\F1-06 and LocalAppData\\F1-06\\registros", [](TestCase &t)
+        {
+            const fs::path documents = "C:/Users/p/Documents";
+            const fs::path local = "C:/Users/p/AppData/Local";
+            const UserPaths paths = ps2x::resolveUserPaths(UserPathsMode::Installed, "C:/Games/F1-06", documents, local);
+            const fs::path root = documents / "My Games" / "F1-06";
+            t.IsTrue(paths.mode == UserPathsMode::Installed, "the mode is installed");
+            t.Equals(normal(paths.configDirectory), normal(root / "config"), "config in My Games");
