+                "registro = 0");
+            t.IsTrue(parsed.warnings.empty(), "no warnings");
+            t.Equals(parsed.values.at("pantalla_completa"), std::string("1"), "pantalla_completa");
+            t.Equals(parsed.values.at("aspecto"), std::string("16:9"), "aspecto");
+            t.Equals(parsed.values.at("filtro"), std::string("cercano"), "filtro");
+            t.Equals(parsed.values.at("volumen"), std::string("35"), "volumen");
+            t.Equals(parsed.values.at("registro"), std::string("0"), "registro");
+        });
