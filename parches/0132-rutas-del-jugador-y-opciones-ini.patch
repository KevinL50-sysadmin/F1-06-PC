diff --git a/ps2xRuntime/include/ps2_options.h b/ps2xRuntime/include/ps2_options.h
new file mode 100644
index 0000000..e6f79cc
--- /dev/null
+++ b/ps2xRuntime/include/ps2_options.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <filesystem>
+#include <functional>
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Phase 1 (F1 06): opciones.ini, the player's settings. Each option stands for a PS2X_* variable; a variable that is
+// already set wins over the file (tests), and the file wins over the default. The runtime applies the file by setting
+// the variables that are not set yet, before anything reads them.
+namespace ps2x
+{
+    struct OptionChoice
+    {
+        const char *value;       // as written in opciones.ini
+        const char *environment; // value of the variable; nullptr leaves it unset
+    };
+
+    struct OptionSpec
+    {
+        const char *key;
+        const char *environment;
+        const char *defaultValue;
+        std::vector<OptionChoice> choices; // empty: an integer from minimum to maximum, passed as is
+        int minimum = 0;
+        int maximum = 0;
+        const char *comment; // Spanish, written above the key in the default file ('\n' between lines)
+    };
+
+    const std::vector<OptionSpec> &optionSpecs();
+
+    // The file written the first time: every option with its default value and a comment.
+    std::string defaultOptionsText();
+
+    struct OptionsFile
+    {
+        std::map<std::string, std::string> values; // every known key: its valid value or the default
+        std::vector<std::string> warnings;          // unknown keys and bad values, one line each
+    };
+
+    // Pure: '#' comments, spaces, CRLF and a UTF-8 BOM are accepted; keys and choices are case-insensitive.
+    OptionsFile parseOptions(std::string_view text, std::string_view fileName = "opciones.ini");
+
+    struct EnvironmentSetting
+    {
+        std::string variable;
+        std::string value;
+    };
+
+    // The variables to set: one per option whose variable is not set (getEnvironment returns null) and whose value
+    // maps to one.
+    std::vector<EnvironmentSetting> optionsEnvironment(
+        const OptionsFile &options, const std::function<const char *(const char *)> &getEnvironment);
+
+    // Reads opciones.ini (creating it with the defaults if missing) and sets the variables it decides. The lines for
+    // the log ("[opciones] ...") are appended to messages.
+    void applyOptionsFile(const std::filesystem::path &file, std::vector<std::string> &messages);
+}
