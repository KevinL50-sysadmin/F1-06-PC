+                                                                "filtro = bilineal\n"
+                                                                "brillo = 3\n"
+                                                                "volumen = mucho\n"
+                                                                "sin igual\n");
+            t.Equals(parsed.values.at("volumen"), std::string("100"), "volumen falls back to the default");
+            t.Equals(parsed.values.at("aspecto"), std::string("auto"), "aspecto falls back to the default");
+            t.Equals(parsed.values.at("filtro"), std::string("bilineal"), "a good value is kept");
+            t.Equals(parsed.warnings.size(), size_t{5}, "one warning per bad line");
+            const std::string all = [&]
