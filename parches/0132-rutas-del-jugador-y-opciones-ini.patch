+    MiniTest::Case("Options", [](TestCase &tc)
+    {
+        tc.Run("the default opciones.ini lists every option with its default and a comment", [](TestCase &t)
+        {
+            const std::string text = ps2x::defaultOptionsText();
+            for (const char *line : {"pantalla_completa = 0\n", "aspecto = auto\n", "filtro = bilineal\n",
+                                     "volumen = 100\n", "registro = 1\n"})
+                t.IsTrue(text.find(line) != std::string::npos, std::string("has ") + line);
+            const ps2x::OptionsFile parsed = ps2x::parseOptions(text);
+            t.IsTrue(parsed.warnings.empty(), "the default file parses without warnings");
+            for (const ps2x::OptionSpec &spec : ps2x::optionSpecs())
+            {
+                t.Equals(parsed.values.at(spec.key), std::string(spec.defaultValue), std::string("default of ") + spec.key);
+                t.IsTrue(text.find(std::string("\n") + spec.key + " = ") != std::string::npos,
+                         std::string("key line of ") + spec.key);
+                t.IsTrue(spec.comment != nullptr && spec.comment[0] != '\0', std::string("comment of ") + spec.key);
+            }
+            t.Equals(ps2x::optionSpecs().size(), size_t{5}, "five options");
+        });
+
+        tc.Run("parseOptions accepts spaces, comments, CRLF, a BOM and any case", [](TestCase &t)
+        {
+            const ps2x::OptionsFile parsed = ps2x::parseOptions(
