+#ifndef PS2_INTC_QUEUE_H
+#define PS2_INTC_QUEUE_H
+
+#include <cstdint>
+
+// INTC causes raised by hardware emulation (for example the VIF 'i' bit) travel through
+// PS2Memory's completed-DMAC queue tagged with this bit, so they keep their order relative to
+// DMA completions and PS2Runtime::drainCompletedDmacHandlers dispatches them as INTC interrupts.
+constexpr uint32_t kPs2QueuedIntcCauseFlag = 0x80000000u;
+
+constexpr uint32_t kPs2IntcCauseVif0 = 4u;
+constexpr uint32_t kPs2IntcCauseVif1 = 5u;
+
+#endif // PS2_INTC_QUEUE_H
