+#include "runtime/ps2_intc_queue.h"
 #include "ThreadNaming.h"
 #include "Kernel/Stubs/Audio.h"
 #include "Kernel/Stubs/GS.h"
@@ -1487,6 +1488,11 @@ void PS2Runtime::drainCompletedDmacHandlers(uint8_t *rdram)
 {
     for (uint32_t cause : m_memory.consumeCompletedDmacCauses())
     {
+        if ((cause & kPs2QueuedIntcCauseFlag) != 0u)
+        {
+            eeScheduler().dispatchIrq(false, cause & ~kPs2QueuedIntcCauseFlag);
+            continue;
+        }
         ps2_syscalls::dispatchDmacHandlersForCause(rdram, this, cause);
     }
 }
