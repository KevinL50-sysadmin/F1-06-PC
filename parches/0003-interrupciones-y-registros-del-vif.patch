 {
+    if (address >= 0x10003C00u && address < 0x10003E00u)
+    {
+        uint32_t value = 0u;
+        if (readVifRegister(vif1_regs, address - 0x10003C00u, value))
+            return value;
+    }
+    if (address >= 0x10003800u && address < 0x10003A00u)
+    {
+        uint32_t value = 0u;
+        if (readVifRegister(vif0_regs, address - 0x10003800u, value))
+            return value;
+    }
+
