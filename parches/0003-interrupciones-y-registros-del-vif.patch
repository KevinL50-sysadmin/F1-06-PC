+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -2278,8 +2278,55 @@ int PS2Memory::pollDmaRegisters()
     return 0;
 }
 
+namespace
+{
+    // VIFn registers as the CPU reads them: VIF0 at 0x10003800, VIF1 at 0x10003C00, one every 0x10.
+    bool readVifRegister(const VIFRegisters &regs, uint32_t offset, uint32_t &value)
+    {
+        switch (offset)
+        {
+        case 0x00: value = regs.stat; return true;
+        case 0x10: value = 0u; return true; // FBRST is write-only
+        case 0x20: value = regs.err; return true;
+        case 0x30: value = regs.mark; return true;
+        case 0x40: value = regs.cycle; return true;
+        case 0x50: value = regs.mode; return true;
+        case 0x60: value = regs.num; return true;
+        case 0x70: value = regs.mask; return true;
+        case 0x80: value = regs.code; return true;
+        case 0x90: value = regs.itops; return true;
+        case 0xA0: value = regs.base; return true;
+        case 0xB0: value = regs.ofst; return true;
+        case 0xC0: value = regs.tops; return true;
+        case 0xD0: value = regs.itop; return true;
+        case 0xE0: value = regs.top; return true;
+        default: break;
+        }
+        if (offset >= 0x100u && offset < 0x180u && (offset & 0xFu) == 0u)
+        {
+            const uint32_t index = (offset - 0x100u) / 0x10u; // R0-R3, then C0-C3
+            value = index < 4u ? regs.row[index] : regs.col[index - 4u];
+            return true;
+        }
+        return false;
+    }
+}
