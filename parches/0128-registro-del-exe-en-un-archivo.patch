     std::filesystem::path getExecutablePath();
 
+    // A player starts the .exe by hand, so its output goes to a console window nobody keeps: write it to
+    // <exe dir>\<exe name>.log instead (the previous run is kept as <exe name>.anterior.log). Runs whose output is
+    // already redirected (the test scripts) are left alone; PS2X_LOG=0 keeps the console.
+    void redirectConsoleToLogFile(const std::filesystem::path &executable)
+    {
+#if defined(_WIN32)
+        if (_isatty(_fileno(stdout)) == 0)
+            return;
+        const char *setting = std::getenv("PS2X_LOG");
+        if (setting != nullptr && setting[0] == '0')
+            return;
+        std::error_code error;
+        const std::filesystem::path directory = executable.parent_path();
+        const std::filesystem::path log = directory / (executable.stem().string() + ".log");
+        if (std::filesystem::exists(log, error))
+            std::filesystem::rename(log, directory / (executable.stem().string() + ".anterior.log"), error);
+        std::cout << "[registro] " << log.string() << std::endl;
+        FILE *out = nullptr;
+        if (_wfreopen_s(&out, log.c_str(), L"w", stdout) != 0 || out == nullptr)
+            return;
+        _dup2(_fileno(stdout), _fileno(stderr)); // stderr shares the file (and its position) with stdout
+        const std::time_t now = std::time(nullptr);
+        char stamp[32] = {};
+        std::strftime(stamp, sizeof(stamp), "%Y-%m-%d %H:%M:%S", std::localtime(&now));
+        std::cout << "[registro] " << stamp << " " << executable.string() << std::endl;
+#else
+        (void)executable;
+#endif
+    }
+
