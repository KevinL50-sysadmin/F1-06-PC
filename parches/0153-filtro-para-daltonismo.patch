@@ -0,0 +1,37 @@
+#pragma once
+
+#include <array>
+#include <functional>
+#include <string_view>
+
+// Fase 5 (T7, F1 06): the colour blindness filter of the presentation (opciones.ini: daltonismo). A 3x3 matrix on
+// the picture after the scaling filter (ps2_display.cpp). Apart from ps2_display.h because ps2_runtime.h includes that
+// one (changing it rebuilds the 14,000 recompiled functions).
+namespace ps2x
+{
+    enum class ColorVision
+    {
+        Normal,       // no: no filter
+        Protanopia,   // no red cones
+        Deuteranopia, // no green cones
+        Tritanopia,   // no blue cones
+    };
+
+    // The opciones.ini names (no, protanopia, deuteranopia, tritanopia), case-insensitive.
+    const char *colorVisionName(ColorVision vision);
+    bool parseColorVision(std::string_view text, ColorVision &vision);
+    // PS2X_DALTONISMO (set from opciones.ini); unset or bad: Normal.
+    ColorVision colorVisionFromEnvironment(const std::function<const char *(const char *)> &getEnvironment);
+
+    // Row-major 3x3 matrices on RGB in 0..1. Simulation: how a dichromat of that kind sees the colours (Machado,
+    // Oliveira and Fernandes 2009, severity 1). Correction: daltonize (Fidaner, Lin and Ozguven 2005), the colours the
+    // eye cannot tell apart moved into those it can, I + E (I - simulation). Normal: the identity.
+    std::array<float, 9> colorVisionSimulation(ColorVision vision);
+    std::array<float, 9> colorVisionCorrection(ColorVision vision);
+    // matrix * rgb, clamped to 0..1 (as the shader writes it).
+    std::array<float, 3> applyColorMatrix(const std::array<float, 9> &matrix, const std::array<float, 3> &rgb);
+
+    // The filter the window uses; any thread (the options menus), applied from the next window frame.
+    void setColorVision(ColorVision vision);
+    ColorVision colorVision();
+}
