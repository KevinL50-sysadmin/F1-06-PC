@@ -246,5 +246,23 @@ void main()
     float rcpL = 1.0 / (4.0 * lobe + 1.0);
     finalColor = vec4(clamp((lobe * (b + d + h + f) + e) * rcpL, 0.0, 1.0), 1.0);
 }
+)glsl";
+
+    // Fase 5 (T7): the colour blindness filter (daltonismo), on the picture already scaled to the window (a render
+    // texture of the destination's size, read pixel for pixel). The rows of ps2x::colorVisionCorrection.
+    inline constexpr const char *kColorVision = R"glsl(#version 330
+in vec2 fragTexCoord;
+in vec4 fragColor;
+uniform sampler2D texture0;
+uniform vec3 row0;
+uniform vec3 row1;
+uniform vec3 row2;
+out vec4 finalColor;
+
+void main()
+{
+    vec3 c = texture(texture0, fragTexCoord).rgb;
+    finalColor = vec4(clamp(vec3(dot(row0, c), dot(row1, c), dot(row2, c)), 0.0, 1.0), 1.0);
+}
 )glsl";
 }
