+    // VU code generations start from a value no other PS2Memory used: the static VU block engines cache schemes by
+    // generation, so two memories both starting at 0 would share stale schemes (each memory gets 2^32 values).
+    static uint64_t uniqueVuCodeGenerationBase()
+    {
+        static std::atomic<uint64_t> s_instances{0};
+        return (s_instances.fetch_add(1, std::memory_order_relaxed) + 1u) << 32;
+    }
+    std::atomic<uint64_t> m_vu0CodeGeneration{uniqueVuCodeGenerationBase()};
+    std::atomic<uint64_t> m_vu1CodeGeneration{uniqueVuCodeGenerationBase()};
