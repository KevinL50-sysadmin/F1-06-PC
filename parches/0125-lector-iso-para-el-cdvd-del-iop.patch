diff --git a/ps2xIOP/include/ps2x/iop/ps2_iso_image.h b/ps2xIOP/include/ps2x/iop/ps2_iso_image.h
new file mode 100644
index 0000000..4870cd0
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/ps2_iso_image.h
@@ -0,0 +1,242 @@
+#pragma once
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace ps2x::iop
+{
+    struct IsoEntry
+    {
+        uint32_t lsn = 0u;
+        uint32_t size = 0u;
+        bool isDirectory = false;
+    };
+
+    // Read-only ISO 9660 image (a plain .iso, or one stored at a byte offset inside a larger file).
+    // open() indexes every directory once; lookup() and readSectors() may then be called from any thread.
+    // open() and close() must not race with readers.
+    class IsoImage
+    {
+    public:
+        static constexpr uint32_t kSectorSize = 2048u;
+        static constexpr uint32_t kPrimaryVolumeDescriptorLsn = 16u;
+
+        IsoImage() = default;
+        IsoImage(const IsoImage &) = delete;
+        IsoImage &operator=(const IsoImage &) = delete;
+
+        bool open(const std::filesystem::path &path, uint64_t baseOffset = 0u)
+        {
+            close();
+            m_stream.open(path, std::ios::binary);
+            if (!m_stream.is_open())
+                return false;
+            m_baseOffset = baseOffset;
+
+            std::vector<uint8_t> pvd(kSectorSize);
+            if (!readRaw(static_cast<uint64_t>(kPrimaryVolumeDescriptorLsn) * kSectorSize, pvd.data(), pvd.size()) ||
+                pvd[0] != 1u || std::memcmp(pvd.data() + 1u, "CD001", 5u) != 0 ||
+                readLe16(pvd.data() + 128u) != kSectorSize)
+            {
+                close();
+                return false;
+            }
+            m_totalSectors = readLe32(pvd.data() + 80u);
+            const IsoEntry root{readLe32(pvd.data() + 156u + 2u), readLe32(pvd.data() + 156u + 10u), true};
+            m_index.emplace(std::string{}, root);
+            if (!indexDirectory(std::string{}, root))
+            {
+                close();
+                return false;
+            }
+            m_path = path;
+            m_open = true;
+            return true;
+        }
+
+        void close()
+        {
+            if (m_stream.is_open())
+                m_stream.close();
+            m_stream.clear();
+            m_index.clear();
+            m_path.clear();
+            m_baseOffset = 0u;
+            m_totalSectors = 0u;
+            m_open = false;
+        }
+
+        [[nodiscard]] bool isOpen() const { return m_open; }
+        [[nodiscard]] const std::filesystem::path &path() const { return m_path; }
+        [[nodiscard]] uint64_t baseOffset() const { return m_baseOffset; }
+        // Volume space size from the PVD (not the file size).
+        [[nodiscard]] uint32_t totalSectors() const { return m_totalSectors; }
+
+        // Accepts "\DIR\FILE.BIN;1", "dir/file.bin" or "cdrom0:\DIR\FILE.BIN;1" (case-insensitive).
+        [[nodiscard]] std::optional<IsoEntry> lookup(std::string_view guestPath) const
+        {
+            if (!m_open)
+                return std::nullopt;
+            const std::optional<std::string> key = normalizePath(guestPath);
+            if (!key)
+                return std::nullopt;
+            const auto found = m_index.find(*key);
+            if (found == m_index.end())
+                return std::nullopt;
+            return found->second;
+        }
+
+        // Reads `count` whole sectors at `lsn` into `destination` (count * kSectorSize bytes).
+        bool readSectors(uint32_t lsn, uint32_t count, void *destination) const
+        {
+            if (!m_open || static_cast<uint64_t>(lsn) + count > m_totalSectors)
+                return false;
+            return readRaw(static_cast<uint64_t>(lsn) * kSectorSize, destination,
+                           static_cast<size_t>(count) * kSectorSize);
+        }
+
+    private:
+        static uint16_t readLe16(const uint8_t *bytes)
+        {
+            return static_cast<uint16_t>(bytes[0] | (bytes[1] << 8u));
+        }
+
+        static uint32_t readLe32(const uint8_t *bytes)
+        {
+            return static_cast<uint32_t>(bytes[0]) | (static_cast<uint32_t>(bytes[1]) << 8u) |
+                   (static_cast<uint32_t>(bytes[2]) << 16u) | (static_cast<uint32_t>(bytes[3]) << 24u);
+        }
+
+        // Upper case, without the ";1" version suffix or a trailing '.' (ISO names without extension).
+        static std::string normalizeComponent(std::string_view value)
+        {
+            std::string result(value);
+            const size_t semicolon = result.rfind(';');
+            if (semicolon != std::string::npos)
+                result.resize(semicolon);
+            while (!result.empty() && result.back() == '.')
+                result.pop_back();
+            std::transform(result.begin(), result.end(), result.begin(),
+                           [](unsigned char ch)
+                           { return static_cast<char>(std::toupper(ch)); });
+            return result;
+        }
+
+        static std::optional<std::string> normalizePath(std::string_view value)
+        {
+            const size_t colon = value.find(':');
+            if (colon != std::string_view::npos)
+            {
+                std::string device(value.substr(0u, colon));
+                std::transform(device.begin(), device.end(), device.begin(),
+                               [](unsigned char ch)
+                               { return static_cast<char>(std::tolower(ch)); });
+                if (device != "cdrom0" && device != "cdrom")
+                    return std::nullopt;
+                value.remove_prefix(colon + 1u);
+            }
+
+            std::string result;
+            size_t begin = 0u;
+            while (begin <= value.size())
+            {
+                size_t end = value.find_first_of("/\\", begin);
+                if (end == std::string_view::npos)
+                    end = value.size();
+                const std::string_view component = value.substr(begin, end - begin);
+                begin = end + 1u;
+                if (component.empty() || component == ".")
+                    continue;
+                if (component == "..")
+                    return std::nullopt;
+                if (!result.empty())
+                    result += '/';
+                result += normalizeComponent(component);
+            }
+            return result;
+        }
+
+        bool readRaw(uint64_t offset, void *destination, size_t size) const
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_stream.clear();
+            m_stream.seekg(static_cast<std::streamoff>(m_baseOffset + offset), std::ios::beg);
+            if (!m_stream)
+                return false;
+            m_stream.read(static_cast<char *>(destination), static_cast<std::streamsize>(size));
+            return static_cast<size_t>(m_stream.gcount()) == size;
+        }
+
+        bool indexDirectory(const std::string &prefix, const IsoEntry &directory)
+        {
+            std::vector<std::pair<std::string, IsoEntry>> pending{{prefix, directory}};
+            std::unordered_set<uint32_t> visited;
+            while (!pending.empty())
+            {
+                const auto [base, entry] = pending.back();
+                pending.pop_back();
+                if (!visited.insert(entry.lsn).second)
+                    continue;
+
+                const uint32_t sectors = (entry.size + kSectorSize - 1u) / kSectorSize;
+                if (sectors == 0u || static_cast<uint64_t>(entry.lsn) + sectors > m_totalSectors)
+                    return false;
+                std::vector<uint8_t> bytes(static_cast<size_t>(sectors) * kSectorSize);
+                if (!readRaw(static_cast<uint64_t>(entry.lsn) * kSectorSize, bytes.data(), bytes.size()))
+                    return false;
+
+                size_t offset = 0u;
+                while (offset < entry.size)
+                {
+                    const uint8_t length = bytes[offset];
+                    if (length == 0u)
+                    {
+                        // No more records in this sector: they continue in the next one.
+                        offset = (offset / kSectorSize + 1u) * kSectorSize;
+                        continue;
+                    }
+                    if (length < 34u || offset + length > bytes.size())
+                        return false;
+                    const uint8_t *record = bytes.data() + offset;
+                    offset += length;
+                    const uint8_t nameLength = record[32];
+                    if (33u + nameLength > length)
+                        return false;
+                    if (nameLength == 1u && (record[33] == 0u || record[33] == 1u))
+                        continue; // "." and ".."
+
+                    const std::string name = normalizeComponent(
+                        std::string_view(reinterpret_cast<const char *>(record + 33u), nameLength));
+                    const IsoEntry child{readLe32(record + 2u), readLe32(record + 10u), (record[25] & 0x02u) != 0u};
+                    const std::string key = base.empty() ? name : base + '/' + name;
+                    // Multi-extent files repeat their record: the first extent is kept.
+                    if (!m_index.emplace(key, child).second)
+                        continue;
+                    if (child.isDirectory)
+                        pending.emplace_back(key, child);
+                }
+            }
+            return true;
+        }
+
+        mutable std::mutex m_mutex;
+        mutable std::ifstream m_stream;
+        std::filesystem::path m_path;
+        uint64_t m_baseOffset = 0u;
+        uint32_t m_totalSectors = 0u;
+        bool m_open = false;
+        std::unordered_map<std::string, IsoEntry> m_index;
+    };
+}
