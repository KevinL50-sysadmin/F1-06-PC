+namespace
+{
+    using ps2x::iop::IsoEntry;
+    using ps2x::iop::IsoImage;
+
+    constexpr uint32_t kSector = 2048u;
+    constexpr uint32_t kVolumeSectors = 64u; // larger than the file on purpose: the PVD is authoritative
+    constexpr uint32_t kRootLsn = 18u;       // two sectors: DIR in the first, README.TXT after a zero-length gap
+    constexpr uint32_t kDirLsn = 20u;
+    constexpr uint32_t kFileLsn = 21u; // DIR/FILE.BIN, 5000 bytes over three sectors
+    constexpr uint32_t kFileSize = 5000u;
+    constexpr uint32_t kReadmeLsn = 24u;
+    constexpr uint32_t kImageSectors = 25u;
+    const std::string kReadme = "hello iso!";
+
+    void putBoth32(std::vector<uint8_t> &image, size_t at, uint32_t value)
+    {
+        for (uint32_t i = 0u; i < 4u; ++i)
+        {
+            image[at + i] = static_cast<uint8_t>(value >> (i * 8u));
+            image[at + 4u + i] = static_cast<uint8_t>(value >> ((3u - i) * 8u));
+        }
+    }
+
+    void putBoth16(std::vector<uint8_t> &image, size_t at, uint16_t value)
+    {
+        image[at] = static_cast<uint8_t>(value);
+        image[at + 1u] = static_cast<uint8_t>(value >> 8u);
+        image[at + 2u] = static_cast<uint8_t>(value >> 8u);
+        image[at + 3u] = static_cast<uint8_t>(value);
+    }
+
+    size_t putRecord(std::vector<uint8_t> &image, size_t at, uint32_t lsn, uint32_t size, bool directory,
+                     const std::string &name)
+    {
+        const size_t length = (33u + name.size() + 1u) & ~size_t{1u};
+        image[at] = static_cast<uint8_t>(length);
+        putBoth32(image, at + 2u, lsn);
+        putBoth32(image, at + 10u, size);
+        image[at + 25u] = directory ? 2u : 0u;
+        putBoth16(image, at + 28u, 1u);
+        image[at + 32u] = static_cast<uint8_t>(name.size());
+        std::memcpy(image.data() + at + 33u, name.data(), name.size());
+        return at + length;
+    }
+
+    std::vector<uint8_t> fileBytes()
+    {
+        std::vector<uint8_t> bytes(kFileSize);
+        for (uint32_t i = 0u; i < kFileSize; ++i)
+            bytes[i] = static_cast<uint8_t>((i * 7u + i / kSector) & 0xFFu);
+        return bytes;
+    }
+
+    std::vector<uint8_t> buildIso()
+    {
+        std::vector<uint8_t> image(static_cast<size_t>(kImageSectors) * kSector, 0u);
+        const size_t pvd = 16u * kSector;
+        image[pvd] = 1u;
+        std::memcpy(image.data() + pvd + 1u, "CD001", 5u);
+        image[pvd + 6u] = 1u;
+        putBoth32(image, pvd + 80u, kVolumeSectors);
+        putBoth16(image, pvd + 128u, static_cast<uint16_t>(kSector));
+        (void)putRecord(image, pvd + 156u, kRootLsn, 2u * kSector, true, std::string(1u, '\0'));
+        const size_t terminator = 17u * kSector;
+        image[terminator] = 255u;
+        std::memcpy(image.data() + terminator + 1u, "CD001", 5u);
+
+        size_t at = kRootLsn * kSector;
+        at = putRecord(image, at, kRootLsn, 2u * kSector, true, std::string(1u, '\0'));
+        at = putRecord(image, at, kRootLsn, 2u * kSector, true, std::string(1u, '\1'));
+        (void)putRecord(image, at, kDirLsn, kSector, true, "DIR");
+        (void)putRecord(image, (kRootLsn + 1u) * kSector, kReadmeLsn, static_cast<uint32_t>(kReadme.size()), false,
+                        "README.TXT;1");
+
+        at = kDirLsn * kSector;
+        at = putRecord(image, at, kDirLsn, kSector, true, std::string(1u, '\0'));
+        at = putRecord(image, at, kRootLsn, 2u * kSector, true, std::string(1u, '\1'));
+        (void)putRecord(image, at, kFileLsn, kFileSize, false, "FILE.BIN;1");
+
+        const std::vector<uint8_t> file = fileBytes();
+        std::memcpy(image.data() + kFileLsn * kSector, file.data(), file.size());
+        std::memcpy(image.data() + kReadmeLsn * kSector, kReadme.data(), kReadme.size());
+        return image;
+    }
+
+    struct TempDir
+    {
+        std::filesystem::path path;
+
+        TempDir()
+        {
+            const auto stamp = std::chrono::steady_clock::now().time_since_epoch().count();
+            path = std::filesystem::temp_directory_path() / ("ps2x-iso-image-" + std::to_string(stamp));
+            std::filesystem::create_directories(path);
+        }
+
+        ~TempDir()
+        {
+            std::error_code error;
+            std::filesystem::remove_all(path, error);
+        }
+    };
+
+    void writeFile(const std::filesystem::path &path, const std::vector<uint8_t> &bytes)
+    {
+        std::ofstream out(path, std::ios::binary);
+        out.write(reinterpret_cast<const char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    }
+
+    // Writes the ISO after `prefix` junk bytes and before some trailing junk, as when it is appended to a file.
+    std::filesystem::path writeIso(const TempDir &dir, const char *name, uint64_t prefix)
+    {
+        std::vector<uint8_t> bytes(static_cast<size_t>(prefix), 0xEEu);
+        const std::vector<uint8_t> iso = buildIso();
+        bytes.insert(bytes.end(), iso.begin(), iso.end());
+        if (prefix != 0u)
+            bytes.insert(bytes.end(), 777u, 0xEEu);
+        const std::filesystem::path path = dir.path / name;
+        writeFile(path, bytes);
+        return path;
+    }
+
+    void checkImage(TestCase &t, const IsoImage &image, const std::string &label)
+    {
+        t.Equals(image.totalSectors(), kVolumeSectors, label + ": total sectors come from the PVD, not the file size");
+
+        for (const char *path : {"\\DIR\\FILE.BIN;1", "dir/file.bin", "cdrom0:\\DIR\\FILE.BIN;1", "CDROM0:/Dir/File.Bin"})
+        {
+            const std::optional<IsoEntry> entry = image.lookup(path);
+            t.IsTrue(entry.has_value(), label + ": lookup finds " + path);
+            if (entry)
+            {
+                t.Equals(entry->lsn, kFileLsn, label + ": real LSN for " + path);
+                t.Equals(entry->size, kFileSize, label + ": size for " + path);
+                t.IsFalse(entry->isDirectory, label + ": FILE.BIN is a file");
+            }
+        }
+
+        const std::optional<IsoEntry> directory = image.lookup("\\DIR");
+        t.IsTrue(directory.has_value() && directory->isDirectory && directory->lsn == kDirLsn,
+                 label + ": \\DIR is a directory at its real LSN");
+        const std::optional<IsoEntry> readme = image.lookup("\\README.TXT;1");
+        t.IsTrue(readme.has_value() && readme->lsn == kReadmeLsn && readme->size == kReadme.size(),
+                 label + ": a record after a zero-length gap in the next directory sector is found");
+        t.IsFalse(image.lookup("\\DIR\\MISSING.BIN;1").has_value(), label + ": a missing file is not found");
+        t.IsFalse(image.lookup("\\NODIR\\FILE.BIN;1").has_value(), label + ": a missing directory is not found");
+        t.IsFalse(image.lookup("\\FILE.BIN;1").has_value(), label + ": a file is only found in its own directory");
+
+        const std::vector<uint8_t> expected = fileBytes();
+        std::vector<uint8_t> sectors(3u * kSector, 0xAAu);
+        t.IsTrue(image.readSectors(kFileLsn, 3u, sectors.data()), label + ": reading the file sectors succeeds");
+        t.IsTrue(std::memcmp(sectors.data(), expected.data(), expected.size()) == 0,
+                 label + ": readSectors returns the exact file bytes");
+        t.IsTrue(std::all_of(sectors.begin() + kFileSize, sectors.end(), [](uint8_t b) { return b == 0u; }),
+                 label + ": the sector tail comes from the image (zeros), not the caller's buffer");
+
+        std::vector<uint8_t> one(kSector, 0u);
+        t.IsTrue(image.readSectors(kReadmeLsn, 1u, one.data()) &&
+                     std::memcmp(one.data(), kReadme.data(), kReadme.size()) == 0,
+                 label + ": a single sector read returns README.TXT");
+        t.IsFalse(image.readSectors(kVolumeSectors - 1u, 2u, one.data()),
+                  label + ": a read past the volume end is refused");
+    }
+
+    // A minimal IOP host: real host files for the virtual ISO, and the configured image path and offset.
+    class CdvdHost final : public ps2x::iop::IopHost
+    {
+    public:
+        bool readGuest(uint32_t, void *, size_t) const override { return false; }
+        bool writeGuest(uint32_t, const void *, size_t) override { return false; }
+        bool zeroGuest(uint32_t, size_t) override { return false; }
+        bool normalizeGuestAddress(uint32_t, uint32_t &) const override { return false; }
+        uint32_t allocateIopHandle(ps2x::iop::IopHandleKind) override { return 1u; }
+        uint32_t allocateGuest(uint32_t, uint32_t) override { return 0u; }
+        void freeGuest(uint32_t) override {}
+        void audioCommand(uint32_t, uint32_t, ps2x::iop::GuestBuffer, ps2x::iop::GuestBuffer) override {}
+        std::string hostPath(ps2x::iop::HostPathKind kind) const override
+        {
+            if (kind == ps2x::iop::HostPathKind::CdRoot)
+                return cdRoot.string();
+            if (kind == ps2x::iop::HostPathKind::CdImage)
+                return cdImage.empty() ? std::string{} : cdImage.string();
+            return {};
+        }
+        uint64_t cdImageOffset() const override { return imageOffset; }
+        std::string translateGuestPath(std::string_view path) const override { return std::string(path); }
+        uint64_t openHostFile(std::string_view path) override
+        {
+            std::FILE *stream = std::fopen(std::string(path).c_str(), "rb");
+            if (!stream)
+                return 0u;
+            files[++lastHandle] = stream;
+            return lastHandle;
+        }
+        bool hostFileSize(uint64_t, uint64_t &) const override { return false; }
+        bool readHostFile(uint64_t handle, uint64_t offset, void *destination, size_t size, size_t &bytesRead) override
+        {
+            bytesRead = 0u;
+            const auto found = files.find(handle);
+            if (found == files.end() || std::fseek(found->second, static_cast<long>(offset), SEEK_SET) != 0)
+                return false;
+            bytesRead = std::fread(destination, 1u, size, found->second);
+            return true;
+        }
+        void closeHostFile(uint64_t handle) override
+        {
+            const auto found = files.find(handle);
+            if (found == files.end())
+                return;
+            std::fclose(found->second);
+            files.erase(found);
+        }
+        int32_t memoryCard(const ps2x::iop::MemoryCardRequest &) override { return 0; }
+        bool hasGuestFunction(uint32_t) const override { return false; }
+        bool invokeGuestFunction(uint64_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t *) override
+        {
+            return false;
+        }
+        void log(ps2x::iop::LogLevel, std::string_view) override {}
+
+        std::filesystem::path cdRoot;
+        std::filesystem::path cdImage;
+        uint64_t imageOffset = 0u;
+        std::unordered_map<uint64_t, std::FILE *> files;
+        uint64_t lastHandle = 0u;
+    };
+
+    struct CdvdHarness
+    {
+        explicit CdvdHarness(CdvdHost &host) : kernel(memory), cdvd(host, memory, kernel)
+        {
+            kernel.reset();
+            cdvd.reset();
+            resultAddress = memory.allocate(64u);
+            nameAddress = memory.allocate(256u);
+            bufferAddress = memory.allocate(4u * kSector);
+        }
+
+        // sceCdSearchFile: returns 1 when found and leaves sceCdlFILE at resultAddress.
+        uint32_t searchFile(const std::string &name)
+        {
+            (void)memory.writeRam(nameAddress, name.c_str(), name.size() + 1u);
+            ps2x::iop::detail::IopCpuState cpu{};
+            cpu.gpr[4] = resultAddress;
+            cpu.gpr[5] = nameAddress;
+            return cdvd.dispatchImport(10u, cpu) ? cpu.gpr[2] : 0xFFFFFFFFu;
+        }
+
+        // sceCdRead into bufferAddress.
+        uint32_t read(uint32_t lsn, uint32_t sectors)
+        {
+            ps2x::iop::detail::IopCpuState cpu{};
+            cpu.gpr[4] = lsn;
+            cpu.gpr[5] = sectors;
+            cpu.gpr[6] = bufferAddress;
+            return cdvd.dispatchImport(6u, cpu) ? cpu.gpr[2] : 0xFFFFFFFFu;
+        }
+
+        std::vector<uint8_t> buffer(size_t size) const
+        {
+            std::vector<uint8_t> bytes(size, 0u);
+            (void)memory.readRam(bufferAddress, bytes.data(), bytes.size());
+            return bytes;
+        }
+
+        ps2x::iop::detail::IopMemory memory;
+        ps2x::iop::detail::IopKernel kernel;
+        ps2x::iop::detail::IopCdvd cdvd;
+        uint32_t resultAddress = 0u;
+        uint32_t nameAddress = 0u;
+        uint32_t bufferAddress = 0u;
+    };
+}
+
+void register_ps2_iso_image_tests()
+{
+    MiniTest::Case("PS2IsoImage", [](TestCase &tc)
+    {
+        tc.Run("IsoImage reads a plain ISO: lookup forms, real LSNs, sectors and PVD size", [](TestCase &t)
+        {
+            TempDir dir;
+            const std::filesystem::path path = writeIso(dir, "plain.iso", 0u);
+            IsoImage image;
+            t.IsTrue(image.open(path), "a plain ISO opens at offset 0");
+            checkImage(t, image, "plain");
+        });
+
+        tc.Run("IsoImage reads an ISO stored at a non-zero offset inside a larger file", [](TestCase &t)
+        {
+            TempDir dir;
+            constexpr uint64_t prefix = 3u * kSector + 123u;
+            const std::filesystem::path path = writeIso(dir, "appended.bin", prefix);
+            IsoImage image;
+            t.IsFalse(image.open(path, 0u), "the appended ISO is not found at offset 0");
+            t.IsTrue(image.open(path, prefix), "the appended ISO opens at its base offset");
+            checkImage(t, image, "offset");
+        });
+
+        tc.Run("IsoImage refuses files that are not ISO 9660 images", [](TestCase &t)
+        {
+            TempDir dir;
+            const std::filesystem::path text = dir.path / "notes.txt";
+            writeFile(text, std::vector<uint8_t>(20u * kSector, 'x'));
+            IsoImage image;
+            t.IsFalse(image.open(text), "a non-ISO file does not open");
+            t.IsFalse(image.isOpen(), "a failed open leaves the image closed");
+            t.IsFalse(image.open(dir.path / "missing.iso"), "a missing file does not open");
+            const std::filesystem::path small = dir.path / "small.iso";
+            writeFile(small, std::vector<uint8_t>(kSector, 0u));
+            t.IsFalse(image.open(small), "a file shorter than the PVD does not open");
+            t.IsFalse(image.lookup("\\DIR\\FILE.BIN;1").has_value(), "a closed image finds nothing");
+        });
+
+        tc.Run("IsoImage serves concurrent readers the right sectors", [](TestCase &t)
+        {
+            TempDir dir;
+            const std::filesystem::path path = writeIso(dir, "threads.iso", 0u);
+            IsoImage image;
+            t.IsTrue(image.open(path), "the ISO opens");
+            const std::vector<uint8_t> expected = fileBytes();
+            std::atomic<int> bad{0};
+            std::vector<std::thread> threads;
+            for (int thread = 0; thread < 4; ++thread)
+            {
+                threads.emplace_back([&, thread]()
+                {
+                    std::vector<uint8_t> sector(kSector);
+                    for (int i = 0; i < 200; ++i)
+                    {
+                        const bool readme = ((i + thread) & 1) != 0;
+                        if (!image.readSectors(readme ? kReadmeLsn : kFileLsn + 1u, 1u, sector.data()) ||
+                            (readme ? std::memcmp(sector.data(), kReadme.data(), kReadme.size())
+                                    : std::memcmp(sector.data(), expected.data() + kSector, kSector)) != 0)
+                            ++bad;
+                    }
+                });
+            }
+            for (std::thread &thread : threads)
+                thread.join();
+            t.Equals(bad.load(), 0, "every concurrent read returns its own sector");
+        });
+
+        tc.Run("IOP CDVD with an image: sceCdSearchFile and sceCdRead use the real LSNs", [](TestCase &t)
+        {
+            TempDir dir;
+            constexpr uint64_t prefix = 5u * kSector + 7u;
+            CdvdHost host;
+            host.cdRoot = dir.path; // holds only the image file: the virtual ISO could not answer
+            host.cdImage = writeIso(dir, "game.bin", prefix);
+            host.imageOffset = prefix;
+            CdvdHarness cd(host);
+
+            t.Equals(cd.searchFile("cdrom0:\\DIR\\FILE.BIN;1"), 1u, "sceCdSearchFile finds the file in the image");
+            t.Equals(cd.memory.read32(cd.resultAddress), kFileLsn, "sceCdSearchFile returns the real LSN");
+            t.Equals(cd.memory.read32(cd.resultAddress + 4u), kFileSize, "sceCdSearchFile returns the real size");
+            t.Equals(cd.memory.readString(cd.resultAddress + 8u, 16u), std::string("FILE.BIN"),
+                     "sceCdSearchFile returns the leaf name without ;1");
+            t.Equals(cd.searchFile("\\README.TXT;1"), 1u, "a path without device is searched on the disc");
+            t.Equals(cd.memory.read32(cd.resultAddress), kReadmeLsn, "README.TXT has its real LSN");
+            t.Equals(cd.searchFile("cdrom0:\\GAME.BIN;1"), 0u, "files of the host folder are not on the disc");
+
+            t.Equals(cd.read(kFileLsn, 3u), 1u, "sceCdRead of the file sectors succeeds");
+            const std::vector<uint8_t> expected = fileBytes();
+            const std::vector<uint8_t> read = cd.buffer(expected.size());
+            t.IsTrue(read == expected, "sceCdRead returns the file bytes from the image");
+            t.Equals(cd.read(16u, 1u), 1u, "sceCdRead of the PVD succeeds");
+            const std::vector<uint8_t> pvd = cd.buffer(6u);
+            t.IsTrue(pvd[0] == 1u && std::memcmp(pvd.data() + 1u, "CD001", 5u) == 0,
+                     "sector 16 is the image's own PVD");
+        });
+
+        tc.Run("IOP CDVD without an image keeps serving the virtual ISO of the folder", [](TestCase &t)
+        {
+            TempDir dir;
+            std::filesystem::create_directories(dir.path / "DATA");
+            const std::vector<uint8_t> expected = fileBytes();
+            writeFile(dir.path / "DATA" / "file.bin", expected);
+            CdvdHost host;
+            host.cdRoot = dir.path;
+            CdvdHarness cd(host);
+
+            t.Equals(cd.searchFile("cdrom0:\\DATA\\FILE.BIN;1"), 1u, "sceCdSearchFile finds the folder file");
+            const uint32_t lsn = cd.memory.read32(cd.resultAddress);
+            t.IsTrue(lsn >= 20u, "the virtual ISO places files after its directories");
+            t.Equals(cd.memory.read32(cd.resultAddress + 4u), kFileSize, "the size is the host file size");
+            t.Equals(cd.read(lsn, 3u), 1u, "sceCdRead of the virtual sectors succeeds");
+            t.IsTrue(cd.buffer(expected.size()) == expected, "sceCdRead returns the host file bytes");
+            t.Equals(cd.read(16u, 1u), 1u, "sceCdRead of the virtual PVD succeeds");
+            const std::vector<uint8_t> pvd = cd.buffer(6u);
+            t.IsTrue(pvd[0] == 1u && std::memcmp(pvd.data() + 1u, "CD001", 5u) == 0, "sector 16 is the virtual PVD");
+        });
+        tc.Run("PS2X_ISO sets the CD image read from a plain ISO (offset 0)", [](TestCase &t)
+        {
+            const PS2Runtime::IoPaths oldPaths = PS2Runtime::getIoPaths();
+            TempDir dir;
+            const std::filesystem::path elf = dir.path / "GAME.ELF";
+            const std::filesystem::path iso = dir.path / "game.iso";
+            PS2Runtime::IoPaths paths = oldPaths;
+            paths.cdImage.clear();
+            paths.cdImageOffset = 0u;
+            PS2Runtime::setIoPaths(paths);
+
+            _putenv_s("PS2X_ISO", "");
+            PS2Runtime::configureIoPathsFromElf(elf.string());
+            t.IsTrue(PS2Runtime::getIoPaths().cdImage.empty(), "without PS2X_ISO there is no CD image");
+
+            _putenv_s("PS2X_ISO", iso.string().c_str());
+            PS2Runtime::configureIoPathsFromElf(elf.string());
+            _putenv_s("PS2X_ISO", "");
+            t.Equals(PS2Runtime::getIoPaths().cdImage.lexically_normal().string(),
+                     std::filesystem::absolute(iso).lexically_normal().string(), "PS2X_ISO=<path> sets cdImage");
+            t.Equals(PS2Runtime::getIoPaths().cdImageOffset, uint64_t{0u}, "PS2X_ISO images start at offset 0");
+            t.Equals(PS2Runtime::getIoPaths().cdRoot.lexically_normal().string(),
+                     std::filesystem::absolute(dir.path).lexically_normal().string(),
+                     "PS2X_ISO leaves the CD root next to the ELF");
+
+            PS2Runtime::setIoPaths(oldPaths);
+        });
+    });
+}
