+#pragma once
+
+#include "ps2_netplay_protocol.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+// Fase 5 (T15, netplay N2): the host's picture, encoded with the FFmpeg the game already carries (LGPL DLLs, also used
+// by the .pss videos). No FFmpeg type leaves ps2_netplay_video.cpp. Without FFmpeg (PS2X_ENABLE_FFMPEG=OFF) nothing
+// opens and the netplay goes on without a picture.
+namespace ps2x::netplay
+{
+    // Whether this build carries FFmpeg.
+    bool videoAvailable();
+
+    // The encoders tried for a preference, in order: "auto" = h264_nvenc, h264_amf, h264_qsv (hardware), h264_mf
+    // (Media Foundation: the GPU's or Windows' own), mjpeg (always there). A single name = only that one.
+    std::vector<std::string> videoEncoderCandidates(const std::string &preference);
+    bool isVideoEncoderName(const std::string &name);
+
+    // The picture size for a source of sourceHeight lines shown at aspect (width / height): maxHeight lines at most
+    // (never more than the source has), the width from the aspect; both even and within the protocol's limits.
+    void videoOutputSize(uint32_t sourceHeight, float aspect, uint32_t maxHeight, uint16_t &width, uint16_t &height);
+
+    struct VideoEncoderSettings
+    {
+        uint16_t width = 960, height = 540;
+        uint16_t fps = 50;
+        uint32_t kbps = 8000;
+        std::string preference = "auto";
+        int keyIntervalPictures = 250; // a key picture at least this often (and whenever asked)
+    };
+
+    // Low-latency settings: no B pictures, no look-ahead, one picture in -> one packet out, constant bit rate with a
+    // small buffer (about two pictures).
+    class VideoEncoder
+    {
+    public:
+        VideoEncoder();
+        ~VideoEncoder();
+        VideoEncoder(const VideoEncoder &) = delete;
+        VideoEncoder &operator=(const VideoEncoder &) = delete;
+
+        // Opens the first candidate that works; tried lists every attempt ("h264_nvenc: <why>").
+        bool open(const VideoEncoderSettings &settings, std::string &error, std::vector<std::string> *tried = nullptr);
+        void close();
+        bool isOpen() const;
+        const std::string &encoderName() const;
+        VideoCodec codec() const;
+        const VideoEncoderSettings &settings() const;
+
+        // Scales an RGBA picture (any size) to the encoder's and encodes it. packets gets what the encoder gives back
+        // (normally one packet); key tells whether each is a key picture. False if the encoder failed.
+        struct Packet
+        {
+            std::vector<uint8_t> data;
+            bool key = false;
+        };
+        bool encode(const uint8_t *rgba, uint32_t width, uint32_t height, size_t stride, bool forceKey,
+                    std::vector<Packet> &packets, std::string &error);
+
+    private:
+        struct Impl;
+        std::unique_ptr<Impl> m_impl;
+    };
+
+    // The guest's decoder. Only pictures of the configured size come out (capped at kMaxVideoWidth x kMaxVideoHeight
+    // by the configuration itself and by the decoder's own pixel limit).
+    class VideoDecoder
+    {
+    public:
+        VideoDecoder();
+        ~VideoDecoder();
+        VideoDecoder(const VideoDecoder &) = delete;
+        VideoDecoder &operator=(const VideoDecoder &) = delete;
+
+        bool open(const VideoConfig &config, std::string &error);
+        void close();
+        bool isOpen() const;
+        // One whole picture -> RGBA (width * height * 4). False with error if it does not decode or has another size;
+        // true with got = false if the decoder gave nothing back for it.
+        bool decode(const uint8_t *data, size_t size, std::vector<uint8_t> &rgba, bool &got, std::string &error);
+
+    private:
+        struct Impl;
+        std::unique_ptr<Impl> m_impl;
+    };
+}
