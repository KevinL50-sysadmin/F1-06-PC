+                uint8_t *p = &rgba[(static_cast<size_t>(y) * width + x) * 4u];
+                const bool block = ((x / 64u) + (y / 64u) + seed) % 5u == 0u;
+                p[0] = block ? 230 : static_cast<uint8_t>(x * 255u / width);
+                p[1] = block ? 40 : static_cast<uint8_t>(y * 255u / height);
+                p[2] = block ? 60 : static_cast<uint8_t>((x + y + seed * 16u) & 0xFFu);
+                p[3] = 0x80;
+            }
+        return rgba;
+    }
+
+    // Mean absolute difference of the colour channels of two RGBA pictures of one size.
+    double meanDifference(const std::vector<uint8_t> &a, const std::vector<uint8_t> &b)
+    {
+        if (a.size() != b.size() || a.empty())
+            return 255.0;
+        uint64_t total = 0;
+        for (size_t i = 0; i < a.size(); i += 4)
+            for (size_t c = 0; c < 3; ++c)
+                total += static_cast<uint64_t>(std::abs(static_cast<int>(a[i + c]) - static_cast<int>(b[i + c])));
+        return static_cast<double>(total) / static_cast<double>(a.size() / 4u * 3u);
+    }
+
+    // Scales an RGBA picture (nearest) to compare it with what the guest got at another size.
+    std::vector<uint8_t> scaledNearest(const std::vector<uint8_t> &src, uint32_t sw, uint32_t sh, uint32_t dw,
+                                       uint32_t dh)
+    {
+        std::vector<uint8_t> out(static_cast<size_t>(dw) * dh * 4u);
+        for (uint32_t y = 0; y < dh; ++y)
+            for (uint32_t x = 0; x < dw; ++x)
+                std::memcpy(&out[(static_cast<size_t>(y) * dw + x) * 4u],
+                            &src[(static_cast<size_t>(y * sh / dh) * sw + x * sw / dw) * 4u], 4);
+        return out;
+    }
