+    void SendQueue::pushControl(MessageType type, const uint8_t *payload, size_t size)
+    {
+        Message m;
+        m.type = type;
+        m.payload.assign(payload, payload + size);
+        m_control.push_back(std::move(m));
+    }
+
+    void SendQueue::pushVideoConfig(const VideoConfig &config)
+    {
+        const auto bytes = encodeVideoConfig(config);
+        VideoItem item;
+        item.config = true;
+        Message m;
+        m.type = MessageType::VideoConfig;
+        m.payload.assign(bytes.begin(), bytes.end());
+        m.video = true;
+        item.messages.push_back(std::move(m));
+        m_video.push_back(std::move(item));
+    }
+
+    void SendQueue::pushPicture(std::vector<std::vector<uint8_t>> chunks, uint32_t picture)
+    {
+        if (chunks.empty())
+            return;
+        VideoItem item;
+        item.picture = picture;
+        item.messages.reserve(chunks.size());
+        for (std::vector<uint8_t> &chunk : chunks)
+        {
+            Message m;
+            m.type = MessageType::VideoChunk;
+            m.payload = std::move(chunk);
+            m.video = true;
+            item.messages.push_back(std::move(m));
+        }
+        m_video.push_back(std::move(item));
+    }
+
+    bool SendQueue::next(Message &out)
+    {
+        if (!m_control.empty())
+        {
+            out = std::move(m_control.front());
+            m_control.erase(m_control.begin());
+            return true;
+        }
+        if (m_video.empty())
+            return false;
+        VideoItem &item = m_video.front();
+        out = std::move(item.messages[item.sent++]);
+        m_inProgress = item.sent < item.messages.size();
+        if (!m_inProgress)
+            m_video.erase(m_video.begin());
+        return true;
+    }
+
+    bool SendQueue::empty() const
+    {
+        return m_control.empty() && m_video.empty();
+    }
+
+    size_t SendQueue::waitingPictures() const
+    {
+        size_t n = 0;
+        for (size_t i = 0; i < m_video.size(); ++i)
+            if (!m_video[i].config && !(i == 0 && m_inProgress))
+                ++n;
+        return n;
+    }
+
+    size_t SendQueue::dropWaitingPictures()
+    {
+        size_t dropped = 0;
+        std::vector<VideoItem> kept;
+        for (size_t i = 0; i < m_video.size(); ++i)
+        {
+            if (m_video[i].config || (i == 0 && m_inProgress))
+                kept.push_back(std::move(m_video[i]));
+            else
+                ++dropped;
+        }
+        m_video = std::move(kept);
+        return dropped;
+    }
+
+    void SendQueue::clear()
+    {
+        m_control.clear();
+        m_video.clear();
+        m_inProgress = false;
+    }
