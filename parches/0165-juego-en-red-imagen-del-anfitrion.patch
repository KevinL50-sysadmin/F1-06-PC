+            }
+            frame = av_frame_alloc();
+            packet = av_packet_alloc();
+            if (frame == nullptr || packet == nullptr)
+            {
+                why = "sin memoria";
+                release();
+                return false;
+            }
+            frame->format = ctx->pix_fmt;
+            frame->width = ctx->width;
+            frame->height = ctx->height;
+            frame->color_range = ctx->color_range;
+            frame->colorspace = ctx->colorspace;
+            const int buffer = av_frame_get_buffer(frame, 0);
+            if (buffer < 0)
+            {
+                why = avError(buffer);
+                release();
+                return false;
+            }
+            name = encoder;
+            codec = mjpeg ? VideoCodec::Mjpeg : VideoCodec::H264;
+            return true;
+        }
+    };
+
+    VideoEncoder::VideoEncoder() : m_impl(std::make_unique<Impl>()) {}
+
+    VideoEncoder::~VideoEncoder()
+    {
+        close();
+    }
+
+    bool VideoEncoder::open(const VideoEncoderSettings &settings, std::string &error, std::vector<std::string> *tried)
+    {
+        close();
+        if (settings.width < kMinVideoSide || settings.width > kMaxVideoWidth || settings.height < kMinVideoSide ||
+            settings.height > kMaxVideoHeight || (settings.width & 1u) != 0 || (settings.height & 1u) != 0)
+        {
+            error = "tamano de imagen no valido: " + std::to_string(settings.width) + "x" +
+                    std::to_string(settings.height);
+            return false;
+        }
+        m_impl->settings = settings;
+        const std::vector<std::string> candidates = videoEncoderCandidates(settings.preference);
+        if (candidates.empty())
+        {
+            error = "codificador desconocido: " + settings.preference;
+            return false;
+        }
+        std::string all;
+        for (const std::string &name : candidates)
+        {
+            std::string why;
+            const AVCodec *c = avcodec_find_encoder_by_name(name.c_str());
+            if (c == nullptr)
+                why = "no esta en esta version de FFmpeg";
+            else if (m_impl->tryOpen(c, name, why))
+                return true;
+            if (tried != nullptr)
+                tried->push_back(name + ": " + why);
+            all += (all.empty() ? "" : "; ") + name + ": " + why;
+        }
+        error = "ningun codificador abre (" + all + ")";
+        return false;
+    }
+
+    void VideoEncoder::close()
+    {
+        m_impl->release();
+    }
+
+    bool VideoEncoder::isOpen() const
+    {
+        return m_impl->ctx != nullptr;
+    }
+
+    const std::string &VideoEncoder::encoderName() const
+    {
+        return m_impl->name;
+    }
+
+    VideoCodec VideoEncoder::codec() const
+    {
+        return m_impl->codec;
+    }
+
+    const VideoEncoderSettings &VideoEncoder::settings() const
+    {
+        return m_impl->settings;
+    }
+
+    bool VideoEncoder::encode(const uint8_t *rgba, uint32_t width, uint32_t height, size_t stride, bool forceKey,
+                              std::vector<Packet> &packets, std::string &error)
+    {
+        Impl &m = *m_impl;
+        if (m.ctx == nullptr)
+        {
+            error = "codificador cerrado";
+            return false;
+        }
+        if (rgba == nullptr || width == 0 || height == 0 || width > kMaxSourceSide || height > kMaxSourceSide ||
+            stride < static_cast<size_t>(width) * 4u || stride > static_cast<size_t>(INT32_MAX))
+        {
+            error = "imagen de origen no valida";
+            return false;
+        }
+        m.sws = sws_getCachedContext(m.sws, static_cast<int>(width), static_cast<int>(height), AV_PIX_FMT_RGBA,
+                                     m.ctx->width, m.ctx->height, m.ctx->pix_fmt, SWS_BILINEAR, nullptr, nullptr,
+                                     nullptr);
+        if (m.sws == nullptr)
+        {
+            error = "no se puede escalar la imagen";
+            return false;
+        }
+        const int *coefficients = sws_getCoefficients(SWS_CS_ITU601);
+        sws_setColorspaceDetails(m.sws, coefficients, 1, coefficients, m.ctx->color_range == AVCOL_RANGE_JPEG ? 1 : 0,
+                                 0, 1 << 16, 1 << 16);
+        const int writable = av_frame_make_writable(m.frame);
+        if (writable < 0)
+        {
+            error = avError(writable);
+            return false;
+        }
+        const uint8_t *src[4] = {rgba, nullptr, nullptr, nullptr};
+        const int srcStride[4] = {static_cast<int>(stride), 0, 0, 0};
+        sws_scale(m.sws, src, srcStride, 0, static_cast<int>(height), m.frame->data, m.frame->linesize);
+        m.frame->pts = m.pts++;
+        m.frame->pict_type = forceKey ? AV_PICTURE_TYPE_I : AV_PICTURE_TYPE_NONE;
+        if (forceKey)
+            m.frame->flags |= AV_FRAME_FLAG_KEY;
+        else
+            m.frame->flags &= ~AV_FRAME_FLAG_KEY;
+        const int sent = avcodec_send_frame(m.ctx, m.frame);
+        if (sent < 0)
+        {
+            error = "el codificador " + m.name + " falla: " + avError(sent);
+            return false;
+        }
+        for (;;)
+        {
+            const int got = avcodec_receive_packet(m.ctx, m.packet);
+            if (got == AVERROR(EAGAIN) || got == AVERROR_EOF)
+                break;
+            if (got < 0)
+            {
+                error = "el codificador " + m.name + " falla: " + avError(got);
+                return false;
+            }
+            Packet p;
+            p.key = (m.packet->flags & AV_PKT_FLAG_KEY) != 0;
+            // A key picture must open the decoder on its own: its parameter sets in front if the encoder keeps them
+            // apart (extradata).
+            if (p.key && m.codec == VideoCodec::H264 && m.ctx->extradata_size > 0 &&
+                !hasSequenceHeader(m.packet->data, static_cast<size_t>(m.packet->size)))
+                p.data.assign(m.ctx->extradata, m.ctx->extradata + m.ctx->extradata_size);
+            p.data.insert(p.data.end(), m.packet->data, m.packet->data + m.packet->size);
+            packets.push_back(std::move(p));
+            av_packet_unref(m.packet);
+        }
+        return true;
+    }
+
+    struct VideoDecoder::Impl
+    {
+        VideoConfig config;
+        AVCodecContext *ctx = nullptr;
+        AVFrame *frame = nullptr;
+        AVPacket *packet = nullptr;
+        SwsContext *sws = nullptr;
+
+        void release()
+        {
+            sws_freeContext(sws);
+            sws = nullptr;
+            av_packet_free(&packet);
+            av_frame_free(&frame);
+            avcodec_free_context(&ctx);
+        }
+    };
+
+    VideoDecoder::VideoDecoder() : m_impl(std::make_unique<Impl>()) {}
+
+    VideoDecoder::~VideoDecoder()
+    {
+        close();
+    }
+
+    bool VideoDecoder::open(const VideoConfig &config, std::string &error)
+    {
+        close();
+        // The same checks as on the wire, whoever builds the config.
+        const auto bytes = encodeVideoConfig(config);
+        VideoConfig checked;
+        if (!decodeVideoConfig(bytes.data(), bytes.size(), checked, error))
+            return false;
+        const AVCodec *c = avcodec_find_decoder(config.codec == static_cast<uint8_t>(VideoCodec::Mjpeg)
+                                                    ? AV_CODEC_ID_MJPEG
+                                                    : AV_CODEC_ID_H264);
+        if (c == nullptr)
+        {
+            error = std::string("no hay decodificador ") + videoCodecName(config.codec);
+            return false;
+        }
+        Impl &m = *m_impl;
+        m.ctx = avcodec_alloc_context3(c);
+        m.frame = av_frame_alloc();
+        m.packet = av_packet_alloc();
+        if (m.ctx == nullptr || m.frame == nullptr || m.packet == nullptr)
+        {
+            error = "sin memoria";
+            m.release();
+            return false;
+        }
+        // One picture in, one out (no frame threads, which hold pictures back), and no picture larger than the
+        // configuration allows, whatever the bitstream says.
+        m.ctx->flags |= AV_CODEC_FLAG_LOW_DELAY;
+        m.ctx->thread_count = 1;
+        m.ctx->max_pixels = static_cast<int64_t>(kMaxVideoWidth) * kMaxVideoHeight;
+        m.ctx->width = config.width;
+        m.ctx->height = config.height;
+        const int opened = avcodec_open2(m.ctx, c, nullptr);
+        if (opened < 0)
+        {
+            error = avError(opened);
+            m.release();
+            return false;
+        }
+        m.config = config;
+        return true;
+    }
+
+    void VideoDecoder::close()
+    {
+        m_impl->release();
+    }
+
+    bool VideoDecoder::isOpen() const
+    {
+        return m_impl->ctx != nullptr;
+    }
+
+    bool VideoDecoder::decode(const uint8_t *data, size_t size, std::vector<uint8_t> &rgba, bool &got,
+                              std::string &error)
+    {
+        Impl &m = *m_impl;
+        got = false;
+        if (m.ctx == nullptr)
+        {
+            error = "decodificador cerrado";
+            return false;
+        }
+        if (data == nullptr || size == 0 || size > kMaxVideoPictureBytes)
+        {
+            error = "imagen codificada de tamano no valido";
+            return false;
+        }
+        const int made = av_new_packet(m.packet, static_cast<int>(size)); // zeroed padding after the data
+        if (made < 0)
+        {
+            error = avError(made);
+            return false;
+        }
+        std::memcpy(m.packet->data, data, size);
+        const int sent = avcodec_send_packet(m.ctx, m.packet);
+        av_packet_unref(m.packet);
+        if (sent < 0)
+        {
+            error = "imagen que no se puede decodificar: " + avError(sent);
+            return false;
+        }
+        for (;;)
+        {
+            const int received = avcodec_receive_frame(m.ctx, m.frame);
+            if (received == AVERROR(EAGAIN) || received == AVERROR_EOF)
+                break;
+            if (received < 0)
+            {
+                error = "imagen que no se puede decodificar: " + avError(received);
+                return false;
+            }
+            const int w = m.frame->width, h = m.frame->height;
+            if (w != m.config.width || h != m.config.height)
+            {
+                error = "imagen de " + std::to_string(w) + "x" + std::to_string(h) + " en una secuencia de " +
+                        std::to_string(m.config.width) + "x" + std::to_string(m.config.height);
+                av_frame_unref(m.frame);
+                return false;
+            }
+            m.sws = sws_getCachedContext(m.sws, w, h, static_cast<AVPixelFormat>(m.frame->format), w, h,
+                                         AV_PIX_FMT_RGBA, SWS_BILINEAR, nullptr, nullptr, nullptr);
+            if (m.sws == nullptr)
+            {
+                error = "formato de imagen decodificada no valido";
+                av_frame_unref(m.frame);
+                return false;
+            }
+            const bool fullRange = m.frame->color_range == AVCOL_RANGE_JPEG ||
+                                   m.frame->format == AV_PIX_FMT_YUVJ420P;
+            const int *coefficients = sws_getCoefficients(SWS_CS_ITU601);
+            sws_setColorspaceDetails(m.sws, coefficients, fullRange ? 1 : 0, coefficients, 1, 0, 1 << 16, 1 << 16);
+            rgba.resize(static_cast<size_t>(w) * h * 4u);
+            uint8_t *dst[4] = {rgba.data(), nullptr, nullptr, nullptr};
+            const int dstStride[4] = {w * 4, 0, 0, 0};
+            sws_scale(m.sws, m.frame->data, m.frame->linesize, 0, h, dst, dstStride);
+            av_frame_unref(m.frame);
+            got = true;
+        }
+        return true;
+    }
+#else
+    bool videoAvailable()
+    {
+        return false;
+    }
+
+    struct VideoEncoder::Impl
+    {
+        VideoEncoderSettings settings;
+        std::string name;
+    };
+    VideoEncoder::VideoEncoder() : m_impl(std::make_unique<Impl>()) {}
+    VideoEncoder::~VideoEncoder() = default;
+    bool VideoEncoder::open(const VideoEncoderSettings &settings, std::string &error, std::vector<std::string> *)
+    {
+        m_impl->settings = settings;
+        error = "esta compilacion no lleva FFmpeg";
+        return false;
+    }
+    void VideoEncoder::close() {}
+    bool VideoEncoder::isOpen() const { return false; }
+    const std::string &VideoEncoder::encoderName() const { return m_impl->name; }
+    VideoCodec VideoEncoder::codec() const { return VideoCodec::H264; }
+    const VideoEncoderSettings &VideoEncoder::settings() const { return m_impl->settings; }
+    bool VideoEncoder::encode(const uint8_t *, uint32_t, uint32_t, size_t, bool, std::vector<Packet> &,
+                              std::string &error)
+    {
+        error = "esta compilacion no lleva FFmpeg";
+        return false;
+    }
+
+    struct VideoDecoder::Impl
+    {
+    };
+    VideoDecoder::VideoDecoder() : m_impl(std::make_unique<Impl>()) {}
+    VideoDecoder::~VideoDecoder() = default;
+    bool VideoDecoder::open(const VideoConfig &, std::string &error)
+    {
+        error = "esta compilacion no lleva FFmpeg";
+        return false;
+    }
+    void VideoDecoder::close() {}
+    bool VideoDecoder::isOpen() const { return false; }
+    bool VideoDecoder::decode(const uint8_t *, size_t, std::vector<uint8_t> &, bool &got, std::string &error)
+    {
+        got = false;
+        error = "esta compilacion no lleva FFmpeg";
+        return false;
+    }
+#endif
+}
