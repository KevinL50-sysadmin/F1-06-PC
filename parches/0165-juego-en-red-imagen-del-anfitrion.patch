+
+    bool VideoAssembler::configure(const uint8_t *payload, size_t size)
+    {
+        VideoConfig config;
+        if (!decodeVideoConfig(payload, size, config, m_why))
+            return false;
+        if (config.stream <= m_config.stream)
+        {
+            m_why = "la secuencia de imagen no avanza (" + std::to_string(config.stream) + ")";
+            return false;
+        }
+        if (m_inPicture)
+        {
+            ++m_lost; // the host gave up on it
+            m_inPicture = false;
+            m_data.clear();
+        }
+        m_config = config;
+        return true;
+    }
+
+    VideoAssembler::Result VideoAssembler::add(const uint8_t *payload, size_t size, VideoPicture &out)
+    {
+        if (m_config.stream == 0)
+            return fail("trozo de imagen antes de su configuracion");
+        if (payload == nullptr || size <= kVideoChunkHeaderSize || size > kVideoChunkHeaderSize + kMaxVideoChunkData)
+            return fail("trozo de imagen de tamano no valido");
+        const VideoChunkHeader h = decodeChunkHeader(payload);
+        const size_t dataSize = size - kVideoChunkHeaderSize;
+        if (h.stream != static_cast<uint16_t>(m_config.stream & 0xFFFFu))
+            return fail("trozo de otra secuencia de imagen");
+        if ((h.flags & ~kVideoKeyPicture) != 0 || payload[7] != 0)
+            return fail("banderas del trozo de imagen no validas");
+        if (h.pictureSize == 0 || h.pictureSize > kMaxVideoPictureBytes)
+            return fail("imagen de tamano no valido: " + std::to_string(h.pictureSize));
+        if (h.count == 0 || h.count > kMaxVideoChunks || h.count != chunksFor(h.pictureSize) || h.index >= h.count)
+            return fail("numero de trozos no valido");
+        const size_t expectedData =
+            h.index + 1u < h.count ? kMaxVideoChunkData
+                                   : h.pictureSize - static_cast<size_t>(h.count - 1u) * kMaxVideoChunkData;
+        if (dataSize != expectedData)
+            return fail("trozo de imagen de longitud no valida");
+        if (h.index == 0)
+        {
+            if (m_anyPicture && h.picture <= m_lastPicture)
+                return fail("numero de imagen que no avanza");
+            if (m_inPicture)
+                ++m_lost; // the host dropped the rest of the previous one
+            m_inPicture = true;
+            m_current = h;
+            m_data.clear();
+            m_data.reserve(h.pictureSize);
+            m_anyPicture = true;
+            m_lastPicture = h.picture;
+        }
+        else
+        {
+            if (!m_inPicture || h.picture != m_current.picture || h.index != m_current.index + 1u ||
+                h.count != m_current.count || h.pictureSize != m_current.pictureSize || h.flags != m_current.flags ||
+                h.captureMs != m_current.captureMs)
+                return fail("trozo de imagen fuera de orden");
+            m_current.index = h.index;
+        }
+        m_data.insert(m_data.end(), payload + kVideoChunkHeaderSize, payload + size);
+        if (h.index + 1u < h.count)
+            return Result::NeedMore;
+
+        // Gap: a picture lost since the last whole one (dropped unfinished, or numbers skipped by the host).
+        const uint64_t skipped = m_anyWhole ? static_cast<uint64_t>(h.picture - m_lastWhole - 1u) : 0u;
+        const uint64_t lostBefore = m_lost;
+        m_lost += skipped;
+        m_gap = skipped > 0 || lostBefore != m_lostAtWhole;
+        m_lostAtWhole = m_lost;
+        m_anyWhole = true;
+        m_lastWhole = h.picture;
+        m_inPicture = false;
+        out.picture = h.picture;
+        out.key = (h.flags & kVideoKeyPicture) != 0;
+        out.captureMs = h.captureMs;
+        out.encodeMs = h.encodeMs;
+        out.latencyMs = h.latencyMs;
+        out.data = std::move(m_data);
+        m_data.clear();
+        return Result::Picture;
+    }
