+    std::array<uint8_t, kVideoConfigPayloadSize> encodeVideoConfig(const VideoConfig &config)
+    {
+        std::array<uint8_t, kVideoConfigPayloadSize> out{};
+        out[0] = config.codec;
+        put16(out.data() + 2, config.width);
+        put16(out.data() + 4, config.height);
+        put16(out.data() + 6, config.fps);
+        put32(out.data() + 8, config.kbps);
+        put32(out.data() + 12, config.stream);
+        return out;
+    }
+
+    bool decodeVideoConfig(const uint8_t *payload, size_t size, VideoConfig &config, std::string &why)
+    {
+        if (payload == nullptr || size != kVideoConfigPayloadSize)
+        {
+            why = "configuracion de imagen de tamano no valido";
+            return false;
+        }
+        VideoConfig c;
+        c.codec = payload[0];
+        c.width = get16(payload + 2);
+        c.height = get16(payload + 4);
+        c.fps = get16(payload + 6);
+        c.kbps = get32(payload + 8);
+        c.stream = get32(payload + 12);
+        if (c.codec != static_cast<uint8_t>(VideoCodec::H264) && c.codec != static_cast<uint8_t>(VideoCodec::Mjpeg))
+            why = "codec de imagen desconocido (" + std::to_string(c.codec) + ")";
+        else if (payload[1] != 0)
+            why = "byte reservado de la configuracion de imagen";
+        else if (c.width < kMinVideoSide || c.width > kMaxVideoWidth || c.height < kMinVideoSide ||
+                 c.height > kMaxVideoHeight || (c.width & 1u) != 0 || (c.height & 1u) != 0)
+            why = "tamano de imagen no valido: " + std::to_string(c.width) + "x" + std::to_string(c.height);
+        else if (c.fps < 1 || c.fps > 120)
+            why = "imagenes por segundo no validas: " + std::to_string(c.fps);
+        else if (c.kbps < 100 || c.kbps > 100000)
+            why = "tasa de bits no valida: " + std::to_string(c.kbps);
+        else if (c.stream == 0)
+            why = "numero de secuencia de imagen 0";
+        else
+        {
+            config = c;
+            return true;
+        }
+        return false;
+    }
+
+    namespace
+    {
+        std::vector<uint8_t> encodeChunkHeader(const VideoChunkHeader &h)
+        {
+            std::vector<uint8_t> out(kVideoChunkHeaderSize, 0);
+            put16(out.data(), h.stream);
+            put16(out.data() + 2, h.index);
+            put16(out.data() + 4, h.count);
+            out[6] = h.flags;
+            put32(out.data() + 8, h.picture);
+            put32(out.data() + 12, h.pictureSize);
+            put32(out.data() + 16, h.captureMs);
+            put16(out.data() + 20, h.encodeMs);
+            put16(out.data() + 22, h.latencyMs);
+            return out;
+        }
+
+        VideoChunkHeader decodeChunkHeader(const uint8_t *in)
+        {
+            VideoChunkHeader h;
+            h.stream = get16(in);
+            h.index = get16(in + 2);
+            h.count = get16(in + 4);
+            h.flags = in[6];
+            h.picture = get32(in + 8);
+            h.pictureSize = get32(in + 12);
+            h.captureMs = get32(in + 16);
+            h.encodeMs = get16(in + 20);
+            h.latencyMs = get16(in + 22);
+            return h;
+        }
+
+        size_t chunksFor(size_t pictureSize)
+        {
+            return (pictureSize + kMaxVideoChunkData - 1) / kMaxVideoChunkData;
+        }
+    }
+
+    std::vector<std::vector<uint8_t>> chunkVideoPicture(const VideoPicture &picture, uint32_t stream)
+    {
+        const size_t size = picture.data.size();
+        if (size == 0 || size > kMaxVideoPictureBytes)
+            return {};
+        VideoChunkHeader h;
+        h.stream = static_cast<uint16_t>(stream & 0xFFFFu);
+        h.count = static_cast<uint16_t>(chunksFor(size));
+        h.flags = picture.key ? kVideoKeyPicture : 0;
+        h.picture = picture.picture;
+        h.pictureSize = static_cast<uint32_t>(size);
+        h.captureMs = picture.captureMs;
+        h.encodeMs = picture.encodeMs;
+        h.latencyMs = picture.latencyMs;
+        std::vector<std::vector<uint8_t>> chunks;
+        chunks.reserve(h.count);
+        for (uint16_t i = 0; i < h.count; ++i)
+        {
+            h.index = i;
+            std::vector<uint8_t> chunk = encodeChunkHeader(h);
+            const size_t at = static_cast<size_t>(i) * kMaxVideoChunkData;
+            const size_t n = std::min(kMaxVideoChunkData, size - at);
+            chunk.insert(chunk.end(), picture.data.begin() + static_cast<std::ptrdiff_t>(at),
+                         picture.data.begin() + static_cast<std::ptrdiff_t>(at + n));
+            chunks.push_back(std::move(chunk));
+        }
+        return chunks;
+    }
