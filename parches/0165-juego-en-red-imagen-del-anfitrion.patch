+    void videoOutputSize(uint32_t sourceHeight, float aspect, uint32_t maxHeight, uint16_t &width, uint16_t &height)
+    {
+        if (!(aspect > 0.25f && aspect < 8.0f))
+            aspect = 4.0f / 3.0f;
+        uint32_t h = std::min<uint32_t>(maxHeight, sourceHeight != 0 ? sourceHeight : maxHeight);
+        h = std::clamp<uint32_t>(h, kMinVideoSide, kMaxVideoHeight) & ~1u;
+        uint32_t w = static_cast<uint32_t>(std::lround(h * static_cast<double>(aspect) / 2.0)) * 2u;
+        if (w > kMaxVideoWidth)
+        {
+            w = kMaxVideoWidth;
+            h = static_cast<uint32_t>(std::lround(w / static_cast<double>(aspect) / 2.0)) * 2u;
+            h = std::clamp<uint32_t>(h, kMinVideoSide, kMaxVideoHeight) & ~1u;
+        }
+        w = std::max<uint32_t>(w, kMinVideoSide);
