diff --git a/ps2xTest/src/ps2_vigilante_tests.cpp b/ps2xTest/src/ps2_vigilante_tests.cpp
new file mode 100644
index 0000000..791d21e
--- /dev/null
+++ b/ps2xTest/src/ps2_vigilante_tests.cpp
@@ -0,0 +1,365 @@
+#include "MiniTest.h"
+#include "ps2_options.h"
+#include "ps2_vigilante.h"
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace
+{
+    using ps2x::vigilante::Aviso;
+    using ps2x::vigilante::Detector;
+    using ps2x::vigilante::Suceso;
+
+    // One heartbeat: samples (time, counter) in order; returns every event of the last one.
+    std::vector<Aviso> sample(Detector &detector, double now, uint64_t counter)
+    {
+        return detector.muestra(now, &counter);
+    }
+
+    // A heartbeat that advances once per second from t = 0 to t = last (so its last change is at t = last).
+    void advanceUntil(Detector &detector, int last, std::vector<Aviso> &all)
+    {
+        for (int t = 0; t <= last; ++t)
+            for (const Aviso &aviso : sample(detector, t, static_cast<uint64_t>(t)))
+                all.push_back(aviso);
+    }
+}
+
+void register_ps2_vigilante_tests()
+{
+    MiniTest::Case("Vigilante", [](TestCase &tc)
+    {
+        tc.Run("no event while the heartbeat advances", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 120, all);
+            t.Equals(all.size(), size_t{0u}, "two minutes advancing: nothing");
+        });
+
+        tc.Run("one parado event exactly at the threshold, none just below", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 5, all); // last change at t = 5
+            t.Equals(sample(detector, 14.0, 5u).size(), size_t{0u}, "9 s stalled: nothing");
+            t.Equals(sample(detector, 14.999, 5u).size(), size_t{0u}, "just below 10 s: nothing");
+            const std::vector<Aviso> at = sample(detector, 15.0, 5u);
+            t.Equals(at.size(), size_t{1u}, "10 s stalled: one event");
+            if (at.size() == 1u)
+            {
+                t.Equals(at[0].latido, size_t{0u}, "of the heartbeat 0");
+                t.IsTrue(at[0].suceso == Suceso::Parado, "parado");
+                t.Equals(at[0].segundos, 10.0, "stalled for 10 s");
+            }
+        });
+
+        tc.Run("a sample after the threshold fires once with the stall so far", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 5, all);
+            t.Equals(sample(detector, 13.0, 5u).size(), size_t{0u}, "8 s: nothing");
+            const std::vector<Aviso> late = sample(detector, 17.5, 5u);
+            t.Equals(late.size(), size_t{1u}, "12.5 s (samples late): one event");
+            if (late.size() == 1u)
+                t.Equals(late[0].segundos, 12.5, "with the 12.5 s");
+        });
+
+        tc.Run("no repeat while still stalled", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 5, all);
+            size_t events = 0u;
+            for (int s = 6; s <= 600; ++s)
+                events += sample(detector, s, 5u).size();
+            t.Equals(events, size_t{1u}, "almost ten minutes stalled: one event");
+        });
+
+        tc.Run("a recovery after a reported stall gives one sigue event with its duration", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 5, all);
+            for (int s = 6; s <= 30; ++s)
+                sample(detector, s, 5u);
+            const std::vector<Aviso> back = sample(detector, 31.0, 6u);
+            t.Equals(back.size(), size_t{1u}, "it advances: one event");
+            if (back.size() == 1u)
+            {
+                t.IsTrue(back[0].suceso == Suceso::Sigue, "sigue");
+                t.Equals(back[0].latido, size_t{0u}, "of the heartbeat 0");
+                t.Equals(back[0].segundos, 26.0, "after 26 s (from t = 5 to t = 31)");
+            }
+            t.Equals(sample(detector, 32.0, 7u).size(), size_t{0u}, "and then nothing while it advances");
+        });
+
+        tc.Run("a short stall below the threshold gives no sigue event", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 5, all);
+            for (int s = 6; s <= 14; ++s)
+                sample(detector, s, 5u);
+            t.Equals(sample(detector, 14.5, 6u).size(), size_t{0u}, "9.5 s stalled, then advances: nothing");
+        });
+
+        tc.Run("a second stall after a recovery fires again", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 5, all);
+            t.Equals(sample(detector, 15.0, 5u).size(), size_t{1u}, "first stall");
+            t.Equals(sample(detector, 16.0, 6u).size(), size_t{1u}, "recovery");
+            t.Equals(sample(detector, 25.0, 6u).size(), size_t{0u}, "9 s into the second stall: nothing");
+            const std::vector<Aviso> again = sample(detector, 26.0, 6u);
+            t.Equals(again.size(), size_t{1u}, "10 s into the second stall: one event");
+            if (again.size() == 1u)
+            {
+                t.IsTrue(again[0].suceso == Suceso::Parado, "parado again");
+                t.Equals(again[0].segundos, 10.0, "counted from the recovery");
+            }
+        });
+
+        tc.Run("a heartbeat that never advanced is silent", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            size_t events = 0u;
+            for (int s = 0; s <= 300; ++s)
+                events += sample(detector, s, 0u).size();
+            t.Equals(events, size_t{0u}, "never advanced from 0: nothing");
+
+            Detector started(1u, 10);
+            events = 0u;
+            for (int s = 0; s <= 300; ++s)
+                events += sample(started, s, 1234u).size();
+            t.Equals(events, size_t{0u}, "stuck at its first value (not 0): nothing either");
+        });
+
+        tc.Run("threshold 0 is off", [](TestCase &t)
+        {
+            Detector detector(1u, 0);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 5, all);
+            size_t events = 0u;
+            for (int s = 6; s <= 600; ++s)
+                events += sample(detector, s, 5u).size();
+            events += sample(detector, 601.0, 6u).size();
+            t.Equals(all.size() + events, size_t{0u}, "no stall and no recovery");
+        });
+
+        tc.Run("two heartbeats are independent", [](TestCase &t)
+        {
+            Detector detector(2u, 10);
+            uint64_t counters[2] = {0u, 0u};
+            std::vector<Aviso> all;
+            for (int s = 0; s <= 5; ++s)
+            {
+                counters[0] = counters[1] = static_cast<uint64_t>(s);
+                for (const Aviso &aviso : detector.muestra(s, counters))
+                    all.push_back(aviso);
+            }
+            // The second one (the window) stalls at t = 5; the first (EE) keeps going.
+            for (int s = 6; s <= 20; ++s)
+            {
+                counters[0] = static_cast<uint64_t>(s);
+                for (const Aviso &aviso : detector.muestra(s, counters))
+                    all.push_back(aviso);
+            }
+            t.Equals(all.size(), size_t{1u}, "one event");
+            if (all.size() == 1u)
+            {
+                t.Equals(all[0].latido, size_t{1u}, "of the stalled heartbeat only");
+                t.IsTrue(all[0].suceso == Suceso::Parado, "parado");
+            }
+            counters[1] = 99u;
+            const std::vector<Aviso> back = detector.muestra(21.0, counters);
+            t.Equals(back.size(), size_t{1u}, "its recovery");
+            if (back.size() == 1u)
+            {
+                t.Equals(back[0].latido, size_t{1u}, "of the same heartbeat");
+                t.IsTrue(back[0].suceso == Suceso::Sigue, "sigue");
+                t.Equals(back[0].segundos, 16.0, "after 16 s");
+            }
+        });
+
+        tc.Run("an excused stall (minimized window) is silent and counts from the end of the excuse", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 5, all);
+            const bool excused = true;
+            size_t events = 0u;
+            for (int s = 6; s <= 100; ++s)
+            {
+                uint64_t counter = 5u;
+                events += detector.muestra(s, &counter, &excused).size();
+            }
+            t.Equals(events, size_t{0u}, "95 s stalled while excused: nothing");
+            t.Equals(sample(detector, 109.0, 5u).size(), size_t{0u}, "9 s after the excuse: nothing");
+            const std::vector<Aviso> at = sample(detector, 110.0, 5u);
+            t.Equals(at.size(), size_t{1u}, "10 s after the excuse: one event");
+            if (at.size() == 1u)
+            {
+                t.IsTrue(at[0].suceso == Suceso::Parado, "parado");
+                t.Equals(at[0].segundos, 10.0, "counted from the last excused sample");
+            }
+
+            Detector restored(1u, 10);
+            advanceUntil(restored, 5, all);
+            for (int s = 6; s <= 60; ++s)
+            {
+                uint64_t counter = 5u;
+                restored.muestra(s, &counter, &excused);
+            }
+            t.Equals(sample(restored, 61.0, 6u).size(), size_t{0u}, "it advances after the excuse: no sigue");
+        });
+
+        tc.Run("an excused heartbeat that advances while excused gives no sigue", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 5, all);
+            const bool excused = true;
+            for (int s = 6; s <= 20; ++s)
+            {
+                uint64_t counter = static_cast<uint64_t>(s);
+                for (const Aviso &aviso : detector.muestra(s, &counter, &excused))
+                    all.push_back(aviso);
+            }
+            for (int s = 21; s <= 29; ++s)
+                for (const Aviso &aviso : sample(detector, s, 20u))
+                    all.push_back(aviso);
+            t.Equals(all.size(), size_t{0u}, "advancing while excused, then 9 s stalled: nothing");
+            const std::vector<Aviso> at = sample(detector, 30.0, 20u);
+            t.Equals(at.size(), size_t{1u}, "10 s stalled without excuse: one event");
+            if (at.size() == 1u)
+            {
+                t.IsTrue(at[0].suceso == Suceso::Parado, "parado");
+                t.Equals(at[0].segundos, 10.0, "stalled for 10 s");
+            }
+        });
+
+        tc.Run("threshold 3 fires at exactly 3.0 s", [](TestCase &t)
+        {
+            Detector detector(1u, 3);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 5, all);
+            t.Equals(sample(detector, 7.999, 5u).size(), size_t{0u}, "just below 3 s: nothing");
+            const std::vector<Aviso> at = sample(detector, 8.0, 5u);
+            t.Equals(all.size() + at.size(), size_t{1u}, "3 s stalled: one event");
+            if (at.size() == 1u)
+                t.Equals(at[0].segundos, 3.0, "stalled for 3 s");
+        });
+
+        tc.Run("an excuse does not hide a stall already reported", [](TestCase &t)
+        {
+            Detector detector(1u, 10);
+            std::vector<Aviso> all;
+            advanceUntil(detector, 5, all);
+            t.Equals(sample(detector, 15.0, 5u).size(), size_t{1u}, "stall reported");
+            const bool excused = true;
+            size_t events = 0u;
+            for (int s = 16; s <= 30; ++s)
+            {
+                uint64_t counter = 5u;
+                events += detector.muestra(s, &counter, &excused).size();
+            }
+            t.Equals(events, size_t{0u}, "minimized while stalled: nothing more");
+            const std::vector<Aviso> back = sample(detector, 31.0, 6u);
+            t.Equals(back.size(), size_t{1u}, "it advances: one event");
+            if (back.size() == 1u)
+            {
+                t.IsTrue(back[0].suceso == Suceso::Sigue, "sigue");
+                t.Equals(back[0].segundos, 26.0, "with the whole stall (from t = 5 to t = 31)");
+            }
+        });
+
+        tc.Run("only the excused heartbeat is excused", [](TestCase &t)
+        {
+            Detector detector(2u, 10);
+            uint64_t counters[2] = {0u, 0u};
+            const bool excused[2] = {false, true};
+            std::vector<Aviso> all;
+            for (int s = 0; s <= 5; ++s)
+            {
+                counters[0] = counters[1] = static_cast<uint64_t>(s);
+                detector.muestra(s, counters, excused);
+            }
+            for (int s = 6; s <= 30; ++s)
+                for (const Aviso &aviso : detector.muestra(s, counters, excused))
+                    all.push_back(aviso);
+            t.Equals(all.size(), size_t{1u}, "both stalled: one event");
+            if (all.size() == 1u)
+            {
+                t.Equals(all[0].latido, size_t{0u}, "of the heartbeat that is not excused");
+                t.IsTrue(all[0].suceso == Suceso::Parado, "parado");
+            }
+        });
+
+        tc.Run("the option value is read as whole seconds", [](TestCase &t)
+        {
+            using ps2x::vigilante::leerUmbral;
+            t.Equals(leerUmbral(nullptr), 10, "unset: 10");
+            t.Equals(leerUmbral(""), 10, "empty: 10");
+            t.Equals(leerUmbral("abc"), 10, "not a number: 10");
+            t.Equals(leerUmbral("12s"), 10, "trailing letters: 10");
+            t.Equals(leerUmbral("-5"), 10, "negative: 10");
+            t.Equals(leerUmbral("0"), 0, "0: off");
+            // The same values as opciones.ini: 0 or 3 to 600; anything else is the default, like an invalid value.
+            t.Equals(leerUmbral("1"), 10, "1: not accepted, 10");
+            t.Equals(leerUmbral("2"), 10, "2: not accepted, 10");
+            t.Equals(leerUmbral("3"), 3, "3");
+            t.Equals(leerUmbral("10"), 10, "10");
+            t.Equals(leerUmbral(" 30 "), 30, "spaces around: 30");
+            t.Equals(leerUmbral("600"), 600, "600");
+            t.Equals(leerUmbral("601"), 10, "601: not accepted, 10");
+            t.Equals(leerUmbral("700"), 10, "700: not accepted, 10");
+            t.Equals(leerUmbral("99999999999999999999"), 10, "huge: 10");
+        });
+
+        tc.Run("the vigilante option is 10 by default and sets PS2X_VIGILANTE", [](TestCase &t)
+        {
+            t.Equals(ps2x::parseOptions("").values.at("vigilante"), std::string("10"), "10 by default");
+            t.IsTrue(ps2x::defaultOptionsText(false).find("vigilante = 10\n") != std::string::npos,
+                     "the template has it");
+            t.IsTrue(ps2x::defaultOptionsText(true).find("vigilante = 10\n") != std::string::npos,
+                     "development too");
+
+            const ps2x::OptionsFile file = ps2x::parseOptions("vigilante = 0\n");
+            t.IsTrue(file.warnings.empty(), "0 gives no warning");
+            std::map<std::string, std::string> variables;
+            for (const ps2x::EnvironmentSetting &setting :
+                 ps2x::optionsEnvironment(file, [](const char *) -> const char * { return nullptr; }))
+                variables[setting.variable] = setting.value;
+            t.Equals(variables["PS2X_VIGILANTE"], std::string("0"), "vigilante -> PS2X_VIGILANTE");
+
+            const ps2x::OptionsFile bad = ps2x::parseOptions("vigilante = mucho\n");
+            t.Equals(bad.warnings.size(), size_t{1u}, "a value that is not a number warns");
+            t.Equals(bad.values.at("vigilante"), std::string("10"), "and gives the default");
+
+            // The same values as PS2X_VIGILANTE (leerUmbral): 0 or 3 to 600.
+            for (const char *accepted : {"3", "600"})
+            {
+                const ps2x::OptionsFile ok = ps2x::parseOptions(std::string("vigilante = ") + accepted + "\n");
+                t.IsTrue(ok.warnings.empty(), std::string(accepted) + " gives no warning");
+                t.Equals(ok.values.at("vigilante"), std::string(accepted), std::string(accepted) + " is kept");
+            }
+            for (const char *rejected : {"1", "2", "601", "700"})
+            {
+                const ps2x::OptionsFile no = ps2x::parseOptions(std::string("vigilante = ") + rejected + "\n");
+                t.Equals(no.warnings.size(), size_t{1u}, std::string(rejected) + " warns");
+                if (no.warnings.size() == 1u)
+                    t.IsTrue(no.warnings[0].find("(valores: 0 o de 3 a 600)") != std::string::npos,
+                             std::string(rejected) + ": the warning says the accepted values");
+                t.Equals(no.values.at("vigilante"), std::string("10"), std::string(rejected) + " gives the default");
+            }
+            t.IsTrue(ps2x::defaultOptionsText(false).find("0 lo apaga; de 3 a 600") != std::string::npos,
+                     "the help text says the accepted values");
+        });
+    });
+}
