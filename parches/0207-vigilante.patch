@@ -0,0 +1,79 @@
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+#include <vector>
+
+// Vigilante (odd/tasks/vigilante.md): si un latido del juego (los VBlank del EE, las vueltas del bucle de la ventana)
+// deja de avanzar durante umbral segundos, el registro recoge la pila de cada hilo; si despues sigue, cuanto duro el
+// paron. Mientras todo va bien no escribe nada: un hilo que lee los contadores una vez por segundo.
+namespace ps2x::vigilante
+{
+    constexpr int kUmbralPorDefecto = 10;
+    constexpr int kUmbralMinimo = 3;
+    constexpr int kUmbralMaximo = 600;
+
+    // Un valor aceptado de la opcion vigilante (opciones.ini y PS2X_VIGILANTE): segundos enteros, 0 o de 3 a 600.
+    bool umbralValido(std::string_view valor);
+
+    // Valor de PS2X_VIGILANTE, sin espacios alrededor: un valor aceptado (0 apaga el vigilante); sin valor o no
+    // aceptado (1, 2, mas de 600, letras), 10, como hace opciones.ini.
+    int leerUmbral(const char *valor);
+
+    enum class Suceso
+    {
+        Parado, // el latido lleva umbral segundos o mas sin avanzar (uno por paron)
+        Sigue,  // vuelve a avanzar tras un paron avisado
+    };
+
+    struct Aviso
+    {
+        size_t latido = 0u;
+        Suceso suceso = Suceso::Parado;
+        double segundos = 0.0; // Parado: desde el ultimo avance; Sigue: lo que duro el paron
+    };
+
+    // La logica del vigilante, sin hilos ni Win32. Un latido que aun no ha avanzado nunca (el arranque, antes del
+    // primer fotograma) no avisa; umbral 0 no avisa nunca.
+    class Detector
+    {
+    public:
+        Detector(size_t latidos, int umbralSegundos);
+
+        // Una muestra: ahora en segundos de un reloj monotono y contadores[i], el valor del latido i. excusados[i]
+        // (opcional): el latido i esta parado por algo normal (T3: la ventana minimizada o arrastrada); no avisa y el
+        // paron se cuenta desde que acaba la excusa. Un paron ya avisado sigue hasta que el latido avance.
+        std::vector<Aviso> muestra(double ahora, const uint64_t *contadores, const bool *excusados = nullptr);
+
+    private:
+        struct Estado
+        {
+            bool visto = false;     // ya hay un valor anterior
+            bool arrancado = false; // ha avanzado alguna vez
+            bool avisado = false;   // paron actual ya avisado
+            uint64_t valor = 0u;
+            double ultimoAvance = 0.0;
+        };
+        std::vector<Estado> m_estados;
+        int m_umbral;
+    };
+
+    // Latido del bucle de la ventana (ps2_runtime.cpp): una suma relajada por vuelta.
+    std::atomic<uint64_t> &latidoVentana();
+
+    // T3: la ventana del juego (HWND en Windows). Minimizada, el bucle de raylib espera sin dar vueltas, y mientras se
+    // arrastra o hay un menu del sistema abierto, Windows no vuelve al bucle: el latido de la ventana queda excusado.
+    void ventanaDelJuego(void *ventana);
+
+    struct Latido
+    {
+        const char *nombre;
+        const std::atomic<uint64_t> *contador;
+    };
+
+    // Arranca el hilo "Vigilante" (Windows; en otros sistemas no hace nada). umbralSegundos 0: no arranca. Los
+    // contadores deben vivir mientras viva el proceso.
+    bool arrancar(int umbralSegundos, const std::vector<Latido> &latidos);
+}
