diff --git a/ps2xRuntime/src/lib/ps2_vigilante.cpp b/ps2xRuntime/src/lib/ps2_vigilante.cpp
new file mode 100644
index 0000000..ce689da
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_vigilante.cpp
@@ -0,0 +1,95 @@
+#include "ps2_vigilante.h"
+
+#include <cctype>
+#include <cstring>
+
+namespace ps2x::vigilante
+{
+    namespace
+    {
+        // Los segundos de un valor de solo cifras; -1 si no lo es o pasa de kUmbralMaximo.
+        int segundosDe(std::string_view valor)
+        {
+            if (valor.empty())
+                return -1;
+            int segundos = 0;
+            for (const char c : valor)
+            {
+                if (!std::isdigit(static_cast<unsigned char>(c)))
+                    return -1;
+                segundos = segundos * 10 + (c - '0');
+                if (segundos > kUmbralMaximo)
+                    return -1;
+            }
+            return segundos;
+        }
+    }
+
+    bool umbralValido(std::string_view valor)
+    {
+        const int segundos = segundosDe(valor);
+        return segundos == 0 || (segundos >= kUmbralMinimo && segundos <= kUmbralMaximo);
+    }
+
+    int leerUmbral(const char *valor)
+    {
+        if (valor == nullptr)
+            return kUmbralPorDefecto;
+        const char *inicio = valor;
+        const char *fin = valor + std::strlen(valor);
+        while (inicio < fin && std::isspace(static_cast<unsigned char>(*inicio)))
+            ++inicio;
+        while (fin > inicio && std::isspace(static_cast<unsigned char>(fin[-1])))
+            --fin;
+        const std::string_view recortado(inicio, static_cast<size_t>(fin - inicio));
+        return umbralValido(recortado) ? segundosDe(recortado) : kUmbralPorDefecto;
+    }
+
+    Detector::Detector(size_t latidos, int umbralSegundos) : m_estados(latidos), m_umbral(umbralSegundos)
+    {
+    }
+
+    std::vector<Aviso> Detector::muestra(double ahora, const uint64_t *contadores, const bool *excusados)
+    {
+        std::vector<Aviso> avisos;
+        for (size_t i = 0; i < m_estados.size(); ++i)
+        {
+            Estado &e = m_estados[i];
+            const uint64_t valor = contadores[i];
+            if (!e.visto || valor != e.valor)
+            {
+                if (e.visto)
+                {
+                    if (e.avisado)
+                        avisos.push_back({i, Suceso::Sigue, ahora - e.ultimoAvance});
+                    e.arrancado = true;
+                }
+                e.visto = true;
+                e.avisado = false;
+                e.valor = valor;
+                e.ultimoAvance = ahora;
+                continue;
+            }
+            if (m_umbral <= 0 || !e.arrancado || e.avisado)
+                continue;
+            if (excusados != nullptr && excusados[i])
+            {
+                e.ultimoAvance = ahora; // el paron cuenta desde que acaba la excusa
+                continue;
+            }
+            const double parado = ahora - e.ultimoAvance;
+            if (parado >= static_cast<double>(m_umbral))
+            {
+                e.avisado = true;
+                avisos.push_back({i, Suceso::Parado, parado});
+            }
+        }
+        return avisos;
+    }
+
+    std::atomic<uint64_t> &latidoVentana()
+    {
+        static std::atomic<uint64_t> latido{0u};
+        return latido;
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_vigilante_win.cpp b/ps2xRuntime/src/lib/ps2_vigilante_win.cpp
new file mode 100644
index 0000000..d8679b8
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_vigilante_win.cpp
@@ -0,0 +1,598 @@
+// Vigilante T2 (odd/tasks/vigilante.md): el hilo "Vigilante" y su informe. Una vez por segundo lee los latidos; si
+// uno se para, escribe en el registro la pila de cada hilo del proceso:
+//   [vigilante] parado EE desde hace 10 s
+//   [vigilante] compilacion: F1-06.exe fecha_pe=6736A0F1 tam_imagen=04B2D000 pdb=ps2EntryRunner.pdb
+//               guid=0123456789ABCDEF0123456789ABCDEF edad=1 base=0x00007FF6A1230000
+//   [vigilante] hilo 1234 GameThread
+//   [vigilante]   #0 ntdll.dll+0x9F0C4
+//   [vigilante]   #1 F1-06.exe+0x1A2B3C
+//   [vigilante] fin del informe (23 hilos)
+//   [vigilante] EE sigue tras 26 s
+// El paquete no lleva el PDB: modulo+desplazamiento y la identidad de la compilacion bastan para traducirlo en casa,
+// y dbghelp ni se carga (no es seguro entre hilos y el informe de fallos, f1_fallos.cpp, tambien lo usa). Solo si el
+// PDB que nombra el propio .exe esta a su lado (desarrollo), tras el fin del informe se repiten las pilas con nombres:
+//   [vigilante] nombres (con el PDB junto al .exe):
+//   [vigilante] hilo 1234 GameThread
+//   [vigilante]   #0 ntdll.dll+0x9F0C4 NtWaitForSingleObject+0x14
+//   [vigilante] fin de los nombres
+// Asi un dbghelp colgado no se lleva las lineas de modulo+desplazamiento, que ya estan escritas.
+//
+// El juego puede tener cerrojos tomados (el del monton, el del CRT): con un hilo suspendido solo se lee su contexto y
+// se desenrolla su pila a un arreglo; nada de malloc, new, printf ni iostream. Se suspende un hilo cada vez y se
+// reanuda enseguida, con el vigilante en prioridad maxima mientras tanto (que no se quede sin CPU con un hilo del juego
+// suspendido). La salida va con WriteFile al manejador de stderr (el registro, o la consola sin registro), sin el
+// cerrojo de los FILE del CRT.
+
+#include "ps2_vigilante.h"
+
+#include <algorithm>
+#include <memory>
+#include <thread>
+#include <vector>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <tlhelp32.h>
+#include <psapi.h>
+#include <dbghelp.h> // solo los tipos: dbghelp.dll se carga a mano, en desarrollo
+#include <io.h>
+#include <cstring>
+#endif
+
+namespace ps2x::vigilante
+{
+#if defined(_WIN32)
+    namespace
+    {
+        constexpr int kMaxMarcos = 32;
+        constexpr size_t kMaxHilos = 256u;
+        constexpr size_t kMaxModulos = 512u;
+        constexpr int kMaxInformes = 20; // tras estos, solo la linea del paron
+
+        HANDLE g_salida = INVALID_HANDLE_VALUE;
+        std::atomic<bool> g_arrancado{false};
+        std::atomic<HWND> g_ventana{nullptr};
+
+        // T3: la ventana minimizada (raylib no da vueltas al bucle sin FLAG_WINDOW_ALWAYS_RUN), arrastrada o con un
+        // menu del sistema abierto (el bucle modal de Windows no vuelve al del juego).
+        bool ventanaEnPausa()
+        {
+            const HWND ventana = g_ventana.load(std::memory_order_relaxed);
+            if (ventana == nullptr)
+                return false;
+            if (IsIconic(ventana))
+                return true;
+            GUITHREADINFO info{};
+            info.cbSize = sizeof(info);
+            const DWORD hilo = GetWindowThreadProcessId(ventana, nullptr);
+            return hilo != 0u && GetGUIThreadInfo(hilo, &info) &&
+                   (info.flags & (GUI_INMOVESIZE | GUI_INMENUMODE | GUI_SYSTEMMENUMODE | GUI_POPUPMENUMODE)) != 0u;
+        }
+
+        // Una linea en un bufer fijo, sin reservar memoria.
+        class Linea
+        {
+        public:
+            Linea &texto(const char *s)
+            {
+                while (s != nullptr && *s != '\0' && m_n < sizeof(m_bufer) - 2u)
+                    m_bufer[m_n++] = *s++;
+                return *this;
+            }
+            Linea &decimal(uint64_t v)
+            {
+                char cifras[24];
+                int n = 0;
+                do
+                {
+                    cifras[n++] = static_cast<char>('0' + v % 10u);
+                    v /= 10u;
+                } while (v != 0u);
+                while (n > 0 && m_n < sizeof(m_bufer) - 2u)
+                    m_bufer[m_n++] = cifras[--n];
+                return *this;
+            }
+            // Hexadecimal en mayusculas, con al menos 'ancho' cifras.
+            Linea &hex(uint64_t v, int ancho = 1)
+            {
+                char cifras[16];
+                int n = 0;
+                do
+                {
+                    cifras[n++] = "0123456789ABCDEF"[v & 0xFu];
+                    v >>= 4;
+                } while (v != 0u || n < ancho);
+                while (n > 0 && m_n < sizeof(m_bufer) - 2u)
+                    m_bufer[m_n++] = cifras[--n];
+                return *this;
+            }
+            void escribir()
+            {
+                m_bufer[m_n++] = '\r';
+                m_bufer[m_n++] = '\n';
+                DWORD escritos = 0;
+                if (g_salida != INVALID_HANDLE_VALUE && g_salida != nullptr)
+                    WriteFile(g_salida, m_bufer, static_cast<DWORD>(m_n), &escritos, nullptr);
+                m_n = 0u;
+            }
+
+        private:
+            char m_bufer[640];
+            size_t m_n = 0u;
+        };
+
+        Linea &inicio(Linea &l)
+        {
+            return l.texto("[vigilante] ");
+        }
+
+        struct Modulo
+        {
+            uint64_t base;
+            uint64_t tam;
+            char nombre[64];
+        };
+
+        struct Hilo
+        {
+            DWORD id;
+            char nombre[96];
+            uint64_t marcos[kMaxMarcos];
+            int n; // -1: no se pudo leer
+        };
+
+        // Estado del informe: estatico (un solo hilo vigilante), para no reservar memoria.
+        Modulo g_modulos[kMaxModulos];
+        size_t g_numModulos = 0u;
+        Hilo g_hilos[kMaxHilos];
+        bool g_identidadEscrita = false;
+        int g_informes = 0;
+
+        void aUtf8(const wchar_t *w, char *destino, int tam)
+        {
+            destino[0] = '\0';
+            if (w == nullptr)
+                return;
+            const int n = WideCharToMultiByte(CP_UTF8, 0, w, -1, destino, tam, nullptr, nullptr);
+            if (n <= 0)
+                destino[0] = '\0';
+            destino[tam - 1] = '\0';
+        }
+
+        // Los modulos cargados, leidos del PEB sin el cerrojo del cargador (K32EnumProcessModules).
+        void leerModulos()
+        {
+            HMODULE modulos[kMaxModulos];
+            DWORD bytes = 0;
+            g_numModulos = 0u;
+            if (!EnumProcessModules(GetCurrentProcess(), modulos, sizeof(modulos), &bytes))
+                return;
+            const size_t n = std::min<size_t>(bytes / sizeof(HMODULE), kMaxModulos);
+            for (size_t i = 0; i < n; ++i)
+            {
+                MODULEINFO info{};
+                if (!GetModuleInformation(GetCurrentProcess(), modulos[i], &info, sizeof(info)))
+                    continue;
+                Modulo &m = g_modulos[g_numModulos++];
+                m.base = reinterpret_cast<uint64_t>(info.lpBaseOfDll);
+                m.tam = info.SizeOfImage;
+                if (GetModuleBaseNameA(GetCurrentProcess(), modulos[i], m.nombre, sizeof(m.nombre)) == 0)
+                    std::strcpy(m.nombre, "?");
+            }
+        }
+
+        const Modulo *moduloDe(uint64_t direccion)
+        {
+            for (size_t i = 0; i < g_numModulos; ++i)
+                if (direccion >= g_modulos[i].base && direccion - g_modulos[i].base < g_modulos[i].tam)
+                    return &g_modulos[i];
+            return nullptr;
+        }
+
+        // Desenrolla la pila de un contexto (del hilo suspendido): solo lee memoria. Un marco roto acaba la pila.
+        int desenrollar(CONTEXT *c, uint64_t *marcos)
+        {
+            int n = 0;
+            __try
+            {
+                while (n < kMaxMarcos && c->Rip != 0u)
+                {
+                    marcos[n++] = c->Rip;
+                    const DWORD64 rspAntes = c->Rsp;
+                    DWORD64 base = 0;
+                    PRUNTIME_FUNCTION funcion = RtlLookupFunctionEntry(c->Rip, &base, nullptr);
+                    if (funcion != nullptr)
+                    {
+                        void *datos = nullptr;
+                        DWORD64 marco = 0;
+                        RtlVirtualUnwind(UNW_FLAG_NHANDLER, base, c->Rip, funcion, c, &datos, &marco, nullptr);
+                    }
+                    else
+                    {
+                        // Funcion hoja (sin datos de desenrollado): la vuelta esta en la cima de la pila.
+                        c->Rip = *reinterpret_cast<const DWORD64 *>(c->Rsp);
+                        c->Rsp += 8u;
+                    }
+                    if (c->Rsp <= rspAntes && funcion != nullptr)
+                        break; // la pila no avanza: algo no cuadra
+                }
+            }
+            __except (EXCEPTION_EXECUTE_HANDLER)
+            {
+            }
+            return n;
+        }
+
+        // Suspende el hilo, copia su contexto y su pila, y lo reanuda.
+        int capturar(HANDLE hilo, uint64_t *marcos)
+        {
+            if (SuspendThread(hilo) == static_cast<DWORD>(-1))
+                return -1;
+            CONTEXT c{};
+            c.ContextFlags = CONTEXT_FULL;
+            int n = -1;
+            if (GetThreadContext(hilo, &c)) // espera a que la suspension sea efectiva
+                n = desenrollar(&c, marcos);
+            ResumeThread(hilo);
+            return n;
+        }
+
+        void nombreDelHilo(HANDLE hilo, char *destino, int tam)
+        {
+            using GetThreadDescriptionFn = HRESULT(WINAPI *)(HANDLE, PWSTR *);
+            static const auto leer = reinterpret_cast<GetThreadDescriptionFn>(
+                GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "GetThreadDescription"));
+            destino[0] = '\0';
+            PWSTR descripcion = nullptr;
+            if (leer != nullptr && SUCCEEDED(leer(hilo, &descripcion)) && descripcion != nullptr)
+            {
+                aUtf8(descripcion, destino, tam);
+                LocalFree(descripcion);
+            }
+        }
+
+        // El registro CodeView RSDS del .exe: GUID, edad y ruta del PDB con que se enlazo.
+        struct CodeView
+        {
+            GUID guid;
+            DWORD edad;
+            const char *pdb; // la ruta tal como la guardo el enlazador
+        };
+
+        const IMAGE_NT_HEADERS64 *cabeceras(const uint8_t *base)
+        {
+            const auto *dos = reinterpret_cast<const IMAGE_DOS_HEADER *>(base);
+            if (base == nullptr || dos->e_magic != IMAGE_DOS_SIGNATURE)
+                return nullptr;
+            return reinterpret_cast<const IMAGE_NT_HEADERS64 *>(base + dos->e_lfanew);
+        }
+
+        bool leerCodeView(CodeView &cv)
+        {
+            const auto *base = reinterpret_cast<const uint8_t *>(GetModuleHandleW(nullptr));
+            const IMAGE_NT_HEADERS64 *nt = cabeceras(base);
+            if (nt == nullptr)
+                return false;
+            const IMAGE_DATA_DIRECTORY &dir = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_DEBUG];
+            const auto *depuracion = reinterpret_cast<const IMAGE_DEBUG_DIRECTORY *>(base + dir.VirtualAddress);
+            for (size_t i = 0; dir.VirtualAddress != 0u && i < dir.Size / sizeof(IMAGE_DEBUG_DIRECTORY); ++i)
+            {
+                const IMAGE_DEBUG_DIRECTORY &d = depuracion[i];
+                if (d.Type != IMAGE_DEBUG_TYPE_CODEVIEW || d.AddressOfRawData == 0u || d.SizeOfData < 24u)
+                    continue;
+                const uint8_t *datos = base + d.AddressOfRawData;
+                if (std::memcmp(datos, "RSDS", 4) != 0)
+                    continue;
+                std::memcpy(&cv.guid, datos + 4, sizeof(cv.guid));
+                std::memcpy(&cv.edad, datos + 20, sizeof(cv.edad));
+                cv.pdb = reinterpret_cast<const char *>(datos + 24);
+                return true;
+            }
+            return false;
+        }
+
+        const char *nombreDeArchivo(const char *ruta)
+        {
+            const char *nombre = ruta;
+            for (const char *c = ruta; *c != '\0'; ++c)
+                if (*c == '\\' || *c == '/')
+                    nombre = c + 1;
+            return nombre;
+        }
+
+        // Exe, fecha del PE, tamano de la imagen, PDB (GUID y edad del registro CodeView RSDS) y base: con esto se
+        // encuentra el PDB guardado de esta compilacion.
+        void escribirIdentidad()
+        {
+            Linea l;
+            const auto *base = reinterpret_cast<const uint8_t *>(GetModuleHandleW(nullptr));
+            wchar_t rutaW[MAX_PATH] = {};
+            char exe[MAX_PATH] = {};
+            GetModuleFileNameW(nullptr, rutaW, MAX_PATH);
+            const wchar_t *barra = wcsrchr(rutaW, L'\\');
+            aUtf8(barra != nullptr ? barra + 1 : rutaW, exe, sizeof(exe));
+            inicio(l).texto("compilacion: ").texto(exe);
+            if (const IMAGE_NT_HEADERS64 *nt = cabeceras(base))
+            {
+                l.texto(" fecha_pe=").hex(nt->FileHeader.TimeDateStamp, 8);
+                l.texto(" tam_imagen=").hex(nt->OptionalHeader.SizeOfImage, 8);
+                CodeView cv{};
+                if (leerCodeView(cv))
+                {
+                    // El GUID como lo escribe symstore (sin guiones) y la edad.
+                    l.texto(" pdb=").texto(nombreDeArchivo(cv.pdb)).texto(" guid=").hex(cv.guid.Data1, 8)
+                        .hex(cv.guid.Data2, 4).hex(cv.guid.Data3, 4);
+                    for (const unsigned char b : cv.guid.Data4)
+                        l.hex(b, 2);
+                    l.texto(" edad=").decimal(cv.edad);
+                }
+            }
+            l.texto(" base=0x").hex(reinterpret_cast<uint64_t>(base), 16);
+            l.escribir();
+        }
+
+        // Desarrollo: el PDB que nombra el registro CodeView del .exe esta en su carpeta. El paquete no lo lleva.
+        bool pdbJuntoAlExe()
+        {
+            CodeView cv{};
+            if (!leerCodeView(cv))
+                return false;
+            wchar_t ruta[MAX_PATH] = {};
+            const DWORD n = GetModuleFileNameW(nullptr, ruta, MAX_PATH);
+            wchar_t *barra = n > 0u && n < MAX_PATH ? wcsrchr(ruta, L'\\') : nullptr;
+            if (barra == nullptr)
+                return false;
+            const int libre = static_cast<int>(MAX_PATH - (barra + 1 - ruta));
+            if (MultiByteToWideChar(CP_UTF8, 0, nombreDeArchivo(cv.pdb), -1, barra + 1, libre) <= 0)
+                return false;
+            const DWORD atributos = GetFileAttributesW(ruta);
+            return atributos != INVALID_FILE_ATTRIBUTES && (atributos & FILE_ATTRIBUTE_DIRECTORY) == 0u;
+        }
+
+        // dbghelp.dll, cargada a mano y solo con el PDB junto al .exe: el paquete del jugador no la toca nunca.
+        struct Dbghelp
+        {
+            decltype(&SymSetOptions) opciones = nullptr;
+            decltype(&SymInitializeW) iniciar = nullptr;
+            decltype(&SymCleanup) soltar = nullptr;
+            decltype(&SymFromAddr) simbolo = nullptr;
+        };
+
+        const Dbghelp *dbghelp()
+        {
+            static Dbghelp d;
+            static bool intentado = false;
+            if (!intentado)
+            {
+                intentado = true;
+                if (pdbJuntoAlExe())
+                    if (HMODULE m = LoadLibraryExW(L"dbghelp.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32))
+                    {
+                        d.opciones = reinterpret_cast<decltype(d.opciones)>(GetProcAddress(m, "SymSetOptions"));
+                        d.iniciar = reinterpret_cast<decltype(d.iniciar)>(GetProcAddress(m, "SymInitializeW"));
+                        d.soltar = reinterpret_cast<decltype(d.soltar)>(GetProcAddress(m, "SymCleanup"));
+                        d.simbolo = reinterpret_cast<decltype(d.simbolo)>(GetProcAddress(m, "SymFromAddr"));
+                    }
+            }
+            return d.opciones && d.iniciar && d.soltar && d.simbolo ? &d : nullptr;
+        }
+
+        // Un marco: modulo+desplazamiento y, con dbghelp ya iniciado, el nombre de la funcion.
+        void escribirMarco(int i, uint64_t direccion, const Dbghelp *simbolos)
+        {
+            Linea l;
+            inicio(l).texto("  #").decimal(static_cast<uint64_t>(i)).texto(" ");
+            if (const Modulo *m = moduloDe(direccion))
+                l.texto(m->nombre).texto("+0x").hex(direccion - m->base);
+            else
+                l.texto("0x").hex(direccion, 16);
+            if (simbolos != nullptr)
+            {
+                alignas(SYMBOL_INFO) char bufer[sizeof(SYMBOL_INFO) + 256] = {};
+                auto *simbolo = reinterpret_cast<SYMBOL_INFO *>(bufer);
+                simbolo->SizeOfStruct = sizeof(SYMBOL_INFO);
+                simbolo->MaxNameLen = 255;
+                DWORD64 desplazamiento = 0;
+                if (simbolos->simbolo(GetCurrentProcess(), direccion, &desplazamiento, simbolo))
+                    l.texto(" ").texto(simbolo->Name).texto("+0x").hex(desplazamiento);
+            }
+            l.escribir();
+        }
+
+        void escribirHilos(size_t numHilos, const Dbghelp *simbolos)
+        {
+            for (size_t i = 0; i < numHilos; ++i)
+            {
+                const Hilo &h = g_hilos[i];
+                if (h.id == 0u)
+                    continue;
+                Linea l;
+                inicio(l).texto("hilo ").decimal(h.id);
+                if (h.nombre[0] != '\0')
+                    l.texto(" ").texto(h.nombre);
+                if (h.n < 0)
+                    l.texto(" (no se pudo leer su pila)");
+                l.escribir();
+                for (int m = 0; m < h.n; ++m)
+                    escribirMarco(m, h.marcos[m], simbolos);
+            }
+        }
+
+        // Desarrollo: las mismas pilas con nombres, despues del informe. dbghelp se inicia y se suelta cada vez, para
+        // no dejarla tomada (el informe de fallos hace su propio SymInitialize).
+        void escribirNombres(size_t numHilos)
+        {
+            const Dbghelp *d = dbghelp();
+            if (d == nullptr)
+                return;
+            // Solo la carpeta del .exe: nunca un servidor de simbolos de la red (_NT_SYMBOL_PATH no cuenta).
+            wchar_t carpeta[MAX_PATH] = {};
+            GetModuleFileNameW(nullptr, carpeta, MAX_PATH);
+            if (wchar_t *barra = wcsrchr(carpeta, L'\\'))
+                *barra = L'\0';
+            d->opciones(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_FAIL_CRITICAL_ERRORS | SYMOPT_NO_PROMPTS);
+            if (!d->iniciar(GetCurrentProcess(), carpeta, TRUE))
+                return;
+            Linea l;
+            inicio(l).texto("nombres (con el PDB junto al .exe):").escribir();
+            escribirHilos(numHilos, d);
+            inicio(l).texto("fin de los nombres").escribir();
+            d->soltar(GetCurrentProcess());
+        }
+
+        void informe()
+        {
+            if (!g_identidadEscrita)
+            {
+                g_identidadEscrita = true;
+                escribirIdentidad();
+            }
+            leerModulos();
+
+            // Los hilos del proceso, salvo este.
+            const DWORD propio = GetCurrentThreadId();
+            const DWORD proceso = GetCurrentProcessId();
+            size_t numHilos = 0u;
+            HANDLE foto = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+            if (foto != INVALID_HANDLE_VALUE)
+            {
+                THREADENTRY32 entrada{};
+                entrada.dwSize = sizeof(entrada);
+                for (BOOL hay = Thread32First(foto, &entrada); hay && numHilos < kMaxHilos;
+                     hay = Thread32Next(foto, &entrada))
+                    if (entrada.th32OwnerProcessID == proceso && entrada.th32ThreadID != propio)
+                        g_hilos[numHilos++].id = entrada.th32ThreadID;
+                CloseHandle(foto);
+            }
+
+            // Primero todas las pilas (lo mas juntas posible en el tiempo); despues se escriben. Mientras, el vigilante
+            // va en prioridad maxima: con un hilo del juego suspendido no debe esperar a que le toque la CPU.
+            const HANDLE propioHilo = GetCurrentThread();
+            const int prioridad = GetThreadPriority(propioHilo);
+            SetThreadPriority(propioHilo, THREAD_PRIORITY_TIME_CRITICAL);
+            for (size_t i = 0; i < numHilos; ++i)
+            {
+                Hilo &h = g_hilos[i];
+                h.n = -1;
+                h.nombre[0] = '\0';
+                HANDLE hilo = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION,
+                                         FALSE, h.id);
+                if (hilo == nullptr)
+                    continue;
+                // El id de la foto puede ser ya de un hilo de otro proceso (el hilo acabo y su id se reutilizo).
+                if (GetProcessIdOfThread(hilo) == proceso)
+                {
+                    nombreDelHilo(hilo, h.nombre, sizeof(h.nombre));
+                    h.n = capturar(hilo, h.marcos);
+                }
+                else
+                    h.id = 0u; // no se escribe
+                CloseHandle(hilo);
+            }
+            SetThreadPriority(propioHilo,
+                              prioridad != THREAD_PRIORITY_ERROR_RETURN ? prioridad : THREAD_PRIORITY_BELOW_NORMAL);
+
+            // Modulo+desplazamiento antes de tocar dbghelp: si se cuelga, el informe ya esta escrito.
+            escribirHilos(numHilos, nullptr);
+            const size_t escritos = static_cast<size_t>(
+                std::count_if(g_hilos, g_hilos + numHilos, [](const Hilo &h) { return h.id != 0u; }));
+            Linea l;
+            inicio(l).texto("fin del informe (").decimal(escritos).texto(" hilos)").escribir();
+            escribirNombres(numHilos);
+        }
+
+        double segundosAhora()
+        {
+            ULONGLONG cienNs = 0; // sin el tiempo de suspension del PC
+            QueryUnbiasedInterruptTime(&cienNs);
+            return static_cast<double>(cienNs) / 1.0e7;
+        }
+
+        void bucle(int umbral, std::vector<Latido> latidos)
+        {
+            SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+            using SetThreadDescriptionFn = HRESULT(WINAPI *)(HANDLE, PCWSTR);
+            if (const auto nombrar = reinterpret_cast<SetThreadDescriptionFn>(
+                    GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadDescription")))
+                nombrar(GetCurrentThread(), L"Vigilante");
+
+            Detector detector(latidos.size(), umbral);
+            std::vector<uint64_t> valores(latidos.size(), 0u);
+            std::unique_ptr<bool[]> excusados(new bool[latidos.size()]());
+            for (;;)
+            {
+                Sleep(1000);
+                const bool pausa = ventanaEnPausa();
+                for (size_t i = 0; i < latidos.size(); ++i)
+                {
+                    valores[i] = latidos[i].contador->load(std::memory_order_relaxed);
+                    excusados[i] = pausa && latidos[i].contador == &latidoVentana();
+                }
+                bool parado = false;
+                for (const Aviso &aviso : detector.muestra(segundosAhora(), valores.data(), excusados.get()))
+                {
+                    Linea l;
+                    inicio(l);
+                    const uint64_t segundos = static_cast<uint64_t>(aviso.segundos + 0.5);
+                    if (aviso.suceso == Suceso::Parado)
+                    {
+                        l.texto("parado ").texto(latidos[aviso.latido].nombre).texto(" desde hace ").decimal(segundos)
+                            .texto(" s");
+                        parado = true;
+                    }
+                    else
+                        l.texto(latidos[aviso.latido].nombre).texto(" sigue tras ").decimal(segundos).texto(" s");
+                    l.escribir();
+                }
+                if (parado)
+                {
+                    if (g_informes < kMaxInformes)
+                        informe();
+                    else if (g_informes == kMaxInformes)
+                    {
+                        Linea l;
+                        inicio(l).texto("ya hay ").decimal(kMaxInformes).texto(" informes: no se escriben mas pilas")
+                            .escribir();
+                    }
+                    ++g_informes;
+                }
+            }
+        }
+    }
+
+    bool arrancar(int umbralSegundos, const std::vector<Latido> &latidos)
+    {
+        if (umbralSegundos <= 0 || latidos.empty() || g_arrancado.exchange(true))
+            return false;
+        // El manejador de stderr (el registro, unido a stdout, o la consola); se escribe sin pasar por el CRT.
+        g_salida = reinterpret_cast<HANDLE>(_get_osfhandle(2));
+        if (g_salida == INVALID_HANDLE_VALUE || g_salida == nullptr)
+            g_salida = GetStdHandle(STD_ERROR_HANDLE);
+        std::thread(bucle, umbralSegundos, latidos).detach();
+        return true;
+    }
+
+    void ventanaDelJuego(void *ventana)
+    {
+        g_ventana.store(static_cast<HWND>(ventana), std::memory_order_relaxed);
+    }
+#else
+    void ventanaDelJuego(void *ventana)
+    {
+        (void)ventana;
+    }
+
+    bool arrancar(int umbralSegundos, const std::vector<Latido> &latidos)
+    {
+        (void)umbralSegundos;
+        (void)latidos;
+        return false;
+    }
+#endif
+}
