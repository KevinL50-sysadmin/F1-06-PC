+            t.IsTrue(photoModeSpeedEffectsMask(0x4u, true) == 0x0u, "on: blur only, off too");
+            t.IsTrue(photoModeSpeedEffectsMask(0xFFFFFFF8u | 0x3u, true) == 0xFFFFFFF8u, "on: other bits kept");
+            t.IsTrue(photoModeSpeedEffectsMask(0x0u, true) == 0x0u, "on: nothing to take off");
