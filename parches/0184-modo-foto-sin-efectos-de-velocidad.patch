+    // Aspecto T1: a frozen race keeps drawing the effects of the car's speed (F1 06: the speed effects object's mask, from
+    // the player's options when the race is set up: 4 highspeedblur, 2 highspeedzoom, 1 enginevibration). While the
+    // photo mode is on the game draws with them off; the mask itself is left as it was (src/f1_overrides.cpp).
+    constexpr uint32_t kPhotoModeSpeedEffects = 0x7u;
+
+    inline uint32_t photoModeSpeedEffectsMask(uint32_t mask, bool photoMode)
+    {
+        return photoMode ? mask & ~kPhotoModeSpeedEffects : mask;
+    }
+
     // The shared state (ps2_runtime.cpp; any thread). The window: setPhotoModeKeyOption from the menus,
