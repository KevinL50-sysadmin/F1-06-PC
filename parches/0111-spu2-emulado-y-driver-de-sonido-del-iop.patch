+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <thread>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    // SPU2 emulated at register level (patch 0111). F1 06 runs Sony's own LIBSD.IRX and its AUDIO.IRX driver on the
+    // emulated IOP, and they drive the hardware directly, so the registers are the interface to emulate.
+    //
+    // Split in two so the sound costs almost nothing on the EE thread (which also runs the IOP):
+    // - IOP side (the public calls, on the IOP's thread): the register file, transfers into SPU2 RAM (DMA and the data
+    //   port) and the interrupts that depend only on time (an IRQA in the core output areas, which the drivers use to
+    //   check that the SPU2 is alive), at exact IOP cycles.
+    // - Synthesis (its own thread): voices (ADPCM, pitch, ADSR, volumes), core mixing, reverb and noise, paced by the
+    //   IOP clock (768 IOP cycles per 48 kHz sample). It receives the register writes through a queue stamped with the
+    //   IOP sample, publishes what the IOP reads back (ENVX, VOLX, NAX, ENDX) and reports voice fetches that hit IRQA.
+    //   It trails the IOP by a millisecond or two, like a slightly late SPU2.
+    class Spu2
+    {
+    public:
+        static constexpr uint32_t RegBase = 0x1F900000u;
+        static constexpr uint32_t RegEnd = 0x1F900800u;
+        static constexpr uint64_t CyclesPerSample = 768u; // 36.864 MHz / 48 kHz
+        static constexpr uint32_t RamWords = 1u << 20;    // 2 MB in halfwords
+
+        Spu2();
+        ~Spu2();
+        Spu2(const Spu2 &) = delete;
+        Spu2 &operator=(const Spu2 &) = delete;
+
+        void reset();
+        void setClock(const uint64_t *iopCycles) noexcept { m_clock = iopCycles; }
+
+        [[nodiscard]] uint16_t read16(uint32_t phys);
+        void write16(uint32_t phys, uint16_t value);
+
+        // IOP DMA channel 4 (core 0) or 7 (core 1) started: copies between IOP RAM and SPU2 RAM at the core's TSA.
+        void dmaTransfer(int core, uint8_t *iopRam, uint32_t iopRamSize, uint32_t madr, uint32_t bytes, bool toSpu);
+
+        // IRQ 9 (SPU2): the IOP calls poll() once its cycle reaches nextPollCycle(); true = raise the interrupt now.
+        [[nodiscard]] uint64_t nextPollCycle() const noexcept { return m_nextPoll; }
+        [[nodiscard]] bool poll();
+
+        struct Synth;
+
+    private:
+        struct Command
+        {
+            uint64_t sample;
+            uint16_t reg; // halfword index (offset / 2)
+            uint16_t value;
+        };
+
+        [[nodiscard]] uint64_t now() const noexcept { return m_clock ? *m_clock : 0u; }
+        [[nodiscard]] uint64_t nowSample() const noexcept { return now() / CyclesPerSample; }
+        void publishClock() noexcept;
+        void push(uint16_t reg, uint16_t value);
+        void ensureThread();
+        void stopThread();
+        void threadMain();
+        void scheduleOutputIrq();
+        void transferIrqCheck(int core, uint32_t first, uint32_t count);
+        [[nodiscard]] uint32_t irqa(int core) const noexcept;
+        [[nodiscard]] uint32_t tsa(int core) const noexcept;
+        void setTsa(int core, uint32_t address) noexcept;
+        [[nodiscard]] bool voiceRestarted(int core, int voice) const noexcept;
+
+        // Shared with the synthesis thread.
+        std::vector<uint16_t> m_ram;
+        std::vector<Command> m_queue;
+        std::atomic<uint64_t> m_queueWrite{0};
+        std::atomic<uint64_t> m_queueRead{0}; // = commands applied by the synthesis thread
+        std::atomic<uint64_t> m_publishedCycle{0};
+        std::atomic<uint32_t> m_pubEndx[2]{};
+        std::atomic<uint32_t> m_pubNax[2][24]{};
+        std::atomic<uint32_t> m_pubEnvx[2][24]{};
+        std::atomic<uint32_t> m_pubVolx[2][24]{}; // VOLXL | VOLXR << 16
+        std::atomic<uint32_t> m_asyncIrq{0};      // cores whose IRQA a voice fetch hit
+        std::atomic<uint64_t> m_asyncIrqSeq[2]{}; // commands applied when it happened
+        std::atomic<bool> m_stop{false};
+        std::unique_ptr<Synth> m_synth;
+        std::thread m_thread;
+        bool m_threadEnabled = true;
+
+        // IOP side.
+        const uint64_t *m_clock = nullptr;
+        uint16_t m_regs[0x400]{};
+        uint64_t m_konSeq[2][24]{};
+        uint64_t m_endxClearSeq[2][24]{};
+        uint64_t m_irqConfigSeq[2]{};
+        uint16_t m_irqInfo = 0;
+        uint16_t m_statx[2]{};
+        uint64_t m_outputIrqSample[2]{UINT64_MAX, UINT64_MAX};
+        bool m_transferIrq[2]{};
+        uint64_t m_nextPoll = UINT64_MAX;
+    };
+}
