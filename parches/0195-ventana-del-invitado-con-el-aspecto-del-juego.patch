+        // The page: background with the game's pale chevrons, the header band and its title, the subtitle.
+        void drawPage(const Page &page, const std::string &title, const std::string &subtitle)
+        {
+            ClearBackground(toRaylib(kPageBackground));
+            chevron(page, -50.0f, 268.0f, 190.0f, 155.0f, 85.0f, true, kPageChevron);
+            chevron(page, 150.0f, 268.0f, 105.0f, 120.0f, 55.0f, true, kPageChevron);
+            const Rectangle header = page.screen(page.left(), 0.0f, page.right() - page.left(), kPageHeader);
+            if (header.y > 0.0f)
+                DrawRectangle(0, 0, static_cast<int>(page.width), static_cast<int>(std::ceil(header.y)), toRaylib(kHeaderTop));
+            DrawRectangleGradientV(0, static_cast<int>(header.y), static_cast<int>(page.width),
+                                   static_cast<int>(std::ceil(header.height)), toRaylib(kHeaderTop), toRaylib(kHeaderBottom));
+            for (size_t i = 0; i < std::size(kHeaderChrome); ++i)
+                DrawRectangleRec(page.screen(page.left(), kPageHeader + i, page.right() - page.left(), 1.0f),
+                                 toRaylib(kHeaderChrome[i]));
+            page.text(hostOverlayCaps(title), kPageMargin, kPageHeader / 2.0f + 2.0f, kTitleLine, kHostOverlayText, true);
+            const auto measure = [&](const std::string &s) { return page.measure(s, kSmallLine); };
+            float middle = kSubtitleTop;
+            for (const std::string &line :
+                 lineList(wrapped(hostOverlayCaps(subtitle), kGameFrameWidth - 2.0f * kPageMargin, measure)))
+            {
+                page.text(line, kPageMargin, middle, kSmallLine, kSubtitleGrey);
+                middle += kTickerLineStep;
+            }
+        }
