+    size_t loadGameFileCache(const std::filesystem::path &folder)
+    {
+        namespace fs = std::filesystem;
+        constexpr uintmax_t kMaxFile = 8u * 1024u * 1024u;
+        size_t loaded = 0;
+        std::error_code error;
+        if (folder.empty() || !fs::is_directory(folder, error))
+            return 0;
+        for (fs::recursive_directory_iterator it(folder, error), end; !error && it != end; it.increment(error))
+        {
+            if (!it->is_regular_file(error) || it->file_size(error) > kMaxFile)
+                continue;
+            const std::string name = it->path().lexically_relative(folder).generic_string();
+            if (!gameFileCacheName(name))
+                continue;
+            std::vector<uint8_t> bytes = readWholeFile(it->path());
+            if (bytes.empty())
+                continue;
+            const char kind = name[name.size() - 3]; // .pct or .bft (gameFileCacheName)
+            const bool picture = kind == 'p' || kind == 'P';
+            if (picture)
+                storeGameTextureFile(name, std::move(bytes));
+            else
+                storeGameFontFile(name, std::move(bytes));
+            ++loaded;
+        }
+        return loaded;
+    }
