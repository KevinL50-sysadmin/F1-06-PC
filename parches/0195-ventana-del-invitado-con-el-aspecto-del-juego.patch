+    namespace
+    {
+        constexpr uint16_t kPadUp = 1u << 4, kPadDown = 1u << 6, kPadCross = 1u << 14;
+
+        bool padEdge(uint16_t pressed, uint16_t before, uint16_t button)
+        {
+            return (pressed & button) != 0u && (before & button) == 0u;
+        }
+    }
+
+    GuestFormPad guestFormPad(int focus, uint16_t pressed, uint16_t before, bool keyboardBusy)
+    {
+        GuestFormPad out{focus, false, false};
+        if (keyboardBusy)
+            return out;
+        const bool up = padEdge(pressed, before, kPadUp), down = padEdge(pressed, before, kPadDown);
+        if (down && !up)
+            out.focus = (focus + 1) % kGuestFormRows;
+        if (up && !down)
+            out.focus = (focus + kGuestFormRows - 1) % kGuestFormRows;
+        out.connect = padEdge(pressed, before, kPadCross);
+        out.used = up || down || out.connect;
+        return out;
+    }
+
+    bool guestFormReturn(bool enterPressed, uint16_t pressed, uint16_t before, bool keyboardBusy)
+    {
+        return enterPressed || (!keyboardBusy && padEdge(pressed, before, kPadCross));
+    }
