+        // The game's ticker band out to the window's edges with its lines, its bottom at bottom; an error with a red
+        // stripe.
+        void drawTicker(const Page &page, const std::string &text, bool error, float bottom)
+        {
+            if (text.empty())
+                return;
+            const auto measure = [&](const std::string &s) { return page.measure(s, kSmallLine); };
+            const std::vector<std::string> lines =
+                lineList(wrapped(hostOverlayCaps(text), kGameFrameWidth - kTickerText - kPageMargin, measure));
+            const float height = lines.size() * kTickerLineStep + 8.0f;
+            const float top = bottom - height;
+            drawHostTickerBand(HostOverlayRect{page.left(), top, page.right() - page.left(), height});
+            if (error)
+                DrawRectangleRec(page.screen(14.0f, top, 4.0f, height), toRaylib(kHostOverlayRed));
+            float middle = top + 4.0f + kTickerLineStep / 2.0f;
+            for (const std::string &line : lines)
+            {
+                page.text(line, kTickerText, middle, kSmallLine, kHostOverlayText, true);
+                middle += kTickerLineStep;
+            }
+        }
