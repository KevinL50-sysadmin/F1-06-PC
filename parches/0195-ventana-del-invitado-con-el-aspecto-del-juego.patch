+        // A row as the game's: the label (grey; selected: black with the red arrow) and the value box (grey with
+        // white text and grey arrows; selected: black with red arrows; fill: a colour of its own, the state's).
+        void drawRow(const Page &page, int row, const std::string &label, const std::string &value, bool selected,
+                     bool tail, const HostOverlayColor *fill = nullptr)
+        {
+            const float middle = rowMiddle(row);
+            if (selected)
+                chevron(page, kSelectX, middle, 16.0f, 9.0f, 7.0f, true, kHostOverlayRed);
+            const std::string caps = hostOverlayCaps(label);
+            const float labelRoom = kBoxLeft - 30.0f - kLabelX;
+            const float labelWidth = page.measure(caps, kRowLine);
+            const float labelLine = labelWidth > labelRoom ? kRowLine * labelRoom / labelWidth : kRowLine;
+            page.text(caps, kLabelX, middle, labelLine, selected ? kLabelBlack : kLabelGrey);
+
+            const Color box = toRaylib(fill != nullptr ? *fill : selected ? kBoxBlack : kBoxGrey);
+            DrawRectangleRec(page.screen(kBoxLeft + kBoxPoint, middle - kBoxHalf, kBoxRight - kBoxLeft - 2.0f * kBoxPoint,
+                                         2.0f * kBoxHalf),
+                             box);
+            triangle(page.point(kBoxLeft, middle), page.point(kBoxLeft + kBoxPoint, middle - kBoxHalf),
+                     page.point(kBoxLeft + kBoxPoint, middle + kBoxHalf), box);
+            triangle(page.point(kBoxRight, middle), page.point(kBoxRight - kBoxPoint, middle - kBoxHalf),
+                     page.point(kBoxRight - kBoxPoint, middle + kBoxHalf), box);
+            const HostOverlayColor arrows = selected ? kHostOverlayRed : kBoxArrows;
+            for (int i = 0; i < 2; ++i)
+            {
+                chevron(page, kBoxLeft - 26.0f + i * 10.0f, middle, 9.0f, 8.0f, 4.5f, false, arrows);
+                chevron(page, kBoxRight + 7.0f + i * 10.0f, middle, 9.0f, 8.0f, 4.5f, true, arrows);
+            }
+
+            // The value centred, smaller if it does not fit (not below 12 rows), then cut.
+            const float room = kBoxRight - kBoxLeft - 2.0f * kBoxPoint - 4.0f;
+            float line = kSmallLine;
+            const float width = page.measure(value, line);
+            if (width > room)
+                line = std::max(12.0f, line * room / width);
+            const std::string shown = fitted(page, value, line, room, tail);
+            const float x = (kBoxLeft + kBoxRight - page.measure(shown, line)) / 2.0f;
+            page.text(shown, x, middle, line, kHostOverlayText);
+        }
+
+        // The lines of a text broken by wrapped.
+        std::vector<std::string> lineList(const std::string &text)
+        {
+            std::vector<std::string> out;
+            for (size_t start = 0; start <= text.size();)
+            {
+                const size_t end = std::min(text.find('\n', start), text.size());
+                out.push_back(text.substr(start, end - start));
+                start = end + 1;
+            }
+            return out;
+        }
