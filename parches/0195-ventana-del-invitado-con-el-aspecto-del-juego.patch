+            if (name.size() <= ending.size())
+                return false;
+            for (size_t i = 0; i < ending.size(); ++i)
+            {
+                const char c = name[name.size() - ending.size() + i];
+                if ((c >= 'A' && c <= 'Z' ? static_cast<char>(c - 'A' + 'a') : c) != ending[i])
+                    return false;
