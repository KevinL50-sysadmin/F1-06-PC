+                    return;
+                const std::string text = hostOverlayCaps(helpBarText(bar, HostLanguage::Spanish));
+                const float line = std::min(kSmallLine, kSmallLine * (kGameFrameWidth - 2.0f * kHelpBarMargin) /
+                                                            std::max(1.0f, page.measure(text, kSmallLine)));
