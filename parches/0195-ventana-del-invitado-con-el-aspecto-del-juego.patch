+        // The text cut to room: from the left ("...", the tail shown: the address being typed), else from the right.
+        std::string fitted(const Page &page, const std::string &text, float line, float room, bool tail)
+        {
+            if (page.measure(text, line) <= room)
+                return text;
+            std::string cut = text;
+            while (!cut.empty())
+            {
+                if (tail)
+                    cut.erase(0, 1);
+                else
+                    cut.pop_back();
+                while (!cut.empty() && (static_cast<unsigned char>(tail ? cut.front() : cut.back()) & 0xC0u) == 0x80u)
+                {
+                    if (tail)
+                        cut.erase(0, 1);
+                    else
+                        cut.pop_back();
+                }
+                const std::string shown = tail ? "..." + cut : cut + "...";
+                if (page.measure(shown, line) <= room)
+                    return shown;
+            }
+            return {};
+        }
