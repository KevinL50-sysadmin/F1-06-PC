+                texture = it->second;
+                return true;
+            };
+            ps2x::PadIcons icons = ps2x::buildPadIcons(from);
+            using I = ps2x::PadIcon;
+            const auto ready = [&](I i) { return icons.ready[static_cast<size_t>(i)]; };
+            t.IsTrue(ready(I::Cross) && ready(I::Triangle), "the game's two buttons");
