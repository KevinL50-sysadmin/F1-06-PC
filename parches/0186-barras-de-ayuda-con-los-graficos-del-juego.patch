+        tc.Run("a .pct of 8 bits: size, and every pixel through the CSM1 palette", [](TestCase &t)
+        {
+            const std::vector<uint8_t> bytes = samplePct(32, 32, 8);
+            ps2x::GameTexture texture;
+            t.IsTrue(ps2x::decodeGameTexture(bytes.data(), bytes.size(), texture), "decodes");
+            t.Equals(texture.width, 32, "width: twice the 16 x 16 CT32 upload's");
+            t.Equals(texture.height, 32, "height: twice the upload's");
+            if (texture.rgba.size() != 32u * 32u * 4u)
+                return;
+            int wrong = 0;
+            for (int y = 0; y < 32; ++y)
+                for (int x = 0; x < 32; ++x)
+                {
+                    uint8_t expected[4];
+                    expectedRgba(paletteColour(index8(x, y)), expected);
+                    if (std::memcmp(&texture.rgba[(size_t(y) * 32 + x) * 4], expected, 4) != 0)
+                        ++wrong;
+                }
+            t.Equals(wrong, 0, "every pixel its palette colour, PS2 alpha doubled (0x80 = 255)");
+        });
+
+        tc.Run("a wide .pct of 8 bits (the bottom band's shape) and one of 4 bits", [](TestCase &t)
+        {
