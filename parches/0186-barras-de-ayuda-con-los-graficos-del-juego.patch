+            icons = ps2x::buildPadIcons(from);
+            bool all = true;
+            for (bool r : icons.ready)
+                all = all && r;
+            t.IsTrue(all, "with the sheet: every icon");
+            t.IsTrue(icons.keyCapReady, "and the key cap");
