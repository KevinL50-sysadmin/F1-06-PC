+            t.Equals(ps2x::helpKeyName(ps2x::padKey(ps2x::PadIcon::R2), L::Spanish), std::string("R2"), "R2");
+            t.Equals(ps2x::helpKeyName(ps2x::keyboardKey("F12"), L::Spanish), std::string("F12"), "a key: its name");
+
+            ps2x::HelpBar bar;
+            bar.title = "Repeticion";
+            bar.left = {{{ps2x::padKey(ps2x::PadIcon::L2)}, "atras"},
+                        {{ps2x::padKey(ps2x::PadIcon::DpadUp), ps2x::padKey(ps2x::PadIcon::DpadDown)}, "zoom"}};
+            bar.right = {{{ps2x::keyboardKey("K")}, "pausa"}};
+            t.Equals(ps2x::helpBarText(bar, L::Spanish), std::string("Repeticion: L2 atras, arriba abajo zoom, K pausa."),
