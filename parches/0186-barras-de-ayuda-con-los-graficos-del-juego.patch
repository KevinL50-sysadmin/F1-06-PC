@@ -0,0 +1,114 @@
+#pragma once
+
+#include "ps2_host_overlay.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Aspecto T4: the game's own front end pictures (the pad's buttons, the bottom band of its menus) for the host's help
+// bars. The port copies each .pct as the game reads it from the user's disc (src/f1_overrides.cpp, the same reader as
+// the .bft letters); nothing of the game goes in the package.
+//
+// The .pct format (little endian), as read from the game's files (scripts/pct_decodificar.py draws one):
+//   13 bytes: u8 (log2 of the height << 4) | log2 of the width, u8 bits per pixel (8 or 4), u16 (flags), u16 height,
+//     u16 width, u16 0, u16 (the size in 256 byte units), u8 (the same plus the palette's)
