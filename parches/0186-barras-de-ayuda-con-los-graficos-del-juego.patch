+// Aspecto T4: the help bar (main thread, before the bottom line, which goes above it): for kPhotoModeHelpSeconds or
+// kReplayHelpSeconds, fading in and out; again from the start when the controls shown change (pad or keyboard); gone
+// with the photo mode or the replay.
+static void DrawHelpBar()
+{
+    static HelpBarKind s_kind = HelpBarKind::None;
+    static double s_start = -1.0;
+    const auto seconds = [](HelpBarKind kind)
+    { return kind == HelpBarKind::PhotoMode ? ps2x::kPhotoModeHelpSeconds : ps2x::kReplayHelpSeconds; };
+    const HelpBarKind asked =
+        static_cast<HelpBarKind>(g_helpBarRequest.exchange(static_cast<int>(HelpBarKind::None), std::memory_order_relaxed));
+    if (asked != HelpBarKind::None)
+    {
+        s_start = ps2x::hostNoticeStart(GetTime(), s_kind == asked ? s_start : -1.0, seconds(asked));
+        s_kind = asked;
+    }
+    if (g_helpInputChanged)
+    {
+        g_helpInputChanged = false;
+        if (s_kind != HelpBarKind::None)
+            s_start = ps2x::hostNoticeStart(GetTime(), s_start, seconds(s_kind));
+    }
+    const bool on = s_kind == HelpBarKind::PhotoMode ? ps2x::photoModeActive()
+                    : s_kind == HelpBarKind::Replay  ? ps2x::replayScrubActive() && !ps2x::photoModeActive()
+                                                     : false;
+    if (!on)
+    {
+        s_kind = HelpBarKind::None;
+        return;
+    }
+    const float alpha = ps2x::hostNoticeAlpha(GetTime() - s_start, seconds(s_kind));
+    if (!(alpha > 0.0f))
+        return;
+    const ps2x::HostLanguage language = ps2x::hostLanguage();
+    const ps2x::HelpInput input = ShownHelpInput();
+    ps2x::drawHostHelpBar(s_kind == HelpBarKind::PhotoMode
+                              ? ps2x::photoModeHelp(language, input, ps2x::photoKeyOption(), ps2x::photoModeKeyOption())
+                              : ps2x::replayHelp(language, input),
+                          alpha);
+}
