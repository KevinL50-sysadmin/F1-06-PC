+        });
+
+        tc.Run("the symbol's colour on the sheet, and a stick drawn from a d-pad button", [](TestCase &t)
+        {
+            ps2x::GameTexture sheet = solid(40, 40, {0, 0, 0, 0});
+            for (int y = 10; y < 30; ++y)
+                for (int x = 10; x < 27; ++x)
+                    setPixel(sheet, x, y, kSheetGrey);
+            for (int x = 14; x < 22; ++x)
+            {
+                setPixel(sheet, x, 14, {233, 140, 31, 255});
+                setPixel(sheet, x, 24, {233, 140, 31, 255});
+            }
+            setPixel(sheet, 18, 18, {120, 100, 90, 255}); // a dull pixel does not count
+            const ps2x::HostOverlayColor c = ps2x::symbolColour(sheet, {10, 10, 17, 20});
+            t.IsTrue(c.r == 233 && c.g == 140 && c.b == 31 && c.a == 255, "the strongly coloured pixels' colour");
