+    inline constexpr float kHelpBarEntryGap = 18.0f;
+    inline constexpr float kHelpBarBorderHeight = 64.0f;
+    inline constexpr int kHelpBarMaxRows = 2;
+
+    struct HelpKeySize
+    {
