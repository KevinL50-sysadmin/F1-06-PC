+            ps2x::GameTexture texture;
+            t.IsTrue(ps2x::decodeGameTexture(wide.data(), wide.size(), texture), "256 x 32, 8 bits: decodes");
+            t.IsTrue(texture.width == 256 && texture.height == 32, "its size");
+            int wrong = 0;
+            for (int y = 0; y < texture.height && texture.rgba.size() == 256u * 32u * 4u; ++y)
+                for (int x = 0; x < texture.width; ++x)
+                {
+                    uint8_t expected[4];
+                    expectedRgba(paletteColour(index8(x, y)), expected);
+                    if (std::memcmp(&texture.rgba[(size_t(y) * 256 + x) * 4], expected, 4) != 0)
+                        ++wrong;
+                }
+            t.Equals(wrong, 0, "every pixel (two GS pages across)");
+
+            const std::vector<uint8_t> four = samplePct(64, 64, 4);
+            ps2x::GameTexture small;
+            t.IsTrue(ps2x::decodeGameTexture(four.data(), four.size(), small), "64 x 64, 4 bits: decodes");
+            t.IsTrue(small.width == 64 && small.height == 64, "twice across and four times down the CT32 upload");
+            wrong = 0;
+            for (int y = 0; y < small.height && small.rgba.size() == 64u * 64u * 4u; ++y)
+                for (int x = 0; x < small.width; ++x)
+                {
+                    uint8_t expected[4];
+                    expectedRgba(paletteColour(index4(x, y)), expected);
+                    if (std::memcmp(&small.rgba[(size_t(y) * 64 + x) * 4], expected, 4) != 0)
+                        ++wrong;
+                }
+            t.Equals(wrong, 0, "every pixel through the 16 colour palette");
+        });
+
+        tc.Run("a cut, damaged or other file is refused and the texture is left as it was", [](TestCase &t)
+        {
+            const std::vector<uint8_t> whole = samplePct(32, 32, 8);
+            int accepted = 0;
+            for (size_t size = 0; size < whole.size(); ++size)
