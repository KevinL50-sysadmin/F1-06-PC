+
+        tc.Run("right entries: the word and then the key, against the right edge", [](TestCase &t)
+        {
+            const ps2x::HelpBarLayout l = ps2x::helpBarLayout(sampleBar(1, 1), sampleTextWidth, sampleKeySize);
+            t.Equals(l.rows, 1, "one row");
+            if (l.pieces.size() != 5u)
+                return;
+            const ps2x::HelpBarPiece &word = l.pieces[3], &key = l.pieces[4];
+            t.IsTrue(word.right && key.right && word.text && !key.text, "the word, then the key");
+            t.Equals(key.x + key.width, 512.0f - ps2x::kHelpBarMargin, "the key against the right margin");
+            t.Equals(word.x + word.width + ps2x::kHelpBarTextGap, key.x, "the word just before it");
+        });
+
+        tc.Run("a long bar: two rows, the right entries on the bottom one, nothing overlaps", [](TestCase &t)
+        {
+            const ps2x::HelpBar bar = sampleBar(7, 2);
+            const ps2x::HelpBarLayout l = ps2x::helpBarLayout(bar, sampleTextWidth, sampleKeySize);
+            t.Equals(l.rows, 2, "two rows");
+            t.Equals(l.top, 512.0f - ps2x::kHelpBarBorderHeight - ps2x::kHelpBarRowStep, "the band one row higher");
+            bool inside = true, rightBottom = true, overlap = false;
+            for (size_t i = 0; i < l.pieces.size(); ++i)
+            {
+                const ps2x::HelpBarPiece &p = l.pieces[i];
+                inside = inside && p.x >= ps2x::kHelpBarMargin - 0.01f && p.x + p.width <= 512.0f - ps2x::kHelpBarMargin + 0.01f;
+                if (p.right)
+                    rightBottom = rightBottom && std::fabs(p.y + p.height / 2.0f - ps2x::kHelpBarRowCentre) < 0.01f;
+                for (size_t k = i + 1; k < l.pieces.size(); ++k)
+                {
+                    const ps2x::HelpBarPiece &q = l.pieces[k];
+                    if (p.x < q.x + q.width && q.x < p.x + p.width && p.y < q.y + q.height && q.y < p.y + p.height)
+                        overlap = true;
+                }
+            }
+            t.IsTrue(inside, "inside the margins");
+            t.IsTrue(rightBottom, "the right entries on the bottom row");
+            t.IsFalse(overlap, "no piece over another");
+            int top = 0;
+            for (const ps2x::HelpBarPiece &p : l.pieces)
+                top += std::fabs(p.y + p.height / 2.0f - (ps2x::kHelpBarRowCentre - ps2x::kHelpBarRowStep)) < 0.01f;
+            t.IsTrue(top > 0, "some on the top row");
+        });
+
+        tc.Run("a bar too long for two rows: smaller, still inside", [](TestCase &t)
+        {
+            const ps2x::HelpBarLayout l = ps2x::helpBarLayout(sampleBar(16, 2), sampleTextWidth, sampleKeySize);
+            t.Equals(l.rows, 2, "two rows at most");
+            t.IsTrue(l.scale < 1.0f && l.scale > 0.3f, "smaller (" + std::to_string(l.scale) + ")");
+            bool inside = true;
+            for (const ps2x::HelpBarPiece &p : l.pieces)
+                inside = inside && p.x >= ps2x::kHelpBarMargin - 0.01f && p.x + p.width <= 512.0f - ps2x::kHelpBarMargin + 0.01f;
+            t.IsTrue(inside, "inside the margins");
+            const ps2x::HelpBarLayout none = ps2x::helpBarLayout(ps2x::HelpBar{}, sampleTextWidth, sampleKeySize);
