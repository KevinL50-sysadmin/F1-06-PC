+namespace ps2x
+{
+    bool sameGameFileName(std::string_view a, std::string_view b)
+    {
+        return a.size() == b.size() &&
+               std::equal(a.begin(), a.end(), b.begin(), [](char x, char y)
+                          { return std::tolower(static_cast<unsigned char>(x)) == std::tolower(static_cast<unsigned char>(y)); });
+    }
+
+    bool wantedGameTexture(std::string_view name)
+    {
+        return std::any_of(std::begin(kGameTextureFiles), std::end(kGameTextureFiles),
+                           [&](std::string_view file) { return sameGameFileName(file, name); });
+    }
+
+    namespace
+    {
+        // Stored under the list's spelling, whichever the game used.
+        std::string storeKey(std::string_view name)
+        {
+            for (std::string_view file : kGameTextureFiles)
+                if (sameGameFileName(file, name))
+                    return std::string(file);
+            return std::string(name);
+        }
+    }
+
+    // The same store as the letters' (names, bytes and versions; a .pct never has a .bft's name).
+    bool storeGameTextureFile(std::string_view name, std::vector<uint8_t> bytes)
+    {
+        return storeGameFontFile(storeKey(name), std::move(bytes));
+    }
+
+    bool gameTextureFile(std::string_view name, std::vector<uint8_t> &bytes, uint32_t &version)
+    {
+        return gameFontFile(storeKey(name), bytes, version);
+    }
+
+    namespace
+    {
+        constexpr size_t kPctHeader = 13u;
+        constexpr int kMaxSide = 1024;
+
+        uint32_t read32(const uint8_t *p)
+        {
+            uint32_t v = 0;
+            std::memcpy(&v, p, 4);
+            return v;
+        }
+    }
+
+    bool decodeGameTexture(const uint8_t *data, size_t size, GameTexture &texture)
+    {
+        if (data == nullptr || size < kPctHeader)
+            return false;
+        const int bits = data[1];
+        const int height = data[4] | (data[5] << 8), width = data[6] | (data[7] << 8);
+        if ((bits != 8 && bits != 4) || width != (1 << (data[0] & 0x0F)) || height != (1 << (data[0] >> 4)) ||
+            width > kMaxSide || height > kMaxSide || width < 2 || height < 4)
+            return false;
+        GameGsUpload picture, palette;
+        if (!findGameGsUpload(data, size, kPctHeader, picture) || !findGameGsUpload(data, size, picture.end, palette))
+            return false;
+        const uint32_t colours = bits == 8 ? 256u : 16u;
+        const uint32_t cw = static_cast<uint32_t>(width) / 2u;
+        const uint32_t ch = static_cast<uint32_t>(bits == 8 ? height / 2 : height / 4);
+        if (picture.width != cw || picture.height != ch || palette.width * palette.height != colours)
+            return false;
+
+        // GS memory as the game leaves it: the CT32 rectangle (whole pages, buffer width in 64 pixel units), read back
+        // as PSMT8 or PSMT4 with twice the buffer width (the same pages).
+        const uint32_t bw = (cw + 63u) / 64u, pagesHigh = (ch + 31u) / 32u;
+        std::vector<uint8_t> gs(size_t(bw) * pagesHigh * 8192u, 0u);
+        for (uint32_t y = 0; y < ch; ++y)
+            for (uint32_t x = 0; x < cw; ++x)
+            {
+                const uint32_t address = GSPSMCT32::addrPSMCT32(0u, bw, x, y);
+                if (address + 4u > gs.size())
+                    return false;
+                std::memcpy(&gs[address], data + picture.data + (size_t(y) * cw + x) * 4u, 4u);
+            }
+        std::vector<uint8_t> colour(size_t(colours) * 4u);
+        for (uint32_t i = 0; i < colours; ++i)
+        {
+            uint32_t slot = i;
+            if (colours == 256u) // CSM1: 8-15 and 16-23 of each 32 entries swapped
+            {
+                const uint32_t x = (i & 7u) | ((i & 0x10u) >> 1), y = ((i >> 5) << 1) | ((i & 8u) >> 3);
+                slot = y * 16u + x;
+            }
+            const uint32_t c = read32(data + palette.data + size_t(slot) * 4u);
+            const uint32_t alpha = c >> 24;
+            colour[i * 4u] = static_cast<uint8_t>(c);
+            colour[i * 4u + 1u] = static_cast<uint8_t>(c >> 8);
+            colour[i * 4u + 2u] = static_cast<uint8_t>(c >> 16);
+            colour[i * 4u + 3u] = static_cast<uint8_t>(alpha >= 0x80u ? 255u : alpha * 2u);
+        }
+        GameTexture out;
+        out.width = width;
+        out.height = height;
+        out.rgba.resize(size_t(width) * height * 4u);
+        const uint32_t tbw = 2u * bw;
+        for (int y = 0; y < height; ++y)
+            for (int x = 0; x < width; ++x)
+            {
+                uint32_t index = 0;
+                if (bits == 8)
+                {
+                    const uint32_t address = GSPSMT8::addrPSMT8(0u, tbw, x, y);
+                    if (address >= gs.size())
+                        return false;
+                    index = gs[address];
+                }
+                else
+                {
+                    const uint32_t nibble = GSPSMT4::addrPSMT4(0u, tbw, x, y);
+                    if ((nibble >> 1) >= gs.size())
+                        return false;
+                    const uint8_t b = gs[nibble >> 1];
+                    index = (nibble & 1u) ? (b >> 4) : (b & 0x0Fu);
+                }
+                std::memcpy(&out.rgba[(size_t(y) * width + x) * 4u], &colour[index * 4u], 4u);
+            }
+        texture = std::move(out);
+        return true;
+    }
+
+    TextureRect opaqueBounds(const GameTexture &texture, TextureRect within)
+    {
+        const int x0 = std::max(0, within.x), y0 = std::max(0, within.y);
+        const int x1 = std::min(texture.width, within.x + within.width);
+        const int y1 = std::min(texture.height, within.y + within.height);
+        int minX = x1, minY = y1, maxX = -1, maxY = -1;
+        for (int y = y0; y < y1; ++y)
+            for (int x = x0; x < x1; ++x)
+                if (texture.rgba[(size_t(y) * texture.width + x) * 4u + 3u] != 0u)
+                {
+                    minX = std::min(minX, x);
+                    minY = std::min(minY, y);
+                    maxX = std::max(maxX, x);
+                    maxY = std::max(maxY, y);
+                }
+        if (maxX < 0)
+            return {};
+        return {minX, minY, maxX - minX + 1, maxY - minY + 1};
+    }
+
+    GameTexture cropTexture(const GameTexture &texture, TextureRect rect)
+    {
+        GameTexture out;
+        if (rect.empty() || rect.x < 0 || rect.y < 0 || rect.x + rect.width > texture.width ||
+            rect.y + rect.height > texture.height)
+            return out;
+        out.width = rect.width;
+        out.height = rect.height;
+        out.rgba.resize(size_t(rect.width) * rect.height * 4u);
+        for (int y = 0; y < rect.height; ++y)
+            std::memcpy(&out.rgba[size_t(y) * rect.width * 4u],
+                        &texture.rgba[(size_t(rect.y + y) * texture.width + rect.x) * 4u], size_t(rect.width) * 4u);
+        return out;
+    }
+
+    PadIconSource padIconSource(PadIcon icon)
+    {
+        constexpr TextureRect kButton{0, 0, 32, 32};
+        // On the sheet (256 x 256): the shoulder buttons in their boxes, the d-pad and the face buttons in their
+        // ovals, SELECT and START with their names under them.
+        constexpr TextureRect kDpadUp{20, 80, 17, 20};
+        switch (icon)
+        {
+        case PadIcon::Cross:
+            return {kBtnCrossFile, kButton, PadIconOrigin::Native, {}};
+        case PadIcon::Triangle:
+            return {kBtnTriangleFile, kButton, PadIconOrigin::Native, {}};
+        case PadIcon::Circle:
+            return {kBtnCrossFile, kButton, PadIconOrigin::Drawn, {218, 104, 17, 20}};
+        case PadIcon::Square:
+            return {kBtnCrossFile, kButton, PadIconOrigin::Drawn, {218, 128, 17, 20}};
+        case PadIcon::L1:
+            return {kPadSheetFile, {16, 34, 25, 17}, PadIconOrigin::Sheet, {}};
+        case PadIcon::L2:
+            return {kPadSheetFile, {16, 58, 25, 17}, PadIconOrigin::Sheet, {}};
+        case PadIcon::R1:
+            return {kPadSheetFile, {214, 34, 25, 17}, PadIconOrigin::Sheet, {}};
+        case PadIcon::R2:
+            return {kPadSheetFile, {214, 58, 25, 17}, PadIconOrigin::Sheet, {}};
+        case PadIcon::DpadUp:
+            return {kPadSheetFile, kDpadUp, PadIconOrigin::Sheet, {}};
+        case PadIcon::DpadDown:
+            return {kPadSheetFile, {20, 104, 17, 20}, PadIconOrigin::Sheet, {}};
+        case PadIcon::DpadRight:
+            return {kPadSheetFile, {20, 128, 17, 20}, PadIconOrigin::Sheet, {}};
+        case PadIcon::DpadLeft:
+            return {kPadSheetFile, {20, 152, 17, 20}, PadIconOrigin::Sheet, {}};
+        case PadIcon::Start:
+        case PadIcon::Select:
+            return {kPadSheetFile, {16, 34, 25, 17}, PadIconOrigin::Drawn, {}}; // L1's box
+        case PadIcon::LeftStick:
+        case PadIcon::RightStick:
+            return {kPadSheetFile, kDpadUp, PadIconOrigin::Drawn, {}};
+        }
+        return {kBtnCrossFile, kButton, PadIconOrigin::Native, {}};
+    }
+
+    namespace
+    {
+        HostOverlayColor at(const GameTexture &t, int x, int y)
+        {
+            const uint8_t *p = &t.rgba[(size_t(y) * t.width + x) * 4u];
+            return {p[0], p[1], p[2], p[3]};
+        }
+
+        void setRgb(GameTexture &t, int x, int y, float r, float g, float b)
+        {
+            uint8_t *p = &t.rgba[(size_t(y) * t.width + x) * 4u];
+            p[0] = static_cast<uint8_t>(std::clamp(std::lround(r), 0L, 255L));
+            p[1] = static_cast<uint8_t>(std::clamp(std::lround(g), 0L, 255L));
+            p[2] = static_cast<uint8_t>(std::clamp(std::lround(b), 0L, 255L));
+        }
+
+        // Over each pixel of the shape (inside(x, y) on a 4 x 4 grid of points in it), its colour by how much it covers.
+        template <typename Inside>
+        void paint(GameTexture &t, HostOverlayColor colour, Inside inside)
+        {
+            for (int y = 0; y < t.height; ++y)
+                for (int x = 0; x < t.width; ++x)
+                {
+                    if (at(t, x, y).a == 0u)
+                        continue;
+                    int hits = 0;
+                    for (int sy = 0; sy < 4; ++sy)
+                        for (int sx = 0; sx < 4; ++sx)
+                            hits += inside(x + (sx + 0.5f) / 4.0f, y + (sy + 0.5f) / 4.0f) ? 1 : 0;
+                    if (hits == 0)
+                        continue;
+                    const float c = hits / 16.0f;
+                    const HostOverlayColor old = at(t, x, y);
+                    setRgb(t, x, y, old.r * (1.0f - c) + colour.r * c, old.g * (1.0f - c) + colour.g * c,
+                           old.b * (1.0f - c) + colour.b * c);
+                }
+        }
+    }
+
+    HostOverlayColor symbolColour(const GameTexture &sheet, TextureRect rect)
+    {
+        std::map<uint32_t, int> counts;
+        const int x1 = std::min(sheet.width, rect.x + rect.width), y1 = std::min(sheet.height, rect.y + rect.height);
+        for (int y = std::max(0, rect.y); y < y1; ++y)
+            for (int x = std::max(0, rect.x); x < x1; ++x)
+            {
+                const HostOverlayColor c = at(sheet, x, y);
+                const int hi = std::max({c.r, c.g, c.b}), lo = std::min({c.r, c.g, c.b});
+                if (c.a == 255u && hi - lo >= 80)
+                    ++counts[(uint32_t(c.r) << 16) | (uint32_t(c.g) << 8) | c.b];
+            }
+        if (counts.empty())
+            return {0, 0, 0, 0};
+        const auto best = std::max_element(counts.begin(), counts.end(),
+                                           [](const auto &a, const auto &b) { return a.second < b.second; });
+        return {static_cast<uint8_t>(best->first >> 16), static_cast<uint8_t>(best->first >> 8),
+                static_cast<uint8_t>(best->first), 255};
+    }
+
+    GameTexture glossyFaceButton(const GameTexture &cross, bool circle, HostOverlayColor colour)
+    {
+        if (cross.rgba.empty() || cross.width <= 0 || cross.height <= 0)
+            return {};
+        GameTexture out = cross;
+        // The X: its blue (more blue than red and green) over the button's grey to black shading.
+        const auto symbol = [&](int x, int y)
+        {
+            const HostOverlayColor c = at(cross, x, y);
+            if (c.a == 0u)
+                return 0.0f;
+            return std::clamp((c.b - std::max(c.r, c.g) - 4.0f) / 89.0f, 0.0f, 1.0f);
+        };
+        int x0 = cross.width, y0 = cross.height, x1 = -1, y1 = -1;
+        for (int y = 0; y < cross.height; ++y)
+            for (int x = 0; x < cross.width; ++x)
+            {
+                if (symbol(x, y) > 0.5f)
+                {
+                    x0 = std::min(x0, x);
+                    y0 = std::min(y0, y);
+                    x1 = std::max(x1, x);
+                    y1 = std::max(y1, y);
+                }
+                if (symbol(x, y) <= 0.05f)
+                    continue;
+                // Painted over with the button's shading of its row: between the nearest clean pixels left and right.
+                int left = x - 1, right = x + 1;
+                while (left >= 0 && (symbol(left, y) > 0.05f || at(cross, left, y).a == 0u))
+                    --left;
+                while (right < cross.width && (symbol(right, y) > 0.05f || at(cross, right, y).a == 0u))
+                    ++right;
+                const bool hasLeft = left >= 0, hasRight = right < cross.width;
+                HostOverlayColor a = hasLeft ? at(cross, left, y) : HostOverlayColor{0, 0, 0, 255};
+                HostOverlayColor b = hasRight ? at(cross, right, y) : a;
+                if (!hasLeft)
+                    a = b;
+                const float f = hasLeft && hasRight ? float(x - left) / float(right - left) : 0.0f;
+                setRgb(out, x, y, a.r + (b.r - a.r) * f, a.g + (b.g - a.g) * f, a.b + (b.b - a.b) * f);
+            }
+        if (x1 < 0)
+            return {};
+        // The new symbol where the X was, as thick as the PlayStation's.
+        const float cx = (x0 + x1 + 1) / 2.0f, cy = (y0 + y1 + 1) / 2.0f;
+        const float rx = (x1 - x0 + 1) / 2.0f, ry = (y1 - y0 + 1) / 2.0f;
+        const float stroke = std::max(1.5f, std::min(rx, ry) * 0.4f);
+        if (circle)
+        {
+            const float inner = 1.0f - stroke / std::min(rx, ry);
+            paint(out, colour, [&](float x, float y)
+                  {
+                      const float dx = (x - cx) / rx, dy = (y - cy) / ry;
+                      const float d = std::sqrt(dx * dx + dy * dy);
+                      return d <= 1.0f && d >= inner;
+                  });
+        }
+        else
+        {
+            const float hx = rx * 0.85f, hy = ry * 0.85f;
+            paint(out, colour, [&](float x, float y)
+                  {
+                      const float dx = std::fabs(x - cx), dy = std::fabs(y - cy);
+                      return dx <= hx && dy <= hy && !(dx < hx - stroke && dy < hy - stroke);
+                  });
+        }
+        return out;
+    }
+
+    namespace
+    {
+        float luminance(HostOverlayColor c)
+        {
+            return 0.299f * c.r + 0.587f * c.g + 0.114f * c.b;
+        }
+    }
+
+    GameTexture blankButton(const GameTexture &button)
+    {
+        if (button.rgba.empty())
+            return {};
+        GameTexture out = button;
+        // The button's own grey: its most common opaque colour.
+        std::map<uint32_t, int> counts;
+        for (int y = 0; y < out.height; ++y)
+            for (int x = 0; x < out.width; ++x)
+                if (const HostOverlayColor c = at(out, x, y); c.a == 255u)
+                    ++counts[(uint32_t(c.r) << 16) | (uint32_t(c.g) << 8) | c.b];
+        if (counts.empty())
+            return {};
+        const uint32_t grey = std::max_element(counts.begin(), counts.end(),
+                                               [](const auto &a, const auto &b) { return a.second < b.second; })->first;
+        for (int y = 0; y < out.height; ++y)
+            for (int x = 0; x < out.width; ++x)
+                if (at(out, x, y).a != 0u && luminance(at(out, x, y)) > 70.0f)
+                    setRgb(out, x, y, float(grey >> 16 & 0xFF), float(grey >> 8 & 0xFF), float(grey & 0xFF));
+        return out;
+    }
+
+    GameTexture stickButton(const GameTexture &dpadButton)
+    {
+        // The ring in the arrow's light colour.
+        HostOverlayColor light{245, 245, 245, 255};
+        float lightest = -1.0f;
+        for (int y = 0; y < dpadButton.height; ++y)
+            for (int x = 0; x < dpadButton.width; ++x)
+                if (const HostOverlayColor c = at(dpadButton, x, y); c.a == 255u && luminance(c) > lightest)
+                {
+                    lightest = luminance(c);
+                    light = c;
+                }
+        GameTexture out = blankButton(dpadButton);
+        if (out.rgba.empty())
+            return {};
+        // The stick's top: a ring.
+        const float cx = out.width / 2.0f, cy = out.height / 2.0f, rx = out.width * 0.32f, ry = out.height * 0.32f;
+        constexpr float kStroke = 1.6f;
+        paint(out, light, [&](float x, float y)
+              {
+                  const float dx = (x - cx) / rx, dy = (y - cy) / ry;
+                  const float d = std::sqrt(dx * dx + dy * dy);
+                  return d <= 1.0f && d >= 1.0f - kStroke / std::min(rx, ry);
+              });
+        return out;
+    }
+
+    PadIcons buildPadIcons(const GameTextureSource &source)
+    {
+        PadIcons icons;
+        std::map<std::string, std::optional<GameTexture>, std::less<>> cache;
+        const auto texture = [&](std::string_view file) -> const GameTexture *
+        {
+            auto it = cache.find(file);
+            if (it == cache.end())
+            {
+                GameTexture t;
+                it = cache.emplace(std::string(file), source(file, t) && !t.rgba.empty() ? std::optional<GameTexture>(t)
+                                                                                         : std::nullopt)
+                         .first;
+            }
+            return it->second ? &*it->second : nullptr;
+        };
+        for (size_t i = 0; i < kPadIconCount; ++i)
+        {
+            const PadIcon icon = static_cast<PadIcon>(i);
+            const PadIconSource s = padIconSource(icon);
+            const GameTexture *base = texture(s.file);
+            if (base == nullptr)
+                continue;
+            GameTexture made;
+            if (s.origin != PadIconOrigin::Drawn)
+                made = cropTexture(*base, opaqueBounds(*base, s.rect));
+            else if (icon == PadIcon::Circle || icon == PadIcon::Square)
+            {
+                const GameTexture *sheet = texture(kPadSheetFile);
+                const HostOverlayColor colour =
+                    sheet != nullptr ? symbolColour(*sheet, s.colourFrom) : HostOverlayColor{0, 0, 0, 0};
+                if (colour.a == 0u)
+                    continue;
+                const GameTexture drawn = glossyFaceButton(*base, icon == PadIcon::Circle, colour);
+                made = cropTexture(drawn, opaqueBounds(drawn, s.rect));
+            }
+            else if (icon == PadIcon::Start || icon == PadIcon::Select)
+                made = blankButton(cropTexture(*base, opaqueBounds(*base, s.rect)));
+            else
+                made = stickButton(cropTexture(*base, opaqueBounds(*base, s.rect)));
+            icons.ready[i] = !made.rgba.empty();
+            icons.icon[i] = std::move(made);
+        }
+        const GameTexture *end = texture(kKeyCapEndFile), *mid = texture(kKeyCapMidFile);
+        if (end != nullptr && mid != nullptr)
+        {
+            icons.keyCapEnd = cropTexture(*end, opaqueBounds(*end, {0, 0, end->width, end->height}));
+            icons.keyCapMid = cropTexture(*mid, opaqueBounds(*mid, {0, 0, mid->width, mid->height}));
+            icons.keyCapReady = !icons.keyCapEnd.rgba.empty() && !icons.keyCapMid.rgba.empty();
+        }
+        return icons;
+    }
+
+    HelpKeySize padIconFrameSize(PadIcon icon, int width, int height)
+    {
+        // The game's bottom bar buttons (and the circle and square drawn from them) as they are; the sheet's d-pad
+        // buttons are 20 rows high.
+        const PadIconSource s = padIconSource(icon);
+        const bool barButton = s.file == kBtnCrossFile || s.file == kBtnTriangleFile;
+        const float scale = barButton ? 1.0f : kHelpBarIconHeight / 20.0f;
+        if (icon == PadIcon::Start || icon == PadIcon::Select)
+            return {height * scale * kLabelButtonAspect, height * scale};
+        return {width * scale, height * scale};
+    }
+
+    HelpKeySize keyCapFrameSize(float textWidth)
+    {
+        // Btn_Grey_End's rounded end is 15 x 29: at the key cap's height, both ends side by side at least.
+        constexpr float kEndWidth = kKeyCapHeight * 15.0f / 29.0f;
+        constexpr float kPadding = 6.0f;
+        return {std::max(std::max(textWidth, 0.0f) + 2.0f * kPadding, 2.0f * kEndWidth), kKeyCapHeight};
+    }
+}
