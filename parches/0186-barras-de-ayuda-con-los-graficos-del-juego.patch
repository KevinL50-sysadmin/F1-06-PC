+            t.Equals(l.rows, 1, "one row");
+            t.Equals(l.scale, 1.0f, "at the game's size");
+            t.Equals(l.top, 512.0f - ps2x::kHelpBarBorderHeight, "the band as the game's");
+            t.Equals(l.pieces.size(), size_t(9), "two keys and a word each");
