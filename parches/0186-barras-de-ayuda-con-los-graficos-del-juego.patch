+            const ps2x::GameTexture blank = ps2x::blankButton(dpad);
+            int light = 0;
+            for (int y = 0; y < blank.height; ++y)
+                for (int x = 0; x < blank.width; ++x)
+                    light += pixel(blank, x, y).r > 100 ? 1 : 0;
+            t.Equals(light, 0, "a button without its arrow (or its name): only its own grey");
+            t.IsTrue(pixel(blank, 8, 10).r == kSheetGrey.r && pixel(blank, 8, 10).a == 255, "the grey where it was");
+        });
+
+        tc.Run("the icons from the pictures the game read; missing pictures leave theirs not ready", [](TestCase &t)
+        {
+            std::map<std::string, ps2x::GameTexture> pictures;
