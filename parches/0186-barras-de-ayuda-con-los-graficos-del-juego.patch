+                    for (int x = r.x + 1; x < r.x + r.width - 1; ++x)
+                        setPixel(sheet, x, y, (x + y) % 3 == 0 ? ps2x::HostOverlayColor{233, 140, 31, 255} : kSheetGrey);
+            }
+            pictures[std::string(ps2x::kPadSheetFile)] = sheet;
+            pictures[std::string(ps2x::kKeyCapEndFile)] = solid(32, 32, {200, 200, 200, 255});
