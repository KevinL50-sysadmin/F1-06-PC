+            memory.used = true;
+            memory.last = ps2x::HelpInput::Keyboard;
+            t.IsTrue(ps2x::helpInputShown(memory, true) == ps2x::HelpInput::Keyboard, "a key used: the keyboard");
+            memory.last = ps2x::HelpInput::Pad;
+            t.IsTrue(ps2x::helpInputShown(memory, false) == ps2x::HelpInput::Pad, "the pad used: the pad");
+        });
+
+        tc.Run("the bar as one line of text, with every control's name", [](TestCase &t)
+        {
