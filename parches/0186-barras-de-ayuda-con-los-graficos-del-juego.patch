+
+        tc.Run("the game's pictures only when everything is there, else one line of text", [](TestCase &t)
+        {
+            ps2x::HelpBar bar = sampleBar(1, 1); // L1, R1 and circle
+            const auto all = [](ps2x::PadIcon) { return true; };
+            const auto noCircle = [](ps2x::PadIcon i) { return i != ps2x::PadIcon::Circle; };
+            t.IsTrue(ps2x::helpBarNative(bar, all, false, true, true), "every icon, the band and the letter");
+            t.IsFalse(ps2x::helpBarNative(bar, noCircle, true, true, true), "an icon missing");
+            t.IsFalse(ps2x::helpBarNative(bar, all, true, false, true), "no band");
+            t.IsFalse(ps2x::helpBarNative(bar, all, true, true, false), "no game letter");
+            bar.left.push_back({{ps2x::keyboardKey("W")}, "mover"});
+            t.IsFalse(ps2x::helpBarNative(bar, all, false, true, true), "a key without the key cap");
+            t.IsTrue(ps2x::helpBarNative(bar, noCircle, true, true, true) == false, "still the circle missing");
+            t.IsTrue(ps2x::helpBarNative(bar, all, true, true, true), "with the key cap");
+        });
+    });
+}
