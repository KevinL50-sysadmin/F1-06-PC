+            const ps2x::HelpKeySize start = ps2x::padIconFrameSize(ps2x::PadIcon::Start, 25, 17);
+            t.IsTrue(std::fabs(start.height - l1.height) < 0.01f, "START: as high as L1's box");
+            t.IsTrue(start.width >= 2.5f * start.height, "and wide enough for its name");
+        });
+    });
+
+    MiniTest::Case("HelpBar", [](TestCase &tc)
+    {
+        tc.Run("the pad's or the keyboard's controls: the last used; before that the pad if connected", [](TestCase &t)
+        {
+            ps2x::HelpInputMemory memory;
