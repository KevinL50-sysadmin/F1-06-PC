+        });
+
+        tc.Run("icons and key caps at the game's size", [](TestCase &t)
+        {
+            const ps2x::HelpKeySize cross = ps2x::padIconFrameSize(ps2x::PadIcon::Cross, 18, 22);
+            t.IsTrue(cross.width == 18.0f && cross.height == ps2x::kHelpBarIconHeight, "the game's button as it is");
+            const ps2x::HelpKeySize up = ps2x::padIconFrameSize(ps2x::PadIcon::DpadUp, 17, 20);
+            t.Equals(up.height, ps2x::kHelpBarIconHeight, "a sheet d-pad button as high as the game's");
+            const ps2x::HelpKeySize l1 = ps2x::padIconFrameSize(ps2x::PadIcon::L1, 25, 17);
+            t.IsTrue(std::fabs(l1.width / l1.height - 25.0f / 17.0f) < 0.01f, "L1 keeps its shape");
+            t.IsTrue(std::fabs(l1.height - 17.0f * up.height / 20.0f) < 0.01f, "at the sheet's one scale");
