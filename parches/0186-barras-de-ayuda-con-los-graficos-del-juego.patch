+// Aspecto T4: the game's pictures (.pct) for the help bars, and the bars themselves. The samples are built here (made-up
+// pictures with the layout of the game's files); no byte of the game is in the tests.
+namespace
+{
+    void put16(std::vector<uint8_t> &out, uint16_t v)
+    {
+        out.push_back(static_cast<uint8_t>(v));
+        out.push_back(static_cast<uint8_t>(v >> 8));
+    }
+
+    void put32(std::vector<uint8_t> &out, uint32_t v)
+    {
+        for (int i = 0; i < 4; ++i)
+            out.push_back(static_cast<uint8_t>(v >> (8 * i)));
+    }
+
+    void put64(std::vector<uint8_t> &out, uint64_t v)
+    {
+        for (int i = 0; i < 8; ++i)
+            out.push_back(static_cast<uint8_t>(v >> (8 * i)));
+    }
+
+    // A+D (BITBLTBUF, TRXPOS, TRXREG, TRXDIR) and an IMAGE tag with the CT32 data of a w x h rectangle.
+    void putUpload(std::vector<uint8_t> &out, uint32_t w, uint32_t h, const std::vector<uint8_t> &data)
+    {
+        put64(out, (1ull << 60) | 4u);
+        put64(out, 0xEu);
+        put64(out, 0u);
+        put64(out, 0x50u);
+        put64(out, 0u);
+        put64(out, 0x51u);
+        put64(out, (uint64_t(h) << 32) | w);
+        put64(out, 0x52u);
+        put64(out, 0u);
+        put64(out, 0x53u);
+        put64(out, (2ull << 58) | (1ull << 15) | (data.size() / 16u));
+        put64(out, 0u);
+        out.insert(out.end(), data.begin(), data.end());
+    }
+
+    int log2i(int v)
+    {
+        int n = 0;
+        while ((1 << n) < v)
+            ++n;
+        return n;
+    }
+
+    void putHeader(std::vector<uint8_t> &out, int width, int height, int bits)
+    {
+        out.push_back(static_cast<uint8_t>((log2i(height) << 4) | log2i(width)));
+        out.push_back(static_cast<uint8_t>(bits));
+        put16(out, 0x2040u);
+        put16(out, static_cast<uint16_t>(height));
+        put16(out, static_cast<uint16_t>(width));
+        put16(out, 0u);
+        put16(out, static_cast<uint16_t>(width * height * bits / 8 / 256));
+        out.push_back(0x08u);
+    }
+
+    // The PS2 colour (alpha 0-0x80) of a sample palette entry.
+    uint32_t paletteColour(int i)
+    {
+        const uint32_t alpha = i == 0 ? 0u : (i % 5 == 0 ? 0x40u : 0x80u);
+        return (alpha << 24) | (uint32_t(i * 3 & 0xFF) << 16) | (uint32_t(255 - i) << 8) | uint32_t(i);
+    }
+
+    // The picture's palette index at a pixel.
+    uint8_t index8(int x, int y)
+    {
+        return static_cast<uint8_t>((x * 7 + y * 13) & 0xFF);
+    }
+    uint8_t index4(int x, int y)
+    {
+        return static_cast<uint8_t>((x + y * 3) & 0x0F);
+    }
+
+    // A .pct as the game's: PSMT8 (bits 8) or PSMT4 (bits 4) in GS memory sent as CT32, then its palette.
+    std::vector<uint8_t> samplePct(int width, int height, int bits)
+    {
+        const uint32_t cw = static_cast<uint32_t>(width / 2), ch = static_cast<uint32_t>(bits == 8 ? height / 2 : height / 4);
+        const uint32_t bw = (cw + 63u) / 64u, pagesHigh = (ch + 31u) / 32u;
+        std::vector<uint8_t> gs(size_t(bw) * pagesHigh * 8192u, 0u);
+        for (int y = 0; y < height; ++y)
+            for (int x = 0; x < width; ++x)
+            {
+                if (bits == 8)
+                    gs[GSPSMT8::addrPSMT8(0u, 2u * bw, x, y)] = index8(x, y);
+                else
+                {
+                    const uint32_t nibble = GSPSMT4::addrPSMT4(0u, 2u * bw, x, y);
+                    uint8_t &b = gs[nibble >> 1];
+                    b = (nibble & 1u) ? static_cast<uint8_t>((b & 0x0Fu) | (index4(x, y) << 4))
+                                      : static_cast<uint8_t>((b & 0xF0u) | index4(x, y));
+                }
+            }
+        std::vector<uint8_t> picture;
+        for (uint32_t y = 0; y < ch; ++y)
+            for (uint32_t x = 0; x < cw; ++x)
+            {
+                const uint32_t at = GSPSMCT32::addrPSMCT32(0u, bw, x, y);
+                picture.insert(picture.end(), gs.begin() + at, gs.begin() + at + 4);
+            }
+        std::vector<uint8_t> out;
+        putHeader(out, width, height, bits);
+        putUpload(out, cw, ch, picture);
+        std::vector<uint8_t> palette;
+        if (bits == 8)
+        {
+            // CSM1: entry i is at (x, y) of the 16 x 16 rectangle, 8-15 and 16-23 of each 32 swapped.
+            std::vector<uint32_t> slots(256u);
+            for (int i = 0; i < 256; ++i)
+            {
+                const int x = (i & 7) | ((i & 0x10) >> 1), y = ((i >> 5) << 1) | ((i & 8) >> 3);
+                slots[size_t(y * 16 + x)] = paletteColour(i);
+            }
+            for (uint32_t c : slots)
+                put32(palette, c);
+            putUpload(out, 16u, 16u, palette);
+        }
+        else
+        {
+            for (int i = 0; i < 16; ++i)
+                put32(palette, paletteColour(i));
+            putUpload(out, 8u, 2u, palette);
+        }
+        return out;
+    }
+
+    void expectedRgba(uint32_t c, uint8_t out[4])
+    {
+        const uint32_t alpha = c >> 24;
+        out[0] = static_cast<uint8_t>(c);
+        out[1] = static_cast<uint8_t>(c >> 8);
+        out[2] = static_cast<uint8_t>(c >> 16);
+        out[3] = static_cast<uint8_t>(alpha >= 0x80u ? 255u : alpha * 2u);
+    }
+
+    ps2x::GameTexture solid(int width, int height, ps2x::HostOverlayColor c)
+    {
+        ps2x::GameTexture t;
+        t.width = width;
+        t.height = height;
+        t.rgba.resize(size_t(width) * height * 4u);
+        for (size_t i = 0; i < t.rgba.size(); i += 4)
+        {
+            t.rgba[i] = c.r;
+            t.rgba[i + 1] = c.g;
+            t.rgba[i + 2] = c.b;
+            t.rgba[i + 3] = c.a;
+        }
+        return t;
+    }
+
+    void setPixel(ps2x::GameTexture &t, int x, int y, ps2x::HostOverlayColor c)
+    {
+        uint8_t *p = &t.rgba[(size_t(y) * t.width + x) * 4u];
+        p[0] = c.r;
+        p[1] = c.g;
+        p[2] = c.b;
+        p[3] = c.a;
+    }
+
+    ps2x::HostOverlayColor pixel(const ps2x::GameTexture &t, int x, int y)
+    {
+        const uint8_t *p = &t.rgba[(size_t(y) * t.width + x) * 4u];
+        return {p[0], p[1], p[2], p[3]};
+    }
+
+    // Like the game's Btn_Cross: a 32 x 32 picture, an opaque black oval button (18 x 22 from (0, 10)) with a blue X.
+    constexpr ps2x::HostOverlayColor kXBlue{0x2A, 0xA2, 0xFF, 0xFF};
+    bool inButton(int x, int y)
+    {
+        const float dx = (x + 0.5f - 9.0f) / 9.0f, dy = (y + 0.5f - 21.0f) / 11.0f;
+        return dx * dx + dy * dy <= 1.0f;
+    }
+    bool onX(int x, int y)
+    {
+        const int u = x - 4, v = y - 15; // the X in a 10 x 12 box
+        if (u < 0 || u >= 10 || v < 0 || v >= 12)
+            return false;
+        const float a = v * 10.0f / 12.0f;
+        return std::fabs(u - a) <= 1.0f || std::fabs((9 - u) - a) <= 1.0f;
+    }
+    ps2x::GameTexture sampleCross()
+    {
+        ps2x::GameTexture t = solid(32, 32, {0, 0, 0, 0});
+        for (int y = 0; y < 32; ++y)
+            for (int x = 0; x < 32; ++x)
+                if (inButton(x, y))
+                    setPixel(t, x, y, onX(x, y) ? kXBlue : ps2x::HostOverlayColor{0x08, 0x08, 0x08, 0xFF});
+        return t;
+    }
+
+    // Like a d-pad button of the sheet: a dark grey oval with a white arrow.
+    constexpr ps2x::HostOverlayColor kSheetGrey{43, 43, 43, 255}, kSheetWhite{245, 245, 245, 255};
+    ps2x::GameTexture sampleDpad()
+    {
+        ps2x::GameTexture t = solid(17, 20, {0, 0, 0, 0});
+        for (int y = 0; y < 20; ++y)
+            for (int x = 0; x < 17; ++x)
+            {
+                const float dx = (x + 0.5f - 8.5f) / 8.5f, dy = (y + 0.5f - 10.0f) / 10.0f;
+                if (dx * dx + dy * dy > 1.0f)
+                    continue;
+                const bool arrow = y >= 7 && y <= 11 && std::abs(x - 8) <= (y - 7);
+                setPixel(t, x, y, arrow ? kSheetWhite : kSheetGrey);
+            }
+        return t;
+    }
+
+    ps2x::HelpBar sampleBar(int left, int right)
+    {
+        ps2x::HelpBar bar;
+        bar.title = "Prueba";
+        for (int i = 0; i < left; ++i)
+            bar.left.push_back({{ps2x::padKey(ps2x::PadIcon::L1), ps2x::padKey(ps2x::PadIcon::R1)}, "inclinar"});
+        for (int i = 0; i < right; ++i)
+            bar.right.push_back({{ps2x::padKey(ps2x::PadIcon::Circle)}, "foto"});
+        return bar;
+    }
+
+    float sampleTextWidth(const std::string &text)
+    {
+        return static_cast<float>(text.size()) * 8.0f;
+    }
+
+    ps2x::HelpKeySize sampleKeySize(const ps2x::HelpKey &key)
+    {
+        if (!key.key.empty())
+            return ps2x::keyCapFrameSize(sampleTextWidth(key.key));
+        return {18.0f, ps2x::kHelpBarIconHeight};
+    }
+}
