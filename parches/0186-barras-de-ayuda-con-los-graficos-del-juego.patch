+            const ps2x::GameTexture dpad = sampleDpad();
+            const ps2x::GameTexture stick = ps2x::stickButton(dpad);
+            t.IsTrue(stick.width == dpad.width && stick.height == dpad.height, "the button's size");
+            t.IsTrue(pixel(stick, 8, 10).r < 100, "the arrow is gone from the middle");
