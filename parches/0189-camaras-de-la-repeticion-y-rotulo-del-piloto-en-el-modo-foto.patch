+// Camaras y pilotos T2: the driver's caption of the photo mode (main thread, after the help bar, which it keeps clear
+// of): for kPhotoCaptionSeconds after each driver chosen, hidden and brought back with the bar by L3 (PhotoCaptionShow),
+// gone with the photo mode. Over the window only: the photo (the game's frame) never has it.
+static void DrawPhotoCaption()
+{
+    static ps2x::PhotoCaptionShow s_show;
+    static ps2x::PhotoModeCaption s_caption;
+    const double now = GetTime();
+    const int toggled = g_captionHelpToggled;
+    g_captionHelpToggled = 0;
+    bool fresh = false;
+    {
+        std::lock_guard<std::mutex> lock(g_photoCaptionMutex);
+        if (g_photoCaptionNew)
+        {
+            s_caption = g_photoCaption;
+            g_photoCaptionNew = false;
+            fresh = true;
+        }
+    }
+    if (!ps2x::photoModeActive())
+    {
+        s_show.stop();
+        return;
+    }
+    if (toggled != 0)
+        s_show.helpToggled(now, toggled > 0);
+    if (fresh)
+        s_show.show(now);
+    const float alpha = s_show.alpha(now);
+    if (!(alpha > 0.0f))
+        return;
+    const ps2x::PhotoCaptionLines lines = ps2x::photoCaptionLines(s_caption, ps2x::hostLanguage());
+    ps2x::drawHostDriverCaption(lines.position, lines.name, lines.team, alpha);
