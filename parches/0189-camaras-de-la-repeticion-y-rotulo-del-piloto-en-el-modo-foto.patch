+    // Camaras y pilotos T2: the race's cameras in the photo mode and in the replay, one list for both: the driving
+    // camera's modes (triangle in a race), then the replay's own (its TV camera's onboard modes, the PlayerCam, and its
+    // trackside TV camera, in the order its triangle takes them), round. The replay's triangle and the photo mode's go
+    // through all of them (src/f1_overrides.cpp writes the game's own indices).
+    struct RaceCameraSet
+    {
+        int driving = 0; // the driving camera's modes
+        int replay = 0;  // the replay's onboard modes
+        bool tv = false; // the replay's trackside camera
+    };
+    enum class RaceCameraKind
+    {
+        Driving,
+        Replay,
+        Tv,
+    };
+    struct RaceCamera
+    {
+        RaceCameraKind kind = RaceCameraKind::Driving;
+        int mode = 0; // Driving and Replay: the mode's index
+    };
+
+    inline int raceCameraCount(const RaceCameraSet &set)
+    {
+        return std::max(set.driving, 0) + std::max(set.replay, 0) + (set.tv ? 1 : 0);
+    }
+
+    // The camera's place in the list, or -1 if the set has no such camera.
+    inline int raceCameraIndex(const RaceCameraSet &set, const RaceCamera &camera)
+    {
+        const int driving = std::max(set.driving, 0), replay = std::max(set.replay, 0);
+        switch (camera.kind)
+        {
+        case RaceCameraKind::Driving:
+            return camera.mode >= 0 && camera.mode < driving ? camera.mode : -1;
+        case RaceCameraKind::Replay:
+            return camera.mode >= 0 && camera.mode < replay ? driving + camera.mode : -1;
+        case RaceCameraKind::Tv:
+            return set.tv ? driving + replay : -1;
+        }
+        return -1;
+    }
+
+    inline bool raceCameraAt(const RaceCameraSet &set, int index, RaceCamera &camera)
+    {
+        const int driving = std::max(set.driving, 0), replay = std::max(set.replay, 0);
+        if (index < 0 || index >= raceCameraCount(set))
+            return false;
+        if (index < driving)
+            camera = {RaceCameraKind::Driving, index};
+        else if (index < driving + replay)
+            camera = {RaceCameraKind::Replay, index - driving};
+        else
+            camera = {RaceCameraKind::Tv, 0};
+        return true;
+    }
+
+    // step places from current, round; from another of the game's cameras (the start's: -1, or out of range) the first
+    // (the last going back). -1 when there is none.
+    inline int stepRaceCamera(int current, const RaceCameraSet &set, int step)
+    {
+        const int total = raceCameraCount(set);
+        if (total == 0)
+            return -1;
+        if (current < 0 || current >= total)
+            return step >= 0 ? 0 : total - 1;
+        return ((current + step) % total + total) % total;
+    }
+
+    // The notice when the camera changes: "Camera 3 of 5" (driving), "Replay camera 2 of 4", "TV camera".
+    inline std::string raceCameraNotice(const RaceCameraSet &set, int index, HostLanguage language)
+    {
+        const bool es = language == HostLanguage::Spanish;
+        RaceCamera camera;
+        if (!raceCameraAt(set, index, camera))
+            return {};
+        const std::string of = es ? " de " : " of ";
+        switch (camera.kind)
+        {
+        case RaceCameraKind::Driving:
+            return (es ? "C\xC3\xA1mara " : "Camera ") + std::to_string(camera.mode + 1) + of +
+                   std::to_string(set.driving);
+        case RaceCameraKind::Replay:
+            return (es ? "C\xC3\xA1mara de repetici\xC3\xB3n " : "Replay camera ") + std::to_string(camera.mode + 1) + of +
+                   std::to_string(set.replay);
+        case RaceCameraKind::Tv:
+            return es ? "C\xC3\xA1mara de televisi\xC3\xB3n" : "TV camera";
+        }
+        return {};
+    }
+
+    // Camaras y pilotos T2: the driver's caption when a car is chosen in the photo mode, as the game's replay shows it
+    // (its HUD's func_203F18: the driver's name as the game keeps it, mixed case, and the team): name and team in the
+    // game's Latin-1, the race position (1 the leader; 0 not known).
+    struct PhotoModeCaption
+    {
+        std::string name, team;
+        int position = 0;
+    };
+    struct PhotoCaptionLines
+    {
+        std::string position, name, team; // UTF-8; position "" when not known
+    };
+
+    namespace photo_mode_detail
+    {
+        inline std::string latin1ToUtf8(const std::string &text)
+        {
+            std::string out;
+            for (unsigned char c : text)
+            {
+                if (c < 0x80u)
+                    out.push_back(static_cast<char>(c));
+                else
+                {
+                    out.push_back(static_cast<char>(0xC0u | (c >> 6)));
+                    out.push_back(static_cast<char>(0x80u | (c & 0x3Fu)));
+                }
+            }
+            return out;
+        }
+    }
+
+    inline PhotoCaptionLines photoCaptionLines(const PhotoModeCaption &caption, HostLanguage language)
+    {
+        PhotoCaptionLines lines;
+        lines.position = caption.position > 0 ? std::to_string(caption.position) : std::string();
+        lines.name = caption.name.empty() ? std::string(language == HostLanguage::Spanish ? "Coche" : "Car")
+                                          : photo_mode_detail::latin1ToUtf8(caption.name);
+        lines.team = photo_mode_detail::latin1ToUtf8(caption.team);
+        return lines;
+    }
+
+    // When the caption is on screen (the window's thread; now: seconds, any clock): for kPhotoCaptionSeconds after each
+    // driver chosen (and when the photo mode goes on), fading in and out. It goes with the help bar: hidden at once when
+    // L3 hides the bar (and kept hidden, another driver too, until L3 brings the bar back) and there, to stay, when L3
+    // brings it back. The photo itself never has it: it is drawn over the window only (ps2_host_overlay.h).
+    constexpr double kPhotoCaptionSeconds = 4.0;
+
+    class PhotoCaptionShow
+    {
+    public:
+        void show(double now)
+        {
+            if (m_state == State::Hidden || m_state == State::Pinned)
+                return;
+            m_start = m_state == State::Timed ? hostNoticeStart(now, m_start, kPhotoCaptionSeconds) : now;
+            m_state = State::Timed;
+        }
+        // L3 (helpShown: the help bar on screen after it).
+        void helpToggled(double now, bool helpShown)
+        {
+            m_state = helpShown ? State::Pinned : State::Hidden;
+            m_start = now;
+        }
+        void stop()
+        {
+            m_state = State::Off;
+            m_start = -1.0;
+        }
+        float alpha(double now) const
+        {
+            if (m_state == State::Timed)
+                return hostNoticeAlpha(now - m_start, kPhotoCaptionSeconds);
+            if (m_state == State::Pinned)
+            {
+                const double elapsed = now - m_start; // 1e-9: as HelpBarShow
+                return elapsed + 1e-9 >= kHostNoticeFadeIn
+                           ? 1.0f
+                           : static_cast<float>(std::max(0.0, elapsed / kHostNoticeFadeIn));
+            }
+            return 0.0f;
+        }
+
+    private:
+        enum class State
+        {
+            Off,    // nothing chosen yet, or after the photo mode
+            Timed,  // for kPhotoCaptionSeconds from m_start
+            Pinned, // with the help bar, from m_start
+            Hidden, // with the help bar, by L3
+        };
+        State m_state = State::Off;
+        double m_start = -1.0;
+    };
