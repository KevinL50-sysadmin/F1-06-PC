+            const ps2x::DriverCaptionLayout wide = ps2x::driverCaptionLayout(8.0f, 140.0f, 35.0f, 512.0f);
+            t.Equals(wide.name.width, 140.0f + 2.0f * ps2x::kDriverCaptionPadding, "a long name: wider");
+            t.Equals(wide.team.width, wide.name.width, "the team too");
+            const ps2x::DriverCaptionLayout team = ps2x::driverCaptionLayout(8.0f, 40.0f, 150.0f, 512.0f);
+            t.Equals(team.name.width, 150.0f + 2.0f * ps2x::kDriverCaptionPadding, "a long team: both wider");
