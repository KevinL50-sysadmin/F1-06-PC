+            const ps2x::DriverCaptionLayout above = ps2x::driverCaptionLayout(8.0f, 40.0f, 35.0f, 430.0f);
+            t.Equals(above.bottom, 430.0f - ps2x::kDriverCaptionAbove, "over a help bar: just above it");
+            t.Equals(above.bottom - above.name.y, l.bottom - l.name.y, "the same size");
+
+            const ps2x::DriverCaptionLayout none = ps2x::driverCaptionLayout(0.0f, 40.0f, 35.0f, 512.0f);
+            t.Equals(none.position.width, 0.0f, "no position: no cell");
+            t.Equals(none.name.x, ps2x::kDriverCaptionLeft, "the name from the margin");
+        });
     });
 }
