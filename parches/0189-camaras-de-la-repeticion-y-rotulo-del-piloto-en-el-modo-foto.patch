+    DriverCaptionLayout driverCaptionLayout(float positionWidth, float nameWidth, float teamWidth, float limit)
+    {
+        DriverCaptionLayout l;
+        const float height =
+            kDriverCaptionNameHeight + kDriverCaptionSeparator + kDriverCaptionTeamHeight + kDriverCaptionEdge;
+        l.bottom = std::min(kDriverCaptionTop + height, limit - kDriverCaptionAbove);
+        const float top = l.bottom - height;
+        float x = kDriverCaptionLeft;
+        if (positionWidth > 0.0f)
+        {
+            l.position = {x, top, std::max(kDriverCaptionMinPosition, positionWidth + 2.0f * kDriverCaptionPadding),
+                          height};
+            x += l.position.width + kDriverCaptionGap;
+        }
+        else
+            l.position = {x, top, 0.0f, height};
+        const float width =
+            std::max(kDriverCaptionMinWidth, std::max(nameWidth, teamWidth) + 2.0f * kDriverCaptionPadding);
+        l.name = {x, top, width, kDriverCaptionNameHeight};
+        l.team = {x, top + kDriverCaptionNameHeight + kDriverCaptionSeparator, width, kDriverCaptionTeamHeight};
+        return l;
+    }
+
+    HostOverlayBox drawHostDriverCaption(const std::string &position, const std::string &name, const std::string &team,
+                                         float alpha)
+    {
+        if (!(alpha > 0.0f))
+            return {};
+        // The position tower's letter (fruitigerMedium, a 16 row line); the game reads it with the race HUD, and not
+        // always (logs/cyp-t2: not in a race without the tower): else the race letter closest to it, else the menus'.
+        constexpr float kCaptionLine = 16.0f;
+        refreshGameLetters();
+        const GameLetter *letter = readyLetter(kRaceTowerFontFile);
+        if (letter == nullptr)
+        {
+            std::vector<int> heights;
+            std::vector<const GameLetter *> race;
+            for (const GameLetter &l : gameLetters())
+                if (l.ready && l.race)
+                {
+                    heights.push_back(l.lineHeight);
+                    race.push_back(&l);
+                }
+            const int best = nearestGameFont(heights, kCaptionLine);
+            letter = best >= 0 ? race[static_cast<size_t>(best)] : menuLetter(kCaptionLine);
+        }
+        if (letter == nullptr || letter->lineHeight <= 0)
+            return {};
+        // In the game's 512 x 512 frame, stretched to the picture as the game's own; the letter at the tower's size there.
+        const GamePictureRect picture = currentGamePictureRect(GetScreenWidth(), GetScreenHeight());
+        const float sx = picture.width / kGameFrameWidth, sy = picture.height / kGameFrameHeight;
+        const LetterFor frameLetter{letter->font, 0.0f, 1.0f};
+        const float size = kCaptionLine;
+        const auto width = [&](const std::string &text) { return text.empty() ? 0.0f : measureWith(frameLetter, text, size); };
+        float limit = kGameFrameHeight;
+        HostOverlayBox help;
+        if (recentHostOverlayBox(HostOverlayPlace::BottomCentre, help) && sy > 0.0f)
+            limit = (help.y - picture.y) / sy;
+        const DriverCaptionLayout l = driverCaptionLayout(width(position), width(name), width(team), limit);
+        const auto screen = [&](float x, float y, float w, float h)
+        { return Rectangle{picture.x + x * sx, picture.y + y * sy, w * sx, h * sy}; };
+        const auto fill = [&](float x, float y, float w, float h, HostOverlayColor colour)
+        { DrawRectangleRec(screen(x, y, w, h), toColor(colour, alpha)); };
+
+        // The replay's rows, top to bottom (logs/cyp-t2/rotulo-repeticion-x4.png): white, the chrome line, blue, the edge.
+        constexpr HostOverlayColor kWhite{0xFB, 0xFB, 0xFB, 0xFF}, kBlue{0x4E, 0x4F, 0x6F, 0xFF};
+        constexpr HostOverlayColor kChrome[] = {{0xDC, 0xDB, 0xDC, 0xFF}, {0x9D, 0x9C, 0x9E, 0xFF}, {0x6A, 0x68, 0x69, 0xFF},
+                                                {0x90, 0x91, 0x96, 0xFF}, {0x7C, 0x7E, 0xA0, 0xFF}, {0x5C, 0x5F, 0x84, 0xFF}};
+        constexpr HostOverlayColor kEdge[] = {{0x45, 0x43, 0x52, 0xFF}, {0x20, 0x20, 0x20, 0xFF}, {0x20, 0x20, 0x20, 0xFF}};
+        const float edgeTop = l.team.y + l.team.height;
+        const auto column = [&](const HostOverlayRect &r, bool withName)
+        {
+            if (withName)
+            {
+                fill(r.x, r.y, r.width, kDriverCaptionNameHeight, kWhite);
+                for (size_t i = 0; i < std::size(kChrome); ++i)
+                    fill(r.x, r.y + kDriverCaptionNameHeight + i, r.width, 1.0f, kChrome[i]);
+                fill(r.x, l.team.y, r.width, kDriverCaptionTeamHeight, kBlue);
+            }
+            else
+                fill(r.x, r.y, r.width, edgeTop - r.y, kBlue);
+            for (size_t i = 0; i < std::size(kEdge); ++i)
+                fill(r.x, edgeTop + i, r.width, 1.0f, kEdge[i]);
+        };
+        if (l.position.width > 0.0f)
+            column(l.position, false);
+        column(l.name, true);
+
+        // The texts at the letter's size on the picture, their ink centred on their rows.
+        const LetterFor screenLetter{letter->font, 0.0f, sx / sy};
+        const float textSize = size * sy;
+        const float inkMiddle = (letter->inkTop + letter->inkBottom + 1) / 2.0f / letter->lineHeight;
+        const auto text = [&](const std::string &s, float x, float middle, HostOverlayColor colour)
+        {
+            if (s.empty())
+                return;
+            const Rectangle at = screen(x, middle, 0.0f, 0.0f);
+            drawWith(screenLetter, s, Vector2{std::round(at.x), std::round(at.y - inkMiddle * textSize)}, textSize,
+                     toColor(colour, alpha));
+        };
+        text(name, l.name.x + kDriverCaptionPadding, l.name.y + l.name.height / 2.0f, kHostTowerText);
+        text(team, l.team.x + kDriverCaptionPadding, l.team.y + l.team.height / 2.0f, kHostOverlayText);
+        if (l.position.width > 0.0f)
+            text(position, l.position.x + (l.position.width - width(position)) / 2.0f,
+                 l.position.y + (edgeTop - l.position.y) / 2.0f, kHostOverlayText);
+
+        const Rectangle all = screen(l.position.x, l.name.y, l.name.x + l.name.width - l.position.x, l.bottom - l.name.y);
+        HostOverlayBox box;
+        box.x = all.x;
+        box.y = all.y;
+        box.width = all.width;
+        box.height = all.height;
+        return box;
+    }
+
