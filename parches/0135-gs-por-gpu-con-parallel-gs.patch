+        m_gpu->GifPacket(data, sizeBytes);
+
     const bool processed = visitPackedGifPacket(data, sizeBytes, [&](const PackedGifPacketTag &tag)
                                                 {
         m_curQ = 1.0f;
@@ -1238,6 +1263,26 @@ void GS::uploadImageNative(uint64_t bitbltbuf,
 {
     gifSyncBeforeAccess(__func__);
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (m_gpu && data && sizeBytes != 0u)
+    {
+        // The same upload as a GIF packet for paraLLEl-GS: A+D for the four transfer registers, then IMAGE.
+        thread_local std::vector<uint8_t> packet;
+        const uint32_t imageQwords = (sizeBytes + 15u) / 16u;
+        packet.assign(16u + 4u * 16u + 16u + static_cast<size_t>(imageQwords) * 16u, 0u);
+        const auto put = [&](size_t offset, uint64_t value) { std::memcpy(packet.data() + offset, &value, 8u); };
+        put(0u, 4ull | (1ull << 60)); // NLOOP 4, PACKED, NREG 1
+        put(8u, 0x0Eull);             // A+D
+        const uint64_t regs[4][2] = {{bitbltbuf, GS_REG_BITBLTBUF}, {trxpos, GS_REG_TRXPOS},
+                                     {trxreg, GS_REG_TRXREG}, {trxdir, GS_REG_TRXDIR}};
+        for (size_t i = 0; i < 4u; ++i)
+        {
+            put(16u + i * 16u, regs[i][0]);
+            put(24u + i * 16u, regs[i][1]);
+        }
+        put(80u, static_cast<uint64_t>(imageQwords) | (1ull << 15) | (static_cast<uint64_t>(GIF_FMT_IMAGE) << 58));
