--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_gpu_bridge.h
@@ -0,0 +1,94 @@
+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <string>
+
+struct GSRegisters;
+
+// Phase 2 (F1 06): the GS on the GPU. `gs = gpu` in opciones.ini or PS2X_GS=gpu (the variable wins) runs
+// paraLLEl-GS (Vulkan compute) through our bridge DLL pgs_puente.dll (gpu/pgs_puente, C API pgs_puente.h), loaded at
+// run time from the .exe's folder (PS2X_GS_GPU_DLL: another path). Without the DLL or Vulkan the CPU GS is used, with
+// one "[gs:gpu]" line in the log. `gs = cpu` (the default) does not load anything: the CPU GS ("Software" mode) is the
+// reference.
+//
+// The GS front-end (gs_frontend.cpp) still parses every GIF packet: it owns CSR/IMR, SIGNAL/FINISH/LABEL and the
+// state the game waits on. With this backend it also forwards the raw packets and register writes here, and skips
+// the CPU drawing (Submit, uploads and CLUT loads do nothing). paraLLEl-GS keeps the only copy of local memory, so
+// every read (ReadVram, SnapshotVram, local -> host transfers) is served from it.
+//
+// Threading: the Vulkan device and every paraLLEl-GS call live on one thread ("GS GPU"), fed by a queue. Producers
+// (the GIF thread, the EE thread) only copy into the queue; reads wait for the queue to reach them. Presentation
+// never waits: a scanout is queued at the display flips (patch 0104) or by the window's latch, read back
+// asynchronously, and Present returns the newest frame read back.
+enum class GSMode : uint8_t
+{
+    Cpu,
+    Gpu,
+};
+
+// PS2X_GS: "gpu" (any case) selects the GPU; anything else, or unset, the CPU.
+GSMode ps2GsModeFromEnvironment(const char *value);
+
+// PS2X_GS_GPU_DLL, or pgs_puente.dll next to the executable.
+std::filesystem::path ps2GsGpuBridgePath();
+
+class GSGpuBackend final : public GSRasterBackend
+{
+public:
+    // Loads the DLL and creates the device on the GS GPU thread. Null, with the reason in error, if not possible.
+    static std::unique_ptr<GSGpuBackend> Create(const std::filesystem::path &dll, std::string &error);
+    ~GSGpuBackend() override;
+
+    std::string DeviceName() const;
+
+    // The registers that are not in a GSPresentationRequest (SMODE1).
+    void SetPrivilegedRegisters(const GSRegisters *registers);
+
+    // Raw data for paraLLEl-GS, in order.
+    void GifPacket(const uint8_t *data, uint32_t sizeBytes);
+    void WriteRegister(uint8_t address, uint64_t value);
+    // A scanout of the display described by request (queued in order with the packets).
+    void QueueScanout(const GSPresentationRequest &request);
+    // The newest frame read back (never waits).
+    PresentationFrame PresentPublished();
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    // QueueScanout(request), then PresentPublished().
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+    // Until every queued command has run on the GS GPU thread.
+    void WaitIdle() const;
+
+    struct Impl;
+
+private:
+    GSGpuBackend();
+    std::unique_ptr<Impl> m_impl;
+};
+
+// GS::init: the GPU backend when PS2X_GS asks for it and it can be created; otherwise null, with "[gs:gpu] ..." in the
+// log the first time (ps2GsGpuFallbackWarnings counts those lines).
+std::unique_ptr<GSGpuBackend> ps2GsCreateRequestedGpuBackend();
+uint32_t ps2GsGpuFallbackWarnings();
