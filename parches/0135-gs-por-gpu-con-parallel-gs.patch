+std::string GSGpuBackend::DeviceName() const
+{
+    return m_impl->deviceName;
+}
+
+void GSGpuBackend::SetPrivilegedRegisters(const GSRegisters *registers)
+{
+    m_impl->privRegs = registers;
+}
+
+void GSGpuBackend::GifPacket(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (data == nullptr || sizeBytes < 16u)
+        return;
+    m_impl->statPackets.fetch_add(1u, std::memory_order_relaxed);
+    m_impl->statBytes.fetch_add(sizeBytes, std::memory_order_relaxed);
+    const uint32_t whole = sizeBytes & ~15u;
+    m_impl->push(Impl::Kind::Gif, whole, 0u, data, whole);
+}
+
+void GSGpuBackend::WriteRegister(uint8_t address, uint64_t value)
+{
+    if (address > 0x7Fu)
+        return;
+    m_impl->push(Impl::Kind::Register, address, value, nullptr, 0u);
+}
+
+void GSGpuBackend::QueueScanout(const GSPresentationRequest &request)
+{
+    Impl::ScanoutCommand command{};
+    command.request = request;
+    command.smode1 = m_impl->privRegs != nullptr ? m_impl->privRegs->smode1 : 0u;
+    m_impl->push(Impl::Kind::Scanout, sizeof(command), 0u, &command, sizeof(command));
+}
+
+PresentationFrame GSGpuBackend::PresentPublished()
+{
+    std::lock_guard<std::mutex> lock(m_impl->publishMutex);
+    return m_impl->published; // a copy: the latch moves it into the GS
+}
+
+void GSGpuBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    // The GS hands local memory over in this array (setRasterBackend): it becomes the GPU's.
+    if (vram == nullptr || vramSize == 0u)
+        return;
+    const size_t bytes = std::min<size_t>(vramSize, kVramSize);
+    Impl &impl = *m_impl;
+    impl.runSync([&]() {
+        void *mapped = impl.api.map_vram_write(impl.context, 0u, kVramSize);
+        if (mapped == nullptr)
+            return;
+        std::memcpy(mapped, vram, bytes);
+        impl.api.end_vram_write(impl.context, 0u, kVramSize);
+    });
+    impl.mutations.fetch_add(1u, std::memory_order_relaxed);
+}
+
+void GSGpuBackend::Reset()
+{
+    m_impl->transfer = {};
+    m_impl->transfer.direction = 3u;
+    m_impl->localToHostActive = false;
+    m_impl->localToHost.clear();
+    m_impl->localToHostPos = 0u;
+}
