+void GSGpuBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    Impl &impl = *m_impl;
+    impl.transfer = {};
+    impl.transfer.direction = command.direction;
+    impl.transfer.totalPixels = static_cast<uint32_t>(command.trxreg.rrw) * command.trxreg.rrh;
+    impl.localToHostActive = command.direction == 1u;
+    impl.localToHostFetched = false;
+    impl.localToHost.clear();
+    impl.localToHostPos = 0u;
+    if (impl.localToHostActive)
+    {
+        const uint64_t bytes = static_cast<uint64_t>(impl.transfer.totalPixels) * bitsPerPixel(command.bitbltbuf.spsm) / 8u;
+        impl.localToHost.resize(static_cast<size_t>(bytes));
+        impl.transfer.localToHostPendingBytes = impl.localToHost.size();
+    }
+}
+
+PresentationFrame GSGpuBackend::Present(const GSPresentationRequest &request)
+{
+    QueueScanout(request);
+    return PresentPublished();
+}
