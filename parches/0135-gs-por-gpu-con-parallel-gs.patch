diff --git a/ps2xTest/src/ps2_gs_gpu_tests.cpp b/ps2xTest/src/ps2_gs_gpu_tests.cpp
new file mode 100644
index 0000000..1cd7576
--- /dev/null
+++ b/ps2xTest/src/ps2_gs_gpu_tests.cpp
@@ -0,0 +1,314 @@
+#include "MiniTest.h"
+#include "ps2_options.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/gs_gpu_bridge.h"
+#include "runtime/ps2_memory.h"
+#include "gs_test_sync.h"
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <functional>
+#include <iostream>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace fs = std::filesystem;
+
+namespace
+{
+    // Sets an environment variable for the life of the object, and restores it (or unsets it) after.
+    struct ScopedEnvironment
+    {
+        std::string name;
+        std::string previous;
+        bool hadPrevious = false;
+
+        ScopedEnvironment(const char *variable, const char *value) : name(variable)
+        {
+            if (const char *current = std::getenv(variable))
+            {
+                previous = current;
+                hadPrevious = true;
+            }
+            set(value);
+        }
+        ~ScopedEnvironment() { set(hadPrevious ? previous.c_str() : nullptr); }
+
+        void set(const char *value)
+        {
+#if defined(_WIN32)
+            _putenv_s(name.c_str(), value != nullptr ? value : "");
+#else
+            if (value != nullptr)
+                setenv(name.c_str(), value, 1);
+            else
+                unsetenv(name.c_str());
+#endif
+        }
+    };
+
+    std::map<std::string, std::string> settingsOf(const ps2x::OptionsFile &options,
+                                                  const std::function<const char *(const char *)> &getEnvironment)
+    {
+        std::map<std::string, std::string> result;
+        for (const ps2x::EnvironmentSetting &setting : ps2x::optionsEnvironment(options, getEnvironment))
+            result[setting.variable] = setting.value;
+        return result;
+    }
+
+    constexpr uint8_t kRegPrim = 0x00u;
+    constexpr uint8_t kRegRgbaq = 0x01u;
+    constexpr uint8_t kRegXyz2 = 0x05u;
+    constexpr uint8_t kRegXyoffset1 = 0x18u;
+    constexpr uint8_t kRegPrmodecont = 0x1Au;
+    constexpr uint8_t kRegScissor1 = 0x40u;
+    constexpr uint8_t kRegTest1 = 0x47u;
+    constexpr uint8_t kRegFrame1 = 0x4Cu;
+    constexpr uint8_t kRegZbuf1 = 0x4Eu;
+    constexpr uint8_t kRegBitbltbuf = 0x50u;
+    constexpr uint8_t kRegTrxpos = 0x51u;
+    constexpr uint8_t kRegTrxreg = 0x52u;
+    constexpr uint8_t kRegTrxdir = 0x53u;
+
+    void appendU64(std::vector<uint8_t> &packet, uint64_t value)
+    {
+        for (int i = 0; i < 8; ++i)
+            packet.push_back(static_cast<uint8_t>(value >> (8 * i)));
+    }
+
+    // A PACKED A+D GIF packet writing these registers in order.
+    std::vector<uint8_t> adPacket(const std::vector<std::pair<uint8_t, uint64_t>> &writes)
+    {
+        std::vector<uint8_t> packet;
+        appendU64(packet, static_cast<uint64_t>(writes.size()) | (1ull << 15) | (1ull << 60));
+        appendU64(packet, 0x0Eull);
+        for (const auto &write : writes)
+        {
+            appendU64(packet, write.second);
+            appendU64(packet, write.first);
+        }
+        return packet;
+    }
+
+    // 16x16 PSMCT32 pixels uploaded at block 0x1000 (page 128), width 64.
+    constexpr uint32_t kImageBase = 0x1000u;
+    constexpr uint32_t kImageSize = 16u;
+
+    std::vector<uint8_t> imagePixels()
+    {
+        std::vector<uint8_t> pixels(kImageSize * kImageSize * 4u);
+        for (size_t i = 0; i < pixels.size(); ++i)
+            pixels[i] = static_cast<uint8_t>(i * 7u + 3u);
+        return pixels;
+    }
+
+    std::vector<uint8_t> imageUploadPacket()
+    {
+        std::vector<uint8_t> packet = adPacket({
+            {kRegBitbltbuf, (static_cast<uint64_t>(kImageBase) << 32) | (1ull << 48)}, // DBW 1, DPSM CT32
+            {kRegTrxpos, 0ull},
+            {kRegTrxreg, static_cast<uint64_t>(kImageSize) | (static_cast<uint64_t>(kImageSize) << 32)},
+            {kRegTrxdir, 0ull}, // host -> local
+        });
+        const std::vector<uint8_t> pixels = imagePixels();
+        appendU64(packet, static_cast<uint64_t>(pixels.size() / 16u) | (1ull << 15) | (2ull << 58)); // IMAGE
+        appendU64(packet, 0ull);
+        packet.insert(packet.end(), pixels.begin(), pixels.end());
+        return packet;
+    }
+
+    // A flat sprite (8,8)-(40,24) in a 64-pixel wide PSMCT32 frame at page 0.
+    std::vector<uint8_t> spritePacket()
+    {
+        return adPacket({
+            {kRegPrmodecont, 1ull},
+            {kRegFrame1, 1ull << 16},                          // FBP 0, FBW 1, PSMCT32, no mask
+            {kRegZbuf1, (64ull) | (1ull << 32)},               // ZBP 64 pages, ZMSK
+            {kRegScissor1, 63ull << 16 | 63ull << 48},         // 0..63 x 0..63
+            {kRegXyoffset1, 0ull},
+            {kRegTest1, (1ull << 16) | (1ull << 17)},          // ZTE, ZTST always
+            {kRegPrim, 6ull},                                  // sprite, flat, no texture
+            {kRegRgbaq, 0x80402010ull | (0x3F800000ull << 32)},
+            {kRegXyz2, (8ull << 4) | ((8ull << 4) << 16)},
+            {kRegXyz2, (40ull << 4) | ((24ull << 4) << 16)},
+        });
+    }
+
+    std::vector<uint8_t> localToHostSetupPacket()
+    {
+        return adPacket({
+            {kRegBitbltbuf, static_cast<uint64_t>(kImageBase) | (1ull << 16)}, // SBP, SBW 1, SPSM CT32
+            {kRegTrxpos, 0ull},
+            {kRegTrxreg, static_cast<uint64_t>(kImageSize) | (static_cast<uint64_t>(kImageSize) << 32)},
+            {kRegTrxdir, 1ull}, // local -> host
+        });
+    }
+
+    std::vector<uint8_t> vramOf(GS &gs)
+    {
+        gs.refreshDisplaySnapshot();
+        uint32_t size = 0u;
+        const uint8_t *data = gs.lockDisplaySnapshot(size);
+        std::vector<uint8_t> copy;
+        if (data != nullptr)
+            copy.assign(data, data + size);
+        gs.unlockDisplaySnapshot();
+        return copy;
+    }
+
+    fs::path testBridgeDll()
+    {
+#if defined(PS2X_TEST_PGS_PUENTE_DLL)
+        return fs::path(PS2X_TEST_PGS_PUENTE_DLL);
+#else
+        return {};
+#endif
+    }
+}
+
+void register_ps2_gs_gpu_tests()
+{
+    MiniTest::Case("GsGpu", [](TestCase &tc)
+    {
+        tc.Run("the gs option is cpu by default and leaves PS2X_GS unset", [](TestCase &t)
+        {
+            const std::string text = ps2x::defaultOptionsText();
+            t.IsTrue(text.find("\ngs = cpu\n") != std::string::npos, "the default file has gs = cpu");
+            const ps2x::OptionsFile defaults = ps2x::parseOptions(text);
+            t.IsTrue(defaults.warnings.empty(), "the default file parses without warnings");
+            t.Equals(defaults.values.at("gs"), std::string("cpu"), "gs defaults to cpu");
+            const auto none = [](const char *) -> const char * { return nullptr; };
+            t.IsTrue(settingsOf(defaults, none).count("PS2X_GS") == 0u, "gs = cpu sets no variable");
+        });
+
+        tc.Run("gs = gpu sets PS2X_GS=gpu unless the variable is already set", [](TestCase &t)
+        {
+            const ps2x::OptionsFile options = ps2x::parseOptions("gs = GPU\n");
+            t.IsTrue(options.warnings.empty(), "gs = GPU is valid (any case)");
+            t.Equals(options.values.at("gs"), std::string("gpu"), "the value is gpu");
+            const auto none = [](const char *) -> const char * { return nullptr; };
+            const auto settings = settingsOf(options, none);
+            t.IsTrue(settings.count("PS2X_GS") == 1u && settings.at("PS2X_GS") == "gpu", "PS2X_GS=gpu");
+            const auto cpuSet = [](const char *name) -> const char * {
+                return std::strcmp(name, "PS2X_GS") == 0 ? "cpu" : nullptr;
+            };
+            t.IsTrue(settingsOf(options, cpuSet).count("PS2X_GS") == 0u, "PS2X_GS already set wins over the file");
+        });
+
+        tc.Run("a bad gs value keeps cpu with one warning", [](TestCase &t)
+        {
+            const ps2x::OptionsFile options = ps2x::parseOptions("gs = vulkan\n");
+            t.Equals(options.values.at("gs"), std::string("cpu"), "falls back to cpu");
+            t.Equals(options.warnings.size(), size_t{1}, "one warning");
+            t.IsTrue(!options.warnings.empty() &&
+                         options.warnings.front() ==
+                             "[opciones] opciones.ini:1: valor no valido 'vulkan' para gs; se usa cpu (valores: cpu, gpu)",
+                     "the warning names the values");
+        });
+
+        tc.Run("PS2X_GS selects the GPU only for gpu", [](TestCase &t)
+        {
+            t.IsTrue(ps2GsModeFromEnvironment(nullptr) == GSMode::Cpu, "unset: cpu");
+            t.IsTrue(ps2GsModeFromEnvironment("") == GSMode::Cpu, "empty: cpu");
+            t.IsTrue(ps2GsModeFromEnvironment("cpu") == GSMode::Cpu, "cpu");
+            t.IsTrue(ps2GsModeFromEnvironment("gpu") == GSMode::Gpu, "gpu");
+            t.IsTrue(ps2GsModeFromEnvironment("GPU") == GSMode::Gpu, "GPU");
+            t.IsTrue(ps2GsModeFromEnvironment("vulkan") == GSMode::Cpu, "anything else: cpu");
+        });
+
+        tc.Run("without the bridge DLL the CPU GS draws, with one [gs:gpu] warning", [](TestCase &t)
+        {
+            const fs::path missing = fs::temp_directory_path() / "ps2x-no-such-dir" / "pgs_puente.dll";
+            ScopedEnvironment mode("PS2X_GS", "gpu");
+            ScopedEnvironment dll("PS2X_GS_GPU_DLL", missing.string().c_str());
+            const uint32_t before = ps2GsGpuFallbackWarnings();
+
+            t.IsTrue(ps2GsCreateRequestedGpuBackend() == nullptr, "no backend without the DLL");
+            std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0u);
+            GSRegisters regs{};
+            GS gs;
+            gs.init(vram.data(), static_cast<uint32_t>(vram.size()), &regs);
+            const std::vector<uint8_t> packet = spritePacket();
+            gs.processGIFPacket(packet.data(), static_cast<uint32_t>(packet.size()));
+            waitForGs(gs);
+            t.Equals(gs.ReadVram(0u, 0u, 1u, 10u, 10u), 0x80402010u, "the CPU GS drew the sprite");
+            t.Equals(vram[0] | 0u, 0u, "outside the sprite stays clear");
+            t.Equals(before, 0u, "no warning before");
+            t.Equals(ps2GsGpuFallbackWarnings(), 1u, "one [gs:gpu] warning for the whole process");
+        });
+
+        tc.Run("with PS2X_GS unset nothing is loaded", [](TestCase &t)
+        {
+            ScopedEnvironment mode("PS2X_GS", nullptr);
+            const uint32_t before = ps2GsGpuFallbackWarnings();
+            t.IsTrue(ps2GsCreateRequestedGpuBackend() == nullptr, "no GPU backend in cpu mode");
+            t.Equals(ps2GsGpuFallbackWarnings(), before, "and no warning");
+        });
+
+        tc.Run("a sprite, an IMAGE upload and a local->host transfer match the CPU GS through the bridge", [](TestCase &t)
+        {
+            const fs::path dllPath = testBridgeDll();
+            if (dllPath.empty() || !fs::exists(dllPath))
+            {
+                std::cout << "    [Skipped] pgs_puente.dll not built (" << dllPath.string()
+                          << "): run scripts/obtener-parallel-gs.ps1" << std::endl;
+                return;
+            }
+            std::string error;
+            std::unique_ptr<GSGpuBackend> backend = GSGpuBackend::Create(dllPath, error);
+            if (!backend)
+            {
+                std::cout << "    [Skipped] no GPU bridge: " << error << std::endl;
+                return;
+            }
+
+            std::vector<uint8_t> cpuVram(PS2_GS_VRAM_SIZE, 0u), gpuVram(PS2_GS_VRAM_SIZE, 0u);
+            GSRegisters cpuRegs{}, gpuRegs{};
+            GS cpu;
+            cpu.init(cpuVram.data(), static_cast<uint32_t>(cpuVram.size()), &cpuRegs);
+            GS gpu;
+            gpu.init(gpuVram.data(), static_cast<uint32_t>(gpuVram.size()), &gpuRegs);
+            gpu.setRasterBackend(std::move(backend));
+
+            for (const std::vector<uint8_t> &packet : {imageUploadPacket(), spritePacket()})
+            {
+                cpu.processGIFPacket(packet.data(), static_cast<uint32_t>(packet.size()));
+                gpu.processGIFPacket(packet.data(), static_cast<uint32_t>(packet.size()));
+            }
+
+            t.Equals(gpu.ReadVram(0u, 0u, 1u, 10u, 10u), 0x80402010u, "the GPU drew the sprite");
+            t.Equals(gpu.ReadVram(0u, 0u, 1u, 7u, 10u), 0u, "left of the sprite is clear");
+            t.Equals(gpu.ReadVram(0u, 0u, 1u, 40u, 10u), 0u, "the right edge is not drawn");
+            const std::vector<uint8_t> pixels = imagePixels();
+            uint32_t first = 0u;
+            std::memcpy(&first, pixels.data(), 4u);
+            t.Equals(gpu.ReadVram(0u, kImageBase, 1u, 0u, 0u), first, "the GPU has the uploaded image");
+
+            const std::vector<uint8_t> cpuBytes = vramOf(cpu);
+            const std::vector<uint8_t> gpuBytes = vramOf(gpu);
+            t.Equals(gpuBytes.size(), size_t{PS2_GS_VRAM_SIZE}, "the bridge reads all local memory");
+            size_t different = 0u, firstDifferent = SIZE_MAX;
+            for (size_t i = 0; i < std::min(cpuBytes.size(), gpuBytes.size()); ++i)
+                if (cpuBytes[i] != gpuBytes[i])
+                {
+                    ++different;
+                    firstDifferent = std::min(firstDifferent, i);
+                }
+            t.Equals(different, size_t{0}, "same local memory bytes (first difference at " +
+                                               std::to_string(firstDifferent) + ")");
+
+            const std::vector<uint8_t> setup = localToHostSetupPacket();
+            cpu.processGIFPacket(setup.data(), static_cast<uint32_t>(setup.size()));
+            gpu.processGIFPacket(setup.data(), static_cast<uint32_t>(setup.size()));
+            std::vector<uint8_t> cpuOut(pixels.size(), 0xCCu), gpuOut(pixels.size(), 0xCCu);
+            const uint32_t cpuRead = cpu.consumeLocalToHostBytes(cpuOut.data(), static_cast<uint32_t>(cpuOut.size()));
+            const uint32_t gpuRead = gpu.consumeLocalToHostBytes(gpuOut.data(), static_cast<uint32_t>(gpuOut.size()));
+            t.Equals(gpuRead, cpuRead, "the same number of bytes read back");
+            t.IsTrue(gpuOut == pixels, "the GPU's local -> host data is the uploaded image");
+            t.IsTrue(gpuOut == cpuOut, "and matches the CPU GS");
+        });
+    });
+}
