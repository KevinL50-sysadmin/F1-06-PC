+bool GSGpuBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    bool cleared = false;
+    m_impl->editVram([&](GSCpuBackend &vram) { cleared = vram.ClearFramebuffer(context, rgba); });
+    return cleared;
+}
+
+uint32_t GSGpuBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    Impl &impl = *m_impl;
+    if (dst == nullptr || maxBytes == 0u || !impl.localToHostActive)
+        return 0u;
+    if (!impl.localToHostFetched)
+    {
+        // The whole transfer at once: paraLLEl-GS read it into its FIFO when the TRXDIR write reached it.
+        impl.localToHostFetched = true;
+        const uint32_t words = static_cast<uint32_t>((impl.localToHost.size() + 15u) / 16u);
+        std::vector<uint8_t> fifo(static_cast<size_t>(words) * 16u);
+        if (words != 0u)
+            impl.runSync([&]() { impl.api.read_transfer_fifo(impl.context, fifo.data(), words); });
+        std::memcpy(impl.localToHost.data(), fifo.data(), impl.localToHost.size());
+        impl.statLocalToHost.fetch_add(1u, std::memory_order_relaxed);
+        impl.statLocalToHostBytes.fetch_add(impl.localToHost.size(), std::memory_order_relaxed);
+    }
+    if (impl.localToHostPos >= impl.localToHost.size())
+        return 0u;
+    const size_t count = std::min<size_t>(maxBytes, impl.localToHost.size() - impl.localToHostPos);
+    std::memcpy(dst, impl.localToHost.data() + impl.localToHostPos, count);
+    impl.localToHostPos += count;
+    impl.transfer.copiedPixels = impl.transfer.totalPixels;
+    impl.transfer.localToHostPendingBytes = impl.localToHost.size() - impl.localToHostPos;
+    return static_cast<uint32_t>(count);
+}
+
+uint32_t GSGpuBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    Impl &impl = *m_impl;
+    std::lock_guard<std::mutex> lock(impl.readMutex);
+    impl.statVramReads.fetch_add(1u, std::memory_order_relaxed);
+    impl.refreshCacheLocked();
+    return impl.view.ReadVram(psm, base, bw, x, y);
+}
+
+void GSGpuBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    m_impl->editVram([&](GSCpuBackend &vram) { vram.WriteVram(psm, base, bw, x, y, value); });
+}
+
+void GSGpuBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    Impl &impl = *m_impl;
+    std::lock_guard<std::mutex> lock(impl.readMutex);
+    impl.statSnapshots.fetch_add(1u, std::memory_order_relaxed);
+    impl.refreshCacheLocked();
+    out = impl.vramCache;
+}
+
+GSTransferSnapshot GSGpuBackend::GetTransferSnapshot() const
+{
+    return m_impl->transfer;
+}
+
+void GSGpuBackend::WaitIdle() const
+{
+    m_impl->runSync([]() {});
+}
+
+std::unique_ptr<GSGpuBackend> ps2GsCreateRequestedGpuBackend()
+{
+    if (ps2GsModeFromEnvironment(std::getenv("PS2X_GS")) != GSMode::Gpu)
+        return nullptr;
+    const std::filesystem::path dll = ps2GsGpuBridgePath();
+    std::string error;
+    std::unique_ptr<GSGpuBackend> backend = GSGpuBackend::Create(dll, error);
+    if (!backend)
+    {
+        static std::once_flag s_warned;
+        std::call_once(s_warned, [&]() {
+            g_fallbackWarnings.fetch_add(1u, std::memory_order_relaxed);
+            std::fprintf(stderr, "[gs:gpu] no se puede usar el GS por GPU: %s; se usa el GS de CPU\n", error.c_str());
+        });
+        return nullptr;
+    }
+    std::fprintf(stderr, "[gs:gpu] GS por GPU: paraLLEl-GS en %s (%s)\n", backend->DeviceName().c_str(),
+                 dll.string().c_str());
+    return backend;
+}
+
+uint32_t ps2GsGpuFallbackWarnings()
+{
+    return g_fallbackWarnings.load(std::memory_order_relaxed);
+}
