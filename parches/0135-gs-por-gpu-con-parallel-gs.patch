diff --git a/ps2xRuntime/src/lib/gs/gs_gpu_bridge.cpp b/ps2xRuntime/src/lib/gs/gs_gpu_bridge.cpp
new file mode 100644
index 0000000..6bd0cce
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_gpu_bridge.cpp
@@ -0,0 +1,842 @@
+#include "runtime/gs/gs_gpu_bridge.h"
+#include "runtime/gs/gs_cpu_backend.h"
+#include "runtime/ps2_memory.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <iterator>
+#include <mutex>
+#include <thread>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+namespace
+{
+    // The C ABI of pgs_puente.dll (gpu/pgs_puente/pgs_puente.h, API version 1), declared here so that the runtime
+    // does not depend on the bridge's source tree.
+    constexpr uint32_t kPgsApiVersion = 1u;
+    constexpr size_t kVramSize = 4u * 1024u * 1024u;
+    struct pgs_context;
+    struct PgsCreateInfo
+    {
+        uint32_t struct_size;
+        uint32_t super_sampling;
+        uint32_t flags;
+    };
+    struct PgsPrivRegs
+    {
+        uint64_t pmode, smode1, smode2, dispfb1, display1, dispfb2, display2, extbuf, extdata, extwrite, bgcolor;
+    };
+    struct PgsFrame
+    {
+        const uint8_t *rgba;
+        uint32_t width, height, mode_width, mode_height, interlaced;
+        uint64_t serial;
+    };
+    struct PgsStats
+    {
+        uint64_t gif_bytes, gif_transfers, vsyncs, frames, fifo_bytes, vram_maps;
+    };
+    enum : uint32_t
+    {
+        kScanoutForceProgressive = 1u << 0,
+        kScanoutAntiBlur = 1u << 2,
+        kScanoutAdaptHorizontal = 1u << 4,
+    };
+
+    struct PgsApi
+    {
+        uint32_t (*api_version)();
+        pgs_context *(*create)(const PgsCreateInfo *, char *, size_t);
+        void (*destroy)(pgs_context *);
+        const char *(*device_name)(pgs_context *);
+        void (*gif_transfer)(pgs_context *, uint32_t, const void *, size_t);
+        void (*write_register)(pgs_context *, uint32_t, uint64_t);
+        void (*reset_gif_path)(pgs_context *, uint32_t);
+        void (*flush)(pgs_context *);
+        const void *(*map_vram_read)(pgs_context *, size_t, size_t);
+        void *(*map_vram_write)(pgs_context *, size_t, size_t);
+        void (*end_vram_write)(pgs_context *, size_t, size_t);
+        void (*read_transfer_fifo)(pgs_context *, void *, uint32_t);
+        int (*vsync)(pgs_context *, const PgsPrivRegs *, uint32_t, uint32_t);
+        int (*get_frame)(pgs_context *, int, PgsFrame *);
+        void (*get_stats)(pgs_context *, PgsStats *);
+    };
+
+    constexpr uint32_t kHostFrameWidth = 640u; // the presentation frame's row stride (gs_frontend.cpp)
+    constexpr uint32_t kHostFrameHeight = 512u;
+    constexpr uint32_t kGifPath = 3u;          // whole packets, each one parsed from its first tag (see GifPacket)
+
+    std::atomic<uint32_t> g_fallbackWarnings{0u};
+
+    // GIF bits per pixel of a transfer format (local -> host size).
+    uint32_t bitsPerPixel(uint32_t psm)
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT24:
+        case 0x31u: // Z24
+            return 24u;
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case 0x32u: // Z16
+        case 0x3Au: // Z16S
+            return 16u;
+        case 0x13u: // T8
+            return 8u;
+        case 0x14u: // T4
+            return 4u;
+        default:
+            return 32u;
+        }
+    }
+
+    // SMODE1 as the BIOS sets it (SetGsCrt does not store it here): PAL for 512-line displays, else NTSC.
+    uint64_t smode1For(uint64_t smode1, uint64_t display)
+    {
+        const uint32_t lc = static_cast<uint32_t>((smode1 >> 3u) & 0x7Fu);
+        if (lc == 32u || lc == 22u || lc == 15u || lc == 29u)
+            return smode1;
+        const uint32_t lines = static_cast<uint32_t>((display >> 44u) & 0x7FFu) + 1u;
+        return lines > 480u ? 0x740836504ull : 0x740834504ull;
+    }
+
+    // Our kernel HLE (Stubs/GS.cpp) writes DISPLAY in pixels (DW + 1 = width with MAGH 0, DH + 1 = frame lines) and
+    // leaves SMODE2 at 0 when the game does not call SetGsCrt: a CRTC description only the CPU presenter reads that
+    // way. paraLLEl-GS emulates the real CRTC (DW in video clocks, 2560 per PAL/NTSC line; 256/224 lines per field
+    // without INT), so it showed a 512-clock-wide strip of the top 256 lines. Translate such registers to the hardware
+    // ones of the same picture: interlaced field mode (forced progressive: the whole frame), MAGH from the width, and
+    // the standard origin (offsets do not matter: the scanout removes the common one). F1 06: 512x512, DBY 1 on
+    // circuit 2 (its flicker filter), blended as the CPU presenter does.
+    bool hleDisplayRegisters(uint64_t smode2, uint64_t display)
+    {
+        const uint32_t lines = static_cast<uint32_t>((display >> 44u) & 0x7FFu) + 1u;
+        return (smode2 & 1u) == 0u && lines > 300u;
+    }
+
+    uint64_t hardwareDisplay(uint64_t display, bool pal)
+    {
+        const uint32_t dw = static_cast<uint32_t>((display >> 32u) & 0xFFFu);
+        const uint32_t dh = static_cast<uint32_t>((display >> 44u) & 0x7FFu);
+        const uint32_t magh = static_cast<uint32_t>((display >> 23u) & 0xFu);
+        const uint32_t width = (dw + 1u) / (magh + 1u);
+        if (width < 64u || dh + 1u < 64u)
+            return display;
+        const uint32_t clocks = std::clamp<uint32_t>((2560u + width / 2u) / width, 1u, 16u);
+        const uint64_t dx = (pal ? 169u : 159u) * 4u; // the mode's scan offsets (gs_renderer.cpp), so the origin is 0
+        const uint64_t dy = (pal ? 36u : 25u) * 2u;
+        return dx | (dy << 12u) | (static_cast<uint64_t>(clocks - 1u) << 23u) |
+               (static_cast<uint64_t>(width * clocks - 1u) << 32u) | (static_cast<uint64_t>(dh) << 44u);
+    }
+
+    int64_t nowNs()
+    {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(
+                   std::chrono::steady_clock::now().time_since_epoch())
+            .count();
+    }
+
+    thread_local bool t_onGpuThread = false;
+
+    // As ThreadNaming::SetCurrentThreadName (that header cannot be included with windows.h).
+    void nameThisThread()
+    {
+#if defined(_WIN32)
+        using SetThreadDescriptionFn = HRESULT(WINAPI *)(HANDLE, PCWSTR);
+        if (HMODULE kernel32 = GetModuleHandleW(L"Kernel32.dll"))
+            if (auto setName = reinterpret_cast<SetThreadDescriptionFn>(
+                    reinterpret_cast<void *>(GetProcAddress(kernel32, "SetThreadDescription"))))
+                setName(GetCurrentThread(), L"GS GPU");
+#endif
+    }
+}
+
+GSMode ps2GsModeFromEnvironment(const char *value)
+{
+    if (value == nullptr)
+        return GSMode::Cpu;
+    std::string text(value);
+    for (char &c : text)
+        c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return text == "gpu" ? GSMode::Gpu : GSMode::Cpu;
+}
+
+std::filesystem::path ps2GsGpuBridgePath()
+{
+    if (const char *value = std::getenv("PS2X_GS_GPU_DLL"); value != nullptr && value[0] != '\0')
+        return std::filesystem::path(value);
+#if defined(_WIN32)
+    wchar_t buffer[MAX_PATH * 2] = {};
+    const DWORD length = GetModuleFileNameW(nullptr, buffer, static_cast<DWORD>(std::size(buffer)));
+    if (length != 0u && length < std::size(buffer))
+        return std::filesystem::path(buffer).parent_path() / "pgs_puente.dll";
+#endif
+    return std::filesystem::path("pgs_puente.dll");
+}
+
+struct GSGpuBackend::Impl
+{
+    enum class Kind : uint32_t
+    {
+        Gif,
+        Register,
+        Scanout,
+        Call,
+    };
+    struct Header
+    {
+        Kind kind;
+        uint32_t size; // payload bytes (Register: the address)
+        uint64_t arg;  // Register: the value; Call: the SyncCall
+    };
+    static_assert(sizeof(Header) == 16u, "queue records are 16-byte aligned");
+    struct ScanoutCommand
+    {
+        GSPresentationRequest request{};
+        uint64_t smode1 = 0u;
+    };
+    struct SyncCall
+    {
+        std::function<void()> fn;
+        bool done = false;
+    };
+
+    static constexpr size_t kMaxPending = 64u << 20;
+
+    // The DLL.
+#if defined(_WIN32)
+    HMODULE module = nullptr;
+#else
+    void *module = nullptr;
+#endif
+    PgsApi api{};
+    pgs_context *context = nullptr;
+    std::string deviceName;
+
+    // The queue: producers append records to pending under mutex, the GS GPU thread swaps it with working.
+    std::thread worker;
+    std::mutex mutex;
+    std::condition_variable wake, room, done;
+    std::vector<uint8_t> pending, working;
+    bool stop = false;
+    bool created = false;
+    std::string createError;
+    std::atomic<uint64_t> mutations{0u}; // records that may change local memory, queued so far
+
+    const GSRegisters *privRegs = nullptr;
+    uint32_t scanoutFlags = kScanoutForceProgressive | kScanoutAdaptHorizontal;
+    bool scanoutFromVram = false; // PS2X_GS_GPU_ESCANEO=vram: the CPU converts a copy of the GPU's local memory
+    bool translateCrtc = true;    // PS2X_GS_GPU_ESCANEO=crudo: the HLE's CRTC registers as they are
+
+    // Reads: a copy of local memory, refreshed when something was queued since.
+    mutable std::mutex readMutex;
+    mutable std::vector<uint8_t> vramCache;
+    mutable uint64_t cacheMutations = UINT64_MAX;
+    mutable GSCpuBackend view; // ReadVram/WriteVram/ClearFramebuffer in the GS layout, over a buffer
+
+    // Local -> host transfer (frontend thread, under the GS state lock).
+    GSTransferSnapshot transfer{};
+    bool localToHostActive = false;
+    bool localToHostFetched = false;
+    std::vector<uint8_t> localToHost;
+    size_t localToHostPos = 0u;
+
+    // Presentation.
+    std::mutex publishMutex;
+    PresentationFrame published;
+    uint64_t lastFrameSerial = 0u;
+    GSPresentationRequest lastScanoutRequest{};
+
+    // Statistics (the 10 s "[gs:gpu]" line).
+    std::atomic<uint64_t> statPackets{0u}, statBytes{0u}, statScanouts{0u}, statFrames{0u};
+    std::atomic<uint64_t> statVramReads{0u}, statVramRefreshes{0u}, statSnapshots{0u}, statLocalToHost{0u};
+    std::atomic<uint64_t> statLocalToHostBytes{0u}, statWaitNs{0u}, statPushNs{0u};
+    uint64_t busyNs = 0u; // GS GPU thread
+    int64_t reportAt = 0;
+
+    void push(Kind kind, uint32_t size, uint64_t arg, const void *payload, size_t payloadBytes)
+    {
+        const int64_t start = nowNs();
+        const size_t padded = (payloadBytes + 15u) & ~static_cast<size_t>(15u);
+        {
+            std::unique_lock<std::mutex> lock(mutex);
+            if (pending.size() > kMaxPending && !t_onGpuThread)
+            {
+                const int64_t waitStart = nowNs();
+                room.wait(lock, [&]() { return pending.size() <= kMaxPending || stop; });
+                statWaitNs.fetch_add(static_cast<uint64_t>(nowNs() - waitStart), std::memory_order_relaxed);
+            }
+            const size_t offset = pending.size();
+            pending.resize(offset + sizeof(Header) + padded);
+            Header header{kind, size, arg};
+            std::memcpy(pending.data() + offset, &header, sizeof(header));
+            if (payloadBytes != 0u)
+                std::memcpy(pending.data() + offset + sizeof(Header), payload, payloadBytes);
+            if (kind != Kind::Scanout)
+                mutations.fetch_add(1u, std::memory_order_relaxed);
+        }
+        wake.notify_one();
+        statPushNs.fetch_add(static_cast<uint64_t>(nowNs() - start), std::memory_order_relaxed);
+    }
+
+    // Runs fn on the GS GPU thread after everything queued so far, and waits for it.
+    void runSync(std::function<void()> fn)
+    {
+        if (t_onGpuThread)
+        {
+            fn();
+            return;
+        }
+        const int64_t start = nowNs();
+        SyncCall call{std::move(fn)};
+        push(Kind::Call, 0u, reinterpret_cast<uint64_t>(&call), nullptr, 0u);
+        std::unique_lock<std::mutex> lock(mutex);
+        done.wait(lock, [&]() { return call.done; });
+        statWaitNs.fetch_add(static_cast<uint64_t>(nowNs() - start), std::memory_order_relaxed);
+    }
+
+    void publish(PresentationFrame &&frame)
+    {
+        std::lock_guard<std::mutex> lock(publishMutex);
+        published = std::move(frame);
+    }
+
+    // The newest frame read back by the DLL (never waits for the GPU).
+    void pollFrame()
+    {
+        PgsFrame frame{};
+        if (!api.get_frame(context, 0, &frame) || frame.serial == lastFrameSerial || frame.rgba == nullptr)
+            return;
+        lastFrameSerial = frame.serial;
+        statFrames.fetch_add(1u, std::memory_order_relaxed);
+        PresentationFrame result{};
+        result.width = std::min(frame.width, kHostFrameWidth);
+        result.height = std::min(frame.height, kHostFrameHeight);
+        result.pixels.assign(static_cast<size_t>(kHostFrameWidth) * kHostFrameHeight * 4u, 0u);
+        for (uint32_t y = 0; y < result.height; ++y)
+        {
+            uint8_t *dst = result.pixels.data() + static_cast<size_t>(y) * kHostFrameWidth * 4u;
+            std::memcpy(dst, frame.rgba + static_cast<size_t>(y) * frame.width * 4u, result.width * 4u);
+            for (uint32_t x = 0; x < result.width; ++x)
+                dst[x * 4u + 3u] = 0xFFu;
+        }
+        result.displayFbp = static_cast<uint32_t>(lastScanoutRequest.dispfb1 & 0x1FFu);
+        result.sourceFbp = result.displayFbp;
+        static uint32_t s_sizeLogs = 0u, s_lastWidth = 0u, s_lastHeight = 0u;
+        if ((frame.width != s_lastWidth || frame.height != s_lastHeight) && s_sizeLogs < 20u)
+        {
+            ++s_sizeLogs;
+            std::fprintf(stderr, "[gs:gpu] fotograma: %ux%u (modo %ux%u, entrelazado=%u)\n", frame.width,
+                         frame.height, frame.mode_width, frame.mode_height, frame.interlaced);
+        }
+        s_lastWidth = frame.width;
+        s_lastHeight = frame.height;
+        publish(std::move(result));
+    }
+
+    void scanout(const ScanoutCommand &command)
+    {
+        statScanouts.fetch_add(1u, std::memory_order_relaxed);
+        lastScanoutRequest = command.request;
+        const GSPresentationRequest &request = command.request;
+        if (scanoutFromVram)
+        {
+            const void *mapped = api.map_vram_read(context, 0u, kVramSize);
+            if (mapped == nullptr)
+                return;
+            thread_local std::vector<uint8_t> copy;
+            copy.assign(static_cast<const uint8_t *>(mapped), static_cast<const uint8_t *>(mapped) + kVramSize);
+            thread_local GSCpuBackend converter;
+            converter.Initialize(copy.data(), static_cast<uint32_t>(copy.size()));
+            PresentationFrame frame = converter.Present(request);
+            if (frame)
+            {
+                statFrames.fetch_add(1u, std::memory_order_relaxed);
+                publish(std::move(frame));
+            }
+            return;
+        }
+        const uint64_t display = (request.pmode & 1u) != 0u ? request.display1 : request.display2;
+        PgsPrivRegs regs{request.pmode, smode1For(command.smode1, display), request.smode2, request.dispfb1,
+                         request.display1, request.dispfb2, request.display2, 0u, 0u, 0u, request.bgcolor};
+        if (translateCrtc && hleDisplayRegisters(request.smode2, display))
+        {
+            const bool pal = ((regs.smode1 >> 13u) & 3u) == 3u;
+            regs.smode2 = 1u; // INT, FFMD 0
+            regs.display1 = hardwareDisplay(request.display1, pal);
+            regs.display2 = hardwareDisplay(request.display2, pal);
+        }
+        static uint32_t s_modeLogs = 0u;
+        static PgsPrivRegs s_lastRegs{};
+        if (std::memcmp(&regs, &s_lastRegs, sizeof(regs)) != 0 && s_modeLogs < 20u)
+        {
+            ++s_modeLogs;
+            std::fprintf(stderr,
+                         "[gs:gpu] escaneo: SMODE1=0x%llx (registro 0x%llx) SMODE2=0x%llx PMODE=0x%llx DISPFB1=0x%llx "
+                         "DISPLAY1=0x%llx DISPFB2=0x%llx DISPLAY2=0x%llx\n",
+                         static_cast<unsigned long long>(regs.smode1), static_cast<unsigned long long>(command.smode1),
+                         static_cast<unsigned long long>(regs.smode2), static_cast<unsigned long long>(regs.pmode),
+                         static_cast<unsigned long long>(regs.dispfb1), static_cast<unsigned long long>(regs.display1),
+                         static_cast<unsigned long long>(regs.dispfb2), static_cast<unsigned long long>(regs.display2));
+        }
+        s_lastRegs = regs;
+        api.vsync(context, &regs, static_cast<uint32_t>(request.vsyncTick & 1u), scanoutFlags);
+    }
+
+    void report(int64_t now)
+    {
+        if (reportAt == 0)
+            reportAt = now;
+        const int64_t elapsed = now - reportAt;
+        if (elapsed < 10'000'000'000ll)
+            return;
+        reportAt = now;
+        const double seconds = static_cast<double>(elapsed) / 1e9;
+        const auto take = [](std::atomic<uint64_t> &value) { return value.exchange(0u, std::memory_order_relaxed); };
+        const uint64_t packets = take(statPackets), bytes = take(statBytes);
+        const uint64_t scanouts = take(statScanouts), frames = take(statFrames);
+        const uint64_t reads = take(statVramReads), refreshes = take(statVramRefreshes);
+        const uint64_t snapshots = take(statSnapshots), l2h = take(statLocalToHost), l2hBytes = take(statLocalToHostBytes);
+        const uint64_t waitNs = take(statWaitNs), pushNs = take(statPushNs);
+        std::fprintf(stderr,
+                     "[gs:gpu] 10 s: paquetes=%.0f/s %.2f MB/s escaneos=%.1f/s fotogramas=%.1f/s | lecturas: "
+                     "ReadVram=%llu (copias de VRAM %llu) SnapshotVram=%llu local->host=%llu (%llu bytes) | "
+                     "hilo GS GPU=%.0f ms (%.1f %%), encolar=%.0f ms, esperas por lecturas=%.0f ms\n",
+                     static_cast<double>(packets) / seconds, static_cast<double>(bytes) / seconds / 1e6,
+                     static_cast<double>(scanouts) / seconds, static_cast<double>(frames) / seconds,
+                     static_cast<unsigned long long>(reads), static_cast<unsigned long long>(refreshes),
+                     static_cast<unsigned long long>(snapshots), static_cast<unsigned long long>(l2h),
+                     static_cast<unsigned long long>(l2hBytes), static_cast<double>(busyNs) / 1e6,
+                     100.0 * static_cast<double>(busyNs) / static_cast<double>(elapsed),
+                     static_cast<double>(pushNs) / 1e6, static_cast<double>(waitNs) / 1e6);
+        busyNs = 0u;
+    }
+
+    void process(const std::vector<uint8_t> &records)
+    {
+        size_t offset = 0u;
+        while (offset + sizeof(Header) <= records.size())
+        {
+            Header header{};
+            std::memcpy(&header, records.data() + offset, sizeof(header));
+            const uint8_t *payload = records.data() + offset + sizeof(Header);
+            size_t payloadBytes = 0u;
+            switch (header.kind)
+            {
+            case Kind::Gif:
+                payloadBytes = header.size;
+                api.gif_transfer(context, kGifPath, payload, header.size);
+                // Our front-end parses every packet from its first tag and drops a truncated last one: so here.
+                api.reset_gif_path(context, kGifPath);
+                break;
+            case Kind::Register:
+                api.write_register(context, header.size, header.arg);
+                break;
+            case Kind::Scanout:
+            {
+                payloadBytes = sizeof(ScanoutCommand);
+                ScanoutCommand command;
+                std::memcpy(&command, payload, sizeof(command));
+                scanout(command);
+                break;
+            }
+            case Kind::Call:
+            {
+                auto *call = reinterpret_cast<SyncCall *>(header.arg);
+                call->fn();
+                {
+                    std::lock_guard<std::mutex> lock(mutex);
+                    call->done = true;
+                }
+                done.notify_all();
+                break;
+            }
+            }
+            offset += sizeof(Header) + ((payloadBytes + 15u) & ~static_cast<size_t>(15u));
+        }
+    }
+
+    void workerLoop()
+    {
+        t_onGpuThread = true;
+        nameThisThread();
+        char error[256] = {};
+        PgsCreateInfo info{sizeof(PgsCreateInfo), 1u, 0u};
+        context = api.create(&info, error, sizeof(error));
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            created = true;
+            if (context == nullptr)
+                createError = error[0] != '\0' ? error : "pgs_create fallo";
+            else
+                deviceName = api.device_name(context);
+        }
+        done.notify_all();
+        if (context == nullptr)
+            return;
+
+        for (;;)
+        {
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                if (pending.empty() && !stop)
+                    wake.wait_for(lock, std::chrono::milliseconds(2), [&]() { return !pending.empty() || stop; });
+                if (stop && pending.empty())
+                    break;
+                working.swap(pending);
+            }
+            room.notify_all();
+            const int64_t start = nowNs();
+            if (!working.empty())
+            {
+                process(working);
+                working.clear();
+            }
+            pollFrame();
+            const int64_t end = nowNs();
+            busyNs += static_cast<uint64_t>(end - start);
+            report(end);
+        }
+        api.destroy(context);
+        context = nullptr;
+    }
+
+    // Copies all of the GPU's local memory into vramCache (GS GPU thread).
+    void copyVram(std::vector<uint8_t> &out) const
+    {
+        const void *mapped = api.map_vram_read(context, 0u, kVramSize);
+        out.resize(kVramSize);
+        if (mapped != nullptr)
+            std::memcpy(out.data(), mapped, kVramSize);
+    }
+
+    // With readMutex held: vramCache up to date with everything queued so far.
+    void refreshCacheLocked()
+    {
+        const uint64_t queued = mutations.load(std::memory_order_relaxed);
+        if (cacheMutations == queued && !vramCache.empty())
+            return;
+        statVramRefreshes.fetch_add(1u, std::memory_order_relaxed);
+        if (vramCache.empty())
+        {
+            vramCache.resize(kVramSize);
+            view.Initialize(vramCache.data(), static_cast<uint32_t>(vramCache.size()));
+        }
+        runSync([&]() { copyVram(vramCache); });
+        cacheMutations = queued;
+    }
+
+    // Runs edit over the GPU's local memory, mapped for writing (GS GPU thread), as a GS-layout view.
+    void editVram(const std::function<void(GSCpuBackend &)> &edit)
+    {
+        runSync([&]() {
+            void *mapped = api.map_vram_write(context, 0u, kVramSize);
+            if (mapped == nullptr)
+                return;
+            GSCpuBackend target;
+            target.Initialize(static_cast<uint8_t *>(mapped), static_cast<uint32_t>(kVramSize));
+            edit(target);
+            api.end_vram_write(context, 0u, kVramSize);
+        });
+        mutations.fetch_add(1u, std::memory_order_relaxed);
+    }
+};
+
+std::unique_ptr<GSGpuBackend> GSGpuBackend::Create(const std::filesystem::path &dll, std::string &error)
+{
+    std::unique_ptr<GSGpuBackend> backend(new GSGpuBackend());
+    Impl &impl = *backend->m_impl;
+#if defined(_WIN32)
+    impl.module = LoadLibraryW(dll.wstring().c_str());
+    if (impl.module == nullptr)
+    {
+        error = "no se puede cargar " + dll.string() + " (error " + std::to_string(GetLastError()) + ")";
+        return nullptr;
+    }
+    const auto symbol = [&](const char *name) { return reinterpret_cast<void *>(GetProcAddress(impl.module, name)); };
+#else
+    impl.module = dlopen(dll.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (impl.module == nullptr)
+    {
+        error = "no se puede cargar " + dll.string();
+        return nullptr;
+    }
+    const auto symbol = [&](const char *name) { return dlsym(impl.module, name); };
+#endif
+    bool complete = true;
+    const auto resolve = [&](auto &function, const char *name) {
+        function = reinterpret_cast<std::remove_reference_t<decltype(function)>>(symbol(name));
+        complete = complete && function != nullptr;
+    };
+    PgsApi &api = impl.api;
+    resolve(api.api_version, "pgs_api_version");
+    resolve(api.create, "pgs_create");
+    resolve(api.destroy, "pgs_destroy");
+    resolve(api.device_name, "pgs_device_name");
+    resolve(api.gif_transfer, "pgs_gif_transfer");
+    resolve(api.write_register, "pgs_write_register");
+    resolve(api.reset_gif_path, "pgs_reset_gif_path");
+    resolve(api.flush, "pgs_flush");
+    resolve(api.map_vram_read, "pgs_map_vram_read");
+    resolve(api.map_vram_write, "pgs_map_vram_write");
+    resolve(api.end_vram_write, "pgs_end_vram_write");
+    resolve(api.read_transfer_fifo, "pgs_read_transfer_fifo");
+    resolve(api.vsync, "pgs_vsync");
+    resolve(api.get_frame, "pgs_get_frame");
+    resolve(api.get_stats, "pgs_get_stats");
+    if (!complete || api.api_version() != kPgsApiVersion)
+    {
+        error = dll.string() + " no tiene la API esperada (version " + std::to_string(kPgsApiVersion) + ")";
+        return nullptr;
+    }
+
+    if (const char *value = std::getenv("PS2X_GS_GPU_ESCANEO"))
+    {
+        impl.scanoutFromVram = std::strcmp(value, "vram") == 0;
+        impl.translateCrtc = std::strcmp(value, "crudo") != 0;
+    }
+    if (const char *value = std::getenv("PS2X_GS_GPU_BANDERAS")) // scanout flags of pgs_vsync (diagnosis)
+        impl.scanoutFlags = static_cast<uint32_t>(std::strtoul(value, nullptr, 0));
+
+    impl.worker = std::thread([&impl]() { impl.workerLoop(); });
+    {
+        std::unique_lock<std::mutex> lock(impl.mutex);
+        impl.done.wait(lock, [&]() { return impl.created; });
+    }
+    if (impl.context == nullptr)
+    {
+        error = impl.createError;
+        return nullptr; // the destructor joins the thread and unloads the DLL
+    }
+    return backend;
+}
+
+GSGpuBackend::GSGpuBackend() : m_impl(std::make_unique<Impl>()) {}
+
+GSGpuBackend::~GSGpuBackend()
+{
+    Impl &impl = *m_impl;
+    if (impl.worker.joinable())
+    {
+        {
+            std::lock_guard<std::mutex> lock(impl.mutex);
+            impl.stop = true;
+        }
+        impl.wake.notify_all();
+        impl.room.notify_all();
+        impl.worker.join();
+    }
+#if defined(_WIN32)
+    if (impl.module != nullptr)
+        FreeLibrary(impl.module);
+#else
+    if (impl.module != nullptr)
+        dlclose(impl.module);
+#endif
+}
