+            setCdPaths(disc, {}, 0u, mods);
+            const PS2VfsMounts mounts{disc, disc, disc / "mc0"};
+            PS2RomDevice rom;
+            PS2Vfs vfs;
+            t.IsTrue(readVfsFile(vfs, "cdrom0:\\MODDIR\\FILE.BIN;1", mounts, rom) == mod, "PS2Vfs: open/read give the mod");
+            t.IsTrue(readVfsFile(vfs, "cdrom0:\\MODDIR\\KEEP.BIN;1", mounts, rom) == keep, "PS2Vfs: other files unchanged");
+            PS2VfsStat status;
+            t.IsTrue(vfs.stat("cdrom0:\\MODDIR\\FILE.BIN;1", mounts, rom, status) && status.size == kModSize,
+                     "PS2Vfs: stat reports the mod size");
+            t.IsFalse(readVfsFile(vfs, "cdrom0:\\NEW.BIN;1", mounts, rom).has_value(), "PS2Vfs: a file only in mods is ignored");
+            t.IsFalse(vfs.stat("cdrom0:\\NEW.BIN;1", mounts, rom, status), "PS2Vfs: stat of a file only in mods fails");
+
+            EeCd ee;
+            t.Equals(ee.search("\\MODDIR\\FILE.BIN;1"), 1, "EE: sceCdSearchFile finds the overridden file");
+            t.Equals(ee.size(), kModSize, "EE: sceCdSearchFile returns the mod size");
+            t.Equals(ee.read(ee.lsn(), 4u), 1, "EE: sceCdRead of the mod succeeds");
+            t.IsTrue(ee.buffer(kModSize) == mod, "EE: sceCdRead returns the mod bytes");
+            t.Equals(ee.search("\\NEW.BIN;1"), 0, "EE: a file only in mods is not on the disc");
+
+            PS2Runtime runtime;
+            PS2IopHostAdapter adapter(runtime);
+            std::vector<uint8_t> module;
+            t.IsTrue(ps2x::iop::detail::IopModuleLoader::readWholeHostFile(adapter, "cdrom0:\\MODDIR\\FILE.BIN;1", module) &&
+                         module == mod,
+                     "IRX: a cdrom0: module is read from the mod");
+
+            const std::vector<std::string> expected = {
+                "[mods] " + (std::filesystem::path("moddir") / "File.Bin").string() + " -> " +
+                    absoluteText(mods / "moddir" / "File.Bin") + " (7000 bytes)",
+                "[mods] NEW.BIN no existe en el disco: se ignora",
+                "[mods] 1 archivos sustituidos desde " + absoluteText(mods),
+            };
+            t.IsTrue(PS2Runtime::cdModsReport() == expected, "one line per mod and the summary");
+        });
+
+        tc.Run("Image mode: a mod gets sectors after the volume, other files keep real LSNs and bytes", [](TestCase &t)
+        {
+            IoPathsGuard guard;
+            TempDir dir;
+            constexpr uint64_t prefix = 2u * kSector + 5u;
+            // The whole PVD volume is in the file, so its last sector can be read next to the first mod sector.
+            std::vector<uint8_t> volume = buildIso();
+            volume.resize(static_cast<size_t>(kVolumeSectors) * kSector, 0x5Au);
+            std::vector<uint8_t> bytes(static_cast<size_t>(prefix), 0xEEu);
+            bytes.insert(bytes.end(), volume.begin(), volume.end());
+            const std::filesystem::path iso = dir.path / "game.bin";
+            writeFile(iso, bytes);
+            const std::filesystem::path mods = dir.path / "mods";
+            const std::vector<uint8_t> mod = modBytes();
+            writeTree(mods / "dir" / "file.bin;1", mod); // lower case and the ISO version suffix
+            writeTree(mods / "NOPE.BIN", modBytes(10u));
+
+            CdvdHost host;
+            host.cdRoot = dir.path;
+            host.cdImage = iso;
+            host.imageOffset = prefix;
+            host.mods = mods;
+            CdvdHarness cd(host);
+            t.Equals(cd.searchFile("cdrom0:\\DIR\\FILE.BIN;1"), 1u, "IOP: the overridden file is found");
+            const uint32_t lsn = cd.memory.read32(cd.resultAddress);
+            t.IsTrue(lsn >= kVolumeSectors, "IOP: the mod lives after the image's last sector");
+            t.Equals(cd.memory.read32(cd.resultAddress + 4u), kModSize, "IOP: the mod size");
+            t.Equals(cd.read(lsn, 4u), 1u, "IOP: sceCdRead of the mod sectors succeeds");
+            t.IsTrue(cd.buffer(kModSize) == mod, "IOP: sceCdRead returns the mod bytes");
+            t.Equals(cd.searchFile("cdrom0:\\README.TXT;1"), 1u, "IOP: a file without mod is found");
+            t.Equals(cd.memory.read32(cd.resultAddress), kReadmeLsn, "IOP: a file without mod keeps its real LSN");
+            t.Equals(cd.read(kReadmeLsn, 1u), 1u, "IOP: the real sectors are read");
+            const std::vector<uint8_t> readme = cd.buffer(kReadme.size());
+            t.IsTrue(std::string(readme.begin(), readme.end()) == kReadme, "IOP: a file without mod keeps its bytes");
+            t.Equals(cd.searchFile("cdrom0:\\NOPE.BIN;1"), 0u, "IOP: a file only in mods is not on the disc");
+
+            setCdPaths(dir.path, iso, prefix, mods);
+            const std::shared_ptr<const IsoImage> image = PS2Runtime::cdIsoImage();
+            t.IsTrue(image != nullptr, "the shared image opens");
+            if (image)
+            {
+                const std::optional<IsoEntry> entry = image->lookup("dir/file.bin");
+                t.IsTrue(entry && entry->lsn == lsn && entry->size == kModSize,
+                         "the shared image maps the mod to the same LSN as the IOP");
+                std::vector<uint8_t> bytes;
+                t.IsTrue(image->readFile("\\DIR\\FILE.BIN;1", bytes) && bytes == mod, "readFile returns the mod");
+                std::vector<uint8_t> two(2u * kSector, 0xAAu);
+                t.Equals(lsn, kVolumeSectors, "the first mod starts right after the volume");
+                t.IsTrue(image->readSectors(lsn - 1u, 2u, two.data()), "a read across the image end succeeds");
+                t.IsTrue(two[0] == 0x5Au && two[kSector - 1u] == 0x5Au, "the last image sector has its bytes");
+                t.IsTrue(std::equal(mod.begin(), mod.begin() + kSector, two.begin() + kSector),
+                         "the sector after the image end is the mod's first sector");
+                std::vector<uint8_t> tail(kSector, 0xAAu);
+                t.IsTrue(image->readSectors(lsn + 3u, 1u, tail.data()), "the mod's last sector is read");
+                t.IsTrue(std::equal(mod.begin() + 3u * kSector, mod.end(), tail.begin()) &&
+                             std::all_of(tail.begin() + (kModSize - 3u * kSector), tail.end(), [](uint8_t b) { return b == 0u; }),
+                         "the mod's last sector is its bytes and then zeros");
+                std::vector<uint8_t> block(32u * kSector, 0xAAu);
+                t.IsTrue(image->readSectors(lsn + 2u, 32u, block.data()),
+                         "a block read past the end of the last mod succeeds, as on a disc");
+                t.IsTrue(std::equal(mod.begin() + 2u * kSector, mod.end(), block.begin()) &&
+                             std::all_of(block.begin() + (kModSize - 2u * kSector), block.end(), [](uint8_t b) { return b == 0u; }),
+                         "the mod's tail and the sectors after the last mod are zeros");
+                t.Equals(image->totalSectors(), kVolumeSectors + 4u + IsoImage::kModTailSectors,
+                         "the volume grows by the mod sectors and the zero tail");
+                t.IsFalse(image->readSectors(image->totalSectors() - 1u, 2u, tail.data()), "a read past the tail is refused");
+                t.IsTrue(image->lookup("\\README.TXT").has_value() && image->lookup("\\README.TXT")->lsn == kReadmeLsn,
+                         "a file without mod keeps its real LSN");
+            }
+
+            const PS2VfsMounts mounts{dir.path, dir.path, dir.path / "mc0"};
+            PS2RomDevice rom;
+            PS2Vfs vfs;
+            t.IsTrue(readVfsFile(vfs, "cdrom0:\\DIR\\FILE.BIN;1", mounts, rom) == mod, "PS2Vfs: open/read give the mod");
+            const std::optional<std::vector<uint8_t>> text = readVfsFile(vfs, "cdrom0:\\README.TXT;1", mounts, rom);
+            t.IsTrue(text && std::string(text->begin(), text->end()) == kReadme, "PS2Vfs: other files unchanged");
+            PS2VfsStat status;
+            t.IsTrue(vfs.stat("cdrom0:\\DIR\\FILE.BIN;1", mounts, rom, status) && status.size == kModSize,
+                     "PS2Vfs: stat reports the mod size");
+            t.IsFalse(readVfsFile(vfs, "cdrom0:\\NOPE.BIN", mounts, rom).has_value(), "PS2Vfs: a file only in mods is ignored");
+
+            EeCd ee;
+            t.Equals(ee.search("cdrom0:\\DIR\\FILE.BIN;1"), 1, "EE: sceCdSearchFile finds the overridden file");
+            t.IsTrue(ee.lsn() == lsn && ee.size() == kModSize, "EE: the same LSN and the mod size");
+            t.Equals(ee.read(lsn, 4u), 1, "EE: sceCdRead of the mod succeeds");
+            t.IsTrue(ee.buffer(kModSize) == mod, "EE: sceCdRead returns the mod bytes");
+            t.Equals(ee.search("\\README.TXT;1"), 1, "EE: a file without mod is found");
+            t.Equals(ee.lsn(), kReadmeLsn, "EE: a file without mod keeps its real LSN");
+
+            PS2Runtime runtime;
+            PS2IopHostAdapter adapter(runtime);
+            std::vector<uint8_t> module;
+            t.IsTrue(ps2x::iop::detail::IopModuleLoader::readWholeHostFile(adapter, "cdrom0:\\DIR\\FILE.BIN;1", module) &&
+                         module == mod,
+                     "IRX: a cdrom0: module is read from the mod");
+
+            const std::vector<std::string> report = PS2Runtime::cdModsReport();
+            t.Equals(report.size(), size_t{3u}, "one line per mod and the summary");
+            if (report.size() == 3u)
+            {
+                t.Equals(report[0], "[mods] " + (std::filesystem::path("dir") / "file.bin;1").string() + " -> " +
+                                        absoluteText(mods / "dir" / "file.bin;1") + " (7000 bytes)",
+                         "the overridden file line");
+                t.Equals(report[1], std::string("[mods] NOPE.BIN no existe en el disco: se ignora"), "the ignored line");
+                t.Equals(report[2], "[mods] 1 archivos sustituidos desde " + absoluteText(mods), "the summary");
+            }
+        });
+
+        tc.Run("Without mods (none, missing or empty folder) every read is the same as before", [](TestCase &t)
+        {
+            IoPathsGuard guard;
+            TempDir dir;
+            constexpr uint64_t prefix = 3u * kSector + 1u;
+            const std::filesystem::path iso = writeIso(dir, "game.bin", prefix);
+            const std::filesystem::path disc = dir.path / "disc";
+            writeTree(disc / "MODDIR" / "FILE.BIN", fileBytes());
+            std::filesystem::create_directories(dir.path / "empty");
+
+            // sceCdSearchFile + sceCdRead on the IOP, the shared image and PS2Vfs, as one comparable record.
+            const auto snapshot = [&](const std::filesystem::path &mods, bool imageMode)
+            {
+                std::vector<uint32_t> values;
+                std::vector<uint8_t> bytes;
+                CdvdHost host;
+                host.cdRoot = imageMode ? dir.path : disc;
+                host.cdImage = imageMode ? iso : std::filesystem::path{};
+                host.imageOffset = imageMode ? prefix : 0u;
+                host.mods = mods;
+                CdvdHarness cd(host);
+                const std::string file = imageMode ? "cdrom0:\\DIR\\FILE.BIN;1" : "cdrom0:\\MODDIR\\FILE.BIN;1";
+                values.push_back(cd.searchFile(file));
+                values.push_back(cd.memory.read32(cd.resultAddress));
+                values.push_back(cd.memory.read32(cd.resultAddress + 4u));
+                values.push_back(cd.read(cd.memory.read32(cd.resultAddress), 3u));
+                const std::vector<uint8_t> read = cd.buffer(3u * kSector);
+                bytes.insert(bytes.end(), read.begin(), read.end());
+                values.push_back(cd.read(16u, 1u));
+                const std::vector<uint8_t> pvd = cd.buffer(kSector);
+                bytes.insert(bytes.end(), pvd.begin(), pvd.end());
+
+                setCdPaths(imageMode ? dir.path : disc, imageMode ? iso : std::filesystem::path{}, imageMode ? prefix : 0u,
+                           mods);
+                if (const std::shared_ptr<const IsoImage> image = PS2Runtime::cdIsoImage())
+                {
+                    values.push_back(image->totalSectors());
+                    values.push_back(image->lookup(file)->lsn);
+                }
+                const PS2VfsMounts mounts{host.cdRoot, host.cdRoot, host.cdRoot / "mc0"};
+                PS2RomDevice rom;
+                PS2Vfs vfs;
+                const std::optional<std::vector<uint8_t>> whole = readVfsFile(vfs, file, mounts, rom);
+                values.push_back(whole ? static_cast<uint32_t>(whole->size()) : 0xFFFFFFFFu);
+                if (whole)
+                    bytes.insert(bytes.end(), whole->begin(), whole->end());
+                values.push_back(static_cast<uint32_t>(PS2Runtime::cdModsReport().size()));
+                return std::make_pair(values, bytes);
+            };
+
+            for (const bool imageMode : {false, true})
+            {
+                const std::string mode = imageMode ? "image" : "folder";
+                const auto base = snapshot({}, imageMode);
+                t.Equals(base.first.front(), 1u, mode + ": the file is found without mods");
+                t.IsTrue(snapshot(dir.path / "missing", imageMode) == base, mode + ": a missing mods folder changes nothing");
+                t.IsTrue(snapshot(dir.path / "empty", imageMode) == base, mode + ": an empty mods folder changes nothing");
+                t.Equals(base.first.back(), 0u, mode + ": no [mods] lines without mods");
+            }
+            const auto image = snapshot(dir.path / "empty", true);
+            t.IsTrue(std::find(image.first.begin(), image.first.end(), kVolumeSectors) != image.first.end(),
+                     "image: the volume keeps its PVD size");
+        });
+
+        tc.Run("The mods folder: none in development, the given one, PS2X_MODS above both", [](TestCase &t)
+        {
+            IoPathsGuard guard;
+            TempDir dir;
+            const std::string elf = (dir.path / "GAME.ELF").string();
+            const std::filesystem::path given = dir.path / "mods";
+            const std::filesystem::path forced = dir.path / "forced";
+            const std::filesystem::path iso = writeIso(dir, "game.iso", 0u);
+            _putenv_s("PS2X_MODS", "");
+            _putenv_s("PS2X_ISO", "");
+            _putenv_s("PS2X_TARJETAS", "");
+
+            setCdPaths(dir.path, {}, 0u);
+            PS2Runtime::configureIoPathsFromElf(elf);
+            t.IsTrue(PS2Runtime::getIoPaths().modsRoot.empty(), "development mode has no mods folder");
+            PS2Runtime::configureIoPathsFromElf(elf, {}, given);
+            t.Equals(PS2Runtime::getIoPaths().modsRoot.string(), absoluteText(given), "the given mods folder is used");
+            PS2Runtime::configureIoPathsFromElf(elf);
+            t.Equals(PS2Runtime::getIoPaths().modsRoot.string(), absoluteText(given),
+                     "loading the ELF again keeps the mods folder");
+
+            _putenv_s("PS2X_MODS", forced.string().c_str());
+            setCdPaths(dir.path, {}, 0u);
+            PS2Runtime::configureIoPathsFromElf(elf);
+            t.Equals(PS2Runtime::getIoPaths().modsRoot.string(), absoluteText(forced), "PS2X_MODS in development mode");
+            PS2Runtime::configureIoPathsFromElf(elf, {}, given);
+            t.Equals(PS2Runtime::getIoPaths().modsRoot.string(), absoluteText(forced), "PS2X_MODS wins over the folder");
+            PS2Runtime::configureIoPathsForImage(iso, 0u, dir.path, "GAME.ELF", {}, given);
+            t.Equals(PS2Runtime::getIoPaths().modsRoot.string(), absoluteText(forced), "PS2X_MODS wins in image mode");
+            _putenv_s("PS2X_MODS", "");
+            PS2Runtime::configureIoPathsForImage(iso, 0u, dir.path, "GAME.ELF", {}, given);
+            t.Equals(PS2Runtime::getIoPaths().modsRoot.string(), absoluteText(given), "image mode uses the given folder");
+        });
+    });
 }
