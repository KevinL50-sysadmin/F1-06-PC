diff --git a/ps2xRuntime/src/lib/ps2_replay_scrub.h b/ps2xRuntime/src/lib/ps2_replay_scrub.h
new file mode 100644
index 0000000..2bfbfd1
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_replay_scrub.h
@@ -0,0 +1,168 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+// Fase 5 (T14, F1 06): rewind, fast-forward and pause in the game's own replay. The game does not keep the cars'
+// positions: it keeps the pad inputs of the last 1920 steps and two snapshots of the whole race state, and its replay
+// restores the oldest snapshot and simulates again from the inputs, looping at the end (src/f1_overrides.cpp). So:
+// pause = no steps; fast-forward = more steps per frame; rewind = start the replay again (the game's own loop) and run
+// the steps up to the earlier position within one frame, without drawing them. A step costs the PC about 3 ms, so
+// rewind held only moves the target (the picture stays still) and the replay goes there once, when it is let go.
+// The window reads the keys and the pad (ps2_runtime.cpp); the game's thread plans each frame's steps (ReplayScrubber).
+namespace ps2x
+{
+    constexpr double kReplayRewindJump = 2.0;     // seconds of replay back at once and each kReplayRewindRepeat held
+    constexpr double kReplayRewindRepeat = 0.25;
+    constexpr double kReplayFasterAfter = 1.0;    // fast-forward held this long goes from x2 to x4
+    constexpr double kReplayMuteAfterSeek = 0.3;  // the sound stays off this long after the jump back
+    constexpr double kReplayActiveWindow = 1.0;   // the replay counts as on while the game saw it this recently
+
+    // What the player holds (pausePresses counts the pause key's presses, so none is lost between two game frames).
+    struct ReplayScrubControls
+    {
+        bool rewind = false;
+        bool fastForward = false;
+        uint32_t pausePresses = 0u;
+    };
+
+    // The game's replay cursor, in steps: position from 0 (the replay's start) to length - 1.
+    struct ReplayPosition
+    {
+        int32_t position = 0;
+        int32_t length = 0;
+    };
+
+    // One frame: run steps simulation steps; with restart, first put the cursor on the replay's last step, so the
+    // first step makes the game start the replay again (cursor 0) and the rest bring it to target. While rewind is
+    // held, target is where it will go.
+    struct ReplayStepPlan
+    {
+        uint32_t steps = 0u;
+        bool restart = false;
+        int32_t target = -1;
+        int speed = 1; // 0 paused, 1, 2 or 4; -1 rewinding
+    };
+
+    inline bool validReplayPosition(const ReplayPosition &p)
+    {
+        return p.length > 0 && p.position >= 0 && p.position < p.length;
+    }
+
+    // Steps for a number of replay seconds (at least one).
+    inline int32_t replaySteps(double seconds, double stepsPerSecond)
+    {
+        const double sps = std::isfinite(stepsPerSecond) && stepsPerSecond > 0.0 ? stepsPerSecond : 50.0;
+        return std::max<int32_t>(1, static_cast<int32_t>(std::lround(seconds * sps)));
+    }
+
+    class ReplayScrubber
+    {
+    public:
+        // n: the steps the game would run this frame (the VBLANKs since its last one); now: seconds, any clock.
+        ReplayStepPlan plan(const ReplayScrubControls &c, const ReplayPosition &p, uint32_t n, double stepsPerSecond,
+                            double now)
+        {
+            ReplayStepPlan out;
+            out.steps = n;
+            if (!m_synced)
+            {
+                m_synced = true;
+                m_presses = c.pausePresses;
+            }
+            if (((c.pausePresses - m_presses) & 1u) != 0u)
+                m_paused = !m_paused;
+            m_presses = c.pausePresses;
+            if (!validReplayPosition(p))
+                return out;
+
+            if (c.rewind)
+            {
+                const int32_t jump = replaySteps(kReplayRewindJump, stepsPerSecond);
+                if (!m_rewinding)
+                {
+                    m_rewinding = true;
+                    m_lastJump = now;
+                    m_target = std::max<int32_t>(0, p.position - jump);
+                }
+                else if (now - m_lastJump >= kReplayRewindRepeat)
+                {
+                    m_lastJump = now;
+                    m_target = std::max<int32_t>(0, m_target - jump);
+                }
+                out.steps = 0u;
+                out.target = m_target;
+                out.speed = -1;
+                return out;
+            }
+            if (m_rewinding)
+            {
+                m_rewinding = false;
+                m_seeking = true;
+                out.restart = true;
+                out.target = std::min(m_target, p.length - 1);
+                out.steps = static_cast<uint32_t>(out.target) + 1u;
+                out.speed = -1;
+                return out;
+            }
+
+            // The frame after the jump took long: the game would make up for it with as many steps.
+            uint32_t own = n;
+            if (m_seeking)
+            {
+                m_seeking = false;
+                m_mutedUntil = now + kReplayMuteAfterSeek;
+                own = std::min<uint32_t>(n, 1u);
+            }
+            if (c.fastForward)
+            {
+                if (m_fastSince < 0.0)
+                    m_fastSince = now;
+                out.speed = now - m_fastSince >= kReplayFasterAfter ? 4 : 2;
+                out.steps = own * static_cast<uint32_t>(out.speed);
+                return out;
+            }
+            m_fastSince = -1.0;
+            out.speed = m_paused ? 0 : 1;
+            out.steps = m_paused ? 0u : own;
+            return out;
+        }
+
+        bool paused() const { return m_paused; }
+        // The sound: off while paused, rewinding, going there and a moment after.
+        bool muted(double now) const
+        {
+            return m_paused || m_rewinding || m_seeking || now < m_mutedUntil;
+        }
+        // Out of the replay: it starts again playing.
+        void reset()
+        {
+            *this = ReplayScrubber();
+        }
+
+    private:
+        bool m_synced = false;
+        uint32_t m_presses = 0u;
+        bool m_paused = false;
+        bool m_rewinding = false;
+        bool m_seeking = false;
+        int32_t m_target = 0;
+        double m_lastJump = 0.0;
+        double m_mutedUntil = -1.0;
+        double m_fastSince = -1.0;
+    };
+
+    // The shared state (ps2_runtime.cpp; any thread). The game's thread: replayScrubSeen on each frame of a replay
+    // (with its position, or where rewind goes, in steps, and the steps per second), replayScrubControls,
+    // setReplayScrubState and setReplayScrubSeeking around the long frame of the jump back. The window:
+    // replayScrubActive (also during that frame), setReplayScrubControls. The pad (ps2_pad.cpp) hides L2, R2 and SELECT
+    // from the game while it is on, and the sound is off while replayScrubMuted.
+    void replayScrubSeen(const ReplayPosition &position, double stepsPerSecond);
+    bool replayScrubActive();
+    void setReplayScrubControls(bool rewind, bool fastForward, bool pausePressed);
+    ReplayScrubControls replayScrubControls();
+    void setReplayScrubState(int speed, bool muted);
+    void setReplayScrubSeeking(bool seeking);
+    bool replayScrubMuted();
+}
