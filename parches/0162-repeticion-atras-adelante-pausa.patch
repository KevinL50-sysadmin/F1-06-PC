+// Fase 5 (T14): rewind, fast-forward and pause in the game's replay (ps2_replay_scrub.h). The game's thread says when a
+// replay is playing and where (src/f1_overrides.cpp); the window reads J (rewind), L (fast-forward) and K (pause), or
+// the pad's L2, R2 and SELECT, only then and never with the options menu open, and shows a line when the speed changes.
+namespace
+{
+    std::mutex g_replayScrubMutex;
+    ps2x::ReplayScrubControls g_replayScrubControls;
+    ps2x::ReplayPosition g_replayScrubPosition;
+    double g_replayScrubStepsPerSecond = 50.0;
+    double g_replayScrubSeen = -1.0;
+    int g_replayScrubSpeed = 1;
+    std::atomic<bool> g_replayScrubMuted{false};
+    std::atomic<bool> g_replayScrubSeeking{false};
+}
+
+namespace ps2x
+{
+    void replayScrubSeen(const ReplayPosition &position, double stepsPerSecond)
+    {
+        std::lock_guard<std::mutex> lock(g_replayScrubMutex);
+        g_replayScrubPosition = position;
+        g_replayScrubStepsPerSecond = stepsPerSecond;
+        g_replayScrubSeen = PhotoModeClock();
+    }
+
+    bool replayScrubActive()
+    {
+        if (g_replayScrubSeeking.load(std::memory_order_relaxed))
+            return true;
+        std::lock_guard<std::mutex> lock(g_replayScrubMutex);
+        return g_replayScrubSeen >= 0.0 && PhotoModeClock() - g_replayScrubSeen <= kReplayActiveWindow;
+    }
+
+    void setReplayScrubControls(bool rewind, bool fastForward, bool pausePressed)
+    {
+        std::lock_guard<std::mutex> lock(g_replayScrubMutex);
+        g_replayScrubControls.rewind = rewind;
+        g_replayScrubControls.fastForward = fastForward;
+        if (pausePressed)
+            ++g_replayScrubControls.pausePresses;
+    }
+
+    ReplayScrubControls replayScrubControls()
+    {
+        std::lock_guard<std::mutex> lock(g_replayScrubMutex);
+        return g_replayScrubControls;
+    }
+
+    void setReplayScrubState(int speed, bool muted)
+    {
+        {
+            std::lock_guard<std::mutex> lock(g_replayScrubMutex);
+            g_replayScrubSpeed = speed;
+        }
+        g_replayScrubMuted.store(muted, std::memory_order_relaxed);
+    }
+
+    void setReplayScrubSeeking(bool seeking)
+    {
+        if (!seeking && g_replayScrubSeeking.load(std::memory_order_relaxed))
+        {
+            // Seen now: the long frame does not count against kReplayActiveWindow.
+            std::lock_guard<std::mutex> lock(g_replayScrubMutex);
+            g_replayScrubSeen = PhotoModeClock();
+        }
+        g_replayScrubSeeking.store(seeking, std::memory_order_relaxed);
+    }
+
+    bool replayScrubMuted()
+    {
+        return g_replayScrubMuted.load(std::memory_order_relaxed) || g_replayScrubSeeking.load(std::memory_order_relaxed);
+    }
+}
+
+// The window's part, once per frame (main thread).
+static void UpdateReplayScrub(bool optionsMenuOpen)
+{
+    static int s_shownSpeed = 1;
+    static int32_t s_shownTarget = -1;
+    static bool s_wasActive = false;
+    const bool active = ps2x::replayScrubActive() && !ps2x::photoModeActive();
+    if (!active)
+    {
+        if (s_wasActive)
+            ps2x::setReplayScrubControls(false, false, false);
+        s_wasActive = false;
+        s_shownSpeed = 1;
+        s_shownTarget = -1;
+        g_replayScrubMuted.store(false, std::memory_order_relaxed);
+        return;
+    }
+    if (!s_wasActive)
+        std::cout << "[repeticion] controles: J atras, L adelante (x2, x4), K pausa; mando L2, R2, SELECT" << std::endl;
+    s_wasActive = true;
+    bool rewind = false, fastForward = false, pause = false;
+    if (!optionsMenuOpen)
+    {
+        const ps2x::PhotoModePad pad = ps2x::readPhotoModePad();
+        constexpr uint16_t kSelect = 1u << 0, kL2 = 1u << 8, kR2 = 1u << 9;
+        static bool s_selectHeld = false;
+        const bool select = (pad.pressed & kSelect) != 0u;
+        rewind = IsKeyDown(KEY_J) || (pad.pressed & kL2) != 0u;
+        fastForward = !rewind && (IsKeyDown(KEY_L) || (pad.pressed & kR2) != 0u);
+        pause = IsKeyPressed(KEY_K) || (select && !s_selectHeld);
+        s_selectHeld = select;
+    }
+    ps2x::setReplayScrubControls(rewind, fastForward, pause);
+
+    int speed = 1;
+    ps2x::ReplayPosition position;
+    double stepsPerSecond = 50.0;
+    {
+        std::lock_guard<std::mutex> lock(g_replayScrubMutex);
+        speed = g_replayScrubSpeed;
+        position = g_replayScrubPosition;
+        stepsPerSecond = g_replayScrubStepsPerSecond > 0.0 ? g_replayScrubStepsPerSecond : 50.0;
+    }
+    // Rewind held: a line each time the target moves.
+    if (speed == s_shownSpeed && (speed != -1 || position.position == s_shownTarget))
+        return;
+    s_shownSpeed = speed;
+    s_shownTarget = position.position;
+    char line[160];
+    const char *what = speed == 0    ? "pausa (K o SELECT sigue)"
+                       : speed == -1 ? "atras, hasta"
+                       : speed == 2  ? "adelante x2"
+                       : speed == 4  ? "adelante x4"
+                                     : "normal";
+    std::snprintf(line, sizeof(line), "Repeticion: %s  %.1f / %.1f s", what, position.position / stepsPerSecond,
+                  position.length / stepsPerSecond);
+    std::cout << "[repeticion] " << line << std::endl;
+    SetPhotoMessage(line);
+}
