diff --git a/ps2xTest/src/ps2_high_ram_tests.cpp b/ps2xTest/src/ps2_high_ram_tests.cpp
new file mode 100644
index 0000000..7cb65fc
--- /dev/null
+++ b/ps2xTest/src/ps2_high_ram_tests.cpp
@@ -0,0 +1,179 @@
+#include "MiniTest.h"
+#include "ps2_high_ram.h"
+#include "runtime/ps2_memory.h"
+
+#include <sstream>
+#include <string>
+
+// RAM extra (parche 0181): the allocator of the high region (above what the game sees), tested on a small region.
+namespace
+{
+    using ps2x::HighRamAllocator;
+
+    constexpr uint32_t kBase = 0x00001000u;
+    constexpr uint32_t kSize = 0x00000400u; // 16 blocks of 64 bytes
+
+    std::string reportOf(const HighRamAllocator &allocator)
+    {
+        std::ostringstream out;
+        allocator.report(out);
+        return out.str();
+    }
+
+    // Three 0x100-byte blocks A, B, C at the start of the region and a 0x100-byte hole after C.
+    struct ThreeBlocks
+    {
+        HighRamAllocator allocator{kBase, kSize};
+        uint32_t a = allocator.allocate(0x100u);
+        uint32_t b = allocator.allocate(0x100u);
+        uint32_t c = allocator.allocate(0x100u);
+    };
+}
+
+void register_ps2_high_ram_tests()
+{
+    MiniTest::Case("HighRamAllocator", [](TestCase &tc)
+    {
+        tc.Run("a fresh region is one hole with nothing used", [](TestCase &t)
+        {
+            const HighRamAllocator allocator{kBase, kSize};
+            const HighRamAllocator::Stats s = allocator.stats();
+            t.Equals(s.used, 0u, "used");
+            t.Equals(s.peak, 0u, "peak");
+            t.Equals(s.blocks, 0u, "blocks");
+            t.Equals(s.holes, 1u, "holes");
+            t.Equals(s.largestFree, kSize, "largest hole");
+            t.Equals(reportOf(allocator), std::string("usados=0 pico=0 bloques=0 mayor_libre=1024"), "report");
+        });
+
+        tc.Run("blocks are 64-byte aligned and sizes round up to 64 bytes", [](TestCase &t)
+        {
+            HighRamAllocator allocator{kBase, kSize};
+            t.Equals(allocator.allocate(1u), kBase, "1 byte at the base");
+            t.Equals(allocator.allocate(65u), kBase + 0x40u, "65 bytes after one block");
+            t.Equals(allocator.allocate(64u), kBase + 0xC0u, "65 bytes took two blocks");
+            const HighRamAllocator::Stats s = allocator.stats();
+            t.Equals(s.used, 0x100u, "used counts the rounded sizes");
+            t.Equals(s.blocks, 3u, "blocks");
+            t.Equals(s.largestFree, kSize - 0x100u, "largest hole");
+        });
+
+        tc.Run("allocation is first fit", [](TestCase &t)
+        {
+            ThreeBlocks r;
+            t.IsTrue(r.allocator.release(r.b), "release B");
+            t.Equals(r.allocator.allocate(0x40u), r.b, "the first hole (B) wins over the tail hole");
+            t.Equals(r.allocator.allocate(0x40u), r.b + 0x40u, "then the rest of B");
+            t.Equals(r.allocator.allocate(0x100u), r.c + 0x100u, "a block that does not fit in B goes to the tail");
+        });
+
+        tc.Run("a released block merges with the next hole", [](TestCase &t)
+        {
+            ThreeBlocks r;
+            t.IsTrue(r.allocator.release(r.c), "release C");
+            const HighRamAllocator::Stats s = r.allocator.stats();
+            t.Equals(s.holes, 1u, "C and the tail are one hole");
+            t.Equals(s.largestFree, 0x200u, "largest hole");
+            t.Equals(r.allocator.allocate(0x200u), r.c, "the merged hole holds 0x200 bytes at C");
+        });
+
+        tc.Run("a released block merges with the previous hole", [](TestCase &t)
+        {
+            ThreeBlocks r;
+            t.IsTrue(r.allocator.release(r.a), "release A");
+            t.IsTrue(r.allocator.release(r.b), "release B");
+            const HighRamAllocator::Stats s = r.allocator.stats();
+            t.Equals(s.holes, 2u, "A+B and the tail");
+            t.Equals(s.largestFree, 0x200u, "largest hole");
+            t.Equals(r.allocator.allocate(0x200u), r.a, "the merged hole holds 0x200 bytes at A");
+        });
+
+        tc.Run("a released block merges with both neighbours", [](TestCase &t)
+        {
+            ThreeBlocks r;
+            t.IsTrue(r.allocator.release(r.a), "release A");
+            t.IsTrue(r.allocator.release(r.c), "release C");
+            t.Equals(r.allocator.stats().holes, 2u, "A and C+tail before B");
+            t.IsTrue(r.allocator.release(r.b), "release B");
+            const HighRamAllocator::Stats s = r.allocator.stats();
+            t.Equals(s.holes, 1u, "the whole region is one hole again");
+            t.Equals(s.largestFree, kSize, "largest hole");
+            t.Equals(s.used, 0u, "used");
+            t.Equals(s.blocks, 0u, "blocks");
+            t.Equals(r.allocator.allocate(kSize), kBase, "the whole region fits again");
+        });
+
+        tc.Run("a double free is not owned and changes nothing", [](TestCase &t)
+        {
+            ThreeBlocks r;
+            t.IsTrue(r.allocator.release(r.b), "first release");
+            const std::string before = reportOf(r.allocator);
+            const uint32_t holes = r.allocator.stats().holes;
+            t.IsFalse(r.allocator.release(r.b), "second release is not owned");
+            t.Equals(reportOf(r.allocator), before, "stats unchanged");
+            t.Equals(r.allocator.stats().holes, holes, "holes unchanged");
+        });
+
+        tc.Run("interior and unknown pointers are not owned and change nothing", [](TestCase &t)
+        {
+            ThreeBlocks r;
+            const std::string before = reportOf(r.allocator);
+            t.IsFalse(r.allocator.release(r.a + 0x40u), "interior of A");
+            t.IsFalse(r.allocator.release(r.c + 0x100u), "start of the tail hole");
+            t.IsFalse(r.allocator.release(kBase + kSize), "end of the region");
+            t.IsFalse(r.allocator.release(0u), "null");
+            t.Equals(reportOf(r.allocator), before, "stats unchanged");
+            t.IsTrue(r.allocator.release(r.a), "A is still owned");
+        });
+
+        tc.Run("exhaustion returns 0 and changes nothing", [](TestCase &t)
+        {
+            HighRamAllocator allocator{kBase, kSize};
+            t.Equals(allocator.allocate(kSize + HighRamAllocator::kAlignment), 0u, "size + one block");
+            t.Equals(allocator.allocate(kSize + 1u), 0u, "size + one byte");
+            t.Equals(allocator.allocate(0xFFFFFFFFu), 0u, "huge size does not wrap");
+            t.Equals(allocator.allocate(0u), 0u, "zero bytes");
+            t.Equals(reportOf(allocator), std::string("usados=0 pico=0 bloques=0 mayor_libre=1024"), "nothing used");
+            t.Equals(allocator.allocate(kSize - 0x40u), kBase, "all but one block");
+            t.Equals(allocator.allocate(0x80u), 0u, "two blocks do not fit in the last one");
+            t.Equals(allocator.allocate(0x40u), kBase + kSize - 0x40u, "the last block");
+            const std::string full = reportOf(allocator);
+            t.Equals(allocator.allocate(1u), 0u, "a full region");
+            t.Equals(reportOf(allocator), full, "a failed allocation changes nothing");
+            t.Equals(allocator.stats().holes, 0u, "no holes");
+        });
+
+        tc.Run("contains covers exactly the region", [](TestCase &t)
+        {
+            const HighRamAllocator allocator{kBase, kSize};
+            t.IsFalse(allocator.contains(kBase - 1u), "below");
+            t.IsTrue(allocator.contains(kBase), "base");
+            t.IsTrue(allocator.contains(kBase + kSize - 1u), "last byte");
+            t.IsFalse(allocator.contains(kBase + kSize), "end");
+        });
+
+        tc.Run("stats keep the peak and the largest hole", [](TestCase &t)
+        {
+            ThreeBlocks r;
+            t.Equals(r.allocator.stats().peak, 0x300u, "peak after three blocks");
+            t.IsTrue(r.allocator.release(r.b), "release B");
+            t.IsTrue(r.allocator.release(r.c), "release C");
+            const HighRamAllocator::Stats s = r.allocator.stats();
+            t.Equals(s.used, 0x100u, "used");
+            t.Equals(s.peak, 0x300u, "the peak stays");
+            t.Equals(s.blocks, 1u, "blocks");
+            t.Equals(s.largestFree, 0x300u, "B+C+tail");
+            t.Equals(reportOf(r.allocator), std::string("usados=256 pico=768 bloques=1 mayor_libre=768"), "report");
+        });
+
+        tc.Run("the game's high region is 0x2000000-0x3FFFFFF", [](TestCase &t)
+        {
+            HighRamAllocator allocator{PS2_GUEST_RAM_SIZE, PS2_RAM_SIZE - PS2_GUEST_RAM_SIZE};
+            t.IsFalse(allocator.contains(0x01FFFFFFu), "below 32 MB");
+            t.IsTrue(allocator.contains(0x02000000u), "32 MB");
+            t.IsTrue(allocator.contains(0x03FFFFFFu), "last byte");
+            t.Equals(allocator.allocate(0x00200000u), 0x02000000u, "first block at 32 MB");
+            t.Equals(allocator.stats().largestFree, 0x01E00000u, "the rest");
+        });
+    });
+}
