index 0000000..6c2730e
--- /dev/null
+++ b/ps2xRuntime/include/ps2_high_ram.h
@@ -0,0 +1,127 @@
+#ifndef PS2_HIGH_RAM_H
+#define PS2_HIGH_RAM_H
+
+#include <algorithm>
+#include <cstdint>
+#include <iterator>
+#include <map>
+#include <mutex>
+#include <ostream>
+
+namespace ps2x
+{
+    // RAM extra (F1 06, parche 0181): allocator for a region of the reserved RAM that the game does not see (the game
+    // sees PS2_GUEST_RAM_SIZE; the region above it, up to PS2_RAM_SIZE, belongs to the port). First fit over a list of
+    // holes sorted by address, blocks rounded up to 64 bytes, holes merged with both neighbours on release. The
+    // bookkeeping lives on the PC (nothing is written to guest RAM). `base` must be non-zero and 64-byte aligned:
+    // allocate returns 0 when nothing fits, so the caller can fall back to the game's own allocator.
+    class HighRamAllocator
+    {
+    public:
+        static constexpr uint32_t kAlignment = 64u;
+
+        struct Stats
+        {
+            uint32_t used = 0u;        // bytes in blocks (rounded sizes)
+            uint32_t peak = 0u;        // maximum of `used`
+            uint32_t blocks = 0u;      // live blocks
+            uint32_t holes = 0u;       // free holes
+            uint32_t largestFree = 0u; // largest hole
+        };
+
+        HighRamAllocator(uint32_t base, uint32_t size) : m_base(base), m_end(base + size)
+        {
+            if (size != 0u)
+                m_free.emplace(base, size);
+        }
+
+        [[nodiscard]] bool contains(uint32_t address) const
+        {
+            return address >= m_base && address < m_end;
+        }
+
+        // A block of at least `size` bytes, or 0 when it does not fit (nothing changes then).
+        uint32_t allocate(uint32_t size)
+        {
+            if (size == 0u || size > m_end - m_base)
+                return 0u;
+            const uint32_t rounded = (size + kAlignment - 1u) & ~(kAlignment - 1u);
+            std::lock_guard<std::mutex> lock(m_mutex);
+            for (auto it = m_free.begin(); it != m_free.end(); ++it)
+            {
+                if (it->second < rounded)
+                    continue;
+                const uint32_t start = it->first, rest = it->second - rounded;
+                m_free.erase(it);
+                if (rest != 0u)
+                    m_free.emplace(start + rounded, rest);
+                m_used.emplace(start, rounded);
+                m_usedBytes += rounded;
+                m_peak = std::max(m_peak, m_usedBytes);
+                return start;
+            }
+            return 0u;
+        }
+
+        // Releases the block that starts at `address`; false (and nothing changes) when it is not a live block of
+        // this allocator: an unknown or interior pointer, or a block already released.
+        bool release(uint32_t address)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            const auto it = m_used.find(address);
+            if (it == m_used.end())
+                return false;
+            uint32_t start = it->first, size = it->second;
+            m_used.erase(it);
+            m_usedBytes -= size;
+            auto next = m_free.lower_bound(start);
+            if (next != m_free.end() && start + size == next->first)
+            {
+                size += next->second;
+                next = m_free.erase(next);
+            }
+            if (next != m_free.begin())
+            {
+                const auto previous = std::prev(next);
+                if (previous->first + previous->second == start)
+                {
+                    previous->second += size;
+                    return true;
+                }
+            }
+            m_free.emplace(start, size);
+            return true;
+        }
+
+        [[nodiscard]] Stats stats() const
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            Stats s;
+            s.used = m_usedBytes;
+            s.peak = m_peak;
+            s.blocks = static_cast<uint32_t>(m_used.size());
+            s.holes = static_cast<uint32_t>(m_free.size());
+            for (const auto &hole : m_free)
+                s.largestFree = std::max(s.largestFree, hole.second);
+            return s;
+        }
+
+        // The stats as the port's log lines print them: "usados=.. pico=.. bloques=.. mayor_libre=..".
+        void report(std::ostream &out) const
+        {
+            const Stats s = stats();
+            out << "usados=" << s.used << " pico=" << s.peak << " bloques=" << s.blocks << " mayor_libre=" << s.largestFree;
+        }
+
+    private:
+        const uint32_t m_base;
+        const uint32_t m_end;
+        mutable std::mutex m_mutex;
+        std::map<uint32_t, uint32_t> m_free; // start -> size
+        std::map<uint32_t, uint32_t> m_used; // start -> rounded size
+        uint32_t m_usedBytes = 0u;
+        uint32_t m_peak = 0u;
+    };
+}
+
+#endif // PS2_HIGH_RAM_H
