+// Debug (F1 06): last VIF1 'i' bits with the mark that belongs to each one (a MARK with the 'i' bit sets its own
+// value first). The interrupt handler runs after the whole transfer and reads VIF1_MARK then.
+namespace
+{
+    struct Vif1IrqNote
+    {
+        uint64_t index = 0;
+        uint32_t cmd = 0;
+        uint32_t mark = 0;
+    };
+    Vif1IrqNote g_vif1IrqNotes[64];
+    uint64_t g_vif1IrqCount = 0;
+}
+
+void ps2DebugNoteVif1Irq(uint32_t cmd, uint32_t mark)
+{
+    Vif1IrqNote &note = g_vif1IrqNotes[g_vif1IrqCount % 64u];
+    note.index = g_vif1IrqCount++;
+    note.cmd = cmd;
+    note.mark = mark;
+}
+
+void ps2DebugDumpVif1Irqs()
+{
+    const uint64_t first = g_vif1IrqCount > 64u ? g_vif1IrqCount - 64u : 0u;
+    std::cerr << "[vif1:irqs] total=" << g_vif1IrqCount << std::hex << std::endl;
+    for (uint64_t i = first; i < g_vif1IrqCount; ++i)
+    {
+        const Vif1IrqNote &note = g_vif1IrqNotes[i % 64u];
+        std::cerr << "[vif1:irqs]   n=" << std::dec << note.index << std::hex << " cmd=0x" << note.cmd << " mark=0x"
+                  << note.mark << std::endl;
+    }
+    std::cerr << std::dec;
+}
+
+// VIF1 stall after a VIFcode with the 'i' bit (hardware behaviour): the VIF raises INTC cause 5 and processes nothing
+// else until VIF1_FBRST.STC. The handler reads VIF1_MARK and reacts in the middle of the packet: F1 06 marks
+// 0x9000 to upload the next textures through PATH3 and 0x1000 to count the end of the packet. Without the stall the
+// handlers ran after the whole packet and all saw the last mark, so textures arrived late and, if the last mark was
+// 0x9000, the end of the packet was never counted and the game waited for it forever.
+// State lives here (not in PS2Memory) so the stall does not change ps2_memory.h.
+namespace
+{
+    // Data waiting behind the stall, in order: [g_vif1StallOffset, end). Resuming processes it in place and a new
+    // stall inside it only moves the offset, so a packet with many 'i' bits is not copied again at each one.
+    std::vector<uint8_t> g_vif1StallBuffer;
+    size_t g_vif1StallOffset = 0;
+    bool g_vif1Stalled = false;
+    bool g_vif1DmaEndPending = false; // the DMA ended while stalled: signal it once the remainder is processed
+}
+
+bool ps2Vif1IsStalled()
+{
+    return g_vif1Stalled;
+}
+
+bool ps2Vif1HasStalledData()
+{
+    return g_vif1Stalled && g_vif1StallOffset < g_vif1StallBuffer.size();
+}
+
+void ps2Vif1SetDmaEndPending()
+{
+    g_vif1DmaEndPending = true;
+}
+
+bool ps2Vif1TakeDmaEndPending()
+{
+    const bool pending = g_vif1DmaEndPending;
+    g_vif1DmaEndPending = false;
+    return pending;
+}
+
+bool ps2Vif1TakeStall(const uint8_t *&data, uint32_t &size)
+{
+    if (!g_vif1Stalled)
+        return false;
+    g_vif1Stalled = false;
+    data = g_vif1StallBuffer.data() + g_vif1StallOffset;
+    size = static_cast<uint32_t>(g_vif1StallBuffer.size() - g_vif1StallOffset);
+    return true;
+}
+
+void ps2Vif1ReleaseStallData()
+{
+    // Called after processing what ps2Vif1TakeStall handed out: drop it unless a new stall kept part of it.
+    if (!g_vif1Stalled)
+    {
+        g_vif1StallBuffer.clear();
+        g_vif1StallOffset = 0;
+    }
+}
+
+void ps2Vif1ResetStall()
+{
+    g_vif1Stalled = false;
+    g_vif1DmaEndPending = false;
+    g_vif1StallBuffer.clear();
+    g_vif1StallOffset = 0;
+}
