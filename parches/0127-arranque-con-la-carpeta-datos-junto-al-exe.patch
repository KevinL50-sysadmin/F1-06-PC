+
+    // The regular file in `directory` whose name equals `name` ignoring ASCII case, with its on-disk name.
+    inline std::optional<std::filesystem::path> findFileIgnoringCase(const std::filesystem::path &directory,
+                                                                     std::string_view name)
+    {
+        const auto equalsIgnoringCase = [](std::string_view left, std::string_view right)
+        {
+            return left.size() == right.size() &&
+                   std::equal(left.begin(), left.end(), right.begin(), [](unsigned char a, unsigned char b)
+                              { return std::toupper(a) == std::toupper(b); });
+        };
+        std::error_code error;
+        for (const auto &entry : std::filesystem::directory_iterator(directory, error))
+        {
+            if (entry.is_regular_file(error) && equalsIgnoringCase(entry.path().filename().string(), name))
+                return entry.path();
+        }
+        return std::nullopt;
+    }
+
+    // Folder mode of a packaged game: the disc files extracted into a "datos" folder next to the .exe.
+    struct DataFolderBoot
+    {
+        std::filesystem::path dataDirectory;
+        std::filesystem::path elfPath;
+        std::string boot2;
+    };
+
+    // `exeDirectory`/datos with a SYSTEM.CNF whose BOOT2 ELF is in that folder (both names in any case).
+    inline std::optional<DataFolderBoot> findDataFolderBoot(const std::filesystem::path &exeDirectory)
+    {
+        const std::filesystem::path dataDirectory = exeDirectory / "datos";
+        const std::optional<std::filesystem::path> systemCnf = findFileIgnoringCase(dataDirectory, "SYSTEM.CNF");
+        if (!systemCnf)
+            return std::nullopt;
+        std::ifstream stream(*systemCnf, std::ios::binary);
+        const std::string text((std::istreambuf_iterator<char>(stream)), std::istreambuf_iterator<char>());
+        const std::optional<std::string> boot2 = parseSystemCnfBoot2(text);
+        if (!boot2)
+            return std::nullopt;
+        const std::optional<std::filesystem::path> elf = findFileIgnoringCase(dataDirectory, bootElfName(*boot2));
+        if (!elf)
+            return std::nullopt;
+        return DataFolderBoot{dataDirectory, *elf, *boot2};
+    }
 }
