+    bool plainFill(const PixelPipeline &pp, const FastWrite4 &w, const SpriteSetup &s, PlainFill &out)
+    {
+        if (w.scalar || w.abe || w.fbmskOn || w.readAlways || w.dateCt32 || pp.ztestMethod != 1u)
+            return false;
+        uint32_t rgba = s.vertexRgba;
+        if (w.fge)
+        {
+            const uint32_t f = s.fog;
+            const uint32_t fogColor[3] = {pp.fogR, pp.fogG, pp.fogB};
+            uint32_t fogged = rgba & 0xFF000000u;
+            for (int c = 0; c < 3; ++c)
+            {
+                const uint32_t ch = (rgba >> (8 * c)) & 0xFFu;
+                fogged |= ((((f * ch) >> 8) + (((255u - f) * (fogColor[c] & 0xFFu)) >> 8)) & 0xFFu) << (8 * c);
+            }
+            rgba = fogged;
+        }
+        const uint32_t a = rgba >> 24;
+        const uint32_t aref = (pp.test >> 4) & 0xFFu;
+        bool pass;
+        switch (w.atst)
+        {
+        case 0: pass = false; break;
+        case 2: pass = a < aref; break;
+        case 3: pass = !(a > aref); break;
+        case 4: pass = a == aref; break;
+        case 5: pass = !(a < aref); break;
+        case 6: pass = a > aref; break;
+        case 7: pass = a != aref; break;
+        default: pass = true; break;
+        }
+        const bool wRgb = pass || w.failRgb, wAlpha = pass || w.failAlpha, wDepth = pass || w.failDepth;
+        if (w.frameCt32 && wRgb && !wAlpha) // the frame's alpha kept: a read
+            return false;
+        out.frame = wRgb || wAlpha;
+        out.depth = w.writeZ && wDepth;
+        if (out.frame && out.depth && pp.fbp == pp.zbp)
+            return false;
+        const uint32_t alpha = a | (w.fbaSetsAlpha && wAlpha ? 0x80u : 0u);
+        out.pixel = (rgba & 0x00FFFFFFu) | (alpha << 24);
+        return true;
+    }
