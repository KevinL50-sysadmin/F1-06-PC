+    void offerHostAudio(const int16_t *stereo, size_t frames) noexcept
+    {
+        if (!g_audioWanted.load(std::memory_order_relaxed) || stereo == nullptr || frames == 0)
+            return;
+        const uint32_t now = clockMs();
+        if (!ps2x::photoModeActive() && !ps2x::replayScrubMuted())
+        {
+            g_audioTap.push(stereo, frames, now);
+            return;
+        }
+        // The host is silent (photo mode, replay paused or rewinding): so is the guest, at the same pace.
+        static const int16_t s_silence[256 * 2] = {};
+        for (size_t done = 0; done < frames;)
+        {
+            const size_t n = std::min<size_t>(frames - done, 256);
+            done += n;
+            g_audioTap.push(s_silence, n, now);
+        }
+    }
