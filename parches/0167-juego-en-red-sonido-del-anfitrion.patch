+                t.IsTrue(status.audioPackets > 100, name + "packets " + std::to_string(status.audioPackets));
+                t.IsTrue(status.audioKbps > 50.0f, name + "kbit/s " + std::to_string(status.audioKbps));
+                const HostAudioStats hs = host.audioStats();
+                t.IsTrue(hs.packets > 100 && hs.bytes > 0, name + "counted on the host");
+                t.IsTrue(played.peak(48000, played.left.size()) > 7000, name + "the sine plays on the guest");
+                std::string around;
+                for (size_t i = played.maxDeltaAt >= 6 ? played.maxDeltaAt - 6 : 0;
