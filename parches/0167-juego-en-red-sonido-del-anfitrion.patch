new file mode 100644
index 0000000..54616d3
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_netplay_audio.cpp
@@ -0,0 +1,835 @@
+#include "ps2_netplay_audio.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+#if !defined(PS2X_HAS_FFMPEG)
+#define PS2X_HAS_FFMPEG 1
+#endif
+
+#if PS2X_HAS_FFMPEG
+extern "C"
+{
+#include <libavcodec/avcodec.h>
+#include <libavutil/channel_layout.h>
+#include <libavutil/error.h>
+#include <libavutil/frame.h>
+#include <libavutil/opt.h>
+}
+#endif
+
+// Fase 5 (T15, netplay N3): see ps2_netplay_audio.h.
+namespace ps2x::netplay
+{
+    namespace
+    {
+        uint32_t pack(int16_t left, int16_t right)
+        {
+            return static_cast<uint16_t>(left) | (static_cast<uint32_t>(static_cast<uint16_t>(right)) << 16);
+        }
+
+        int16_t clamp16(double value)
+        {
+            return static_cast<int16_t>(std::clamp<long>(std::lround(value), -32768L, 32767L));
+        }
+
+        // Catmull-Rom between p1 and p2 at t in [0, 1) (as the host's Spu2OutputResampler).
+        double interpolate(double p0, double p1, double p2, double p3, double t)
+        {
+            return p1 + 0.5 * t * (p2 - p0 + t * (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3 + t * (3.0 * (p1 - p2) + p3 - p0)));
+        }
+
+        // A host time from a stamp (ms, low 32 bits of a frame's number) and another frame's number, 48 per ms.
+        uint32_t timeOf(uint64_t stamp, uint64_t frame)
+        {
+            const int32_t delta = static_cast<int32_t>(static_cast<uint32_t>(frame) - static_cast<uint32_t>(stamp));
+            return static_cast<uint32_t>(stamp >> 32) +
+                   static_cast<uint32_t>(static_cast<int64_t>(delta) * 1000 / static_cast<int64_t>(kAudioSampleRate));
+        }
+    }
+
+    std::vector<std::string> audioEncoderCandidates(const std::string &preference)
+    {
+        if (preference == "auto")
+            return {"opus", "pcm"};
+        if (preference == "opus" || preference == "pcm")
+            return {preference};
+        return {};
+    }
+
+    void AudioTapRing::push(const int16_t *stereo, size_t frames, uint32_t nowMs) noexcept
+    {
+        if (stereo == nullptr || frames == 0)
+            return;
+        // Seqlock order: the reservation is seen before any frame it covers (the release fence), so a reader that
+        // copied an overwritten frame sees the reservation that overwrote it.
+        const uint64_t w = m_write.load(std::memory_order_relaxed);
+        m_reserve.store(w + frames, std::memory_order_relaxed);
+        std::atomic_thread_fence(std::memory_order_release);
+        for (size_t i = 0; i < frames; ++i)
+            m_frames[(w + i) % kCapacity].store(pack(stereo[i * 2u], stereo[i * 2u + 1u]), std::memory_order_relaxed);
+        m_write.store(w + frames, std::memory_order_release);
+        m_stamp.store((static_cast<uint64_t>(nowMs) << 32) | static_cast<uint32_t>(w + frames), std::memory_order_release);
+    }
+
+    size_t AudioTapRing::read(int16_t *stereo, size_t maxFrames, uint64_t &firstFrame) noexcept
+    {
+        const uint64_t w = m_write.load(std::memory_order_acquire);
+        if (w - m_read > kCapacity)
+        {
+            m_dropped.fetch_add(w - kCapacity - m_read, std::memory_order_relaxed);
+            m_read = w - kCapacity;
+        }
+        size_t n = static_cast<size_t>(std::min<uint64_t>(maxFrames, w - m_read));
+        if (n == 0 || stereo == nullptr)
+            return 0;
+        for (size_t i = 0; i < n; ++i)
+        {
+            const uint32_t packed = m_frames[(m_read + i) % kCapacity].load(std::memory_order_relaxed);
+            stereo[i * 2u] = static_cast<int16_t>(packed & 0xFFFFu);
+            stereo[i * 2u + 1u] = static_cast<int16_t>(packed >> 16);
+        }
+        // The producer may have come round while they were copied: a frame is good only if the one a ring later had
+        // not been reserved (the push under way may have written part of it already).
+        std::atomic_thread_fence(std::memory_order_acquire);
+        const uint64_t limit = m_reserve.load(std::memory_order_relaxed);
+        uint64_t start = m_read;
+        if (limit > start + kCapacity)
+        {
+            const size_t lost = static_cast<size_t>(std::min<uint64_t>(n, limit - kCapacity - start));
+            if (lost > 0)
+            {
+                std::memmove(stereo, stereo + lost * 2u, (n - lost) * 2u * sizeof(int16_t));
+                n -= lost;
+                start += lost;
+                m_dropped.fetch_add(lost, std::memory_order_relaxed);
+            }
+        }
+        m_read = start + n;
+        firstFrame = start;
+        return n;
+    }
+
+    void AudioTapRing::skipAll() noexcept
+    {
+        m_read = m_write.load(std::memory_order_acquire);
+    }
+
+    size_t AudioTapRing::available() const noexcept
+    {
+        return static_cast<size_t>(std::min<uint64_t>(m_write.load(std::memory_order_acquire) - m_read, kCapacity));
+    }
+
+    uint32_t AudioTapRing::captureMsOf(uint64_t frame) const noexcept
+    {
+        return timeOf(m_stamp.load(std::memory_order_acquire), frame);
+    }
+
+    AudioJitterBuffer::AudioJitterBuffer(const AudioJitterSettings &settings) : m_settings(settings)
+    {
+        m_target = std::clamp(m_settings.startTarget, m_settings.minTarget, m_settings.maxTarget);
+        m_fadeIn = m_settings.fadeFrames;
+        m_statTarget.store(m_target, std::memory_order_relaxed);
+    }
+
+    void AudioJitterBuffer::push(const int16_t *stereo, size_t frames, uint32_t captureMs, bool discontinuity)
+    {
+        if (stereo == nullptr || frames == 0)
+            return;
+        const uint64_t w = m_write.load(std::memory_order_relaxed);
+        const uint64_t r = m_read.load(std::memory_order_acquire);
+        const size_t room = static_cast<size_t>(kCapacity - std::min<uint64_t>(w - r, kCapacity));
+        const size_t n = std::min(frames, room);
+        if (n == 0)
+        {
+            m_dropped.fetch_add(frames, std::memory_order_relaxed);
+            m_producerGap = true;
+            return;
+        }
+        if (discontinuity || m_producerGap)
+            m_discontinuity.store(w, std::memory_order_relaxed);
+        m_producerGap = n < frames;
+        for (size_t i = 0; i < n; ++i)
+            m_ring[(w + i) % kCapacity].store(pack(stereo[i * 2u], stereo[i * 2u + 1u]), std::memory_order_relaxed);
+        m_stamp.store((static_cast<uint64_t>(captureMs) << 32) | static_cast<uint32_t>(w), std::memory_order_relaxed);
+        m_stampValid.store(true, std::memory_order_relaxed);
+        m_write.store(w + n, std::memory_order_release);
+        if (n < frames)
+            m_dropped.fetch_add(frames - n, std::memory_order_relaxed);
+    }
+
+    AudioJitterBuffer::Frame AudioJitterBuffer::frameAt(uint64_t index) const noexcept
+    {
+        const uint32_t packed = m_ring[index % kCapacity].load(std::memory_order_relaxed);
+        return {static_cast<double>(static_cast<int16_t>(packed & 0xFFFFu)),
+                static_cast<double>(static_cast<int16_t>(packed >> 16))};
+    }
+
+    void AudioJitterBuffer::startTail() noexcept
+    {
+        m_tail = m_settings.fadeFrames;
+    }
+
+    void AudioJitterBuffer::writeTail(int16_t *out, size_t frames) noexcept
+    {
+        for (size_t i = 0; i < frames; ++i)
+        {
+            if (m_tail > 0)
+            {
+                const double gain = static_cast<double>(--m_tail) / m_settings.fadeFrames;
+                out[i * 2u] = clamp16(m_lastLeft * gain);
+                out[i * 2u + 1u] = clamp16(m_lastRight * gain);
+            }
+            else
+            {
+                out[i * 2u] = 0;
+                out[i * 2u + 1u] = 0;
+            }
+        }
+        if (m_tail == 0)
+            m_lastLeft = m_lastRight = 0.0;
+    }
+
+    void AudioJitterBuffer::setVolume(float volume) noexcept
+    {
+        m_volume.store(std::isfinite(volume) ? std::clamp(volume, 0.0f, 1.0f) : 1.0f, std::memory_order_relaxed);
+    }
+
+    void AudioJitterBuffer::pull(int16_t *out, size_t frames, uint32_t nowMs)
+    {
+        if (out == nullptr || frames == 0)
+            return;
+        const AudioJitterSettings &s = m_settings;
+        const double fade = static_cast<double>(s.fadeFrames);
+        if (m_resetRequest.exchange(false, std::memory_order_acq_rel))
+        {
+            if (m_state != State::Buffering)
+                startTail();
+            m_state = State::Buffering;
+            m_index = m_write.load(std::memory_order_acquire);
+            m_read.store(m_index, std::memory_order_release);
+            m_gapAt = UINT64_MAX;
+            m_discontinuity.store(UINT64_MAX, std::memory_order_relaxed);
+        }
+        const uint64_t w = m_write.load(std::memory_order_acquire);
+        if (const uint64_t d = m_discontinuity.exchange(UINT64_MAX, std::memory_order_relaxed); d != UINT64_MAX)
+            m_gapAt = d;
+        const uint64_t fill = w - m_index;
+        m_statFill.store(static_cast<uint32_t>(std::min<uint64_t>(fill, UINT32_MAX)), std::memory_order_relaxed);
+        m_statPullMs.store(nowMs, std::memory_order_relaxed);
+        m_statPullFrames.store(static_cast<uint32_t>(frames), std::memory_order_relaxed);
+        size_t i = 0; // frames of `out` written
+        if (m_state == State::Buffering)
+        {
+            // The fade-out of the last underrun ends first, even if the sound is back already (no jump to the fade-in).
+            if (m_tail > 0)
+            {
+                i = std::min<size_t>(m_tail, frames);
+                writeTail(out, i);
+            }
+            if (fill < m_target || i == frames)
+            {
+                writeTail(out + i * 2u, frames - i);
+                m_statPlaying.store(false, std::memory_order_relaxed);
+                m_statHasCapture.store(false, std::memory_order_relaxed);
+                m_statTarget.store(m_target, std::memory_order_relaxed);
+                return;
+            }
+            // Starting from silence: what piled up beyond the target (a host that caught up after a stall) is skipped
+            // now, under the fade-in, rather than later with a fade out and in.
+            if (fill > static_cast<uint64_t>(m_target) + s.fadeFrames)
+                m_index = w - m_target;
+            m_state = State::Playing;
+            m_floor = m_index;
+            m_phase = 0.0;
+            m_fadeIn = 0;
+            m_fill = static_cast<double>(w - m_index);
+            m_tail = 0;
+        }
+        // The capture time of the first frame handed now (for the sync with the picture).
+        if (m_stampValid.load(std::memory_order_relaxed))
+        {
+            m_statCapture.store(timeOf(m_stamp.load(std::memory_order_relaxed), m_index), std::memory_order_relaxed);
+            m_statHasCapture.store(true, std::memory_order_relaxed);
+        }
+        // The speed follows the smoothed fill toward the target (the host's clock against this device's).
+        m_fill += (static_cast<double>(fill) - m_fill) *
+                  std::min(1.0, static_cast<double>(frames) / (static_cast<double>(kAudioSampleRate) * s.smoothingSeconds));
+        m_step = 1.0 + std::clamp((m_fill - m_target) * (s.maxDeviation / s.controlSpan), -s.maxDeviation, s.maxDeviation);
+        if (m_state == State::Playing && fill > static_cast<uint64_t>(m_target) + s.valveMargin)
+        {
+            m_state = State::Skipping;
+            m_skipFade = s.fadeFrames;
+            m_skips.fetch_add(1, std::memory_order_relaxed);
+        }
+        const double wantGain = m_muted.load(std::memory_order_relaxed) ? 0.0 : m_volume.load(std::memory_order_relaxed);
+        const double gainStep = 1.0 / 480.0; // 10 ms from silence to full volume
+        const uint64_t startIndex = m_index;
+        for (; i < frames; ++i)
+        {
+            if (m_index + 2u >= w)
+            {
+                // Dry: fade the last frame out, play silence and wait for the target again (a little higher).
+                m_underruns.fetch_add(1, std::memory_order_relaxed);
+                m_target = std::min(m_target + s.targetRaise, s.maxTarget);
+                m_played = 0;
+                m_state = State::Buffering;
+                m_gapAt = UINT64_MAX;
+                startTail();
+                break;
+            }
+            const Frame p0 = frameAt(m_index > m_floor ? m_index - 1u : m_index);
+            const Frame p1 = frameAt(m_index), p2 = frameAt(m_index + 1u), p3 = frameAt(m_index + 2u);
+            double gain = 1.0;
+            if (m_fadeIn < s.fadeFrames)
+                gain = static_cast<double>(m_fadeIn++) / fade;
+            if (m_state == State::Skipping)
+                gain *= static_cast<double>(m_skipFade) / fade;
+            if (m_gapAt != UINT64_MAX)
+            {
+                const double at = static_cast<double>(m_index) + m_phase, gap = static_cast<double>(m_gapAt);
+                if (at < gap)
+                    gain *= std::min(1.0, (gap - at) / fade);
+                else if (at - gap < fade)
+                    gain *= (at - gap) / fade;
+                else
+                    m_gapAt = UINT64_MAX;
+            }
+            m_gain += std::clamp(wantGain - m_gain, -gainStep, gainStep);
+            m_lastLeft = interpolate(p0.left, p1.left, p2.left, p3.left, m_phase) * gain * m_gain;
+            m_lastRight = interpolate(p0.right, p1.right, p2.right, p3.right, m_phase) * gain * m_gain;
+            out[i * 2u] = clamp16(m_lastLeft);
+            out[i * 2u + 1u] = clamp16(m_lastRight);
+            if (m_state == State::Skipping && --m_skipFade == 0)
+            {
+                // Faded out: jump to the target behind the newest frame and fade back in.
+                m_index = std::max(m_index, w - m_target);
+                m_floor = m_index;
+                m_phase = 0.0;
+                m_fadeIn = 0;
+                m_fill = static_cast<double>(m_target);
+                m_gapAt = UINT64_MAX;
+                m_state = State::Playing;
+                continue;
+            }
+            m_phase += m_step;
+            while (m_phase >= 1.0)
+            {
+                m_phase -= 1.0;
+                ++m_index;
+            }
+        }
+        if (i < frames)
+            writeTail(out + i * 2u, frames - i);
+        m_read.store(m_state == State::Buffering ? m_index : std::max(m_floor, m_index - 1u), std::memory_order_release);
+        m_played += m_index - startIndex;
+        if (m_played >= s.lowerAfterFrames)
+        {
+            m_played = 0;
+            m_target = std::max(s.minTarget, m_target > s.targetLower ? m_target - s.targetLower : 0u);
+        }
+        m_statTarget.store(m_target, std::memory_order_relaxed);
+        m_statRatio.store((m_step - 1.0) * 1e6, std::memory_order_relaxed);
+        m_statPlaying.store(m_state != State::Buffering, std::memory_order_relaxed);
+    }
+
+    AudioJitterBuffer::Stats AudioJitterBuffer::stats() const noexcept
+    {
+        Stats s;
+        s.fillFrames = m_statFill.load(std::memory_order_relaxed);
+        s.targetFrames = m_statTarget.load(std::memory_order_relaxed);
+        s.underruns = m_underruns.load(std::memory_order_relaxed);
+        s.skips = m_skips.load(std::memory_order_relaxed);
+        s.droppedFrames = m_dropped.load(std::memory_order_relaxed);
+        s.ratioPpm = m_statRatio.load(std::memory_order_relaxed);
+        s.playing = m_statPlaying.load(std::memory_order_relaxed);
+        s.hasCapture = m_statHasCapture.load(std::memory_order_relaxed);
+        s.playingCaptureMs = m_statCapture.load(std::memory_order_relaxed);
+        s.pullMs = m_statPullMs.load(std::memory_order_relaxed);
+        s.pullFrames = m_statPullFrames.load(std::memory_order_relaxed);
+        return s;
+    }
+
+#if PS2X_HAS_FFMPEG
+    namespace
+    {
+        std::string avError(int code)
+        {
+            char text[AV_ERROR_MAX_STRING_SIZE] = {};
+            av_strerror(code, text, sizeof(text));
+            return text;
+        }
+
+        // The sample format the codec takes, the first of the ones converted here.
+        AVSampleFormat sampleFormat(const AVCodec *codec, AVCodecContext *ctx)
+        {
+            const void *list = nullptr;
+            int count = 0;
+            if (avcodec_get_supported_config(ctx, codec, AV_CODEC_CONFIG_SAMPLE_FORMAT, 0, &list, &count) < 0 ||
+                list == nullptr)
+                return AV_SAMPLE_FMT_FLTP;
+            const AVSampleFormat *formats = static_cast<const AVSampleFormat *>(list);
+            for (AVSampleFormat wanted : {AV_SAMPLE_FMT_FLTP, AV_SAMPLE_FMT_FLT, AV_SAMPLE_FMT_S16})
+                for (int i = 0; i < count; ++i)
+                    if (formats[i] == wanted)
+                        return wanted;
+            return AV_SAMPLE_FMT_NONE;
+        }
+    }
+#endif
+
+    struct AudioEncoder::Impl
+    {
+        std::string name;
+        AudioCodec codec = AudioCodec::Pcm16;
+        uint32_t kbps = 0;
+        uint16_t frameSamples = 0;
+        bool open = false;
+#if PS2X_HAS_FFMPEG
+        AVCodecContext *ctx = nullptr;
+        AVFrame *frame = nullptr;
+        AVPacket *packet = nullptr;
+        int64_t pts = 0;
+#endif
+
+        void release()
+        {
+#if PS2X_HAS_FFMPEG
+            av_packet_free(&packet);
+            av_frame_free(&frame);
+            avcodec_free_context(&ctx);
+            pts = 0;
+#endif
+            name.clear();
+            open = false;
+        }
+
+#if PS2X_HAS_FFMPEG
+        bool openOpus(const AVCodec *c, const std::string &which, std::string &why)
+        {
+            ctx = avcodec_alloc_context3(c);
+            if (ctx == nullptr)
+            {
+                why = "sin memoria";
+                return false;
+            }
+            ctx->sample_rate = static_cast<int>(kAudioSampleRate);
+            av_channel_layout_default(&ctx->ch_layout, kAudioChannels);
+            ctx->sample_fmt = sampleFormat(c, ctx);
+            if (ctx->sample_fmt == AV_SAMPLE_FMT_NONE)
+            {
+                why = "sin formato de muestras compatible";
+                release();
+                return false;
+            }
+            ctx->bit_rate = static_cast<int64_t>(kbps) * 1000;
+            ctx->strict_std_compliance = FF_COMPLIANCE_EXPERIMENTAL; // FFmpeg's own Opus encoder is marked so
+            const std::string ms = frameSamples == 120 ? "2.5" : std::to_string(frameSamples / 48);
+            if (which == "libopus")
+            {
+                av_opt_set(ctx->priv_data, "frame_duration", ms.c_str(), 0);
+                av_opt_set(ctx->priv_data, "application", "lowdelay", 0);
+            }
+            else
+                av_opt_set(ctx->priv_data, "opus_delay", ms.c_str(), 0); // the most it may hold back: one frame
+            const int opened = avcodec_open2(ctx, c, nullptr);
+            if (opened < 0)
+            {
+                why = avError(opened);
+                release();
+                return false;
+            }
+            // FFmpeg's own encoder takes 2.5 ms pieces and gives a packet per opus_delay: the frame goes in pieces.
+            if (ctx->frame_size <= 0 || frameSamples % ctx->frame_size != 0)
+            {
+                why = "toma tramas de " + std::to_string(ctx->frame_size) + " muestras, no divide " +
+                      std::to_string(frameSamples);
+                release();
+                return false;
+            }
+            frame = av_frame_alloc();
+            packet = av_packet_alloc();
+            if (frame == nullptr || packet == nullptr)
+            {
+                why = "sin memoria";
+                release();
+                return false;
+            }
+            frame->format = ctx->sample_fmt;
+            frame->nb_samples = ctx->frame_size;
+            frame->sample_rate = ctx->sample_rate;
+            av_channel_layout_copy(&frame->ch_layout, &ctx->ch_layout);
+            const int buffer = av_frame_get_buffer(frame, 0);
+            if (buffer < 0)
+            {
+                why = avError(buffer);
+                release();
+                return false;
+            }
+            name = which;
+            return true;
+        }
+#endif
+    };
+
+    AudioEncoder::AudioEncoder() : m_impl(std::make_unique<Impl>()) {}
+
+    AudioEncoder::~AudioEncoder()
+    {
+        close();
+    }
+
+    bool AudioEncoder::open(const std::string &name, uint32_t kbps, uint16_t frameSamples, std::string &error)
+    {
+        close();
+        Impl &m = *m_impl;
+        if (frameSamples != 120 && frameSamples != 240 && frameSamples != 480 && frameSamples != 960)
+        {
+            error = "tamano de trama de sonido no valido: " + std::to_string(frameSamples);
+            return false;
+        }
+        m.frameSamples = frameSamples;
+        if (name == "pcm")
+        {
+            m.codec = AudioCodec::Pcm16;
+            m.kbps = kAudioSampleRate * kAudioChannels * 16u / 1000u;
+            m.name = "pcm";
+            m.open = true;
+            return true;
+        }
+        if (name != "opus")
+        {
+            error = "codificador de sonido desconocido: " + name;
+            return false;
+        }
+#if PS2X_HAS_FFMPEG
+        m.codec = AudioCodec::Opus;
+        m.kbps = std::clamp<uint32_t>(kbps, 16u, 510u);
+        std::string tried;
+        for (const char *which : {"libopus", "opus"})
+        {
+            std::string why;
+            const AVCodec *c = avcodec_find_encoder_by_name(which);
+            if (c == nullptr)
+                why = "no esta en esta version de FFmpeg";
+            else if (m.openOpus(c, which, why))
+            {
+                m.open = true;
+                return true;
+            }
+            tried += (tried.empty() ? "" : "; ") + std::string(which) + ": " + why;
+        }
+        error = "Opus no abre (" + tried + ")";
+        return false;
+#else
+        (void)kbps;
+        error = "esta compilacion no lleva FFmpeg (sin Opus)";
+        return false;
+#endif
+    }
+
+    void AudioEncoder::close()
+    {
+        m_impl->release();
+    }
+
+    bool AudioEncoder::isOpen() const
+    {
+        return m_impl->open;
+    }
+
+    AudioCodec AudioEncoder::codec() const
+    {
+        return m_impl->codec;
+    }
+
+    const std::string &AudioEncoder::encoderName() const
+    {
+        return m_impl->name;
+    }
+
+    uint32_t AudioEncoder::kbps() const
+    {
+        return m_impl->kbps;
+    }
+
+    uint16_t AudioEncoder::frameSamples() const
+    {
+        return m_impl->frameSamples;
+    }
+
+    bool AudioEncoder::encode(const int16_t *stereo, std::vector<std::vector<uint8_t>> &packets, std::string &error)
+    {
+        Impl &m = *m_impl;
+        if (!m.open || stereo == nullptr)
+        {
+            error = "codificador de sonido cerrado";
+            return false;
+        }
+        const size_t samples = static_cast<size_t>(m.frameSamples) * kAudioChannels;
+        if (m.codec == AudioCodec::Pcm16)
+        {
+            std::vector<uint8_t> out(samples * 2u);
+            for (size_t i = 0; i < samples; ++i)
+            {
+                const uint16_t v = static_cast<uint16_t>(stereo[i]);
+                out[i * 2u] = static_cast<uint8_t>(v & 0xFFu);
+                out[i * 2u + 1u] = static_cast<uint8_t>(v >> 8);
+            }
+            packets.push_back(std::move(out));
+            return true;
+        }
+#if PS2X_HAS_FFMPEG
+        const int n = m.ctx->frame_size;
+        for (int piece = 0; piece < m.frameSamples / n; ++piece)
+        {
+            const int16_t *in = stereo + static_cast<size_t>(piece) * n * kAudioChannels;
+            const int writable = av_frame_make_writable(m.frame);
+            if (writable < 0)
+            {
+                error = avError(writable);
+                return false;
+            }
+            switch (m.ctx->sample_fmt)
+            {
+            case AV_SAMPLE_FMT_FLTP:
+            {
+                float *left = reinterpret_cast<float *>(m.frame->data[0]);
+                float *right = reinterpret_cast<float *>(m.frame->data[1]);
+                for (int i = 0; i < n; ++i)
+                {
+                    left[i] = in[i * 2] / 32768.0f;
+                    right[i] = in[i * 2 + 1] / 32768.0f;
+                }
+                break;
+            }
+            case AV_SAMPLE_FMT_FLT:
+            {
+                float *both = reinterpret_cast<float *>(m.frame->data[0]);
+                for (int i = 0; i < n * 2; ++i)
+                    both[i] = in[i] / 32768.0f;
+                break;
+            }
+            default:
+                std::memcpy(m.frame->data[0], in, static_cast<size_t>(n) * kAudioChannels * sizeof(int16_t));
+                break;
+            }
+            m.frame->pts = m.pts;
+            m.pts += n;
+            const int sent = avcodec_send_frame(m.ctx, m.frame);
+            if (sent < 0)
+            {
+                error = "el codificador de sonido falla: " + avError(sent);
+                return false;
+            }
+            for (;;)
+            {
+                const int got = avcodec_receive_packet(m.ctx, m.packet);
+                if (got == AVERROR(EAGAIN) || got == AVERROR_EOF)
+                    break;
+                if (got < 0)
+                {
+                    error = "el codificador de sonido falla: " + avError(got);
+                    return false;
+                }
+                if (m.packet->size > 0)
+                    packets.emplace_back(m.packet->data, m.packet->data + m.packet->size);
+                av_packet_unref(m.packet);
+            }
+        }
+        return true;
+#else
+        error = "esta compilacion no lleva FFmpeg";
+        return false;
+#endif
+    }
+
+    struct AudioDecoder::Impl
+    {
+        AudioConfig config;
+        bool open = false;
+#if PS2X_HAS_FFMPEG
+        AVCodecContext *ctx = nullptr;
+        AVFrame *frame = nullptr;
+        AVPacket *packet = nullptr;
+#endif
+
+        void release()
+        {
+#if PS2X_HAS_FFMPEG
+            av_packet_free(&packet);
+            av_frame_free(&frame);
+            avcodec_free_context(&ctx);
+#endif
+            open = false;
+        }
+    };
+
+    AudioDecoder::AudioDecoder() : m_impl(std::make_unique<Impl>()) {}
+
+    AudioDecoder::~AudioDecoder()
+    {
+        close();
+    }
+
+    bool AudioDecoder::open(const AudioConfig &config, std::string &error)
+    {
+        close();
+        // The same checks as on the wire, whoever builds the config.
+        const auto bytes = encodeAudioConfig(config);
+        AudioConfig checked;
+        if (!decodeAudioConfig(bytes.data(), bytes.size(), checked, error))
+            return false;
+        Impl &m = *m_impl;
+        m.config = checked;
+        if (checked.codec == static_cast<uint8_t>(AudioCodec::Pcm16))
+        {
+            m.open = true;
+            return true;
+        }
+#if PS2X_HAS_FFMPEG
+        const AVCodec *c = avcodec_find_decoder(AV_CODEC_ID_OPUS);
+        if (c == nullptr)
+        {
+            error = "no hay decodificador opus";
+            return false;
+        }
+        m.ctx = avcodec_alloc_context3(c);
+        m.frame = av_frame_alloc();
+        m.packet = av_packet_alloc();
+        if (m.ctx == nullptr || m.frame == nullptr || m.packet == nullptr)
+        {
+            error = "sin memoria";
+            m.release();
+            return false;
+        }
+        m.ctx->sample_rate = static_cast<int>(kAudioSampleRate);
+        av_channel_layout_default(&m.ctx->ch_layout, kAudioChannels);
+        m.ctx->thread_count = 1;
+        const int opened = avcodec_open2(m.ctx, c, nullptr);
+        if (opened < 0)
+        {
+            error = avError(opened);
+            m.release();
+            return false;
+        }
+        m.open = true;
+        return true;
+#else
+        error = "esta compilacion no lleva FFmpeg (sin Opus)";
+        return false;
+#endif
+    }
+
+    void AudioDecoder::close()
+    {
+        m_impl->release();
+    }
+
+    bool AudioDecoder::isOpen() const
+    {
+        return m_impl->open;
+    }
+
+    bool AudioDecoder::decode(const uint8_t *data, size_t size, std::vector<int16_t> &stereo, std::string &error)
+    {
+        Impl &m = *m_impl;
+        if (!m.open)
+        {
+            error = "decodificador de sonido cerrado";
+            return false;
+        }
+        if (data == nullptr || size == 0 || size > kMaxAudioPacketData)
+        {
+            error = "paquete de sonido de tamano no valido";
+            return false;
+        }
+        if (m.config.codec == static_cast<uint8_t>(AudioCodec::Pcm16))
+        {
+            if (size != static_cast<size_t>(m.config.frameSamples) * kAudioChannels * 2u)
+            {
+                error = "paquete PCM de longitud no valida: " + std::to_string(size);
+                return false;
+            }
+            const size_t at = stereo.size();
+            stereo.resize(at + size / 2u);
+            for (size_t i = 0; i < size / 2u; ++i)
+                stereo[at + i] = static_cast<int16_t>(data[i * 2u] | (data[i * 2u + 1u] << 8));
+            return true;
+        }
+#if PS2X_HAS_FFMPEG
+        const int made = av_new_packet(m.packet, static_cast<int>(size)); // zeroed padding after the data
+        if (made < 0)
+        {
+            error = avError(made);
+            return false;
+        }
+        std::memcpy(m.packet->data, data, size);
+        const int sent = avcodec_send_packet(m.ctx, m.packet);
+        av_packet_unref(m.packet);
+        if (sent < 0)
+        {
+            error = "paquete de sonido que no se puede decodificar: " + avError(sent);
+            return false;
+        }
+        for (;;)
+        {
+            const int received = avcodec_receive_frame(m.ctx, m.frame);
+            if (received == AVERROR(EAGAIN) || received == AVERROR_EOF)
+                break;
+            if (received < 0)
+            {
+                error = "paquete de sonido que no se puede decodificar: " + avError(received);
+                return false;
+            }
+            const int n = m.frame->nb_samples;
+            // At most 120 ms per packet (the largest Opus packet), stereo at 48 kHz.
+            if (m.frame->ch_layout.nb_channels != kAudioChannels || m.frame->sample_rate != static_cast<int>(kAudioSampleRate) ||
+                n <= 0 || n > 5760)
+            {
+                error = "sonido decodificado de formato inesperado";
+                av_frame_unref(m.frame);
+                return false;
+            }
+            const size_t at = stereo.size();
+            stereo.resize(at + static_cast<size_t>(n) * 2u);
+            int16_t *out = stereo.data() + at;
+            switch (m.frame->format)
+            {
+            case AV_SAMPLE_FMT_FLTP:
+            {
+                const float *left = reinterpret_cast<const float *>(m.frame->data[0]);
+                const float *right = reinterpret_cast<const float *>(m.frame->data[1]);
+                for (int i = 0; i < n; ++i)
+                {
+                    out[i * 2] = clamp16(left[i] * 32768.0);
+                    out[i * 2 + 1] = clamp16(right[i] * 32768.0);
+                }
+                break;
+            }
+            case AV_SAMPLE_FMT_FLT:
+            {
+                const float *both = reinterpret_cast<const float *>(m.frame->data[0]);
+                for (int i = 0; i < n * 2; ++i)
+                    out[i] = clamp16(both[i] * 32768.0);
+                break;
+            }
+            case AV_SAMPLE_FMT_S16:
+                std::memcpy(out, m.frame->data[0], static_cast<size_t>(n) * 2u * sizeof(int16_t));
+                break;
+            default:
+                stereo.resize(at);
+                av_frame_unref(m.frame);
+                error = "formato de muestras decodificadas no soportado";
+                return false;
+            }
+            av_frame_unref(m.frame);
+        }
+        return true;
+#else
+        error = "esta compilacion no lleva FFmpeg";
+        return false;
+#endif
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_netplay_audio.h b/ps2xRuntime/src/lib/ps2_netplay_audio.h
new file mode 100644
index 0000000..07e1908
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_netplay_audio.h
@@ -0,0 +1,209 @@
+#pragma once
+
+#include "ps2_netplay_protocol.h"
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+// Fase 5 (T15, netplay N3): the host's sound for the guest.
+//
+// Host: the SPU2 synthesis hands every frame it puts in the host's output ring to a tap (ps2x::iop::setSpu2OutputTap),
+// which copies it into an AudioTapRing (lock-free, never waits: the synthesis thread is never held up and what the host
+// hears does not change). A sender thread takes 10 ms frames out of it, encodes them (Opus, or 16-bit PCM) and queues
+// one AUDIO_PACKET per frame, stamped with the host time its first sample was synthesized (the picture carries the
+// time it was captured, on the same clock).
+//
+// Guest: the packets are checked (AudioReceiver), decoded and put in an AudioJitterBuffer, which the audio device's
+// thread drains: it starts once ~40 ms are buffered, follows the host's clock with a small resampling (+-0.5 %, no
+// clicks), fades out and rebuffers when it runs dry (and buffers a little more after each time, up to 80 ms), and skips
+// with a fade when too much piled up (a network stall that came in all at once).
+namespace ps2x::netplay
+{
+    // 10 ms frames.
+    constexpr uint16_t kAudioFrameSamples = 480;
+
+    // The encoders tried for a preference, in order: "auto" = opus, pcm. A single name = only that one.
+    std::vector<std::string> audioEncoderCandidates(const std::string &preference);
+
+    // Host side: one producer (the synthesis thread) and one consumer (the sender thread). The producer never waits:
+    // when the consumer falls more than kCapacity frames behind, the oldest frames are overwritten (the consumer sees
+    // them as dropped). Frames are counted from 0 since the ring was made.
+    class AudioTapRing
+    {
+    public:
+        static constexpr size_t kCapacity = 1u << 15; // frames (683 ms at 48 kHz)
+
+        // Producer: frames of interleaved stereo, synthesized just before nowMs (host clock).
+        void push(const int16_t *stereo, size_t frames, uint32_t nowMs) noexcept;
+        // Consumer: up to maxFrames of the oldest frames still there; firstFrame = the number of the first one. Frames
+        // overwritten before they were read are skipped and counted in dropped().
+        size_t read(int16_t *stereo, size_t maxFrames, uint64_t &firstFrame) noexcept;
+        // Consumer: skips everything waiting (the next read starts at the newest frame).
+        void skipAll() noexcept;
+        size_t available() const noexcept;
+        uint64_t dropped() const noexcept { return m_dropped.load(std::memory_order_relaxed); }
+        // The host time a frame was synthesized, from the producer's latest push (48 frames per ms).
+        uint32_t captureMsOf(uint64_t frame) const noexcept;
+
+    private:
+        std::atomic<uint32_t> m_frames[kCapacity]{};
+        std::atomic<uint64_t> m_write{0};
+        std::atomic<uint64_t> m_reserve{0}; // m_write + the push under way (its frames may be half written)
+        std::atomic<uint64_t> m_stamp{0}; // (ms << 32) | low 32 bits of the frame count after the latest push
+        uint64_t m_read = 0;              // consumer only
+        std::atomic<uint64_t> m_dropped{0};
+    };
+
+    struct AudioJitterSettings
+    {
+        uint32_t minTarget = 1920;         // frames buffered before playing (40 ms)
+        uint32_t maxTarget = 3840;         // 80 ms: the most the target rises to after underruns
+        uint32_t startTarget = 1920;
+        uint32_t targetRaise = 480;        // per underrun (10 ms)
+        uint32_t targetLower = 240;        // per lowerAfterFrames played without one (5 ms)
+        uint64_t lowerAfterFrames = 20u * 48000u;
+        uint32_t valveMargin = 2880;       // 60 ms above the target: skip back to it (with a fade)
+        uint32_t fadeFrames = 240;         // 5 ms fades (underrun, skip, gap, start)
+        double maxDeviation = 0.005;       // +-0.5 % of speed (under 9 cents)
+        double controlSpan = 960.0;        // frames off the target that give the full deviation (20 ms)
+        double smoothingSeconds = 1.0;     // of the fill the speed follows
+    };
+
+    // Guest side: one producer (the network thread) and one consumer (the audio device's thread); no locks.
+    class AudioJitterBuffer
+    {
+    public:
+        static constexpr size_t kCapacity = 1u << 14; // frames (341 ms)
+
+        explicit AudioJitterBuffer(const AudioJitterSettings &settings = {});
+
+        // Producer: decoded frames of interleaved stereo; captureMs = host time of the first one. discontinuity = some
+        // frames before these were lost: the sound fades out before them and in after them. Frames that do not fit are
+        // dropped (counted, and the next push starts after a gap).
+        void push(const int16_t *stereo, size_t frames, uint32_t captureMs, bool discontinuity);
+        // Consumer: always writes `frames` frames (silence while buffering); nowMs = the guest's clock now.
+        void pull(int16_t *out, size_t frames, uint32_t nowMs);
+        // Any thread: the consumer drops what is buffered and starts again (a new stream).
+        void requestReset() noexcept { m_resetRequest.store(true, std::memory_order_release); }
+        // Any thread: 0..1, and silence (both change with a 10 ms ramp, no click).
+        void setVolume(float volume) noexcept;
+        void setMuted(bool muted) noexcept { m_muted.store(muted, std::memory_order_relaxed); }
+        float volume() const noexcept { return m_volume.load(std::memory_order_relaxed); }
+        bool muted() const noexcept { return m_muted.load(std::memory_order_relaxed); }
+
+        struct Stats
+        {
+            uint32_t fillFrames = 0;   // buffered at the last pull
+            uint32_t targetFrames = 0;
+            uint64_t underruns = 0;
+            uint64_t skips = 0;        // times the valve skipped
+            uint64_t droppedFrames = 0; // pushed frames that did not fit
+            double ratioPpm = 0.0;     // input frames per output frame - 1, in ppm (+ = draining)
+            bool playing = false;
+            // The host time of the sound handed to the device at the last pull, and the guest time of that pull.
+            bool hasCapture = false;
+            uint32_t playingCaptureMs = 0;
+            uint32_t pullMs = 0;
+            uint32_t pullFrames = 0;
+        };
+        Stats stats() const noexcept;
+
+    private:
+        struct Frame
+        {
+            double left = 0.0, right = 0.0;
+        };
+        Frame frameAt(uint64_t index) const noexcept;
+        void startTail() noexcept;
+        void writeTail(int16_t *out, size_t frames) noexcept;
+
+        AudioJitterSettings m_settings;
+        std::atomic<uint32_t> m_ring[kCapacity]{};
+        std::atomic<uint64_t> m_write{0};
+        std::atomic<uint64_t> m_read{0};                 // the oldest frame the consumer still needs
+        std::atomic<uint64_t> m_stamp{0};                // (captureMs << 32) | low 32 bits of the frame's number
+        std::atomic<bool> m_stampValid{false};
+        std::atomic<uint64_t> m_discontinuity{UINT64_MAX}; // number of the first frame after a gap
+        std::atomic<bool> m_resetRequest{false};
+        std::atomic<float> m_volume{1.0f};
+        std::atomic<bool> m_muted{false};
+        bool m_producerGap = false; // producer only: frames were dropped since the last push
+
+        // Consumer only.
+        enum class State : uint8_t
+        {
+            Buffering,
+            Playing,
+            Skipping, // fading out before the valve's jump
+        };
+        State m_state = State::Buffering;
+        uint64_t m_index = 0;      // the frame at the playing position
+        uint64_t m_floor = 0;      // the first frame of this playing run (none before it is read)
+        double m_phase = 0.0;      // between m_index and m_index + 1
+        double m_step = 1.0;
+        double m_fill = 0.0;       // smoothed
+        uint32_t m_target = 0;
+        uint32_t m_fadeIn = 0;     // frames of the fade-in done (fadeFrames: none running)
+        uint32_t m_skipFade = 0;
+        uint32_t m_tail = 0;       // fade-out frames of the last output still to write
+        double m_lastLeft = 0.0, m_lastRight = 0.0;
+        double m_gain = 1.0;       // volume ramp
+        uint64_t m_played = 0;     // frames since the last underrun or target change
+        uint64_t m_gapAt = UINT64_MAX;
+
+        // Published by the consumer.
+        std::atomic<uint32_t> m_statFill{0}, m_statTarget{0};
+        std::atomic<uint64_t> m_underruns{0}, m_skips{0}, m_dropped{0};
+        std::atomic<double> m_statRatio{0.0};
+        std::atomic<bool> m_statPlaying{false}, m_statHasCapture{false};
+        std::atomic<uint32_t> m_statCapture{0}, m_statPullMs{0}, m_statPullFrames{0};
+    };
