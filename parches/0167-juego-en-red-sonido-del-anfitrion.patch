+            t.IsFalse(decoder.decode(huge.data(), huge.size(), pcm, error), "an oversized packet is refused");
+        });
+
+        tc.Run("loopback in this process: a sine from the tap to the device, Opus and PCM", [](TestCase &t)
+        {
+            for (const char *codec : {"pcm", "opus"})
+            {
