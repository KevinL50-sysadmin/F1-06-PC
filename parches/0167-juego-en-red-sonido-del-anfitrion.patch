+        tc.Run("the producer never waits and an overflow drops the oldest frames", [](TestCase &t)
+        {
+            auto ring = std::make_unique<AudioTapRing>();
+            const size_t total = 3 * AudioTapRing::kCapacity;
+            std::vector<int16_t> chunk(64 * 2);
+            const auto started = std::chrono::steady_clock::now();
+            for (size_t at = 0; at < total; at += 64)
+            {
+                for (size_t i = 0; i < 64; ++i)
+                {
+                    chunk[i * 2] = static_cast<int16_t>((at + i) & 0x7FFF);
+                    chunk[i * 2 + 1] = static_cast<int16_t>(((at + i) >> 15) & 0x7FFF);
+                }
+                ring->push(chunk.data(), 64, 1);
+            }
+            const double ms =
+                std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count();
+            t.IsTrue(ms < 1000.0, "98304 frames with nobody reading took " + std::to_string(ms) + " ms");
+            std::vector<int16_t> out(4096 * 2);
+            uint64_t first = 0, expected = 0, readTotal = 0;
+            bool firstRead = true, inOrder = true;
+            size_t n = 0;
+            while ((n = ring->read(out.data(), 4096, first)) > 0)
+            {
+                if (firstRead)
+                    expected = first;
+                firstRead = false;
+                inOrder = inOrder && first == expected;
+                for (size_t i = 0; i < n; ++i)
+                    inOrder = inOrder && out[i * 2] == static_cast<int16_t>((first + i) & 0x7FFF) &&
+                              out[i * 2 + 1] == static_cast<int16_t>(((first + i) >> 15) & 0x7FFF);
+                expected = first + n;
+                readTotal += n;
+            }
+            t.Equals(readTotal, static_cast<uint64_t>(AudioTapRing::kCapacity), "the newest ring-full is there");
+            t.IsTrue(!firstRead, "something read");
+            t.IsTrue(inOrder, "in order, each frame the one with its number");
+            t.Equals(expected, static_cast<uint64_t>(total), "up to the last frame");
+            t.Equals(ring->dropped(), static_cast<uint64_t>(total - AudioTapRing::kCapacity), "the oldest dropped");
+        });
+
+        tc.Run("a reader racing the producer never takes an overwritten frame", [](TestCase &t)
+        {
+            auto ring = std::make_unique<AudioTapRing>();
+            constexpr uint64_t kTotal = 3000000;
+            std::atomic<bool> done{false};
+            std::thread producer([&]
+            {
+                std::vector<int16_t> chunk(64 * 2);
+                for (uint64_t at = 0; at < kTotal; at += 64)
+                {
+                    for (uint64_t i = 0; i < 64; ++i)
+                    {
+                        chunk[i * 2] = static_cast<int16_t>((at + i) & 0x7FFF);
+                        chunk[i * 2 + 1] = static_cast<int16_t>(((at + i) >> 15) & 0x7FFF);
+                    }
+                    ring->push(chunk.data(), 64, 1);
+                }
+                done = true;
+            });
+            std::vector<int16_t> out(700 * 2);
+            uint64_t readTotal = 0, wrong = 0, last = 0, rounds = 0;
+            bool any = false, backwards = false;
+            for (;;)
+            {
+                const bool finished = done.load();
+                uint64_t first = 0;
+                const size_t n = ring->read(out.data(), 700, first);
+                if (n == 0 && finished)
+                    break;
+                if (n > 0)
+                {
+                    backwards = backwards || (any && first < last);
+                    for (size_t i = 0; i < n; ++i)
+                        if (out[i * 2] != static_cast<int16_t>((first + i) & 0x7FFF) ||
+                            out[i * 2 + 1] != static_cast<int16_t>(((first + i) >> 15) & 0x7FFF))
+                            ++wrong;
+                    last = first + n;
+                    any = true;
+                    readTotal += n;
+                }
+                if (++rounds % 50 == 0)
+                    std::this_thread::sleep_for(std::chrono::microseconds(300)); // let the producer lap now and then
+            }
+            producer.join();
+            t.Equals(wrong, static_cast<uint64_t>(0), "no frame read is another's");
+            t.IsFalse(backwards, "never backwards");
+            t.Equals(readTotal + ring->dropped(), kTotal, "every frame read or counted as dropped");
+            t.Equals(last, kTotal, "the last frame read");
+        }); });
