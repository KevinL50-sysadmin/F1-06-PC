+            t.Equals(first, static_cast<uint64_t>(0), "from frame 0");
+            t.IsTrue(std::equal(in.begin(), in.end(), out.begin()), "the same samples, both channels");
+            t.Equals(ring->captureMsOf(480), 1000u, "the frame after the push: its time");
+            t.Equals(ring->captureMsOf(0), 990u, "480 frames before: 10 ms earlier");
+            t.Equals(ring->captureMsOf(240), 995u, "in between");
+            t.Equals(ring->read(out.data(), 1000, first), static_cast<size_t>(0), "nothing more");
+            ring->push(in.data(), 100, 1003);
+            ring->skipAll();
+            t.Equals(ring->available(), static_cast<size_t>(0), "skipped");
+            ring->push(in.data(), 10, 1004);
+            t.Equals(ring->read(out.data(), 1000, first), static_cast<size_t>(10), "the next ones");
+            t.Equals(first, static_cast<uint64_t>(580), "numbered after the skipped ones");
+            t.Equals(ring->dropped(), static_cast<uint64_t>(0), "a skip is not a drop");
