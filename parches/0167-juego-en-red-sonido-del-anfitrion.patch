+    void Host::Impl::audioLoop()
+    {
+        // Above the game's threads: it sleeps nearly all the time, and a late packet is a gap on the guest.
+        SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+        AudioEncoder encoder;
+        std::string error, tried;
+        for (const std::string &name : audioEncoderCandidates(settings.audio.codec))
+        {
+            if (encoder.open(name, settings.audio.kbps, kAudioFrameSamples, error))
+                break;
+            tried += (tried.empty() ? "" : "; ") + name + ": " + error;
+        }
+        if (!encoder.isOpen())
+        {
+            logLine("sonido: ningun codificador abre (%s); el invitado no oira el juego", tried.c_str());
+            return;
+        }
+        if (!tried.empty())
+            logLine("sonido: probados antes: %s", tried.c_str());
+        AudioConfig config;
+        config.codec = static_cast<uint8_t>(encoder.codec());
+        config.frameSamples = kAudioFrameSamples;
+        config.kbps = encoder.kbps();
+        config.stream = ++audioStream;
+        logLine("sonido: codificador %s (%s), %u kbit/s, tramas de %u ms", encoder.encoderName().c_str(),
+                audioCodecName(config.codec), static_cast<unsigned>(config.kbps),
+                static_cast<unsigned>(kAudioFrameSamples / 48u));
+        {
+            std::lock_guard<std::mutex> lock(statsMutex);
+            audio.encoder = encoder.encoderName();
+            audio.kbps = config.kbps;
+        }
+        {
+            std::lock_guard<std::mutex> lock(io);
+            if (!sessionOpen)
+                return;
+            queue.pushAudioConfig(config);
+            flushLocked();
+        }
+        setAudioOwner(this);
+        const uint64_t droppedAtStart = g_audioTap.dropped();
+        std::vector<int16_t> chunk(4096u * 2u), pending;
+        std::deque<uint32_t> captures; // capture time of each frame given to the encoder, oldest first
+        std::vector<std::vector<uint8_t>> packets;
+        uint64_t pendingFirst = 0, expected = 0;
+        bool haveExpected = false;
+        uint32_t sequence = 0;
+        bool failed = false;
+        // The stream starts (and starts again after a gap) with a 5 ms fade-in: the tap cuts in anywhere in a sound,
+        // and the codec's delay would put that edge after the guest's own fade-in.
+        constexpr uint32_t kSourceFade = kAudioFrameSamples / 2u;
+        uint32_t sourceFade = 0;
+        while (!failed)
+        {
+            {
+                std::unique_lock<std::mutex> lock(audioMutex);
+                audioWake.wait_for(lock, std::chrono::milliseconds(kAudioPollMs), [&] { return audioStop; });
+                if (audioStop)
+                    break;
+            }
+            uint64_t first = 0;
+            size_t n = 0;
+            while ((n = g_audioTap.read(chunk.data(), 4096u, first)) > 0)
+            {
+                if (haveExpected && first != expected)
+                {
+                    // This thread was late and the tap overwrote frames: the part of a frame waiting goes too, and a
+                    // sequence number is skipped so the guest fades over the gap.
+                    pending.clear();
+                    ++sequence;
+                    sourceFade = 0;
+                }
+                for (size_t i = 0; i < n && sourceFade < kSourceFade; ++i, ++sourceFade)
+                {
+                    chunk[i * 2u] = static_cast<int16_t>(chunk[i * 2u] * static_cast<int32_t>(sourceFade) /
+                                                         static_cast<int32_t>(kSourceFade));
+                    chunk[i * 2u + 1u] = static_cast<int16_t>(chunk[i * 2u + 1u] * static_cast<int32_t>(sourceFade) /
+                                                              static_cast<int32_t>(kSourceFade));
+                }
+                if (pending.empty())
+                    pendingFirst = first;
+                pending.insert(pending.end(), chunk.begin(), chunk.begin() + static_cast<std::ptrdiff_t>(n * 2u));
+                expected = first + n;
+                haveExpected = true;
+            }
+            size_t used = 0;
+            while (!failed && pending.size() - used >= kAudioFrameSamples * 2u)
+            {
+                captures.push_back(g_audioTap.captureMsOf(pendingFirst));
+                packets.clear();
+                const Clock::time_point encodeStart = Clock::now();
+                if (!encoder.encode(pending.data() + used, packets, error))
+                {
+                    logLine("sonido: %s; el invitado deja de oir el juego", error.c_str());
+                    failed = true;
+                    break;
+                }
+                {
+                    std::lock_guard<std::mutex> statsLock(statsMutex);
+                    ++statsAudioFrames;
+                    statsAudioEncodeMs += std::chrono::duration<double, std::milli>(Clock::now() - encodeStart).count();
+                }
+                used += kAudioFrameSamples * 2u;
+                pendingFirst += kAudioFrameSamples;
+                for (std::vector<uint8_t> &data : packets)
+                {
+                    AudioPacket packet;
+                    packet.sequence = ++sequence;
+                    packet.captureMs = captures.empty() ? clockMs() : captures.front();
+                    if (!captures.empty())
+                        captures.pop_front();
+                    packet.data = std::move(data);
+                    std::vector<uint8_t> payload = encodeAudioPacket(packet, config.stream);
+                    if (payload.empty())
+                        continue; // larger than the protocol allows (no codec here makes one)
+                    std::lock_guard<std::mutex> lock(io);
+                    if (!sessionOpen)
+                    {
+                        failed = true;
+                        break;
+                    }
+                    queue.pushAudio(std::move(payload));
+                    flushLocked();
+                    std::lock_guard<std::mutex> statsLock(statsMutex);
+                    ++audio.packets;
+                    ++statsAudioPackets;
+                    audio.queueDropped = queue.droppedAudio();
+                    audio.tapDropped = g_audioTap.dropped() - droppedAtStart;
+                }
+                while (captures.size() > kMaxHeldCaptures)
+                    captures.pop_front();
+            }
+            pending.erase(pending.begin(), pending.begin() + static_cast<std::ptrdiff_t>(used));
+        }
+        clearAudioOwner(this);
+    }
