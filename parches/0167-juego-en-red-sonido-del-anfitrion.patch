+                t.IsTrue(played.maxDelta <= kSineDelta * 1.3,
+                         name + "continuous (largest step " + std::to_string(played.maxDelta) + " at frame " +
+                             std::to_string(played.maxDeltaAt) + ": " + around + "; underruns " +
+                             std::to_string(status.audioUnderruns) + ", lost " + std::to_string(status.audioLost) + ")");
+                t.IsTrue(status.audioDelayMs > 0 && status.audioDelayMs < 200,
