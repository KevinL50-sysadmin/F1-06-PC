+    void Host::Impl::stopAudio()
+    {
+        {
+            std::lock_guard<std::mutex> lock(audioMutex);
+            audioStop = true;
+        }
+        audioWake.notify_one();
+        if (audioThread.joinable())
+            audioThread.join();
+        clearAudioOwner(this);
