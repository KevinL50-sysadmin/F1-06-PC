+                guest.setAudioMuted(true);
+                t.IsTrue(guest.audioMuted(), name + "mute");
+                guest.stop();
+                t.IsTrue(waitFor([&] { return !host.guestConnected(); }), name + "guest gone");
+                host.stop();
+            }
+            std::vector<int16_t> nothing = sineFrames(0, 64);
+            offerHostAudio(nothing.data(), 64); // without a guest: nothing happens
+            t.IsTrue(true, "a tap without a guest is harmless");
+        }); });
+}
