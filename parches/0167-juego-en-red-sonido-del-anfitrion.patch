+void register_ps2_netplay_audio_tests()
+{
+    MiniTest::Case("NetplayAudioProtocol", [](TestCase &tc)
+                   {
+        tc.Run("version 3: the audio types have strict sizes and 0x32-0x3F stay reserved", [](TestCase &t)
+        {
+            t.Equals(kProtocolVersion, static_cast<uint16_t>(3), "version 3");
+            t.Equals(payloadSizeOf(0x30), 16, "AUDIO_CONFIG");
+            t.Equals(payloadSizeOf(0x31), -1, "AUDIO_PACKET has no single size");
+            size_t lo = 0, hi = 0;
+            t.IsTrue(payloadRange(0x31, lo, hi), "AUDIO_PACKET range");
+            t.Equals(lo, kAudioPacketHeaderSize + 1, "at least one byte of sound");
