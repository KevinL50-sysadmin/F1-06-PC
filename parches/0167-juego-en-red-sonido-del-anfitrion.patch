+            }
+        }); });
+
+    MiniTest::Case("NetplayAudioLoopback", [](TestCase &tc)
+                   {
+        tc.Run("the host's sound reaches the guest over 127.0.0.1 (PCM, then Opus)", [](TestCase &t)
+        {
+            for (const char *codec : {"pcm", "auto"})
+            {
+                const std::string name = std::string(codec) + ": ";
+                Host host;
+                HostSettings settings{"127.0.0.1", 0, "clave-de-prueba"};
+                settings.video.codec = "no";
+                settings.audio.codec = codec;
+                std::string error;
+                t.IsTrue(host.start(settings, error), name + "host listens: " + error);
+                Guest guest;
+                guest.start({"127.0.0.1", host.port(), "clave-de-prueba"});
+                t.IsTrue(waitFor([&] { return guest.status().state == GuestState::Connected; }), name + "connected");
+                // Without a guest's sound nothing is wanted; now the host takes the synthesis' frames.
+                std::atomic<bool> stop{false};
+                std::thread synthesis([&]
+                {
+                    uint64_t frame = 0;
+                    auto next = std::chrono::steady_clock::now();
+                    while (!stop.load())
+                    {
+                        const auto s = sineFrames(frame, 240);
+                        offerHostAudio(s.data(), 240);
+                        frame += 240;
+                        next += std::chrono::microseconds(5000);
+                        std::this_thread::sleep_until(next);
+                    }
+                });
+                Played played;
+                std::vector<int16_t> out(1024 * 2);
+                auto next = std::chrono::steady_clock::now();
+                for (int i = 0; i < 100; ++i) // ~2.1 s of device pulls
+                {
+                    guest.pullAudio(out.data(), 1024);
+                    played.add(out.data(), 1024);
+                    next += std::chrono::microseconds(21333);
+                    std::this_thread::sleep_until(next);
+                }
+                stop = true;
+                synthesis.join();
+                const GuestStatus status = guest.status();
+                t.Equals(status.audioCodec, std::string(std::string(codec) == "pcm" ? "pcm" : "opus"),
