+// Fase 5 (T15, netplay N3): protocol version 3 (AUDIO_CONFIG, AUDIO_PACKET, the send queue's priorities), the tap ring
+// of the host (never waits, an overflow drops the oldest frames), the guest's jitter buffer (target, underrun fades,
+// drift, valve, volume, gaps), the codecs (PCM bit for bit, Opus through FFmpeg) and a sine from the host's tap to the
+// guest's device, in this process and over 127.0.0.1.
+namespace
+{
+    using namespace ps2x::netplay;
+
+    constexpr double kPi = 3.14159265358979323846;
+    // The sine of the host's resampler tests: 441 Hz, amplitude 8000.
+    constexpr double kAmplitude = 8000.0;
+    constexpr double kSineStep = 2.0 * kPi * 441.0 / 48000.0;
+    // Largest sample-to-sample change of that sine played up to 0.5 % faster, plus rounding.
+    constexpr double kSineDelta = kAmplitude * kSineStep * 1.006 + 2.0;
+
+    int16_t sineAt(uint64_t frame, double phase = 0.0)
+    {
+        return static_cast<int16_t>(std::lround(kAmplitude * std::sin(kSineStep * static_cast<double>(frame) + phase)));
+    }
+
+    // `frames` stereo frames of the sine from frame `first` (left = right).
+    std::vector<int16_t> sineFrames(uint64_t first, size_t frames, double phase = 0.0)
+    {
+        std::vector<int16_t> out(frames * 2u);
+        for (size_t i = 0; i < frames; ++i)
+            out[i * 2u] = out[i * 2u + 1u] = sineAt(first + i, phase);
+        return out;
+    }
+
+    // What a device took from a jitter buffer: the left channel and its largest sample-to-sample change.
+    struct Played
+    {
+        std::vector<int16_t> left;
+        double maxDelta = 0.0;
+        size_t maxDeltaAt = 0;
+
+        void add(const int16_t *stereo, size_t frames)
+        {
+            for (size_t i = 0; i < frames; ++i)
+            {
+                const int16_t value = stereo[i * 2u];
+                if (!left.empty())
+                {
+                    const double delta = std::abs(static_cast<double>(value) - left.back());
+                    if (delta > maxDelta)
+                    {
+                        maxDelta = delta;
+                        maxDeltaAt = left.size();
+                    }
+                }
+                left.push_back(value);
+            }
+        }
+
+        void pull(AudioJitterBuffer &buffer, size_t frames, uint32_t nowMs = 0)
+        {
+            std::vector<int16_t> out(frames * 2u, 12345);
+            buffer.pull(out.data(), frames, nowMs);
+            add(out.data(), frames);
+        }
+
+        int peak(size_t from, size_t to) const
+        {
+            int p = 0;
+            for (size_t i = from; i < std::min(to, left.size()); ++i)
+                p = std::max(p, std::abs(static_cast<int>(left[i])));
+            return p;
+        }
+
+        bool silent(size_t from, size_t to) const { return peak(from, to) == 0; }
+
+        // Zero crossings upward per second over [from, to).
+        double frequency(size_t from, size_t to) const
+        {
+            int crossings = 0;
+            for (size_t i = from + 1; i < std::min(to, left.size()); ++i)
+                crossings += left[i - 1] < 0 && left[i] >= 0 ? 1 : 0;
+            return crossings * 48000.0 / static_cast<double>(std::min(to, left.size()) - from);
+        }
+
+        double rms(size_t from, size_t to) const
+        {
+            double sum = 0.0;
+            size_t n = 0;
+            for (size_t i = from; i < std::min(to, left.size()); ++i, ++n)
+                sum += static_cast<double>(left[i]) * left[i];
+            return n ? std::sqrt(sum / static_cast<double>(n)) : 0.0;
+        }
+    };
+
+    // A host clock `rate` times the guest's: packets of 480 frames against device pulls of 1024 frames, in time order.
+    struct DriftRun
+    {
+        AudioJitterBuffer buffer;
+        Played played;
+        uint64_t pushed = 0;
+        double fillSum = 0.0;
+        uint64_t fillCount = 0;
+
+        void run(double rate, double seconds, double measureFrom)
+        {
+            double producer = 0.0, consumer = 0.0;
+            const double packet = 480.0 / (48000.0 * rate), pull = 1024.0 / 48000.0;
+            while (consumer < seconds)
+            {
+                if (producer <= consumer)
+                {
+                    const std::vector<int16_t> frames = sineFrames(pushed, 480);
+                    buffer.push(frames.data(), 480, static_cast<uint32_t>(pushed / 48u), false);
+                    pushed += 480;
+                    producer += packet;
+                }
+                else
+                {
+                    played.pull(buffer, 1024);
+                    if (consumer >= measureFrom)
+                    {
+                        fillSum += buffer.stats().fillFrames;
+                        ++fillCount;
+                    }
+                    consumer += pull;
+                }
+            }
+        }
+
+        double meanFill() const { return fillCount ? fillSum / static_cast<double>(fillCount) : 0.0; }
+    };
+
+    AudioConfig audioConfig(AudioCodec codec, uint32_t stream = 1)
+    {
+        AudioConfig c;
+        c.codec = static_cast<uint8_t>(codec);
+        c.channels = 2;
+        c.frameSamples = 480;
+        c.sampleRate = 48000;
+        c.kbps = codec == AudioCodec::Pcm16 ? 1536u : 128u;
+        c.stream = stream;
+        return c;
+    }
+
+    AudioPacket packetOf(uint32_t sequence, size_t size)
+    {
+        AudioPacket p;
+        p.sequence = sequence;
+        p.captureMs = 5000u + sequence * 10u;
+        p.data.resize(size);
+        for (size_t i = 0; i < size; ++i)
+            p.data[i] = static_cast<uint8_t>(i * 3u + sequence);
+        return p;
+    }
+
+    template <typename Predicate>
+    bool waitFor(Predicate predicate, int milliseconds = 4000)
+    {
+        const auto end = std::chrono::steady_clock::now() + std::chrono::milliseconds(milliseconds);
+        while (std::chrono::steady_clock::now() < end)
+        {
+            if (predicate())
+                return true;
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+        return predicate();
+    }
+
+    // The in-process loopback: tap ring -> sender (10 ms frames, encoder, AUDIO_PACKET, signed frame) -> reader ->
+    // receiver -> decoder -> jitter buffer -> a device pulling 1024 frames, on a simulated clock.
+    struct Loopback
+    {
+        AudioTapRing tap;
+        AudioEncoder encoder;
+        AudioDecoder decoder;
+        AudioReceiver receiver;
+        AudioJitterBuffer jitter;
+        MessageAuth hostAuth, guestAuth;
+        FrameReader reader{guestAuth};
+        Played played;
+        uint32_t sequence = 0;
+        uint64_t produced = 0, firstOfFrame = 0;
+        std::vector<int16_t> pending;
+        std::vector<uint32_t> captures;
+        uint64_t packets = 0, bytes = 0, frameErrors = 0, decodeErrors = 0;
+        std::string why;
+
+        bool start(const std::string &codec)
+        {
+            Digest key{};
+            key.fill(0x42);
+            hostAuth.start(key, true);
+            guestAuth.start(key, false);
+            if (!encoder.open(codec, 128, kAudioFrameSamples, why))
+                return false;
+            AudioConfig config;
+            config.codec = static_cast<uint8_t>(encoder.codec());
+            config.frameSamples = kAudioFrameSamples;
+            config.kbps = encoder.kbps();
+            config.stream = 1;
+            const auto bytesOfConfig = encodeAudioConfig(config);
+            if (!deliver(MessageType::AudioConfig, std::vector<uint8_t>(bytesOfConfig.begin(), bytesOfConfig.end())))
+                return false;
+            return decoder.open(receiver.config(), why);
+        }
+
+        bool deliver(MessageType type, const std::vector<uint8_t> &payload)
+        {
+            const std::vector<uint8_t> frame = encodeFrame(type, payload.data(), payload.size(), &hostAuth);
+            Frame f;
+            if (frame.empty() || !reader.feed(frame.data(), frame.size()) || reader.next(f) != FrameReader::Result::Frame)
+            {
+                ++frameErrors;
+                return false;
+            }
+            if (f.type == static_cast<uint8_t>(MessageType::AudioConfig))
+                return receiver.configure(f.payload.data(), f.size);
+            AudioPacket packet;
+            if (receiver.add(f.payload.data(), f.size, packet) != AudioReceiver::Result::Packet)
+            {
+                ++frameErrors;
+                why = receiver.why();
+                return false;
+            }
+            std::vector<int16_t> pcm;
+            if (!decoder.decode(packet.data.data(), packet.data.size(), pcm, why))
+            {
+                ++decodeErrors;
+                return false;
+            }
+            jitter.push(pcm.data(), pcm.size() / 2u, packet.captureMs, receiver.gapBeforeLast() && packets > 1);
+            return true;
+        }
+
+        // The synthesis: 64 frames at a time at simulated time nowMs.
+        void synthesize(size_t frames, uint32_t nowMs)
+        {
+            const std::vector<int16_t> s = sineFrames(produced, frames);
+            tap.push(s.data(), frames, nowMs);
+            produced += frames;
+        }
+
+        // The sender: every whole 10 ms frame waiting.
+        void send()
+        {
+            int16_t chunk[2048 * 2];
+            uint64_t first = 0;
+            size_t n = 0;
+            while ((n = tap.read(chunk, 2048, first)) > 0)
+            {
+                if (pending.empty())
+                    firstOfFrame = first;
+                pending.insert(pending.end(), chunk, chunk + n * 2u);
+            }
+            while (pending.size() >= kAudioFrameSamples * 2u)
+            {
+                captures.push_back(tap.captureMsOf(firstOfFrame));
+                std::vector<std::vector<uint8_t>> out;
+                encoder.encode(pending.data(), out, why);
+                pending.erase(pending.begin(), pending.begin() + kAudioFrameSamples * 2);
+                firstOfFrame += kAudioFrameSamples;
+                for (std::vector<uint8_t> &data : out)
+                {
+                    AudioPacket packet;
+                    packet.sequence = ++sequence;
+                    packet.captureMs = captures.empty() ? 0u : captures.front();
+                    if (!captures.empty())
+                        captures.erase(captures.begin());
+                    packet.data = std::move(data);
+                    bytes += packet.data.size();
+                    ++packets;
+                    deliver(MessageType::AudioPacket, encodeAudioPacket(packet, 1));
+                }
+            }
+        }
+
+        // `seconds` of simulated time: synthesis every 1.33 ms (64 frames), sender every 5 ms, device every 21.3 ms.
+        void run(double seconds)
+        {
+            double synth = 0.0, sender = 0.0, device = 0.0;
+            while (device < seconds)
+            {
+                const double next = std::min({synth, sender, device});
+                if (next == synth)
+                {
+                    synthesize(64, static_cast<uint32_t>(synth * 1000.0));
+                    synth += 64.0 / 48000.0;
+                }
+                else if (next == sender)
+                {
+                    send();
+                    sender += 0.005;
+                }
+                else
+                {
+                    played.pull(jitter, 1024, static_cast<uint32_t>(device * 1000.0));
+                    device += 1024.0 / 48000.0;
+                }
+            }
+        }
+    };
+}
