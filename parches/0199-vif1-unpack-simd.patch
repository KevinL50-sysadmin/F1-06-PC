+    // Scalar model of a VIF1 UNPACK (S/V2/V3/V4 with 32/16/8 bits), written from the VIF rules and not from the
+    // interpreter: CL >= WL skips, CL < WL fills (a data field takes ROW in a write without source), MASK per field and
+    // cycle, modes 1 and 2 add ROW (2 keeps the sum), V2 writes x y x y, V3 takes w from the next element of the
+    // stream (0 past the end of the packet).
+    struct UnpackModelCase
+    {
+        uint32_t vn, vl, cl, wl, mode, num, addr;
+        bool mask, zeroExtend;
+    };
+
+    void modelUnpack(std::vector<uint8_t> &vu, uint32_t row[4], const uint32_t col[4], uint32_t maskReg,
+                     const UnpackModelCase &c, const uint8_t *src, const uint8_t *packetEnd)
+    {
+        const uint32_t elemBytes = c.vl == 0u ? 4u : c.vl == 1u ? 2u : 1u;
+        const uint32_t vectorBytes = (c.vn + 1u) * elemBytes;
+        const uint32_t writes = c.num == 0u ? 256u : c.num;
+        uint32_t srcIndex = 0u;
+        for (uint32_t i = 0u; i < writes; ++i)
+        {
+            const uint32_t cyclePos = i % c.wl, block = i / c.wl;
+            const bool decoded = c.cl >= c.wl || cyclePos < c.cl;
+            const uint32_t dest = (c.cl >= c.wl ? c.addr + block * c.cl + cyclePos : c.addr + i) & 0x3FFu;
+            const uint8_t *vec = src + static_cast<size_t>(srcIndex) * vectorBytes;
+            if (decoded)
+                ++srcIndex;
+            const auto element = [&](uint32_t e) -> uint32_t
+            {
+                const uint8_t *q = vec + e * elemBytes;
+                if (q + elemBytes > packetEnd)
+                    return 0u;
+                if (c.vl == 0u)
+                {
+                    uint32_t v;
+                    std::memcpy(&v, q, 4u);
+                    return v;
+                }
+                if (c.vl == 1u)
+                {
+                    uint16_t v;
+                    std::memcpy(&v, q, 2u);
+                    return c.zeroExtend ? v : static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(v)));
+                }
+                return c.zeroExtend ? q[0] : static_cast<uint32_t>(static_cast<int32_t>(static_cast<int8_t>(q[0])));
+            };
+            uint32_t value[4] = {};
+            if (decoded)
+            {
+                for (uint32_t f = 0u; f < 4u; ++f)
+                    value[f] = element(c.vn == 0u ? 0u : c.vn == 1u ? (f & 1u) : f);
+            }
+            const uint32_t mc = cyclePos > 3u ? 3u : cyclePos;
+            uint32_t lanes[4];
+            std::memcpy(lanes, vu.data() + dest * 16u, sizeof(lanes));
+            for (uint32_t f = 0u; f < 4u; ++f)
+            {
+                uint32_t spec = c.mask ? (maskReg >> ((mc * 4u + f) * 2u)) & 3u : 0u;
+                if (!decoded && spec == 0u)
+                    spec = 1u;
+                if (spec == 0u)
+                {
+                    lanes[f] = value[f];
+                    if (c.mode == 1u || c.mode == 2u)
+                        lanes[f] += row[f];
+                    if (c.mode == 2u)
+                        row[f] = lanes[f];
+                }
+                else if (spec == 1u)
+                    lanes[f] = row[f];
+                else if (spec == 2u)
+                    lanes[f] = col[mc];
+            }
+            std::memcpy(vu.data() + dest * 16u, lanes, sizeof(lanes));
+        }
+    }
