diff --git a/ps2xTest/src/gs_test_sync.h b/ps2xTest/src/gs_test_sync.h
new file mode 100644
index 0000000..598093f
--- /dev/null
+++ b/ps2xTest/src/gs_test_sync.h
@@ -0,0 +1,11 @@
+#pragma once
+
+#include "runtime/gs/gs_frontend.h"
+
+// The tests run the GS as the game does: GIF packets from DMA/VIF1/XGKICK on the GIF thread (patch 0082), and the
+// rasterizer on its own thread and band workers (patches 0026, 0030). A test that reads or writes the local memory
+// array directly, instead of through GS::ReadVram/WriteVram, waits for the GS first.
+inline void waitForGs(const GS &gs)
+{
+    gs.waitIdle();
+}
