diff --git a/ps2xRuntime/include/runtime/gs/gs_frontend.h b/ps2xRuntime/include/runtime/gs/gs_frontend.h
index 4c3f641..1f53c01 100644
--- a/ps2xRuntime/include/runtime/gs/gs_frontend.h
+++ b/ps2xRuntime/include/runtime/gs/gs_frontend.h
@@ -147,6 +147,9 @@ public:
 
     void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value);
     uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const;
+    // Until every GIF packet queued by this thread and every backend command so far has run, so the caller may read
+    // or write the local memory array directly (tests; the GS methods that return data already wait).
+    void waitIdle() const;
 
 private:
     void snapshotVRAM();
diff --git a/ps2xRuntime/src/lib/gs/gs_frontend.cpp b/ps2xRuntime/src/lib/gs/gs_frontend.cpp
index e2444e9..a6739ac 100644
--- a/ps2xRuntime/src/lib/gs/gs_frontend.cpp
+++ b/ps2xRuntime/src/lib/gs/gs_frontend.cpp
@@ -2196,6 +2196,16 @@ uint32_t GS::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint
     return m_backend ? m_backend->ReadVram(psm, base, bw, x, y) : 0u;
 }
 
+void GS::waitIdle() const
+{
+    gifSyncBeforeAccess(__func__);
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    // A readback is what every backend completes first: the threaded one drains its queue, the CPU one waits for its
+    // band jobs.
+    if (m_backend)
+        (void)m_backend->ReadVram(GS_PSM_CT32, 0u, 1u, 0u, 0u);
+}
+
 void GS::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
 {
     gifSyncBeforeAccess(__func__);
