diff --git a/ps2xRuntime/src/lib/ps2_camera_fov.h b/ps2xRuntime/src/lib/ps2_camera_fov.h
new file mode 100644
index 0000000..7ac2ac9
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_camera_fov.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+// Fase 5 (T12, F1 06): the race cameras' field of view (opciones.ini fov: 0 = the game's, 5 to 30 = that percent
+// wider; AJUSTES PC and the F2 menu). The game gives every race camera a half angle (vertical, in radians) through
+// func_2C5948; src/f1_overrides.cpp widens it there on every frame, so a change shows on the next frame.
+namespace ps2x
+{
+    constexpr int kCameraFovMaxPercent = 30;
+    // The widest half angle given to the game (about 80 degrees; the game itself stops at pi/2, where the tangent of
+    // its projection blows up).
+    constexpr float kCameraFovLimit = 1.4f;
+
+    // The game's half angle widened by percent (clamped to 0..kCameraFovMaxPercent), at most kCameraFovLimit. A
+    // percent of 0 or an angle that is not a positive number leaves it as it was; it never narrows it.
+    inline float widenedCameraFov(float halfAngle, int percent)
+    {
+        if (!(halfAngle > 0.0f) || percent <= 0)
+            return halfAngle;
+        const float widened = halfAngle * (1.0f + static_cast<float>(std::min(percent, kCameraFovMaxPercent)) / 100.0f);
+        return std::max(halfAngle, std::min(widened, kCameraFovLimit));
+    }
+}
