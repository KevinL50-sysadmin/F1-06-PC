+// Fase 5 (T8): the photos (tecla_foto, F12 by default; ps2_photo.h). The key, or the menu script's "foto", asks for one;
+// the next UploadFrame copies the picture on screen (the latched frame at its internal size, before the window's
+// filters) and a thread of its own encodes the PNG and writes it, so the window and the game do not wait for it. The
+// window shows a line for a few seconds and the log gets [foto].
+namespace
+{
+    std::mutex g_photoMutex;
+    std::string g_photoKey;
+    bool g_photoKeyRead = false;
+    std::string g_photoMessage; // what the window shows
