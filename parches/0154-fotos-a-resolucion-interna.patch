+        if (number > 1)
+            text += "_" + std::to_string(number);
+        return text + ".png";
+    }
+
+    fs::path uniquePhotoPath(const fs::path &folder, const std::tm &time,
+                             const std::function<bool(const fs::path &)> &exists)
+    {
+        for (int number = 1;; ++number)
+        {
+            fs::path path = folder / photoFileName(time, number);
+            if (!exists(path) || number >= 1000)
+                return path;
+        }
+    }
