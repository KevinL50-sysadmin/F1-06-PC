+
+static void SetPhotoMessage(const std::string &message)
+{
+    std::lock_guard<std::mutex> lock(g_photoMutex);
+    g_photoMessage = message;
+    g_photoMessageNew = true;
+}
+
+// frame: rows of rowPixels pixels, the picture in its top left width x height pixels (as SaveRequestedCapture).
+static void SavePhoto(const std::vector<uint8_t> &frame, uint32_t rowPixels, uint32_t width, uint32_t height)
+{
+    width = std::min<uint32_t>(width, rowPixels);
+    if (width == 0u || height == 0u || frame.size() < static_cast<size_t>(rowPixels) * height * 4u)
+        return;
+    std::vector<uint8_t> pixels(static_cast<size_t>(width) * height * 4u);
+    for (uint32_t y = 0; y < height; ++y)
+        std::memcpy(pixels.data() + static_cast<size_t>(y) * width * 4u,
+                    frame.data() + static_cast<size_t>(y) * rowPixels * 4u, static_cast<size_t>(width) * 4u);
+    for (size_t i = 3u; i < pixels.size(); i += 4u)
+        pixels[i] = 0xFFu;
+
+    std::filesystem::path folder = ps2x::userPhotosDirectory();
+    if (folder.empty())
+        folder = "capturas";
+    const std::time_t now = std::time(nullptr);
+    std::tm local{};
+#if defined(_WIN32)
+    localtime_s(&local, &now);
+#else
+    localtime_r(&now, &local);
+#endif
+    std::filesystem::path path;
+    {
+        std::lock_guard<std::mutex> lock(g_photoMutex);
+        path = ps2x::uniquePhotoPath(folder, local, [](const std::filesystem::path &candidate)
+                                     {
+                                         std::error_code error;
+                                         return g_photosReserved.count(candidate) != 0u ||
+                                                std::filesystem::exists(candidate, error);
+                                     });
+        g_photosReserved.insert(path);
+    }
+    g_photosWriting.fetch_add(1);
+    std::thread([pixels = std::move(pixels), path, width, height]() mutable
+                {
+                    ThreadNaming::SetCurrentThreadName("Foto");
+                    const auto start = std::chrono::steady_clock::now();
+                    Image image{pixels.data(), static_cast<int>(width), static_cast<int>(height), 1,
+                                PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+                    int size = 0;
+                    unsigned char *png = ExportImageToMemory(image, ".png", &size);
+                    std::error_code error;
+                    std::filesystem::create_directories(path.parent_path(), error);
+                    bool saved = false;
+                    if (png != nullptr && size > 0)
+                    {
+                        std::ofstream out(path, std::ios::binary | std::ios::trunc);
+                        out.write(reinterpret_cast<const char *>(png), size);
+                        saved = static_cast<bool>(out);
+                    }
+                    if (png != nullptr)
+                        MemFree(png);
+                    const long long ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                             std::chrono::steady_clock::now() - start).count();
+                    if (saved)
+                    {
+                        std::cout << "[foto] guardada " << ps2x::pathForLog(path) << " (" << width << "x" << height
+                                  << ", " << ms << " ms)" << std::endl;
+                        SetPhotoMessage("Foto guardada: " + ps2x::pathForLog(path.filename()));
+                    }
+                    else
+                    {
+                        std::cerr << "[foto] no se pudo guardar " << ps2x::pathForLog(path) << std::endl;
+                        SetPhotoMessage("No se pudo guardar la foto en " + ps2x::pathForLog(path.parent_path()));
+                    }
+                    {
+                        std::lock_guard<std::mutex> lock(g_photoMutex);
+                        g_photosReserved.erase(path);
+                    }
+                    g_photosWriting.fetch_sub(1);
+                })
+        .detach();
+}
+
+// The photo's line at the bottom of the window, for 3 seconds (main thread, between BeginDrawing and EndDrawing).
+static void DrawPhotoMessage()
+{
+    static std::string s_message;
+    static double s_until = 0.0;
+    {
+        std::lock_guard<std::mutex> lock(g_photoMutex);
+        if (g_photoMessageNew)
+        {
+            s_message = g_photoMessage;
+            s_until = GetTime() + 3.0;
+            g_photoMessageNew = false;
+        }
+    }
+    if (s_message.empty() || GetTime() >= s_until)
+        return;
+    const int fontSize = std::max(10, GetScreenHeight() / 40);
+    const int padding = fontSize / 3;
+    const int width = MeasureText(s_message.c_str(), fontSize) + 2 * padding;
+    const int y = GetScreenHeight() - fontSize - 4 * padding;
+    DrawRectangle(2 * padding, y, width, fontSize + 2 * padding, Fade(BLACK, 0.6f));
+    DrawText(s_message.c_str(), 3 * padding, y + padding, fontSize, RAYWHITE);
+}
