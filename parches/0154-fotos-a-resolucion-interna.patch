+// Fase 5 (T8, F1 06): the photos (opciones.ini tecla_foto: f12, f9, f8 or no). The key saves the game's picture at its
+// internal resolution (the GPU GS's supersampled or double resolution output included) as a PNG in the photos folder
+// (ps2x::userPhotosDirectory), written on a thread of its own so the game does not wait for it (ps2_runtime.cpp).
+namespace ps2x
+{
+    // Any thread (the options menus); the window uses it from its next frame. Unknown values: no key.
+    void setPhotoKeyOption(const std::string &option);
+    std::string photoKeyOption();
+    // Takes a photo of the next window frame (the key; PS2X_MENU_GUION's "foto" action in the tests).
+    void requestPhoto();
+}
