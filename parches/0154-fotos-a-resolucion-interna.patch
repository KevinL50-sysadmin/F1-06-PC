+    std::string photoFileName(const std::tm &time, int number)
+    {
+        char name[64];
+        std::snprintf(name, sizeof(name), "F1-06_%04d-%02d-%02d_%02d-%02d-%02d", time.tm_year + 1900, time.tm_mon + 1,
+                      time.tm_mday, time.tm_hour, time.tm_min, time.tm_sec);
