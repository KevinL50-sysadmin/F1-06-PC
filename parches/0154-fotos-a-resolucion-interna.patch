+        g_photoKey = option;
+        g_photoKeyRead = true;
+    }
+
+    std::string photoKeyOption()
+    {
+        std::lock_guard<std::mutex> lock(g_photoMutex);
+        if (!g_photoKeyRead)
+        {
+            const char *value = std::getenv("PS2X_TECLA_FOTO");
+            g_photoKey = value != nullptr ? value : "f12";
+            g_photoKeyRead = true;
+        }
+        return g_photoKey;
+    }
