+    // Writes from the current write on (cyclePos/blockIndex: those of the previous write) until the count or the
+    // first vector with less than 16 bytes of packet left; returns how many it wrote. Plain: no mask and mode 0.
+    template <uint32_t VL, uint32_t VN, bool Plain>
+    uint32_t unpackFast(uint8_t *vuData, const uint8_t *srcBase, uint32_t bytesPerVector, const uint8_t *packetEnd,
+                        uint32_t count, uint32_t vuAddr, uint32_t cl, uint32_t wl, bool zeroExtend, uint32_t addMode,
+                        const UnpackSelect &sel, uint32_t *row, uint32_t &cyclePos, uint32_t &blockIndex)
+    {
+        uint32_t w = 0u;
+        for (; w < count; ++w)
+        {
+            const uint8_t *src = srcBase + static_cast<size_t>(w) * bytesPerVector;
+            if (src + 16u > packetEnd)
+                break;
+            if (++cyclePos == wl)
+            {
+                cyclePos = 0u;
+                ++blockIndex;
+            }
+            uint8_t *dst = vuData + ((vuAddr + blockIndex * cl + cyclePos) & 0x3FFu) * 16u;
+            __m128i value = unpackDecode<VL, VN>(src, zeroExtend);
+            if constexpr (Plain)
+                _mm_storeu_si128(reinterpret_cast<__m128i *>(dst), value);
+            else
+            {
+                const uint32_t mc = cyclePos > 3u ? 3u : cyclePos;
+                const __m128i rowV = _mm_loadu_si128(reinterpret_cast<const __m128i *>(row));
+                if (addMode == 1u || addMode == 2u)
+                    value = _mm_add_epi32(value, rowV);
+                const __m128i old = _mm_loadu_si128(reinterpret_cast<const __m128i *>(dst));
+                const __m128i result =
+                    _mm_or_si128(_mm_or_si128(_mm_and_si128(sel.data[mc], value), _mm_and_si128(sel.row[mc], rowV)),
+                                 _mm_or_si128(_mm_and_si128(sel.col[mc], sel.colAll[mc]), _mm_and_si128(sel.keep[mc], old)));
+                _mm_storeu_si128(reinterpret_cast<__m128i *>(dst), result);
+                if (addMode == 2u)
+                    _mm_storeu_si128(reinterpret_cast<__m128i *>(row),
+                                     _mm_or_si128(_mm_and_si128(sel.data[mc], value), _mm_andnot_si128(sel.data[mc], rowV)));
+            }
+        }
+        return w;
+    }
+
+    template <bool Plain>
+    uint32_t unpackFastFormat(uint32_t vl, uint32_t vn, uint8_t *vuData, const uint8_t *srcBase, uint32_t bytesPerVector,
+                              const uint8_t *packetEnd, uint32_t count, uint32_t vuAddr, uint32_t cl, uint32_t wl,
+                              bool zeroExtend, uint32_t addMode, const UnpackSelect &sel, uint32_t *row,
+                              uint32_t &cyclePos, uint32_t &blockIndex)
+    {
+#define PS2_UNPACK_FAST(L, N)                                                                                         \
+    case (L << 2) | N:                                                                                                \
+        return unpackFast<L, N, Plain>(vuData, srcBase, bytesPerVector, packetEnd, count, vuAddr, cl, wl, zeroExtend, \
+                                       addMode, sel, row, cyclePos, blockIndex);
+        switch ((vl << 2) | vn)
+        {
+            PS2_UNPACK_FAST(0u, 0u)
+            PS2_UNPACK_FAST(0u, 1u)
+            PS2_UNPACK_FAST(0u, 2u)
+            PS2_UNPACK_FAST(0u, 3u)
+            PS2_UNPACK_FAST(1u, 0u)
+            PS2_UNPACK_FAST(1u, 1u)
+            PS2_UNPACK_FAST(1u, 2u)
+            PS2_UNPACK_FAST(1u, 3u)
+            PS2_UNPACK_FAST(2u, 0u)
+            PS2_UNPACK_FAST(2u, 1u)
+            PS2_UNPACK_FAST(2u, 2u)
+            PS2_UNPACK_FAST(2u, 3u)
+        default:
+            return 0u; // V4-5 and the unknown formats: the general loop
+        }
+#undef PS2_UNPACK_FAST
+    }
+}
