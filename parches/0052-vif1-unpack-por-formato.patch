+    // UNPACK by format (patch 0051): with CL >= WL every write takes the next source vector, and while 16 bytes of
+    // the packet remain from the vector the decode reads them without the per-element bounds checks (as element()
+    // in processVIF1Data: S fills xyzw, V2 writes x y x y, V3 takes w from the next element of the stream).
+    template <uint32_t VL, uint32_t VN>
+    __forceinline __m128i unpackDecode(const uint8_t *src, bool zeroExtend)
+    {
+        __m128i v;
+        if constexpr (VL == 0u)
+        {
+            if constexpr (VN >= 2u)
+                v = _mm_loadu_si128(reinterpret_cast<const __m128i *>(src));
+            else
+                v = _mm_loadl_epi64(reinterpret_cast<const __m128i *>(src));
+        }
+        else if constexpr (VL == 1u)
+        {
+            const __m128i h = _mm_loadl_epi64(reinterpret_cast<const __m128i *>(src));
+            v = zeroExtend ? _mm_unpacklo_epi16(h, _mm_setzero_si128()) : _mm_srai_epi32(_mm_unpacklo_epi16(h, h), 16);
+        }
+        else
+        {
+            int32_t word;
+            std::memcpy(&word, src, sizeof(word));
+            const __m128i b = _mm_cvtsi32_si128(word);
+            if (zeroExtend)
+                v = _mm_unpacklo_epi16(_mm_unpacklo_epi8(b, _mm_setzero_si128()), _mm_setzero_si128());
+            else
+            {
+                const __m128i b8 = _mm_unpacklo_epi8(b, b);
+                v = _mm_srai_epi32(_mm_unpacklo_epi16(b8, b8), 24);
+            }
+        }
+        if constexpr (VN == 0u)
+            v = _mm_shuffle_epi32(v, _MM_SHUFFLE(0, 0, 0, 0));
+        else if constexpr (VN == 1u)
+            v = _mm_shuffle_epi32(v, _MM_SHUFFLE(1, 0, 1, 0));
+        return v;
+    }
+
+    struct UnpackSelect
