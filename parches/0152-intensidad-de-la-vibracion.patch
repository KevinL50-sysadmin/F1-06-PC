diff --git a/ps2xRuntime/src/lib/ps2_pad.cpp b/ps2xRuntime/src/lib/ps2_pad.cpp
index 5f66dcd..c8b71fa 100644
--- a/ps2xRuntime/src/lib/ps2_pad.cpp
+++ b/ps2xRuntime/src/lib/ps2_pad.cpp
@@ -829,8 +829,51 @@ namespace ps2x
         return connected;
     }
 
+    namespace
+    {
+        // Fase 5 (T6): opciones.ini vibracion; -1 until the first rumble reads PS2X_VIBRACION (opciones.ini sets the
+        // variables after the static objects are built).
+        std::atomic<int> g_rumblePercent{-1};
+
+        int rumblePercent()
+        {
+            int percent = g_rumblePercent.load(std::memory_order_relaxed);
+            if (percent < 0)
+            {
+                const int fromEnvironment = rumbleIntensityFromText(std::getenv("PS2X_VIBRACION"));
+                g_rumblePercent.compare_exchange_strong(percent, fromEnvironment, std::memory_order_relaxed);
+                percent = g_rumblePercent.load(std::memory_order_relaxed);
+            }
+            return percent;
+        }
+    }
+
+    float scaledRumble(float motor, int percent)
+    {
+        return std::clamp(motor, 0.0f, 1.0f) * static_cast<float>(std::clamp(percent, 0, 100)) / 100.0f;
+    }
+
+    int rumbleIntensityFromText(const char *text)
+    {
+        if (text == nullptr || *text == '\0')
+            return 100;
+        char *end = nullptr;
+        const long value = std::strtol(text, &end, 10);
+        if (end == text || *end != '\0')
+            return 100;
+        return static_cast<int>(std::clamp<long>(value, 0, 100));
+    }
+
+    void setRumbleIntensity(int percent)
+    {
+        g_rumblePercent.store(std::clamp(percent, 0, 100), std::memory_order_relaxed);
+    }
+
     void setPadPortRumble(int port, float smallMotor, float largeMotor)
     {
+        const int percent = rumblePercent();
+        smallMotor = scaledRumble(smallMotor, percent);
+        largeMotor = scaledRumble(largeMotor, percent);
         if (port == 0)
         {
             ps2_pad_win::setRumble(smallMotor, largeMotor);
