index 0000000..50f24d6
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_threaded_backend.h
@@ -0,0 +1,125 @@
+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+#include "runtime/gs/gs_cpu_backend.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <variant>
+#include <vector>
+
+// Runs the software rasterizer (GSCpuBackend) on its own thread. The GS front-end keeps parsing GIF packets on the EE
+// thread, and every backend call that changes local memory (draws, CLUT loads, transfers, uploads, clears) is queued
+// in order and executed by the worker, so the EE/VIF1/VU1 work overlaps with rasterization. Calls that read local
+// memory back wait until the queue is empty. Presentation is queued too, as a snapshot of local memory taken in order
+// with the draws; Present() converts the newest snapshot and never waits for pending draws (the displayed frame is one
+// presentation behind).
+// The queue is bounded by estimated work (pixels), not only by commands: a full-screen primitive costs milliseconds and
+// a small one microseconds, so a command bound alone let the EE run tens of seconds ahead of the rasterizer.
+// PS2X_GS_THREAD=0 selects the plain GSCpuBackend instead.
+class GSThreadedBackend final : public GSRasterBackend
+{
+public:
+    GSThreadedBackend();
+    ~GSThreadedBackend() override;
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+private:
+    struct ClutCommand
+    {
+        GSTex0Reg tex0{};
+        GSTexClutReg texclut{};
+    };
+    struct ClearCommand
+    {
+        GSContext context{};
+        uint32_t rgba = 0;
+    };
+    struct WriteVramCommand
+    {
+        uint32_t psm = 0, base = 0, bw = 0, x = 0, y = 0, value = 0;
+    };
+    struct TextureFlushCommand
+    {
+    };
+    struct SnapshotCommand
+    {
+        GSPresentationRequest request{};
+    };
+    using Command = std::variant<GSPrimitiveBatch, ClutCommand, GSTransferCommand, std::vector<uint8_t>,
+                                 TextureFlushCommand, ClearCommand, WriteVramCommand, SnapshotCommand>;
+    struct Slot
+    {
+        Command command;
+        uint32_t cost = 0u; // estimated work, in pixels
+    };
+
+    static constexpr uint64_t kCapacity = 16384u;
+    static constexpr uint64_t kChunk = 512u;
+    static constexpr uint64_t kMaxPendingCost = 2000000u; // about 5 full 640x448 screens of pixels
+    static constexpr uint32_t kPublishCost = 65536u;       // the worker reports progress at least this often
+
+    template <typename T>
+    void Push(T &&command, uint32_t cost);
+    void Drain() const;
+    void WorkerLoop();
+    void Execute(Command &command, uint64_t index);
+
+    std::unique_ptr<GSCpuBackend> m_cpu;
+    std::vector<Slot> m_ring;
+    mutable std::mutex m_mutex;
+    mutable std::condition_variable m_notEmpty;
+    mutable std::condition_variable m_notFull;
+    mutable std::condition_variable m_idle;
+    uint64_t m_head = 0u;        // next command the worker runs
+    uint64_t m_tail = 0u;        // next free slot
+    uint64_t m_pendingCost = 0u; // cost of the commands in [m_head, m_tail)
+    uint32_t m_producersWaiting = 0u;
+    bool m_workerBusy = false;
+    bool m_workerWaiting = false;
+    bool m_stop = false;
+    std::atomic<uint64_t> m_lastSnapshotIndex{UINT64_MAX}; // ring index of the newest queued snapshot
+    mutable std::atomic<uint64_t> m_fullWaits{0u};          // pushes that found the queue full (statistics)
+    mutable std::atomic<uint64_t> m_drains{0u};             // drains that had to wait for the worker (statistics)
+    mutable std::atomic<uint64_t> m_producerWaitNs{0u};     // time producers spent waiting (statistics)
+    std::thread m_worker;
+
+    // Presentation. The worker publishes local-memory snapshots; Present() converts the newest one.
+    std::mutex m_publishMutex;
+    std::vector<uint8_t> m_workerSnapshot;
+    std::vector<uint8_t> m_publishedSnapshot;
+    GSPresentationRequest m_publishedRequest{};
+    uint64_t m_publishedSerial = 0u;
+    std::mutex m_presentMutex; // serializes Present() callers; guards the fields below
+    std::vector<uint8_t> m_presentSnapshot;
+    GSPresentationRequest m_presentRequest{};
+    uint64_t m_presentSerial = 0u;
+    PresentationFrame m_presentFrame;
+};
+
+// Backend used by the GS front-end: GSThreadedBackend, or GSCpuBackend with PS2X_GS_THREAD=0.
+std::unique_ptr<GSRasterBackend> CreateDefaultGSRasterBackend();
