+namespace
+{
+    using ReadVramFn = uint32_t (*)(uint8_t *, uint32_t, uint32_t, uint32_t, uint32_t);
+    using WriteVramFn = void (*)(uint8_t *, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t);
+
+    // The part of WritePixel that depends only on the draw state, worked out once per primitive. writePixelFast does
+    // exactly what WritePixel does with it.
+    struct PixelPipeline
+    {
+        int scissorX0 = 0, scissorX1 = 0, scissorY0 = 0, scissorY1 = 0;
+        bool fge = false;
+        uint8_t fogR = 0, fogG = 0, fogB = 0;
+        uint32_t fbp = 0, fbw = 1, fpsm = 0, zbp = 0, zpsm = 0;
+        uint64_t test = 0;
+        uint32_t ztestMethod = 0;
+        bool abe = false;
+        bool pabe = false;
+        uint8_t asel = 0, bsel = 0, csel = 0, dsel = 0, fix = 0;
+        bool fbaSetsAlpha = false;
+        uint32_t fbmsk = 0;
+        bool frame16 = false;
+        bool frameCt24 = false;
+        bool frameCt32 = false;
+        bool dateNeedsRead = false;
+        bool zmask = false;
+        ReadVramFn readFrame = nullptr;
+        ReadVramFn readZ = nullptr;
+        WriteVramFn writeFrame = nullptr;
+        WriteVramFn writeZ = nullptr;
+    };
+
+    inline void writePixelFast(uint8_t *vram, const PixelPipeline &pp, int x, int y, int z, uint8_t r, uint8_t g,
+                               uint8_t b, uint8_t a, uint8_t fog)
+    {
+        if (x < pp.scissorX0 || x > pp.scissorX1 || y < pp.scissorY0 || y > pp.scissorY1)
+            return;
+
+        if (pp.fge)
+        {
+            const uint32_t inverseFog = 255u - fog;
+            auto applyFog = [&](uint8_t input, uint8_t fogColor) -> uint8_t
+            {
+                return static_cast<uint8_t>(((static_cast<uint32_t>(fog) * input) >> 8) + ((inverseFog * fogColor) >> 8));
+            };
+
+            r = applyFog(r, pp.fogR);
+            g = applyFog(g, pp.fogG);
+            b = applyFog(b, pp.fogB);
+        }
+
+        const PixelWriteMask writeMask = classifyAlphaTest(pp.test, a, static_cast<uint8_t>(pp.fpsm));
+        if (!writeMask.writesAnything())
+            return;
+
+        const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha && pp.frameCt32;
+        const bool frmw = pp.dateNeedsRead ||
+                          (writeMask.writesFramebuffer() && (pp.fbmsk != 0 || pp.abe || preserveDestinationAlpha));
+
+        u32 rawFramebufferPixel = 0;
+        u32 fbrgba = 0;
+        if (frmw)
+        {
+            rawFramebufferPixel = pp.readFrame(vram, pp.fbp, pp.fbw, x, y);
+            fbrgba = rawFramebufferPixel;
+            if (pp.frame16)
+                fbrgba = Rgba5551ToRgba8888(fbrgba);
+            else if (pp.frameCt24)
+                fbrgba |= 0x80000000u;
+        }
+
+        if (!passesDestinationAlphaTest(pp.test, static_cast<uint8_t>(pp.fpsm), rawFramebufferPixel))
+            return;
+
+        bool zpass = false;
+        uint32_t storedZ = 0u;
+        switch (pp.ztestMethod)
+        {
+        case 0:
+            zpass = false;
+            break;
+        case 1:
+            zpass = true;
+            break;
+        case 2:
+            storedZ = pp.readZ(vram, pp.zbp, pp.fbw, x, y);
+            zpass = static_cast<uint32_t>(z) >= storedZ;
+            break;
+        case 3:
+            storedZ = pp.readZ(vram, pp.zbp, pp.fbw, x, y);
+            zpass = static_cast<uint32_t>(z) > storedZ;
+            break;
+        }
+        if (!zpass)
+            return;
+
+        if (writeMask.writesFramebuffer())
+        {
+            if (pp.abe && !(pp.pabe && (a & 0x80u) == 0u))
+            {
+                const uint8_t dr = fbrgba & 0xFF;
+                const uint8_t dg = (fbrgba >> 8) & 0xFF;
+                const uint8_t db = (fbrgba >> 16) & 0xFF;
+                const uint8_t da = (fbrgba >> 24) & 0xFF;
+                auto pickRGB = [](uint8_t sel, int cs, int cd) -> int
+                {
+                    if (sel == 0)
+                        return cs;
+                    if (sel == 1)
+                        return cd;
+                    return 0;
+                };
+                const int cAlpha = (pp.csel == 0) ? a : (pp.csel == 1) ? da
+                                                                       : pp.fix;
+                r = clampU8(((pickRGB(pp.asel, r, dr) - pickRGB(pp.bsel, r, dr)) * cAlpha >> 7) + pickRGB(pp.dsel, r, dr));
+                g = clampU8(((pickRGB(pp.asel, g, dg) - pickRGB(pp.bsel, g, dg)) * cAlpha >> 7) + pickRGB(pp.dsel, g, dg));
+                b = clampU8(((pickRGB(pp.asel, b, db) - pickRGB(pp.bsel, b, db)) * cAlpha >> 7) + pickRGB(pp.dsel, b, db));
+            }
+
+            if (writeMask.writeAlpha && pp.fbaSetsAlpha)
+                a = static_cast<uint8_t>(a | 0x80u);
+
+            u32 pixel = pack32(r, g, b, a);
+            if (pp.fbmsk != 0)
+                pixel = (pixel & ~pp.fbmsk) | (fbrgba & pp.fbmsk);
+            if (preserveDestinationAlpha)
+                pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+            if (pp.frame16)
+                pixel = Rgba8888ToRgba5551(pixel);
+            pp.writeFrame(vram, pp.fbp, pp.fbw, x, y, pixel);
+        }
+
+        if (writeMask.writeDepth && !pp.zmask)
+            pp.writeZ(vram, pp.zbp, pp.fbw, x, y, static_cast<uint32_t>(z));
+    }
+}
