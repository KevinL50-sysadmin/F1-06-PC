+        pp.zmask = ctx.zbuf.zmask;
+        pp.readFrame = m_readVramFuncs[fpsm & 0x3Fu];
+        pp.writeFrame = m_writeVramFuncs[fpsm & 0x3Fu];
+        pp.readZ = m_readVramFuncs[pp.zpsm & 0x3Fu];
+        pp.writeZ = m_writeVramFuncs[pp.zpsm & 0x3Fu];
+    }
+
+    // Vertex attributes as floats (the conversions are exact, as in the expressions of the reference).
+    const float r0 = v0.r, r1 = v1.r, r2 = v2.r;
+    const float g0 = v0.g, g1 = v1.g, g2 = v2.g;
+    const float b0 = v0.b, b1 = v1.b, b2 = v2.b;
+    const float a0 = v0.a, a1 = v1.a, a2 = v2.a;
+    const float fog0 = v0.fog, fog1 = v1.fog, fog2 = v2.fog;
+    const float u0 = v0.u, u1 = v1.u, u2 = v2.u;
+    const float t0 = v0.v, t1 = v1.v, t2 = v2.v;
+    const bool iip = state.prim.iip;
+    const bool tme = state.prim.tme;
+    const bool fst = state.prim.fst;
+    const auto &tex = ctx.tex0;
+    const float e0 = fy1 - fy2;
+    const float e1 = fy2 - fy0;
+
+    for (int y = minY; y <= maxY; ++y)
+    {
+        float py = static_cast<float>(y) + 0.5f;
+        int spanX0 = minX;
+        int spanX1 = maxX;
+        {
+            const float offset0 = ((fx2 - fx1) * (py - fy2) - (fy1 - fy2) * fx2) * k;
+            const float offset1 = ((fx0 - fx2) * (py - fy2) - (fy2 - fy0) * fx2) * k;
+            const float offset2 = 1.0f - offset0 - offset1;
+            float lo = static_cast<float>(minX) + 0.5f;
+            float hi = static_cast<float>(maxX) + 0.5f;
+            if (!narrowSpan(slope0, offset0, lo, hi) || !narrowSpan(slope1, offset1, lo, hi) ||
+                !narrowSpan(slope2, offset2, lo, hi) || !(lo <= hi + 2.0f))
+                continue;
+            spanX0 = std::max(minX, static_cast<int>(std::floor(lo - 0.5f)) - 1);
+            spanX1 = std::min(maxX, static_cast<int>(std::ceil(hi - 0.5f)) + 1);
+        }
+        const float row0 = (fx2 - fx1) * (py - fy2);
+        const float row1 = (fx0 - fx2) * (py - fy2);
+        for (int x = spanX0; x <= spanX1; ++x)
+        {
+            float px = static_cast<float>(x) + 0.5f;
+
+            float w0 = ((e0 * (px - fx2) + row0) * winding) * invAbsDenom;
+            float w1 = ((e1 * (px - fx2) + row1) * winding) * invAbsDenom;
+            float w2 = 1.0f - w0 - w1;
+
+            if (w0 < -kEdgeEpsilon || w1 < -kEdgeEpsilon || w2 < -kEdgeEpsilon)
+                continue;
+
+            double z = v0.z * w0 + v1.z * w1 + v2.z * w2;
+
+            uint8_t r, g, b, a;
+            if (iip)
+            {
+                r = clampU8(static_cast<int>(r0 * w0 + r1 * w1 + r2 * w2));
+                g = clampU8(static_cast<int>(g0 * w0 + g1 * w1 + g2 * w2));
+                b = clampU8(static_cast<int>(b0 * w0 + b1 * w1 + b2 * w2));
+                a = clampU8(static_cast<int>(a0 * w0 + a1 * w1 + a2 * w2));
+            }
+            else
+            {
+                r = v2.r;
+                g = v2.g;
+                b = v2.b;
+                a = v2.a;
+            }
+
+            if (tme)
+            {
+                float is, it, iq;
+                uint16_t iu, iv;
+                if (fst)
+                {
+                    iu = static_cast<uint16_t>(u0 * w0 + u1 * w1 + u2 * w2);
+                    iv = static_cast<uint16_t>(t0 * w0 + t1 * w1 + t2 * w2);
+                    is = 0.0f;
+                    it = 0.0f;
+                    iq = 1.0f;
+                }
+                else
+                {
+                    is = v0.s * w0 + v1.s * w1 + v2.s * w2;
+                    it = v0.t * w0 + v1.t * w1 + v2.t * w2;
+                    iq = v0.q * w0 + v1.q * w1 + v2.q * w2;
+                    iu = 0;
+                    iv = 0;
+                }
+
+                const uint32_t texel = SampleTexture(state, is, it, iq, iu, iv);
+                const TextureCombineResult color = combineTexture(tex, r, g, b, a,
+                                                                  static_cast<uint8_t>(texel & 0xFF),
+                                                                  static_cast<uint8_t>((texel >> 8) & 0xFF),
+                                                                  static_cast<uint8_t>((texel >> 16) & 0xFF),
+                                                                  static_cast<uint8_t>((texel >> 24) & 0xFF));
+                r = color.r;
+                g = color.g;
+                b = color.b;
+                a = color.a;
+            }
+
+            const uint8_t fog = clampU8(static_cast<int>(fog0 * w0 + fog1 * w1 + fog2 * w2));
+            writePixelFast(m_vram, pp, x, y, static_cast<u32>(z + 0.5), r, g, b, a, fog);
+        }
+    }
+}
+
+void GSCpuBackend::VerifyTriangle(const GSPrimitiveBatch &batch)
+{
+    // Draws the triangle with the reference rasterizer on a copy of local memory and with the current one on the real
+    // memory, and compares the whole 4 MB. Slow: only for the first F1_GS_VERIFICAR triangles.
+    static std::vector<uint8_t> before;
+    static std::vector<uint8_t> reference;
+    static uint64_t checked = 0u;
+    static uint64_t different = 0u;
+    before.assign(m_vram, m_vram + m_vramSize);
+    DrawTriangleReference(batch);
+    reference.assign(m_vram, m_vram + m_vramSize);
+    std::memcpy(m_vram, before.data(), m_vramSize);
+    DrawTriangle(batch);
+    ++checked;
+    if (std::memcmp(m_vram, reference.data(), m_vramSize) != 0)
+    {
+        ++different;
+        size_t first = 0u;
+        size_t count = 0u;
+        for (size_t i = 0; i < m_vramSize; ++i)
+            if (m_vram[i] != reference[i])
+            {
+                if (count++ == 0u)
+                    first = i;
+            }
+        const GSDrawState &state = batch.state;
+        if (different <= 20u)
+            std::fprintf(stderr,
+                         "[gs:verificar] DISTINTO triangulo %llu: %zu bytes, primero 0x%zx (%02x frente a %02x) tme=%d "
+                         "fst=%d iip=%d abe=%d fge=%d fpsm=%d zpsm=%d test=0x%llx alpha=0x%llx\n",
+                         static_cast<unsigned long long>(checked), count, first, m_vram[first], reference[first],
+                         int(state.prim.tme), int(state.prim.fst), int(state.prim.iip), int(state.prim.abe),
+                         int(state.prim.fge), int(state.context.frame.psm), int(state.context.zbuf.psm),
+                         static_cast<unsigned long long>(state.context.test),
+                         static_cast<unsigned long long>(state.context.alpha));
+        // Keep the reference result so later triangles start from the same memory in both versions.
+        std::memcpy(m_vram, reference.data(), m_vramSize);
+    }
+    if ((checked % 2000u) == 0u)
+        std::fprintf(stderr, "[gs:verificar] %llu triangulos comprobados, %llu distintos\n",
+                     static_cast<unsigned long long>(checked), static_cast<unsigned long long>(different));
+}
