+GSThreadedBackend::GSThreadedBackend()
+    : m_cpu(std::make_unique<GSCpuBackend>()),
+      m_ring(kCapacity)
+{
+    m_worker = std::thread([this]()
+                           { WorkerLoop(); });
+}
+
+GSThreadedBackend::~GSThreadedBackend()
+{
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_stop = true;
+    }
+    m_notEmpty.notify_all();
+    if (m_worker.joinable())
+        m_worker.join();
+}
+
+template <typename T>
+void GSThreadedBackend::Push(T &&command, uint32_t cost)
+{
+    cost += kCommandCost;
+    std::unique_lock<std::mutex> lock(m_mutex);
+    // Wait for a free slot and for the queued work to fall under the bound (a command larger than the bound still
+    // goes in when the queue is empty).
+    const auto hasRoom = [this, cost]()
+    {
+        return m_tail - m_head < kCapacity && (m_head == m_tail || m_pendingCost + cost <= kMaxPendingCost);
+    };
+    if (!hasRoom())
+    {
+        m_fullWaits.fetch_add(1u, std::memory_order_relaxed);
+        const auto waitStart = std::chrono::steady_clock::now();
+        ++m_producersWaiting;
+        m_notFull.wait(lock, hasRoom);
+        --m_producersWaiting;
+        const auto waited = std::chrono::steady_clock::now() - waitStart;
+        m_producerWaitNs.fetch_add(
+            static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(waited).count()),
+            std::memory_order_relaxed);
+    }
+    Slot &slot = m_ring[m_tail % kCapacity];
+    slot.command = std::forward<T>(command);
+    slot.cost = cost;
+    m_pendingCost += cost;
+    if constexpr (std::is_same_v<std::decay_t<T>, SnapshotCommand>)
+        m_lastSnapshotIndex.store(m_tail, std::memory_order_relaxed);
+    ++m_tail;
+    if (m_workerWaiting)
+        m_notEmpty.notify_one();
+}
+
+void GSThreadedBackend::Drain() const
+{
+    std::unique_lock<std::mutex> lock(m_mutex);
+    if (m_head == m_tail && !m_workerBusy)
+        return;
+    m_drains.fetch_add(1u, std::memory_order_relaxed);
+    m_idle.wait(lock, [this]()
+                { return m_head == m_tail && !m_workerBusy; });
+}
+
+void GSThreadedBackend::WorkerLoop()
+{
+    ThreadNaming::SetCurrentThreadName("GS raster");
+    // Every 10 s, "[gs:hilo]" reports how busy the worker was, the commands it ran, and how often a producer found the
+    // queue full or had to drain it: a busy worker with many full-queue waits means the rasterizer is the bottleneck.
+    using Clock = std::chrono::steady_clock;
+    Clock::time_point reportStart = Clock::now();
+    Clock::duration busyTime{};
+    uint64_t commandsRun = 0u;
+
+    std::unique_lock<std::mutex> lock(m_mutex);
+    for (;;)
+    {
+        while (m_head == m_tail && !m_stop)
+        {
+            m_workerWaiting = true;
+            m_idle.notify_all();
+            m_notEmpty.wait(lock);
+            m_workerWaiting = false;
+        }
+        if (m_head == m_tail)
+            break;
+
+        // Producers only write slots at m_tail and later, so [begin, end) can run without the lock. Progress (m_head
+        // and the pending cost) is published every kPublishCost of work, so producers waiting on the work bound resume
+        // while the chunk is still running.
+        const uint64_t begin = m_head;
+        const uint64_t end = std::min<uint64_t>(m_tail, begin + kChunk);
+        m_workerBusy = true;
+        lock.unlock();
+        const Clock::time_point chunkStart = Clock::now();
+        uint64_t unpublishedCost = 0u;
+        for (uint64_t index = begin; index < end; ++index)
+        {
+            Slot &slot = m_ring[index % kCapacity];
+            Execute(slot.command, index);
+            unpublishedCost += slot.cost;
+            if (unpublishedCost >= kPublishCost && index + 1u < end)
+            {
+                lock.lock();
+                m_head = index + 1u;
+                m_pendingCost -= unpublishedCost;
+                if (m_producersWaiting != 0u)
+                    m_notFull.notify_all();
+                lock.unlock();
+                unpublishedCost = 0u;
+            }
+        }
+        const Clock::time_point chunkEnd = Clock::now();
+        busyTime += chunkEnd - chunkStart;
+        commandsRun += end - begin;
+        if (chunkEnd - reportStart >= std::chrono::seconds(10))
+        {
+            const double seconds = std::chrono::duration<double>(chunkEnd - reportStart).count();
+            const double producerWait = 1e-9 * static_cast<double>(m_producerWaitNs.exchange(0u, std::memory_order_relaxed));
+            std::fprintf(stderr, "[gs:hilo] ocupado=%.0f%% ordenes/s=%.0f colaLlena=%llu esperaEE=%.0f%% vaciados=%llu\n",
+                         100.0 * std::chrono::duration<double>(busyTime).count() / seconds, commandsRun / seconds,
+                         static_cast<unsigned long long>(m_fullWaits.exchange(0u, std::memory_order_relaxed)),
+                         100.0 * producerWait / seconds,
+                         static_cast<unsigned long long>(m_drains.exchange(0u, std::memory_order_relaxed)));
+            reportStart = chunkEnd;
+            busyTime = {};
+            commandsRun = 0u;
+        }
+        lock.lock();
+        m_head = end;
+        m_pendingCost -= unpublishedCost;
+        m_workerBusy = false;
+        if (m_producersWaiting != 0u)
+            m_notFull.notify_all();
+    }
+    m_idle.notify_all();
+}
+
+void GSThreadedBackend::Execute(Command &command, uint64_t index)
+{
+    std::visit([&](auto &payload)
+               {
+                   using T = std::decay_t<decltype(payload)>;
+                   if constexpr (std::is_same_v<T, GSPrimitiveBatch>)
+                       m_cpu->Submit(payload);
+                   else if constexpr (std::is_same_v<T, ClutCommand>)
+                       m_cpu->LoadClut(payload.tex0, payload.texclut);
+                   else if constexpr (std::is_same_v<T, GSTransferCommand>)
+                       m_cpu->BeginTransfer(payload);
+                   else if constexpr (std::is_same_v<T, std::vector<uint8_t>>)
+                   {
+                       m_cpu->UploadImage(payload.data(), static_cast<uint32_t>(payload.size()));
+                       // Release the copy now; the slot may stay unused for a long time.
+                       std::vector<uint8_t>().swap(payload);
+                   }
+                   else if constexpr (std::is_same_v<T, TextureFlushCommand>)
+                       m_cpu->TextureFlush();
+                   else if constexpr (std::is_same_v<T, ClearCommand>)
+                       m_cpu->ClearFramebuffer(payload.context, payload.rgba);
+                   else if constexpr (std::is_same_v<T, WriteVramCommand>)
+                       m_cpu->WriteVram(payload.psm, payload.base, payload.bw, payload.x, payload.y, payload.value);
+                   else if constexpr (std::is_same_v<T, SnapshotCommand>)
+                   {
+                       // Older snapshots are skipped while a newer one is queued, but at least one is taken every
+                       // 33 ms: under steady load the queue is always more than a presentation (16 ms) behind, and
+                       // skipping every non-newest snapshot froze the display on the first frame.
+                       static std::chrono::steady_clock::time_point s_lastSnapshot{};
+                       const auto now = std::chrono::steady_clock::now();
+                       if (index != m_lastSnapshotIndex.load(std::memory_order_relaxed) &&
+                           now - s_lastSnapshot < std::chrono::milliseconds(33))
+                           return;
+                       s_lastSnapshot = now;
+                       m_cpu->SnapshotVram(m_workerSnapshot);
+                       std::lock_guard<std::mutex> lock(m_publishMutex);
+                       std::swap(m_workerSnapshot, m_publishedSnapshot);
+                       m_publishedRequest = payload.request;
+                       ++m_publishedSerial;
+                   } },
+               command);
+}
+
+void GSThreadedBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    Drain();
+    m_cpu->Initialize(vram, vramSize);
+}
+
+void GSThreadedBackend::Reset()
+{
+    Drain();
+    m_cpu->Reset();
+}
+
+void GSThreadedBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    if (batch.vertexCount == 0u)
+        return;
+    if (g_ps2AbMode.load(std::memory_order_relaxed) != 0)
+    {
+        // A/B comparison: draw on the calling thread, as the plain CPU backend does.
+        Drain();
+        m_cpu->Submit(batch);
+        return;
+    }
+    Push(batch, estimatePixels(batch));
+}
+
+void GSThreadedBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    Push(ClutCommand{tex0, texclut}, 256u);
+}
+
+void GSThreadedBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    // Local-to-local and local-to-host transfers run when the command executes.
+    const uint64_t pixels = static_cast<uint64_t>(command.trxreg.rrw) * command.trxreg.rrh;
+    Push(command, command.direction == 0u ? 0u : static_cast<uint32_t>(std::min<uint64_t>(pixels, 4000000u)));
+}
+
+void GSThreadedBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (data == nullptr || sizeBytes == 0u)
+        return;
+    Push(std::vector<uint8_t>(data, data + sizeBytes), sizeBytes / 2u);
+}
+
+void GSThreadedBackend::Flush()
+{
+}
+
+void GSThreadedBackend::TextureFlush()
+{
+    Push(TextureFlushCommand{}, 0u);
+}
+
+void GSThreadedBackend::Sync(GSSyncReason reason)
+{
+    // FINISH and presentation do not need the pixels yet; readbacks drain in the calls that return data.
+    if (reason == GSSyncReason::Reset || reason == GSSyncReason::LocalToHost || reason == GSSyncReason::DebugReadback)
+        Drain();
+}
+
+PresentationFrame GSThreadedBackend::Present(const GSPresentationRequest &request)
+{
+    std::lock_guard<std::mutex> presentLock(m_presentMutex);
+    Push(SnapshotCommand{request}, 65536u); // a 4 MB copy
+    if (m_presentSerial == 0u)
+    {
+        // Nothing converted yet: wait for this first snapshot instead of showing an empty frame.
+        Drain();
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(m_publishMutex);
+        if (m_publishedSerial == m_presentSerial)
+            return m_presentFrame;
+        std::swap(m_publishedSnapshot, m_presentSnapshot);
+        m_presentRequest = m_publishedRequest;
+        m_presentSerial = m_publishedSerial;
+    }
+
+    // Convert outside the queue: the worker keeps drawing while this thread builds the host frame.
+    if (m_presentSnapshot.empty())
+    {
+        m_presentFrame = {};
+        return m_presentFrame;
+    }
+    thread_local GSCpuBackend converter;
+    converter.Initialize(m_presentSnapshot.data(), static_cast<uint32_t>(m_presentSnapshot.size()));
+    m_presentFrame = converter.PresentFromLocalMemory(m_presentRequest);
+    return m_presentFrame;
+}
+
+bool GSThreadedBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    const uint32_t width = context.scissor.x1 >= context.scissor.x0 ? context.scissor.x1 - context.scissor.x0 + 1u : 0u;
+    const uint32_t height = context.scissor.y1 >= context.scissor.y0 ? context.scissor.y1 - context.scissor.y0 + 1u : 0u;
+    Push(ClearCommand{context, rgba}, width * height);
+    const uint8_t psm = context.frame.psm;
+    return context.frame.fbw != 0u &&
+           (psm == GS_PSM_CT32 || psm == GS_PSM_CT24 || psm == GS_PSM_CT16 || psm == GS_PSM_CT16S);
+}
+
+uint32_t GSThreadedBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    Drain();
+    return m_cpu->ConsumeLocalToHostBytes(dst, maxBytes);
+}
+
+uint32_t GSThreadedBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    Drain();
+    return m_cpu->ReadVram(psm, base, bw, x, y);
+}
+
+void GSThreadedBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    Push(WriteVramCommand{psm, base, bw, x, y, value}, 0u);
+}
+
+void GSThreadedBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    Drain();
+    m_cpu->SnapshotVram(out);
+}
+
+GSTransferSnapshot GSThreadedBackend::GetTransferSnapshot() const
+{
+    // Only the debug history uses it; it does not need to wait for the queue.
+    return m_cpu->GetTransferSnapshot();
+}
