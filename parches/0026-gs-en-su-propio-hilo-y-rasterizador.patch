+std::atomic<int> g_ps2AbMode{0};
+
+namespace
+{
+    constexpr uint32_t kCommandCost = 32u; // fixed cost of any command, in pixels
+
+    // Pixels a primitive may touch: its bounding box clipped to the scissor (half of it for triangles, the longer side
+    // for lines). Only used to bound the queued work, so a rough figure is enough.
+    uint32_t estimatePixels(const GSPrimitiveBatch &batch)
+    {
+        const GSContext &ctx = batch.state.context;
+        const uint32_t count = std::min<uint32_t>(batch.vertexCount, 3u);
+        float minX = batch.vertices[0].x, maxX = minX, minY = batch.vertices[0].y, maxY = minY;
+        for (uint32_t i = 1; i < count; ++i)
+        {
+            minX = std::min(minX, batch.vertices[i].x);
+            maxX = std::max(maxX, batch.vertices[i].x);
+            minY = std::min(minY, batch.vertices[i].y);
+            maxY = std::max(maxY, batch.vertices[i].y);
+        }
+        const float ofx = static_cast<float>(ctx.xyoffset.ofx >> 4);
+        const float ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
+        const float x0 = std::max(minX - ofx, static_cast<float>(ctx.scissor.x0));
+        const float x1 = std::min(maxX - ofx, static_cast<float>(ctx.scissor.x1));
+        const float y0 = std::max(minY - ofy, static_cast<float>(ctx.scissor.y0));
+        const float y1 = std::min(maxY - ofy, static_cast<float>(ctx.scissor.y1));
+        if (!(x1 >= x0 && y1 >= y0))
+            return 0u;
+        const float width = x1 - x0 + 1.0f;
+        const float height = y1 - y0 + 1.0f;
+        float pixels = width * height;
+        switch (batch.state.prim.type)
+        {
+        case GS_PRIM_TRIANGLE:
+        case GS_PRIM_TRISTRIP:
+        case GS_PRIM_TRIFAN:
+            pixels *= 0.5f;
+            break;
+        case GS_PRIM_LINE:
+        case GS_PRIM_LINESTRIP:
+            pixels = std::max(width, height);
+            break;
+        case GS_PRIM_POINT:
+            pixels = 1.0f;
+            break;
+        default:
+            break;
+        }
+        return static_cast<uint32_t>(std::min(pixels, 4.0e6f));
+    }
+}
