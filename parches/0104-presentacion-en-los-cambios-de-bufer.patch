+// Patch 0104: the part of local memory a presentation reads (the display buffers of the enabled CRTs, as whole pages
+// of up to 512 rows), so that the snapshot at every display flip copies ~1.3 MB instead of 4 MB. With a preferred
+// source (another buffer), all of it, as before.
+void GSThreadedBackend::displaySnapshotRange(const GSPresentationRequest &request, uint32_t &begin, uint32_t &bytes)
+{
+    begin = 0u;
+    bytes = 0u;
+    if (request.hasPreferredSource)
+        return;
+    const bool crt1 = (request.pmode & 1u) != 0u;
+    const bool crt2 = (request.pmode & 2u) != 0u;
+    uint64_t lo = ~0ull, hi = 0u;
+    for (int i = 0; i < 2; ++i)
+    {
+        if (!(i == 0 ? crt1 : crt2))
+            continue;
+        const uint64_t dispfb = i == 0 ? request.dispfb1 : request.dispfb2;
+        const uint64_t fbp = dispfb & 0x1FFu;
+        const uint64_t fbw = std::max<uint64_t>(1u, (dispfb >> 9) & 0x3Fu);
+        const uint64_t psm = (dispfb >> 15) & 0x1Fu;
+        const uint64_t pageRows = (psm & 0x2u) != 0u ? 64u : 32u; // 16-bit formats: 64x64 pages
+        const uint64_t start = fbp * 8192u;
+        const uint64_t size = fbw * ((512u + pageRows - 1u) / pageRows) * 8192u;
+        lo = std::min(lo, start);
+        hi = std::max(hi, start + size);
+    }
+    if (hi <= lo)
+        return;
+    begin = static_cast<uint32_t>(lo);
+    bytes = static_cast<uint32_t>(hi - lo);
+}
