+    // Patch 0087: VF registers whose normalize4 (all four lanes) a compiled schedule has stored in st.jitNorm and that
+    // nothing has written since (bit r: st.jitNorm[r]), at compile time. An operand that a FMAC normalizes is stored
+    // there the first time and read back, already normalized, by the next FMACs of the schedule that read the same
+    // register (the transform matrices are read over and over within a block); any write to the register drops it.
+    // Empty at the start of every schedule. The values are the same: normalize4 works lane by lane.
+    struct JitNormShadow
+    {
+        uint32_t valid = 0u;
+    };
+
+    // xmm x = normalize4(vf[r]) (rax = kJitConst), through st.jitNorm when `shadow` (nullptr: off) has it, storing it
+    // there otherwise.
+    inline void jitLoadNormalized(JitEmitter &e, uint8_t x, uint8_t r, JitNormShadow *shadow)
+    {
+        const size_t row = offsetof(BlockState, jitNorm) + 16u * r;
+        if (shadow != nullptr && ((shadow->valid >> r) & 1u) != 0u)
+        {
+            e.loadXmm(x, JitEmitter::St, row);
+            return;
+        }
+        e.loadXmm(x, JitEmitter::Vu, offsetof(VU1State, vf) + 16u * r);
+        jitNormalize(e, x);
+        if (shadow != nullptr && r != 0u)
+        {
+            e.storeXmm(JitEmitter::St, row, x);
+            shadow->valid |= 1u << r;
+        }
+    }
