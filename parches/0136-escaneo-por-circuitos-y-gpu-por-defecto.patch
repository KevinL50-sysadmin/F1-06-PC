+    // The GPU backend over the test bridge, or null (with a [Skipped] line) when it cannot be created here.
+    std::unique_ptr<GSGpuBackend> testGpuBackend()
+    {
+        const fs::path dllPath = testBridgeDll();
+        if (dllPath.empty() || !fs::exists(dllPath))
+        {
+            std::cout << "    [Skipped] pgs_puente.dll not built (" << dllPath.string()
+                      << "): run scripts/obtener-parallel-gs.ps1" << std::endl;
+            return nullptr;
+        }
+        std::string error;
+        std::unique_ptr<GSGpuBackend> backend = GSGpuBackend::Create(dllPath, error);
+        if (!backend)
+            std::cout << "    [Skipped] no GPU bridge: " << error << std::endl;
+        return backend;
+    }
+
+    // A PSMCT32 frame at FBP 0 whose colours change on every row and column and whose alpha cycles through 0x80,
+    // 0x40, 0x00, 0xFF and 0x20: a one-line shift, a resample or another blend factor changes the picture.
+    std::vector<uint8_t> testFrameVram(uint32_t width, uint32_t height)
+    {
+        std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0u);
+        GSCpuBackend view;
+        view.Initialize(vram.data(), static_cast<uint32_t>(vram.size()));
+        static constexpr uint32_t kAlphas[] = {0x80u, 0x40u, 0x00u, 0xFFu, 0x20u};
+        for (uint32_t y = 0; y < height; ++y)
+            for (uint32_t x = 0; x < width; ++x)
+            {
+                const uint32_t alpha = kAlphas[(y / 8u + x / 16u) % 5u];
+                const uint32_t color = ((x * 3u + y * 5u) & 0xFFu) | (((y * 7u) & 0xFFu) << 8u) |
+                                       (((x ^ y) & 0xFFu) << 16u) | (alpha << 24u);
+                view.WriteVram(GS_PSM_CT32, 0u, width / 64u, x, y, color);
+            }
+        return vram;
+    }
+
+    // The newest frame the GPU backend reads back after scanning request out (waits up to 5 s).
+    PresentationFrame gpuScanout(GSGpuBackend &backend, const GSPresentationRequest &request)
+    {
+        backend.QueueScanout(request);
+        for (int attempt = 0; attempt < 500; ++attempt)
+        {
+            backend.WaitIdle();
+            PresentationFrame frame = backend.PresentPublished();
+            if (frame)
+                return frame;
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+        return {};
+    }
+
+    // Same size and the same RGBA in every presented pixel (rows are 640 pixels apart in both).
+    void expectSamePresentation(TestCase &t, const PresentationFrame &cpu, const PresentationFrame &gpu)
+    {
+        t.Equals(gpu.width, cpu.width, "the GPU frame is as wide as the CPU one");
+        t.Equals(gpu.height, cpu.height, "the GPU frame is as tall as the CPU one");
+        if (gpu.width != cpu.width || gpu.height != cpu.height || gpu.pixels.size() != cpu.pixels.size())
+            return;
+        size_t different = 0u;
+        std::string first = "none";
+        for (uint32_t y = 0; y < cpu.height; ++y)
+            for (uint32_t x = 0; x < cpu.width; ++x)
+            {
+                const size_t offset = (static_cast<size_t>(y) * 640u + x) * 4u;
+                if (std::memcmp(cpu.pixels.data() + offset, gpu.pixels.data() + offset, 4u) == 0)
+                    continue;
+                if (different++ == 0u)
+                    first = std::to_string(x) + "," + std::to_string(y);
+            }
+        t.Equals(different, size_t{0}, "identical pixels (first difference at " + first + ")");
+    }
 }
 
