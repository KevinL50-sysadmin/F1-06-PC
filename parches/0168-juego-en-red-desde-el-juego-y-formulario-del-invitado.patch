+
+            settings.port = used;
+            settings.password = "clave-fija";
+            t.IsTrue(session.start(settings, error), "the same port again at once: " + error);
+            s = session.status();
+            t.IsTrue(s.hosting && s.port == used, "hosting on the same port");
+            t.Equals(s.password, std::string("clave-fija"), "the given password");
+            Guest again;
+            again.start({"127.0.0.1", used, "clave-fija"});
+            t.IsTrue(waitFor([&] { return session.status().guestConnected; }), "a guest again");
+
+            HostSession other;
+            HostSessionSettings busy = settings;
+            t.IsFalse(other.start(busy, error), "a port in use cannot be taken");
+            t.IsFalse(error.empty(), "with the reason");
+            const HostSessionStatus failed = other.status();
+            t.IsTrue(!failed.hosting && !failed.error.empty(), "the failure in the status");
+            t.IsTrue(hostStatusText(failed).rfind("Juego en red: no se puede ser anfitrion", 0) == 0,
