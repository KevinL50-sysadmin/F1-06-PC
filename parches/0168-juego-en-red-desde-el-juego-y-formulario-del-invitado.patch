+
+            settings.password = "otra-clave";
+            t.IsTrue(session.start(settings, error), "start while running restarts: " + error);
+            t.IsTrue(waitFor([&] { return again.status().state == GuestState::Disconnected; }),
+                     "the old session's guest is let go");
+            t.Equals(session.status().password, std::string("otra-clave"), "the new password");
+            again.stop();
+            session.stop();
+            t.IsFalse(remotePadActive(), "nothing left");
+            t.Equals(padPortState(rdram, 1), port2Before, "port 2 as before, at the end");
+        }); });
