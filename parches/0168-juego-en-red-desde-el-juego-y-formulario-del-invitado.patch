diff --git a/ps2xRuntime/src/lib/ps2_netplay_session.cpp b/ps2xRuntime/src/lib/ps2_netplay_session.cpp
new file mode 100644
index 0000000..6b84299
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_netplay_session.cpp
@@ -0,0 +1,328 @@
+#include "ps2_netplay_session.h"
+#include "ps2_options.h"
+#include "ps2_user_paths.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+#include <sstream>
+
+// Fase 5 (T15, netplay N4): see ps2_netplay_session.h.
+namespace ps2x::netplay
+{
+    namespace
+    {
+        std::string trimmed(std::string_view text)
+        {
+            size_t begin = 0, end = text.size();
+            while (begin < end && std::isspace(static_cast<unsigned char>(text[begin])))
+                ++begin;
+            while (end > begin && std::isspace(static_cast<unsigned char>(text[end - 1])))
+                --end;
+            return std::string(text.substr(begin, end - begin));
+        }
+
+        std::string lowered(std::string text)
+        {
+            std::transform(text.begin(), text.end(), text.begin(),
+                           [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+            return text;
+        }
+
+        // A port typed as text: 1-65535, digits only.
+        bool parsePort(const std::string &text, uint16_t &port, std::string &error)
+        {
+            std::string ignored;
+            bool hasPort = false;
+            return splitHostPort("x:" + text, ignored, port, hasPort, error);
+        }
+
+        // Windows' socket errors come in the system's code page (accents in Spanish): plain ASCII for the window's
+        // default font and for ImGui (UTF-8).
+        std::string asciiOnly(const std::string &text)
+        {
+            static const std::pair<unsigned char, char> kFolds[] = {
+                {0xE1, 'a'}, {0xE9, 'e'}, {0xED, 'i'}, {0xF3, 'o'}, {0xFA, 'u'}, {0xFC, 'u'}, {0xF1, 'n'},
+                {0xC1, 'A'}, {0xC9, 'E'}, {0xCD, 'I'}, {0xD3, 'O'}, {0xDA, 'U'}, {0xDC, 'U'}, {0xD1, 'N'}};
+            std::string out;
+            for (const char c : text)
+            {
+                const unsigned char u = static_cast<unsigned char>(c);
+                if (u < 0x80)
+                {
+                    out += u < 0x20 ? ' ' : c;
+                    continue;
+                }
+                char folded = '?';
+                for (const auto &[from, to] : kFolds)
+                    if (u == from)
+                        folded = to;
+                out += folded;
+            }
+            return out;
+        }
+    }
+
+    std::string generatePassword(const RandomSource &random)
+    {
+        constexpr size_t kAlphabetSize = sizeof(kPasswordAlphabet) - 1;
+        constexpr unsigned kLimit = 256u - 256u % kAlphabetSize; // 248: bytes at or above it are skipped
+        std::string out;
+        uint8_t bytes[16];
+        for (int batch = 0; batch < 64 && out.size() < kGeneratedPasswordSize; ++batch)
+        {
+            if (!random || !random(bytes, sizeof(bytes)))
+                return {};
+            for (const uint8_t b : bytes)
+                if (b < kLimit && out.size() < kGeneratedPasswordSize)
+                    out += kPasswordAlphabet[b % kAlphabetSize];
+        }
+        return out.size() == kGeneratedPasswordSize ? out : std::string();
+    }
+
+    bool parsePictureQuality(std::string_view text, PictureQuality &quality)
+    {
+        const std::string value = lowered(trimmed(text));
+        if (value == "baja")
+            quality = PictureQuality::Low;
+        else if (value == "media")
+            quality = PictureQuality::Medium;
+        else if (value == "alta")
+            quality = PictureQuality::High;
+        else
+            return false;
+        return true;
+    }
+
+    const char *pictureQualityOption(PictureQuality quality)
+    {
+        switch (quality)
+        {
+        case PictureQuality::Low: return "baja";
+        case PictureQuality::High: return "alta";
+        case PictureQuality::Medium: break;
+        }
+        return "media";
+    }
+
+    HostVideoSettings videoSettingsFor(PictureQuality quality)
+    {
+        HostVideoSettings video;
+        switch (quality)
+        {
+        case PictureQuality::Low:
+            video.height = 360;
+            video.kbps = 4000;
+            break;
+        case PictureQuality::Medium:
+            video.height = 540;
+            video.kbps = 8000;
+            break;
+        case PictureQuality::High:
+            video.height = 720;
+            video.kbps = 15000;
+            break;
+        }
+        return video;
+    }
+
+    bool validateGuestForm(const GuestForm &form, GuestSettings &settings, std::string &error)
+    {
+        const std::string address = trimmed(form.address);
+        if (address.empty())
+        {
+            error = "Escribe la direcci\xC3\xB3n IP del anfitri\xC3\xB3n.";
+            return false;
+        }
+        GuestSettings out;
+        const std::string portText = trimmed(form.port);
+        std::string why;
+        if (!portText.empty() && !parsePort(portText, out.port, why))
+        {
+            error = "Puerto no v\xC3\xA1lido (de 1 a 65535): " + portText;
+            return false;
+        }
+        bool hasPort = false;
+        if (!splitHostPort(address, out.host, out.port, hasPort, why))
+        {
+            error = "Direcci\xC3\xB3n no v\xC3\xA1lida: " + address;
+            return false;
+        }
+        if (form.password.size() < kMinPasswordSize || form.password.size() > kMaxPasswordSize)
+        {
+            error = "La contrase\xC3\xB1" "a debe tener entre " + std::to_string(kMinPasswordSize) + " y " +
+                    std::to_string(kMaxPasswordSize) + " caracteres.";
+            return false;
+        }
+        out.password = form.password;
+        settings = out;
+        return true;
+    }
+
+    GuestMemory rememberedFrom(const GuestSettings &settings)
+    {
+        return {settings.host, settings.port};
+    }
+
+    std::string guestMemoryText(const GuestMemory &memory)
+    {
+        std::ostringstream out;
+        out << "# Juego en red (F1-06.exe --invitado): la ultima direccion y el puerto del anfitrion a los que se\n"
+               "# conecto este PC. La contrasena no se guarda nunca.\n"
+            << "direccion = " << memory.address << "\n"
+            << "puerto = " << memory.port << "\n";
+        return out.str();
+    }
+
+    GuestMemory parseGuestMemory(std::string_view text)
+    {
+        GuestMemory memory;
+        if (text.size() >= 3 && static_cast<unsigned char>(text[0]) == 0xEF &&
+            static_cast<unsigned char>(text[1]) == 0xBB && static_cast<unsigned char>(text[2]) == 0xBF)
+            text.remove_prefix(3);
+        std::istringstream lines{std::string(text)};
+        std::string line;
+        while (std::getline(lines, line))
+        {
+            const size_t equals = line.find('=');
+            if (line.empty() || line[0] == '#' || equals == std::string::npos)
+                continue;
+            const std::string key = lowered(trimmed(std::string_view(line).substr(0, equals)));
+            const std::string value = trimmed(std::string_view(line).substr(equals + 1));
+            std::string why;
+            if (key == "direccion")
+            {
+                std::string host;
+                uint16_t port = kDefaultPort;
+                bool hasPort = false;
+                if (splitHostPort(value, host, port, hasPort, why) && !hasPort)
+                    memory.address = host;
+            }
+            else if (key == "puerto")
+            {
+                uint16_t port = kDefaultPort;
+                if (parsePort(value, port, why))
+                    memory.port = port;
+            }
+        }
+        return memory;
+    }
+
+    GuestMemory loadGuestMemory(const std::filesystem::path &file)
+    {
+        std::ifstream in(file, std::ios::binary);
+        if (!in)
+            return {};
+        std::stringstream text;
+        text << in.rdbuf();
+        return parseGuestMemory(text.str());
+    }
+
+    bool saveGuestMemory(const std::filesystem::path &file, const GuestMemory &memory, std::string &error)
+    {
+        return ps2x::writeTextFileAtomically(file, guestMemoryText(memory), error);
+    }
+
+    std::filesystem::path guestMemoryFile()
+    {
+        const std::filesystem::path folder = ps2x::userConfigDirectory();
+        return (folder.empty() ? std::filesystem::path("config") : folder) / "red.ini";
+    }
+
+    std::string listenAddressOverride()
+    {
+        const char *value = std::getenv("PS2X_RED_ESCUCHAR");
+        return value != nullptr ? trimmed(value) : std::string();
+    }
+
+    std::string hostStatusText(const HostSessionStatus &status)
+    {
+        if (!status.hosting)
+            return status.error.empty() ? std::string("Juego en red apagado")
+                                        : "Juego en red: no se puede ser anfitrion (" + status.error + ")";
+        if (status.guestConnected)
+            return "Juego en red: invitado conectado desde " + status.guestAddress + " (jugador 2)";
+        const std::string port = std::to_string(status.port);
+        std::string where;
+        for (const std::string &address : status.addresses)
+            where += (where.empty() ? "" : " o ") + address + ":" + port;
+        if (where.empty())
+            where = "el puerto " + port;
+        return "Juego en red: esperando invitado en " + where + " - clave " + status.password;
+    }
+
+    struct HostSession::Impl
+    {
+        mutable std::mutex mutex;
+        Host host;
+        HostSessionStatus status; // the parts that change only with start and stop
+    };
+
+    HostSession::HostSession() : m_impl(std::make_unique<Impl>()) {}
+
+    HostSession::~HostSession()
+    {
+        stop();
+    }
+
+    bool HostSession::start(const HostSessionSettings &settings, std::string &error)
+    {
+        std::lock_guard<std::mutex> lock(m_impl->mutex);
+        m_impl->host.stop();
+        HostSessionStatus status;
+        status.port = settings.port;
+        status.listenAddress = settings.listenAddress;
+        status.password = settings.password.empty() ? generatePassword() : settings.password;
+        if (status.password.empty())
+            error = "no hay numeros aleatorios para la contrasena";
+        else
+        {
+            HostSettings host{settings.listenAddress, settings.port, status.password};
+            host.video = settings.video;
+            host.audio = settings.audio;
+            status.hosting = m_impl->host.start(host, error);
+        }
+        if (!status.hosting)
+        {
+            error = asciiOnly(error);
+            status.error = error;
+            status.password.clear();
+            m_impl->status = status;
+            return false;
+        }
+        status.port = m_impl->host.port();
+        status.addresses = settings.listenAddress.empty() ? localIpv4Addresses()
+                                                          : std::vector<std::string>{settings.listenAddress};
+        m_impl->status = status;
+        return true;
+    }
+
+    void HostSession::stop()
+    {
+        std::lock_guard<std::mutex> lock(m_impl->mutex);
+        m_impl->host.stop();
+        m_impl->status.hosting = false;
+        m_impl->status.password.clear();
+        m_impl->status.error.clear();
+    }
+
+    HostSessionStatus HostSession::status() const
+    {
+        std::lock_guard<std::mutex> lock(m_impl->mutex);
+        HostSessionStatus status = m_impl->status;
+        if (status.hosting)
+        {
+            status.guestConnected = m_impl->host.guestConnected();
+            status.guestAddress = status.guestConnected ? m_impl->host.guestAddress() : std::string();
+        }
+        return status;
+    }
+
+    HostSession &hostSession()
+    {
+        static HostSession s_session;
+        return s_session;
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_netplay_session.h b/ps2xRuntime/src/lib/ps2_netplay_session.h
new file mode 100644
index 0000000..49ea057
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_netplay_session.h
@@ -0,0 +1,107 @@
+#pragma once
+
+#include "ps2_netplay.h"
+
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Fase 5 (T15, netplay N4): the netplay without the command line. The host starts and stops from the game (AJUSTES PC
+// row JUEGO EN RED, F2 menu section "Juego en red") while the game runs; the guest fills a small form in its window
+// (F1-06.exe --invitado with no address), which remembers the last address and port in config\red.ini (never the
+// password).
+namespace ps2x::netplay
+{
+    // A session password a player can read out or type: no 0/O, 1/I/L (ambiguous), uppercase and digits only.
+    constexpr const char kPasswordAlphabet[] = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
+    constexpr size_t kGeneratedPasswordSize = 8;
+    // Empty when the random source fails. Each character is uniform over kPasswordAlphabet (rejection sampling).
+    std::string generatePassword(const RandomSource &random = randomBytes);
+
+    // The picture quality presets of the F2 menu and opciones.ini red_calidad.
+    enum class PictureQuality
+    {
+        Low,    // baja: 4 Mbit/s, 360 lines
+        Medium, // media: 8 Mbit/s, 540 lines (the N2 default)
+        High,   // alta: 15 Mbit/s, 720 lines
+    };
+    bool parsePictureQuality(std::string_view text, PictureQuality &quality);
+    const char *pictureQualityOption(PictureQuality quality); // baja, media, alta
+    HostVideoSettings videoSettingsFor(PictureQuality quality);
+
+    // The guest's form, as typed. True with settings filled (address trimmed, port 1-65535, password 4-256
+    // characters); false with a Spanish message in error. An empty port is the default one; "host:port" in the address
+    // wins over the port field.
+    struct GuestForm
+    {
+        std::string address;
+        std::string port;
+        std::string password;
+    };
+    bool validateGuestForm(const GuestForm &form, GuestSettings &settings, std::string &error);
+
+    // config\red.ini of the guest: the last address and port that connected. Never the password.
+    struct GuestMemory
+    {
+        std::string address;
+        uint16_t port = kDefaultPort;
+    };
+    GuestMemory rememberedFrom(const GuestSettings &settings); // the address and port, without the password
+    std::string guestMemoryText(const GuestMemory &memory);
+    GuestMemory parseGuestMemory(std::string_view text); // bad or missing lines keep the defaults
+    GuestMemory loadGuestMemory(const std::filesystem::path &file);
+    bool saveGuestMemory(const std::filesystem::path &file, const GuestMemory &memory, std::string &error);
+    std::filesystem::path guestMemoryFile(); // <config folder>\red.ini
+
+    // PS2X_RED_ESCUCHAR=<numeric address> (tests, advanced): the address the in-game host listens on instead of every
+    // interface (127.0.0.1: no other PC can connect, and Windows does not ask about its firewall).
+    std::string listenAddressOverride();
+
+    struct HostSessionSettings
+    {
+        std::string listenAddress; // empty: every interface
+        uint16_t port = kDefaultPort;
+        std::string password; // empty: generatePassword()
+        HostVideoSettings video;
+        HostAudioSettings audio;
+    };
+
+    struct HostSessionStatus
+    {
+        bool hosting = false;
+        bool guestConnected = false;
+        uint16_t port = 0;
+        std::string listenAddress; // as asked (empty: every interface)
+        std::vector<std::string> addresses; // where a guest can connect: this PC's IPv4 addresses, or listenAddress
+        std::string password;
+        std::string guestAddress;
+        std::string error; // the last start that failed (empty after a good one)
+    };
+
+    // One line for the host's overlay and log (ASCII: the window's default font has no accents).
+    std::string hostStatusText(const HostSessionStatus &status);
+
