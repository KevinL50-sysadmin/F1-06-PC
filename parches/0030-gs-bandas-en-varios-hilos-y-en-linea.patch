+void GSCpuBackend::StartBandWorkers(unsigned threads)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_bands || threads <= 1u)
+        return;
+    auto bands = std::make_unique<BandState>();
+    bands->threads = std::min(threads, 16u);
+    if (const char *rows = std::getenv("PS2X_GS_BANDA"))
+    {
+        const int value = std::atoi(rows);
+        int shift = 1;
+        while (shift < 8 && (1 << shift) < value)
+            ++shift;
+        bands->bandShift = shift; // a power of two between 2 and 256 rows
+    }
+    bands->jobs.reset(new BandJob[BandState::kJobCapacity]);
+    bands->palettes.reset(new std::array<uint32_t, 256>[BandState::kPaletteCount]);
+    bands->worker.reset(new BandState::Worker[bands->threads]);
+    if (const char *value = std::getenv("F1_GS_VERIFICAR_BANDAS"))
+        bands->verifyLeft = std::strtoull(value, nullptr, 0);
+    if (const char *value = std::getenv("F1_GS_VERIFICAR_BANDAS_DESDE"))
+        bands->verifyFrom = std::atof(value);
+    else if (const char *value = std::getenv("F1_GS_VERIFICAR_DESDE"))
+        bands->verifyFrom = std::atof(value);
+    for (unsigned k = 0; k < bands->threads; ++k)
+        bands->workers.emplace_back([state = bands.get(), k]()
+                                    { state->WorkerLoop(k); });
+    std::fprintf(stderr, "[gs:bandas] %u hilos, bandas de %d filas\n", bands->threads, 1 << bands->bandShift);
+    m_bands = std::move(bands);
+}
+
+void GSCpuBackend::WaitBands() const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    WaitBandsUnlocked();
+}
+
+void GSCpuBackend::WaitBandsUnlocked() const
+{
+    if (m_bands)
+        m_bands->WaitDone(m_bands->prepared, kWaitDirect);
+}
+
+void GSCpuBackend::QuiesceBands(int reason)
+{
+    if (!m_bands)
+        return;
+    CloseBandVerification();
+    m_bands->WaitDone(m_bands->prepared, reason);
+}
+
+void GSCpuBackend::FlushBands()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_bands)
+        m_bands->PublishPending();
+}
+
+void GSCpuBackend::WaitBandsForRead(int reason, uint32_t baseBlock, uint32_t bw, uint32_t psm, int x0, int y0, int x1,
+                                    int y1)
+{
+    if (!m_bands)
+        return;
+    CloseBandVerification();
+    PageBits pages;
+    addRectPages(pages, baseBlock, bw, psm, x0, y0, x1, y1);
+    m_bands->WaitForPages(pages, false, reason);
+}
+
+void GSCpuBackend::WaitBandsForWrite(int reason, uint32_t baseBlock, uint32_t bw, uint32_t psm, int x0, int y0, int x1,
+                                     int y1)
+{
+    if (!m_bands)
+        return;
+    CloseBandVerification();
+    PageBits pages;
+    addRectPages(pages, baseBlock, bw, psm, x0, y0, x1, y1);
+    m_bands->WaitForPages(pages, true, reason);
+}
+
+void GSCpuBackend::BandTransferBegin(const GSTransferCommand &command)
+{
+    if (command.direction == 0u)
+    {
+        // Host to local: UploadImage waits for the pending jobs touching the destination.
+        m_bands->transferPages.clear();
+        if (command.trxreg.rrw != 0u && command.trxreg.rrh != 0u)
+            addRectPages(m_bands->transferPages, command.bitbltbuf.dbp, std::max<uint32_t>(command.bitbltbuf.dbw, 1u),
+                         command.bitbltbuf.dpsm, command.trxpos.dsax, command.trxpos.dsay,
+                         command.trxpos.dsax + command.trxreg.rrw - 1, command.trxpos.dsay + command.trxreg.rrh - 1);
+    }
+    else if (command.direction == 1u || command.direction == 2u)
+    {
+        QuiesceBands(kWaitTransfer); // they read (and write) local memory on this thread
+    }
+}
+
+void GSCpuBackend::BandTransferWait()
+{
+    CloseBandVerification();
+    m_bands->WaitForPages(m_bands->transferPages, true, kWaitTransfer);
+}
