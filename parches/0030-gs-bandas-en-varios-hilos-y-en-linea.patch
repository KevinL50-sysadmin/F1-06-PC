+const uint32_t *GSCpuBackend::BandPalette(const GSDrawState &state, uint64_t jobIndex)
+{
+    BandState &bs = *m_bands;
+    PreparePalette(state); // m_palette for this state; (m_paletteGeneration, m_paletteKey) identify its contents
+    if (bs.paletteCurrent == SIZE_MAX || bs.paletteGeneration != m_paletteGeneration || bs.paletteKey != m_paletteKey)
+    {
+        const size_t slot = bs.paletteNext;
+        bs.paletteNext = (slot + 1u) % BandState::kPaletteCount;
+        bs.WaitDone(bs.paletteLastJob[slot], kWaitPalette);
+        bs.palettes[slot] = m_palette;
+        bs.paletteCurrent = slot;
+        bs.paletteGeneration = m_paletteGeneration;
+        bs.paletteKey = m_paletteKey;
+    }
+    bs.paletteLastJob[bs.paletteCurrent] = jobIndex + 1u;
+    return bs.palettes[bs.paletteCurrent].data();
+}
