+template <typename T>
+bool GSThreadedBackend::TryPush(T &&command, uint32_t cost)
+{
+    cost += kCommandCost;
+    std::unique_lock<std::mutex> lock(m_mutex);
+    if (!(m_tail - m_head < kCapacity && (m_head == m_tail || m_pendingCost + cost <= kMaxPendingCost)))
+        return false;
+    Slot &slot = m_ring[m_tail % kCapacity];
+    slot.command = std::forward<T>(command);
+    slot.cost = cost;
+    m_pendingCost += cost;
+    if constexpr (std::is_same_v<std::decay_t<T>, SnapshotCommand>)
+        m_lastSnapshotIndex.store(m_tail, std::memory_order_relaxed);
+    ++m_tail;
+    if (m_workerWaiting)
+        m_notEmpty.notify_one();
+    return true;
