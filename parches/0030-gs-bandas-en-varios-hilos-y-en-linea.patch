+    const auto checkTarget = [&](const PageBits &pages, uint32_t layout)
+    {
+        pages.forEachCommon(bs.pendingWrites, [&](uint32_t page)
+                            {
+                                if (bs.pageWriteLayout[page] != layout)
+                                    needLayout = std::max(needLayout, bs.pageWriteJob[page]); });
+        pages.forEachCommon(bs.pendingReads, [&](uint32_t page)
+                            { needRead = std::max(needRead, bs.ReadJobOf(page)); });
+    };
+    checkTarget(colorPages, colorLayout);
+    checkTarget(depthPages, depthLayout);
+    const uint64_t need = std::max({needTexture, needLayout, needRead});
+    if (need > bs.minDone)
+        bs.WaitDone(need, need == needTexture ? kWaitTexture : need == needLayout ? kWaitLayout : kWaitTextureRead);
+
+    // F1_GS_VERIFICAR_BANDAS: a batch starts from local memory with nothing pending.
+    if (bs.verifyLeft != 0u &&
+        std::chrono::duration<double>(std::chrono::steady_clock::now() - bs.verifyStart).count() >= bs.verifyFrom)
+    {
+        if (bs.verifyBatches.empty())
+        {
+            bs.WaitDone(index, kWaitVerify);
+            bs.verifyBefore.assign(m_vram, m_vram + m_vramSize);
+        }
+        bs.verifyBatches.push_back(batch);
+    }
+
+    // Record what it touches and publish it.
+    const uint64_t tag = index + 1u;
+    colorPages.forEach([&](uint32_t page)
+                       { bs.pageWriteJob[page] = tag; bs.pageWriteLayout[page] = colorLayout; });
+    depthPages.forEach([&](uint32_t page)
+                       { bs.pageWriteJob[page] = tag; bs.pageWriteLayout[page] = depthLayout; });
+    bs.pendingWrites |= colorPages;
+    bs.pendingWrites |= depthPages;
+    if (texturePages != nullptr)
+    {
+        bs.textureLastJob = tag;
+        bs.pendingReads |= *texturePages;
+    }
+    bs.prepared = tag;
+    if (tag - bs.published.load(std::memory_order_relaxed) >= BandState::kPublishBatch)
+        bs.Publish(tag);
+
+    if (bs.verifyBatches.size() >= 256u)
+        CloseBandVerification();
+    if ((++bs.jobsSinceReport & 1023u) == 0u)
+        bs.Report();
+}
+
+void GSCpuBackend::CloseBandVerification()
+{
+    if (!m_bands || m_bands->verifyBatches.empty())
+        return;
+    BandState &bs = *m_bands;
+    bs.WaitDone(bs.prepared, kWaitVerify);
+    bs.verifyBands.assign(m_vram, m_vram + m_vramSize);
+    std::memcpy(m_vram, bs.verifyBefore.data(), m_vramSize);
+    for (const GSPrimitiveBatch &batch : bs.verifyBatches)
+    {
+        if (batch.state.prim.type == GS_PRIM_SPRITE)
+            DrawSpriteReference(batch);
+        else
+            DrawTriangleReference(batch);
+    }
+    const uint64_t count = bs.verifyBatches.size();
+    bs.verifyChecked += count;
+    ++bs.verifyBatchesChecked;
+    if (std::memcmp(m_vram, bs.verifyBands.data(), m_vramSize) != 0)
+    {
+        ++bs.verifyDifferent;
+        size_t first = 0u, differing = 0u;
+        for (size_t i = 0; i < m_vramSize; ++i)
+            if (m_vram[i] != bs.verifyBands[i] && differing++ == 0u)
+                first = i;
+        if (bs.verifyDifferent <= 20u)
+            std::fprintf(stderr,
+                         "[gs:bandas] verificar: DISTINTO lote %llu (%llu primitivas): %zu bytes, primero 0x%zx "
+                         "(bandas %02x, referencia %02x)\n",
+                         static_cast<unsigned long long>(bs.verifyBatchesChecked), static_cast<unsigned long long>(count),
+                         differing, first, bs.verifyBands[first], m_vram[first]);
+        // Keep the reference result, as VerifyPrimitive does.
+    }
+    bs.verifyBatches.clear();
+    bs.verifyLeft = bs.verifyLeft > count ? bs.verifyLeft - count : 0u;
+    if (bs.verifyBatchesChecked % 50u == 0u || bs.verifyLeft == 0u)
+        std::fprintf(stderr, "[gs:bandas] verificar: %llu primitivas en %llu lotes comprobadas, %llu lotes distintos\n",
+                     static_cast<unsigned long long>(bs.verifyChecked),
+                     static_cast<unsigned long long>(bs.verifyBatchesChecked),
+                     static_cast<unsigned long long>(bs.verifyDifferent));
 }
 
