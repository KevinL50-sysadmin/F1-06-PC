+        bool drivingButtonsDistinct(const std::map<std::string, std::string> &values)
+        {
+            std::set<std::string> buttons;
+            for (const std::string &key : gameOptionsPageKeys(6))
+                if (const auto found = values.find(key); found != values.end() && !buttons.insert(found->second).second)
+                    return false;
+            return true;
