+        // Two actions on one button (a file written by hand, a variable): the actions that are not forced take the
+        // defaults of the mode; if a forced one still shares a button, each other action that does takes the first
+        // free button, in the order of its choices. False when nothing changes.
+        bool repairDrivingButtons(std::map<std::string, std::string> &values,
+                                  const std::map<std::string, std::string> &forced, bool development)
+        {
+            if (drivingButtonsDistinct(values))
+                return false;
+            const std::vector<std::string> &keys = gameOptionsPageKeys(6);
+            for (const std::string &key : keys)
+                if (forced.count(key) == 0u)
+                    values[key] = optionDefault(*findSpec(key), development);
+            for (const std::string &key : keys)
+            {
+                if (forced.count(key) != 0u)
+                    continue;
+                bool shared = false;
+                std::set<std::string> used;
+                for (const std::string &other : keys)
+                    if (other != key)
+                    {
+                        used.insert(values[other]);
+                        shared = shared || values[other] == values[key];
+                    }
+                if (!shared)
+                    continue;
+                for (const OptionChoice &choice : findSpec(key)->choices)
+                    if (used.count(choice.value) == 0u)
+                    {
+                        values[key] = choice.value;
+                        break;
+                    }
+            }
+            return true;
+        }
