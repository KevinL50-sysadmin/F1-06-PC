+PS2OptionsMenu::GameNetplayState PS2OptionsMenu::gameNetplayState(int waitMs)
+{
+    const auto until = std::chrono::steady_clock::now() + std::chrono::milliseconds(std::max(0, waitMs));
+    while (g_netplayRequest.load() >= 0 && std::chrono::steady_clock::now() < until)
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    // update() takes the request and starts or stops the host holding g_modelMutex: once it is free, that is done.
+    {
+        std::lock_guard<std::mutex> lock(g_modelMutex);
+    }
+    const int request = g_netplayRequest.load();
+    const ps2x::netplay::HostSessionStatus status = ps2x::netplay::hostSession().status();
+    GameNetplayState state;
+    state.state = static_cast<int>(ps2x::netplay::hostPageState(status, request));
+    state.port = status.hosting ? status.port : 0;
+    state.addresses = ps2x::netplay::hostPageAddresses(status);
+    return state;
+}
