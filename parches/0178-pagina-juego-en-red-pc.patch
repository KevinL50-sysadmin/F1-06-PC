+    std::vector<std::array<int, 4>> hostPageAddresses(const HostSessionStatus &status)
+    {
+        std::vector<std::array<int, 4>> parts;
+        if (!status.hosting)
+            return parts;
+        for (const std::string &address : status.addresses)
+        {
+            std::array<int, 4> numbers{};
+            size_t at = 0;
+            bool good = true;
+            for (size_t i = 0; good && i < numbers.size(); ++i)
+            {
+                const size_t end = i + 1 < numbers.size() ? address.find('.', at) : address.size();
+                const std::string part = end == std::string::npos ? std::string() : address.substr(at, end - at);
+                good = !part.empty() && part.size() <= 3u && (part.size() == 1u || part[0] != '0') &&
+                       std::all_of(part.begin(), part.end(), [](unsigned char c) { return std::isdigit(c) != 0; });
+                if (good)
+                {
+                    numbers[i] = std::atoi(part.c_str());
+                    good = numbers[i] <= 255;
+                }
+                at = end + 1;
+            }
+            if (good)
+                parts.push_back(numbers);
+        }
+        return parts;
+    }
