+// Patch 0148: soft edges for the draws inside one scissor window (F1 06: the race-HUD minimap, a big rotated quad of
+// the whole track clipped by SCISSOR_1 to an 80x125 box, so the track line ends in a hard straight cut). A draw
+// packet (one PACKED tag with PRE) whose context scissor is exactly `scissor` is redrawn as disjoint pieces: rings of
+// one pixel along the edge of the window, each with its own scissor and the vertex alpha scaled from faint (outer
+// ring) to full, and the rest of the window once as it was; the window's scissor is set again after them. The
+// rewrite happens before either rasterizer sees the packet, so both draw the same thing. scissor 0 or width 0: off.
+void ps2GsSetScissorFeather(uint64_t scissor, uint32_t widthPixels)
+{
+    s_featherWidth.store(0u, std::memory_order_relaxed);
+    s_featherScissor.store(scissor & kScissorFieldMask, std::memory_order_relaxed);
+    s_featherWidth.store(widthPixels, std::memory_order_release);
+}
+
+// Patch 0148: textured, alpha-blended draws into these frame buffers (FBP) do not write the frame alpha where the
+// texel alpha is 0. F1 06 shows each picture as circuit 1 blended with the other buffer one line lower (PMODE MMOD 0:
+// by the pixel alpha of circuit 1); the transparent texels of its text and menu sprites wrote alpha 0, so their whole
+// boxes showed the other buffer shifted by a line (the red of a bar one line higher behind its "100%", a dark line
+// above a sprite edge). The colour is the same either way ((Cs-Cd)*0+Cd). count 0: off.
+void ps2GsSetKeepFrameAlpha(const uint32_t *fbps, uint32_t count)
+{
+    s_keepAlphaOn.store(false, std::memory_order_relaxed);
+    for (std::atomic<uint64_t> &word : s_keepAlphaFbps)
+        word.store(0u, std::memory_order_relaxed);
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        const uint32_t fbp = fbps[i] & 0x1FFu;
+        s_keepAlphaFbps[fbp >> 6].fetch_or(1ull << (fbp & 63u), std::memory_order_relaxed);
+    }
+    s_keepAlphaOn.store(count != 0u, std::memory_order_release);
+}
