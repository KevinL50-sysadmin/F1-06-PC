+    // Debug (patch 0148): F1_GS_VOLCAR_TIJERA=<64-bit value in hex> prints, once, the first GIF packet holding that
+    // value (at any 8-byte position; e.g. a SCISSOR or a packed XYZ2), the F1_GS_VOLCAR_TIJERA_ANTES (default 0)
+    // packets before it and the F1_GS_VOLCAR_TIJERA_N (default 40) after it, one quadword per line ("[gs:tijera]").
+    // F1_GS_VOLCAR_TIJERA_MASCARA=<hex>: only those bits of each word are compared.
+    // Called under the GS state mutex.
+    void printDumpedPacket(const uint8_t *data, uint32_t sizeBytes, const char *label)
+    {
+        std::ostringstream text;
+        text << "[gs:tijera] paquete" << label << " de " << sizeBytes << " bytes\n";
+        for (uint32_t at = 0; at + 16u <= sizeBytes; at += 16u)
+        {
+            char line[64];
+            std::snprintf(line, sizeof(line), "[gs:tijera] %5u %016llx %016llx\n", at / 16u,
+                          static_cast<unsigned long long>(loadLE64(data + at + 8u)),
+                          static_cast<unsigned long long>(loadLE64(data + at)));
+            text << line;
+        }
+        std::cerr << text.str() << std::flush;
+    }
+
+    void dumpScissorPacket(const uint8_t *data, uint32_t sizeBytes)
+    {
+        static const uint64_t s_value = []
+        {
+            const char *value = std::getenv("F1_GS_VOLCAR_TIJERA");
+            return value != nullptr ? std::strtoull(value, nullptr, 16) : 0ull;
+        }();
+        static const int s_after = []
+        {
+            const char *value = std::getenv("F1_GS_VOLCAR_TIJERA_N");
+            return value != nullptr ? std::atoi(value) : 40;
+        }();
+        static const size_t s_before = []
+        {
+            const char *value = std::getenv("F1_GS_VOLCAR_TIJERA_ANTES");
+            return value != nullptr ? static_cast<size_t>(std::max(0, std::atoi(value))) : size_t{0};
+        }();
+        static const uint64_t s_mask = []
+        {
+            const char *value = std::getenv("F1_GS_VOLCAR_TIJERA_MASCARA"); // bits compared (default all)
+            return value != nullptr ? std::strtoull(value, nullptr, 16) : ~0ull;
+        }();
+        static std::vector<std::vector<uint8_t>> s_previous; // the last s_before packets, oldest first
+        static int s_left = -1; // packets still to print after the first one (-1: not found yet)
+        if (s_value == 0u || s_left == 0)
+            return;
+        if (s_left < 0)
+        {
+            bool found = false;
+            for (uint32_t at = 0; at + 8u <= sizeBytes && !found; at += 8u)
+                found = (loadLE64(data + at) & s_mask) == s_value;
+            if (!found)
+            {
+                if (s_before != 0u)
+                {
+                    if (s_previous.size() == s_before)
+                        s_previous.erase(s_previous.begin());
+                    s_previous.emplace_back(data, data + sizeBytes);
+                }
+                return;
+            }
+            for (const std::vector<uint8_t> &previous : s_previous)
+                printDumpedPacket(previous.data(), static_cast<uint32_t>(previous.size()), " (antes)");
+            s_previous.clear();
+            s_left = s_after + 1;
+            printDumpedPacket(data, sizeBytes, " (el buscado)");
+            --s_left;
+            return;
+        }
+        --s_left;
+        printDumpedPacket(data, sizeBytes, "");
+    }
+
+    // Patch 0148: ps2GsSetScissorFeather and ps2GsSetKeepFrameAlpha.
+    constexpr uint64_t kScissorFieldMask = 0x07FF07FF07FF07FFull;
+    std::atomic<uint64_t> s_featherScissor{0u};
+    std::atomic<uint32_t> s_featherWidth{0u};
+    std::atomic<uint64_t> s_keepAlphaFbps[8] = {}; // one bit per FBP (0-511)
+    std::atomic<bool> s_keepAlphaOn{false};
+    thread_local bool t_rewriteBusy = false; // processing a rewritten packet
+
+    uint64_t encodeScissor(uint32_t x0, uint32_t y0, uint32_t x1, uint32_t y1)
+    {
+        return static_cast<uint64_t>(x0) | (static_cast<uint64_t>(x1) << 16) | (static_cast<uint64_t>(y0) << 32) |
+               (static_cast<uint64_t>(y1) << 48);
+    }
+
+    // A draw packet rewritten by the rules of patch 0148, or false when no rule applies. Only a packet that is one
+    // PACKED tag with PRE (a triangle or sprite primitive) and vertex data is considered.
+    bool buildDrawRewrite(const uint8_t *data, uint32_t sizeBytes, const GSContext ctx[2], bool prmodecont,
+                          const GSPrimReg &prmode, bool pabe, std::vector<uint8_t> &out)
+    {
+        const uint32_t width = s_featherWidth.load(std::memory_order_acquire);
+        const uint64_t window = s_featherScissor.load(std::memory_order_relaxed);
+        const bool keepAlphaOn = s_keepAlphaOn.load(std::memory_order_acquire);
+        if (((width == 0u || window == 0u) && !keepAlphaOn) || t_rewriteBusy || sizeBytes < 32u)
+            return false;
+        const uint64_t tagLo = loadLE64(data);
+        const uint64_t tagHi = loadLE64(data + 8u);
+        const uint32_t nloop = static_cast<uint32_t>(tagLo & 0x7FFFu);
+        uint32_t nreg = static_cast<uint32_t>((tagLo >> 60) & 0xFu);
+        if (nreg == 0u)
+            nreg = 16u;
+        const uint32_t prim = static_cast<uint32_t>((tagLo >> 47) & 0x7FFu);
+        const uint32_t type = prim & 7u;
+        if (((tagLo >> 58) & 3u) != GIF_FMT_PACKED || ((tagLo >> 46) & 1u) == 0u || type < GS_PRIM_TRIANGLE ||
+            type > GS_PRIM_SPRITE || 16ull + 16ull * nloop * nreg != sizeBytes)
+            return false;
+        for (uint32_t r = 0; r < nreg; ++r)
+        {
+            const uint32_t reg = static_cast<uint32_t>((tagHi >> (r * 4u)) & 0xFu);
+            if ((reg < GS_REG_RGBAQ || reg > GS_REG_XYZ2) && reg != GS_REG_FOG && reg != 0xFu) // vertex data, NOP
+                return false;
+        }
+        const GSPrimReg attributes = prmodecont ? decodePrimRegister(prim) : prmode;
+        const uint32_t ci = attributes.ctxt ? 1u : 0u;
+        const GSContext &c = ctx[ci];
+
+        // ps2GsSetKeepFrameAlpha: a textured, alpha-blended (Cs-Cd)*As+Cd draw without alpha test into a registered
+        // PSMCT32 buffer. A texel with As 0 leaves the colour as it was but writes alpha 0; with the alpha test
+        // NOTEQUAL 0 and AFAIL ZB_ONLY it writes nothing but the Z it wrote before.
+        const uint32_t fbp = c.frame.fbp & 0x1FFu;
+        const bool keepAlpha =
+            keepAlphaOn && attributes.tme && attributes.abe && !pabe && (c.alpha & 0xFFu) == 0x44u &&
+            (c.test & 1u) == 0u && ((c.test >> 14) & 1u) == 0u && c.frame.psm == GS_PSM_CT32 &&
+            (c.frame.fbmsk & 0xFF000000u) == 0u && (c.fba & 1u) == 0u && c.tex0.tcc != 0u &&
+            ((s_keepAlphaFbps[fbp >> 6].load(std::memory_order_relaxed) >> (fbp & 63u)) & 1u) != 0u;
+        const GSScissorReg &sc = c.scissor;
+        uint32_t k = 0u;
+        if (width != 0u && window != 0u && encodeScissor(sc.x0, sc.y0, sc.x1, sc.y1) == window && sc.x1 >= sc.x0 &&
+            sc.y1 >= sc.y0)
+            k = std::min<uint32_t>({width, (sc.x1 - sc.x0) / 2u, (sc.y1 - sc.y0) / 2u});
+        if (k == 0u && !keepAlpha)
+            return false;
+
+        const uint64_t scissorReg = ci != 0u ? GS_REG_SCISSOR_2 : GS_REG_SCISSOR_1;
+        const uint64_t testReg = ci != 0u ? GS_REG_TEST_2 : GS_REG_TEST_1;
+        out.clear();
+        out.reserve((4u * k + 2u) * (sizeBytes + 32u) + 64u);
+        const auto put = [&out](uint64_t value)
+        {
+            const size_t at = out.size();
+            out.resize(at + 8u);
+            std::memcpy(out.data() + at, &value, 8u);
+        };
+        const auto writeRegister = [&](uint64_t reg, uint64_t value)
+        {
+            put(1ull | (static_cast<uint64_t>(GIF_FMT_PACKED) << 58) | (1ull << 60)); // NLOOP 1, NREG 1, no EOP
+            put(0xEull); // A+D
+            put(value);
+            put(reg);
+        };
+        const auto draw = [&](float factor)
+        {
+            const size_t at = out.size();
+            out.insert(out.end(), data, data + sizeBytes);
+            out[at + 1u] &= 0x7Fu; // EOP off: a register write follows
+            if (factor != 1.0f)
+                for (uint32_t loop = 0; loop < nloop; ++loop)
+                    for (uint32_t r = 0; r < nreg; ++r)
+                        if (((tagHi >> (r * 4u)) & 0xFu) == GS_REG_RGBAQ)
+                        {
+                            uint8_t &alpha = out[at + 16u + (loop * nreg + r) * 16u + 12u];
+                            alpha = static_cast<uint8_t>(std::lround(alpha * factor));
+                        }
+        };
+        const auto drawIn = [&](uint32_t x0, uint32_t y0, uint32_t x1, uint32_t y1, float factor)
+        {
+            if (x1 < x0 || y1 < y0)
+                return;
+            writeRegister(scissorReg, encodeScissor(x0, y0, x1, y1));
+            draw(factor);
+        };
+
+        if (keepAlpha)
+            writeRegister(testReg, (c.test & ~0x3FFFull) | 1u | (7u << 1) | (2u << 12)); // ATE, NOTEQUAL 0, ZB_ONLY
+        if (k == 0u)
+            draw(1.0f);
+        else
+        {
+            // ps2GsSetScissorFeather: rings of one pixel along the edge of the window, faint to full, then the rest.
+            for (uint32_t ring = 0; ring < k; ++ring)
+            {
+                const float t = static_cast<float>(ring + 1u) / static_cast<float>(k + 1u);
+                const float factor = t * t * (3.0f - 2.0f * t); // smoothstep
+                const uint32_t x0 = sc.x0 + ring, x1 = sc.x1 - ring, y0 = sc.y0 + ring, y1 = sc.y1 - ring;
+                drawIn(x0, y0, x1, y0, factor);
+                drawIn(x0, y1, x1, y1, factor);
+                drawIn(x0, y0 + 1u, x0, y1 - 1u, factor);
+                drawIn(x1, y0 + 1u, x1, y1 - 1u, factor);
+            }
+            drawIn(sc.x0 + k, sc.y0 + k, sc.x1 - k, sc.y1 - k, 1.0f);
+            writeRegister(scissorReg, window);
+        }
+        if (keepAlpha)
+            writeRegister(testReg, c.test);
+        out[out.size() - 32u + 1u] |= static_cast<uint8_t>(tagLo >> 8) & 0x80u; // the EOP of the original tag
+        return true;
+    }
+
