+    }
+
+    // One PACKED GIF tag with PRE: a textured, alpha-blended sprite with UV (fst), (0,0)-(8,8), vertex colour 0x80.
+    std::vector<uint8_t> keepAlphaSpritePacket()
+    {
+        const uint64_t prim = static_cast<uint64_t>(GS_PRIM_SPRITE) | (1ull << 4) | (1ull << 6) | (1ull << 8);
+        std::vector<uint8_t> packet;
+        appendU64(packet, makeGifTag(1u, GIF_FMT_PACKED, 5u, true) | (1ull << 46) | (prim << 47));
+        appendU64(packet, 0x53531ull); // RGBAQ, UV, XYZ2, UV, XYZ2
+        appendU64(packet, 0x80ull | (0x80ull << 32));
+        appendU64(packet, 0x80ull | (0x80ull << 32));
+        appendU64(packet, 0ull);
+        appendU64(packet, 0ull);
+        appendU64(packet, 0ull);
+        appendU64(packet, 0ull);
+        appendU64(packet, (8ull << 4) | ((8ull << 4) << 32));
+        appendU64(packet, 0ull);
+        appendU64(packet, (8ull << 4) | ((8ull << 4) << 32));
+        appendU64(packet, 0ull);
+        return packet;
+    }
