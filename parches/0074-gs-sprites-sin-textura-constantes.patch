+    // Patch 0074: an untextured sprite has the same colour, depth and fog in every pixel, so what writePixelTyped works
+    // out from them alone (the fog, the alpha test, the blend decision, the colour written without blending) is done
+    // once per sprite; the rest is the same per pixel, with the same expressions. Its pixels are inside the scissor
+    // already (prepareSprite clips to it). A/B mode 58: writePixelTyped for each pixel, as before.
+    template <GSMem::PixelStorageMode F, GSMem::PixelStorageMode Z>
+    void spriteFillRows(const BandJob &job, int shift, unsigned count, unsigned index)
+    {
+        const SpriteSetup s = job.sprite;
+        const PixelPipeline &pp = job.pp;
+        uint8_t *const vram = pp.vram;
+        uint8_t r = static_cast<uint8_t>(s.vertexRgba);
+        uint8_t g = static_cast<uint8_t>(s.vertexRgba >> 8);
+        uint8_t b = static_cast<uint8_t>(s.vertexRgba >> 16);
+        const uint8_t a = static_cast<uint8_t>(s.vertexRgba >> 24);
+        if (pp.fge)
+        {
+            const uint8_t fog = s.fog;
+            const uint32_t inverseFog = 255u - fog;
+            auto applyFog = [&](uint8_t input, uint8_t fogColor) -> uint8_t
+            {
+                return static_cast<uint8_t>(((static_cast<uint32_t>(fog) * input) >> 8) + ((inverseFog * fogColor) >> 8));
+            };
+            r = applyFog(r, pp.fogR);
+            g = applyFog(g, pp.fogG);
+            b = applyFog(b, pp.fogB);
+        }
+        const PixelWriteMask writeMask = classifyAlphaTest(pp.test, a, static_cast<uint8_t>(pp.fpsm));
+        if (!writeMask.writesAnything())
+            return;
+        const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha && pp.frameCt32;
+        const bool frmw = pp.dateNeedsRead ||
+                          (writeMask.writesFramebuffer() && (pp.fbmsk != 0 || pp.abe || preserveDestinationAlpha));
+        const bool writeFrame = writeMask.writesFramebuffer();
+        const bool blend = pp.abe && !(pp.pabe && (a & 0x80u) == 0u);
+        const uint8_t written = writeMask.writeAlpha && pp.fbaSetsAlpha ? static_cast<uint8_t>(a | 0x80u) : a;
+        const u32 plain = pack32(r, g, b, written);
+        const bool writeDepth = writeMask.writeDepth && !pp.zmask;
+        const uint32_t z = static_cast<uint32_t>(s.z);
+        const int skip = static_cast<int>(count - 1u) << shift;
+        for (int y = firstBandRow(s.drawY0, shift, count, index); y <= s.drawY1; y = nextBandRow(y, shift, skip))
+            for (int x = s.drawX0; x <= s.drawX1; ++x)
+            {
+                u32 rawFramebufferPixel = 0;
+                u32 fbrgba = 0;
+                if (frmw)
+                {
+                    rawFramebufferPixel = pipelineRead<F>(pp.readFrame, vram, pp.fbp, pp.fbw, x, y);
+                    fbrgba = rawFramebufferPixel;
+                    if (pp.frame16)
+                        fbrgba = Rgba5551ToRgba8888(fbrgba);
+                    else if (pp.frameCt24)
+                        fbrgba |= 0x80000000u;
+                }
+                if (!passesDestinationAlphaTest(pp.test, static_cast<uint8_t>(pp.fpsm), rawFramebufferPixel))
+                    continue;
+                bool zpass = false;
+                switch (pp.ztestMethod)
+                {
+                case 0:
+                    zpass = false;
+                    break;
+                case 1:
+                    zpass = true;
+                    break;
+                case 2:
+                    zpass = z >= pipelineRead<Z>(pp.readZ, vram, pp.zbp, pp.fbw, x, y);
+                    break;
+                case 3:
+                    zpass = z > pipelineRead<Z>(pp.readZ, vram, pp.zbp, pp.fbw, x, y);
+                    break;
+                }
+                if (!zpass)
+                    continue;
+                if (writeFrame)
+                {
+                    u32 pixel = plain;
+                    if (blend)
+                    {
+                        const uint8_t dr = fbrgba & 0xFF;
+                        const uint8_t dg = (fbrgba >> 8) & 0xFF;
+                        const uint8_t db = (fbrgba >> 16) & 0xFF;
+                        const uint8_t da = (fbrgba >> 24) & 0xFF;
+                        auto pickRGB = [](uint8_t sel, int cs, int cd) -> int
+                        {
+                            if (sel == 0)
+                                return cs;
+                            if (sel == 1)
+                                return cd;
+                            return 0;
+                        };
+                        const int cAlpha = (pp.csel == 0) ? a : (pp.csel == 1) ? da
+                                                                               : pp.fix;
+                        const uint8_t br = clampU8(((pickRGB(pp.asel, r, dr) - pickRGB(pp.bsel, r, dr)) * cAlpha >> 7) + pickRGB(pp.dsel, r, dr));
+                        const uint8_t bg = clampU8(((pickRGB(pp.asel, g, dg) - pickRGB(pp.bsel, g, dg)) * cAlpha >> 7) + pickRGB(pp.dsel, g, dg));
+                        const uint8_t bb = clampU8(((pickRGB(pp.asel, b, db) - pickRGB(pp.bsel, b, db)) * cAlpha >> 7) + pickRGB(pp.dsel, b, db));
+                        pixel = pack32(br, bg, bb, written);
+                    }
+                    if (pp.fbmsk != 0)
+                        pixel = (pixel & ~pp.fbmsk) | (fbrgba & pp.fbmsk);
+                    if (preserveDestinationAlpha)
+                        pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+                    if (pp.frame16)
+                        pixel = Rgba8888ToRgba5551(pixel);
+                    pipelineWrite<F>(pp.writeFrame, vram, pp.fbp, pp.fbw, x, y, pixel);
+                }
+                if (writeDepth)
+                    pipelineWrite<Z>(pp.writeZ, vram, pp.zbp, pp.fbw, x, y, z);
+            }
+    }
