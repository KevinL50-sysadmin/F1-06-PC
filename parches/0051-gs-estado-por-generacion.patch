+void GSThreadedBackend::SubmitSameState(const GSPrimitiveBatch &batch)
+{
+    const int mode = g_ps2AbMode.load(std::memory_order_relaxed);
+    if (!m_queuedStateValid || mode == 1 || mode == 12 || batch.vertexCount == 0u)
+    {
+        Submit(batch);
+        return;
+    }
+    PrimitiveCommand primitive;
+    primitive.vertices = batch.vertices;
+    primitive.vertexCount = batch.vertexCount;
+    Push(std::move(primitive), estimatePixels(batch));
+}
