 #include "runtime/gs/ps2_gif_arbiter.h"
+#include "runtime/ps2_ab.h"
 #include <algorithm>
 #include <cstring>
 
@@ -30,6 +31,18 @@ void GifArbiter::submit(GifPathId pathId, const uint8_t *data, uint32_t sizeByte
     if (!data || sizeBytes < 16 || !m_processFn)
         return;
 
+    // Patch 0084: a PATH1 packet (XGKICK) with nothing queued goes on at once, without a copy. It is the path with the
+    // highest priority, so drain would put it first anyway (A/B modes 79 and 78: queued and copied, as before).
+    if (pathId == GifPathId::Path1 && m_queue.empty())
+    {
+        const int mode = g_ps2AbMode.load(std::memory_order_relaxed);
+        if (mode != 79 && mode != 78)
+        {
+            m_processFn(data, sizeBytes);
+            return;
+        }
+    }
+
