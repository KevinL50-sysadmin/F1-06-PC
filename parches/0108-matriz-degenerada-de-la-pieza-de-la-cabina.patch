diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
index f6c96c0..7f02530 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
@@ -3256,6 +3256,32 @@ void VU1Interpreter::run(uint8_t *vuCode, uint32_t codeSize,
     const uint32_t pcInicioTraza = m_state.pc;
     if (m_unit == Unit::VU1)
     {
+        // Patch 0108: row 2 of the object matrix in data qwords 0-3 is rebuilt as row0 x row1 when rows 1 and 2 are the
+        // same unit vector. F1 06 sends some objects (two per car, among them a piece of the cockpit) with that
+        // degenerate matrix, built on the EE side by code not found yet: the cockpit piece then stretched its length
+        // upwards, a black carbon "V" over the cockpit view that PCSX2 does not show. F1_VU1_ARREGLO_MATRIZ=0: as before.
+        static const bool s_fixMatrix = []
+        {
+            const char *value = std::getenv("F1_VU1_ARREGLO_MATRIZ");
+            return value == nullptr || std::atoi(value) != 0;
+        }();
+        if (s_fixMatrix && vuData && dataSize >= 64u)
+        {
+            float r[4][4];
+            std::memcpy(r, vuData, sizeof(r));
+            const float l0 = r[0][0] * r[0][0] + r[0][1] * r[0][1] + r[0][2] * r[0][2];
+            const float l1 = r[1][0] * r[1][0] + r[1][1] * r[1][1] + r[1][2] * r[1][2];
+            if (std::memcmp(r[1], r[2], 16) == 0 && l0 > 0.98f && l0 < 1.02f && l1 > 0.98f && l1 < 1.02f &&
+                r[0][3] == 0.0f && r[1][3] == 0.0f && r[3][3] == 1.0f)
+            {
+                const float c[4] = {r[0][1] * r[1][2] - r[0][2] * r[1][1], r[0][2] * r[1][0] - r[0][0] * r[1][2],
+                                    r[0][0] * r[1][1] - r[0][1] * r[1][0], 0.0f};
+                std::memcpy(vuData + 32, c, 16);
+                static uint32_t s_fixed = 0u;
+                if (s_fixed++ < 3u)
+                    std::fprintf(stderr, "[vu1:matriz] fila 2 rehecha (inicio=0x%04x)\n", m_state.pc);
+            }
+        }
         s_vu1RunStartPc = m_state.pc;
         s_vu1RunCode = vuCode;
         s_vu1RunCodeSize = codeSize;
