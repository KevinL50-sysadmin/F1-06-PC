+    // Macro-mode VU0 memory accesses (VLQI/VSQI/VLQD/VSQD/VILWR/VISWR) address VU0 data memory, 4 KB seen from
+    // the EE at 0x11004000: the VI register holds a quadword index that wraps at 256. VI0 stays 0 and VF0 is
+    // read-only. Encodings: VLQI/VLQD ft, (is) use ft = rt, is = rd; VSQI/VSQD fs, (it) use fs = rd, it = rt.
+    namespace
+    {
+        std::string vu0MemAddress(uint8_t vi)
+        {
+            return fmt::format("(0x11004000u + (((uint32_t)ctx->vi[{}] & 0xFFu) << 4))", vi);
+        }
+
+        std::string vu0StepVi(uint8_t vi, int delta)
+        {
+            if (vi == 0)
+                return "";
+            return fmt::format("ctx->vi[{}] = static_cast<uint16_t>(ctx->vi[{}] {} 1); ", vi, vi, delta > 0 ? '+' : '-');
+        }
+
+        std::string vu0LoadInto(uint8_t vft, uint8_t dest_mask, const std::string &addrExpr)
+        {
+            if (vft == 0)
+                return "";
+            return fmt::format("{{ __m128 res = _mm_castsi128_ps(READ128({})); "
+                               "__m128i mask = _mm_set_epi32({}, {}, {}, {}); "
+                               "ctx->vu0_vf[{}] = _mm_blendv_ps(ctx->vu0_vf[{}], res, _mm_castsi128_ps(mask)); }} ",
+                               addrExpr,
+                               (dest_mask & 0x1) ? -1 : 0, (dest_mask & 0x2) ? -1 : 0,
+                               (dest_mask & 0x4) ? -1 : 0, (dest_mask & 0x8) ? -1 : 0,
+                               vft, vft);
+        }
+
+        std::string vu0StoreFrom(uint8_t vfs, uint8_t dest_mask, const std::string &addrExpr)
+        {
+            return fmt::format("{{ const uint32_t addr = {}; __m128i old_val = READ128(addr); "
+                               "__m128 res = _mm_blendv_ps(_mm_castsi128_ps(old_val), ctx->vu0_vf[{}], _mm_castsi128_ps(_mm_set_epi32({}, {}, {}, {}))); "
+                               "WRITE128(addr, _mm_castps_si128(res)); }} ",
+                               addrExpr, vfs,
+                               (dest_mask & 0x1) ? -1 : 0, (dest_mask & 0x2) ? -1 : 0,
+                               (dest_mask & 0x4) ? -1 : 0, (dest_mask & 0x8) ? -1 : 0);
+        }
+
+        // Byte offset of the single field selected by the dest mask (x=8, y=4, z=2, w=1).
+        uint32_t vu0FieldOffset(uint8_t dest_mask)
+        {
+            if (dest_mask & 0x8)
+                return 0u;
+            if (dest_mask & 0x4)
+                return 4u;
+            if (dest_mask & 0x2)
+                return 8u;
+            return 12u;
+        }
+    }
