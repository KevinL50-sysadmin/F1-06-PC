+
+    // ---- Tablas de busqueda (por los 16 bits siguientes) ----
+    struct VlcEntry
+    {
+        uint8_t len = 0;   // 0 = codigo no valido
+        uint8_t run = 0;   // 64 = EOB, 65 = escape
+        int16_t level = 0; // o el valor (DC: tamano; MBAI: incremento, 34 escape, 35 relleno)
+    };
+    constexpr uint8_t kRunEob = 64;
+    constexpr uint8_t kRunEscape = 65;
+
+    template <size_t Bits>
+    void addCode(std::array<VlcEntry, (1u << Bits)> &table, uint32_t code, uint32_t len, VlcEntry entry)
+    {
+        entry.len = static_cast<uint8_t>(len);
+        const uint32_t first = code << (Bits - len);
+        const uint32_t count = 1u << (Bits - len);
+        for (uint32_t i = 0; i < count; ++i)
+            table[first + i] = entry;
+    }
+
+    struct Tablas
+    {
+        std::array<VlcEntry, 1u << 16> acZero{};
+        std::array<VlcEntry, 1u << 16> acOne{};
+        std::array<VlcEntry, 1u << 10> dcLum{};
+        std::array<VlcEntry, 1u << 10> dcChroma{};
+        std::array<VlcEntry, 1u << 11> mbai{};
+        float idct[8][8]{}; // idct[u][x] = c(u)/2 * cos((2x+1) u pi / 16)
+
+        Tablas()
+        {
+            for (int i = 0; i < kRlElems + 2; ++i)
+            {
+                VlcEntry e0{};
+                VlcEntry e1{};
+                if (i < kRlElems)
+                {
+                    e0.run = e1.run = static_cast<uint8_t>(kRlRun[i]);
+                    e0.level = e1.level = kRlLevel[i];
+                }
+                else
+                {
+                    e0.run = e1.run = (i == kRlElems) ? kRunEscape : kRunEob;
+                }
+                addCode<16>(acZero, kTableZero[i][0], kTableZero[i][1], e0);
+                addCode<16>(acOne, kTableOne[i][0], kTableOne[i][1], e1);
+            }
+            for (int s = 0; s < 12; ++s)
+            {
+                VlcEntry e{};
+                e.level = static_cast<int16_t>(s);
+                addCode<10>(dcLum, kDcLumCode[s], kDcLumBits[s], e);
+                addCode<10>(dcChroma, kDcChromaCode[s], kDcChromaBits[s], e);
+            }
+            for (int i = 0; i < 35; ++i)
+            {
+                VlcEntry e{};
+                e.level = static_cast<int16_t>(i + 1);
+                addCode<11>(mbai, kMbAddrIncr[i][0], kMbAddrIncr[i][1], e);
+            }
+            const double pi = 3.14159265358979323846;
+            for (int u = 0; u < 8; ++u)
+                for (int x = 0; x < 8; ++x)
+                    idct[u][x] = static_cast<float>((u == 0 ? std::sqrt(0.5) : 1.0) * 0.5 *
+                                                    std::cos((2 * x + 1) * u * pi / 16.0));
+        }
+    };
+
+    const Tablas &tablas()
+    {
+        static const Tablas t;
+        return t;
+    }
+
+    // ---- Estado del IPU ----
+    struct Ipu
+    {
+        std::vector<uint8_t> in;    // FIFO de entrada (bytes en orden de memoria)
+        size_t bitPos = 0;          // bits ya leidos de "in"
+        uint32_t pendingSkip = 0;   // BCLR.BP: bits que saltar del siguiente dato
+        std::vector<uint8_t> out;   // FIFO de salida
+        size_t outPos = 0;
+        uint32_t cmdResult = 0;     // IPU_CMD al leer (FDEC/VDEC)
+        uint32_t ctrl = 0;          // IPU_CTRL (campos escribibles + ECD/SCD)
+        uint8_t iqIntra[64]{};      // en orden de barrido (zigzag), como los carga SETIQ
+        uint8_t iqNonIntra[64]{};
+        uint16_t vqclut[16]{};
+        uint32_t th0 = 0;
+        uint32_t th1 = 0;
+        uint32_t mensajesNoSoportada = 0;
+    };
+
+    Ipu &ipu()
+    {
+        static Ipu estado;
+        return estado;
+    }
+
+    std::mutex &ipuMutex()
+    {
+        static std::mutex m;
+        return m;
+    }
+
+    // ---- Lectura de bits ----
+    size_t bitsAvailable(const Ipu &s)
+    {
+        const size_t total = s.in.size() * 8u;
+        return total > s.bitPos ? total - s.bitPos : 0u;
+    }
+
+    uint32_t peekBits(const Ipu &s, uint32_t n) // n <= 32; mas alla del final lee ceros
+    {
+        uint64_t acc = 0;
+        const size_t byte = s.bitPos >> 3;
+        for (size_t i = 0; i < 5; ++i)
+            acc = (acc << 8) | (byte + i < s.in.size() ? s.in[byte + i] : 0u);
+        acc <<= 24; // 40 bits arriba del todo de 64
+        acc <<= (s.bitPos & 7u);
+        return static_cast<uint32_t>(acc >> (64u - n));
+    }
+
+    void skipBits(Ipu &s, uint32_t n)
+    {
+        s.bitPos += n;
+    }
+
+    uint32_t getBits(Ipu &s, uint32_t n)
+    {
+        if (n == 0u)
+            return 0u;
+        const uint32_t v = peekBits(s, n);
+        skipBits(s, n);
+        return v;
+    }
+
+    void compactInput(Ipu &s)
+    {
+        const size_t bytes = s.bitPos >> 3;
+        if (bytes >= 65536u && bytes * 2u >= s.in.size())
+        {
+            s.in.erase(s.in.begin(), s.in.begin() + static_cast<std::ptrdiff_t>(bytes));
+            s.bitPos -= bytes * 8u;
+        }
+    }
+
+    // ---- IDEC ----
+    struct Contexto
+    {
+        bool mpeg1 = false;
+        bool altScan = false;
+        bool ivf = false;
+        bool qst = false;
+        uint32_t idp = 0;
+        uint32_t qscaleCode = 1;
+        int dcPred[3] = {128, 128, 128};
+    };
+
+    int quantizerScale(const Contexto &c)
+    {
+        if (c.mpeg1)
+            return static_cast<int>(c.qscaleCode);
+        return c.qst ? kNonLinearQscale[c.qscaleCode & 31u] : static_cast<int>(c.qscaleCode) * 2;
+    }
+
+    // Decodifica un bloque intra en coef[] (orden natural). Devuelve false si el flujo esta roto.
+    bool decodeIntraBlock(Ipu &s, Contexto &c, int componente, int coef[64], bool &soloDc)
+    {
+        const Tablas &t = tablas();
+        std::memset(coef, 0, 64 * sizeof(int));
+        const VlcEntry &dce = (componente == 0 ? t.dcLum : t.dcChroma)[peekBits(s, 10)];
+        if (dce.len == 0)
+            return false;
+        skipBits(s, dce.len);
+        const int size = dce.level;
+        int diff = 0;
+        if (size != 0)
+        {
+            const int v = static_cast<int>(getBits(s, static_cast<uint32_t>(size)));
+            diff = (v & (1 << (size - 1))) ? v : v - ((1 << size) - 1);
+        }
+        int &pred = c.dcPred[componente];
+        pred += diff;
+        coef[0] = pred * (8 >> c.idp);
+        soloDc = true;
+
+        const uint8_t *scan = c.altScan ? kAlternateScan : kZigzag;
+        const auto &ac = c.ivf ? t.acOne : t.acZero;
+        const int qs = quantizerScale(c);
+        int suma = coef[0];
+        int i = 0;
+        for (;;)
+        {
+            const VlcEntry &e = ac[peekBits(s, 16)];
+            if (e.len == 0)
+                return false;
+            skipBits(s, e.len);
+            if (e.run == kRunEob)
+                break;
+            int run;
+            int level;
+            if (e.run == kRunEscape)
+            {
+                run = static_cast<int>(getBits(s, 6));
+                if (c.mpeg1)
+                {
+                    level = static_cast<int>(static_cast<int8_t>(getBits(s, 8)));
+                    if (level == 0)
+                        level = static_cast<int>(getBits(s, 8));
+                    else if (level == -128)
+                        level = static_cast<int>(getBits(s, 8)) - 256;
+                }
+                else
+                {
+                    level = static_cast<int>(getBits(s, 12));
+                    if (level & 0x800)
+                        level -= 0x1000;
+                }
+            }
+            else
+            {
+                run = e.run;
+                level = e.level;
+                if (getBits(s, 1))
+                    level = -level;
+            }
+            i += run + 1;
+            if (i > 63)
+                return false;
+            const int j = scan[i];
+            const int peso = s.iqIntra[i];
+            int val;
+            const int mag = std::abs(level) * qs * peso;
+            if (c.mpeg1)
+            {
+                val = mag >> 3;
+                if (val != 0 && (val & 1) == 0)
+                    val -= 1; // "oddification" de MPEG-1
+            }
+            else
+            {
+                val = mag >> 4;
+            }
+            if (level < 0)
+                val = -val;
+            val = std::clamp(val, -2048, 2047);
+            coef[j] = val;
+            suma += val;
+            soloDc = false;
+        }
+        if (!c.mpeg1 && (suma & 1) == 0)
+        {
+            coef[63] ^= 1; // control de desajuste de MPEG-2
+            soloDc = false;
+        }
+        return true;
+    }
+
+    void idctBlock(const int coef[64], bool soloDc, uint8_t *dst, int paso)
+    {
+        if (soloDc)
+        {
+            const int v = std::clamp(static_cast<int>(std::floor(coef[0] / 8.0 + 0.5)), 0, 255);
+            for (int y = 0; y < 8; ++y)
+                std::memset(dst + y * paso, v, 8);
+            return;
+        }
+        const Tablas &t = tablas();
+        float tmp[8][8]; // filas transformadas: tmp[v][x]
+        for (int v = 0; v < 8; ++v)
+        {
+            const int *fila = coef + v * 8;
+            for (int x = 0; x < 8; ++x)
+            {
+                float acc = 0.0f;
+                for (int u = 0; u < 8; ++u)
+                    acc += t.idct[u][x] * static_cast<float>(fila[u]);
+                tmp[v][x] = acc;
+            }
+        }
+        for (int y = 0; y < 8; ++y)
+            for (int x = 0; x < 8; ++x)
+            {
+                float acc = 0.0f;
+                for (int v = 0; v < 8; ++v)
+                    acc += t.idct[v][y] * tmp[v][x];
+                dst[y * paso + x] = static_cast<uint8_t>(std::clamp(static_cast<int>(std::floor(acc + 0.5f)), 0, 255));
+            }
+    }
+
+    // Conversion de color del IPU (coeficientes de PCSX2 / del manual: 1,164, 1,596, 0,813, 0,391, 2,018 en 1/128).
+    void cscMacroblock(Ipu &s, const uint8_t y[16][16], const uint8_t cb[8][8], const uint8_t cr[8][8], bool rgb16,
+                       bool dither)
+    {
+        static constexpr int kDither[4][4] = {{-4, 0, -3, 1}, {2, -2, 3, -1}, {-3, 1, -4, 0}, {3, -1, 2, -2}};
+        const size_t base = s.out.size();
+        s.out.resize(base + (rgb16 ? 512u : 1024u));
+        uint8_t *dst = s.out.data() + base;
+        for (int py = 0; py < 16; ++py)
+            for (int px = 0; px < 16; ++px)
+            {
+                const int lum = (static_cast<int>(y[py][px]) - 16) * 0x95;
+                const int vcb = static_cast<int>(cb[py >> 1][px >> 1]) - 128;
+                const int vcr = static_cast<int>(cr[py >> 1][px >> 1]) - 128;
+                int r = (lum + vcr * 0xcc + 64) >> 7;
+                int g = (lum - vcr * 0x68 - vcb * 0x32 + 64) >> 7;
+                int b = (lum + vcb * 0x102 + 64) >> 7;
+                r = std::clamp(r, 0, 255);
+                g = std::clamp(g, 0, 255);
+                b = std::clamp(b, 0, 255);
+                uint32_t a = 0x80u;
+                if (static_cast<uint32_t>(r) < s.th0 && static_cast<uint32_t>(g) < s.th0 && static_cast<uint32_t>(b) < s.th0)
+                    a = 0u;
+                else if (static_cast<uint32_t>(r) < s.th1 && static_cast<uint32_t>(g) < s.th1 &&
+                         static_cast<uint32_t>(b) < s.th1)
+                    a = 0x40u;
+                if (!rgb16)
+                {
+                    uint8_t *p = dst + (py * 16 + px) * 4;
+                    p[0] = static_cast<uint8_t>(r);
+                    p[1] = static_cast<uint8_t>(g);
+                    p[2] = static_cast<uint8_t>(b);
+                    p[3] = static_cast<uint8_t>(a);
+                }
+                else
+                {
+                    if (dither)
+                    {
+                        const int d = kDither[py & 3][px & 3];
+                        r = std::clamp(r + d, 0, 255);
+                        g = std::clamp(g + d, 0, 255);
+                        b = std::clamp(b + d, 0, 255);
+                    }
+                    const uint16_t v = static_cast<uint16_t>((r >> 3) | ((g >> 3) << 5) | ((b >> 3) << 10) |
+                                                             (a != 0u ? 0x8000u : 0u));
+                    std::memcpy(dst + (py * 16 + px) * 2, &v, 2);
+                }
+            }
+    }
+
+    // IDEC: decodifica macrobloques intra hasta encontrar un codigo de inicio (o acabarse la entrada).
+    void idec(Ipu &s, uint32_t cmd)
+    {
+        Contexto c;
+        c.mpeg1 = (s.ctrl >> 23) & 1u;
+        c.qst = (s.ctrl >> 22) & 1u;
+        c.ivf = (s.ctrl >> 21) & 1u;
+        c.altScan = (s.ctrl >> 20) & 1u;
+        c.idp = (s.ctrl >> 16) & 3u;
+        c.qscaleCode = (cmd >> 16) & 31u;
+        const bool dtd = (cmd >> 24) & 1u;
+        const bool dte = (cmd >> 26) & 1u;
+        const bool rgb16 = (cmd >> 27) & 1u;
+        const int reinicioDc = 1 << (7 + c.idp);
+        for (int &p : c.dcPred)
+            p = reinicioDc;
+        skipBits(s, cmd & 0x3Fu);
+
+        const Tablas &t = tablas();
+        uint32_t macrobloques = 0;
+        bool error = false;
+        // El primer macrobloque va sin incremento de direccion; tras cada uno viene el del siguiente (un codigo no
+        // valido es el codigo de inicio que acaba la imagen).
+        for (bool primero = true;; primero = false)
+        {
+            if (!primero)
+            {
+                int incremento = 0;
+                bool fin = false;
+                for (;;)
+                {
+                    if (bitsAvailable(s) < 24u)
+                    {
+                        fin = true;
+                        break;
+                    }
+                    const VlcEntry &e = t.mbai[peekBits(s, 11)];
+                    if (e.len == 0)
+                    {
+                        fin = true;
+                        break;
+                    }
+                    skipBits(s, e.len);
+                    if (e.level == 34)
+                        incremento += 33;
+                    else if (e.level != 35)
+                    {
+                        incremento += e.level;
+                        break;
+                    }
+                }
+                if (fin)
+                    break;
+                if (incremento > 1)
+                    for (int &p : c.dcPred)
+                        p = reinicioDc;
+            }
+            // macroblock_type de una imagen I: "1" intra, "01" intra con cuantificador.
+            bool quant;
+            if (getBits(s, 1))
+                quant = false;
+            else if (getBits(s, 1))
+                quant = true;
+            else
+            {
+                error = true;
+                break;
+            }
+            bool campo = false;
+            if (dtd)
+                campo = getBits(s, 1) != 0u;
+            if (quant)
+                c.qscaleCode = getBits(s, 5);
+
+            uint8_t y[16][16];
+            uint8_t cb[8][8];
+            uint8_t cr[8][8];
+            int coef[64];
+            bool soloDc = false;
+            for (int b = 0; b < 4 && !error; ++b)
+            {
+                if (!decodeIntraBlock(s, c, 0, coef, soloDc))
+                {
+                    error = true;
+                    break;
+                }
+                uint8_t *dst;
+                int paso;
+                if (!campo)
+                {
+                    dst = &y[(b >> 1) * 8][(b & 1) * 8];
+                    paso = 16;
+                }
+                else
+                {
+                    dst = &y[b >> 1][(b & 1) * 8];
+                    paso = 32;
+                }
+                idctBlock(coef, soloDc, dst, paso);
+            }
+            if (!error && decodeIntraBlock(s, c, 1, coef, soloDc))
+                idctBlock(coef, soloDc, &cb[0][0], 8);
+            else
+                error = true;
+            if (!error && decodeIntraBlock(s, c, 2, coef, soloDc))
+                idctBlock(coef, soloDc, &cr[0][0], 8);
+            else
+                error = true;
+            if (error)
+                break;
+            cscMacroblock(s, y, cb, cr, rgb16, dte);
+            ++macrobloques;
+        }
+        s.ctrl &= ~((1u << 14) | (1u << 15));
+        s.ctrl |= error ? (1u << 14) : (1u << 15); // ECD o SCD
+        if (error && s.mensajesNoSoportada++ < 16u)
+            std::fprintf(stderr, "[ipu] IDEC: flujo no valido tras %u macrobloques (bit %zu de %zu)\n", macrobloques,
+                         s.bitPos, s.in.size() * 8u);
+        static uint32_t s_avisos = 0;
+        if (s_avisos < 8u)
+        {
+            ++s_avisos;
+            std::fprintf(stderr, "[ipu] IDEC: %u macrobloques (ctrl=0x%08x cmd=0x%08x)\n", macrobloques, s.ctrl, cmd);
+        }
+    }
+
+    void loadDefaultsUnlocked(Ipu &s)
+    {
+        for (int i = 0; i < 64; ++i)
+        {
+            s.iqIntra[i] = kDefaultIntraMatrix[kZigzag[i]];
+            s.iqNonIntra[i] = 16;
+        }
+        std::memset(s.vqclut, 0, sizeof(s.vqclut));
+        s.th0 = 0;
+        s.th1 = 0;
+    }
+
+    void resetUnlocked(Ipu &s)
+    {
+        s.in.clear();
+        s.bitPos = 0;
+        s.pendingSkip = 0;
+        s.out.clear();
+        s.outPos = 0;
+        s.cmdResult = 0;
+        s.ctrl = 0;
+    }
+
+    struct Inicio
+    {
+        Inicio() { loadDefaultsUnlocked(ipu()); }
+    } g_inicio;
+}
+
+namespace ps2_ipu
+{
+    void reset()
+    {
+        std::lock_guard<std::mutex> lock(ipuMutex());
+        resetUnlocked(ipu());
+    }
+
+    void loadDefaultTables()
+    {
+        std::lock_guard<std::mutex> lock(ipuMutex());
+        loadDefaultsUnlocked(ipu());
+    }
+
+    void writeCmd(uint32_t value)
+    {
+        std::lock_guard<std::mutex> lock(ipuMutex());
+        Ipu &s = ipu();
+        const uint32_t orden = value >> 28;
+        switch (orden)
+        {
+        case 0x0: // BCLR
+            s.in.clear();
+            s.bitPos = 0;
+            s.pendingSkip = value & 0x7Fu;
+            break;
+        case 0x1: // IDEC
+            idec(s, value);
+            break;
+        case 0x4: // FDEC
+            skipBits(s, value & 0x3Fu);
+            s.cmdResult = peekBits(s, 32);
+            break;
+        case 0x5: // SETIQ
+        {
+            skipBits(s, value & 0x3Fu);
+            uint8_t *iq = ((value >> 27) & 1u) ? s.iqNonIntra : s.iqIntra;
+            for (int i = 0; i < 64; ++i)
+                iq[i] = static_cast<uint8_t>(getBits(s, 8));
+            break;
+        }
+        case 0x6: // SETVQ
+            for (int i = 0; i < 16; ++i)
+            {
+                const uint32_t lo = getBits(s, 8);
+                const uint32_t hi = getBits(s, 8);
+                s.vqclut[i] = static_cast<uint16_t>(lo | (hi << 8));
+            }
+            break;
+        case 0x9: // SETTH
+            s.th0 = value & 0x1FFu;
+            s.th1 = (value >> 16) & 0x1FFu;
+            break;
+        default:
+            if (s.mensajesNoSoportada++ < 16u)
+                std::fprintf(stderr, "[ipu] orden no soportada: IPU_CMD=0x%08x\n", value);
+            break;
+        }
+        compactInput(s);
+    }
+
+    uint32_t readCmd()
+    {
+        std::lock_guard<std::mutex> lock(ipuMutex());
+        return ipu().cmdResult & 0x7FFFFFFFu; // BUSY = 0: las ordenes acaban al escribirlas
+    }
+
+    void writeCtrl(uint32_t value)
+    {
+        std::lock_guard<std::mutex> lock(ipuMutex());
+        Ipu &s = ipu();
+        if (value & (1u << 30))
+            resetUnlocked(s);
+        s.ctrl = (s.ctrl & ((1u << 14) | (1u << 15))) | (value & 0x07FF0000u);
+    }
+
+    uint32_t readCtrl()
+    {
+        std::lock_guard<std::mutex> lock(ipuMutex());
+        const Ipu &s = ipu();
+        const size_t ifc = std::min<size_t>(8u, (bitsAvailable(s) + 127u) / 128u);
+        const size_t ofc = std::min<size_t>(8u, (s.out.size() - s.outPos) / 16u);
+        return (s.ctrl & 0x07FFC000u) | static_cast<uint32_t>(ifc) | (static_cast<uint32_t>(ofc) << 4);
+    }
+
+    uint32_t readBp()
+    {
+        std::lock_guard<std::mutex> lock(ipuMutex());
+        const Ipu &s = ipu();
+        const size_t ifc = std::min<size_t>(8u, (bitsAvailable(s) + 127u) / 128u);
+        return static_cast<uint32_t>(s.bitPos & 0x7Fu) | (static_cast<uint32_t>(ifc) << 8);
+    }
+
+    uint32_t readTop()
+    {
+        std::lock_guard<std::mutex> lock(ipuMutex());
+        return ipu().in.empty() ? 0u : peekBits(ipu(), 32);
+    }
+
+    void pushInput(const uint8_t *data, size_t size)
+    {
+        std::lock_guard<std::mutex> lock(ipuMutex());
+        Ipu &s = ipu();
+        const bool vacia = bitsAvailable(s) == 0u;
+        if (vacia)
+        {
+            s.in.clear();
+            s.bitPos = 0;
+        }
+        s.in.insert(s.in.end(), data, data + size);
+        if (vacia && s.pendingSkip != 0u)
+        {
+            s.bitPos += s.pendingSkip;
+            s.pendingSkip = 0;
+        }
+    }
+
+    size_t outputAvailable()
+    {
+        std::lock_guard<std::mutex> lock(ipuMutex());
+        const Ipu &s = ipu();
+        return s.out.size() - s.outPos;
+    }
+
+    size_t popOutput(uint8_t *dst, size_t size)
+    {
+        std::lock_guard<std::mutex> lock(ipuMutex());
+        Ipu &s = ipu();
+        const size_t n = std::min(size, s.out.size() - s.outPos);
+        std::memcpy(dst, s.out.data() + s.outPos, n);
+        s.outPos += n;
+        if (s.outPos == s.out.size())
+        {
+            s.out.clear();
+            s.outPos = 0;
+        }
+        return n;
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_ipu.h b/ps2xRuntime/src/lib/ps2_ipu.h
new file mode 100644
index 0000000..b36493c
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_ipu.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// IPU del EE (decodificador de imagen: MPEG-1/2 intra, IDCT y conversion YCbCr -> RGB), anadido para F1 06, que
+// decodifica sus videos .ipf con su propio codigo (FDEC + IDEC + DMA de entrada en cadena y de salida normal).
+// Modelo sincrono: el DMA de entrada mete todo en la FIFO de entrada (sin limite de 8 qwords) y cada orden se ejecuta
+// entera al escribir IPU_CMD, dejando su salida en la FIFO de salida para el DMA fromIPU. Ordenes: BCLR, IDEC, FDEC,
+// SETIQ, SETVQ y SETTH (BDEC, VDEC, CSC y PACK no: libmpeg va por el HLE de sceMpeg).
+// Estado global (un solo IPU) para no tocar ps2_memory.h, que incluye el codigo traducido.
+namespace ps2_ipu
+{
+    void reset();             // IPU_CTRL.RST: FIFOs y registros (las tablas se conservan)
+    void loadDefaultTables(); // lo que carga sceIpuInit: matriz intra por defecto, no intra plana, umbrales a 0
+
+    void writeCmd(uint32_t value);
+    uint32_t readCmd();
+    void writeCtrl(uint32_t value);
+    uint32_t readCtrl();
+    uint32_t readBp();
+    uint32_t readTop();
+
+    void pushInput(const uint8_t *data, size_t size);  // IN_FIFO / DMA toIPU (ch4)
+    size_t outputAvailable();                          // bytes en la FIFO de salida
+    size_t popOutput(uint8_t *dst, size_t size);       // OUT_FIFO / DMA fromIPU (ch3)
+}
