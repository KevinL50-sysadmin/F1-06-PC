+namespace
+{
+    // IPU (ps2_ipu.cpp): DMA toIPU (canal 4, normal o en cadena) y fromIPU (canal 3, normal). Las direcciones con el
+    // bit 31 son del scratchpad.
+    const uint8_t *ipuDmaSource(PS2Memory &mem, uint32_t addr, uint32_t bytes)
+    {
+        if (addr & 0x80000000u)
+        {
+            const uint32_t off = addr & 0x3FF0u;
+            return off + bytes <= PS2_SCRATCHPAD_SIZE ? mem.getScratchpad() + off : nullptr;
+        }
+        const uint32_t off = addr & 0x01FFFFF0u;
+        return off + bytes <= PS2_RAM_SIZE ? mem.getRDRAM() + off : nullptr;
+    }
+
+    void ipuDmaFeed(PS2Memory &mem, uint32_t addr, uint32_t qwc)
+    {
+        if (const uint8_t *src = ipuDmaSource(mem, addr, qwc * 16u))
+            ps2_ipu::pushInput(src, qwc * 16u);
+    }
+
+    bool g_ipuFromPending = false; // fromIPU arrancado y aun sin todos sus qwords
+
+    void serviceIpuFromDma(PS2Memory &mem)
+    {
+        auto &m_ioRegisters = mem.m_ioRegisters;
+        static constexpr uint32_t kFromIpu = 0x1000B000u;
+        // Solo con g_ipuFromPending: leer CHCR borra STR en este runtime aunque el canal siga pendiente.
+        if (!g_ipuFromPending)
+            return;
+        uint32_t madr = m_ioRegisters[kFromIpu + 0x10u];
+        uint32_t qwc = m_ioRegisters[kFromIpu + 0x20u] & 0xFFFFu;
+        while (qwc != 0u && ps2_ipu::outputAvailable() >= 16u)
+        {
+            const uint32_t n = std::min<uint32_t>(qwc, static_cast<uint32_t>(ps2_ipu::outputAvailable() / 16u));
+            uint8_t *dst = const_cast<uint8_t *>(ipuDmaSource(mem, madr, n * 16u));
+            if (!dst)
+                break;
+            ps2_ipu::popOutput(dst, n * 16u);
+            madr += n * 16u;
+            qwc -= n;
+        }
+        m_ioRegisters[kFromIpu + 0x10u] = madr;
+        m_ioRegisters[kFromIpu + 0x20u] = qwc;
+        if (qwc == 0u)
+        {
+            g_ipuFromPending = false;
+            mem.completeDmacChannel(kFromIpu, 3u);
+        }
+    }
+
+    bool tryProcessIpuDma(PS2Memory &mem, uint32_t channelBase, uint32_t chcr)
+    {
+        auto &m_ioRegisters = mem.m_ioRegisters;
+        static constexpr uint32_t kFromIpu = 0x1000B000u;
+        static constexpr uint32_t kToIpu = 0x1000B400u;
+        if (channelBase == kFromIpu)
+        {
+            g_ipuFromPending = true;
+            serviceIpuFromDma(mem);
+            return true;
+        }
+        if (channelBase != kToIpu)
+            return false;
+
+        const uint32_t mode = (chcr >> 2u) & 0x3u;
+        uint32_t madr = m_ioRegisters[kToIpu + 0x10u];
+        const uint32_t qwc = m_ioRegisters[kToIpu + 0x20u] & 0xFFFFu;
+        if (qwc != 0u)
+        {
+            ipuDmaFeed(mem, madr, qwc);
+            madr += qwc * 16u;
+        }
+        if (mode == 1u) // cadena de origen
+        {
+            uint32_t tadr = m_ioRegisters[kToIpu + 0x30u];
+            uint32_t asr[2] = {};
+            uint32_t asrCount = 0u;
+            for (int guard = 0; guard < 65536; ++guard)
+            {
+                const uint8_t *tagPtr = ipuDmaSource(mem, tadr, 16u);
+                if (!tagPtr)
+                    break;
+                uint64_t tag = 0;
+                std::memcpy(&tag, tagPtr, sizeof(tag));
+                const uint32_t tagQwc = static_cast<uint32_t>(tag & 0xFFFFu);
+                const uint32_t id = static_cast<uint32_t>((tag >> 28) & 0x7u);
+                const bool irq = ((tag >> 31) & 1u) != 0u;
+                const uint32_t addr = static_cast<uint32_t>((tag >> 32) & 0xFFFFFFF0u);
+                bool fin = false;
+                switch (id)
+                {
+                case 0: // refe
+                    ipuDmaFeed(mem, addr, tagQwc);
+                    madr = addr + tagQwc * 16u;
+                    tadr += 16u;
+                    fin = true;
+                    break;
+                case 1: // cnt
+                    ipuDmaFeed(mem, tadr + 16u, tagQwc);
+                    madr = tadr + 16u + tagQwc * 16u;
+                    tadr = madr;
