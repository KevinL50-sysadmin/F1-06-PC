diff --git a/ps2xRuntime/src/lib/ps2_options.cpp b/ps2xRuntime/src/lib/ps2_options.cpp
index 02a48af..4d3a06d 100644
--- a/ps2xRuntime/src/lib/ps2_options.cpp
+++ b/ps2xRuntime/src/lib/ps2_options.cpp
@@ -507,6 +507,33 @@ namespace ps2x
         return settings;
     }
 
+    std::vector<std::pair<std::string, std::string>> takeEnvironmentArguments(std::vector<std::string> &arguments)
+    {
+        const auto nameChar = [](char c, bool first)
+        {
+            return (c >= 'A' && c <= 'Z') || c == '_' || (!first && c >= '0' && c <= '9');
+        };
+        std::vector<std::pair<std::string, std::string>> variables;
+        std::vector<std::string> rest;
+        bool leading = true; // only before the first other word: a value ("--clave Clave=...") is never one
+        for (std::string &argument : arguments)
+        {
+            if (argument == "%command%")
+                continue;
+            const size_t equals = argument.find('=');
+            bool name = leading && equals != std::string::npos && equals > 0u;
+            for (size_t i = 0u; name && i < equals; ++i)
+                name = nameChar(argument[i], i == 0u);
+            leading = leading && name;
+            if (name)
+                variables.emplace_back(argument.substr(0u, equals), argument.substr(equals + 1u));
+            else
+                rest.push_back(std::move(argument));
+        }
+        arguments = std::move(rest);
+        return variables;
+    }
+
