+            if ((flags & 0x2u) != 0u)
+                mac |= lane << 4;
+            if ((flags & 0x4u) != 0u)
+                mac |= lane << 8;
+            if ((flags & 0x8u) != 0u)
+                mac |= lane << 12;
+            status |= flags;
+        }
+    }
