+            case FmacAdd: value = a[lane] + b[lane]; exact = la + lb; break;
+            case FmacSub: value = a[lane] - b[lane]; exact = la - lb; break;
+            case FmacMul:
+            case FmacOpmula: value = a[lane] * b[lane]; exact = la * lb; break;
+            case FmacMadd: value = c[lane] + a[lane] * b[lane]; exact = static_cast<long double>(c[lane]) + la * lb; break;
