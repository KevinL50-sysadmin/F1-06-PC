+        c.small = static_cast<uint32_t>(_mm_movemask_pd(_mm_cmplt_pd(absLow, minimum)) |
+                                        (_mm_movemask_pd(_mm_cmplt_pd(absHigh, minimum)) << 2));
+        c.big = static_cast<uint32_t>(_mm_movemask_pd(_mm_cmpgt_pd(absLow, maximum)) |
+                                      (_mm_movemask_pd(_mm_cmpgt_pd(absHigh, maximum)) << 2));
+        return c;
+    }
