+    struct ExactClass
+    {
+        uint32_t sign;
+        uint32_t zero;
+        uint32_t small;
+        uint32_t big;
+    };
+
+    inline ExactClass classifyExact(__m128d low, __m128d high)
+    {
+        const __m128d absMask = _mm_castsi128_pd(_mm_set1_epi64x(0x7FFFFFFFFFFFFFFFll));
+        const __m128d maximum = _mm_set1_pd(static_cast<double>(std::numeric_limits<float>::max()));
+        const __m128d minimum = _mm_set1_pd(static_cast<double>(std::numeric_limits<float>::min()));
+        const __m128d zero = _mm_setzero_pd();
+        const __m128d absLow = _mm_and_pd(low, absMask);
+        const __m128d absHigh = _mm_and_pd(high, absMask);
+        ExactClass c;
+        c.sign = static_cast<uint32_t>(_mm_movemask_pd(low) | (_mm_movemask_pd(high) << 2));
+        c.zero = static_cast<uint32_t>(_mm_movemask_pd(_mm_cmpeq_pd(absLow, zero)) |
