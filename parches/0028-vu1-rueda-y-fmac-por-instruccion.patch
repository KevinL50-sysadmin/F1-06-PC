+    inline void fmacFlagsFromLanes(const uint8_t laneFlags[4], uint8_t components, uint32_t &mac, uint32_t &status)
+    {
+        mac = 0u;
+        status = 0u;
+        for (uint32_t component = 0; component < 4u; ++component)
