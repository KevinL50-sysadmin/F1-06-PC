+    // vuNormalizeOperand on four lanes.
+    inline __m128 normalize4(__m128 value)
+    {
+        const __m128i bits = _mm_castps_si128(value);
+        const __m128i exponentMask = _mm_set1_epi32(0x7F800000);
+        const __m128i sign = _mm_and_si128(bits, _mm_set1_epi32(static_cast<int>(0x80000000u)));
+        const __m128i exponent = _mm_and_si128(bits, exponentMask);
+        const __m128i zeroExponent = _mm_cmpeq_epi32(exponent, _mm_setzero_si128());
+        const __m128i maxExponent = _mm_cmpeq_epi32(exponent, exponentMask);
+        __m128i result = _mm_andnot_si128(_mm_or_si128(zeroExponent, maxExponent), bits);
+        result = _mm_or_si128(result, _mm_and_si128(zeroExponent, sign));
+        result = _mm_or_si128(result, _mm_and_si128(maxExponent, _mm_or_si128(sign, _mm_set1_epi32(0x7F7FFFFF))));
+        return _mm_castsi128_ps(result);
+    }
