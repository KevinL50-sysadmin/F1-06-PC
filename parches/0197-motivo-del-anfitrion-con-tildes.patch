+        // The length of the valid UTF-8 sequence at i (2-4 bytes: no overlong forms, surrogates or past U+10FFFF), or 0.
+        const auto letter = [&](size_t i) -> size_t
+        {
+            const auto at = [&](size_t k) { return static_cast<unsigned char>(text[k]); };
+            const unsigned char b = at(i);
+            size_t size = 0;
+            unsigned char low = 0x80, high = 0xBF;
+            if (b >= 0xC2 && b <= 0xDF)
+                size = 2;
+            else if (b >= 0xE0 && b <= 0xEF)
+            {
+                size = 3;
+                low = b == 0xE0 ? 0xA0 : 0x80;
+                high = b == 0xED ? 0x9F : 0xBF;
+            }
+            else if (b >= 0xF0 && b <= 0xF4)
+            {
+                size = 4;
+                low = b == 0xF0 ? 0x90 : 0x80;
+                high = b == 0xF4 ? 0x8F : 0xBF;
+            }
+            if (size == 0 || i + size > text.size() || at(i + 1) < low || at(i + 1) > high)
+                return 0;
+            for (size_t k = 2; k < size; ++k)
+                if (at(i + k) < 0x80 || at(i + k) > 0xBF)
+                    return 0;
+            return size;
+        };
+        std::string clean;
+        for (size_t i = 0; i < text.size();)
+        {
+            const unsigned char b = static_cast<unsigned char>(text[i]);
+            if (const size_t size = b >= 0x80 ? letter(i) : 0; size > 0)
+            {
+                clean.append(text.substr(i, size));
+                i += size;
+                continue;
+            }
+            clean += b >= 0x20 && b < 0x7F ? static_cast<char>(b) : '?';
+            ++i;
+        }
+        if (clean.size() <= maxSize)
+            return clean;
+        size_t cut = maxSize > 3u ? maxSize - 3u : maxSize;
+        while (cut > 0 && (static_cast<unsigned char>(clean[cut]) & 0xC0u) == 0x80u)
+            --cut; // back to the start of the letter the cut falls in
+        clean.resize(cut);
+        if (maxSize > 3u)
+            clean += "...";
+        return clean;
     }
 
