+    // Debug: F1_GS_CONTAR=<64-bit value in hex>[,<another>] counts the GIF packets holding that value (and the other
+    // one, if given; each at any 8-byte position) and prints the count of each 10 s ("[gs:contar]").
+    void countValuePackets(const uint8_t *data, uint32_t sizeBytes)
+    {
+        static const std::pair<uint64_t, uint64_t> s_values = []
+        {
+            const char *value = std::getenv("F1_GS_CONTAR");
+            if (value == nullptr)
+                return std::make_pair(0ull, 0ull);
+            char *end = nullptr;
+            const uint64_t first = std::strtoull(value, &end, 16);
+            const uint64_t second = end != nullptr && *end == ',' ? std::strtoull(end + 1, nullptr, 16) : 0ull;
+            return std::make_pair(static_cast<unsigned long long>(first), static_cast<unsigned long long>(second));
+        }();
+        const uint64_t s_value = s_values.first;
+        if (s_value == 0u)
+            return;
+        static uint64_t s_count = 0u;
+        static auto s_reportAt = std::chrono::steady_clock::now();
+        static const auto s_start = s_reportAt;
+        bool first = false, second = s_values.second == 0u;
+        for (uint32_t at = 0; at + 8u <= sizeBytes; at += 8u)
+        {
+            const uint64_t word = loadLE64(data + at);
+            first = first || word == s_value;
+            second = second || word == s_values.second;
+        }
+        static std::map<uint32_t, uint64_t> s_alphas; // the alpha of the first A+D RGBAQ of the packets counted
+        if (first && second)
+        {
+            ++s_count;
+            for (uint32_t at = 16u; at + 16u <= sizeBytes; at += 16u)
+                if (loadLE64(data + at + 8u) == GS_REG_RGBAQ)
+                {
+                    ++s_alphas[static_cast<uint32_t>((loadLE64(data + at) >> 24u) & 0xFFu)];
+                    break;
+                }
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (now - s_reportAt >= std::chrono::seconds(10))
+        {
+            s_reportAt = now;
+            std::fprintf(stderr, "[gs:contar] t=%.0f s: %llu paquetes con %llx\n",
+                         std::chrono::duration<double>(now - s_start).count(), static_cast<unsigned long long>(s_count),
+                         static_cast<unsigned long long>(s_value));
+            for (const auto &alpha : s_alphas)
+                std::fprintf(stderr, "[gs:contar]   RGBAQ A=%02x: %llu\n", alpha.first,
+                             static_cast<unsigned long long>(alpha.second));
+            s_alphas.clear();
+            s_count = 0u;
+        }
+    }
