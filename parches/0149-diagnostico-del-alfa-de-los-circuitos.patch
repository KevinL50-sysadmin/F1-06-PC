+    // F1_GS_GPU_TRAZA=x,y,seconds[,packets] (diagnosis, very slow while it runs): from that many seconds after the
+    // GPU GS starts, for that many GIF packets (default 20000), reads local memory back after each packet and prints
+    // every change of the PSMCT32 pixel (x, y) of the buffers at FBP 0 and 128 (width 512), with the packet's
+    // A+D registers and its last RGBAQ.
+    struct PixelTrace
+    {
+        bool on = false;
+        uint32_t x = 0u, y = 0u;
+        int64_t startNs = 0;
+        uint32_t packetsLeft = 0u;
+        uint32_t packetIndex = 0u;
+        uint32_t last[2] = {};
+        bool primed = false;
+        std::vector<uint8_t> copy;
+        GSCpuBackend reader;
+    };
+    PixelTrace trace;
+
+    void configureTrace()
+    {
+        const char *text = std::getenv("F1_GS_GPU_TRAZA");
+        if (text == nullptr)
+            return;
+        unsigned x = 0u, y = 0u, packets = 20000u;
+        double seconds = 0.0;
+        if (std::sscanf(text, "%u,%u,%lf,%u", &x, &y, &seconds, &packets) < 3)
+            return;
+        trace.on = true;
+        trace.x = x;
+        trace.y = y;
+        trace.startNs = nowNs() + static_cast<int64_t>(seconds * 1e9);
+        trace.packetsLeft = packets;
+    }
+
+    static std::string describePacket(const uint8_t *data, uint32_t size)
+    {
+        std::string text;
+        char item[96];
+        uint32_t offset = 0u;
+        uint64_t rgbaq = 0u;
+        bool hasRgbaq = false;
+        while (offset + 16u <= size)
+        {
+            uint64_t lo = 0u, hi = 0u;
+            std::memcpy(&lo, data + offset, 8u);
+            std::memcpy(&hi, data + offset + 8u, 8u);
+            offset += 16u;
+            const uint32_t nloop = static_cast<uint32_t>(lo & 0x7FFFu);
+            const uint32_t flg = static_cast<uint32_t>((lo >> 58u) & 3u);
+            uint32_t nreg = static_cast<uint32_t>((lo >> 60u) & 0xFu);
+            if (nreg == 0u)
+                nreg = 16u;
+            if (((lo >> 46u) & 1u) != 0u)
+            {
+                std::snprintf(item, sizeof(item), " PRE=0x%llx", static_cast<unsigned long long>((lo >> 47u) & 0x7FFu));
+                text += item;
+            }
+            if (flg == 0u)
+            {
+                for (uint32_t i = 0; i < nloop * nreg && offset + 16u <= size; ++i, offset += 16u)
+                {
+                    const uint32_t reg = static_cast<uint32_t>((hi >> ((i % nreg) * 4u)) & 0xFu);
+                    uint64_t vlo = 0u, vhi = 0u;
+                    std::memcpy(&vlo, data + offset, 8u);
+                    std::memcpy(&vhi, data + offset + 8u, 8u);
+                    if (reg == 0xEu)
+                    {
+                        std::snprintf(item, sizeof(item), " %02llx=%llx", static_cast<unsigned long long>(vhi & 0xFFu),
+                                      static_cast<unsigned long long>(vlo));
+                        text += item;
+                    }
+                    else if (reg == 0x1u)
+                    {
+                        rgbaq = (vlo & 0xFFu) | (((vlo >> 32u) & 0xFFu) << 8u) | ((vhi & 0xFFu) << 16u) |
+                                (((vhi >> 32u) & 0xFFu) << 24u);
+                        hasRgbaq = true;
+                    }
+                }
+            }
+            else if (flg == 1u)
+                offset += ((nloop * nreg + 1u) / 2u) * 16u;
+            else
+            {
+                std::snprintf(item, sizeof(item), " IMAGE(%u qw)", nloop);
+                text += item;
+                offset += nloop * 16u;
+            }
+        }
+        if (hasRgbaq)
+        {
+            std::snprintf(item, sizeof(item), " rgba=%llx", static_cast<unsigned long long>(rgbaq));
+            text += item;
+        }
+        return text;
+    }
+
+    void tracePixel(const uint8_t *data, uint32_t size)
+    {
+        if (!trace.on || trace.packetsLeft == 0u || nowNs() < trace.startNs)
+            return;
+        const void *mapped = api.map_vram_read(context, 0u, kVramSize);
+        if (mapped == nullptr)
+            return;
+        if (trace.copy.empty())
+        {
+            trace.copy.resize(kVramSize);
+            trace.reader.Initialize(trace.copy.data(), static_cast<uint32_t>(kVramSize));
+        }
+        std::memcpy(trace.copy.data(), mapped, kVramSize);
+        ++trace.packetIndex;
+        --trace.packetsLeft;
+        for (int b = 0; b < 2; ++b)
+        {
+            const uint32_t fbp = b == 0 ? 0u : 128u;
+            const uint32_t value = trace.reader.ReadVram(GS_PSM_CT32, fbp * 32u, 8u, trace.x, trace.y);
+            if (trace.primed && value == trace.last[b])
+                continue;
+            std::fprintf(stderr, "[gs:traza] paquete %u fbp=%u (%u,%u) %08x -> %08x (A %02x -> %02x) |%s\n",
+                         trace.packetIndex, fbp, trace.x, trace.y, trace.last[b], value, trace.last[b] >> 24u,
+                         value >> 24u, describePacket(data, size).c_str());
+            trace.last[b] = value;
+        }
+        trace.primed = true;
+        if (trace.packetsLeft == 0u)
+            std::fprintf(stderr, "[gs:traza] fin (%u paquetes)\n", trace.packetIndex);
+    }
