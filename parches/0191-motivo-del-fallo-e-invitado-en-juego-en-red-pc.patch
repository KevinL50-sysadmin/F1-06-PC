index a0bde17..1b43a7c 100644
--- a/ps2xRuntime/include/ps2_options_menu.h
+++ b/ps2xRuntime/include/ps2_options_menu.h
@@ -133,6 +133,20 @@ namespace ps2x
         return mode != UserPathsMode::Development;
     }
 
+    // Nativizacion T14: a text of the host for the game's OPTIONS > PC NETPLAY page (the reason a start failed, the
+    // guest's address), which its Lua reads one character code at a time: printable ASCII (anything else is ?) and at
+    // most maxSize characters (a longer one ends in ...).
+    constexpr size_t kNetplayPageTextSize = 96;
+    inline std::string netplayPageText(std::string_view text, size_t maxSize)
+    {
+        std::string out;
+        for (const char c : text.substr(0, maxSize))
+            out += c >= 0x20 && c < 0x7F ? c : '?';
+        if (text.size() > maxSize && maxSize > 3u)
+            out.replace(maxSize - 3u, 3u, "...");
+        return out;
+    }
+
     // PS2X_MENU_GUION (tests): "<seconds>:<action>,..." from the first frame of the window. Actions: abrir, cerrar,
     // guardar, descartar, defecto, seccion=<pantalla|graficos|sonido|juego>, tecla=<arriba|abajo|izquierda|derecha|
     // aceptar>, foto (a photo, as tecla_foto) or <option>=<value> (as the menu sets it). PS2X_MENU_PETICION=<file>: the actions written in that file
@@ -207,13 +221,16 @@ public:
     // Nativizacion T6 (OPTIONS > PC NETPLAY): red_puerto, red_calidad and red_publicas do not change through the three
     // functions above nor setGameOptionNumber while the host runs or is asked to start (ps2x::netplayOptionLocked).
     // The page's read-only rows: the host's state (ps2x::netplay::HostPageState as a number), its port and the IPv4
-    // addresses a guest can connect to. A start or stop asked for (red_anfitrion) is taken by update() on the main
-    // thread: this waits up to waitMs for it first.
+    // addresses a guest can connect to; T14: why the last start failed (only in that state) and the connected guest's
+    // address (only while connected), as ps2x::netplayPageText. A start or stop asked for (red_anfitrion) is taken by
+    // update() on the main thread: this waits up to waitMs for it first.
     struct GameNetplayState
     {
         int state = 0;
         int port = 0;
         std::vector<std::array<int, 4>> addresses;
+        std::string reason;
+        std::string guest;
     };
     static GameNetplayState gameNetplayState(int waitMs);
 
