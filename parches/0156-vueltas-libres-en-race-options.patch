 // Phase 3 (T3): the in-game options menu. Its pure parts: rewriting opciones.ini, the menu's values and the variables
 // that fix some of them, the pad combo that opens it, the guest's input while it is open and the debug panel's mode.
@@ -442,4 +447,82 @@ void register_ps2_options_menu_tests()
             t.IsTrue(ps2x::parseMenuScript("").empty(), "empty: no steps");
         });
     });
+
+    // Fase 5 (T10): any number of laps in RACE OPTIONS, stored as the game's own race distance.
+    MiniTest::Case("RaceLaps", [](TestCase &tc)
+    {
+        tc.Run("raceLapsForDistance gives the game's laps: ceil(GP laps * distance), 0.05 = 3 laps, at most the GP",
+               [](TestCase &t)
+        {
+            t.Equals(ps2x::raceLapsForDistance(60, 0.1f), 6, "Silverstone at 10 %: 6 laps");
+            t.Equals(ps2x::raceLapsForDistance(78, 0.1f), 8, "Monaco at 10 %: 7.8 rounds up to 8");
+            t.Equals(ps2x::raceLapsForDistance(53, 0.75f), 40, "Monza at 75 %: 39.75 rounds up to 40");
+            t.Equals(ps2x::raceLapsForDistance(60, 0.05f), 3, "the shortest setting is 3 laps");
+            t.Equals(ps2x::raceLapsForDistance(70, 0.05f), 3, "3 laps on any circuit");
+            t.Equals(ps2x::raceLapsForDistance(60, 1.0f), 60, "the whole Grand Prix");
+            t.Equals(ps2x::raceLapsForDistance(60, 2.0f), 60, "never more than the Grand Prix");
+        });
+
+        tc.Run("raceDistanceForLaps gives every lap count of every circuit, also after the profile's %f", [](TestCase &t)
+        {
+            int wrong = 0, wrongText = 0, wrongRange = 0;
+            for (int full = 1; full <= 120; ++full)
+            {
+                for (int laps = 1; laps <= full; ++laps)
+                {
+                    const float distance = ps2x::raceDistanceForLaps(full, laps);
+                    if (ps2x::raceLapsForDistance(full, distance) != laps)
+                        ++wrong;
+                    if (!(distance > 0.0f && distance <= 1.0f) || ((distance == 1.0f) != (laps == full)))
+                        ++wrongRange;
+                    char text[32];
+                    std::snprintf(text, sizeof(text), "%f", static_cast<double>(distance));
+                    if (ps2x::raceLapsForDistance(full, std::strtof(text, nullptr)) != laps)
+                        ++wrongText;
+                }
+            }
+            t.Equals(wrong, 0, "the game turns each distance back into its laps");
+            t.Equals(wrongText, 0, "also when written with %f and read again");
+            t.Equals(wrongRange, 0, "between 0 and 1, and 1 only for the whole Grand Prix");
+            t.Equals(ps2x::raceLapsForDistance(70, ps2x::raceDistanceForLaps(70, 4)), 4,
+                     "4 of 70 laps does not fall on 0.05 (3 laps)");
+            t.Equals(ps2x::raceDistanceForLaps(60, 0), ps2x::raceDistanceForLaps(60, 1), "0 laps: 1 lap");
+            t.Equals(ps2x::raceDistanceForLaps(60, 61), 1.0f, "more than the Grand Prix: the Grand Prix");
+            t.Equals(ps2x::raceDistanceForLaps(0, 5), 0.0f, "unknown circuit: 0");
+        });
+
+        tc.Run("trackFullLaps reads the circuit's Grand Prix laps from the game's circuit list", [](TestCase &t)
+        {
+            std::vector<uint8_t> ram(0x00600000u, 0u);
+            auto put = [&ram](uint32_t address, uint32_t value) { std::memcpy(ram.data() + address, &value, 4); };
+            const uint32_t list = 0x004F2D40u;
+            const uint32_t laps[3] = {57u, 56u, 60u};
+            for (uint32_t i = 0; i < 3u; ++i)
+            {
+                const uint32_t record = 0x0050ACD0u + i * 0x2D0u;
+                put(list + i * 4u, record);
+                put(record + 0x40u, laps[i]);
+            }
+            put(0x004A1068u, list);
+            put(0x004A106Cu, list + 12u);
+            const uint32_t size = static_cast<uint32_t>(ram.size());
+            t.Equals(ps2x::trackFullLaps(ram.data(), size, 1), 57, "circuit 1");
+            t.Equals(ps2x::trackFullLaps(ram.data(), size, 3), 60, "circuit 3");
+            t.Equals(ps2x::trackFullLaps(ram.data(), size, 0), 0, "no circuit 0");
+            t.Equals(ps2x::trackFullLaps(ram.data(), size, 4), 0, "past the end of the list");
+            put(0x00500000u + 0x40u, 0u);
+            put(list + 4u, 0x80000000u | 0x00500000u);
+            t.Equals(ps2x::trackFullLaps(ram.data(), size, 2), 0, "a record with 0 laps: unknown");
+            put(list + 4u, 0u);
+            t.Equals(ps2x::trackFullLaps(ram.data(), size, 2), 0, "no record");
+            put(list + 4u, 0x01FFFFF0u);
+            t.Equals(ps2x::trackFullLaps(ram.data(), size, 2), 0, "a record outside the RAM");
+            put(0x004A106Cu, list);
+            t.Equals(ps2x::trackFullLaps(ram.data(), size, 1), 0, "an empty list (not loaded yet)");
+            put(0x004A1068u, 0u);
+            put(0x004A106Cu, 0x00400000u);
+            t.Equals(ps2x::trackFullLaps(ram.data(), size, 1), 0, "a list that is not one");
+            t.Equals(ps2x::trackFullLaps(nullptr, 0u, 1), 0, "no RAM");
+        });
+    });
 }
