diff --git a/ps2xRuntime/src/lib/ps2_race_laps.h b/ps2xRuntime/src/lib/ps2_race_laps.h
new file mode 100644
index 0000000..adea7b4
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_race_laps.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+// Fase 5 (T10, F1 06): any number of laps in RACE OPTIONS. The game keeps the race distance as a fraction of the
+// Grand Prix (game.racedistance, a float per options mode in the options singleton *0x49ED94 + 0x7C + mode * 8, saved
+// with the profile) and turns it into laps when the race starts; RACE OPTIONS only offers 3 laps, 10, 20, 30, 50 and
+// 75 % and the whole race. Writing the distance that gives the chosen laps keeps the rest of the game unchanged.
+namespace ps2x
+{
+    // The game's laps for a distance (func_1E5150, called by the race, the HUD and the strategy): 0.05 is the 3 laps
+    // setting; anything else is ceil(GP laps * distance), never more than the Grand Prix.
+    inline int raceLapsForDistance(int fullLaps, float distance)
+    {
+        if (distance == 0.05f)
+            return 3;
+        const int laps = static_cast<int>(std::ceil(static_cast<float>(fullLaps) * distance));
+        return laps < fullLaps ? laps : fullLaps;
+    }
+
+    // The distance that gives those laps (1 to the Grand Prix): (laps - 0.5) / GP laps, half a lap away from both
+    // roundings (it survives the profile's "%f"), 1 for the whole Grand Prix. 0 if the circuit is unknown.
+    inline float raceDistanceForLaps(int fullLaps, int laps)
+    {
+        if (fullLaps <= 0)
+            return 0.0f;
+        if (laps < 1)
+            laps = 1;
+        if (laps >= fullLaps)
+            return 1.0f;
+        const float distance = (static_cast<float>(laps) - 0.5f) / static_cast<float>(fullLaps);
+        if (std::fabs(distance - 0.05f) < 1e-4f) // the 3 laps setting, also once written with "%f" (4 of 70 laps)
+            return (static_cast<float>(laps) - 0.4f) / static_cast<float>(fullLaps);
+        return distance;
+    }
+
+    // The Grand Prix laps of a circuit (game.track(): 1 to 18, 19 the classic one) from the guest's RAM; 0 if unknown.
+    // The circuit list (the one game.trackinfo reads) is a vector of record pointers at 0x4A1068 (begin, end); the
+    // record's +0x40 is its laps (the race reads the same field through *0x49F1E8 + 0x57C).
+    inline int trackFullLaps(const uint8_t *ram, uint32_t ramSize, int track)
+    {
+        constexpr uint32_t kCircuitList = 0x004A1068u;
+        constexpr uint32_t kLapsField = 0x40u;
+        auto read = [ram, ramSize](uint32_t address, uint32_t &value)
+        {
+            address &= 0x01FFFFFFu;
+            if (ram == nullptr || ramSize < 4u || address > ramSize - 4u)
+                return false;
+            std::memcpy(&value, ram + address, sizeof(value));
+            return true;
+        };
+        uint32_t begin = 0u, end = 0u, record = 0u, laps = 0u;
+        if (track < 1 || !read(kCircuitList, begin) || !read(kCircuitList + 4u, end) || begin == 0u || end < begin ||
+            (end - begin) % 4u != 0u || (end - begin) / 4u > 64u || static_cast<uint32_t>(track) > (end - begin) / 4u)
+            return 0;
+        if (!read(begin + static_cast<uint32_t>(track - 1) * 4u, record) || record == 0u ||
+            !read(record + kLapsField, laps) || laps < 1u || laps > 200u)
+            return 0;
+        return static_cast<int>(laps);
+    }
+}
diff --git a/ps2xTest/src/ps2_options_menu_tests.cpp b/ps2xTest/src/ps2_options_menu_tests.cpp
