+    struct Named
+    {
+        const char *name;
+        int code;
+    };
+
+    int keyCode(const std::string &name)
+    {
+        static const Named kKeys[] = {
+            {"ARRIBA", KEY_UP}, {"ABAJO", KEY_DOWN}, {"IZQUIERDA", KEY_LEFT}, {"DERECHA", KEY_RIGHT},
+            {"ESPACIO", KEY_SPACE}, {"INTRO", KEY_ENTER}, {"TAB", KEY_TAB}, {"ESC", KEY_ESCAPE},
+            {"RETROCESO", KEY_BACKSPACE}, {"MAYUS_IZQ", KEY_LEFT_SHIFT}, {"MAYUS_DER", KEY_RIGHT_SHIFT},
+            {"CTRL_IZQ", KEY_LEFT_CONTROL}, {"CTRL_DER", KEY_RIGHT_CONTROL}, {"ALT_IZQ", KEY_LEFT_ALT},
+            {"ALT_DER", KEY_RIGHT_ALT}};
+        for (const Named &k : kKeys)
+            if (name == k.name)
+                return k.code;
+        if (name.size() == 1u && name[0] >= 'A' && name[0] <= 'Z')
+            return KEY_A + (name[0] - 'A');
+        if (name.size() == 1u && name[0] >= '0' && name[0] <= '9')
+            return KEY_ZERO + (name[0] - '0');
+        if (name.size() == 4u && name.compare(0, 3, "NUM") == 0 && name[3] >= '0' && name[3] <= '9')
+            return KEY_KP_0 + (name[3] - '0');
+        return -1;
+    }
+
+    bool parseSource(const std::string &text, Source &out)
+    {
+        const size_t colon = text.find(':');
+        if (colon == std::string::npos)
+            return false;
+        std::string device = text.substr(0, colon);
+        std::string what = text.substr(colon + 1u);
+        for (char &c : device)
+            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        for (char &c : what)
+            c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+        if (device == "tecla")
+        {
+            out.kind = SourceKind::Key;
+            out.code = keyCode(what);
+            return out.code >= 0;
+        }
+        if (device == "mando")
+        {
+            static const Named kButtons[] = {
+                {"A", GAMEPAD_BUTTON_RIGHT_FACE_DOWN}, {"B", GAMEPAD_BUTTON_RIGHT_FACE_RIGHT},
+                {"X", GAMEPAD_BUTTON_RIGHT_FACE_LEFT}, {"Y", GAMEPAD_BUTTON_RIGHT_FACE_UP},
+                {"LB", GAMEPAD_BUTTON_LEFT_TRIGGER_1}, {"RB", GAMEPAD_BUTTON_RIGHT_TRIGGER_1},
+                {"LS", GAMEPAD_BUTTON_LEFT_THUMB}, {"RS", GAMEPAD_BUTTON_RIGHT_THUMB},
+                {"BACK", GAMEPAD_BUTTON_MIDDLE_LEFT}, {"START", GAMEPAD_BUTTON_MIDDLE_RIGHT},
+                {"ARRIBA", GAMEPAD_BUTTON_LEFT_FACE_UP}, {"ABAJO", GAMEPAD_BUTTON_LEFT_FACE_DOWN},
+                {"IZQUIERDA", GAMEPAD_BUTTON_LEFT_FACE_LEFT}, {"DERECHA", GAMEPAD_BUTTON_LEFT_FACE_RIGHT}};
+            for (const Named &b : kButtons)
+                if (what == b.name)
+                {
+                    out.kind = SourceKind::PadButton;
+                    out.code = b.code;
+                    return true;
+                }
+            if (what == "LT" || what == "RT")
+            {
+                out.kind = SourceKind::PadTrigger;
+                out.code = what == "LT" ? GAMEPAD_AXIS_LEFT_TRIGGER : GAMEPAD_AXIS_RIGHT_TRIGGER;
+                return true;
+            }
+            static const Named kAxes[] = {{"LX", GAMEPAD_AXIS_LEFT_X}, {"LY", GAMEPAD_AXIS_LEFT_Y},
+                                          {"RX", GAMEPAD_AXIS_RIGHT_X}, {"RY", GAMEPAD_AXIS_RIGHT_Y}};
+            if (what.size() == 3u && (what[2] == '+' || what[2] == '-'))
+                for (const Named &a : kAxes)
+                    if (what.compare(0, 2, a.name) == 0)
+                    {
+                        out.kind = SourceKind::PadAxis;
+                        out.code = a.code;
+                        out.mode = what[2];
+                        return true;
+                    }
+            return false;
+        }
+        if (device == "volante")
+        {
+            if (what.size() >= 2u && what[0] == 'B' && std::isdigit(static_cast<unsigned char>(what[1])))
+            {
+                const int n = std::atoi(what.c_str() + 1);
+                if (n < 1 || n > 128)
+                    return false;
+                out.kind = SourceKind::WheelButton;
+                out.code = n - 1;
+                return true;
+            }
+            static const Named kPov[] = {{"POV_ARRIBA", 0}, {"POV_DERECHA", 9000}, {"POV_ABAJO", 18000},
+                                         {"POV_IZQUIERDA", 27000}};
+            for (const Named &p : kPov)
+                if (what == p.name)
+                {
+                    out.kind = SourceKind::WheelPov;
+                    out.code = p.code;
+                    return true;
+                }
+            static const char *const kWheelAxes[] = {"X", "Y", "Z", "RX", "RY", "RZ", "S0", "S1"};
+            if (what.size() >= 2u)
+            {
+                const char mode = what.back();
+                const std::string name = what.substr(0, what.size() - 1u);
+                if (mode == '+' || mode == '-' || mode == '~' || mode == '=')
+                    for (int i = 0; i < 8; ++i)
+                        if (name == kWheelAxes[i])
+                        {
+                            out.kind = SourceKind::WheelAxis;
+                            out.code = i;
+                            out.mode = mode;
+                            return true;
+                        }
+            }
+            return false;
+        }
+        return false;
+    }
+
+    std::string trim(const std::string &s)
+    {
+        size_t a = 0u, b = s.size();
+        while (a < b && std::isspace(static_cast<unsigned char>(s[a])))
+            ++a;
+        while (b > a && std::isspace(static_cast<unsigned char>(s[b - 1u])))
+            --b;
+        return s.substr(a, b - a);
+    }
+
+    void parseConfig(const std::string &text, Config &cfg)
+    {
+        std::istringstream in(text);
+        std::string line;
+        int lineNumber = 0;
+        while (std::getline(in, line))
+        {
+            ++lineNumber;
+            const size_t hash = line.find('#');
+            if (hash != std::string::npos)
+                line.resize(hash);
+            const size_t eq = line.find('=');
+            if (eq == std::string::npos)
+                continue;
+            std::string key = trim(line.substr(0, eq));
+            const std::string value = trim(line.substr(eq + 1u));
+            for (char &c : key)
+                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+            if (key == "volante")
+                cfg.wheel = value;
+            else if (key == "mando")
+                cfg.gamepad = std::atoi(value.c_str());
+            else if (key == "zona_muerta")
+                cfg.deadzone = static_cast<float>(std::atof(value.c_str()));
+            else if (key == "zona_muerta_volante")
+                cfg.wheelDeadzone = static_cast<float>(std::atof(value.c_str()));
+            else if (key == "sensibilidad_volante")
+                cfg.wheelSensitivity = static_cast<float>(std::atof(value.c_str()));
+            else if (key == "umbral_boton")
+                cfg.buttonThreshold = static_cast<float>(std::atof(value.c_str()));
+            else if (key == "vibracion")
+                cfg.rumble = std::atoi(value.c_str()) != 0;
+            else
+            {
+                int target = -1;
+                for (int i = 0; i < kTargetCount; ++i)
+                    if (key == kTargetNames[i])
+                        target = i;
+                if (target < 0)
+                {
+                    std::fprintf(stderr, "[pad] controles.ini:%d: control desconocido '%s'\n", lineNumber, key.c_str());
+                    continue;
+                }
+                cfg.map[static_cast<size_t>(target)].clear();
+                std::istringstream items(value);
+                std::string item;
+                while (std::getline(items, item, ','))
+                {
+                    item = trim(item);
+                    if (item.empty())
+                        continue;
+                    Source src;
+                    if (parseSource(item, src))
+                        cfg.map[static_cast<size_t>(target)].push_back(src);
+                    else
+                        std::fprintf(stderr, "[pad] controles.ini:%d: entrada desconocida '%s'\n", lineNumber,
+                                     item.c_str());
+                }
+            }
+        }
+    }
+
+    Config &config()
+    {
+        static Config cfg = []()
+        {
+            Config c;
+            parseConfig(kDefaultConfig, c);
+            const char *override = std::getenv("PS2X_CONTROLES"); // otro archivo (pruebas)
+            const std::string path = override ? std::string(override) : ps2_pad_win::exeDirectory() + "controles.ini";
+            std::ifstream file(path, std::ios::binary);
+            if (file)
+            {
+                std::stringstream text;
+                text << file.rdbuf();
+                parseConfig(text.str(), c);
+                std::fprintf(stderr, "[pad] controles: %s\n", path.c_str());
+            }
+            else if (!override)
+            {
+                std::ofstream out(path, std::ios::binary);
+                out << kDefaultConfig;
+                std::fprintf(stderr, "[pad] controles: %s creado con los valores por defecto\n", path.c_str());
+            }
+            ps2_pad_win::setRumbleEnabled(c.rumble);
+            return c;
+        }();
+        return cfg;
+    }
+
+    float deadzoned(float v, float dz)
+    {
+        const float a = std::fabs(v);
+        if (a <= dz)
+            return 0.0f;
+        return std::min(1.0f, (a - dz) / std::max(1e-3f, 1.0f - dz));
+    }
+
+    struct Frame
+    {
+        bool gamepad = false;
+        int pad = 0;
+        ps2_pad_win::JoystickState wheel;
+    };
+
+    float sourceValue(const Source &s, const Config &cfg, const Frame &f)
+    {
+        switch (s.kind)
+        {
+        case SourceKind::Key:
+            return IsKeyDown(s.code) ? 1.0f : 0.0f;
+        case SourceKind::PadButton:
+            return f.gamepad && IsGamepadButtonDown(f.pad, s.code) ? 1.0f : 0.0f;
+        case SourceKind::PadTrigger:
+            // raylib: -1 suelto, 1 a fondo.
+            return f.gamepad ? deadzoned(std::clamp((GetGamepadAxisMovement(f.pad, s.code) + 1.0f) * 0.5f, 0.0f, 1.0f), 0.05f)
+                             : 0.0f;
+        case SourceKind::PadAxis:
+        {
+            if (!f.gamepad)
+                return 0.0f;
+            const float v = GetGamepadAxisMovement(f.pad, s.code) * (s.mode == '-' ? -1.0f : 1.0f);
+            return v > 0.0f ? deadzoned(v, cfg.deadzone) : 0.0f;
+        }
+        case SourceKind::WheelAxis:
+        {
+            if (!f.wheel.present)
+                return 0.0f;
+            const float v = f.wheel.axes[s.code];
+            float out = 0.0f;
+            if (s.mode == '+' || s.mode == '-')
+            {
+                const float half = (s.mode == '-' ? -v : v) * cfg.wheelSensitivity;
+                out = half > 0.0f ? deadzoned(std::min(half, 1.0f), cfg.wheelDeadzone) : 0.0f;
+            }
+            else
+            {
+                const float pedal = s.mode == '~' ? (1.0f - v) * 0.5f : (v + 1.0f) * 0.5f;
+                out = deadzoned(std::clamp(pedal, 0.0f, 1.0f), cfg.wheelDeadzone);
+            }
+            return out;
+        }
+        case SourceKind::WheelButton:
+            return f.wheel.present && f.wheel.buttons[s.code] ? 1.0f : 0.0f;
+        case SourceKind::WheelPov:
+        {
+            if (!f.wheel.present || f.wheel.pov < 0)
+                return 0.0f;
+            int diff = std::abs(f.wheel.pov - s.code) % 36000;
+            diff = std::min(diff, 36000 - diff);
+            return diff <= 4500 ? 1.0f : 0.0f; // las diagonales cuentan para las dos direcciones
+        }
+        }
+        return 0.0f;
+    }
+
+    std::once_flag g_wheelOnce;
 }
 
