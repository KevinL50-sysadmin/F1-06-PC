diff --git a/ps2xRuntime/src/lib/ps2_pad_win.cpp b/ps2xRuntime/src/lib/ps2_pad_win.cpp
new file mode 100644
index 0000000..e46c5b9
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_pad_win.cpp
@@ -0,0 +1,258 @@
+#include "ps2_pad_win.h"
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#define DIRECTINPUT_VERSION 0x0800
+#include <windows.h>
+#include <dinput.h>
+#include <xinput.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <cstdio>
+#include <mutex>
+
+#pragma comment(lib, "dinput8.lib")
+#pragma comment(lib, "dxguid.lib")
+
+namespace
+{
+    IDirectInput8W *g_di = nullptr;
+    IDirectInputDevice8W *g_wheel = nullptr;
+    std::string g_wheelName;
+    std::atomic<bool> g_rumbleEnabled{true};
+
+    std::string narrow(const wchar_t *text)
+    {
+        if (!text)
+            return {};
+        const int size = WideCharToMultiByte(CP_UTF8, 0, text, -1, nullptr, 0, nullptr, nullptr);
+        std::string out(size > 0 ? static_cast<size_t>(size - 1) : 0u, '\0');
+        if (size > 1)
+            WideCharToMultiByte(CP_UTF8, 0, text, -1, out.data(), size, nullptr, nullptr);
+        return out;
+    }
+
+    std::string lower(std::string text)
+    {
+        for (char &c : text)
+            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        return text;
+    }
+
+    bool initDirectInput()
+    {
+        if (g_di)
+            return true;
+        return SUCCEEDED(DirectInput8Create(GetModuleHandleW(nullptr), DIRECTINPUT_VERSION, IID_IDirectInput8W,
+                                            reinterpret_cast<void **>(&g_di), nullptr));
+    }
+
+    struct Device
+    {
+        GUID guid{};
+        std::string name;
+    };
+
+    BOOL CALLBACK enumDevice(LPCDIDEVICEINSTANCEW instance, LPVOID context)
+    {
+        auto *devices = static_cast<std::vector<Device> *>(context);
+        devices->push_back({instance->guidInstance, narrow(instance->tszProductName)});
+        return DIENUM_CONTINUE;
+    }
+
+    std::vector<Device> enumerate()
+    {
+        std::vector<Device> devices;
+        if (initDirectInput())
+            g_di->EnumDevices(DI8DEVCLASS_GAMECTRL, enumDevice, &devices, DIEDFL_ATTACHEDONLY);
+        return devices;
+    }
+
+    // DirectInput quiere una ventana de nivel superior del proceso (la del juego, de raylib).
+    BOOL CALLBACK findWindow(HWND hwnd, LPARAM param)
+    {
+        DWORD pid = 0;
+        GetWindowThreadProcessId(hwnd, &pid);
+        if (pid == GetCurrentProcessId() && GetWindow(hwnd, GW_OWNER) == nullptr && IsWindowVisible(hwnd))
+        {
+            *reinterpret_cast<HWND *>(param) = hwnd;
+            return FALSE;
+        }
+        return TRUE;
+    }
+
+    bool looksLikeWheel(const std::string &name)
+    {
+        const std::string n = lower(name);
+        for (const char *word : {"wheel", "racing", "volant", "driving", "g29", "g920", "g923", "g27", "g25",
+                                 "t300", "t150", "tmx", "t248", "fanatec", "momo", "dfgt"})
+            if (n.find(word) != std::string::npos)
+                return true;
+        return false;
+    }
+
+    float axis(LONG value)
+    {
+        return std::clamp(static_cast<float>(value) / 32767.0f, -1.0f, 1.0f);
+    }
+
+    using XInputSetStateFn = DWORD(WINAPI *)(DWORD, XINPUT_VIBRATION *);
+    XInputSetStateFn loadXInputSetState()
+    {
+        static XInputSetStateFn fn = []() -> XInputSetStateFn
+        {
+            for (const char *dll : {"xinput1_4.dll", "xinput1_3.dll", "xinput9_1_0.dll"})
+                if (HMODULE module = LoadLibraryA(dll))
+                    if (auto f = reinterpret_cast<XInputSetStateFn>(GetProcAddress(module, "XInputSetState")))
+                        return f;
+            return nullptr;
+        }();
+        return fn;
+    }
+}
+
+namespace ps2_pad_win
+{
+    std::string exeDirectory()
+    {
+        wchar_t path[MAX_PATH] = {};
+        const DWORD length = GetModuleFileNameW(nullptr, path, MAX_PATH);
+        std::string dir = narrow(path);
+        if (length == 0u)
+            return {};
+        const size_t slash = dir.find_last_of("\\/");
+        return slash == std::string::npos ? std::string() : dir.substr(0, slash + 1u);
+    }
+
+    std::vector<std::string> listGameControllers()
+    {
+        std::vector<std::string> names;
+        for (const Device &d : enumerate())
+            names.push_back(d.name);
+        return names;
+    }
+
+    bool openWheel(const std::string &match)
+    {
+        if (g_wheel)
+            return true;
+        const std::string wanted = lower(match);
+        if (wanted == "ninguno" || wanted == "no" || wanted.empty())
+            return false;
+        const std::vector<Device> devices = enumerate();
+        const Device *chosen = nullptr;
+        for (const Device &d : devices)
+            if (wanted == "auto" ? looksLikeWheel(d.name) : lower(d.name).find(wanted) != std::string::npos)
+            {
+                chosen = &d;
+                break;
+            }
+        if (!chosen)
+            return false;
+        IDirectInputDevice8W *device = nullptr;
+        if (FAILED(g_di->CreateDevice(chosen->guid, &device, nullptr)))
+            return false;
+        HWND window = nullptr;
+        EnumWindows(findWindow, reinterpret_cast<LPARAM>(&window));
+        if (FAILED(device->SetDataFormat(&c_dfDIJoystick2)) ||
+            (window && FAILED(device->SetCooperativeLevel(window, DISCL_BACKGROUND | DISCL_NONEXCLUSIVE))))
+        {
+            device->Release();
+            return false;
+        }
+        DIPROPRANGE range{};
+        range.diph.dwSize = sizeof(range);
+        range.diph.dwHeaderSize = sizeof(range.diph);
+        range.diph.dwHow = DIPH_DEVICE;
+        range.lMin = -32767;
+        range.lMax = 32767;
+        device->SetProperty(DIPROP_RANGE, &range.diph);
+        DIPROPDWORD deadzone{};
+        deadzone.diph.dwSize = sizeof(deadzone);
+        deadzone.diph.dwHeaderSize = sizeof(deadzone.diph);
+        deadzone.diph.dwHow = DIPH_DEVICE;
+        deadzone.dwData = 0;
+        device->SetProperty(DIPROP_DEADZONE, &deadzone.diph);
+        device->Acquire();
+        g_wheel = device;
+        g_wheelName = chosen->name;
+        return true;
+    }
+
+    bool readWheel(JoystickState &out)
+    {
+        out = JoystickState{};
+        if (!g_wheel)
+            return false;
+        DIJOYSTATE2 js{};
+        HRESULT hr = g_wheel->Poll();
+        hr = g_wheel->GetDeviceState(sizeof(js), &js);
+        if (hr == DIERR_INPUTLOST || hr == DIERR_NOTACQUIRED)
+        {
+            g_wheel->Acquire();
+            hr = g_wheel->GetDeviceState(sizeof(js), &js);
+        }
+        if (FAILED(hr))
+            return false;
+        out.present = true;
+        out.axes[0] = axis(js.lX);
+        out.axes[1] = axis(js.lY);
+        out.axes[2] = axis(js.lZ);
+        out.axes[3] = axis(js.lRx);
+        out.axes[4] = axis(js.lRy);
+        out.axes[5] = axis(js.lRz);
+        out.axes[6] = axis(js.rglSlider[0]);
+        out.axes[7] = axis(js.rglSlider[1]);
+        for (int i = 0; i < 128; ++i)
+            out.buttons[i] = (js.rgbButtons[i] & 0x80u) != 0u ? 1u : 0u;
+        out.pov = LOWORD(js.rgdwPOV[0]) == 0xFFFFu ? -1 : static_cast<int>(js.rgdwPOV[0]);
+        return true;
+    }
+
+    std::string wheelName()
+    {
+        return g_wheelName;
+    }
+
+    void setRumbleEnabled(bool enabled)
+    {
+        g_rumbleEnabled.store(enabled, std::memory_order_relaxed);
+        if (!enabled)
+            if (XInputSetStateFn fn = loadXInputSetState())
+            {
+                XINPUT_VIBRATION off{};
+                fn(0, &off);
+            }
+    }
+
+    void setRumble(float smallMotor, float largeMotor)
+    {
+        if (!g_rumbleEnabled.load(std::memory_order_relaxed))
+            return;
+        if (XInputSetStateFn fn = loadXInputSetState())
+        {
+            XINPUT_VIBRATION v{};
+            v.wRightMotorSpeed = static_cast<WORD>(std::clamp(smallMotor, 0.0f, 1.0f) * 65535.0f); // el pequeno, agudo
+            v.wLeftMotorSpeed = static_cast<WORD>(std::clamp(largeMotor, 0.0f, 1.0f) * 65535.0f);
+            fn(0, &v);
+        }
+    }
+}
+
+#else
+
+namespace ps2_pad_win
+{
+    std::string exeDirectory() { return {}; }
+    std::vector<std::string> listGameControllers() { return {}; }
+    bool openWheel(const std::string &) { return false; }
+    bool readWheel(JoystickState &out) { out = JoystickState{}; return false; }
+    std::string wheelName() { return {}; }
+    void setRumbleEnabled(bool) {}
+    void setRumble(float, float) {}
+}
+
+#endif
diff --git a/ps2xRuntime/src/lib/ps2_pad_win.h b/ps2xRuntime/src/lib/ps2_pad_win.h
new file mode 100644
index 0000000..fc4be5e
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_pad_win.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// Entrada de Windows para el mando del PS2 (ps2_pad.cpp), aparte porque windows.h choca con raylib.h:
+// volantes y pedales por DirectInput 8 y vibracion del mando XInput.
+namespace ps2_pad_win
+{
+    struct JoystickState
+    {
+        bool present = false;
+        float axes[8] = {}; // X Y Z RX RY RZ S0 S1, de -1 a 1
+        uint8_t buttons[128] = {};
+        int pov = -1; // centesimas de grado, -1 = centrado
+    };
+
+    std::string exeDirectory(); // carpeta del .exe, con la barra final
+
+    // Los mandos de juego que ve DirectInput (para el log y para elegir el volante).
+    std::vector<std::string> listGameControllers();
+    // match: "auto" (el primero cuyo nombre parezca un volante), "ninguno", o parte del nombre. Llamar desde el hilo
+    // que lo va a leer.
+    bool openWheel(const std::string &match);
+    bool readWheel(JoystickState &out);
+    std::string wheelName();
+
+    // Vibracion del mando XInput 0 (motor pequeno y grande, de 0 a 1).
+    void setRumbleEnabled(bool enabled);
+    void setRumble(float smallMotor, float largeMotor);
+}
