+    // B2 (patch 0172): the PS2's analog audio output is AC-coupled, so a constant level in the mix never reaches the
+    // speakers. F1 06 pauses a race by setting every voice's pitch to 0 with some volumes still up: the mix holds a
+    // constant (-4481 in a test run, 20198 in the user's log) that is silence on the console and in PCSX2. The host
+    // played it, and every ring underrun in the pause dropped it to zero and back, a click each time. A one-pole
+    // high-pass per channel, y[n] = x[n] - x[n-1] + Pole * y[n-1]: a constant is gone in ~0.1 s; 20 Hz loses 0.3 dB.
+    class Spu2DcBlocker
+    {
+    public:
+        static constexpr double CutoffHz = 5.0;
+        static constexpr double Pole = 1.0 - 2.0 * 3.14159265358979323846 * CutoffHz / 48000.0;
+
+        void process(int16_t &left, int16_t &right) noexcept
+        {
+            left = m_left.step(left);
+            right = m_right.step(right);
+        }
+
+    private:
+        struct Channel
+        {
+            double previousIn = 0.0;
+            double previousOut = 0.0;
+
+            int16_t step(int16_t sample) noexcept
+            {
+                const double in = sample;
+                previousOut = in - previousIn + Pole * previousOut;
+                previousIn = in;
+                return static_cast<int16_t>(std::clamp(std::lround(previousOut), -32768L, 32767L));
+            }
+        };
+
+        Channel m_left, m_right;
+    };
+
+    // B2: PS2X_SPU2_CONTINUA=1 (or false here) plays the constant level as before. Any thread.
+    void setSpu2OutputDcFilter(bool enabled) noexcept;
+
     // The host ring without the consumer above (no rebuffering or fades): the tests of the synthesis timing read it
     // directly. Returns the frames written to `out`.
     std::size_t readSpu2OutputRaw(int16_t *out, std::size_t frames) noexcept;
