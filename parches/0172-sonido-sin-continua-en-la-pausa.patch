+        // B2 (patch 0172): in a race's pause F1 06 sets every voice's pitch to 0 and leaves some volumes up, so the mix
+        // holds a constant level (-4481 in a test run, 20198 in the user's log). The PS2's analog output is AC-coupled:
+        // a constant never reaches the speakers (PCSX2 plays silence there). Ours kept it, and every ring underrun in
+        // the pause dropped it to zero and back: the rasp the user heard.
+        tc.Run("SPU2 output removes a constant level, as the PS2's AC-coupled analog output does", [](TestCase &t)
+        {
+            Spu2InputRig rig(true);
+            rig.setSample(0);
+            rig.fillHalf(0x2400u, 4481);
+            rig.fillHalf(0x2500u, 4481);
+            std::vector<int16_t> left;
+            for (uint64_t step = 1; step <= 12u; ++step) // 49152 samples, about 1 s, in pieces the ring holds
+            {
+                rig.setSample(step * 4096u);
+                const std::vector<int16_t> piece = rig.collect(4096u);
+                left.insert(left.end(), piece.begin(), piece.end());
+            }
+            t.IsTrue(left.size() >= 45000u, "the second plays (" + std::to_string(left.size()) + " frames)");
+            if (left.size() < 45000u)
+                return;
+            t.IsTrue(left[20] > 4000, "the step itself still plays (" + std::to_string(left[20]) + ")");
+            int16_t residue = 0;
+            for (size_t i = 24000u; i < left.size(); ++i)
+                residue = std::max<int16_t>(residue, static_cast<int16_t>(std::abs(left[i])));
+            t.IsTrue(residue <= 2, "after half a second nothing is left of it (max " + std::to_string(residue) + ")");
+        });
+
+        tc.Run("SPU2 output high-pass saturates instead of wrapping on a full-scale step", [](TestCase &t)
+        {
+            // A race mix clips at full scale (PCSX2 too); a jump across the whole range overshoots in the filter.
+            ps2x::iop::detail::Spu2DcBlocker blocker;
+            int16_t left = -32768, right = 32767;
+            for (int i = 0; i < 48000; ++i)
+            {
+                left = -32768;
+                right = 32767;
+                blocker.process(left, right);
+            }
+            t.IsTrue(std::abs(left) <= 1 && std::abs(right) <= 1, "a held full-scale level settles to zero");
+            left = 32767;
+            right = -32768;
+            blocker.process(left, right);
+            t.Equals(left, int16_t{32767}, "the step up saturates at the top");
+            t.Equals(right, int16_t{-32768}, "the step down saturates at the bottom");
+        });
+
+        tc.Run("SPU2 output keeps the level of a low tone while it removes the constant", [](TestCase &t)
