+                const ps2x::lgdev::WheelMap defaults = ps2x::lgdev::defaultWheelMap();
+                t.Equals(base.nativeWheel.buttons[ps2x::lgdev::kCross].size(), size_t{1}, "cross: one input");
+                t.Equals(codeAt(base.nativeWheel.buttons[ps2x::lgdev::kCross], 0), 0, "cross = B1 by default");
+                t.Equals(base.nativeWheel.throttle.code, defaults.throttle.code, "throttle = Y by default");
