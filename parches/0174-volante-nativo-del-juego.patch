+    // Patch 0174: a line of [volante] (the native wheel of player 1): direccion, acelerador and freno take one wheel axis;
+    // the button names, a list of volante: inputs (it replaces the default).
+    void parseNativeWheelLine(const std::string &key, const std::string &value, int lineNumber,
+                              ps2x::lgdev::WheelMap &map, std::vector<std::string> &messages)
+    {
+        using ps2x::lgdev::WheelSource;
+        WheelSource *axis = key == "direccion" ? &map.steering : key == "acelerador" ? &map.throttle
+                            : key == "freno"   ? &map.brake : nullptr;
+        int button = -1;
+        for (int b = 0; b < ps2x::lgdev::kButtonCount; ++b)
+            if (key == ps2x::lgdev::kButtonNames[b])
+                button = b;
+        if (!axis && button < 0)
+        {
+            messages.push_back(formatted("controles.ini:%d: control desconocido '%s'", lineNumber, key.c_str()));
+            return;
+        }
+        if (button >= 0)
+            map.buttons[static_cast<size_t>(button)].clear();
+        std::istringstream items(value);
+        std::string item;
+        while (std::getline(items, item, ','))
+        {
+            item = trim(item);
+            if (item.empty())
+                continue;
+            Source src;
+            if (!parseSource(item, src))
+                messages.push_back(formatted("controles.ini:%d: entrada desconocida '%s'", lineNumber, item.c_str()));
+            else if (!isWheelSource(src))
+                messages.push_back(formatted("controles.ini:%d: [volante] solo admite entradas volante: ('%s')",
+                                             lineNumber, item.c_str()));
+            else if (axis && src.kind != SourceKind::WheelAxis)
+                messages.push_back(formatted("controles.ini:%d: %s necesita un eje del volante ('%s')", lineNumber,
+                                             key.c_str(), item.c_str()));
+            else if (axis)
+                *axis = {WheelSource::Kind::Axis, src.code, src.mode};
+            else
+                map.buttons[static_cast<size_t>(button)].push_back(
+                    {src.kind == SourceKind::WheelButton ? WheelSource::Kind::Button
+                     : src.kind == SourceKind::WheelPov  ? WheelSource::Kind::Pov
+                                                         : WheelSource::Kind::Axis,
+                     src.code, src.mode});
+        }
+    }
