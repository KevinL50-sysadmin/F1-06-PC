+                t.Equals(u32At(desc.data(), 4), 0x7E8u, "desc[1]: 0x7E8, Driving Force Pro");
+                t.Equals(u32At(desc.data(), 8), 7u, "desc[2]: 7");
+                t.Equals(u32At(desc.data(), 12), 0u, "desc[3]: 0");
