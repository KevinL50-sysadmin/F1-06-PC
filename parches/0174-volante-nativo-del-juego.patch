index 0000000..9d0df23
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_lgdev.h
@@ -0,0 +1,346 @@
+#pragma once
+
+#include "ps2_pad_win.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+// T2 of the native wheel (F1 06, patch 0174, odd/tasks/volante-nativo.md): the game's Logitech library (liblgdev 1.11,
+// 0x2F6950-0x2F77F8 and lgDevASync 0x2F7880) is replaced by the host (src/f1_overrides.cpp), so the game itself sees
+// a Logitech Driving Force Pro fed from the PC wheel (DirectInput). Contract: analisis/volante-liblgdev.md. This header
+// holds the pure part: the descriptor, the 0x18-byte position, the device state machine and the wheel mapping.
+namespace ps2x::lgdev
+{
+    // Error codes of the IRX (returned as negative s32).
+    constexpr uint32_t kErrNoMoreDevices = 0x80000002u;
+    constexpr uint32_t kErrInvalid = 0x80000004u;
+    constexpr uint32_t kErrAlreadyOpen = 0x80000005u;
+    constexpr uint32_t kErrDeviceGone = 0x80000006u;
+    constexpr size_t kDescriptorSize = 0x18u;
+    constexpr size_t kPositionSize = 0x18u;
+
+    // The Driving Force Pro buttons, in the order of their bit in pos + 0x14 (bit 16 + value).
+    enum DfpButton : int
+    {
+        kCross = 0, kSquare, kCircle, kTriangle, kStart, kSelect, kL1, kR1, kL2, kR2, kL3, kR3,
+        kButtonCount
+    };
+    // Their names in the [volante] section of controles.ini (the DualShock 2 names of the pad mapping).
+    inline const char *const kButtonNames[kButtonCount] = {"cruz", "cuadrado", "circulo", "triangulo", "start", "select",
+                                                           "l1", "r1", "l2", "r2", "l3", "r3"};
+
+    // The wheel as the game wants it, before packing it into the position.
+    struct WheelInput
+    {
+        float steering = 0.0f; // -1 (left) .. 1 (right)
+        float throttle = 0.0f; // 0 released .. 1 floored
+        float brake = 0.0f;
+        int pov = -1;          // hundredths of a degree, -1 = centred
+        uint32_t buttons = 0u; // bit = DfpButton
+    };
+
+    // An input of the PC wheel (the volante: entries of controles.ini).
+    struct WheelSource
+    {
+        enum class Kind : uint8_t
+        {
+            Axis,   // code = axis of JoystickState (X Y Z RX RY RZ S0 S1); mode '+', '-', '~' or '='
+            Button, // code = button (B1 = 0)
+            Pov     // code = direction in hundredths of a degree
+        };
+        Kind kind = Kind::Button;
+        int code = 0;
+        char mode = '+';
+    };
+
+    struct WheelMap
+    {
+        WheelSource steering{WheelSource::Kind::Axis, 0, '+'};
+        WheelSource throttle{WheelSource::Kind::Axis, 1, '~'};
+        WheelSource brake{WheelSource::Kind::Axis, 5, '~'};
+        std::array<std::vector<WheelSource>, kButtonCount> buttons;
+        float pedalDeadzone = 0.02f; // zona_muerta_volante
+    };
+
+    // A Logitech G29 through DirectInput (G HUB): B1 cross, B2 square, B3 circle, B4 triangle, B5 right paddle (R1),
+    // B6 left paddle (L1), B7 R2, B8 L2, B9 share (select), B10 options (start), B11 R3, B12 L3; X steering, Y throttle
+    // and RZ brake (released at +1). The d-pad is the POV.
+    inline WheelMap defaultWheelMap()
+    {
+        WheelMap map;
+        const DfpButton order[12] = {kCross, kSquare, kCircle, kTriangle, kR1, kL1, kR2, kL2, kSelect, kStart, kR3, kL3};
+        for (int b = 0; b < 12; ++b)
+            map.buttons[order[b]].push_back({WheelSource::Kind::Button, b, '+'});
+        return map;
+    }
+
+    // An axis of JoystickState (-1..1) as a 0..1 travel: '+'/'-' half axis, '~' pedal released at +1, '=' at -1.
+    inline float axisTravel(float v, char mode)
+    {
+        switch (mode)
+        {
+        case '-': return std::clamp(-v, 0.0f, 1.0f);
+        case '~': return std::clamp((1.0f - v) * 0.5f, 0.0f, 1.0f);
+        case '=': return std::clamp((v + 1.0f) * 0.5f, 0.0f, 1.0f);
+        default: return std::clamp(v, 0.0f, 1.0f);
+        }
+    }
+
+    inline float pedalValue(const ps2_pad_win::JoystickState &s, const WheelSource &src, float deadzone)
+    {
+        if (src.kind != WheelSource::Kind::Axis || src.code < 0 || src.code >= 8)
+            return 0.0f;
+        const float v = axisTravel(s.axes[src.code], src.mode);
+        return v <= deadzone ? 0.0f : std::min(1.0f, (v - deadzone) / std::max(1e-3f, 1.0f - deadzone));
+    }
+
+    inline bool sourcePressed(const ps2_pad_win::JoystickState &s, const WheelSource &src)
+    {
+        switch (src.kind)
+        {
+        case WheelSource::Kind::Button:
+            return src.code >= 0 && src.code < 128 && s.buttons[src.code] != 0u;
+        case WheelSource::Kind::Pov:
+        {
+            if (s.pov < 0)
+                return false;
+            int diff = std::abs(s.pov - src.code) % 36000;
+            diff = std::min(diff, 36000 - diff);
+            return diff <= 4500; // diagonals count for both directions, as in the pad mapping
+        }
+        case WheelSource::Kind::Axis:
+            return src.code >= 0 && src.code < 8 && axisTravel(s.axes[src.code], src.mode) >= 0.5f;
+        }
+        return false;
+    }
+
+    // The wheel state of DirectInput through the map. Steering linear over the wheel's full physical range (the game
+    // applies its own handling and sensitivity). false (and out at rest) without a wheel.
+    inline bool wheelInputFrom(const ps2_pad_win::JoystickState &s, const WheelMap &map, WheelInput &out)
+    {
+        out = WheelInput{};
+        if (!s.present)
+            return false;
+        if (map.steering.kind == WheelSource::Kind::Axis && map.steering.code >= 0 && map.steering.code < 8)
+            out.steering = std::clamp(s.axes[map.steering.code] * (map.steering.mode == '-' ? -1.0f : 1.0f), -1.0f, 1.0f);
+        out.throttle = pedalValue(s, map.throttle, map.pedalDeadzone);
+        out.brake = pedalValue(s, map.brake, map.pedalDeadzone);
+        out.pov = s.pov;
+        for (int b = 0; b < kButtonCount; ++b)
+            for (const WheelSource &src : map.buttons[b])
+                if (sourcePressed(s, src))
+                    out.buttons |= 1u << b;
+        return true;
+    }
+
+    inline void put16(uint8_t *p, uint16_t v) { std::memcpy(p, &v, 2); }
+    inline void put32(uint8_t *p, uint32_t v) { std::memcpy(p, &v, 4); }
+
+    // Enumerate's descriptor: {0x12, 0x7E8, 7, 0, 0, handle} (Driving Force Pro; the game names it "DrivingForcePro").
+    inline void buildDescriptor(int32_t handle, uint8_t *desc)
+    {
+        const uint32_t words[6] = {0x12u, 0x7E8u, 7u, 0u, 0u, static_cast<uint32_t>(handle)};
+        for (int i = 0; i < 6; ++i)
+            put32(desc + i * 4, words[i]);
+    }
+
+    // The 0x18-byte position as the IRX leaves it: +0 status 0 (new data), +2 s16 steering +-32767, +4 s16
+    // (brake - throttle) >> 1 (-32768 saturates), +0xE/+0x10 u16 throttle/brake 0..0xFFFF, +0x12 d-pad (0 N, 2 E, 4 S,
+    // 6 W, odd diagonals, 0xFF centred), +0x13 0xFF, +0x14 buttons in bits 16-27.
+    inline void buildPosition(const WheelInput &in, uint8_t *pos)
+    {
+        std::memset(pos, 0, kPositionSize);
+        const int steering = static_cast<int>(std::lround(std::clamp(in.steering, -1.0f, 1.0f) * 32767.0f));
+        const int throttle = static_cast<int>(std::lround(std::clamp(in.throttle, 0.0f, 1.0f) * 65535.0f));
+        const int brake = static_cast<int>(std::lround(std::clamp(in.brake, 0.0f, 1.0f) * 65535.0f));
+        const int combined = std::max((brake - throttle) >> 1, -32767);
+        put16(pos + 0x02, static_cast<uint16_t>(static_cast<int16_t>(steering)));
+        put16(pos + 0x04, static_cast<uint16_t>(static_cast<int16_t>(combined)));
+        put16(pos + 0x0E, static_cast<uint16_t>(throttle));
+        put16(pos + 0x10, static_cast<uint16_t>(brake));
+        pos[0x12] = in.pov < 0 ? 0xFFu : static_cast<uint8_t>(((in.pov + 2250) / 4500) % 8);
+        pos[0x13] = 0xFFu;
+        put32(pos + 0x14, (in.buttons & 0xFFFu) << 16);
+    }
+
+    // F1_VOLANTE_FALSO=<steering>,<throttle>,<brake> (tests without hardware): steering -1..1, pedals 0..1.
+    inline bool parseFakeWheel(const char *text, WheelInput &out)
+    {
+        if (text == nullptr)
+            return false;
+        float values[3] = {};
+        const char *p = text;
+        for (int i = 0; i < 3; ++i)
+        {
+            char *end = nullptr;
+            values[i] = std::strtof(p, &end);
+            if (end == p)
+                return false;
+            while (*end == ' ')
+                ++end;
+            if (i < 2 && *end != ',')
+                return false;
+            if (i == 2 && *end != '\0')
+                return false;
+            p = end + (i < 2 ? 1 : 0);
+        }
+        out = WheelInput{};
+        out.steering = std::clamp(values[0], -1.0f, 1.0f);
+        out.throttle = std::clamp(values[1], 0.0f, 1.0f);
+        out.brake = std::clamp(values[2], 0.0f, 1.0f);
+        return true;
+    }
+
+    // F1_VOLANTE_FALSO=mando (tests): the wheel follows the DualShock 2 report of port 0 (bytes 2-19, after the test
+    // scripts and the autopilot wrote it): its buttons and d-pad, the left stick X as the steering and the cross and
+    // square pressures as the throttle and brake (F1 06 accelerates with cross and brakes with square on the pad).
+    inline WheelInput wheelInputFromPadReport(const uint8_t *report)
+    {
+        WheelInput in;
+        const uint32_t pressed = ~static_cast<uint32_t>(report[2] | (report[3] << 8)) & 0xFFFFu;
+        const struct
+        {
+            int bit;
+            DfpButton button;
+        } kButtons[] = {{14, kCross}, {15, kSquare}, {13, kCircle}, {12, kTriangle}, {3, kStart}, {0, kSelect},
+                        {10, kL1},    {11, kR1},     {8, kL2},      {9, kR2},       {1, kL3},    {2, kR3}};
+        for (const auto &b : kButtons)
+            if ((pressed & (1u << b.bit)) != 0u)
+                in.buttons |= 1u << b.button;
+        const bool up = (pressed & 0x10u) != 0u, right = (pressed & 0x20u) != 0u, down = (pressed & 0x40u) != 0u,
+                   left = (pressed & 0x80u) != 0u;
+        in.pov = up && right     ? 4500
+                 : right && down ? 13500
+                 : down && left  ? 22500
+                 : left && up    ? 31500
+                 : up            ? 0
+                 : right         ? 9000
+                 : down          ? 18000
+                 : left          ? 27000
+                                 : -1;
+        in.steering = std::clamp((static_cast<float>(report[6]) - 127.5f) / 127.5f, -1.0f, 1.0f);
+        if (report[6] == 0x80u || report[6] == 0x7Fu)
+            in.steering = 0.0f; // the centre of the stick
+        in.throttle = (in.buttons & (1u << kCross)) != 0u ? static_cast<float>(report[14]) / 255.0f : 0.0f;
+        in.brake = (in.buttons & (1u << kSquare)) != 0u ? static_cast<float>(report[15]) / 255.0f : 0.0f;
+        return in;
+    }
+
+    // The library's state on the host: one wheel (index 0) in slot 0. present: whether the wheel is there now. Not
+    // thread safe (the caller locks).
+    class HostLibrary
+    {
+    public:
+        // EnumHint: non-zero once at start and whenever the wheel comes or goes; 0 otherwise (the game re-enumerates
+        // on non-zero, closing every device first).
+        uint32_t enumHint(bool present)
+        {
+            const bool changed = m_firstHint || present != m_hintPresent;
+            m_firstHint = false;
+            m_hintPresent = present;
+            return changed ? 1u : 0u;
+        }
+
+        int32_t enumerate(uint32_t index, bool present, uint8_t *desc)
+        {
+            if (index != 0u || !present)
+                return static_cast<int32_t>(kErrNoMoreDevices);
+            buildDescriptor(m_open ? m_handle : -1, desc);
+            return 0;
+        }
+
+        // handle = (counter << 4) | slot, as the IRX.
+        int32_t open(uint32_t index, bool present, int32_t &handle)
+        {
+            handle = -1;
+            if (index != 0u || !present)
+                return static_cast<int32_t>(kErrNoMoreDevices);
+            if (m_open)
+            {
+                handle = m_handle;
+                return static_cast<int32_t>(kErrAlreadyOpen);
+            }
+            m_open = true;
+            m_handle = static_cast<int32_t>((++m_counter & 0x7FFFFFFu) << 4);
+            m_props = {0u, 0u, 0u, 255u, 0u, 0u}; // the IRX sets the gain to 255 on open
+            m_effects = 0u;
+            handle = m_handle;
+            return 0;
+        }
+
+        int32_t close(int32_t handle)
+        {
+            if (!valid(handle))
+                return static_cast<int32_t>(kErrInvalid);
+            m_open = false;
+            return 0;
+        }
+
+        // Properties 2 (centring spring, inferred), 3 (gain 0-255), 4 and 5: stored and returned.
+        int32_t getProperty(int32_t handle, uint32_t prop, uint32_t &value)
+        {
+            if (!valid(handle) || prop < 2u || prop > 5u)
+                return static_cast<int32_t>(kErrInvalid);
+            value = m_props[prop];
+            return 0;
+        }
+
+        int32_t setProperty(int32_t handle, uint32_t prop, uint32_t value)
+        {
+            if (!valid(handle) || prop < 2u || prop > 5u)
+                return static_cast<int32_t>(kErrInvalid);
+            m_props[prop] = value;
+            return 0;
+        }
+
+        // One device of ReadMulti. input: the wheel now, nullptr if it is gone. On error, status 0xFF (the game only
+        // copies positions with status 0).
+        int32_t readPosition(int32_t handle, const WheelInput *input, uint8_t *pos)
+        {
+            if (!valid(handle) || input == nullptr)
+            {
+                std::memset(pos, 0, kPositionSize);
+                put16(pos, 0xFFu);
+                return static_cast<int32_t>(valid(handle) ? kErrDeviceGone : kErrInvalid);
+            }
+            buildPosition(*input, pos);
+            return 0;
+        }
+
+        // Force effects (T4 will drive them): id = (handle << 16) | n.
+        int32_t downloadEffect(int32_t handle, uint32_t &id)
+        {
+            if (!valid(handle))
+                return static_cast<int32_t>(kErrInvalid);
+            m_effects = (m_effects % 0xFFFFu) + 1u;
+            id = (static_cast<uint32_t>(handle) << 16) | m_effects;
+            return 0;
+        }
+
+        bool isOpen() const { return m_open; }
+        int32_t handle() const { return m_open ? m_handle : -1; }
+
+    private:
+        bool valid(int32_t handle) const { return m_open && handle == m_handle; }
+
+        bool m_firstHint = true;
+        bool m_hintPresent = false;
+        bool m_open = false;
+        int32_t m_handle = -1;
+        uint32_t m_counter = 0u;
+        uint32_t m_effects = 0u;
+        std::array<uint32_t, 6> m_props{};
+    };
+
+    // Whether the game reads the wheel through the replaced library (set by the game's overrides before the first pad
+    // read). While it does, the wheel does not feed the DualShock 2 of player 1 (F1_VOLANTE_STICK=1 keeps it off).
+    inline std::atomic<bool> g_nativeWheel{false};
+    inline void setNativeWheelEnabled(bool enabled) { g_nativeWheel.store(enabled, std::memory_order_relaxed); }
+    inline bool nativeWheelEnabled() { return g_nativeWheel.load(std::memory_order_relaxed); }
+}
