+    uint16_t u16At(const uint8_t *p, size_t offset)
+    {
+        uint16_t v = 0;
+        std::memcpy(&v, p + offset, 2);
+        return v;
+    }
+
+    int16_t s16At(const uint8_t *p, size_t offset)
+    {
+        int16_t v = 0;
+        std::memcpy(&v, p + offset, 2);
+        return v;
+    }
+
+    uint32_t u32At(const uint8_t *p, size_t offset)
+    {
+        uint32_t v = 0;
+        std::memcpy(&v, p + offset, 4);
+        return v;
+    }
+
+    // The code of the i-th input of a button, -1 if it has fewer.
+    int codeAt(const std::vector<ps2x::lgdev::WheelSource> &sources, size_t i)
+    {
+        return i < sources.size() ? sources[i].code : -1;
+    }
+
+    std::array<uint8_t, 24> position(const WheelInput &in)
+    {
+        std::array<uint8_t, 24> pos{};
+        pos.fill(0xAA);
+        ps2x::lgdev::buildPosition(in, pos.data());
+        return pos;
+    }
+
+    // A G29 at rest as DirectInput reports it: wheel centred, pedals released (+1 with the "~" mode), POV centred.
+    ps2_pad_win::JoystickState g29AtRest()
+    {
+        ps2_pad_win::JoystickState s;
+        s.present = true;
+        s.axes[1] = 1.0f; // Y: throttle released
+        s.axes[2] = 1.0f; // Z: clutch released
+        s.axes[5] = 1.0f; // RZ: brake released
+        s.pov = -1;
+        return s;
+    }
+
