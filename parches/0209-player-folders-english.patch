+    // v1.1.1: the bytes of a player's file (with a NUL, CRLF and bytes over 0x7F), to check they survive untouched.
+    std::string playerBytes(const std::string &name)
+    {
+        return "contenido de " + name + std::string("\0\r\n\xFF\xFE\x01", 6) + name;
+    }
+
+    // The v1.1.0 (Spanish) names of a player's folders: root holds partidas, capturas and config (opciones.ini,
+    // controles.ini), logs holds registros (the .exe's folder in portable mode, LocalAppData\F1-06 when installed).
+    std::vector<fs::path> writeLegacyPlayerFolders(const fs::path &root, const fs::path &logs)
+    {
+        const std::vector<fs::path> files = {root / "partidas" / "mc0" / "BESCES-53950" / "save.bin",
+                                             root / "partidas" / "mc1" / "keep.bin",
+                                             root / "capturas" / "F1-06_2026-10-04_09-05-07.png",
+                                             root / "config" / "opciones.ini",
+                                             root / "config" / "controles.ini",
+                                             logs / "registros" / "F1-06.log",
+                                             logs / "registros" / "F1-06.anterior.log"};
+        for (const fs::path &file : files)
+            writeText(file, playerBytes(file.filename().string()));
+        return files;
+    }
+
+    // Where each file of writeLegacyPlayerFolders() goes with the v1.1.1 names.
+    std::vector<fs::path> newPlayerFiles(const UserPaths &paths)
+    {
+        return {paths.savesDirectory / "mc0" / "BESCES-53950" / "save.bin",
+                paths.savesDirectory / "mc1" / "keep.bin",
+                paths.photosDirectory / "F1-06_2026-10-04_09-05-07.png",
+                paths.optionsFile,
+                paths.controlsFile,
+                paths.logsDirectory / "F1-06.log",
+                paths.logsDirectory / "F1-06.anterior.log"};
+    }
+
+    size_t countLines(const std::vector<std::string> &lines, const std::string &prefix)
+    {
+        return static_cast<size_t>(std::count_if(lines.begin(), lines.end(), [&](const std::string &line)
+                                                 { return line.rfind(prefix, 0) == 0; }));
+    }
+
+    std::string joined(const std::vector<std::string> &lines)
+    {
+        std::string text;
+        for (const std::string &line : lines)
+            text += line + "\n";
+        return text;
+    }
