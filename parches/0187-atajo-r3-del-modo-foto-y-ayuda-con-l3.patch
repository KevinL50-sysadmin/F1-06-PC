+
+    bool parseHeldPadButtons(std::string_view text, uint16_t &bits, double &seconds)
+    {
+        // The PS2's button bits in order, with controles.ini's names.
+        static constexpr std::string_view kNames[16] = {"select", "l3", "r3", "start", "arriba", "derecha",
+                                                        "abajo", "izquierda", "l2", "r2", "l1", "r1",
+                                                        "triangulo", "circulo", "cruz", "cuadrado"};
+        const std::string item = trim(text);
+        const size_t colon = item.find(':');
+        double held = 0.2;
+        if (colon != std::string::npos)
+        {
+            const std::string number = trim(std::string_view(item).substr(colon + 1u));
+            char *end = nullptr;
+            held = std::strtod(number.c_str(), &end);
+            if (number.empty() || end == nullptr || *end != '\0' || !std::isfinite(held) || held < 0.0)
+                return false;
+        }
+        uint16_t found = 0u;
+        std::string_view names = std::string_view(item).substr(0, colon);
+        while (true)
+        {
+            const size_t plus = names.find('+');
+            const std::string name = trim(names.substr(0, plus));
+            const auto at = std::find(std::begin(kNames), std::end(kNames), name);
+            if (at == std::end(kNames))
+                return false;
+            found = static_cast<uint16_t>(found | (1u << (at - std::begin(kNames))));
+            if (plus == std::string_view::npos)
+                break;
+            names.remove_prefix(plus + 1u);
+        }
+        bits = found;
+        seconds = held;
+        return true;
+    }
 }
