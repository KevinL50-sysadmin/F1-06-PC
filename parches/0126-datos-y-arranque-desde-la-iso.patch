+    // Appended-ISO footer built by hand: magic, uint64 LE offset, uint64 LE size, uint32 LE version, uint32 0.
+    std::vector<uint8_t> appendedFooter(const char *magic, uint64_t offset, uint64_t size, uint32_t version = 1u)
+    {
+        std::vector<uint8_t> footer(32u, 0u);
+        std::memcpy(footer.data(), magic, 8u);
+        for (uint32_t i = 0u; i < 8u; ++i)
+        {
+            footer[8u + i] = static_cast<uint8_t>(offset >> (i * 8u));
+            footer[16u + i] = static_cast<uint8_t>(size >> (i * 8u));
+        }
+        for (uint32_t i = 0u; i < 4u; ++i)
+            footer[24u + i] = static_cast<uint8_t>(version >> (i * 8u));
+        return footer;
+    }
