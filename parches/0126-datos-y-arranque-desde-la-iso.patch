+    // Moves `position` inside [0, size] like lseek; returns the new position or -1.
+    int64_t seekInside(uint64_t &position, uint64_t size, int64_t offset, int whence)
+    {
+        int64_t base = 0;
+        if (whence == SEEK_CUR)
+            base = static_cast<int64_t>(position);
+        else if (whence == SEEK_END)
+            base = static_cast<int64_t>(size);
+        else if (whence != SEEK_SET)
+            return -1;
+
