+    // Reads only the last 32 bytes of `path` (and the PVD tag): the ISO appended to it, if the footer is valid.
+    inline std::optional<AppendedIso> findAppendedIso(const std::filesystem::path &path)
+    {
+        std::error_code error;
+        const uint64_t fileSize = std::filesystem::file_size(path, error);
+        if (error || fileSize < kAppendedIsoFooterSize)
+            return std::nullopt;
+        std::ifstream stream(path, std::ios::binary);
+        uint8_t footer[kAppendedIsoFooterSize]{};
+        if (!stream.seekg(static_cast<std::streamoff>(fileSize - kAppendedIsoFooterSize), std::ios::beg) ||
