+        std::string_view name = separator == std::string_view::npos ? boot2 : boot2.substr(separator + 1u);
+        const size_t semicolon = name.rfind(';');
+        if (semicolon != std::string_view::npos)
+            name = name.substr(0u, semicolon);
+        return std::string(name);
+    }
