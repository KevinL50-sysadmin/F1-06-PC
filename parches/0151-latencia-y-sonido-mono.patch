 namespace ps2x::iop::detail
 {
+    // Fase 5 (T5): the range the latency target moves in (frames at 48 kHz) and where it starts, per opciones.ini
+    // latencia_audio. The device pulls 1024 frames at a time, so 2048 (43 ms) is the least that plays smoothly.
+    struct Spu2LatencyBounds
+    {
+        uint32_t minimum = 2048u;
+        uint32_t maximum = 6144u;
+        uint32_t start = 2048u;
+    };
+
+    [[nodiscard]] constexpr Spu2LatencyBounds spu2LatencyBounds(Spu2OutputLatency latency) noexcept
+    {
+        switch (latency)
+        {
+        case Spu2OutputLatency::Low:
+            return {2048u, 3072u, 2048u}; // 43 ms, at most 64 ms after underruns
+        case Spu2OutputLatency::High:
+            return {6144u, 6144u, 6144u}; // 128 ms held
+        case Spu2OutputLatency::Auto:
+            break;
+        }
+        return {2048u, 6144u, 2048u}; // patch 0147: 43 to 128 ms
+    }
+
+    // Fase 5 (T6): opciones.ini audio_mono, (left + right) / 2 on both channels of `frames` interleaved stereo frames.
+    inline void downmixToMono(int16_t *interleavedStereo, size_t frames) noexcept
+    {
+        for (size_t i = 0; i < frames; ++i)
+        {
+            const int32_t sum = static_cast<int32_t>(interleavedStereo[i * 2u]) + interleavedStereo[i * 2u + 1u];
+            const int16_t mono = static_cast<int16_t>(sum / 2);
+            interleavedStereo[i * 2u] = mono;
+            interleavedStereo[i * 2u + 1u] = mono;
+        }
+    }
