diff --git a/ps2xTest/src/ps2_iop_tests.cpp b/ps2xTest/src/ps2_iop_tests.cpp
index 680c805..a44eef4 100644
--- a/ps2xTest/src/ps2_iop_tests.cpp
+++ b/ps2xTest/src/ps2_iop_tests.cpp
@@ -560,5 +560,69 @@ void register_ps2_iop_tests()
             t.Equals(run.underruns, uint64_t{0}, "no underrun");
         });
 
+        // Fase 5 (T5): opciones.ini latencia_audio = auto / baja / alta.
+        tc.Run("SPU2 output latency option: auto adapts 43-128 ms, baja stays low, alta holds 128 ms", [](TestCase &t)
+        {
+            using ps2x::iop::Spu2OutputLatency;
+            using ps2x::iop::detail::Spu2LatencyBounds;
+            using ps2x::iop::detail::spu2LatencyBounds;
+            const Spu2LatencyBounds automatic = spu2LatencyBounds(Spu2OutputLatency::Auto);
+            t.IsTrue(automatic.minimum == 2048u && automatic.maximum == 6144u && automatic.start == 2048u,
+                     "auto: from 43 ms, adapting up to 128 ms (patch 0147)");
+            const Spu2LatencyBounds low = spu2LatencyBounds(Spu2OutputLatency::Low);
+            t.IsTrue(low.minimum == 2048u && low.maximum == 3072u && low.start == 2048u, "baja: 43 ms, at most 64 ms");
+            const Spu2LatencyBounds high = spu2LatencyBounds(Spu2OutputLatency::High);
+            t.IsTrue(high.minimum == 6144u && high.maximum == 6144u && high.start == 6144u, "alta: 128 ms");
+
+            Spu2OutputLatency latency = Spu2OutputLatency::Auto;
+            t.IsTrue(ps2x::iop::parseSpu2OutputLatency("baja", latency) && latency == Spu2OutputLatency::Low, "baja");
+            t.IsTrue(ps2x::iop::parseSpu2OutputLatency("ALTA", latency) && latency == Spu2OutputLatency::High, "alta");
+            t.IsTrue(ps2x::iop::parseSpu2OutputLatency("auto", latency) && latency == Spu2OutputLatency::Auto, "auto");
+            t.IsFalse(ps2x::iop::parseSpu2OutputLatency("media", latency), "an unknown value");
+            t.IsTrue(latency == Spu2OutputLatency::Auto, "leaves the value alone");
+
+            ConsumerRun run; // baja: the underruns raise the target up to 64 ms only
+            run.consumer.setBounds(low);
+            for (int event = 0; event < 6; ++event)
+            {
+                run.queued = run.target.load() + 100u;
+                while (run.pull(1024u) == 1024u)
+                {
+                }
+            }
+            t.Equals(run.underruns, uint64_t{6}, "six underruns");
+            t.Equals(run.target.load(), 3072u, "baja is capped at 64 ms");
+
+            ConsumerRun steady; // alta: never falls below 128 ms
+            steady.consumer.setBounds(high);
+            steady.target.store(high.start);
+            steady.queued = UINT64_MAX / 2u;
+            for (int i = 0; i < 3000; ++i)
+                steady.pull(1024u);
+            t.Equals(steady.target.load(), 6144u, "alta holds 128 ms after a minute without underruns");
+            t.Equals(steady.left[2000u], ConsumerRun::kLevel, "and plays once the ring holds 128 ms");
+
+            ConsumerRun clamped; // a target outside new bounds is brought into them
+            clamped.target.store(6144u);
+            clamped.consumer.setBounds(low);
+            clamped.queued = UINT64_MAX / 2u;
+            clamped.pull(1024u);
+            t.Equals(clamped.target.load(), 3072u, "switching to baja lowers a raised target to 64 ms");
+        });
+
+        tc.Run("SPU2 output mono downmix mixes both channels into each", [](TestCase &t)
+        {
+            int16_t frames[] = {1000, -1000, 32767, 32767, -32768, -32768, 3, 4, 8000, 0};
+            ps2x::iop::detail::downmixToMono(frames, 5u);
+            const int16_t expected[] = {0, 0, 32767, 32767, -32768, -32768, 3, 3, 4000, 4000};
+            bool same = true;
+            for (size_t i = 0; i < 10u; ++i)
+                same = same && frames[i] == expected[i];
+            t.IsTrue(same, "(left + right) / 2 on both channels, without overflow");
+            int16_t untouched[] = {5, 7};
+            ps2x::iop::detail::downmixToMono(untouched, 0u);
+            t.IsTrue(untouched[0] == 5 && untouched[1] == 7, "zero frames change nothing");
+        });
+
     });
 }
