+
+    bool parseSpu2OutputLatency(std::string_view text, Spu2OutputLatency &latency)
+    {
+        std::string lowered(text);
+        for (char &c : lowered)
+            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        if (lowered == "auto")
+            latency = Spu2OutputLatency::Auto;
+        else if (lowered == "baja")
+            latency = Spu2OutputLatency::Low;
+        else if (lowered == "alta")
+            latency = Spu2OutputLatency::High;
+        else
+            return false;
+        return true;
+    }
+
+    void setSpu2OutputLatency(Spu2OutputLatency latency) noexcept
+    {
+        detail::g_latencyRequest.store(static_cast<int>(latency), std::memory_order_relaxed);
+    }
+
+    void setSpu2OutputMono(bool mono) noexcept
+    {
