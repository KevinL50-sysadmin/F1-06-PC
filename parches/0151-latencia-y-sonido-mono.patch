@@ -2,10 +2,26 @@
 
 #include <cstddef>
 #include <cstdint>
+#include <string_view>
 
 namespace ps2x::iop
 {
     // SPU2 output (patch 0111): 48 kHz stereo, interleaved int16. The host audio device pulls it from its own thread.
     // Returns the frames written; the caller fills the rest with silence.
     std::size_t readSpu2Audio(int16_t *interleavedStereo, std::size_t frames) noexcept;
+
+    // Fase 5 (T5, T6; opciones.ini latencia_audio and audio_mono). The output latency: Auto adapts from 43 to 128 ms
+    // (patch 0147), Low keeps 43 ms and rises to 64 ms at most, High holds 128 ms (slow PCs). Mono mixes both channels
+    // into each. Any thread; the device applies them from its next request. The Spu2 starts them from
+    // PS2X_LATENCIA_AUDIO (auto, baja, alta) and PS2X_AUDIO_MONO (1 = mono).
+    enum class Spu2OutputLatency : int
+    {
+        Auto,
+        Low,
+        High,
+    };
+    // auto, baja, alta (case-insensitive); false (latency unchanged) for anything else.
+    bool parseSpu2OutputLatency(std::string_view text, Spu2OutputLatency &latency);
+    void setSpu2OutputLatency(Spu2OutputLatency latency) noexcept;
+    void setSpu2OutputMono(bool mono) noexcept;
 }
