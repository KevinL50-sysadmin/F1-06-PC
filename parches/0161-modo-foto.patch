+// Fase 5 (T13): the photo mode (tecla_modo_foto, F8 by default; ps2_photo_mode.h). The window turns it on and off and
+// hands the held keys and pad to the game's thread, which moves the free camera (src/f1_overrides.cpp); while it is on
+// the sound is muted and the guest's pad is neutral (ps2_pad.cpp).
+namespace
+{
+    std::mutex g_photoModeMutex;
+    std::string g_photoModeKey;
+    bool g_photoModeKeyRead = false;
+    ps2x::PhotoModeSwitch g_photoModeSwitch;
+    ps2x::FreeCameraInput g_photoModeInput;
+    std::atomic<bool> g_photoModeOn{false};
+    std::chrono::steady_clock::time_point g_photoModeClockStart = std::chrono::steady_clock::now();
+
+    double PhotoModeClock()
+    {
+        return std::chrono::duration<double>(std::chrono::steady_clock::now() - g_photoModeClockStart).count();
+    }
+
+    int PhotoModeKeyCode(const std::string &option)
+    {
+        return option == "f8" ? KEY_F8 : option == "f5" ? KEY_F5 : option == "p" ? KEY_P : KEY_NULL;
+    }
+}
+
+static void SetPhotoMessage(const std::string &message);
+
+namespace ps2x
+{
+    void setPhotoModeKeyOption(const std::string &option)
+    {
+        std::lock_guard<std::mutex> lock(g_photoModeMutex);
+        g_photoModeKey = option;
+        g_photoModeKeyRead = true;
+    }
+
+    std::string photoModeKeyOption()
+    {
+        std::lock_guard<std::mutex> lock(g_photoModeMutex);
+        if (!g_photoModeKeyRead)
+        {
+            const char *value = std::getenv("PS2X_TECLA_MODO_FOTO");
+            g_photoModeKey = value != nullptr ? value : "f8";
+            g_photoModeKeyRead = true;
+        }
+        return g_photoModeKey;
+    }
+
+    bool togglePhotoMode()
+    {
+        bool was = false, on = false;
+        {
+            std::lock_guard<std::mutex> lock(g_photoModeMutex);
+            was = g_photoModeSwitch.active();
+            on = g_photoModeSwitch.toggle(PhotoModeClock());
+            g_photoModeInput = {};
+            g_photoModeOn.store(on, std::memory_order_relaxed);
+        }
+        if (!was && !on)
+        {
+            std::cout << "[modo-foto] solo en carrera (no hay camara de carrera dibujando)" << std::endl;
+            SetPhotoMessage("Modo foto: solo en carrera o en la repeticion.");
+            return on;
+        }
+        std::cout << "[modo-foto] " << (on ? "entra" : "sale") << std::endl;
+        SetPhotoMessage(on ? "Modo foto: WASD, R F, flechas, Q E, Z X (o los sticks). Foto con su tecla; sale con la misma."
+                           : "Modo foto: fuera.");
+        return on;
+    }
+
+    bool photoModeActive()
+    {
+        return g_photoModeOn.load(std::memory_order_relaxed);
+    }
+
+    void photoModeCameraFrame()
+    {
+        std::lock_guard<std::mutex> lock(g_photoModeMutex);
+        g_photoModeSwitch.cameraFrame(PhotoModeClock());
+    }
+
+    void setPhotoModeInput(const FreeCameraInput &input)
+    {
+        std::lock_guard<std::mutex> lock(g_photoModeMutex);
+        g_photoModeInput = input;
+    }
+
+    FreeCameraInput photoModeInput()
+    {
+        std::lock_guard<std::mutex> lock(g_photoModeMutex);
+        return g_photoModeInput;
+    }
+}
+
+// The window's part, once per frame (main thread): the key, going off by itself when the race camera stops, and the
+// held keys and pad for the free camera (none while the options menu is open).
+static void UpdatePhotoMode(bool optionsMenuOpen)
+{
+    // The same key as the photos' (F8 in both): the photo goes first and the photo mode has no key.
+    const int key = PhotoModeKeyCode(ps2x::photoModeKeyOption());
+    const bool sharedKey = key != KEY_NULL && key == PhotoKeyCode(ps2x::photoKeyOption());
+    static bool s_sharedKeyLogged = false;
+    if (sharedKey && !s_sharedKeyLogged)
+        std::cerr << "[modo-foto] tecla_modo_foto es la tecla de foto: el modo foto no tiene tecla" << std::endl;
+    s_sharedKeyLogged = sharedKey;
+    if (!optionsMenuOpen && key != KEY_NULL && !sharedKey && IsKeyPressed(key))
+        ps2x::togglePhotoMode();
+    bool wentOff = false;
+    {
+        std::lock_guard<std::mutex> lock(g_photoModeMutex);
+        const bool was = g_photoModeSwitch.active();
+        wentOff = was && !g_photoModeSwitch.stillActive(PhotoModeClock());
+        g_photoModeOn.store(g_photoModeSwitch.active(), std::memory_order_relaxed);
+    }
+    if (wentOff)
+        std::cout << "[modo-foto] sale (la camara de carrera ya no dibuja)" << std::endl;
+    if (!ps2x::photoModeActive())
+        return;
+    ps2x::PhotoModeKeys keys;
+    ps2x::PhotoModePad pad;
+    if (!optionsMenuOpen)
+    {
+        keys.forward = IsKeyDown(KEY_W);
+        keys.back = IsKeyDown(KEY_S);
+        keys.left = IsKeyDown(KEY_A);
+        keys.right = IsKeyDown(KEY_D);
+        keys.up = IsKeyDown(KEY_R);
+        keys.down = IsKeyDown(KEY_F);
+        keys.turnLeft = IsKeyDown(KEY_LEFT);
+        keys.turnRight = IsKeyDown(KEY_RIGHT);
+        keys.lookUp = IsKeyDown(KEY_UP);
+        keys.lookDown = IsKeyDown(KEY_DOWN);
+        keys.rollLeft = IsKeyDown(KEY_Q);
+        keys.rollRight = IsKeyDown(KEY_E);
+        keys.zoomIn = IsKeyDown(KEY_Z);
+        keys.zoomOut = IsKeyDown(KEY_X);
+        keys.fast = IsKeyDown(KEY_LEFT_SHIFT) || IsKeyDown(KEY_RIGHT_SHIFT);
+        keys.slow = IsKeyDown(KEY_LEFT_CONTROL) || IsKeyDown(KEY_RIGHT_CONTROL);
+        keys.reset = IsKeyDown(KEY_BACKSPACE);
+        pad = ps2x::readPhotoModePad();
+    }
+    ps2x::setPhotoModeInput(ps2x::freeCameraInput(keys, pad));
+}
