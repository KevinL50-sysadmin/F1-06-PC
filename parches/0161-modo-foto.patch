diff --git a/ps2xRuntime/src/lib/ps2_photo_mode.h b/ps2xRuntime/src/lib/ps2_photo_mode.h
new file mode 100644
index 0000000..09e86df
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_photo_mode.h
@@ -0,0 +1,259 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <string>
+
+// Fase 5 (T13, F1 06): the photo mode (opciones.ini tecla_modo_foto: f8, f5, p or no). The key freezes the race (the
+// game's simulation steps stop; it keeps drawing), hides the HUD, mutes the sound and hands the race camera to a free
+// camera moved with the keyboard and the pad; the photo key (tecla_foto) takes the picture and the same key goes back.
+// The window's thread reads the input (ps2_runtime.cpp); the game's thread moves the camera on each of its frames and
+// gives it to the game (src/f1_overrides.cpp).
+namespace ps2x
+{
+    // The game's camera matrix (as func_2C5948 takes it): 16 floats, rows 0-2 the camera's axes in the world (row 0
+    // across the screen, row 1 up the screen, row 2 where it looks) and row 3 its position. The world's up is +y.
+    // kFreeCameraRightSign: the screen's right is row 0 times this.
+    constexpr float kFreeCameraRightSign = 1.0f;
+    constexpr float kFreeCameraSpeed = 8.0f;       // world units (metres) per second
+    constexpr float kFreeCameraTurnRate = 1.2f;    // radians per second
+    constexpr float kFreeCameraRollRate = 0.8f;    // radians per second
+    constexpr float kFreeCameraZoomRate = 0.9f;    // the half angle changes by e^(rate) per second
+    constexpr float kFreeCameraMaxPitch = 1.45f;   // about 83 degrees up or down
+    constexpr float kFreeCameraMaxRoll = 0.8f;     // about 45 degrees
+    constexpr float kFreeCameraMinHalfAngle = 0.05f;
+    constexpr float kFreeCameraMaxHalfAngle = 1.2f;
+    constexpr float kFreeCameraMaxDistance = 30.0f; // from where it started: the game keeps the scenery around it
+    constexpr float kFreeCameraMaxDrop = 0.6f;      // under where it started (the ground's height is not known)
+    constexpr float kFreeCameraMaxStep = 0.1f;      // seconds: a long frame does not throw the camera away
+
+    struct FreeCamera
+    {
+        float position[3] = {0.0f, 0.0f, 0.0f};
+        float yaw = 0.0f, pitch = 0.0f, roll = 0.0f; // radians
+        float halfAngle = 0.5f;                      // vertical, as the game's (camera + 0x88)
+        float start[3] = {0.0f, 0.0f, 0.0f};
+        float startYaw = 0.0f, startPitch = 0.0f, startRoll = 0.0f, startHalfAngle = 0.5f;
+    };
+
+    // -1 to 1 each (speed: a factor). forward: where it looks, level; right: across the screen, level; up: the world's up
+    // (down to kFreeCameraMaxDrop under where it started); yaw: to the right; pitch: up; roll: clockwise; zoom: in (a
+    // narrower angle).
+    struct FreeCameraInput
+    {
+        float forward = 0.0f, right = 0.0f, up = 0.0f;
+        float yaw = 0.0f, pitch = 0.0f, roll = 0.0f;
+        float zoom = 0.0f;
+        float speed = 1.0f;
+        bool reset = false;
+    };
+
+    namespace photo_mode_detail
+    {
+        inline void levelAxes(float yaw, float pitch, float forward[3], float across[3], float up[3])
+        {
+            forward[0] = std::cos(pitch) * std::sin(yaw);
+            forward[1] = std::sin(pitch);
+            forward[2] = std::cos(pitch) * std::cos(yaw);
+            across[0] = std::cos(yaw); // (0, 1, 0) x forward, normalised
+            across[1] = 0.0f;
+            across[2] = -std::sin(yaw);
+            up[0] = forward[1] * across[2] - forward[2] * across[1]; // forward x across
+            up[1] = forward[2] * across[0] - forward[0] * across[2];
+            up[2] = forward[0] * across[1] - forward[1] * across[0];
+        }
+
+        inline float dot(const float *a, const float *b)
+        {
+            return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+        }
+
+        inline float clampUnit(float value)
+        {
+            return std::isfinite(value) ? std::clamp(value, -1.0f, 1.0f) : 0.0f;
+        }
+    }
+
+    // The free camera where the game's is: same place, direction, roll and angle (the matrix it gives back is the
+    // game's). That is also where it goes back with input.reset and the centre of kFreeCameraMaxDistance.
+    inline FreeCamera freeCameraFromMatrix(const float m[16], float halfAngle)
+    {
+        using namespace photo_mode_detail;
+        FreeCamera camera;
+        for (int i = 0; i < 3; ++i)
+            camera.position[i] = camera.start[i] = std::isfinite(m[12 + i]) ? m[12 + i] : 0.0f;
+        camera.pitch = std::clamp(std::asin(clampUnit(m[9])), -kFreeCameraMaxPitch, kFreeCameraMaxPitch);
+        camera.yaw = (m[8] == 0.0f && m[10] == 0.0f) ? 0.0f : std::atan2(m[8], m[10]);
+        if (!std::isfinite(camera.yaw))
+            camera.yaw = 0.0f;
+        float forward[3], across[3], up[3];
+        levelAxes(camera.yaw, camera.pitch, forward, across, up);
+        const float roll = std::atan2(dot(m, up), dot(m, across));
+        camera.roll = std::isfinite(roll) ? std::clamp(roll, -kFreeCameraMaxRoll, kFreeCameraMaxRoll) : 0.0f;
+        camera.halfAngle = std::isfinite(halfAngle) && halfAngle > 0.0f
+                               ? std::clamp(halfAngle, kFreeCameraMinHalfAngle, kFreeCameraMaxHalfAngle)
+                               : 0.5f;
+        camera.startYaw = camera.yaw;
+        camera.startPitch = camera.pitch;
+        camera.startRoll = camera.roll;
+        camera.startHalfAngle = camera.halfAngle;
+        return camera;
+    }
+
+    // The camera's matrix for the game (the layout above; w = 0, 0, 0, 1).
+    inline void freeCameraMatrix(const FreeCamera &camera, float m[16])
+    {
+        float forward[3], across[3], up[3];
+        photo_mode_detail::levelAxes(camera.yaw, camera.pitch, forward, across, up);
+        const float c = std::cos(camera.roll), s = std::sin(camera.roll);
+        for (int i = 0; i < 3; ++i)
+        {
+            m[i] = across[i] * c + up[i] * s;
+            m[4 + i] = up[i] * c - across[i] * s;
+            m[8 + i] = forward[i];
+            m[12 + i] = camera.position[i];
+        }
+        m[3] = m[7] = m[11] = 0.0f;
+        m[15] = 1.0f;
+    }
+
+    // One step of seconds (at most kFreeCameraMaxStep): moves, turns and zooms, within the limits.
+    inline void moveFreeCamera(FreeCamera &camera, const FreeCameraInput &input, float seconds)
+    {
+        using photo_mode_detail::clampUnit;
+        if (input.reset)
+        {
+            for (int i = 0; i < 3; ++i)
+                camera.position[i] = camera.start[i];
+            camera.yaw = camera.startYaw;
+            camera.pitch = camera.startPitch;
+            camera.roll = camera.startRoll;
+            camera.halfAngle = camera.startHalfAngle;
+            return;
+        }
+        if (!std::isfinite(seconds) || seconds <= 0.0f)
+            return;
+        const float dt = std::min(seconds, kFreeCameraMaxStep);
+        const float speed = std::isfinite(input.speed) ? std::clamp(input.speed, 0.0f, 10.0f) : 1.0f;
+
+        camera.yaw += clampUnit(input.yaw) * kFreeCameraRightSign * kFreeCameraTurnRate * dt;
+        camera.yaw = std::remainder(camera.yaw, 6.28318530718f);
+        camera.pitch = std::clamp(camera.pitch + clampUnit(input.pitch) * kFreeCameraTurnRate * dt,
+                                  -kFreeCameraMaxPitch, kFreeCameraMaxPitch);
+        camera.roll = std::clamp(camera.roll - clampUnit(input.roll) * kFreeCameraRightSign * kFreeCameraRollRate * dt,
+                                 -kFreeCameraMaxRoll, kFreeCameraMaxRoll);
+        camera.halfAngle = std::clamp(camera.halfAngle * std::exp(-clampUnit(input.zoom) * kFreeCameraZoomRate * dt),
+                                      kFreeCameraMinHalfAngle, kFreeCameraMaxHalfAngle);
+
+        float forward[3], across[3], up[3];
+        photo_mode_detail::levelAxes(camera.yaw, camera.pitch, forward, across, up);
+        const float step = kFreeCameraSpeed * speed * dt;
+        const float f = clampUnit(input.forward) * step, r = clampUnit(input.right) * kFreeCameraRightSign * step,
+                    u = clampUnit(input.up) * step;
+        // Forward and back stay level (looking down does not sink it into the track); up and down are the world's.
+        const float level = std::sqrt(forward[0] * forward[0] + forward[2] * forward[2]);
+        camera.position[0] += (level > 0.0f ? forward[0] / level : 0.0f) * f + across[0] * r;
+        camera.position[1] = std::max(camera.position[1] + u, camera.start[1] - kFreeCameraMaxDrop);
+        camera.position[2] += (level > 0.0f ? forward[2] / level : 0.0f) * f + across[2] * r;
+        float offset[3];
+        for (int i = 0; i < 3; ++i)
+            offset[i] = camera.position[i] - camera.start[i];
+        const float distance = std::sqrt(photo_mode_detail::dot(offset, offset));
+        if (distance > kFreeCameraMaxDistance)
+            for (int i = 0; i < 3; ++i)
+                camera.position[i] = camera.start[i] + offset[i] * (kFreeCameraMaxDistance / distance);
+    }
+
+    // The controls (fixed): what is held on the keyboard and the pad, read by the window.
+    struct PhotoModeKeys
+    {
+        bool forward = false, back = false, left = false, right = false, up = false, down = false; // W S A D R F
+        bool turnLeft = false, turnRight = false, lookUp = false, lookDown = false;               // arrows
+        bool rollLeft = false, rollRight = false;                                                 // Q E
+        bool zoomIn = false, zoomOut = false;                                                     // Z X
+        bool fast = false, slow = false;                                                          // Shift, Ctrl
+        bool reset = false;                                                                       // Backspace
+    };
+
+    // The pad: sticks -1 to 1 (up = -1, as the PS2's), triggers 0 to 1 and the PS2 button bits (1 = pressed).
+    struct PhotoModePad
+    {
+        float leftX = 0.0f, leftY = 0.0f, rightX = 0.0f, rightY = 0.0f;
+        float l2 = 0.0f, r2 = 0.0f;
+        uint16_t pressed = 0u;
+    };
+
+    // PS2 pad bits (libpad order, as ps2_options_menu.h's).
+    constexpr uint16_t kPhotoPadUp = 1u << 4, kPhotoPadDown = 1u << 6, kPhotoPadL1 = 1u << 10,
+                       kPhotoPadR1 = 1u << 11, kPhotoPadTriangle = 1u << 12, kPhotoPadCross = 1u << 14,
+                       kPhotoPadSquare = 1u << 15;
+
+    // Keyboard: W S A D move, R F up and down, arrows turn, Q E roll, Z X zoom, Shift fast (x4), Ctrl slow (x0.25),
+    // Backspace back to the start. Pad: left stick moves, right stick turns, R2 L2 up and down, L1 R1 roll, the d-pad's
+    // up and down zoom, cross fast, square slow, triangle back to the start.
+    inline FreeCameraInput freeCameraInput(const PhotoModeKeys &keys, const PhotoModePad &pad)
+    {
+        using photo_mode_detail::clampUnit;
+        const auto axis = [](bool negative, bool positive) { return (positive ? 1.0f : 0.0f) - (negative ? 1.0f : 0.0f); };
+        const auto held = [&pad](uint16_t bit) { return (pad.pressed & bit) != 0u; };
+        FreeCameraInput input;
+        input.forward = clampUnit(axis(keys.back, keys.forward) - pad.leftY);
+        input.right = clampUnit(axis(keys.left, keys.right) + pad.leftX);
+        input.up = clampUnit(axis(keys.down, keys.up) + pad.r2 - pad.l2);
+        input.yaw = clampUnit(axis(keys.turnLeft, keys.turnRight) + pad.rightX);
+        input.pitch = clampUnit(axis(keys.lookDown, keys.lookUp) - pad.rightY);
+        input.roll = clampUnit(axis(keys.rollLeft || held(kPhotoPadL1), keys.rollRight || held(kPhotoPadR1)));
+        input.zoom = clampUnit(axis(keys.zoomOut || held(kPhotoPadDown), keys.zoomIn || held(kPhotoPadUp)));
+        const bool fast = keys.fast || held(kPhotoPadCross), slow = keys.slow || held(kPhotoPadSquare);
+        input.speed = fast && !slow ? 4.0f : slow && !fast ? 0.25f : 1.0f;
+        input.reset = keys.reset || held(kPhotoPadTriangle);
+        return input;
+    }
+
+    // On and off: the key turns it on only while a race camera is drawing (cameraFrame in the last kEnterWindow
+    // seconds) and it goes off by itself when no race camera has drawn for kLeaveAfter seconds (the race ended).
+    class PhotoModeSwitch
+    {
+    public:
+        static constexpr double kEnterWindow = 0.5;
+        static constexpr double kLeaveAfter = 2.0;
+
+        bool active() const { return m_active; }
+        void cameraFrame(double now) { m_lastCamera = now; }
+        // The key: the new state (off -> on refused outside a race).
+        bool toggle(double now)
+        {
+            if (m_active)
+                m_active = false;
+            else if (m_lastCamera >= 0.0 && now - m_lastCamera <= kEnterWindow)
+                m_active = true;
+            return m_active;
+        }
+        // Every frame of the window: false when it went off by itself now.
+        bool stillActive(double now)
+        {
+            if (m_active && (m_lastCamera < 0.0 || now - m_lastCamera > kLeaveAfter))
+                m_active = false;
+            return m_active;
+        }
+
+    private:
+        bool m_active = false;
+        double m_lastCamera = -1.0;
+    };
+
+    // The shared state (ps2_runtime.cpp; any thread). The window: setPhotoModeKeyOption from the menus,
+    // togglePhotoMode with the key or PS2X_MENU_GUION's "modo_foto", setPhotoModeInput on each of its frames. The game:
+    // photoModeCameraFrame when a race camera draws, photoModeActive and photoModeInput.
+    void setPhotoModeKeyOption(const std::string &option);
+    std::string photoModeKeyOption();
+    bool togglePhotoMode();
+    bool photoModeActive();
+    void photoModeCameraFrame();
+    void setPhotoModeInput(const FreeCameraInput &input);
+    FreeCameraInput photoModeInput();
+
+    // ps2_pad.cpp (the window's thread): the pad of controles.ini for the free camera (not its keys, as readMenuPad).
+    PhotoModePad readPhotoModePad();
+}
