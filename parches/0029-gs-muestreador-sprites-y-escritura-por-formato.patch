+const uint32_t *GSCpuBackend::PreparePalette(const GSDrawState &state)
+{
+    // Everything LookupCLUT reads besides the index and m_clut.
+    const auto &tex = state.context.tex0;
+    const bool fourBit = isFourBitIndexedPsm(tex.psm);
+    const uint64_t key = static_cast<uint64_t>(tex.cpsm) | (static_cast<uint64_t>(tex.csm) << 8) |
+                         (static_cast<uint64_t>(tex.csa) << 16) | (static_cast<uint64_t>(fourBit) << 24) |
+                         (static_cast<uint64_t>(isEightBitIndexedPsm(tex.psm)) << 25) |
+                         (static_cast<uint64_t>(state.texa.ta0) << 32) | (static_cast<uint64_t>(state.texa.ta1) << 40) |
+                         (static_cast<uint64_t>(state.texa.aem) << 48);
+    if (m_paletteGeneration != m_clutGeneration || m_paletteKey != key)
+    {
+        // 4-bit textures only have indices 0-15.
+        const uint32_t count = fourBit ? 16u : 256u;
+        for (uint32_t index = 0; index < count; ++index)
+            m_palette[index] = LookupCLUT(state, static_cast<uint8_t>(index), tex.cpsm, tex.csm, tex.csa, tex.psm);
+        m_paletteGeneration = m_clutGeneration;
+        m_paletteKey = key;
+    }
+    return m_palette.data();
+}
