+                                               kL1, kL2, kR1, kR2};
+        for (int i = 0; i < 12; ++i)
+        {
+            const float v = value[kPressureOrder[i]];
+            data[8 + i] = v >= cfg.buttonThreshold
+                              ? static_cast<uint8_t>(std::clamp(static_cast<int>(std::lround(v * 255.0f)), 1, 255))
+                              : 0u;
+        }
+        data[20] = 1u; // presiones validas (Pad.cpp)
+    }
