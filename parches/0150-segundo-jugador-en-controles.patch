+        data[6] = stick(kLsLeft, kLsRight);
+        data[7] = stick(kLsUp, kLsDown);
+
+        // Presiones (bytes 8-19 del DualShock 2): derecha, izquierda, arriba, abajo, triangulo, circulo, cruz,
