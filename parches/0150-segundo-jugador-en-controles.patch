+    {
+        if (index < 0 || index > 3)
+            return;
+        if (XInputSetStateFn fn = loadXInputSetState())
+        {
+            XINPUT_VIBRATION v{};
+            v.wRightMotorSpeed = static_cast<WORD>(std::clamp(smallMotor, 0.0f, 1.0f) * 65535.0f);
+            v.wLeftMotorSpeed = static_cast<WORD>(std::clamp(largeMotor, 0.0f, 1.0f) * 65535.0f);
+            fn(static_cast<DWORD>(index), &v);
+        }
+    }
