diff --git a/ps2xRuntime/src/lib/ps2_pad_players.h b/ps2xRuntime/src/lib/ps2_pad_players.h
new file mode 100644
index 0000000..e668e3a
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_pad_players.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+// Patch 0150 (F1 06, fase 4): the second player of controles.ini ([jugador2]) on the PS2's second pad port, for split
+// screen. Without that section the second port stays disconnected, as in patch 0123.
+namespace ps2x
+{
+    struct PadPlayerInfo
+    {
+        bool configured = false; // player 1 always; player 2 only with a [jugador2] section
+        int gamepad = -1;        // raylib gamepad it reads (-1 = none)
+        bool rumble = false;
+        int keyInputs = 0;       // tecla: entries in its controls
+        int gamepadInputs = 0;   // mando: entries
+        int wheelInputs = 0;     // volante: entries (player 1 only)
+        // Every control with its inputs, in the order of the PS2 report: "cruz=tecla:X,mando:A,volante:Y~".
+        std::vector<std::string> controls;
+    };
+
+    struct PadPlayersInfo
+    {
+        PadPlayerInfo players[2];
+        std::vector<std::string> messages; // the warnings the game logs as "[pad] <message>"
+    };
+
+    // Parses a controles.ini text over the defaults, as the game does (without reading or writing any file).
+    // noDevices: PS2X_SIN_MANDOS (no physical gamepad for anybody).
+    PadPlayersInfo describePadPlayers(const std::string &iniText, bool noDevices);
+    // Whether the second port has a controller: player 2 configured with some key, or with its gamepad present.
+    bool secondPadPortConnected(const PadPlayerInfo &player2, bool gamepadPresent);
+
+    // The game's controles.ini: whether a PS2 port (0 or 1) has a controller, and the motors of that port's pad.
+    bool padPortConnected(int port);
+    void setPadPortRumble(int port, float smallMotor, float largeMotor);
+}
