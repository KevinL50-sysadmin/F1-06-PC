+    void writeReport(uint8_t *data, uint16_t pressed, const float (&value)[kTargetCount], const Config &cfg)
+    {
+        const uint16_t buttons = static_cast<uint16_t>(~pressed);
+        data[2] = static_cast<uint8_t>(buttons & 0xFFu);
+        data[3] = static_cast<uint8_t>(buttons >> 8);
+
+        auto stick = [&value](int negative, int positive)
+        {
+            const float v = std::clamp(value[positive] - value[negative], -1.0f, 1.0f);
+            return static_cast<uint8_t>(std::clamp(static_cast<int>(std::lround(127.5f + v * 127.5f)), 0, 255));
+        };
