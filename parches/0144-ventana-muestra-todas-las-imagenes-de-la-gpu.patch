+static uint64_t PictureHash(const std::vector<uint8_t> &pixels)
+{
+    uint64_t hash = 0x9E3779B97F4A7C15ull;
+    const size_t words = pixels.size() / 8u;
+    for (size_t i = 0; i < words; ++i)
+    {
+        uint64_t word = 0;
+        std::memcpy(&word, pixels.data() + i * 8u, sizeof(word));
+        hash = (hash ^ word) * 0x100000001B3ull;
+    }
+    return hash ^ pixels.size();
+}
