+    void FramePacingStats::frame(double seconds, bool newPicture)
+    {
+        m_endedStall = 0.0;
+        if (!m_started)
+        {
+            m_started = true;
+            m_windowStart = m_lastFrame = seconds;
+            m_hasPicture = newPicture;
+            m_lastPicture = seconds;
+            m_framesSincePicture = 0;
+            return;
+        }
+        const double ms = 1000.0 * (seconds - m_lastFrame);
+        m_lastFrame = seconds;
+        ++m_frames;
+        m_sumMs += ms;
+        m_sumSquaresMs += ms * ms;
+        m_maxMs = std::max(m_maxMs, ms);
+        ++m_framesSincePicture;
+        if (!newPicture)
+            return;
+        ++m_pictures;
+        if (m_hasPicture)
+            ++m_holds[m_framesSincePicture];
+        m_endedStall = seconds - m_lastPicture;
+        m_longestStall = std::max(m_longestStall, m_endedStall);
+        m_hasPicture = true;
+        m_lastPicture = seconds;
+        m_framesSincePicture = 0;
+    }
+
+    bool FramePacingStats::take(double period, Window &out)
+    {
+        if (!m_started || m_lastFrame - m_windowStart < period || m_frames == 0)
+            return false;
+        out.seconds = m_lastFrame - m_windowStart;
+        out.windowFrames = m_frames;
+        out.meanMs = m_sumMs / m_frames;
+        out.stddevMs = std::sqrt(std::max(0.0, m_sumSquaresMs / m_frames - out.meanMs * out.meanMs));
+        out.maxMs = m_maxMs;
+        out.pictures = m_pictures;
+        out.holds = m_holds;
+        // A stall still going on counts up to now.
+        out.longestStallMs = 1000.0 * std::max(m_longestStall, m_lastFrame - m_lastPicture);
+        m_windowStart = m_lastFrame;
+        m_frames = m_pictures = 0;
+        m_sumMs = m_sumSquaresMs = m_maxMs = m_longestStall = 0.0;
+        m_holds.clear();
+        return true;
+    }
