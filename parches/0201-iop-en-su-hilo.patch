+void PS2IopHostAdapter::queueEffect(uint8_t kind, uint32_t value, const void *bytes, size_t size)
+{
+    IopEffect effect;
+    effect.kind = kind;
+    effect.value = value;
+    effect.offset = static_cast<uint32_t>(m_effectBytes.size());
+    effect.size = static_cast<uint32_t>(size);
+    if (bytes && size != 0u)
+    {
+        const auto *first = static_cast<const uint8_t *>(bytes);
+        m_effectBytes.insert(m_effectBytes.end(), first, first + size);
+    }
+    m_effects.push_back(effect);
+}
+
+void PS2IopHostAdapter::applyEffects()
+{
+    m_applyingEffects = true;
+    for (const IopEffect &effect : m_effects)
+    {
+        const uint8_t *const bytes = m_effectBytes.data() + effect.offset;
+        switch (effect.kind)
+        {
+        case 0u:
+            (void)writeGuest(effect.value, bytes, effect.size);
+            break;
+        case 1u:
+            (void)zeroGuest(effect.value, effect.size);
+            break;
+        default:
+            (void)sendSifCommand(effect.value, effect.size != 0u ? bytes : nullptr, effect.size);
+            break;
+        }
+    }
+    m_effects.clear();
+    m_effectBytes.clear();
+    m_applyingEffects = false;
+}
+
+void PS2IopHostAdapter::workerMain()
+{
+    ThreadNaming::SetCurrentThreadName("IOP");
+    t_onIopWorker = true;
+    for (;;)
+    {
+        if (waitWhile(m_batchState, 0u, kHandOffSpins) == 2u)
+        {
+            return;
+        }
+        const auto start = std::chrono::steady_clock::now();
+        m_batchIop->runEeCycles(m_batchCycles);
+        m_workerBusyNs.fetch_add(nanosecondsSince(start), std::memory_order_relaxed);
+        m_batchState.store(0u, std::memory_order_release);
+        m_batchState.notify_all();
+    }
+}
+
+void PS2IopHostAdapter::handOffBatch(ps2x::iop::IopSubsystem &iop, uint64_t eeCycles)
+{
+    if (!m_workerStarted.load(std::memory_order_acquire))
+    {
+        m_handOffThread.store(std::this_thread::get_id(), std::memory_order_relaxed);
+        m_worker = std::thread(&PS2IopHostAdapter::workerMain, this);
+        m_workerStarted.store(true, std::memory_order_release);
+    }
+    else
+    {
+        m_handOffThread.store(std::this_thread::get_id(), std::memory_order_relaxed);
+        (void)iopSync();
+    }
+    m_batchIop = &iop;
+    m_batchCycles = eeCycles;
+    ++m_stats.handOffs;
+    m_batchState.store(1u, std::memory_order_release);
+    m_batchState.notify_all();
+}
+
+bool PS2IopHostAdapter::iopSync()
+{
+    if (!m_workerStarted.load(std::memory_order_acquire) ||
+        m_handOffThread.load(std::memory_order_relaxed) != std::this_thread::get_id())
+    {
+        return false;
+    }
+    if (m_batchState.load(std::memory_order_acquire) == 1u)
+    {
+        const auto start = std::chrono::steady_clock::now();
+        (void)waitWhile(m_batchState, 1u, kHandOffSpins);
+        ++m_stats.waits;
+        m_stats.waitNs += nanosecondsSince(start);
+    }
+    if (m_effects.empty() || m_applyingEffects)
+    {
+        return false;
+    }
+    applyEffects();
+    return true;
+}
+
+bool PS2IopHostAdapter::iopBatchInFlight() const noexcept
+{
+    return m_batchState.load(std::memory_order_acquire) == 1u;
+}
+
+void PS2IopHostAdapter::stopIopWorker()
+{
+    if (!m_workerStarted.load(std::memory_order_acquire))
+    {
+        return;
+    }
+    (void)waitWhile(m_batchState, 1u, 0u);
+    m_batchState.store(2u, std::memory_order_release);
+    m_batchState.notify_all();
+    if (m_worker.joinable())
+    {
+        m_worker.join();
+    }
+    m_batchState.store(0u, std::memory_order_release);
+    m_workerStarted.store(false, std::memory_order_release);
+    m_effects.clear();
+    m_effectBytes.clear();
+}
+
+PS2IopHostAdapter::WorkerStats PS2IopHostAdapter::takeWorkerStats()
+{
+    WorkerStats stats = m_stats;
+    stats.busyNs = m_workerBusyNs.exchange(0u, std::memory_order_relaxed);
+    m_stats = WorkerStats{};
+    return stats;
+}
