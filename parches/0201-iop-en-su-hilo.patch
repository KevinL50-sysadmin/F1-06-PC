+            const uint32_t expected = count >= slot ? (count - slot) / 64u * 64u + slot : 0u;
+            rings = rings && env.eeWord(kWorkerRingA + slot * 4u) == expected &&
+                    env.eeWord(kWorkerRingB + slot * 4u) == expected;
+        }
+        t.IsTrue(rings, what + ": the rings hold the last counter of each slot");
