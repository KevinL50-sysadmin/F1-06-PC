+    // Pauses this many times for the state to leave `from`, then sleeps on it (both sides of the hand-off: a batch
+    // lasts tens of microseconds and the next one comes about 1 ms later).
+    constexpr uint32_t kHandOffSpins = 256u;
+
+    uint32_t waitWhile(std::atomic<uint32_t> &state, uint32_t from, uint32_t spins)
+    {
+        uint32_t value = state.load(std::memory_order_acquire);
+        for (uint32_t i = 0u; value == from && i < spins; ++i)
+        {
+            _mm_pause();
+            value = state.load(std::memory_order_acquire);
+        }
+        while (value == from)
+        {
+            state.wait(from, std::memory_order_acquire);
+            value = state.load(std::memory_order_acquire);
+        }
+        return value;
+    }
+
+    uint64_t nanosecondsSince(std::chrono::steady_clock::time_point start)
+    {
+        return static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count());
+    }
+}
