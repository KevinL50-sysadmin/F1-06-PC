+        // The counters in the SIF command packets the EE received (guestMalloc'd in order), by address.
+        std::vector<uint32_t> packetCounters() const
+        {
+            std::vector<uint32_t> counters;
+            for (uint32_t address = 0u; address + 32u <= PS2_GUEST_RAM_SIZE; address += 16u)
+            {
+                uint32_t words[5];
