@@ -417,9 +420,33 @@ void EeScheduler::run()
         {
             m_insideInterrupt = !running->invocations.empty() && running->invocations.back().kind == GuestInvocationKind::Interrupt;
             m_guestExecuting.store(true, std::memory_order_release);
+            const uint32_t dispatchedPc = context.pc;
+            const int dispatchedThread = running->id;
+            const size_t dispatchedInvocations = running->invocations.size();
+            const uint64_t transferSerial = ps2EeControlTransferSerial();
             function(m_rdram, &context, &m_runtime);
             m_guestExecuting.store(false, std::memory_order_release);
             m_insideInterrupt = false;
+            // Implicit return, as in dispatchGuestBranch: a function that leaves ctx->pc untouched without yielding
+            // or jumping is an HLE stub or override (they do not set pc = $ra) that has returned. This happens when a
+            // checkpoint fell due right at the call boundary: dispatchGuestBranch gave the thread back with pc = the
+            // callee's entry and this loop resumed it here. Without this the loop called the stub again forever
+            // (F1 06 hang in the menus: sceMpegIsEnd, replaced by videoTerminado, ~13 M times/s for minutes).
+            // A guest function that ended with "jr $ra" already has pc == $ra, so this changes nothing for it (it
+            // happens with self-recursive functions, whose inner call the recompiler turns into a goto: F1 06's
+            // func_2F8D48 comes back here with pc == $ra == 0x2F8EF8 or 0x2F8F08).
+            if (context.pc == dispatchedPc && ps2EeControlTransferSerial() == transferSerial)
+            {
+                const uint32_t returnPc = getRegU32(&context, 31);
+                static uint32_t s_implicitReturnLogs = 0u;
+                if (returnPc != dispatchedPc && s_implicitReturnLogs < 32u)
+                {
+                    ++s_implicitReturnLogs;
+                    std::fprintf(stderr, "[ee:vuelta-implicita] pc=0x%x ra=0x%x hilo=%d invocaciones=%zu\n",
+                                 dispatchedPc, returnPc, dispatchedThread, dispatchedInvocations);
+                }
+                context.pc = returnPc;
+            }
             if (countDispatch)
                 eeDispatchCount(1, context.pc, 0u, 0);
         }
