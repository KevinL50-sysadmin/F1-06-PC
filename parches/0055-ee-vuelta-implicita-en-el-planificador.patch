+// For EeScheduler::run (declared there, so ps2_runtime.h stays untouched): changes whenever a dispatch yielded at a
+// checkpoint or jumped, so the scheduler can apply the same implicit-return rule as dispatchGuestBranch.
+uint64_t ps2EeControlTransferSerial() noexcept
+{
+    return g_eeCheckpointSerial + g_eeJumpSerial;
+}
