+namespace
+{
+    // Patch 0100: how the PS2 picture fills the window. The PS2 sends its frame (640x448 NTSC, 640x512 PAL...) to a
+    // 4:3 TV whatever its size in pixels, so the picture goes to the largest 4:3 rectangle (16:9 for the games set to
+    // widescreen, which draw anamorphic) instead of keeping square pixels (a 640x512 frame came out at 1.25:1).
+    // PS2X_ASPECTO=4:3 (default), 16:9 or pixel (square pixels, as before); F10 cycles them while running.
+    enum class PresentAspect
+    {
+        Tv4x3,
+        Wide16x9,
+        Pixel
+    };
+    PresentAspect initialPresentAspect()
+    {
+        const char *value = std::getenv("PS2X_ASPECTO");
+        if (value != nullptr && std::strcmp(value, "16:9") == 0)
+            return PresentAspect::Wide16x9;
+        if (value != nullptr && std::strcmp(value, "pixel") == 0)
+            return PresentAspect::Pixel;
+        return PresentAspect::Tv4x3;
+    }
+}
