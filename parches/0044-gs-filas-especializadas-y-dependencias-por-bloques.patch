+    }();
+    int wanted = s_kind == 2 && !bandWorker ? 0 : s_kind;
+    if (bandWorker && g_ps2AbMode.load(std::memory_order_relaxed) == 14)
+        wanted = 2;
+    if (wanted != applied)
+    {
+        ThreadNaming::SetCoreKind(wanted);
+        applied = wanted;
+    }
+    ++chunks;
+    if (ThreadNaming::OnEfficiencyCore())
+        ++onEfficiency;
+}
