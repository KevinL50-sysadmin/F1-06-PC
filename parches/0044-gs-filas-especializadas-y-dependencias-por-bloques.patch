+// PS2X_GS_NUCLEOS=1 keeps them on the performance cores, =2 the band workers on the efficiency cores; A/B mode 14:
+// the band workers on the efficiency cores. Called by each GS thread between chunks of work: applies a change.
+void ps2GsThreadCores(int &applied, uint32_t &chunks, uint32_t &onEfficiency, bool bandWorker)
+{
+    static const int s_kind = []
+    {
+        const char *value = std::getenv("PS2X_GS_NUCLEOS");
