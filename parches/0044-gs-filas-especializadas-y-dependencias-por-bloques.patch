+void ThreadNaming::SetCoreKind(int kind)
+{
+    const HostCores &c = hostCores();
+    // THREAD_POWER_THROTTLING_STATE {Version 1, ControlMask, StateMask}: execution speed (1) controlled and off.
+    unsigned long state[3] = {1u, kind == 1 ? 1u : 0u, 0u};
+    SetThreadInformation(GetCurrentThread(), 3 /* ThreadPowerThrottling */, state, sizeof(state));
+    if (!c.hybrid)
+        return;
+    if (kind == 1)
+        SetThreadSelectedCpuSets(GetCurrentThread(), c.performanceIds, c.performanceCount);
+    else if (kind == 2)
+        SetThreadSelectedCpuSets(GetCurrentThread(), c.efficiencyIds, c.efficiencyCount);
+    else
+        SetThreadSelectedCpuSets(GetCurrentThread(), nullptr, 0u);
