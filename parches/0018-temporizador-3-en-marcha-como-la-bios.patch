@@ -403,6 +403,11 @@ bool PS2Memory::initialize(size_t ramSize)
 void PS2Memory::resetEeTimers() noexcept
 {
     m_eeTimers = {};
+    // The EE kernel starts timer 3 at boot, free-running on the H-blank clock (it backs SetAlarm).
+    // The runtime implements alarms in its scheduler, but games also read T3_COUNT directly: F1 06
+    // measures GPU time in scanlines and busy-waits for the next one (func_2D5560), so it hung with
+    // a stopped T3. Start it like the BIOS does, without compare/overflow interrupts.
+    m_eeTimers[3].mode = kEeTimerModeCue | 3u;
 }
 
 uint32_t PS2Memory::advanceEeTimers(uint64_t eeCycles) noexcept
