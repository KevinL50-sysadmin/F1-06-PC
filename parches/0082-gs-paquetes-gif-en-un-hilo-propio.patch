+    // Patch 0082: the GIF packets that the arbiter lets through (PATH1 from XGKICK, PATH2, PATH3), processed by
+    // GS::processGIFPacket on a thread of their own. In a race that work (register writes, vertex kicks, the draw
+    // batches and the queueing for the rasterizer) was ~12 % of the EE thread. The packets keep their order: the EE
+    // thread copies each one into a ring (one producer, one consumer) and the "GS GIF" thread processes them in turn.
+    // Everything else that reads or changes the GS state from the EE thread waits until the ring is empty first:
+    // every GS method that takes the state mutex (gifSyncBeforeAccess). The privileged GS registers do not wait: the
+    // packets only set CSR's FINISH and SIGNAL bits and SIGLBLID (atomic or word writes), and the EE's writes do not
+    // change how a packet is processed; as on the console, those bits show up when the GS gets to them. (Waiting there
+    // made the EE wait ~12 % in a race, where the game polls CSR, and most of the loading screens.) Other threads
+    // (the window's presentation) do not wait, as before. PS2X_GS_GIF_HILO=0 or A/B mode 75: on the EE thread, as
+    // before.
+    thread_local bool t_gifWorker = false;   // this thread is the GIF thread
+    thread_local bool t_gifProducer = false; // this thread has queued packets (the EE thread)
+
+    const bool s_gifThreadEnabled = []()
+    {
+        const char *value = std::getenv("PS2X_GS_GIF_HILO");
+        return value == nullptr || value[0] != '0';
+    }();
+
+    // PS2X_GS_GIF_ESPERAS=1 (diagnostic): every 10 s, "[gs:gif]" with the EE thread's waits for the GIF thread by
+    // what made it wait (the GS method, or "registro" for a privileged register): count and milliseconds.
+    const bool s_gifWaitNotes = []()
+    {
+        const char *value = std::getenv("PS2X_GS_GIF_ESPERAS");
+        return value != nullptr && value[0] != '0';
+    }();
+
+    void noteGifWait(const char *why, uint64_t ns, std::chrono::steady_clock::time_point now)
+    {
+        struct Reason
+        {
+            const char *why;
+            uint64_t count;
+            uint64_t ns;
+        };
+        static Reason s_reasons[32] = {};
+        static std::chrono::steady_clock::time_point s_report = now;
+        size_t i = 0u;
+        while (i < 31u && s_reasons[i].why != nullptr && std::strcmp(s_reasons[i].why, why) != 0)
+            ++i;
+        s_reasons[i].why = why;
+        ++s_reasons[i].count;
+        s_reasons[i].ns += ns;
+        if (now - s_report < std::chrono::seconds(10))
+            return;
+        std::fprintf(stderr, "[gs:gif] esperas del EE en 10 s:");
+        for (Reason &r : s_reasons)
+        {
+            if (r.why == nullptr)
+                break;
+            std::fprintf(stderr, " %s=%llu/%.1fms", r.why, static_cast<unsigned long long>(r.count),
+                         static_cast<double>(r.ns) / 1e6);
+            r.count = 0u;
+            r.ns = 0u;
+        }
+        std::fprintf(stderr, "\n");
+        s_report = now;
+    }
+
+    class GifPacketThread
+    {
+    public:
+        static constexpr uint64_t kRingBytes = 8ull << 20;
+        static constexpr uint64_t kMaxRecord = kRingBytes / 4u; // larger packets go on the caller's thread
+        static constexpr uint32_t kSkip = 0xFFFFFFFFu;            // the rest of the ring is empty: go on at 0
+
+        // False: not queued (too big); the caller processes it.
+        bool submit(GS &gs, const uint8_t *data, uint32_t sizeBytes)
+        {
+            const uint64_t need = 16u + ((static_cast<uint64_t>(sizeBytes) + 15u) & ~15ull);
+            if (need > kMaxRecord)
+                return false;
+            if (!m_started)
+                start();
+            t_gifProducer = true;
+            uint64_t tail = m_tail.load(std::memory_order_relaxed);
+            uint64_t pos = tail % kRingBytes;
+            const uint64_t skip = pos + need > kRingBytes ? kRingBytes - pos : 0u;
+            waitForRoom(tail + skip + need);
+            if (skip != 0u)
+            {
+                writeHeader(pos, kSkip, nullptr);
+                tail += skip;
+                pos = 0u;
+            }
+            writeHeader(pos, sizeBytes, &gs);
+            std::memcpy(m_ring.get() + pos + 16u, data, sizeBytes);
+            m_tail.store(tail + need, std::memory_order_seq_cst);
+            if (m_sleeping.load(std::memory_order_seq_cst))
+                wake();
+            return true;
+        }
+
+        // Until every packet queued so far has been processed. why: who asks (PS2X_GS_GIF_ESPERAS).
+        void sync(const char *why)
+        {
+            const uint64_t target = m_tail.load(std::memory_order_relaxed);
+            if (m_done.load(std::memory_order_acquire) >= target)
+                return;
+            const auto start = std::chrono::steady_clock::now();
+            for (uint32_t spins = 0u; m_done.load(std::memory_order_acquire) < target; ++spins)
+            {
+                if (m_sleeping.load(std::memory_order_seq_cst))
+                    wake();
+                if (spins < 2000u)
+                    _mm_pause();
+                else
+                    std::this_thread::yield();
+            }
+            const auto end = std::chrono::steady_clock::now();
+            const uint64_t ns =
+                static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(end - start).count());
+            g_ps2GsEeWaitNs.fetch_add(ns, std::memory_order_relaxed);
+            if (s_gifWaitNotes)
+                noteGifWait(why, ns, end);
+        }
+
+    private:
+        void start()
+        {
+            m_ring = std::make_unique<uint8_t[]>(kRingBytes);
+            m_started = true;
+            std::thread([this]() { workerLoop(); }).detach();
+        }
+
+        void writeHeader(uint64_t pos, uint32_t size, GS *gs)
+        {
+            uint8_t *const header = m_ring.get() + pos;
+            std::memcpy(header, &size, sizeof(size));
+            std::memcpy(header + 8u, &gs, sizeof(gs));
+        }
+
+        void waitForRoom(uint64_t end)
+        {
+            if (end - m_done.load(std::memory_order_acquire) <= kRingBytes)
+                return;
+            const auto start = std::chrono::steady_clock::now();
+            for (uint32_t spins = 0u; end - m_done.load(std::memory_order_acquire) > kRingBytes; ++spins)
+            {
+                if (m_sleeping.load(std::memory_order_seq_cst))
+                    wake();
+                if (spins < 2000u)
+                    _mm_pause();
+                else
+                    std::this_thread::yield();
+            }
+            g_ps2GsEeWaitNs.fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                                                std::chrono::steady_clock::now() - start)
+                                                                .count()),
+                                      std::memory_order_relaxed);
+        }
+
+        void wake()
+        {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+            }
+            m_wake.notify_one();
+        }
+
+        void workerLoop()
+        {
+            t_gifWorker = true;
+            ThreadNaming::SetCurrentThreadName("GS GIF");
+            int coresApplied = 0;
+            uint32_t coreChunks = 0u, coreOnEfficiency = 0u;
+            uint64_t head = 0u;
+            for (;;)
+            {
+                ps2GsThreadCores(coresApplied, coreChunks, coreOnEfficiency, false); // off the EE's own core
+                uint64_t tail = m_tail.load(std::memory_order_acquire);
+                if (head == tail)
+                {
+                    // Spin a while (the EE sends packets in bursts), then sleep until submit wakes it.
+                    for (uint32_t spins = 0u; spins < 4000u && head == tail; ++spins)
+                    {
+                        _mm_pause();
+                        tail = m_tail.load(std::memory_order_acquire);
+                    }
+                    if (head == tail)
+                    {
+                        std::unique_lock<std::mutex> lock(m_mutex);
+                        m_sleeping.store(true, std::memory_order_seq_cst);
+                        if (m_tail.load(std::memory_order_seq_cst) == head)
+                            m_wake.wait_for(lock, std::chrono::milliseconds(1));
+                        m_sleeping.store(false, std::memory_order_seq_cst);
+                        continue;
+                    }
+                }
+                while (head != tail)
+                {
+                    const uint64_t pos = head % kRingBytes;
+                    const uint8_t *const header = m_ring.get() + pos;
+                    uint32_t size = 0u;
+                    GS *gs = nullptr;
+                    std::memcpy(&size, header, sizeof(size));
+                    std::memcpy(&gs, header + 8u, sizeof(gs));
+                    if (size == kSkip)
+                        head += kRingBytes - pos;
+                    else
+                    {
+                        gs->processGIFPacket(header + 16u, size);
+                        head += 16u + ((static_cast<uint64_t>(size) + 15u) & ~15ull);
+                    }
+                    m_done.store(head, std::memory_order_release);
+                }
+            }
+        }
+
+        std::unique_ptr<uint8_t[]> m_ring;
+        bool m_started = false;
+        alignas(64) std::atomic<uint64_t> m_tail{0u}; // written by the EE thread
+        alignas(64) std::atomic<uint64_t> m_done{0u}; // by the GIF thread: processed up to here
+        alignas(64) std::atomic<bool> m_sleeping{false};
+        std::mutex m_mutex;
+        std::condition_variable m_wake;
+    };
+    GifPacketThread s_gifThread;
+
+    // Before a GS method takes the state mutex: on the EE thread, the queued packets first.
+    inline void gifSyncBeforeAccess(const char *why)
+    {
+        if (t_gifProducer && !t_gifWorker)
+            s_gifThread.sync(why);
+    }
+}
+
+void ps2GsGifSubmit(GS &gs, const uint8_t *data, uint32_t sizeBytes)
+{
+    const int mode = g_ps2AbMode.load(std::memory_order_relaxed);
+    if (s_gifThreadEnabled && mode != 75 && mode != 76 && !t_gifWorker && s_gifThread.submit(gs, data, sizeBytes))
+        return;
+    gs.processGIFPacket(data, sizeBytes); // after the queued ones (gifSyncBeforeAccess)
+}
+
+bool ps2GsGifOnWorker()
+{
+    return t_gifWorker;
+}
