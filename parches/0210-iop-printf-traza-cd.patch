+        // Patch 0210: guest words and strings for the printf formatter, read only from IOP RAM (an argument that is
+        // not a RAM pointer never touches a hardware register).
+        uint32_t guestWord(const IopMemory &memory, uint32_t address)
+        {
+            const uint32_t phys = IopMemory::physicalAddress(address);
+            if ((phys & 3u) != 0u || phys > IopMemory::RamSize - 4u)
+                return 0u;
+            return memory.read32(address);
+        }
+
+        std::optional<std::string> guestString(const IopMemory &memory, uint32_t address)
+        {
+            const uint32_t phys = IopMemory::physicalAddress(address);
+            if (address == 0u || phys >= IopMemory::RamSize)
+                return std::nullopt;
+            return memory.readString(address, std::min<size_t>(kIopPrintfMaxString, IopMemory::RamSize - phys));
+        }
+
+        // MIPS o32: argument slots 0-3 are a0-a3 and slot n >= 4 is the word at sp + 4n. The varargs start at
+        // firstSlot (1 for printf, 2 for fdprintf).
+        uint32_t varargSlot(const IopMemory &memory, const IopCpuState &cpu, uint32_t firstSlot, uint32_t index)
+        {
+            const uint32_t slot = firstSlot + index;
+            if (slot < 4u)
+                return cpu.gpr[4u + slot];
+            return guestWord(memory, cpu.gpr[29] + 4u * slot);
+        }
+    }
