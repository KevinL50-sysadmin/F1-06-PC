diff --git a/ps2xIOP/src/emulator/imports/iop_printf_format.cpp b/ps2xIOP/src/emulator/imports/iop_printf_format.cpp
new file mode 100644
index 0000000..62b6ce5
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_printf_format.cpp
@@ -0,0 +1,244 @@
+#include "iop_printf_format.h"
+
+#include <algorithm>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        struct Spec
+        {
+            bool left = false;
+            bool zero = false;
+            bool plus = false;
+            bool space = false;
+            bool alternate = false;
+            size_t width = 0u;
+            std::optional<size_t> precision;
+        };
+
+        class Output
+        {
+        public:
+            void append(std::string_view text)
+            {
+                const size_t room = kIopPrintfMaxOutput - std::min(kIopPrintfMaxOutput, m_text.size());
+                m_text.append(text.substr(0u, std::min(room, text.size())));
+            }
+
+            void repeat(char ch, size_t count)
+            {
+                const size_t room = kIopPrintfMaxOutput - std::min(kIopPrintfMaxOutput, m_text.size());
+                m_text.append(std::min(room, count), ch);
+            }
+
+            // body padded to the width: spaces on the left (or right with -); zeros between the prefix and the
+            // digits with 0.
+            void padded(const Spec &spec, std::string_view prefix, std::string_view body, bool zeroPad)
+            {
+                const size_t length = prefix.size() + body.size();
+                const size_t pad = spec.width > length ? spec.width - length : 0u;
+                if (!spec.left && !zeroPad)
+                    repeat(' ', pad);
+                append(prefix);
+                if (!spec.left && zeroPad)
+                    repeat('0', pad);
+                append(body);
+                if (spec.left)
+                    repeat(' ', pad);
+            }
+
+            [[nodiscard]] bool full() const noexcept { return m_text.size() >= kIopPrintfMaxOutput; }
+            [[nodiscard]] std::string take() { return std::move(m_text); }
+
+        private:
+            std::string m_text;
+        };
+
+        std::string digits(uint32_t value, uint32_t base, bool upper)
+        {
+            const char *table = upper ? "0123456789ABCDEF" : "0123456789abcdef";
+            std::string text;
+            do
+            {
+                text.push_back(table[value % base]);
+                value /= base;
+            } while (value != 0u);
+            std::reverse(text.begin(), text.end());
+            return text;
+        }
+
+        size_t clampSize(uint32_t value) noexcept
+        {
+            return std::min<size_t>(value, kIopPrintfMaxOutput);
+        }
+    }
+
+    std::string formatIopPrintf(std::string_view format,
+                                const IopPrintfArgument &nextArgument,
+                                const IopPrintfString &readString)
+    {
+        Output out;
+        uint32_t argumentIndex = 0u;
+        const auto next = [&]() -> uint32_t
+        {
+            return nextArgument ? nextArgument(argumentIndex++) : 0u;
+        };
+
+        size_t i = 0u;
+        while (i < format.size() && !out.full())
+        {
+            const size_t percent = format.find('%', i);
+            if (percent == std::string_view::npos)
+            {
+                out.append(format.substr(i));
+                break;
+            }
+            out.append(format.substr(i, percent - i));
+            size_t p = percent + 1u;
+
+            Spec spec;
+            for (; p < format.size(); ++p)
+            {
+                const char flag = format[p];
+                if (flag == '-')
+                    spec.left = true;
+                else if (flag == '0')
+                    spec.zero = true;
+                else if (flag == '+')
+                    spec.plus = true;
+                else if (flag == ' ')
+                    spec.space = true;
+                else if (flag == '#')
+                    spec.alternate = true;
+                else
+                    break;
+            }
+
+            if (p < format.size() && format[p] == '*')
+            {
+                const int32_t width = static_cast<int32_t>(next());
+                if (width < 0)
+                {
+                    spec.left = true;
+                    spec.width = clampSize(static_cast<uint32_t>(-static_cast<int64_t>(width)));
+                }
+                else
+                    spec.width = clampSize(static_cast<uint32_t>(width));
+                ++p;
+            }
+            else
+            {
+                uint64_t width = 0u;
+                for (; p < format.size() && format[p] >= '0' && format[p] <= '9'; ++p)
+                    width = std::min<uint64_t>(width * 10u + static_cast<uint64_t>(format[p] - '0'), kIopPrintfMaxOutput);
+                spec.width = static_cast<size_t>(width);
+            }
+
+            if (p < format.size() && format[p] == '.')
+            {
+                ++p;
+                if (p < format.size() && format[p] == '*')
+                {
+                    const int32_t precision = static_cast<int32_t>(next());
+                    if (precision >= 0) // a negative precision counts as none
+                        spec.precision = clampSize(static_cast<uint32_t>(precision));
+                    ++p;
+                }
+                else
+                {
+                    uint64_t precision = 0u;
+                    for (; p < format.size() && format[p] >= '0' && format[p] <= '9'; ++p)
+                        precision = std::min<uint64_t>(precision * 10u + static_cast<uint64_t>(format[p] - '0'),
+                                                       kIopPrintfMaxOutput);
+                    spec.precision = static_cast<size_t>(precision);
+                }
+            }
+
+            // Length modifiers: the IOP is a 32-bit machine and the guest passes one word per argument here.
+            while (p < format.size() &&
+                   (format[p] == 'h' || format[p] == 'l' || format[p] == 'z' || format[p] == 't' || format[p] == 'j'))
+                ++p;
+
+            if (p >= format.size())
+            {
+                out.append(format.substr(percent)); // a cut conversion is copied as it is
+                break;
+            }
+
+            const char conversion = format[p];
+            switch (conversion)
+            {
+            case 'd':
+            case 'i':
+            case 'u':
+            case 'x':
+            case 'X':
+            case 'o':
+            {
+                const uint32_t raw = next();
+                const bool isSigned = conversion == 'd' || conversion == 'i';
+                const bool negative = isSigned && static_cast<int32_t>(raw) < 0;
+                const uint32_t magnitude = negative ? 0u - raw : raw;
+                const uint32_t base = conversion == 'o' ? 8u : ((conversion == 'x' || conversion == 'X') ? 16u : 10u);
+                std::string body = (spec.precision && *spec.precision == 0u && magnitude == 0u)
+                                       ? std::string()
+                                       : digits(magnitude, base, conversion == 'X');
+                if (spec.precision && body.size() < *spec.precision)
+                    body.insert(0u, *spec.precision - body.size(), '0');
+                std::string prefix;
+                if (negative)
+                    prefix = "-";
+                else if (isSigned && spec.plus)
+                    prefix = "+";
+                else if (isSigned && spec.space)
+                    prefix = " ";
+                if (spec.alternate && base == 8u && (body.empty() || body.front() != '0'))
+                    body.insert(0u, 1u, '0');
+                if (spec.alternate && base == 16u && magnitude != 0u)
+                    prefix += conversion == 'X' ? "0X" : "0x";
+                out.padded(spec, prefix, body, spec.zero && !spec.precision);
+                break;
+            }
+            case 'p':
+            {
+                std::string body = digits(next(), 16u, false);
+                body.insert(0u, body.size() < 8u ? 8u - body.size() : 0u, '0');
+                out.padded(spec, "0x", body, spec.zero);
+                break;
+            }
+            case 'c':
+            {
+                const char ch = static_cast<char>(next() & 0xFFu);
+                out.padded(spec, {}, std::string_view(&ch, 1u), false);
+                break;
+            }
+            case 's':
+            {
+                const uint32_t address = next();
+                std::string text;
+                if (address == 0u)
+                    text = "(null)";
+                else if (const std::optional<std::string> guest = readString ? readString(address) : std::nullopt)
+                    text = *guest;
+                else
+                    text = "<bad>";
+                if (text.size() > kIopPrintfMaxString)
+                    text.resize(kIopPrintfMaxString);
+                if (spec.precision && text.size() > *spec.precision)
+                    text.resize(*spec.precision);
+                out.padded(spec, {}, text, false);
+                break;
+            }
+            case '%':
+                out.append("%");
+                break;
+            default:
+                out.append(format.substr(percent, p + 1u - percent)); // unknown: copied, no argument taken
+                break;
+            }
+            i = p + 1u;
+        }
+        return out.take();
+    }
+}
diff --git a/ps2xIOP/src/emulator/imports/iop_printf_format.h b/ps2xIOP/src/emulator/imports/iop_printf_format.h
new file mode 100644
index 0000000..88274cd
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_printf_format.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <functional>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace ps2x::iop::detail
+{
+    // Patch 0210: the IOP's printf/fdprintf/vfdprintf format their text with the guest's arguments (until then the
+    // raw format string was logged, so F1 06's IRX warnings came out as "%p ... %d").
+    //
+    // nextArgument(index) returns the index-th 32-bit argument after the format (MIPS o32: the caller maps it to
+    // registers, the guest stack or a va_list). readString(address) returns the guest string at address, or nothing
+    // when the pointer is not readable guest memory. Supported: %d %i %u %o %x %X %p %s %c %% with the flags - 0 + space
+    // #, a width and a precision (digits or *), and the length modifiers h hh l ll z t j (all read one 32-bit word).
+    // %p prints 0x and 8 hex digits; %s of 0 prints (null) and of an unreadable pointer <bad>. Anything else is copied
+    // as it is.
+    using IopPrintfArgument = std::function<uint32_t(uint32_t index)>;
+    using IopPrintfString = std::function<std::optional<std::string>(uint32_t address)>;
+
+    [[nodiscard]] std::string formatIopPrintf(std::string_view format,
+                                              const IopPrintfArgument &nextArgument,
+                                              const IopPrintfString &readString);
+
+    // Longest output and longest %s string the formatter produces (a corrupt format or argument cannot run away).
+    inline constexpr size_t kIopPrintfMaxOutput = 4096u;
+    inline constexpr size_t kIopPrintfMaxString = 1024u;
+
+    // Patch 0210: the two messages F1 06 prints when AUDIO.IRX closes a file while CORE.IRX still has a read in
+    // flight for it (a race in the original game: the read finishes ~100 us later, nothing is lost and the game goes
+    // on; see odd/tasks/iop-salida.md L6). They are tagged in the log so players and report readers are not alarmed.
+    [[nodiscard]] inline bool isKnownHarmlessGameWarning(std::string_view text) noexcept
+    {
+        constexpr std::string_view closing = "WARNING: Closing file ";
+        constexpr std::string_view closingEnd = " will probably be fatal";
+        constexpr std::string_view callback = "IOP FATAL ERROR: callback received when status is ";
+        if (text.substr(0, callback.size()) == callback)
+            return true;
+        return text.substr(0, closing.size()) == closing && text.find(closingEnd) != std::string_view::npos;
+    }
+
+    inline constexpr std::string_view kKnownHarmlessGameWarningTag = "[harmless warning from the original game] ";
+
+    // Patch 0210: PS2X_IOP_TRAZA_CD=1 turns on the IOP CD diagnostic trace ("[IOP cd]" lines on stderr: sceCdRead,
+    // sceCdSync, sceCdSeek, sceCdCallback, sceCdInit and every CD callback delivery) and the caller's ra in the IOP
+    // printf lines. Off by default; read once.
+    [[nodiscard]] inline bool iopTrazaCdValue(const char *value) noexcept
+    {
+        return value != nullptr && std::atoi(value) != 0;
+    }
+
+    [[nodiscard]] inline bool iopTrazaCdEnabled() noexcept
+    {
+        static const bool s_enabled = iopTrazaCdValue(std::getenv("PS2X_IOP_TRAZA_CD"));
+        return s_enabled;
+    }
+}
