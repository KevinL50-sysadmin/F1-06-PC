+    // Patch 0210 (T1): the IOP printf formatter with plain arguments and a small table of guest strings.
+    struct PrintfArgs
+    {
+        std::vector<uint32_t> words;
+        std::map<uint32_t, std::string> strings;
+        std::vector<uint32_t> fetched;
+
+        std::string format(std::string_view text)
+        {
+            return ps2x::iop::detail::formatIopPrintf(
+                text,
+                [this](uint32_t index) -> uint32_t
+                {
+                    fetched.push_back(index);
+                    return index < words.size() ? words[index] : 0xDEADBEEFu;
+                },
+                [this](uint32_t address) -> std::optional<std::string>
+                {
+                    const auto it = strings.find(address);
+                    if (it == strings.end())
+                        return std::nullopt;
+                    return it->second;
+                });
+        }
+    };
+
+    // Patch 0210 (T1): calls one stdio import (printf 4, fdprintf 9, vfdprintf 14) on a real IopMemory; the last log
+    // line and v0 are the result.
+    struct StdioRig
+    {
+        iop_test::Host host;
+        ps2x::iop::detail::IopMemory memory;
+        ps2x::iop::detail::IopStdio stdio{host, memory};
+        ps2x::iop::detail::IopCpuState cpu{};
+
+        void putString(uint32_t address, const std::string &text)
+        {
+            (void)memory.writeRam(address, text.c_str(), text.size() + 1u);
+        }
+
+        bool call(uint16_t ordinal)
+        {
+            host.logs.clear();
+            cpu.gpr[2] = 0xFFFFFFFFu;
+            return stdio.dispatchImport(ordinal, cpu);
+        }
+
+        [[nodiscard]] std::string lastLog() const { return host.logs.empty() ? std::string() : host.logs.back(); }
+    };
