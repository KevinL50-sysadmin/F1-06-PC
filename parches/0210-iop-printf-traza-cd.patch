-            logString("[IOP vfdprintf] ", a1);
+        {
+            const uint32_t list = cpu.gpr[6]; // va_list: the arguments as consecutive words in guest memory
+            logFormatted("vfdprintf", a1, [&, list](uint32_t index) { return guestWord(m_memory, list + 4u * index); });
             return true;
