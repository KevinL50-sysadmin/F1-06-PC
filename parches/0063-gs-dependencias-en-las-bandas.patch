+bool GSCpuBackend::BandUploadJob(const uint8_t *data, uint32_t sizeBytes)
+{
+    // A/B modes 36 and 37: the coordinator waits and writes, as before. Also with the union or page tracking (A/B
+    // modes 15 and 19) and while F1_GS_VERIFICAR_BANDAS checks batches (they replay draws only).
+    BandState &bs = *m_bands;
+    const int mode = g_ps2AbMode.load(std::memory_order_relaxed);
+    if (mode == 36 || mode == 37 || !BandState::LastJobs())
+        return false;
+    // What BandTransferWait would wait for: the last pending job writing the destination blocks or reading them as
+    // a texture. Nothing pending: the caller writes it at once.
+    // PS2X_GS_SUBIDAS_SIEMPRE=1 (diagnostic): every chunk as a job, so that F1_GS_VERIFICAR_BANDAS checks them (with
+    // it the workers keep up and almost nothing conflicts).
+    static const bool s_always = []
+    {
+        const char *value = std::getenv("PS2X_GS_SUBIDAS_SIEMPRE");
+        return value != nullptr && value[0] == '1';
+    }();
+    uint32_t page = 0u;
+    uint64_t need = bs.LastBlockWrite(bs.transferBlocks, page);
+    need = std::max(need, bs.LastBlockRead(bs.transferBlocks, page));
+    if (!s_always && (need <= bs.minDone || bs.RefreshMinDone() >= need))
+        return false;
+
+    const uint64_t index = bs.prepared;
+    if (index - bs.minDone >= BandState::kJobCapacity)
+        bs.WaitDone(index + 1u - BandState::kJobCapacity, kWaitRing);
+    const size_t slot = static_cast<size_t>(index % BandState::kJobCapacity);
+    BandJob &job = bs.jobs[slot];
+    job.isSprite = false;
+    job.isUpload = true;
+    job.uploadWorker = static_cast<uint8_t>(index % bs.threads);
+    job.waitAll = need;
+    job.minX = job.minY = 0;
+    job.maxX = job.maxY = -1;
+    BandState::Upload &upload = bs.uploads[slot];
+    upload.transfer = m_transfer;
+    upload.start = m_transferState;
+    upload.data.assign(data, data + sizeBytes);
+    upload.vram = m_vram;
+    upload.write = m_writeVramFuncs[m_transfer.bitbltbuf.dpsm & 0x3Fu];
+    // F1_GS_VERIFICAR_BANDAS: replayed in order with the batch's draws.
+    if (bs.VerifyNow())
+    {
+        if (!bs.VerifyOpen())
+        {
+            bs.WaitDone(index, kWaitVerify);
+            bs.verifyBefore.assign(m_vram, m_vram + m_vramSize);
         }
+        bs.verifyUploads.push_back({bs.verifyBatches.size(), upload});
     }
+    // The transfer state after this chunk, as writing it here would leave it.
+    uploadPixels(m_transfer, m_transferState, data, sizeBytes, nullptr, nullptr);
+
+    // It writes the destination blocks: later jobs and commands order themselves after it like after a draw. Layout
+    // 0 matches no buffer, so a draw writing those pages waits for it too.
+    const uint64_t tag = index + 1u;
+    bs.transferPages.forEach([&](uint32_t p)
+                             { bs.pageWriteJob[p] = tag; bs.pageWriteLayout[p] = 0u; });
+    bs.pendingWrites |= bs.transferPages;
+    bs.RecordBlockWrites(bs.transferBlocks, tag);
+    bs.CheckRecord(tag, bs.transferBlocks, nullptr);
+    for (const auto &[p, mask] : bs.transferBlocks)
+        bs.pendingWriteBlocks[p] |= mask;
+    ++bs.uploadJobs;
+    bs.prepared = tag;
+    if (tag - bs.published.load(std::memory_order_relaxed) >= BandState::kPublishBatch)
+        bs.Publish(tag);
+    if (bs.verifyUploads.size() >= 64u)
+        CloseBandVerification();
+    return true;
 }
 
