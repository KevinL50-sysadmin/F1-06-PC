+
+GSGpuQuality GSGpuBackend::SetQuality(const GSGpuQuality &quality)
+{
+    Impl &impl = *m_impl;
+    GSGpuQuality applied{};
+    // After everything queued so far (the scanout waiting to be coalesced too): between two frames.
+    impl.runSync([&]() {
+        const uint32_t rate = impl.api.set_quality(impl.context, quality.superSampling,
+                                                   quality.superSampledTextures ? kCreateSuperSampledTextures : 0u);
+        applied = impl.applyQuality(quality, rate);
+    });
+    std::fprintf(stderr, "[gs:gpu] calidad: supersampling x%u (pedido x%u), alta_resolucion=%d, texturas=%d\n",
+                 applied.superSampling, quality.superSampling, applied.highResolution ? 1 : 0,
+                 applied.superSampledTextures ? 1 : 0);
+    return applied;
+}
+
+GSGpuQuality ps2GsGpuQualityFromEnvironment(const char *superSampling, const char *highResolution,
+                                            const char *superSampledTextures)
+{
+    GSGpuQuality quality{};
+    if (superSampling != nullptr)
+        for (const char *rate : {"1", "2", "4", "8", "16"})
+            if (std::strcmp(superSampling, rate) == 0)
+                quality.superSampling = static_cast<uint32_t>(std::atoi(rate));
+    quality.highResolution = isOne(highResolution);
+    quality.superSampledTextures = isOne(superSampledTextures);
+    return quality;
+}
+
+GSGpuQuality ps2GsGpuQualityFromEnvironment()
+{
+    return ps2GsGpuQualityFromEnvironment(std::getenv("PS2X_GS_SSAA"), std::getenv("PS2X_GS_ALTA_RES"),
+                                          std::getenv("PS2X_GS_SSAA_TEXTURAS"));
