+    void IopMemory::resetOhci()
+    {
+        for (uint32_t address = kOhciBase; address < kOhciBase + 0x60u; address += 4u)
+            m_hardware[address] = 0u;
+        m_hardware[kOhciBase + kOhciRevision] = 0x10u;
+        m_hardware[kOhciBase + kOhciFmInterval] = 0x27782EDFu;
+        m_hardware[kOhciBase + kOhciFmRemaining] = 0x00002EDFu;
+        m_hardware[kOhciBase + kOhciLsThreshold] = 0x628u;
+        m_hardware[kOhciBase + kOhciRhDescriptorA] = 0x200u | kOhciPortCount; // NPS: ports always powered
+        for (uint32_t port = 0; port < kOhciPortCount; ++port)
+            m_hardware[kOhciBase + kOhciRhPortStatus0 + port * 4u] = kOhciPortPowered;
+        m_ohciFrameNumber = 0u;
+    }
+
+    uint32_t IopMemory::readOhci(uint32_t address) const
+    {
+        const uint32_t offset = address - kOhciBase;
+        const auto stored = [this](uint32_t registerAddress)
+        {
+            const auto value = m_hardware.find(registerAddress);
+            return value != m_hardware.end() ? value->second : 0u;
+        };
+        if (offset == kOhciInterruptDisable)
+            return stored(kOhciBase + kOhciInterruptEnable);
+        if (offset == kOhciFmNumber)
+        {
+            // No real frame timing: advance one frame per poll while the controller is operational.
+            if ((stored(kOhciBase + kOhciControl) & kOhciControlStateMask) == kOhciStateOperational)
+                ++m_ohciFrameNumber;
+            return m_ohciFrameNumber & 0xFFFFu;
+        }
+        return stored(address);
+    }
+
+    void IopMemory::writeOhci(uint32_t address, uint32_t value)
+    {
+        const uint32_t offset = address - kOhciBase;
+        uint32_t &reg = m_hardware[address];
+        switch (offset)
+        {
+        case kOhciRevision:
+        case kOhciFmNumber:
+        case kOhciRhDescriptorA:
+            return;
+        case kOhciCommandStatus:
+            // HostControllerReset completes immediately and leaves the controller in UsbSuspend.
+            // CLF/BLF are cleared at once: there are never transfer descriptors to process.
+            if ((value & 1u) != 0u)
+            {
+                resetOhci();
+                m_hardware[kOhciBase + kOhciControl] = kOhciStateSuspend;
+            }
+            m_hardware[address] = 0u;
+            return;
+        case kOhciInterruptStatus:
+            reg &= ~value;
+            return;
+        case kOhciInterruptEnable:
+            reg |= value;
+            return;
+        case kOhciInterruptDisable:
+            m_hardware[kOhciBase + kOhciInterruptEnable] &= ~value;
+            return;
+        case kOhciHcca:
+            reg = value & ~0xFFu;
+            return;
+        case kOhciRhStatus:
+            reg &= ~(value & 0x00020000u); // write 1 to clear OCIC; power switching is not modelled
+            return;
+        default:
+            break;
+        }
+        if (offset >= kOhciRhPortStatus0 && offset < kOhciRhPortStatus0 + kOhciPortCount * 4u)
+        {
+            // Nothing is connected: enable/suspend/reset requests only raise ConnectStatusChange,
+            // which tells the driver the port is empty; change bits are write-1-to-clear.
+            if ((value & 0x16u) != 0u)
+                reg |= kOhciPortConnectChange;
+            reg &= ~(value & kOhciPortChangeMask);
+            reg |= kOhciPortPowered;
+            return;
+        }
+        reg = value;
+    }
