diff --git a/ps2xRuntime/include/ps2_audio_sistema.h b/ps2xRuntime/include/ps2_audio_sistema.h
new file mode 100644
index 0000000..7e0b86d
--- /dev/null
+++ b/ps2xRuntime/include/ps2_audio_sistema.h
@@ -0,0 +1,86 @@
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Audio en Linux/Proton (odd/tasks/audio-proton.md, patch 0220): which Windows audio system the game's sound goes
+// through. raylib's raudio opens miniaudio with its own default order and keeps the first context that initializes,
+// even when the device then fails or never asks for sound (what Wine/Proton can do with WASAPI). The runtime instead
+// tries WASAPI, DirectSound and WinMM one by one (InitAudioDevice with a single miniaudio backend, chosen through the
+// hook of the raudio copy the CMake build makes) and keeps the first whose device opens, starts and consumes frames.
+// settings.ini's audio_backend (PS2X_AUDIO_BACKEND) puts one first. These are the pure parts; the log lines start with
+// "[audio] " and go to stdout (F1-06.log).
+namespace ps2x::audio
+{
+    // The order to try: the names of miniaudio backends as audio_backend writes them ("wasapi", "directsound",
+    // "winmm"). auto (or unset, empty): wasapi, directsound, winmm. A forced one first, then the others in that order
+    // (a fallback, so a forced system that fails does not leave the game silent). Case-insensitive, spaces trimmed. A
+    // bad value is auto with valid = false. Away from Windows the order is {""}: miniaudio's own choice.
+    struct BackendOrder
+    {
+        std::vector<std::string> order;
+        std::string setting; // auto, wasapi, directsound or winmm (auto for a bad value)
+        bool valid = true;
+    };
+    BackendOrder backendOrder(const char *setting, bool windows);
+
+    // "WASAPI", "DirectSound", "WinMM"; "predeterminado" for "" (miniaudio's own choice); the name itself otherwise.
+    std::string backendDisplayName(std::string_view name);
+
+    // A comma-separated list (the test-only PS2X_AUDIO_PRUEBA_FALLO and PS2X_AUDIO_PRUEBA_SILENCIO) names this
+    // backend, case-insensitive. False for a null list.
+    bool listNames(const char *list, std::string_view name);
+
+    // What opening one backend gave: its device opened and consumed frames (detail: the openedLine), it failed
+    // (detail: miniaudio's reason) or it opened but consumed nothing while waited for (detail: unused).
+    enum class AttemptResult
+    {
+        Opened,
+        Failed,
+        Silent,
+    };
+    struct Attempt
+    {
+        AttemptResult result = AttemptResult::Failed;
+        std::string detail;
+    };
+
+    struct OpenSteps
+    {
+        std::function<Attempt(const std::string &backend)> open;
+        std::function<void()> close; // closes the device of a Silent attempt that is not kept
+        std::function<void(const std::string &line)> log;
+    };
+
+    // Tries order in turn and returns the backend kept (found = false when none works). A failure logs "[audio] <name> no disponible: <detail>" and goes on; a silent device is closed and the next one
+    // tried, except the last, which is kept with a warning (it may still start late); an opened one logs its detail.
+    struct OpenResult
+    {
+        bool found = false;
+        std::string backend;
+        bool silent = false; // kept although it consumed nothing
+    };
+    OpenResult openFirstWorking(const std::vector<std::string> &order, const OpenSteps &steps);
+
+    struct DeviceInfo
+    {
+        std::string backend; // miniaudio's name of the context's backend (ma_get_backend_name)
+        std::string device;  // the playback device's name
+        std::string format;  // the device's internal format (ma_get_format_name: f32, s16...)
+        unsigned sampleRate = 0;
+        unsigned channels = 0;
+        unsigned periodFrames = 0;
+        unsigned periods = 0;
+    };
+    // [audio] sistema=WASAPI dispositivo="Altavoces" formato=f32 48000 Hz 2 canales periodo=480x3 fotogramas
+    std::string openedLine(const std::string &backend, const DeviceInfo &info);
+
+    // The line a few seconds after opening: how many frames the device consumed, or a warning when it took none.
+    std::string playbackLine(uint64_t frames, double seconds);
+
+    // The first lines: the order, and a warning for a bad PS2X_AUDIO_BACKEND value (raw is the value given).
+    std::vector<std::string> orderLines(const BackendOrder &order, const char *raw);
+}
diff --git a/ps2xRuntime/src/lib/ps2_audio_sistema.cpp b/ps2xRuntime/src/lib/ps2_audio_sistema.cpp
new file mode 100644
index 0000000..a886829
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_audio_sistema.cpp
@@ -0,0 +1,146 @@
+#include "ps2_audio_sistema.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+
+namespace ps2x::audio
+{
+    namespace
+    {
+        constexpr const char *kWindowsOrder[] = {"wasapi", "directsound", "winmm"};
+
+        std::string trimmedLower(std::string_view text)
+        {
+            size_t begin = 0u, end = text.size();
+            while (begin < end && std::isspace(static_cast<unsigned char>(text[begin])))
+                ++begin;
+            while (end > begin && std::isspace(static_cast<unsigned char>(text[end - 1u])))
+                --end;
+            std::string result(text.substr(begin, end - begin));
+            for (char &c : result)
+                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+            return result;
+        }
+    }
+
+    BackendOrder backendOrder(const char *setting, bool windows)
+    {
+        BackendOrder result;
+        const std::string value = trimmedLower(setting != nullptr ? setting : "");
+        const bool known = std::find(std::begin(kWindowsOrder), std::end(kWindowsOrder), value) != std::end(kWindowsOrder);
+        result.valid = value.empty() || value == "auto" || known;
+        result.setting = known ? value : "auto";
+        if (!windows)
+        {
+            result.order = {""};
+            return result;
+        }
+        if (known)
+            result.order.push_back(value);
+        for (const char *name : kWindowsOrder)
+            if (value != name)
+                result.order.emplace_back(name);
+        return result;
+    }
+
+    std::string backendDisplayName(std::string_view name)
+    {
+        if (name == "wasapi")
+            return "WASAPI";
+        if (name == "directsound")
+            return "DirectSound";
+        if (name == "winmm")
+            return "WinMM";
+        if (name.empty())
+            return "predeterminado";
+        return std::string(name);
+    }
+
+    bool listNames(const char *list, std::string_view name)
+    {
+        if (list == nullptr)
+            return false;
+        const std::string wanted = trimmedLower(name);
+        std::string_view rest(list);
+        while (true)
+        {
+            const size_t comma = rest.find(',');
+            if (trimmedLower(rest.substr(0u, comma)) == wanted)
+                return true;
+            if (comma == std::string_view::npos)
+                return false;
+            rest.remove_prefix(comma + 1u);
+        }
+    }
+
+    OpenResult openFirstWorking(const std::vector<std::string> &order, const OpenSteps &steps)
+    {
+        OpenResult result;
+        for (size_t i = 0u; i < order.size(); ++i)
+        {
+            const std::string &backend = order[i];
+            const std::string name = backendDisplayName(backend);
+            const Attempt attempt = steps.open(backend);
+            if (attempt.result == AttemptResult::Opened)
+            {
+                steps.log(attempt.detail);
+                result.found = true;
+                result.backend = backend;
+                return result;
+            }
+            if (attempt.result == AttemptResult::Failed)
+            {
+                steps.log("[audio] " + name + " no disponible: " + attempt.detail);
+                continue;
+            }
+            if (i + 1u < order.size())
+            {
+                steps.log("[audio] " + name + " no disponible: se abrio pero no pidio sonido en 1,5 s");
+                steps.close();
+                continue;
+            }
+            steps.log("[audio] AVISO: " + name +
+                      " se abrio pero no pidio sonido en 1,5 s; se queda por ser el ultimo (puede que no suene)");
+            result.found = true;
+            result.backend = backend;
+            result.silent = true;
+            return result;
+        }
+        steps.log("[audio] ningun sistema de audio funciona: el juego sigue sin sonido");
+        return result;
+    }
+
+    std::string openedLine(const std::string &backend, const DeviceInfo &info)
+    {
+        const std::string system = backend.empty() ? info.backend : backendDisplayName(backend);
+        return "[audio] sistema=" + system + " dispositivo=\"" + info.device + "\" formato=" + info.format + " " +
+               std::to_string(info.sampleRate) + " Hz " + std::to_string(info.channels) + " canales periodo=" +
+               std::to_string(info.periodFrames) + "x" + std::to_string(info.periods) + " fotogramas";
+    }
+
+    std::string playbackLine(uint64_t frames, double seconds)
+    {
+        char time[32];
+        std::snprintf(time, sizeof(time), "%.1f", seconds);
+        std::string text(time);
+        std::replace(text.begin(), text.end(), '.', ',');
+        if (frames == 0u)
+            return "[audio] AVISO: el dispositivo no ha consumido ningun fotograma en " + text +
+                   " s: probablemente no suena nada (prueba otro audio_backend en settings.ini)";
+        return "[audio] reproduciendo: " + std::to_string(frames) + " fotogramas consumidos en " + text + " s";
+    }
+
+    std::vector<std::string> orderLines(const BackendOrder &order, const char *raw)
+    {
+        std::vector<std::string> lines;
+        if (!order.valid)
+            lines.push_back(std::string("[audio] AVISO: PS2X_AUDIO_BACKEND=\"") + (raw != nullptr ? raw : "") +
+                            "\" no vale (auto, wasapi, directsound o winmm): se usa auto");
+        std::string names;
+        for (const std::string &backend : order.order)
+            names += (names.empty() ? "" : ", ") + backendDisplayName(backend);
+        lines.push_back("[audio] audio_backend=" + order.setting + ": orden " + names);
+        return lines;
+    }
+}
