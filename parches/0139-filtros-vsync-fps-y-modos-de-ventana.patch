diff --git a/ps2xTest/src/ps2_display_tests.cpp b/ps2xTest/src/ps2_display_tests.cpp
new file mode 100644
index 0000000..1fb4231
--- /dev/null
+++ b/ps2xTest/src/ps2_display_tests.cpp
@@ -0,0 +1,397 @@
+#include "MiniTest.h"
+#include "ps2_display.h"
+#include "ps2_options.h"
+#include "ps2_runtime.h"
+
+#include <map>
+#include <string>
+#include <vector>
+
+namespace
+{
+    using ps2x::DisplaySettings;
+    using ps2x::FrameFilter;
+    using ps2x::WindowMode;
+    using ps2x::WindowStep;
+
+    // The player's filter (chosen from the window captures of fase3 T2); development keeps bilineal.
+    const std::string kPlayerFilter = "fsr";
+
+    using Environment = std::map<std::string, std::string>;
+
+    std::function<const char *(const char *)> environmentOf(const Environment &environment)
+    {
+        return [&environment](const char *name) -> const char *
+        {
+            const auto found = environment.find(name);
+            return found == environment.end() ? nullptr : found->second.c_str();
+        };
+    }
+
+    Environment settingsOf(const ps2x::OptionsFile &options, const Environment &environment = {})
+    {
+        Environment result;
+        for (const ps2x::EnvironmentSetting &setting : ps2x::optionsEnvironment(options, environmentOf(environment)))
+            result[setting.variable] = setting.value;
+        return result;
+    }
+
+    std::string joined(const std::vector<std::string> &lines)
+    {
+        std::string text;
+        for (const std::string &line : lines)
+            text += line + "\n";
+        return text;
+    }
+
+    std::string stepsText(const std::vector<WindowStep> &steps)
+    {
+        std::string text;
+        for (const WindowStep step : steps)
+            text += step == WindowStep::LeaveBorderless   ? "-sin_bordes "
+                    : step == WindowStep::LeaveFullscreen ? "-completa "
+                    : step == WindowStep::EnterBorderless ? "+sin_bordes "
+                                                          : "+completa ";
+        return text;
+    }
+}
+
+void register_ps2_display_tests()
+{
+    MiniTest::Case("DisplayOptions", [](TestCase &tc)
+    {
+        tc.Run("the default opciones.ini has the display options with the player's and development defaults", [](TestCase &t)
+        {
+            const std::string player = ps2x::defaultOptionsText();
+            for (const std::string line : {"\npantalla = ventana\n", "\ntamano_ventana = 960x720\n",
+                                           "\nvsync = 1\n", "\nmostrar_fps = 0\n"})
+                t.IsTrue(player.find(line) != std::string::npos, "player file has" + line);
+            t.IsTrue(player.find("\nfiltro = " + kPlayerFilter + "\n") != std::string::npos,
+                     "player file has filtro = " + kPlayerFilter);
+            t.IsTrue(player.find("pantalla_completa") == std::string::npos, "pantalla_completa is no longer written");
+            for (const char *comment : {"# Modo de la ventana al arrancar: ventana, sin_bordes",
+                                        "# Tamano de la ventana en modo ventana", "# Filtro al ampliar la imagen",
+                                        "# Sincronizacion vertical", "# Contador de fotogramas por segundo"})
+                t.IsTrue(player.find(comment) != std::string::npos, std::string("comment: ") + comment);
+            t.IsTrue(ps2x::parseOptions(player).warnings.empty(), "the player file parses without warnings");
+
+            const std::string development = ps2x::defaultOptionsText(true);
+            for (const char *line : {"\nfiltro = bilineal\n", "\nvsync = 0\n", "\nmostrar_fps = 0\n",
+                                     "\npantalla = ventana\n", "\ntamano_ventana = 960x720\n"})
+                t.IsTrue(development.find(line) != std::string::npos, std::string("development file has") + line);
+            t.IsTrue(ps2x::parseOptions(development, "opciones.ini", true).warnings.empty(),
+                     "the development file parses without warnings");
+        });
+
+        tc.Run("the display options set their variables", [](TestCase &t)
+        {
+            const ps2x::OptionsFile options = ps2x::parseOptions("pantalla = completa\ntamano_ventana = 1280x960\n"
+                                                                 "filtro = nitido\nvsync = 0\nmostrar_fps = 1\n");
+            t.IsTrue(options.warnings.empty(), "no warnings: " + joined(options.warnings));
+            const Environment set = settingsOf(options);
+            t.IsTrue(set.count("PS2X_PANTALLA") && set.at("PS2X_PANTALLA") == "completa", "PS2X_PANTALLA=completa");
+            t.IsTrue(set.count("PS2X_TAMANO_VENTANA") && set.at("PS2X_TAMANO_VENTANA") == "1280x960",
+                     "PS2X_TAMANO_VENTANA=1280x960");
+            t.IsTrue(set.count("PS2X_FILTRO") && set.at("PS2X_FILTRO") == "nitido", "PS2X_FILTRO=nitido");
+            t.IsTrue(set.count("PS2X_VSYNC") && set.at("PS2X_VSYNC") == "0", "PS2X_VSYNC=0");
+            t.IsTrue(set.count("PS2X_MOSTRAR_FPS") && set.at("PS2X_MOSTRAR_FPS") == "1", "PS2X_MOSTRAR_FPS=1");
+            t.IsTrue(set.count("PS2X_PANTALLA_COMPLETA") == 0u, "the old variable is not set any more");
+
+            const std::map<std::string, std::string> filters = {
+                {"cercano", "0"}, {"bilineal", "1"}, {"nitido", "nitido"}, {"fsr", "fsr"}, {"crt", "crt"}};
+            for (const auto &[value, variable] : filters)
+            {
+                const Environment chosen = settingsOf(ps2x::parseOptions("filtro = " + value + "\n"));
+                t.IsTrue(chosen.count("PS2X_FILTRO") && chosen.at("PS2X_FILTRO") == variable,
+                         "filtro = " + value + " -> PS2X_FILTRO=" + variable);
+            }
+            for (const std::string mode : {"ventana", "sin_bordes", "completa"})
+                t.IsTrue(settingsOf(ps2x::parseOptions("pantalla = " + mode + "\n")).at("PS2X_PANTALLA") == mode,
+                         "pantalla = " + mode);
+        });
+
+        tc.Run("the old pantalla_completa key is still read; pantalla wins over it", [](TestCase &t)
+        {
+            const ps2x::OptionsFile on = ps2x::parseOptions("pantalla_completa = 1\n");
+            t.IsTrue(on.warnings.empty(), "no warning for the old key");
+            t.Equals(on.values.at("pantalla"), std::string("sin_bordes"), "1 -> sin_bordes");
+            t.Equals(settingsOf(on).at("PS2X_PANTALLA"), std::string("sin_bordes"), "PS2X_PANTALLA=sin_bordes");
+            const ps2x::OptionsFile off = ps2x::parseOptions("pantalla_completa = 0\n");
+            t.IsTrue(off.warnings.empty(), "no warning for 0");
+            t.Equals(off.values.at("pantalla"), std::string("ventana"), "0 -> ventana");
+            t.Equals(ps2x::parseOptions("pantalla = completa\npantalla_completa = 1\n").values.at("pantalla"),
+                     std::string("completa"), "pantalla written before wins");
+            t.Equals(ps2x::parseOptions("pantalla_completa = 1\npantalla = ventana\n").values.at("pantalla"),
+                     std::string("ventana"), "pantalla written after wins");
+            const ps2x::OptionsFile bad = ps2x::parseOptions("pantalla_completa = 2\n");
+            t.Equals(bad.values.at("pantalla"), std::string("ventana"), "a bad old value keeps the default");
+            t.Equals(joined(bad.warnings),
+                     std::string("[opciones] opciones.ini:1: valor no valido '2' para pantalla_completa; se usa "
+                                 "ventana (valores: 0, 1)\n"),
+                     "a bad old value is warned: " + joined(bad.warnings));
+        });
+
+        tc.Run("bad display values keep the default of the mode with one warning each", [](TestCase &t)
+        {
+            const char *const text = "filtro = lanczos\nvsync = 2\nmostrar_fps = si\npantalla = total\n"
+                                     "tamano_ventana = 1280\n";
+            const ps2x::OptionsFile player = ps2x::parseOptions(text);
+            t.Equals(player.values.at("filtro"), kPlayerFilter, "filtro falls back to the player's default");
+            t.Equals(player.values.at("vsync"), std::string("1"), "vsync falls back to 1 for the player");
+            t.Equals(player.values.at("mostrar_fps"), std::string("0"), "mostrar_fps falls back to 0");
+            t.Equals(player.values.at("pantalla"), std::string("ventana"), "pantalla falls back to ventana");
+            t.Equals(player.values.at("tamano_ventana"), std::string("960x720"), "tamano_ventana falls back to 960x720");
+            const ps2x::OptionsFile development = ps2x::parseOptions(text, "opciones.ini", true);
+            t.Equals(development.values.at("filtro"), std::string("bilineal"), "filtro falls back to bilineal in development");
+            t.Equals(development.values.at("vsync"), std::string("0"), "vsync falls back to 0 in development");
+            t.Equals(joined(development.warnings),
+                     std::string("[opciones] opciones.ini:1: valor no valido 'lanczos' para filtro; se usa bilineal "
+                                 "(valores: cercano, bilineal, nitido, fsr, crt)\n"
+                                 "[opciones] opciones.ini:2: valor no valido '2' para vsync; se usa 0 (valores: 0, 1)\n"
+                                 "[opciones] opciones.ini:3: valor no valido 'si' para mostrar_fps; se usa 0 "
+                                 "(valores: 0, 1)\n"
+                                 "[opciones] opciones.ini:4: valor no valido 'total' para pantalla; se usa ventana "
+                                 "(valores: ventana, sin_bordes, completa)\n"
+                                 "[opciones] opciones.ini:5: valor no valido '1280' para tamano_ventana; se usa "
+                                 "960x720 (valores: <ancho>x<alto>, de 320x240 a 7680x4320)\n"),
+                     "the warnings: " + joined(development.warnings));
+            for (const char *size : {"x960", "1280x", "0x0", "319x240", "1280x4321", "1280x960x2", "1280 x 960", "-1x5"})
+                t.Equals(ps2x::parseOptions(std::string("tamano_ventana = ") + size + "\n").values.at("tamano_ventana"),
+                         std::string("960x720"), std::string("bad size ") + size);
+            t.Equals(ps2x::parseOptions("tamano_ventana = 7680X4320\n").values.at("tamano_ventana"),
+                     std::string("7680x4320"), "the largest size, any case");
+        });
+
+        tc.Run("variables already set win over the file, the old PS2X_PANTALLA_COMPLETA too", [](TestCase &t)
+        {
+            const ps2x::OptionsFile options = ps2x::parseOptions("pantalla = completa\nfiltro = crt\nvsync = 1\n"
+                                                                 "mostrar_fps = 1\ntamano_ventana = 1280x960\n");
+            const Environment set = settingsOf(options, {{"PS2X_PANTALLA", "ventana"}, {"PS2X_FILTRO", "0"},
+                                                         {"PS2X_VSYNC", "0"}, {"PS2X_MOSTRAR_FPS", "0"},
+                                                         {"PS2X_TAMANO_VENTANA", "800x600"}});
+            for (const char *variable :
+                 {"PS2X_PANTALLA", "PS2X_FILTRO", "PS2X_VSYNC", "PS2X_MOSTRAR_FPS", "PS2X_TAMANO_VENTANA"})
+                t.IsTrue(set.count(variable) == 0u, std::string(variable) + " already set is not touched");
+            t.IsTrue(settingsOf(options, {{"PS2X_PANTALLA_COMPLETA", "1"}}).count("PS2X_PANTALLA") == 0u,
+                     "the old variable keeps the file from setting PS2X_PANTALLA");
+        });
+
+        tc.Run("displaySettingsFromEnvironment reads the variables; unset or bad ones keep the old presentation", [](TestCase &t)
+        {
+            const Environment none;
+            t.IsTrue(ps2x::displaySettingsFromEnvironment(environmentOf(none)) == DisplaySettings{},
+                     "nothing set: bilinear, no vsync, no counter, a 960x720 window");
+            const DisplaySettings defaults;
+            t.IsTrue(defaults.filter == FrameFilter::Bilinear && !defaults.vsync && !defaults.showFps &&
+                         defaults.windowMode == WindowMode::Windowed && defaults.windowWidth == 960 &&
+                         defaults.windowHeight == 720,
+                     "the defaults");
+
+            const Environment all = {{"PS2X_FILTRO", "fsr"}, {"PS2X_VSYNC", "1"}, {"PS2X_MOSTRAR_FPS", "1"},
+                                     {"PS2X_PANTALLA", "completa"}, {"PS2X_TAMANO_VENTANA", "1280x960"}};
+            const DisplaySettings read = ps2x::displaySettingsFromEnvironment(environmentOf(all));
+            t.IsTrue(read.filter == FrameFilter::Fsr && read.vsync && read.showFps &&
+                         read.windowMode == WindowMode::Fullscreen && read.windowWidth == 1280 && read.windowHeight == 960,
+                     "every variable");
+
+            const std::map<std::string, FrameFilter> filters = {
+                {"0", FrameFilter::Nearest}, {"1", FrameFilter::Bilinear}, {"cercano", FrameFilter::Nearest},
+                {"bilineal", FrameFilter::Bilinear}, {"nitido", FrameFilter::Sharp}, {"fsr", FrameFilter::Fsr},
+                {"crt", FrameFilter::Crt}, {"lanczos", FrameFilter::Bilinear}, {"", FrameFilter::Bilinear}};
+            for (const auto &[value, filter] : filters)
+                t.IsTrue(ps2x::displaySettingsFromEnvironment(environmentOf({{"PS2X_FILTRO", value}})).filter == filter,
+                         "PS2X_FILTRO='" + value + "'");
+
+            t.IsTrue(ps2x::displaySettingsFromEnvironment(environmentOf({{"PS2X_PANTALLA_COMPLETA", "1"}})).windowMode ==
+                         WindowMode::Borderless,
+                     "old PS2X_PANTALLA_COMPLETA=1 -> sin_bordes");
+            t.IsTrue(ps2x::displaySettingsFromEnvironment(environmentOf({{"PS2X_PANTALLA_COMPLETA", "0"}})).windowMode ==
+                         WindowMode::Windowed,
+                     "old PS2X_PANTALLA_COMPLETA=0 -> ventana");
+            t.IsTrue(ps2x::displaySettingsFromEnvironment(
+                         environmentOf({{"PS2X_PANTALLA_COMPLETA", "1"}, {"PS2X_PANTALLA", "ventana"}}))
+                             .windowMode == WindowMode::Windowed,
+                     "PS2X_PANTALLA wins over the old variable");
+            const DisplaySettings bad = ps2x::displaySettingsFromEnvironment(
+                environmentOf({{"PS2X_VSYNC", "x"}, {"PS2X_MOSTRAR_FPS", "2"}, {"PS2X_PANTALLA", "total"},
+                               {"PS2X_TAMANO_VENTANA", "10x10"}}));
+            t.IsTrue(bad == DisplaySettings{}, "bad values keep the defaults");
+        });
+
+        tc.Run("DisplaySettings map to the opciones.ini values and back", [](TestCase &t)
+        {
+            DisplaySettings settings;
+            settings.filter = FrameFilter::Crt;
+            settings.vsync = true;
+            settings.showFps = true;
+            settings.windowMode = WindowMode::Borderless;
+            settings.windowWidth = 1280;
+            settings.windowHeight = 960;
+            const std::map<std::string, std::string> values = ps2x::displayOptionValues(settings);
+            const std::map<std::string, std::string> expected = {{"filtro", "crt"}, {"vsync", "1"}, {"mostrar_fps", "1"},
+                                                                 {"pantalla", "sin_bordes"},
+                                                                 {"tamano_ventana", "1280x960"}};
+            t.IsTrue(values == expected, "the five opciones.ini values");
+            t.IsTrue(ps2x::displaySettingsFromOptionValues(values) == settings, "and back");
+
+            for (const FrameFilter filter :
+                 {FrameFilter::Nearest, FrameFilter::Bilinear, FrameFilter::Sharp, FrameFilter::Fsr, FrameFilter::Crt})
+                for (const WindowMode mode : {WindowMode::Windowed, WindowMode::Borderless, WindowMode::Fullscreen})
+                {
+                    DisplaySettings each;
+                    each.filter = filter;
+                    each.windowMode = mode;
+                    each.vsync = mode != WindowMode::Windowed;
+                    std::string text;
+                    for (const auto &[key, value] : ps2x::displayOptionValues(each))
+                        text += key + " = " + value + "\n";
+                    const ps2x::OptionsFile parsed = ps2x::parseOptions(text);
+                    const std::string name = std::string(ps2x::frameFilterName(filter)) + "/" + ps2x::windowModeName(mode);
+                    t.IsTrue(parsed.warnings.empty(), name + ": the values are valid opciones.ini values");
+                    t.IsTrue(ps2x::displaySettingsFromOptionValues(parsed.values) == each, name + ": from the file");
+                    const Environment set = settingsOf(parsed);
+                    t.IsTrue(ps2x::displaySettingsFromEnvironment(environmentOf(set)) == each, name + ": through the variables");
+                }
+            t.IsTrue(ps2x::displaySettingsFromOptionValues({}) == DisplaySettings{}, "missing values: the defaults");
+        });
+
+        tc.Run("names of the filters and window modes", [](TestCase &t)
+        {
+            t.Equals(std::string(ps2x::frameFilterName(FrameFilter::Nearest)), std::string("cercano"), "cercano");
+            t.Equals(std::string(ps2x::frameFilterName(FrameFilter::Bilinear)), std::string("bilineal"), "bilineal");
+            t.Equals(std::string(ps2x::frameFilterName(FrameFilter::Sharp)), std::string("nitido"), "nitido");
+            t.Equals(std::string(ps2x::frameFilterName(FrameFilter::Fsr)), std::string("fsr"), "fsr");
+            t.Equals(std::string(ps2x::frameFilterName(FrameFilter::Crt)), std::string("crt"), "crt");
+            t.Equals(std::string(ps2x::windowModeName(WindowMode::Windowed)), std::string("ventana"), "ventana");
+            t.Equals(std::string(ps2x::windowModeName(WindowMode::Borderless)), std::string("sin_bordes"), "sin_bordes");
+            t.Equals(std::string(ps2x::windowModeName(WindowMode::Fullscreen)), std::string("completa"), "completa");
+            WindowMode mode = WindowMode::Windowed;
+            t.IsTrue(!ps2x::parseWindowMode("1", mode) && mode == WindowMode::Windowed, "no number for pantalla");
+            int width = 0, height = 0;
+            t.IsTrue(ps2x::parseWindowSize("320x240", width, height) && width == 320 && height == 240, "the smallest size");
+            t.IsTrue(!ps2x::parseWindowSize("320x239", width, height), "too short");
+            t.Equals(ps2x::windowSizeText(1920, 1080), std::string("1920x1080"), "size text");
+        });
+
+        tc.Run("sharp bilinear prescales by the whole times the picture fits", [](TestCase &t)
+        {
+            const auto check = [&](float sw, float sh, float dw, float dh, int x, int y)
+            {
+                const ps2x::Prescale p = ps2x::sharpPrescale(sw, sh, dw, dh);
+                t.IsTrue(p.x == x && p.y == y,
+                         std::to_string(sw) + "x" + std::to_string(sh) + " -> " + std::to_string(dw) + "x" +
+                             std::to_string(dh) + ": " + std::to_string(p.x) + "," + std::to_string(p.y));
+            };
+            check(640, 448, 1280, 960, 2, 2);
+            check(512, 448, 1440, 1080, 2, 2);
+            check(512, 448, 2880, 2160, 5, 4);
+            check(1024, 896, 1280, 960, 1, 1); // alta_resolucion in a 1280x960 window: plain bilinear
+            check(1024, 896, 640, 480, 1, 1);  // smaller than the frame
+            check(0, 0, 640, 480, 1, 1);
+        });
+
+        tc.Run("the CRT scanlines are the PS2 lines while each gets 3 window pixels", [](TestCase &t)
+        {
+            t.Equals(ps2x::crtScanlines(448, 1440.0f), 448, "448 lines in 1440 pixels");
+            t.Equals(ps2x::crtScanlines(448, 1344.0f), 448, "exactly 3 pixels each");
+            t.Equals(ps2x::crtScanlines(448, 960.0f), 224, "960 pixels: the 224 field lines");
+            t.Equals(ps2x::crtScanlines(896, 2160.0f), 448, "alta_resolucion frames have the PS2 lines halved");
+            t.Equals(ps2x::crtScanlines(896, 960.0f), 224, "and halved again in a small window");
+            t.Equals(ps2x::crtScanlines(512, 480.0f), 128, "never below 3 pixels while lines can halve");
+            t.Equals(ps2x::crtScanlines(448, 100.0f), 112, "at least 100 lines");
+            t.Equals(ps2x::crtScanlines(0, 960.0f), 1, "no frame: one line");
+        });
+
+        tc.Run("window mode changes and F11", [](TestCase &t)
+        {
+            t.Equals(stepsText(ps2x::windowModeSteps(WindowMode::Windowed, WindowMode::Windowed)), std::string(""), "none");
+            t.Equals(stepsText(ps2x::windowModeSteps(WindowMode::Windowed, WindowMode::Borderless)),
+                     std::string("+sin_bordes "), "window -> borderless");
+            t.Equals(stepsText(ps2x::windowModeSteps(WindowMode::Windowed, WindowMode::Fullscreen)),
+                     std::string("+completa "), "window -> fullscreen");
+            t.Equals(stepsText(ps2x::windowModeSteps(WindowMode::Borderless, WindowMode::Fullscreen)),
+                     std::string("-sin_bordes +completa "), "borderless -> fullscreen");
+            t.Equals(stepsText(ps2x::windowModeSteps(WindowMode::Fullscreen, WindowMode::Borderless)),
+                     std::string("-completa +sin_bordes "), "fullscreen -> borderless");
+            t.Equals(stepsText(ps2x::windowModeSteps(WindowMode::Fullscreen, WindowMode::Windowed)),
+                     std::string("-completa "), "fullscreen -> window");
+            t.Equals(stepsText(ps2x::windowModeSteps(WindowMode::Borderless, WindowMode::Windowed)),
+                     std::string("-sin_bordes "), "borderless -> window");
+
+            t.IsTrue(ps2x::toggledWindowMode(WindowMode::Windowed, WindowMode::Windowed) == WindowMode::Borderless,
+                     "F11 in a window with pantalla = ventana: borderless, as before");
+            t.IsTrue(ps2x::toggledWindowMode(WindowMode::Windowed, WindowMode::Fullscreen) == WindowMode::Fullscreen,
+                     "F11 with pantalla = completa: exclusive full screen");
+            t.IsTrue(ps2x::toggledWindowMode(WindowMode::Windowed, WindowMode::Borderless) == WindowMode::Borderless,
+                     "F11 with pantalla = sin_bordes: borderless");
+            t.IsTrue(ps2x::toggledWindowMode(WindowMode::Borderless, WindowMode::Fullscreen) == WindowMode::Windowed,
+                     "F11 in full screen: back to the window");
+            t.IsTrue(ps2x::toggledWindowMode(WindowMode::Fullscreen, WindowMode::Fullscreen) == WindowMode::Windowed,
+                     "F11 in exclusive full screen: back to the window");
+        });
+
+        tc.Run("applyDisplaySettings keeps the settings for the window's next frame", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            t.IsTrue(runtime.displaySettings() == DisplaySettings{}, "before initialize: the defaults");
+            DisplaySettings settings;
+            settings.filter = FrameFilter::Sharp;
+            settings.vsync = true;
+            settings.showFps = true;
+            settings.windowMode = WindowMode::Fullscreen;
+            settings.windowWidth = 1280;
+            settings.windowHeight = 960;
+            runtime.applyDisplaySettings(settings);
+            t.IsTrue(runtime.displaySettings() == settings, "the requested settings are the current ones");
+        });
+
+        tc.Run("the game frame counter counts buffer changes, not register writes, at any window rate", [](TestCase &t)
+        {
+            constexpr uint64_t kA = 0x00u, kB = 0x46u; // two FBP values
+            // 50 frames a second writing DISPFB1 and DISPFB2 (two flips each), seen by a window at 60 Hz.
+            ps2x::GameFrameCounter both;
+            for (int k = 0; k <= 120; ++k)
+            {
+                const double seconds = k / 60.0;
+                const uint64_t frames = static_cast<uint64_t>(seconds * 50.0 + 1e-9);
+                const uint64_t shown = (frames & 1u) != 0u ? kB : kA;
+                both.sample(2u * frames, shown, shown, 0x3u, seconds);
+            }
+            t.IsTrue(both.rate() > 49.0 && both.rate() < 51.0, "both registers, 60 Hz window: " + std::to_string(both.rate()));
+
+            // A window at 12 Hz (VSync with the monitor asleep) that always lands on the same buffer: the flips still
+            // count, two per frame because PMODE shows both read circuits.
+            ps2x::GameFrameCounter slow;
+            for (int k = 0; k <= 24; ++k)
+                slow.sample(8u * static_cast<uint64_t>(k), kA, kA, 0x3u, k / 12.0);
+            t.IsTrue(slow.rate() > 47.0 && slow.rate() < 49.0, "aliased 12 Hz window: " + std::to_string(slow.rate()));
+
+            // One read circuit, only DISPFB1 flips.
+            ps2x::GameFrameCounter one;
+            for (int k = 0; k <= 120; ++k)
+            {
+                const double seconds = k / 60.0;
+                const uint64_t frames = static_cast<uint64_t>(seconds * 25.0 + 1e-9);
+                one.sample(frames, (frames & 1u) != 0u ? kB : kA, kA, 0x1u, seconds);
+            }
+            t.IsTrue(one.rate() > 24.0 && one.rate() < 26.0, "one register at 25 fps: " + std::to_string(one.rate()));
+
+            ps2x::GameFrameCounter still;
+            for (int k = 0; k <= 120; ++k)
+                still.sample(10u, kA, kA, 0x3u, k / 60.0);
+            t.Equals(still.rate(), 0.0, "no flips: 0");
+        });
+
+        tc.Run("the frame rate meter counts per second", [](TestCase &t)
+        {
+            ps2x::RateMeter meter;
+            t.IsTrue(!meter.sample(100u, 10.0), "the first sample only starts");
+            t.Equals(meter.rate(), 0.0, "no rate yet");
+            t.IsTrue(!meter.sample(140u, 10.5), "half a second: not yet");
+            t.IsTrue(meter.sample(150u, 11.0), "a second");
+            t.Equals(meter.rate(), 50.0, "50 per second");
+            t.IsTrue(meter.sample(200u, 13.0), "two seconds");
+            t.Equals(meter.rate(), 25.0, "25 per second");
+        });
+    });
+}
