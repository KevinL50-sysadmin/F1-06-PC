diff --git a/ps2xRuntime/src/lib/ps2_display.cpp b/ps2xRuntime/src/lib/ps2_display.cpp
new file mode 100644
index 0000000..772b6d3
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_display.cpp
@@ -0,0 +1,569 @@
+#include "ps2_display.h"
+#include "shaders/ps2_display_shaders.h"
+
+#include "raylib.h"
+#include "rlgl.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace ps2x
+{
+    namespace
+    {
+        struct FilterName
+        {
+            FrameFilter filter;
+            const char *name;
+        };
+        constexpr FilterName kFilterNames[] = {{FrameFilter::Nearest, "cercano"}, {FrameFilter::Bilinear, "bilineal"},
+                                               {FrameFilter::Sharp, "nitido"},    {FrameFilter::Fsr, "fsr"},
+                                               {FrameFilter::Crt, "crt"}};
+
+        struct ModeName
+        {
+            WindowMode mode;
+            const char *name;
+        };
+        constexpr ModeName kModeNames[] = {
+            {WindowMode::Windowed, "ventana"},
+            {WindowMode::Borderless, "sin_bordes"},
+            {WindowMode::Fullscreen, "completa"}};
+
+        bool parseFlag(const char *text, bool &flag)
+        {
+            if (text == nullptr || (std::strcmp(text, "0") != 0 && std::strcmp(text, "1") != 0))
+                return false;
+            flag = text[0] == '1';
+            return true;
+        }
+
+        bool parsePositive(std::string_view text, int &value)
+        {
+            if (text.empty() || text.size() > 5u)
+                return false;
+            value = 0;
+            for (const char c : text)
+            {
+                if (c < '0' || c > '9')
+                    return false;
+                value = value * 10 + (c - '0');
+            }
+            return true;
+        }
+    }
+
+    const char *frameFilterName(FrameFilter filter)
+    {
+        for (const FilterName &entry : kFilterNames)
+            if (entry.filter == filter)
+                return entry.name;
+        return "bilineal";
+    }
+
+    bool parseFrameFilter(std::string_view text, FrameFilter &filter)
+    {
+        if (text == "0" || text == "1")
+        {
+            filter = text == "0" ? FrameFilter::Nearest : FrameFilter::Bilinear;
+            return true;
+        }
+        for (const FilterName &entry : kFilterNames)
+            if (text == entry.name)
+            {
+                filter = entry.filter;
+                return true;
+            }
+        return false;
+    }
+
+    const char *windowModeName(WindowMode mode)
+    {
+        for (const ModeName &entry : kModeNames)
+            if (entry.mode == mode)
+                return entry.name;
+        return "ventana";
+    }
+
+    bool parseWindowMode(std::string_view text, WindowMode &mode)
+    {
+        for (const ModeName &entry : kModeNames)
+            if (text == entry.name)
+            {
+                mode = entry.mode;
+                return true;
+            }
+        return false;
+    }
+
+    bool parseWindowSize(std::string_view text, int &width, int &height)
+    {
+        const size_t x = text.find_first_of("xX");
+        int w = 0, h = 0;
+        if (x == std::string_view::npos || !parsePositive(text.substr(0, x), w) ||
+            !parsePositive(text.substr(x + 1u), h))
+            return false;
+        if (w < kMinWindowWidth || w > kMaxWindowWidth || h < kMinWindowHeight || h > kMaxWindowHeight)
+            return false;
+        width = w;
+        height = h;
+        return true;
+    }
+
+    std::string windowSizeText(int width, int height)
+    {
+        return std::to_string(width) + "x" + std::to_string(height);
+    }
+
+    DisplaySettings displaySettingsFromEnvironment(const std::function<const char *(const char *)> &getEnvironment)
+    {
+        DisplaySettings settings;
+        if (const char *filter = getEnvironment("PS2X_FILTRO"))
+            parseFrameFilter(filter, settings.filter);
+        parseFlag(getEnvironment("PS2X_VSYNC"), settings.vsync);
+        parseFlag(getEnvironment("PS2X_MOSTRAR_FPS"), settings.showFps);
+        const char *mode = getEnvironment("PS2X_PANTALLA");
+        if (mode == nullptr || !parseWindowMode(mode, settings.windowMode))
+        {
+            bool full = false;
+            if (parseFlag(getEnvironment("PS2X_PANTALLA_COMPLETA"), full) && full)
+                settings.windowMode = WindowMode::Borderless;
+        }
+        if (const char *size = getEnvironment("PS2X_TAMANO_VENTANA"))
+            parseWindowSize(size, settings.windowWidth, settings.windowHeight);
+        return settings;
+    }
+
+    std::map<std::string, std::string> displayOptionValues(const DisplaySettings &settings)
+    {
+        return {{"filtro", frameFilterName(settings.filter)},
+                {"vsync", settings.vsync ? "1" : "0"},
+                {"mostrar_fps", settings.showFps ? "1" : "0"},
+                {"pantalla", windowModeName(settings.windowMode)},
+                {"tamano_ventana", windowSizeText(settings.windowWidth, settings.windowHeight)}};
+    }
+
+    DisplaySettings displaySettingsFromOptionValues(const std::map<std::string, std::string> &values)
+    {
+        const auto value = [&values](const char *key) -> const char *
+        {
+            const auto found = values.find(key);
+            return found == values.end() ? nullptr : found->second.c_str();
+        };
+        DisplaySettings settings;
+        if (const char *filter = value("filtro"))
+            parseFrameFilter(filter, settings.filter);
+        parseFlag(value("vsync"), settings.vsync);
+        parseFlag(value("mostrar_fps"), settings.showFps);
+        if (const char *mode = value("pantalla"))
+            parseWindowMode(mode, settings.windowMode);
+        if (const char *size = value("tamano_ventana"))
+            parseWindowSize(size, settings.windowWidth, settings.windowHeight);
+        return settings;
+    }
+
+    Prescale sharpPrescale(float sourceWidth, float sourceHeight, float destinationWidth, float destinationHeight)
+    {
+        const auto axis = [](float source, float destination)
+        {
+            if (!(source > 0.0f) || !(destination > 0.0f))
+                return 1;
+            return std::max(1, static_cast<int>(std::floor(destination / source)));
+        };
+        return {axis(sourceWidth, destinationWidth), axis(sourceHeight, destinationHeight)};
+    }
+
+    int crtScanlines(int frameHeight, float destinationHeight)
+    {
+        if (frameHeight <= 0)
+            return 1;
+        int lines = frameHeight > 512 ? frameHeight / 2 : frameHeight;
+        while (lines / 2 >= 100 && destinationHeight < 3.0f * static_cast<float>(lines))
+            lines /= 2;
+        return lines;
+    }
+
+    std::vector<WindowStep> windowModeSteps(WindowMode from, WindowMode to)
+    {
+        std::vector<WindowStep> steps;
+        if (from == to)
+            return steps;
+        if (from == WindowMode::Borderless)
+            steps.push_back(WindowStep::LeaveBorderless);
+        else if (from == WindowMode::Fullscreen)
+            steps.push_back(WindowStep::LeaveFullscreen);
+        if (to == WindowMode::Borderless)
+            steps.push_back(WindowStep::EnterBorderless);
+        else if (to == WindowMode::Fullscreen)
+            steps.push_back(WindowStep::EnterFullscreen);
+        return steps;
+    }
+
+    WindowMode toggledWindowMode(WindowMode current, WindowMode configured)
+    {
+        if (current != WindowMode::Windowed)
+            return WindowMode::Windowed;
+        return configured == WindowMode::Windowed ? WindowMode::Borderless : configured;
+    }
+
+    bool GameFrameCounter::sample(uint64_t flips, uint64_t dispfb1, uint64_t dispfb2, uint64_t pmode, double seconds)
+    {
+        constexpr uint64_t kFbp = 0x1FFu;
+        if (m_started && flips > m_flips)
+        {
+            const int changed = ((dispfb1 ^ m_dispfb1) & kFbp ? 1 : 0) + ((dispfb2 ^ m_dispfb2) & kFbp ? 1 : 0);
+            if (changed != 0)
+                m_flipsPerFrame = changed;
+            else if (m_flipsPerFrame == 0)
+                m_flipsPerFrame = std::max(1, static_cast<int>(pmode & 1u) + static_cast<int>((pmode >> 1) & 1u));
+            m_frames += static_cast<double>(flips - m_flips) / m_flipsPerFrame;
+        }
+        m_started = true;
+        m_flips = flips;
+        m_dispfb1 = dispfb1;
+        m_dispfb2 = dispfb2;
+        return m_meter.sample(m_frames, seconds);
+    }
+
+    bool RateMeter::sample(double count, double seconds)
+    {
+        if (!m_started)
+        {
+            m_started = true;
+            m_count = count;
+            m_seconds = seconds;
+            return false;
+        }
+        const double elapsed = seconds - m_seconds;
+        if (elapsed < 1.0)
+            return false;
+        m_rate = (count - m_count) / elapsed;
+        m_count = count;
+        m_seconds = seconds;
+        return true;
+    }
+}
+
+// ---- The window side (raylib) ----
+
+namespace ps2x
+{
+    namespace
+    {
+        constexpr float kRcasSharpnessStops = 0.2f; // AMD's suggested default
+
+        int textureFilterOf(FrameFilter filter)
+        {
+            return filter == FrameFilter::Nearest ? TEXTURE_FILTER_POINT : TEXTURE_FILTER_BILINEAR;
+        }
+
+        // The cap of the frame loop: SetTargetFPS(60) without VSync, as before phase 3. With VSync the swap already
+        // waits for the monitor; the cap (twice its rate) only keeps the loop from spinning when the driver forces
+        // VSync off or the window is not on a monitor.
+        int targetFps(bool vsync, int refreshRate)
+        {
+            return vsync ? std::max(120, 2 * refreshRate) : 60;
+        }
+
+        struct LoadedShader
+        {
+            Shader shader{};
+            bool tried = false;
+            bool valid = false;
+        };
+
+        bool ensureShader(LoadedShader &loaded, const char *code, const char *name)
+        {
+            if (!loaded.tried)
+            {
+                loaded.tried = true;
+                loaded.shader = LoadShaderFromMemory(nullptr, code);
+                loaded.valid = IsShaderValid(loaded.shader) && loaded.shader.id != rlGetShaderIdDefault();
+                if (!loaded.valid)
+                    std::fprintf(stderr, "[ventana] el shader %s no compila; se usa bilineal\n", name);
+            }
+            return loaded.valid;
+        }
+
+        void unloadShader(LoadedShader &loaded)
+        {
+            if (loaded.valid)
+                UnloadShader(loaded.shader);
+            loaded = LoadedShader{};
+        }
+
+        void setVec2(const Shader &shader, const char *name, float x, float y)
+        {
+            const float value[2] = {x, y};
+            SetShaderValue(shader, GetShaderLocation(shader, name), value, SHADER_UNIFORM_VEC2);
+        }
+
+        void setFloat(const Shader &shader, const char *name, float value)
+        {
+            SetShaderValue(shader, GetShaderLocation(shader, name), &value, SHADER_UNIFORM_FLOAT);
+        }
+    }
+
+    struct DisplayPresenter::State
+    {
+        DisplaySettings settings;
+        bool background = false;
+        WindowMode fullscreenChoice = WindowMode::Borderless; // where F11 goes from the window
+        int windowedWidth = 0, windowedHeight = 0;            // the window before exclusive full screen
+        int refreshRate = 60;
+        double refreshCheckedAt = -10.0;
+        unsigned int filteredTexture = 0u;
+        int textureFilter = -1;
+        LoadedShader sharp, crt, easu, rcas;
+        RenderTexture2D upscaled{};
+        bool upscaledValid = false;
+        float crtCurvature = 0.0f;
+    };
+
+    DisplayPresenter::DisplayPresenter() : m_state(std::make_unique<State>()) {}
+    DisplayPresenter::~DisplayPresenter() = default;
+
+    const DisplaySettings &DisplayPresenter::current() const
+    {
+        return m_state->settings;
+    }
+
+    void DisplayPresenter::start(const DisplaySettings &settings, bool backgroundWindow)
+    {
+        State &s = *m_state;
+        s.background = backgroundWindow;
+        s.refreshRate = std::max(1, GetMonitorRefreshRate(GetCurrentMonitor()));
+        const char *curvature = std::getenv("PS2X_CRT_CURVATURA");
+        s.crtCurvature = curvature != nullptr && curvature[0] == '1' ? 1.0f : 0.0f;
+        // The window starts as a window of the settings' size, without VSync (raylib's default) and capped at 60.
+        s.settings = settings;
+        s.settings.windowMode = WindowMode::Windowed;
+        s.settings.vsync = false;
+        SetTargetFPS(targetFps(false, s.refreshRate));
+        if (backgroundWindow && settings.windowMode != WindowMode::Windowed)
+            std::fprintf(stderr, "[ventana] pantalla = %s no se usa con la ventana en segundo plano\n",
+                         windowModeName(settings.windowMode));
+        apply(settings);
+        const int monitor = GetCurrentMonitor();
+        std::fprintf(stderr,
+                     "[ventana] filtro=%s vsync=%d mostrar_fps=%d pantalla=%s tamano=%dx%d; "
+                     "monitor %d (%s): %dx%d a %d Hz\n",
+                     frameFilterName(s.settings.filter), s.settings.vsync ? 1 : 0, s.settings.showFps ? 1 : 0,
+                     windowModeName(s.settings.windowMode), s.settings.windowWidth, s.settings.windowHeight, monitor,
+                     GetMonitorName(monitor), GetMonitorWidth(monitor), GetMonitorHeight(monitor), s.refreshRate);
+    }
+
+    void DisplayPresenter::apply(const DisplaySettings &requested)
+    {
+        State &s = *m_state;
+        DisplaySettings next = requested;
+        if (s.background)
+            next.windowMode = WindowMode::Windowed;
+
+        if (next.vsync != s.settings.vsync)
+        {
+            if (next.vsync)
+                SetWindowState(FLAG_VSYNC_HINT);
+            else
+                ClearWindowState(FLAG_VSYNC_HINT);
+            SetTargetFPS(targetFps(next.vsync, s.refreshRate));
+        }
+
+        const bool sizeChanged =
+            next.windowWidth != s.settings.windowWidth || next.windowHeight != s.settings.windowHeight;
+        bool leftFullscreen = false;
+        for (const WindowStep step : windowModeSteps(s.settings.windowMode, next.windowMode))
+        {
+            switch (step)
+            {
+            case WindowStep::LeaveBorderless:
+                if (IsWindowState(FLAG_BORDERLESS_WINDOWED_MODE))
+                    ToggleBorderlessWindowed();
+                break;
+            case WindowStep::LeaveFullscreen:
+                if (IsWindowFullscreen())
+                {
+                    ToggleFullscreen();
+                    leftFullscreen = true;
+                }
+                break;
+            case WindowStep::EnterBorderless:
+                ToggleBorderlessWindowed();
+                break;
+            case WindowStep::EnterFullscreen:
+            {
+                // Exclusive full screen at the desktop resolution: raylib's ToggleFullscreen asks GLFW for the video
+                // mode closest to the window's size (at the highest refresh rate), so the window takes the monitor's
+                // size first. Leaving it gives the window back its size.
+                s.windowedWidth = GetScreenWidth();
+                s.windowedHeight = GetScreenHeight();
+                const int monitor = GetCurrentMonitor();
+                SetWindowSize(GetMonitorWidth(monitor), GetMonitorHeight(monitor));
+                ToggleFullscreen();
+                break;
+            }
+            }
+        }
+        if (next.windowMode == WindowMode::Windowed)
+        {
+            if (sizeChanged)
+                SetWindowSize(next.windowWidth, next.windowHeight);
+            else if (leftFullscreen && s.windowedWidth > 0)
+                SetWindowSize(s.windowedWidth, s.windowedHeight);
+        }
+        else
+            s.fullscreenChoice = next.windowMode;
+        s.settings = next;
+    }
+
+    const DisplaySettings &DisplayPresenter::toggleFullscreen()
+    {
+        State &s = *m_state;
+        if (!s.background)
+        {
+            DisplaySettings next = s.settings;
+            next.windowMode = toggledWindowMode(s.settings.windowMode, s.fullscreenChoice);
+            apply(next);
+        }
+        return s.settings;
+    }
+
+    void DisplayPresenter::drawFrame(unsigned int textureId, int textureWidth, int textureHeight, float sourceWidth,
+                                     float sourceHeight, float x, float y, float width, float height)
+    {
+        State &s = *m_state;
+        const Texture2D frame{textureId, textureWidth, textureHeight, 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+        FrameFilter filter = s.settings.filter;
+        if ((filter == FrameFilter::Sharp && !ensureShader(s.sharp, shaders::kSharpBilinear, "nitido")) ||
+            (filter == FrameFilter::Crt && !ensureShader(s.crt, shaders::kCrt, "crt")) ||
+            (filter == FrameFilter::Fsr && (!ensureShader(s.easu, shaders::kFsrEasu, "fsr (EASU)") ||
+                                            !ensureShader(s.rcas, shaders::kFsrRcas, "fsr (RCAS)"))))
+            filter = FrameFilter::Bilinear;
+        const int textureFilter = textureFilterOf(filter);
+        if (textureId != s.filteredTexture || textureFilter != s.textureFilter)
+        {
+            SetTextureFilter(frame, textureFilter);
+            s.filteredTexture = textureId;
+            s.textureFilter = textureFilter;
+        }
+        const Rectangle source{0.0f, 0.0f, sourceWidth, sourceHeight};
+        const Rectangle destination{x, y, width, height};
+
+        switch (filter)
+        {
+        case FrameFilter::Nearest:
+        case FrameFilter::Bilinear:
+            DrawTexturePro(frame, source, destination, Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+            return;
+        case FrameFilter::Sharp:
+        {
+            const Prescale prescale = sharpPrescale(sourceWidth, sourceHeight, width, height);
+            BeginShaderMode(s.sharp.shader);
+            setVec2(s.sharp.shader, "textureSize", static_cast<float>(textureWidth), static_cast<float>(textureHeight));
+            setVec2(s.sharp.shader, "prescale", static_cast<float>(prescale.x), static_cast<float>(prescale.y));
+            DrawTexturePro(frame, source, destination, Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+            EndShaderMode();
+            return;
+        }
+        case FrameFilter::Crt:
+            BeginShaderMode(s.crt.shader);
+            setVec2(s.crt.shader, "textureSize", static_cast<float>(textureWidth), static_cast<float>(textureHeight));
+            setVec2(s.crt.shader, "sourceSize", sourceWidth, sourceHeight);
+            setFloat(s.crt.shader, "scanlines",
+                     static_cast<float>(crtScanlines(static_cast<int>(sourceHeight), height)));
+            setFloat(s.crt.shader, "curvature", s.crtCurvature);
+            DrawTexturePro(frame, source, destination, Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+            EndShaderMode();
+            return;
+        case FrameFilter::Fsr:
+            break;
+        }
+
+        // FSR: the picture at the window's size in a render texture (EASU when it grows on some axis; plain bilinear
+        // when the window is smaller than the frame on both, which EASU is not made for), then RCAS to the window
+        // pixel for pixel.
+        const int outWidth = std::max(1, static_cast<int>(std::lround(width)));
+        const int outHeight = std::max(1, static_cast<int>(std::lround(height)));
+        if (!s.upscaledValid || s.upscaled.texture.width != outWidth || s.upscaled.texture.height != outHeight)
+        {
+            if (s.upscaledValid)
+                UnloadRenderTexture(s.upscaled);
+            s.upscaled = LoadRenderTexture(outWidth, outHeight);
+            s.upscaledValid = IsRenderTextureValid(s.upscaled);
+            if (!s.upscaledValid)
+            {
+                DrawTexturePro(frame, source, destination, Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+                return;
+            }
+            SetTextureFilter(s.upscaled.texture, TEXTURE_FILTER_POINT);
+        }
+        const bool upscale =
+            static_cast<float>(outWidth) >= sourceWidth || static_cast<float>(outHeight) >= sourceHeight;
+        BeginTextureMode(s.upscaled);
+        ClearBackground(BLACK);
+        if (upscale)
+        {
+            BeginShaderMode(s.easu.shader);
+            setVec2(s.easu.shader, "textureSize", static_cast<float>(textureWidth), static_cast<float>(textureHeight));
+            setVec2(s.easu.shader, "sourceSize", sourceWidth, sourceHeight);
+        }
+        DrawTexturePro(frame, source, Rectangle{0.0f, 0.0f, static_cast<float>(outWidth), static_cast<float>(outHeight)},
+                       Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+        if (upscale)
+            EndShaderMode();
+        EndTextureMode();
+
+        BeginShaderMode(s.rcas.shader);
+        setVec2(s.rcas.shader, "textureSize", static_cast<float>(outWidth), static_cast<float>(outHeight));
+        setFloat(s.rcas.shader, "sharpness", std::exp2(-kRcasSharpnessStops));
+        // Render textures are stored upside down: a negative source height flips them back.
+        const float w = static_cast<float>(outWidth), h = static_cast<float>(outHeight);
+        DrawTexturePro(s.upscaled.texture, Rectangle{0.0f, 0.0f, w, -h}, Rectangle{std::round(x), std::round(y), w, h},
+                       Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+        EndShaderMode();
+    }
+
+    void DisplayPresenter::drawOverlay(double gameRate)
+    {
+        State &s = *m_state;
+        const double now = GetTime();
+        if (now - s.refreshCheckedAt >= 1.0)
+        {
+            s.refreshCheckedAt = now;
+            const int refresh = std::max(1, GetMonitorRefreshRate(GetCurrentMonitor()));
+            if (refresh != s.refreshRate)
+            {
+                s.refreshRate = refresh;
+                SetTargetFPS(targetFps(s.settings.vsync, refresh));
+            }
+        }
+        if (!s.settings.showFps)
+            return;
+        const int fontSize = std::max(20, GetScreenHeight() / 40);
+        char game[64], screen[96];
+        std::snprintf(game, sizeof(game), "Juego: %.1f fps", gameRate);
+        std::snprintf(screen, sizeof(screen), "Monitor: %d Hz%s, ventana: %d fps", s.refreshRate,
+                      s.settings.vsync ? " (vsync)" : "", GetFPS());
+        const int margin = fontSize / 2;
+        const int width = std::max(MeasureText(game, fontSize), MeasureText(screen, fontSize)) + 2 * margin;
+        const int height = 2 * fontSize + 3 * margin;
+        DrawRectangle(margin, margin, width, height, Fade(BLACK, 0.6f));
+        DrawText(game, 2 * margin, 2 * margin, fontSize, YELLOW);
+        DrawText(screen, 2 * margin, 3 * margin + fontSize, fontSize, RAYWHITE);
+    }
+
+    void DisplayPresenter::unload()
+    {
+        State &s = *m_state;
+        unloadShader(s.sharp);
+        unloadShader(s.crt);
+        unloadShader(s.easu);
+        unloadShader(s.rcas);
+        if (s.upscaledValid)
+            UnloadRenderTexture(s.upscaled);
+        s.upscaledValid = false;
+    }
+}
