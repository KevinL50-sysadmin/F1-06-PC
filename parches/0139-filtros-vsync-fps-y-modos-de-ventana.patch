diff --git a/ps2xRuntime/src/lib/shaders/ps2_display_shaders.h b/ps2xRuntime/src/lib/shaders/ps2_display_shaders.h
new file mode 100644
index 0000000..a604c22
--- /dev/null
+++ b/ps2xRuntime/src/lib/shaders/ps2_display_shaders.h
@@ -0,0 +1,250 @@
+#pragma once
+
+// Phase 3 (T2): the fragment shaders of the frame filters (GLSL 3.30, raylib's default vertex shader: fragTexCoord and
+// fragColor). Embedded so the .exe needs no extra files. ps2_display.cpp loads them on the main thread.
+namespace ps2x::shaders
+{
+    // nitido: sharp bilinear. The texture (bilinear filtering) is sampled as if it had been scaled up by a whole
+    // factor first (prescale, ps2x::sharpPrescale) with nearest: inside each source pixel the colour is flat, and only
+    // the last fraction of a window pixel at its edge blends with the next one. Crisp pixels without the uneven widths
+    // (shimmering when scrolling) of nearest at a non-integer scale.
+    inline constexpr const char *kSharpBilinear = R"glsl(#version 330
+in vec2 fragTexCoord;
+in vec4 fragColor;
+uniform sampler2D texture0;
+uniform vec2 textureSize;
+uniform vec2 prescale;
+out vec4 finalColor;
+
+void main()
+{
+    vec2 texel = fragTexCoord * textureSize;
+    vec2 texelFloored = floor(texel);
+    vec2 s = fract(texel);
+    vec2 regionRange = 0.5 - 0.5 / prescale;
+    vec2 centerDistance = s - 0.5;
+    vec2 f = (centerDistance - clamp(centerDistance, -regionRange, regionRange)) * prescale + 0.5;
+    finalColor = vec4(texture(texture0, (texelFloored + f) / textureSize).rgb, 1.0);
+}
+)glsl";
+
+    // crt: a light CRT look. Each scanline takes the colour at its centre and draws it as a beam (a gaussian across
+    // the line, wider for bright colours), with a soft aperture-grille mask on the window columns. Curvature is off
+    // unless PS2X_CRT_CURVATURA=1.
+    inline constexpr const char *kCrt = R"glsl(#version 330
+in vec2 fragTexCoord;
+in vec4 fragColor;
+uniform sampler2D texture0;
+uniform vec2 textureSize; // texels of the frame texture
+uniform vec2 sourceSize;  // the picture, in the texture's top left corner
+uniform float scanlines;  // lines across the picture (ps2x::crtScanlines)
+uniform float curvature;  // 0: flat
+out vec4 finalColor;
+
+vec2 curve(vec2 uv)
+{
+    uv = uv * 2.0 - 1.0;
+    vec2 offset = abs(uv.yx) / vec2(6.0, 5.0);
+    uv = uv + uv * offset * offset * curvature;
+    return uv * 0.5 + 0.5;
+}
+
+void main()
+{
+    vec2 uv = fragTexCoord * textureSize / sourceSize; // 0..1 across the picture
+    if (curvature > 0.0)
+    {
+        uv = curve(uv);
+        if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))))
+        {
+            finalColor = vec4(0.0, 0.0, 0.0, 1.0);
+            return;
+        }
+    }
+    float line = uv.y * scanlines;
+    float lineCentre = floor(line) + 0.5;
+    float d = line - lineCentre;
+    vec2 sampleUv = vec2(uv.x, lineCentre / scanlines) * sourceSize / textureSize;
+    vec3 colour = pow(texture(texture0, sampleUv).rgb, vec3(2.2));
+    float luma = dot(colour, vec3(0.299, 0.587, 0.114));
+    float width = mix(0.30, 0.45, luma);
+    float beam = exp(-0.5 * d * d / (width * width));
+    colour *= beam * 1.45;
+    vec3 mask = vec3(0.88);
+    mask[int(mod(floor(gl_FragCoord.x), 3.0))] = 1.12;
+    colour *= mask;
+    finalColor = vec4(pow(clamp(colour, 0.0, 1.0), vec3(1.0 / 2.2)), 1.0);
+}
+)glsl";
+
+    // fsr: AMD FidelityFX Super Resolution 1 (FSR 1.0), ported to GLSL from the float path of ffx_fsr1.h:
+    // EASU (edge adaptive spatial upsampling) draws the picture at the window's size into a render texture, then
+    // RCAS (robust contrast adaptive sharpening) draws that to the window pixel for pixel.
+    //
+    // Copyright (c) 2021 Advanced Micro Devices, Inc. All rights reserved.
+    // Permission is hereby granted, free of charge, to any person obtaining a copy
+    // of this software and associated documentation files (the "Software"), to deal
+    // in the Software without restriction, including without limitation the rights
+    // to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
+    // copies of the Software, and to permit persons to whom the Software is
+    // furnished to do so, subject to the following conditions:
+    // The above copyright notice and this permission notice shall be included in
+    // all copies or substantial portions of the Software.
+    // THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+    // IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+    // FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+    // AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+    // LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+    // OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
+    // THE SOFTWARE.
+    inline constexpr const char *kFsrEasu = R"glsl(#version 330
+// AMD FidelityFX Super Resolution 1.0 EASU, GLSL port. Copyright (c) 2021 Advanced Micro Devices, Inc. MIT license.
+in vec2 fragTexCoord;
+in vec4 fragColor;
+uniform sampler2D texture0;
+uniform vec2 textureSize; // texels of the frame texture
+uniform vec2 sourceSize;  // the picture, in the texture's top left corner
+out vec4 finalColor;
+
+vec3 tap(ivec2 p)
+{
+    return texelFetch(texture0, clamp(p, ivec2(0), ivec2(sourceSize) - 1), 0).rgb;
+}
+
+float luma2(vec3 c) // luma times 2, as FSR
+{
+    return c.b * 0.5 + (c.r * 0.5 + c.g);
+}
+
+float rcpLow(float x)
+{
+    return 1.0 / max(x, 1.0e-20);
+}
+
+void easuSet(inout vec2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE)
+{
+    //    a
+    //  b c d
+    //    e
+    float lenX = rcpLow(max(abs(lD - lC), abs(lC - lB)));
+    float dirX = lD - lB;
+    dir.x += dirX * w;
+    lenX = clamp(abs(dirX) * lenX, 0.0, 1.0);
+    len += lenX * lenX * w;
+    float lenY = rcpLow(max(abs(lE - lC), abs(lC - lA)));
+    float dirY = lE - lA;
+    dir.y += dirY * w;
+    lenY = clamp(abs(dirY) * lenY, 0.0, 1.0);
+    len += lenY * lenY * w;
+}
+
+void easuTap(inout vec3 aC, inout float aW, vec2 off, vec2 dir, vec2 len, float lob, float clp, vec3 c)
+{
+    vec2 v = vec2(off.x * dir.x + off.y * dir.y, off.x * (-dir.y) + off.y * dir.x) * len;
+    float d2 = min(dot(v, v), clp);
+    float wB = 0.4 * d2 - 1.0;
+    float wA = lob * d2 - 1.0;
+    wB *= wB;
+    wA *= wA;
+    wB = 1.5625 * wB - 0.5625;
+    float w = wB * wA;
+    aC += c * w;
+    aW += w;
+}
+
+void main()
+{
+    //    b c
+    //  e f g h
+    //  i j k l
+    //    n o
+    vec2 pp = fragTexCoord * textureSize - 0.5;
+    vec2 fp = floor(pp);
+    pp -= fp;
+    ivec2 p = ivec2(fp);
+    vec3 b = tap(p + ivec2(0, -1)), c = tap(p + ivec2(1, -1));
+    vec3 e = tap(p + ivec2(-1, 0)), f = tap(p), g = tap(p + ivec2(1, 0)), h = tap(p + ivec2(2, 0));
+    vec3 i = tap(p + ivec2(-1, 1)), j = tap(p + ivec2(0, 1)), k = tap(p + ivec2(1, 1)), l = tap(p + ivec2(2, 1));
+    vec3 n = tap(p + ivec2(0, 2)), o = tap(p + ivec2(1, 2));
+    float bL = luma2(b), cL = luma2(c), eL = luma2(e), fL = luma2(f), gL = luma2(g), hL = luma2(h);
+    float iL = luma2(i), jL = luma2(j), kL = luma2(k), lL = luma2(l), nL = luma2(n), oL = luma2(o);
+
+    vec2 dir = vec2(0.0);
+    float len = 0.0;
+    easuSet(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);
+    easuSet(dir, len, pp.x * (1.0 - pp.y), cL, fL, gL, hL, kL);
+    easuSet(dir, len, (1.0 - pp.x) * pp.y, fL, iL, jL, kL, nL);
+    easuSet(dir, len, pp.x * pp.y, gL, jL, kL, lL, oL);
+
+    vec2 dir2 = dir * dir;
+    float dirR = dir2.x + dir2.y;
+    bool zero = dirR < (1.0 / 32768.0);
+    dirR = zero ? 1.0 : inversesqrt(dirR);
+    dir.x = zero ? 1.0 : dir.x;
+    dir *= dirR;
+    len = len * 0.5;
+    len *= len;
+    float stretch = dot(dir, dir) / max(abs(dir.x), abs(dir.y));
+    vec2 len2 = vec2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
+    float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
+    float clp = 1.0 / lob;
+
+    vec3 min4 = min(min(f, g), min(j, k));
+    vec3 max4 = max(max(f, g), max(j, k));
+    vec3 aC = vec3(0.0);
+    float aW = 0.0;
+    easuTap(aC, aW, vec2(0.0, -1.0) - pp, dir, len2, lob, clp, b);
+    easuTap(aC, aW, vec2(1.0, -1.0) - pp, dir, len2, lob, clp, c);
+    easuTap(aC, aW, vec2(-1.0, 1.0) - pp, dir, len2, lob, clp, i);
+    easuTap(aC, aW, vec2(0.0, 1.0) - pp, dir, len2, lob, clp, j);
+    easuTap(aC, aW, vec2(0.0, 0.0) - pp, dir, len2, lob, clp, f);
+    easuTap(aC, aW, vec2(-1.0, 0.0) - pp, dir, len2, lob, clp, e);
+    easuTap(aC, aW, vec2(1.0, 1.0) - pp, dir, len2, lob, clp, k);
+    easuTap(aC, aW, vec2(2.0, 1.0) - pp, dir, len2, lob, clp, l);
+    easuTap(aC, aW, vec2(2.0, 0.0) - pp, dir, len2, lob, clp, h);
+    easuTap(aC, aW, vec2(1.0, 0.0) - pp, dir, len2, lob, clp, g);
+    easuTap(aC, aW, vec2(1.0, 2.0) - pp, dir, len2, lob, clp, o);
+    easuTap(aC, aW, vec2(0.0, 2.0) - pp, dir, len2, lob, clp, n);
+    finalColor = vec4(min(max4, max(min4, aC / aW)), 1.0);
+}
+)glsl";
+
+    inline constexpr const char *kFsrRcas = R"glsl(#version 330
+// AMD FidelityFX Super Resolution 1.0 RCAS, GLSL port. Copyright (c) 2021 Advanced Micro Devices, Inc. MIT license.
+in vec2 fragTexCoord;
+in vec4 fragColor;
+uniform sampler2D texture0;
+uniform vec2 textureSize; // the render texture, drawn pixel for pixel
+uniform float sharpness;  // exp2(-stops): 1.0 is the sharpest
+out vec4 finalColor;
+
+#define FSR_RCAS_LIMIT (0.25 - (1.0 / 16.0))
+
+vec3 tap(ivec2 p)
+{
+    return texelFetch(texture0, clamp(p, ivec2(0), ivec2(textureSize) - 1), 0).rgb;
+}
+
+void main()
+{
+    //    b
+    //  d e f
+    //    h
+    ivec2 sp = ivec2(fragTexCoord * textureSize);
+    vec3 b = tap(sp + ivec2(0, -1));
+    vec3 d = tap(sp + ivec2(-1, 0));
+    vec3 e = tap(sp);
+    vec3 f = tap(sp + ivec2(1, 0));
+    vec3 h = tap(sp + ivec2(0, 1));
+    vec3 mn4 = min(min(b, d), min(f, h));
+    vec3 mx4 = max(max(b, d), max(f, h));
+    vec2 peakC = vec2(1.0, -4.0);
+    vec3 hitMin = min(mn4, e) / max(4.0 * mx4, vec3(1.0 / 256.0));
+    vec3 hitMax = (peakC.x - max(mx4, e)) / min(4.0 * mn4 + peakC.y, vec3(-1.0 / 256.0));
+    vec3 lobeRGB = max(-hitMin, hitMax);
+    float lobe = max(-FSR_RCAS_LIMIT, min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * sharpness;
+    float rcpL = 1.0 / (4.0 * lobe + 1.0);
+    finalColor = vec4(clamp((lobe * (b + d + h + f) + e) * rcpL, 0.0, 1.0), 1.0);
+}
+)glsl";
+}
