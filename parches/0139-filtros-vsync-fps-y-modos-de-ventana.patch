diff --git a/ps2xRuntime/include/ps2_display.h b/ps2xRuntime/include/ps2_display.h
new file mode 100644
index 0000000..8b6cdfa
--- /dev/null
+++ b/ps2xRuntime/include/ps2_display.h
@@ -0,0 +1,158 @@
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Phase 3 (T2, F1 06): how the game frame is shown in the window. The options come from opciones.ini through their
+// PS2X_* variables (ps2_options.cpp); DisplaySettings is what the window applies, and what the in-game options menu
+// changes at run time (PS2Runtime::applyDisplaySettings).
+namespace ps2x
+{
+    // How the frame is scaled to the window (opciones.ini: filtro).
+    enum class FrameFilter
+    {
+        Nearest,  // cercano: the PS2 pixels as blocks
+        Bilinear, // bilineal: smooth (the default before phase 3)
+        Sharp,    // nitido: sharp bilinear, an integer prescale then bilinear (crisp pixels, no shimmering)
+        Fsr,      // fsr: AMD FidelityFX Super Resolution 1 (EASU upscale + RCAS sharpening)
+        Crt,      // crt: a simple CRT look (scanlines and a light mask)
+    };
+
+    // opciones.ini: pantalla.
+    enum class WindowMode
+    {
+        Windowed,   // ventana
+        Borderless, // sin_bordes: a borderless window as large as the monitor
+        Fullscreen, // completa: exclusive full screen at the desktop resolution
+    };
+
+    struct DisplaySettings
+    {
+        FrameFilter filter = FrameFilter::Bilinear;
+        bool vsync = false;
+        bool showFps = false;
+        WindowMode windowMode = WindowMode::Windowed;
+        int windowWidth = 960; // the window's size in windowed mode
+        int windowHeight = 720;
+
+        bool operator==(const DisplaySettings &) const = default;
+    };
+
+    constexpr int kMinWindowWidth = 320, kMinWindowHeight = 240;
+    constexpr int kMaxWindowWidth = 7680, kMaxWindowHeight = 4320;
+
+    // The opciones.ini names. parseFrameFilter also takes the old PS2X_FILTRO values 0 (cercano) and 1 (bilineal).
+    const char *frameFilterName(FrameFilter filter);
+    bool parseFrameFilter(std::string_view text, FrameFilter &filter);
+    const char *windowModeName(WindowMode mode);
+    bool parseWindowMode(std::string_view text, WindowMode &mode);
+    // "<width>x<height>" (digits only), from 320x240 to 7680x4320.
+    bool parseWindowSize(std::string_view text, int &width, int &height);
+    std::string windowSizeText(int width, int height);
+
+    // From the variables that opciones.ini sets (PS2X_FILTRO, PS2X_VSYNC, PS2X_MOSTRAR_FPS, PS2X_PANTALLA, or the old
+    // PS2X_PANTALLA_COMPLETA=1 when PS2X_PANTALLA is not set, and PS2X_TAMANO_VENTANA). Unset or bad: the defaults of
+    // DisplaySettings (the presentation before phase 3).
+    DisplaySettings displaySettingsFromEnvironment(const std::function<const char *(const char *)> &getEnvironment);
+
+    // The opciones.ini values of the settings (key -> value), for the options menu to save them, and back from the
+    // values of a parsed opciones.ini (OptionsFile::values; missing or bad values: the DisplaySettings defaults).
+    std::map<std::string, std::string> displayOptionValues(const DisplaySettings &settings);
+    DisplaySettings displaySettingsFromOptionValues(const std::map<std::string, std::string> &values);
+
+    // Sharp bilinear: the integer prescale on each axis, floor(destination / source) and at least 1.
+    struct Prescale
+    {
+        int x = 1;
+        int y = 1;
+    };
+    Prescale sharpPrescale(float sourceWidth, float sourceHeight, float destinationWidth, float destinationHeight);
+
+    // CRT: how many scanlines the picture gets. The PS2 lines (frame height, halved for the GS's double resolution
+    // output, taller than 512), halved again while a line would be less than 3 window pixels high (448 interlaced
+    // lines in a 960 pixel window would make moire; 224 field lines look right).
+    int crtScanlines(int frameHeight, float destinationHeight);
+
+    // The window changes to go from one mode to another, in order.
+    enum class WindowStep
+    {
+        LeaveBorderless,
+        LeaveFullscreen,
+        EnterBorderless,
+        EnterFullscreen,
+    };
+    std::vector<WindowStep> windowModeSteps(WindowMode from, WindowMode to);
+    // F11: from a window to the full screen mode chosen in the options (sin_bordes when it is ventana), and back.
+    WindowMode toggledWindowMode(WindowMode current, WindowMode configured);
+
+    // A count per second, updated once at least a second has passed.
+    class RateMeter
+    {
+    public:
+        // Returns true when the rate was updated.
+        bool sample(double count, double seconds);
+        double rate() const { return m_rate; }
+
+    private:
+        bool m_started = false;
+        double m_count = 0.0;
+        double m_seconds = 0.0;
+        double m_rate = 0.0;
+    };
+
+    // The game's frames per second for the FPS counter, sampled once per window frame: flips is g_ps2DisplayFlips (the
+    // writes to DISPFB1 or DISPFB2 that changed the buffer shown; a game showing both read circuits writes both, two
+    // per frame, as F1 06), dispfb1, dispfb2 and pmode the GS registers. Each frame is as many flips as registers
+    // changed since the last sample; when neither did (the window runs slower than the game and lands on the same
+    // buffer, as with VSync and the monitor asleep), as many as last time, or as the read circuits PMODE enables.
+    class GameFrameCounter
+    {
+    public:
+        bool sample(uint64_t flips, uint64_t dispfb1, uint64_t dispfb2, uint64_t pmode, double seconds);
+        double rate() const { return m_meter.rate(); }
+
+    private:
+        RateMeter m_meter;
+        bool m_started = false;
+        uint64_t m_flips = 0u, m_dispfb1 = 0u, m_dispfb2 = 0u;
+        int m_flipsPerFrame = 0;
+        double m_frames = 0.0;
+    };
+
+    // The window side of the settings (raylib; main thread only, between InitWindow and CloseWindow).
+    class DisplayPresenter
+    {
+    public:
+        DisplayPresenter();
+        ~DisplayPresenter();
+        DisplayPresenter(const DisplayPresenter &) = delete;
+        DisplayPresenter &operator=(const DisplayPresenter &) = delete;
+
+        // The settings the window starts with (InitWindow already used their windowed size). backgroundWindow: the
+        // hidden window of the automated runs, which never goes full screen.
+        void start(const DisplaySettings &settings, bool backgroundWindow);
+        // Changes what differs from the current settings: window mode and size, VSync and filter.
+        void apply(const DisplaySettings &settings);
+        // F11 (toggledWindowMode). Returns the settings with the new window mode.
+        const DisplaySettings &toggleFullscreen();
+        const DisplaySettings &current() const;
+
+        // Draws the frame texture's top left sourceWidth x sourceHeight pixels into the destination rectangle (window
+        // pixels) with the filter; between BeginDrawing and EndDrawing.
+        void drawFrame(unsigned int textureId, int textureWidth, int textureHeight, float sourceWidth, float sourceHeight,
+                       float x, float y, float width, float height);
+        // The FPS counter, when showFps: the game's frames per second and the monitor's refresh rate.
+        void drawOverlay(double gameRate);
+        // Before CloseWindow: the shaders and the render texture.
+        void unload();
+
+    private:
+        struct State;
+        std::unique_ptr<State> m_state;
+    };
+}
