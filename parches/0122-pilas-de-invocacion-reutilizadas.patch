 namespace
 {
+    // Patch 0122: invocation stacks are cached per (thread id, depth) and thread ids keep growing, so every race (new
+    // game threads) took fresh 16 KB stacks and none came back: after 13 quick races in a row the low memory and then
+    // the end of RAM ran out ("EE invocation stack space exhausted", the game closed). A deleted thread's stacks move
+    // to free entries of the same map (thread id 0xFFFFFFFF, never a real one; the stack top as the low half) and
+    // invocationStackTop takes one of those before reserving new memory.
+    constexpr uint64_t kFreeInvocationStackOwner = 0xFFFFFFFFull << 32u;
+
+    void releaseThreadInvocationStacks(std::unordered_map<uint64_t, uint32_t> &tops, int id)
+    {
+        std::vector<uint32_t> released;
+        for (auto it = tops.begin(); it != tops.end();)
+        {
+            if ((it->first >> 32u) == static_cast<uint32_t>(id))
+            {
+                released.push_back(it->second);
+                it = tops.erase(it);
+            }
+            else
+                ++it;
+        }
+        for (const uint32_t top : released)
+            tops.emplace(kFreeInvocationStackOwner | top, top);
+    }
+
+    uint32_t takeFreeInvocationStack(std::unordered_map<uint64_t, uint32_t> &tops)
+    {
+        for (auto it = tops.begin(); it != tops.end(); ++it)
+            if ((it->first & 0xFFFFFFFF00000000ull) == kFreeInvocationStackOwner)
+            {
+                const uint32_t top = it->second;
+                tops.erase(it);
+                return top;
+            }
+        return 0u;
+    }
+
