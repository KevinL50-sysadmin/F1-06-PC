+                const __m128i g = _mm_cvttps_epi32(lerp(t.g0, t.g1, t.g2, w0, w1, w2));
+                const __m128i b = _mm_cvttps_epi32(lerp(t.b0, t.b1, t.b2, w0, w1, w2));
+                const __m128i a = _mm_cvttps_epi32(lerp(t.a0, t.a1, t.a2, w0, w1, w2));
+                const __m128i bytes = _mm_packus_epi16(_mm_packs_epi32(r, g), _mm_packs_epi32(b, a));
+                const __m128i rg = _mm_unpacklo_epi8(bytes, _mm_srli_si128(bytes, 4));
+                const __m128i ba = _mm_unpacklo_epi8(_mm_srli_si128(bytes, 8), _mm_srli_si128(bytes, 12));
