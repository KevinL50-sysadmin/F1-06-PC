+            _mm_store_pd(zL, lerpD(t.z0, t.z1, t.z2, w0lo, w1lo, w2lo));
+            _mm_store_pd(zL + 2, lerpD(t.z0, t.z1, t.z2, w0hi, w1hi, w2hi));
