+    // writePixelTyped<F, Z>. For each four pixels: the depth test first, for the covered pixels (it has no side effect
+    // and a failing pixel writes nothing, whatever the other tests say); then, for the four lanes at once, samplerSample's
+    // 1 / q, the texel coordinates, floor, fractions, wrapping and the address parts, with the same operations per lane
+    // (IEEE single-precision products, sums and the division rounded one by one, truncating conversions); then, per
+    // passing pixel in x order, the texel reads, bilinearRgba, the combiner and writePixelBody without the depth test and
+    // the scissor test (prepareTriangle clamps the box to the scissor). The values are the same bit for bit; only the
+    // order of the depth reads against the other pixels' writes changes, which the separate pages make irrelevant.
+    template <GSMem::PixelStorageMode F, GSMem::PixelStorageMode Z, GSMem::PixelStorageMode P>
+    PS2_GS_INLINE void rasterTriangleSpan4Tex(const BandJob &job, const TriangleSetup &t, int y, int spanX0, int spanX1,
+                                              float row0, float row1)
+    {
+        using Traits = GSMem::PixelStorageTraits<P>;
+        constexpr GSMem::Extent2D extent = Traits::PageExtent();
+        const PixelPipeline &pp = job.pp;
+        const TextureSampler &ts = job.sampler;
+        uint8_t *const vram = pp.vram;
+        const uint32_t ztest = pp.ztestMethod; // 1, 2 or 3 (the caller leaves 0 to rasterTriangleSpan4)
+        const __m128 eps = _mm_set1_ps(-1.0e-4f);
+        const __m128 one = _mm_set1_ps(1.0f);
+        const __m128 half = _mm_set1_ps(0.5f);
+        const __m128 fx2 = _mm_set1_ps(t.fx2);
+        const __m128 e0 = _mm_set1_ps(t.e0), e1 = _mm_set1_ps(t.e1);
+        const __m128 r0v = _mm_set1_ps(row0), r1v = _mm_set1_ps(row1);
+        const __m128 winding = _mm_set1_ps(t.winding), inv = _mm_set1_ps(t.invAbsDenom);
+        const __m128 absMask = _mm_castsi128_ps(_mm_set1_epi32(0x7FFFFFFF));
+        const __m128 qMin = _mm_set1_ps(1.0e-8f);
+        const __m128 texW = _mm_set1_ps(static_cast<float>(ts.texW)), texH = _mm_set1_ps(static_cast<float>(ts.texH));
+        const __m128i oneI = _mm_set1_epi32(1);
+        const __m128i lanes = _mm_setr_epi32(0, 1, 2, 3);
+        const auto &table = *static_cast<const typename Traits::PageLookupTableT *>(ts.pageTable);
+        const uint16_t *const blockTable = reinterpret_cast<const uint16_t *>(&table[ts.tbp0 % Traits::BlocksPerPage()]);
+        const __m128i basePage = _mm_set1_epi32(static_cast<int>(static_cast<uint32_t>(ts.tbp0 / Traits::BlocksPerPage())));
+        const __m128i rowPages = _mm_set1_epi32(static_cast<int>((ts.tbw * 64u) / static_cast<uint32_t>(extent.x)));
+        auto lerp = [](float a0, float a1, float a2, __m128 w0, __m128 w1, __m128 w2)
+        {
+            return _mm_add_ps(_mm_add_ps(_mm_mul_ps(_mm_set1_ps(a0), w0), _mm_mul_ps(_mm_set1_ps(a1), w1)),
+                              _mm_mul_ps(_mm_set1_ps(a2), w2));
+        };
+        auto lerpD = [](double a0, double a1, double a2, __m128d w0, __m128d w1, __m128d w2)
+        {
+            return _mm_add_pd(_mm_add_pd(_mm_mul_pd(_mm_set1_pd(a0), w0), _mm_mul_pd(_mm_set1_pd(a1), w1)),
+                              _mm_mul_pd(_mm_set1_pd(a2), w2));
+        };
+        alignas(16) uint32_t rgbaL[4];
+        alignas(16) uint32_t fogL[4];
+        alignas(16) double zL[4];
+        alignas(16) float fxL[4], fyL[4];
+        alignas(16) uint32_t pre[4][4], idx[4][4]; // [texel 00, 10, 01, 11][lane]
