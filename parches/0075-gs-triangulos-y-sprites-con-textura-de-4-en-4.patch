+    // fastFloorToInt on four lanes: the truncating conversion (INT_MIN out of range, as cvttss2si), minus one where the
+    // truncated value converted back is above the input.
+    PS2_GS_INLINE __m128i floorLanes(__m128 v)
+    {
+        const __m128i truncated = _mm_cvttps_epi32(v);
+        return _mm_add_epi32(truncated, _mm_castps_si128(_mm_cmpgt_ps(_mm_cvtepi32_ps(truncated), v)));
+    }
