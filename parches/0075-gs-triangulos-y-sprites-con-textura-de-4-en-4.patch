+                    else
+                    {
+                        const uint32_t storedZ = pipelineRead<Z>(pp.readZ, vram, pp.zbp, pp.fbw, x + static_cast<int>(i), y);
+                        if (ztest == 2u ? zi[i] >= storedZ : zi[i] > storedZ)
