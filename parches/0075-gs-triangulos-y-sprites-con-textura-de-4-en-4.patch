+    // Patch 0075: SSE2 helpers of rasterTriangleSpan4Tex (signed 32-bit min and max, a 32-bit multiply modulo 2^32).
+    PS2_GS_INLINE __m128i maxEpi32(__m128i a, __m128i b)
+    {
+        const __m128i gt = _mm_cmpgt_epi32(a, b);
+        return _mm_or_si128(_mm_and_si128(gt, a), _mm_andnot_si128(gt, b));
+    }
