+    // PixelStorageTraits<P>::Address and Read's bit address, split for the texels (x, y) of four lanes (wrapped, so
+    // never negative): `pre` is the page part times the bit width plus the bit offset and `idx` the index into the
+    // block table of the texture base, so a texel's bit address is pre + table[idx] * width (modulo 2^32, as Read).
+    template <GSMem::PixelStorageMode P>
+    PS2_GS_INLINE void texelLanes(__m128i x, __m128i y, __m128i basePage, __m128i rowPages, uint32_t *pre, uint32_t *idx)
+    {
+        using Traits = GSMem::PixelStorageTraits<P>;
+        constexpr GSMem::Extent2D extent = Traits::PageExtent();
+        constexpr uint32_t kPageBits = static_cast<uint32_t>(Traits::PixelsPerPage() * GSMem::UnpackedBitWidth(P));
+        static_assert(std::has_single_bit(static_cast<uint32_t>(extent.x)) &&
+                          std::has_single_bit(static_cast<uint32_t>(extent.y)) && std::has_single_bit(kPageBits),
+                      "power-of-two page sizes");
+        constexpr int kShiftX = std::countr_zero(static_cast<uint32_t>(extent.x));
+        constexpr int kShiftY = std::countr_zero(static_cast<uint32_t>(extent.y));
+        constexpr int kShiftPage = std::countr_zero(kPageBits);
+        const __m128i page = _mm_add_epi32(_mm_add_epi32(basePage, mulloEpi32(_mm_srli_epi32(y, kShiftY), rowPages)),
+                                           _mm_srli_epi32(x, kShiftX));
+        _mm_store_si128(reinterpret_cast<__m128i *>(pre),
+                        _mm_add_epi32(_mm_slli_epi32(page, kShiftPage),
+                                      _mm_set1_epi32(static_cast<int>(Traits::BitOffset()))));
+        const __m128i yIn = _mm_and_si128(y, _mm_set1_epi32(static_cast<int>(extent.y - 1)));
+        const __m128i xIn = _mm_and_si128(x, _mm_set1_epi32(static_cast<int>(extent.x - 1)));
+        _mm_store_si128(reinterpret_cast<__m128i *>(idx), _mm_add_epi32(_mm_slli_epi32(yIn, kShiftX), xIn));
+    }
