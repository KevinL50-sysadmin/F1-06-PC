+    // wrapTextureCoordinate on four lanes (size >= 1: textureWidth/Height are 1 << n).
+    PS2_GS_INLINE __m128i wrapLanes(__m128i c, int size, uint8_t mode, uint16_t regionMin, uint16_t regionMax)
+    {
+        switch (mode & 0x3u)
+        {
+        case 0: // REPEAT
+            return _mm_and_si128(c, _mm_set1_epi32(size - 1));
+        case 1: // CLAMP: clampInt(c, 0, size - 1)
+            return minEpi32(maxEpi32(c, _mm_setzero_si128()), _mm_set1_epi32(size - 1));
+        case 2: // REGION_CLAMP
+            return minEpi32(maxEpi32(c, _mm_set1_epi32(regionMin)), _mm_set1_epi32(regionMax));
+        default: // REGION_REPEAT
+            return _mm_or_si128(_mm_and_si128(c, _mm_set1_epi32(regionMin)), _mm_set1_epi32(regionMax));
+        }
+    }
