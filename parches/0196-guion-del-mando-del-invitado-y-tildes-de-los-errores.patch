+    // Pruebas autonomas T2 (S3): PS2X_INVITADO_GUION, the guest's pad scripted by its window's own events, as F1_GUION
+    // is for the game, so the guest's window is tested without anyone at the pad: "evento[#n]+retraso:boton[:duracion]"
+    // separated by commas. Events: formulario (the form shows, also on the way back to it), conectando, contrasena,
+    // conectado, rechazado, desconectado, error. Buttons: select, l3, r3, start, arriba, derecha, abajo, izquierda, l2,
+    // r2, l1, r1, triangulo, circulo, cruz, cuadrado (PadWire.pressed bits 0-15), captura (the window as drawn, to
+    // <PS2X_INVITADO_CAPTURAS>-<n>.png) or cerrar (closes the window). A step fires delay seconds after the n-th time
+    // (default the first) its event happens and holds its button duration seconds (default 0.2), at least one frame.
+    struct GuestPadScriptStep
+    {
+        std::string event;
+        uint32_t occurrence = 1;
+        double delay = 0.0;
+        uint16_t buttons = 0;
+        bool capture = false;
+        bool close = false;
+        double duration = 0.2;
+    };
+    // False with a Spanish message quoting the bad entry, steps unchanged then. Empty text: no steps.
+    bool parseGuestPadScript(std::string_view text, std::vector<GuestPadScriptStep> &steps, std::string &error);
+    const char *guestScriptEvent(GuestState state); // its event name; nullptr for Idle
+    class GuestPadScript
+    {
+    public:
+        struct Frame
+        {
+            uint16_t pressed = 0; // buttons held now
+            int captures = 0;     // captures due now, each once
+            bool close = false;
+        };
+        explicit GuestPadScript(std::vector<GuestPadScriptStep> steps);
+        void event(std::string_view name, double now); // counts it; arms the steps waiting for this occurrence
+        Frame frame(double now);
+        bool finished() const; // every step fired and released
+
+    private:
+        struct Armed
+        {
+            GuestPadScriptStep step;
+            double at = -1.0; // when it fires; < 0 while its event has not happened
+            bool reported = false;
+            bool done = false;
+        };
+        std::vector<Armed> m_steps;
+        std::vector<std::pair<std::string, uint32_t>> m_seen;
+    };
+
     // config\red.ini of the guest: the last address and port that connected. Never the password.
     struct GuestMemory
