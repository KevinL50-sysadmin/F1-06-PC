+    namespace
+    {
+        constexpr const char *kScriptEvents[] = {"formulario", "conectando", "contrasena", "conectado",
+                                                 "rechazado",  "desconectado", "error"};
+        constexpr const char *kScriptButtons[] = {"select", "l3",    "r3",        "start",   "arriba", "derecha",
+                                                  "abajo",  "izquierda", "l2",   "r2",      "l1",     "r1",
+                                                  "triangulo", "circulo", "cruz", "cuadrado"};
+
+        // A whole decimal number, nothing else (std::strtod alone takes "1x" as 1).
+        bool parseSeconds(const std::string &text, double &value)
+        {
+            if (text.empty())
+                return false;
+            char *end = nullptr;
+            value = std::strtod(text.c_str(), &end);
+            return end == text.c_str() + text.size() && std::isfinite(value);
+        }
+    }
+
+    bool parseGuestPadScript(std::string_view text, std::vector<GuestPadScriptStep> &steps, std::string &error)
+    {
+        std::vector<GuestPadScriptStep> parsed;
+        const std::string all(text);
+        size_t start = 0;
+        while (!all.empty() && start <= all.size())
+        {
+            const size_t comma = std::min(all.find(',', start), all.size());
+            std::string entry = all.substr(start, comma - start);
+            start = comma + 1;
+            const size_t first = entry.find_first_not_of(" \t");
+            entry = first == std::string::npos ? std::string() : entry.substr(first, entry.find_last_not_of(" \t") - first + 1);
+            const auto refuse = [&](const char *why)
+            {
+                error = "PS2X_INVITADO_GUION: entrada no valida '" + entry + "' (" + why + ")";
+                return false;
+            };
+            const size_t plus = entry.find('+');
+            const size_t colon = entry.find(':', plus == std::string::npos ? 0 : plus);
+            if (plus == std::string::npos || colon == std::string::npos)
+                return refuse("se espera evento[#n]+retraso:boton[:duracion]");
+            GuestPadScriptStep step;
+            step.event = entry.substr(0, plus);
+            if (const size_t hash = step.event.find('#'); hash != std::string::npos)
+            {
+                const std::string number = step.event.substr(hash + 1);
+                if (number.empty() || number.size() > 6 || number.find_first_not_of("0123456789") != std::string::npos ||
+                    std::atoi(number.c_str()) < 1)
+                    return refuse("#n debe ser un numero de 1 en adelante");
+                step.occurrence = static_cast<uint32_t>(std::atoi(number.c_str()));
+                step.event.resize(hash);
+            }
+            if (std::find_if(std::begin(kScriptEvents), std::end(kScriptEvents), [&](const char *name)
+                             { return step.event == name; }) == std::end(kScriptEvents))
+                return refuse("evento desconocido");
+            if (!parseSeconds(entry.substr(plus + 1, colon - plus - 1), step.delay) || step.delay < 0.0)
+                return refuse("retraso en segundos, 0 o mas");
+            std::string button = entry.substr(colon + 1);
+            if (const size_t more = button.find(':'); more != std::string::npos)
+            {
+                if (!parseSeconds(button.substr(more + 1), step.duration) || step.duration <= 0.0)
+                    return refuse("duracion en segundos, mas de 0");
+                button.resize(more);
+            }
+            if (button == "captura")
+                step.capture = true;
+            else if (button == "cerrar")
+                step.close = true;
+            else
+            {
+                const auto found = std::find_if(std::begin(kScriptButtons), std::end(kScriptButtons),
+                                                [&](const char *name) { return button == name; });
+                if (found == std::end(kScriptButtons))
+                    return refuse("boton desconocido");
+                step.buttons = static_cast<uint16_t>(1u << (found - std::begin(kScriptButtons)));
+            }
+            parsed.push_back(std::move(step));
+            if (comma == all.size())
+                break;
+        }
+        steps = std::move(parsed);
+        error.clear();
+        return true;
+    }
+
+    const char *guestScriptEvent(GuestState state)
+    {
+        switch (state)
+        {
+        case GuestState::Connecting: return "conectando";
+        case GuestState::Authenticating: return "contrasena";
+        case GuestState::Connected: return "conectado";
+        case GuestState::Rejected: return "rechazado";
+        case GuestState::Disconnected: return "desconectado";
+        case GuestState::Failed: return "error";
+        case GuestState::Idle: break;
+        }
+        return nullptr;
+    }
+
+    GuestPadScript::GuestPadScript(std::vector<GuestPadScriptStep> steps)
+    {
+        for (auto &step : steps)
+            m_steps.push_back(Armed{std::move(step)});
+    }
+
+    void GuestPadScript::event(std::string_view name, double now)
+    {
+        uint32_t count = 1;
+        auto seen = std::find_if(m_seen.begin(), m_seen.end(), [&](const auto &entry) { return entry.first == name; });
+        if (seen == m_seen.end())
+            m_seen.emplace_back(std::string(name), 1u);
+        else
+            count = ++seen->second;
+        for (auto &armed : m_steps)
+            if (armed.at < 0.0 && armed.step.event == name && armed.step.occurrence == count)
+                armed.at = now + armed.step.delay;
+    }
+
+    GuestPadScript::Frame GuestPadScript::frame(double now)
+    {
+        Frame frame;
+        for (auto &armed : m_steps)
+        {
+            if (armed.done || armed.at < 0.0 || now < armed.at)
+                continue;
+            if (armed.step.capture || armed.step.close)
+            {
+                frame.captures += armed.step.capture ? 1 : 0;
+                frame.close = frame.close || armed.step.close;
+                armed.done = true;
+                continue;
+            }
+            // Held for its duration, and seen by at least one frame even when the frames come slower than that.
+            if (now < armed.at + armed.step.duration || !armed.reported)
+            {
+                frame.pressed = static_cast<uint16_t>(frame.pressed | armed.step.buttons);
+                armed.reported = true;
+            }
+            else
+                armed.done = true;
+        }
+        return frame;
+    }
+
+    bool GuestPadScript::finished() const
+    {
+        return std::all_of(m_steps.begin(), m_steps.end(), [](const Armed &armed) { return armed.done; });
+    }
+
     GuestMemory rememberedFrom(const GuestSettings &settings)
     {
         return {settings.host, settings.port};
