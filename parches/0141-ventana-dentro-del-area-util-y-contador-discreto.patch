+    DesktopRect fitWindowToWorkArea(int width, int height, const DesktopRect &workArea, const WindowFrame &frame)
+    {
+        const int roomWidth = workArea.width - frame.left - frame.right;
+        const int roomHeight = workArea.height - frame.top - frame.bottom;
+        DesktopRect client{0, 0, std::max(1, width), std::max(1, height)};
+        if (client.width > roomWidth || client.height > roomHeight)
+        {
+            // The axis with less room sets the scale; the other follows it, rounded down.
+            if (static_cast<int64_t>(roomWidth) * client.height <= static_cast<int64_t>(roomHeight) * client.width)
+            {
+                client.height = static_cast<int>(static_cast<int64_t>(client.height) * roomWidth / client.width);
+                client.width = roomWidth;
+            }
+            else
+            {
+                client.width = static_cast<int>(static_cast<int64_t>(client.width) * roomHeight / client.height);
+                client.height = roomHeight;
+            }
+        }
+        client.width = std::max(client.width, kMinWindowWidth);
+        client.height = std::max(client.height, kMinWindowHeight);
+        client.x = workArea.x + frame.left + std::max(0, (roomWidth - client.width) / 2);
+        client.y = workArea.y + frame.top + std::max(0, (roomHeight - client.height) / 2);
+        return client;
+    }
+
+    OverlayLayout fpsOverlayLayout(int windowHeight)
+    {
+        OverlayLayout layout;
+        layout.fontSize = std::max(10, windowHeight / 40);
+        layout.margin = layout.padding = std::max(2, layout.fontSize / 5);
+        layout.height = layout.fontSize + 2 * layout.padding;
+        return layout;
+    }
