+uint64_t GSCpuBackend::SnapshotVramJob(std::vector<uint8_t> &out, bool defer)
+{
+    // Patch 0067: the copy of local memory for the presentation as a band job, so that this thread does not wait for
+    // every pending job (the "directo" waits of [gs:bandas], one per presented frame). A/B mode 42: here, as before;
+    // also without band workers, in A/B modes 36, 37 and 40 (the coordinator waits there), while F1_GS_VERIFICAR_BANDAS
+    // checks batches, and when the caller needs it now. 0: copied already.
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram || m_vramSize == 0u)
+    {
+        out.clear();
+        return 0u;
+    }
+    out.resize(m_vramSize);
+    const int mode = g_ps2AbMode.load(std::memory_order_relaxed);
+    BandState *bands = m_bands.get();
+    if (!defer || bands == nullptr || mode == 42 || mode == 36 || mode == 37 || mode == 40 || bands->verifyLeft != 0u ||
+        bands->RefreshMinDone() >= bands->prepared)
+    {
+        WaitBandsUnlocked();
+        std::memcpy(out.data(), m_vram, m_vramSize);
+        return 0u;
+    }
+    BandState &bs = *bands;
+    if (bs.checkCopies)
+    {
+        // The reference: what the job must copy. The jobs after it are queued while it is pending, as usual.
+        bs.WaitDone(bs.prepared, kWaitDirect);
+        bs.copyReference.assign(m_vram, m_vram + m_vramSize);
+    }
+    const uint64_t index = bs.prepared;
+    if (index - bs.minDone >= BandState::kJobCapacity)
+        bs.WaitDone(index + 1u - BandState::kJobCapacity, kWaitRing);
+    const size_t slot = static_cast<size_t>(index % BandState::kJobCapacity);
+    BandJob &job = bs.jobs[slot];
+    job.isSprite = false;
+    job.isUpload = false;
+    job.isCopy = true;
+    job.waitAll = index > bs.minDone ? index : 0u; // every worker past the jobs before it
+    job.waitFirst = 0u;
+    job.minX = job.minY = 0;
+    job.maxX = job.maxY = -1;
+    BandState::Upload &copy = bs.uploads[slot];
+    copy.vram = m_vram;
+    copy.copyTo = out.data();
+    copy.copyBytes = m_vramSize;
+    const uint64_t tag = index + 1u;
+    bs.copyReadJob = tag;
+    bs.CheckRecord(tag, {}, nullptr);
+    ++bs.copyJobs;
+    bs.prepared = tag;
+    bs.Publish(tag);
+    return tag;
+}
+
+bool GSCpuBackend::SnapshotVramDone(uint64_t tag, const std::vector<uint8_t> &out)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    BandState &bs = *m_bands;
+    if (bs.minDone < tag && bs.RefreshMinDone() < tag)
+        return false;
+    if (bs.checkCopies && !bs.copyReference.empty())
+    {
+        ++bs.copyChecked;
+        if (bs.copyReference.size() != out.size() ||
+            std::memcmp(bs.copyReference.data(), out.data(), out.size()) != 0)
+            ++bs.copyDifferent;
+        bs.copyReference.clear();
+        if (bs.copyChecked % 200u == 0u || bs.copyDifferent == 1u)
+            std::fprintf(stderr, "[gs:bandas] copias: %llu comprobadas, %llu distintas\n",
+                         static_cast<unsigned long long>(bs.copyChecked),
+                         static_cast<unsigned long long>(bs.copyDifferent));
+    }
+    return true;
+}
