-        SetConfigFlags(FLAG_WINDOW_RESIZABLE);
+        // PS2X_BACKGROUND_WINDOW=1: for automated runs the window never takes the focus or covers the desktop.
+        // It is created hidden and unfocused, then shown off-screen at the bottom of the z-order without being
+        // activated. PrintWindow can still capture it, and it keeps running while unfocused.
+        const char *backgroundEnv = std::getenv("PS2X_BACKGROUND_WINDOW");
+        const bool backgroundWindow = backgroundEnv && backgroundEnv[0] != '\0' && backgroundEnv[0] != '0';
+        unsigned int windowFlags = FLAG_WINDOW_RESIZABLE;
