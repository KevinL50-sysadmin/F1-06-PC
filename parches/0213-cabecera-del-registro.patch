new file mode 100644
index 0000000..a950db2
--- /dev/null
+++ b/ps2xTest/src/ps2_cabecera_tests.cpp
@@ -0,0 +1,142 @@
+#include "MiniTest.h"
+#include "ps2_cabecera.h"
+#include "ps2_options.h"
+#include "ps2_vigilante.h"
+
+#include <map>
+#include <sstream>
+#include <string>
+
+// odd/tasks/fallos-con-log.md T3a (S3): the head of F1-06.log says which build, on which PC and with which options,
+// so a player's log identifies the failure.
+namespace
+{
+    using ps2x::cabecera::Sistema;
+
+    bool startsWith(const std::string &text, const std::string &prefix)
+    {
+        return text.compare(0, prefix.size(), prefix) == 0;
+    }
+
+    bool contains(const std::string &text, const std::string &part)
+    {
+        return text.find(part) != std::string::npos;
+    }
+}
+
+void register_ps2_cabecera_tests()
+{
+    MiniTest::Case("Cabecera", [](TestCase &tc)
+    {
+        tc.Run("version line: package version, git commit and build date", [](TestCase &t)
+        {
+            t.Equals(ps2x::cabecera::lineaVersion("1.1.2", "1a2b3c4-dirty", "2026-11-19T10:22Z"),
+                     std::string("[version] 1.1.2 git=1a2b3c4-dirty compilado=2026-11-19T10:22Z"), "all known");
+            t.Equals(ps2x::cabecera::lineaVersion("", "", ""),
+                     std::string("[version] desconocida git=desconocido compilado=desconocida"), "nothing known");
+        });
+
+        tc.Run("PE timestamp as an UTC date", [](TestCase &t)
+        {
+            t.Equals(ps2x::cabecera::fechaDeMarca(0x6736A0F1u), std::string("2024-11-15T01:16Z"), "0x6736A0F1");
+            t.Equals(ps2x::cabecera::fechaDeMarca(0u), std::string("desconocida"), "0: unknown");
+        });
+
+        tc.Run("the version compiled into the build is never empty", [](TestCase &t)
+        {
+            t.IsTrue(*ps2x::cabecera::versionPaquete() != '\0', "package version");
+            t.IsTrue(*ps2x::cabecera::versionGit() != '\0', "git commit");
+        });
+
+        tc.Run("system line: Windows, CPU, threads, cores, RAM, power plan, RecompLauncher", [](TestCase &t)
+        {
+            Sistema s;
+            s.windows = "10.0.26300.7171";
+            s.cpu = "AMD Ryzen 7 5800X 8-Core Processor";
+            s.hilos = 16u;
+            s.nucleos = 8u;
+            s.ramBytes = 32ull << 30;
+            s.energia = "Equilibrado";
+            t.Equals(ps2x::cabecera::lineaSistema(s),
+                     std::string("[sistema] windows=10.0.26300.7171 cpu=\"AMD Ryzen 7 5800X 8-Core Processor\" hilos=16 "
+                                 "nucleos=8 ram=32.0GB energia=Equilibrado recomplauncher=no"),
+                     "one class of cores, no RecompLauncher");
+
+            s.cpu = "12th Gen Intel(R) Core(TM) i7-12700H";
+            s.hilos = 20u;
+            s.nucleos = 14u;
+            s.nucleosP = 6u;
+            s.nucleosE = 8u;
+            s.ramBytes = (16ull << 30) - (200ull << 20);
+            s.energia = "Alto rendimiento";
+            s.recomplauncher = "1.4.0";
+            t.Equals(ps2x::cabecera::lineaSistema(s),
+                     std::string("[sistema] windows=10.0.26300.7171 cpu=\"12th Gen Intel(R) Core(TM) i7-12700H\" hilos=20 "
+                                 "nucleos=14(6P+8E) ram=15.8GB energia=\"Alto rendimiento\" recomplauncher=1.4.0"),
+                     "P and E cores, RecompLauncher");
+        });
+
+        tc.Run("system line with nothing known", [](TestCase &t)
+        {
+            t.Equals(ps2x::cabecera::lineaSistema(Sistema{}),
+                     std::string("[sistema] windows=desconocido cpu=desconocida hilos=desconocido nucleos=desconocido "
+                                 "ram=desconocida energia=desconocido recomplauncher=no"),
+                     "unknown values");
+        });
+
+        tc.Run("options line: settings order, forced marked, unknown keys left out", [](TestCase &t)
+        {
+            const std::map<std::string, std::string> values{
+                {"gs", "cpu"}, {"pantalla", "ventana"}, {"vsync", "1"}, {"no_existe", "x"}};
+            t.Equals(ps2x::cabecera::lineaOpciones(values, {}),
+                     std::string("[opciones] efectivas: pantalla=ventana vsync=1 gs=cpu"), "no forced option");
+            t.Equals(ps2x::cabecera::lineaOpciones(values, {{"gs", "PS2X_GS"}}),
+                     std::string("[opciones] efectivas: pantalla=ventana vsync=1 gs=cpu* (*=por variable de entorno)"),
+                     "gs forced");
+            t.Equals(ps2x::cabecera::lineaOpciones({{"pantalla", "a b"}, {"vsync", ""}}, {}),
+                     std::string("[opciones] efectivas: pantalla=\"a b\" vsync=\"\""), "spaces and empty quoted");
+        });
+
+        tc.Run("options line has every option of a parsed file", [](TestCase &t)
+        {
+            const std::string line = ps2x::cabecera::lineaOpciones(ps2x::parseOptions("").values, {});
+            size_t keys = 0u;
+            for (const char c : line)
+                keys += c == '=' ? 1u : 0u;
+            t.Equals(keys, ps2x::optionSpecs().size(), "one key=value per option");
+            t.IsTrue(startsWith(line, "[opciones] efectivas: pantalla=ventana "), "starts with the first option");
+        });
+
+#if defined(_WIN32)
+        tc.Run("this PC is read", [](TestCase &t)
+        {
+            const Sistema s = ps2x::cabecera::leerSistema();
+            t.IsTrue(startsWith(s.windows, "10.") , "Windows 10 or 11: " + s.windows);
+            t.IsTrue(!s.cpu.empty() && s.cpu.front() != ' ' && s.cpu.back() != ' ', "CPU name, trimmed: " + s.cpu);
+            t.IsTrue(s.hilos > 0u && s.nucleos > 0u && s.nucleos <= s.hilos, "threads and cores");
+            t.IsTrue(s.nucleosP + s.nucleosE == 0u || s.nucleosP + s.nucleosE == s.nucleos, "P+E = cores");
+            t.IsTrue(s.ramBytes > (1ull << 30), "RAM");
+            t.IsTrue(!s.energia.empty(), "power plan");
+        });
+
+        tc.Run("build identity of the watchdog, without its prefix", [](TestCase &t)
+        {
+            const std::string identity = ps2x::vigilante::identidadCompilacion();
+            t.IsTrue(startsWith(identity, "ps2x_tests.exe fecha_pe="), identity);
+            t.IsTrue(contains(identity, " tam_imagen=") && contains(identity, " base=0x"), identity);
+            t.IsTrue(ps2x::vigilante::marcaTiempoPe() != 0u, "PE timestamp");
+        });
+
+        tc.Run("the header writes version, build and system lines", [](TestCase &t)
+        {
+            std::ostringstream out;
+            ps2x::cabecera::escribir(out);
+            const std::string text = out.str();
+            t.IsTrue(startsWith(text, std::string("[version] ") + ps2x::cabecera::versionPaquete() + " git="), text);
+            t.IsTrue(contains(text, "\n[version] compilacion: ps2x_tests.exe fecha_pe="), text);
+            t.IsTrue(contains(text, "\n[sistema] windows=10."), text);
+            t.IsTrue(!contains(text, "[cabecera] error"), text);
+        });
+#endif
+    });
+}
