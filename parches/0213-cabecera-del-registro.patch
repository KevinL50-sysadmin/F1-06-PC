diff --git a/ps2xRuntime/src/lib/ps2_cabecera.cpp b/ps2xRuntime/src/lib/ps2_cabecera.cpp
new file mode 100644
index 0000000..ce22383
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_cabecera.cpp
@@ -0,0 +1,154 @@
+// Cabecera del registro (odd/tasks/fallos-con-log.md T3a; ps2_cabecera.h): el formato de sus lineas y escribir().
+#include "ps2_cabecera.h"
+
+#include "ps2_options.h"
+#include "ps2_vigilante.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <exception>
+#include <fstream>
+#include <sstream>
+
+namespace ps2x::cabecera
+{
+    namespace
+    {
+        std::string oDesconocido(std::string_view valor, const char *desconocido)
+        {
+            return valor.empty() ? std::string(desconocido) : std::string(valor);
+        }
+
+        // Entre comillas si esta vacio o tiene espacios (asi cada clave=valor se separa por espacios).
+        std::string paraLinea(std::string_view valor)
+        {
+            if (!valor.empty() && valor.find(' ') == std::string_view::npos)
+                return std::string(valor);
+            return "\"" + std::string(valor) + "\"";
+        }
+
+        std::string conocidoParaLinea(std::string_view valor, const char *desconocido)
+        {
+            return valor.empty() ? std::string(desconocido) : paraLinea(valor);
+        }
+    }
+
+    std::string fechaDeMarca(uint32_t marca)
+    {
+        if (marca == 0u)
+            return "desconocida";
+        const std::time_t segundos = static_cast<std::time_t>(marca);
+        std::tm utc{};
+#if defined(_WIN32)
+        if (gmtime_s(&utc, &segundos) != 0)
+            return "desconocida";
+#else
+        if (gmtime_r(&segundos, &utc) == nullptr)
+            return "desconocida";
+#endif
+        char texto[32] = {};
+        std::strftime(texto, sizeof(texto), "%Y-%m-%dT%H:%MZ", &utc);
+        return texto;
+    }
+
+    std::string lineaVersion(std::string_view paquete, std::string_view git, std::string_view compilado)
+    {
+        return "[version] " + oDesconocido(paquete, "desconocida") + " git=" + oDesconocido(git, "desconocido") +
+               " compilado=" + oDesconocido(compilado, "desconocida");
+    }
+
+    std::string lineaSistema(const Sistema &s)
+    {
+        std::string linea = "[sistema] windows=" + oDesconocido(s.windows, "desconocido");
+        linea += " cpu=" + conocidoParaLinea(s.cpu, "desconocida");
+        linea += " hilos=" + (s.hilos != 0u ? std::to_string(s.hilos) : std::string("desconocido"));
+        linea += " nucleos=" + (s.nucleos != 0u ? std::to_string(s.nucleos) : std::string("desconocido"));
+        if (s.nucleos != 0u && s.nucleosP != 0u && s.nucleosE != 0u)
+            linea += "(" + std::to_string(s.nucleosP) + "P+" + std::to_string(s.nucleosE) + "E)";
+        linea += " ram=";
+        if (s.ramBytes != 0u)
+        {
+            char gb[32] = {};
+            std::snprintf(gb, sizeof(gb), "%.1fGB", static_cast<double>(s.ramBytes) / static_cast<double>(1ull << 30));
+            linea += gb;
+        }
+        else
+            linea += "desconocida";
+        linea += " energia=" + conocidoParaLinea(s.energia, "desconocido");
+        linea += " recomplauncher=" + conocidoParaLinea(s.recomplauncher, "no");
+        return linea;
+    }
+
+    std::string lineaOpciones(const std::map<std::string, std::string> &valores,
+                              const std::map<std::string, std::string> &forzadas)
+    {
+        std::string linea = "[opciones] efectivas:";
+        bool hayForzadas = false;
+        for (const OptionSpec &spec : optionSpecs())
+        {
+            const auto valor = valores.find(spec.key);
+            if (valor == valores.end())
+                continue;
+            linea += " ";
+            linea += spec.key;
+            linea += "=" + paraLinea(valor->second);
+            if (forzadas.count(spec.key) != 0u)
+            {
+                linea += "*";
+                hayForzadas = true;
+            }
+        }
+        if (hayForzadas)
+            linea += " (*=por variable de entorno)";
+        return linea;
+    }
+
+    void escribir(std::ostream &out)
+    {
+        // Cada linea por su cuenta: si una falla, las demas salen igual.
+        const auto linea = [&out](const char *que, auto &&hacer)
+        {
+            try
+            {
+                out << hacer() << '\n';
+            }
+            catch (const std::exception &e)
+            {
+                out << "[cabecera] error (" << que << "): " << e.what() << '\n';
+            }
+            catch (...)
+            {
+                out << "[cabecera] error (" << que << ")\n";
+            }
+        };
+        linea("version", []
+              { return lineaVersion(versionPaquete(), versionGit(), fechaDeMarca(vigilante::marcaTiempoPe())); });
+        linea("compilacion", []
+              {
+                  const std::string identidad = vigilante::identidadCompilacion();
+                  return "[version] compilacion: " + (identidad.empty() ? std::string("desconocida") : identidad);
+              });
+        linea("sistema", [] { return lineaSistema(leerSistema()); });
+        // Las opciones como las usa el juego: las del archivo, salvo las que fija una variable puesta antes de
+        // applyOptionsFile (lo mismo que muestra el menu, makeOptionsMenuModel).
+        const StartupOptions &inicio = startupOptions();
+        if (!inicio.file.empty())
+            linea("opciones", [&inicio]
+                  {
+                      std::string texto;
+                      if (std::ifstream in(inicio.file, std::ios::binary); in)
+                      {
+                          std::stringstream contenido;
+                          contenido << in.rdbuf();
+                          texto = contenido.str();
+                      }
+                      const auto entorno = [](const char *nombre)
+                      { return static_cast<const char *>(std::getenv(nombre)); };
+                      const OptionsMenuModel modelo =
+                          makeOptionsMenuModel(texto, inicio.development, inicio.forced, entorno);
+                      return lineaOpciones(modelo.current, inicio.forced);
+                  });
+        out.flush();
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_cabecera_win.cpp b/ps2xRuntime/src/lib/ps2_cabecera_win.cpp
new file mode 100644
index 0000000..eb98cd9
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_cabecera_win.cpp
@@ -0,0 +1,173 @@
+// Cabecera del registro (odd/tasks/fallos-con-log.md T3a; ps2_cabecera.h): lo que se lee del PC para la linea
+// [sistema]. Cada dato por su cuenta: si uno no se puede leer queda desconocido y los demas salen igual.
+#include "ps2_cabecera.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <powrprof.h>
+#include <intrin.h>
+#endif
+
+namespace ps2x::cabecera
+{
+#if defined(_WIN32)
+    namespace
+    {
+        std::string aUtf8(const wchar_t *texto)
+        {
+            if (texto == nullptr || *texto == L'\0')
+                return {};
+            const int n = WideCharToMultiByte(CP_UTF8, 0, texto, -1, nullptr, 0, nullptr, nullptr);
+            if (n <= 1)
+                return {};
+            std::string utf8(static_cast<size_t>(n), '\0');
+            WideCharToMultiByte(CP_UTF8, 0, texto, -1, utf8.data(), n, nullptr, nullptr);
+            utf8.resize(static_cast<size_t>(n - 1));
+            return utf8;
+        }
+
+        std::string recortar(std::string texto)
+        {
+            const size_t inicio = texto.find_first_not_of(' ');
+            if (inicio == std::string::npos)
+                return {};
+            const size_t fin = texto.find_last_not_of(' ');
+            return texto.substr(inicio, fin - inicio + 1u);
+        }
+
+        // RtlGetVersion (GetVersionEx miente sin manifiesto) y la revision (UBR) del registro.
+        std::string versionDeWindows()
+        {
+            using RtlGetVersionFn = LONG(WINAPI *)(PRTL_OSVERSIONINFOW);
+            const HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+            const auto leer =
+                ntdll != nullptr ? reinterpret_cast<RtlGetVersionFn>(GetProcAddress(ntdll, "RtlGetVersion")) : nullptr;
+            RTL_OSVERSIONINFOW info{};
+            info.dwOSVersionInfoSize = sizeof(info);
+            if (leer == nullptr || leer(&info) != 0)
+                return {};
+            std::string version = std::to_string(info.dwMajorVersion) + "." + std::to_string(info.dwMinorVersion) +
+                                  "." + std::to_string(info.dwBuildNumber);
+            DWORD ubr = 0u;
+            DWORD tam = sizeof(ubr);
+            if (RegGetValueW(HKEY_LOCAL_MACHINE, L"SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion", L"UBR",
+                             RRF_RT_REG_DWORD, nullptr, &ubr, &tam) == ERROR_SUCCESS)
+                version += "." + std::to_string(ubr);
+            return version;
+        }
+
+        std::string nombreDeCpu()
+        {
+            int registros[4] = {};
+            __cpuid(registros, static_cast<int>(0x80000000u));
+            if (static_cast<unsigned>(registros[0]) < 0x80000004u)
+                return {};
+            char nombre[49] = {};
+            for (unsigned i = 0u; i < 3u; ++i)
+            {
+                __cpuid(registros, static_cast<int>(0x80000002u + i));
+                std::memcpy(nombre + i * 16u, registros, 16u);
+            }
+            return recortar(nombre);
+        }
+
+        // Nucleos fisicos y, con dos clases de eficiencia (Intel hibridos), cuantos de cada una.
+        void nucleos(Sistema &s)
+        {
+            s.hilos = static_cast<unsigned>(GetActiveProcessorCount(ALL_PROCESSOR_GROUPS));
+            DWORD tam = 0u;
+            GetLogicalProcessorInformationEx(RelationProcessorCore, nullptr, &tam);
+            if (tam == 0u)
+                return;
+            std::vector<unsigned char> bufer(tam);
+            auto *info = reinterpret_cast<SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *>(bufer.data());
+            if (!GetLogicalProcessorInformationEx(RelationProcessorCore, info, &tam))
+                return;
+            unsigned total = 0u;
+            unsigned maxima = 0u;
+            unsigned minima = 255u;
+            std::vector<unsigned> clases;
+            for (DWORD desp = 0u; desp < tam;)
+            {
+                const auto *nucleo = reinterpret_cast<const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *>(bufer.data() + desp);
+                if (nucleo->Size == 0u)
+                    break;
+                if (nucleo->Relationship == RelationProcessorCore)
+                {
+                    const unsigned clase = nucleo->Processor.EfficiencyClass;
+                    clases.push_back(clase);
+                    maxima = clase > maxima ? clase : maxima;
+                    minima = clase < minima ? clase : minima;
+                    ++total;
+                }
+                desp += nucleo->Size;
+            }
+            s.nucleos = total;
+            if (total != 0u && maxima != minima)
+            {
+                // La clase mas alta es la de rendimiento.
+                for (const unsigned clase : clases)
+                    ++(clase == maxima ? s.nucleosP : s.nucleosE);
+            }
+        }
+
+        std::string planDeEnergia()
+        {
+            GUID *activo = nullptr;
+            if (PowerGetActiveScheme(nullptr, &activo) != ERROR_SUCCESS || activo == nullptr)
+                return {};
+            std::string nombre;
+            DWORD tam = 0u;
+            if (PowerReadFriendlyName(nullptr, activo, nullptr, nullptr, nullptr, &tam) == ERROR_SUCCESS && tam > 0u)
+            {
+                std::vector<wchar_t> texto(tam / sizeof(wchar_t) + 1u, L'\0');
+                if (PowerReadFriendlyName(nullptr, activo, nullptr, nullptr, reinterpret_cast<UCHAR *>(texto.data()),
+                                          &tam) == ERROR_SUCCESS)
+                    nombre = aUtf8(texto.data());
+            }
+            LocalFree(activo);
+            return nombre;
+        }
+    }
+
+    Sistema leerSistema()
+    {
+        Sistema s;
+        try
+        {
+            s.windows = versionDeWindows();
+            s.cpu = nombreDeCpu();
+            nucleos(s);
+            MEMORYSTATUSEX memoria{};
+            memoria.dwLength = sizeof(memoria);
+            if (GlobalMemoryStatusEx(&memoria))
+                s.ramBytes = memoria.ullTotalPhys;
+            s.energia = planDeEnergia();
+        }
+        catch (...)
+        {
+        }
+        if (const char *launcher = std::getenv("RECOMPLAUNCHER_VERSION"); launcher != nullptr)
+            s.recomplauncher = launcher;
+        return s;
+    }
+#else
+    Sistema leerSistema()
+    {
+        Sistema s;
+        if (const char *launcher = std::getenv("RECOMPLAUNCHER_VERSION"); launcher != nullptr)
+            s.recomplauncher = launcher;
+        return s;
+    }
+#endif
+}
diff --git a/ps2xRuntime/src/lib/ps2_version.cpp b/ps2xRuntime/src/lib/ps2_version.cpp
new file mode 100644
index 0000000..4203efe
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_version.cpp
@@ -0,0 +1,23 @@
+// odd/tasks/fallos-con-log.md T3a: la version del paquete y el commit de git con que se compilo. Los defines solo los
+// recibe este archivo (ps2xRuntime/CMakeLists.txt): cambiarlos no recompila nada mas.
+#include "ps2_cabecera.h"
