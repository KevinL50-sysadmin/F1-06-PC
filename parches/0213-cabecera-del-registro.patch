@@ -0,0 +1,59 @@
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <ostream>
+#include <string>
+#include <string_view>
+
+// Cabecera del registro (odd/tasks/fallos-con-log.md T3a, S3): al abrirse F1-06.log, unas lineas cortas que dicen que
+// compilacion, en que PC y con que opciones va el juego de quien manda el registro:
+//   [version] 1.1.2 git=1a2b3c4-dirty compilado=2026-11-19T10:22Z
+//   [version] compilacion: F1-06.exe fecha_pe=6736A0F1 tam_imagen=04B2D000 pdb=ps2EntryRunner.pdb guid=... edad=1 base=0x...
+//   [sistema] windows=10.0.26300.7171 cpu="AMD Ryzen 7 5800X 8-Core Processor" hilos=16 nucleos=8 ram=31.9GB energia="Equilibrado" recomplauncher=no
+//   [opciones] efectivas: pantalla=ventana ... gs=cpu* ... (*=por variable de entorno)
+// La linea "compilacion:" es la del vigilante (ps2_vigilante.h, identidadCompilacion): con ella se encuentra el PDB.
+namespace ps2x::cabecera
+{
+    // La version del paquete (scripts/paquete/version.txt del proyecto, tambien la de scripts/empaquetar.ps1) y el
+    // commit de git (hash corto, "-dirty" con cambios sin confirmar) con que se compilo; "desconocida" / "desconocido"
+    // si CMake no los encontro. Solo ps2_version.cpp recibe esos defines (cambiarlos no recompila nada mas).
+    const char *versionPaquete();
+    const char *versionGit();
+
+    // La marca de tiempo del PE (segundos desde 1970, UTC) como 2026-11-19T10:22Z; 0: "desconocida".
+    std::string fechaDeMarca(uint32_t marca);
+
+    // "[version] <paquete> git=<git> compilado=<fecha>"; vacios: desconocida / desconocido / desconocida.
+    std::string lineaVersion(std::string_view paquete, std::string_view git, std::string_view compilado);
+
+    struct Sistema
+    {
+        std::string windows;        // 10.0.26300.7171 (mayor.menor.compilacion.revision); vacio: desconocido
+        std::string cpu;            // nombre del procesador (CPUID); vacio: desconocida
+        unsigned hilos = 0u;        // procesadores logicos; 0: desconocido
+        unsigned nucleos = 0u;      // nucleos fisicos; 0: desconocido
+        unsigned nucleosP = 0u;     // con nucleos de dos clases (P y E): los de rendimiento; si no, 0
+        unsigned nucleosE = 0u;     // y los de eficiencia
+        uint64_t ramBytes = 0u;     // memoria fisica total; 0: desconocida
+        std::string energia;        // nombre del plan de energia activo; vacio: desconocido
+        std::string recomplauncher; // valor de RECOMPLAUNCHER_VERSION; vacio: no
+    };
+
+    // "[sistema] windows=.. cpu=".." hilos=N nucleos=N[(PP+EE)] ram=N.NGB energia=".." recomplauncher=.."
+    std::string lineaSistema(const Sistema &sistema);
+
+    // "[opciones] efectivas: clave=valor ..." en el orden de optionSpecs() (ps2_options.h), solo las claves que esten
+    // en valores; las de forzadas (puestas por una variable de entorno) llevan '*' y la linea acaba en
+    // " (*=por variable de entorno)". Un valor vacio o con espacios va entre comillas.
+    std::string lineaOpciones(const std::map<std::string, std::string> &valores,
+                              const std::map<std::string, std::string> &forzadas);
+
+    // Lo que hay en este PC (Windows; en otros sistemas, todo desconocido salvo recomplauncher). No lanza.
+    Sistema leerSistema();
+
+    // Escribe la cabecera en out: version, compilacion, sistema y, si applyOptionsFile ya ha corrido, las opciones
+    // efectivas (startupOptions(): el archivo, el modo y las forzadas por variable). Nunca lanza: lo que falle sale
+    // como "[cabecera] error: ..." y el arranque sigue.
+    void escribir(std::ostream &out);
+}
