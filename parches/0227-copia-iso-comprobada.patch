+            fs::create_directories(good);
+            t.IsTrue(ps2x::disc::extractDisc(report, good, nullptr).status == ExtractStatus::Done,
+                     "the right table copies");
+            report.expected[1].crc32 ^= 1u; // DATA/SUB/B.TXT
+            const fs::path parent = dir.path / "juego";
+            fs::create_directories(parent);
+            const ExtractResult result = ps2x::disc::extractDisc(report, parent, nullptr);
+            t.IsTrue(result.status == ExtractStatus::ReadFailed, "read failure: " + result.detail);
+            t.IsTrue(contains(result.detail, "DATA/SUB/B.TXT no sale bien tras 3 intentos"), "names it: " + result.detail);
+            t.IsTrue(contains(result.detail, "la ISO puede estar"), "says the disc is the problem: " + result.detail);
+            t.Equals(result.log.size(), size_t{3u}, "three logged attempts");
+            t.IsTrue(fs::is_empty(parent), "nothing left");
+        });
+
+        tc.Run("repair with a reference table re-copies only the damaged file and notes it in the marker", [](TestCase &t)
+        {
+            TempDir dir;
+            DiscReport report = ps2x::disc::inspectDisc(writeDisc(dir, kGameCnf));
+            report.expected = syntheticTable();
+            const fs::path parent = dir.path / "juego";
+            fs::create_directories(parent);
+            t.IsTrue(ps2x::disc::extractDisc(report, parent, nullptr).status == ExtractStatus::Done, "extracted");
+            const fs::path data = parent / "data";
+            t.IsTrue(ps2x::disc::dataFolderRepairs(data).empty(), "no repairs yet");
+            zeroSome(data / "DATA" / "A.BIN");
+            const auto old = fs::last_write_time(data / "SYSTEM.CNF") - std::chrono::hours(1);
+            for (const char *name : {"SYSTEM.CNF", "SCES_539.50", "DATA/SUB/B.TXT"})
+                fs::last_write_time(data / name, old);
+            // The disc is not read for the good files: a table says what they hold.
+            std::vector<std::string> copied;
+            ExtractResult result;
+            {
+                ScopedCopyHook hook([&](const fs::path &, const std::string &discPath, int) { copied.push_back(discPath); });
+                result = ps2x::disc::repairDataFolder(report, data, nullptr);
+            }
+            t.IsTrue(result.status == ExtractStatus::AlreadyThere, "repaired: " + result.detail);
+            t.Equals(result.repaired, std::vector<std::string>{"DATA/A.BIN"}, "only A.BIN");
+            t.Equals(copied, std::vector<std::string>{"DATA/A.BIN"}, "only A.BIN copied");
+            t.Equals(readBytes(data / "DATA" / "A.BIN"), pattern(kBinSize, 2u), "A.BIN good again");
+            for (const char *name : {"SYSTEM.CNF", "SCES_539.50", "DATA/SUB/B.TXT"})
+                t.IsTrue(fs::last_write_time(data / name) == old, std::string("untouched: ") + name);
+            t.IsFalse(fs::exists(data / "DATA" / "A.BIN.reparando"), "no temporary file left");
+            const std::vector<std::string> repairs = ps2x::disc::dataFolderRepairs(data);
+            t.Equals(repairs.size(), size_t{1u}, "one repair noted");
+            t.IsTrue(!repairs.empty() && repairs[0].size() > 17u && repairs[0].substr(16) == " DATA/A.BIN",
+                     "date, time and path: " + (repairs.empty() ? std::string() : repairs[0]));
+            t.IsTrue(ps2x::disc::checkDataFolder(data) == DataState::Complete, "the marker still works");
+            t.Equals(ps2x::disc::dataFolderFingerprint(data), report.fingerprint, "same fingerprint");
+
+            const ExtractResult again = ps2x::disc::repairDataFolder(report, data, nullptr);
+            t.IsTrue(again.status == ExtractStatus::AlreadyThere && again.repaired.empty(), "nothing more to repair");
+            t.Equals(ps2x::disc::dataFolderRepairs(data).size(), size_t{1u}, "the note is kept, not repeated");
+        });
+
+        tc.Run("repair whose copy keeps failing leaves the damaged file and fails with exit code 3", [](TestCase &t)
+        {
+            TempDir dir;
+            const fs::path iso = writeDisc(dir, kGameCnf);
+            const fs::path exe = dir.path / "F1-06";
+            writeText(exe / "portable.txt", "x");
+            std::ostringstream out;
+            t.Equals(ps2x::disc::runDiscCommand({"--extraer-iso", iso.string()}, exe, {}, out, nullptr, true), 0,
+                     "extracted");
+            const fs::path bin = exe / "data" / "DATA" / "A.BIN";
+            zeroSome(bin);
+            const std::vector<uint8_t> damaged = readBytes(bin);
+            out.str("");
+            int result = 0;
+            {
+                ScopedCopyHook hook([](const fs::path &written, const std::string &, int) { zeroSome(written); });
+                result = ps2x::disc::runDiscCommand({"--reparar-iso", iso.string()}, exe, {}, out, nullptr, true);
+            }
+            t.Equals(result, 3, "exit code 3: " + out.str());
+            t.IsTrue(contains(out.str(), "[disco] No se pudo reparar la carpeta data: DATA/A.BIN no sale bien"),
+                     "names it: " + out.str());
+            t.Equals(readBytes(bin), damaged, "the damaged file stays as it was");
+            t.IsFalse(fs::exists(exe / "data" / "DATA" / "A.BIN.reparando"), "no temporary file left");
+            t.IsTrue(ps2x::disc::dataFolderRepairs(exe / "data").empty(), "nothing noted as repaired");
+
+            out.str("");
+            t.Equals(ps2x::disc::runDiscCommand({"--extraer-iso", iso.string()}, exe, {}, out, nullptr, true), 0,
+                     "without the fault --extraer-iso repairs it: " + out.str());
+            t.Equals(readBytes(bin), pattern(kBinSize, 2u), "good again");
+            t.IsTrue(contains(out.str(), "progress 0 Checking the game data (0 of 0 MB)"),
+                     "RecompLauncher sees a check: " + out.str());
+            t.Equals(ps2x::disc::dataFolderRepairs(exe / "data").size(), size_t{1u}, "noted");
+        });
     });
