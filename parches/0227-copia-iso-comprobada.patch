+        // A file written and then flushed to the drive before it is closed: FlushFileBuffers / fsync, each result
+        // checked (copia-iso S1: an ofstream's close never says whether the data reached the disk).
+        class SyncedWriter
+        {
+        public:
+            SyncedWriter() = default;
+            SyncedWriter(const SyncedWriter &) = delete;
+            SyncedWriter &operator=(const SyncedWriter &) = delete;
+            ~SyncedWriter() { close(); }
+
+            bool open(const fs::path &path)
+            {
+#if defined(_WIN32)
+                handle_ = CreateFileW(path.c_str(), GENERIC_WRITE, 0u, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL,
+                                      nullptr);
+                if (handle_ == INVALID_HANDLE_VALUE)
+                    return failed("CreateFile");
+#else
+                fd_ = ::open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+                if (fd_ < 0)
+                    return failed("open");
+#endif
+                return true;
+            }
+
+            bool write(const char *data, size_t size)
+            {
+                while (size != 0u)
+                {
+#if defined(_WIN32)
+                    DWORD written = 0u;
+                    const DWORD chunk = static_cast<DWORD>(std::min<size_t>(size, 1u << 30u));
+                    if (!WriteFile(handle_, data, chunk, &written, nullptr) || written == 0u)
+                        return failed("WriteFile");
+#else
+                    const ssize_t written = ::write(fd_, data, size);
+                    if (written < 0 && errno == EINTR)
+                        continue;
+                    if (written <= 0)
+                        return failed("write");
+#endif
+                    data += written;
+                    size -= static_cast<size_t>(written);
+                }
+                return true;
+            }
+
+            // Flushes and closes; false if either fails.
+            bool finish()
+            {
+#if defined(_WIN32)
+                const bool flushed = FlushFileBuffers(handle_) != 0 || failed("FlushFileBuffers");
+                const bool closed = CloseHandle(handle_) != 0 || failed("CloseHandle");
+                handle_ = INVALID_HANDLE_VALUE;
+#else
+                const bool flushed = ::fsync(fd_) == 0 || failed("fsync");
+                const bool closed = ::close(fd_) == 0 || failed("close");
+                fd_ = -1;
+#endif
+                return flushed && closed;
+            }
+
+            const std::string &error() const { return error_; }
+
+        private:
+            void close()
+            {
+#if defined(_WIN32)
+                if (handle_ != INVALID_HANDLE_VALUE)
+                    CloseHandle(handle_);
+                handle_ = INVALID_HANDLE_VALUE;
