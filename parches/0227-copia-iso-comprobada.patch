+                    return {};
+                }
+                if (discWrong)
+                    last = "el disco da CRC32 " + hex32(readCrc) + " y el volcado " + kGameCode + " v1.01 tiene " +
+                           hex32(*expected) + " (la ISO puede estar dañada)";
+                else if (!readBack)
+                    last = "no se puede volver a leer " + pathForLog(target);
+                else
+                    last = "la copia se lee con CRC32 " + hex32(backCrc) + " (" + std::to_string(backSize) +
+                           " bytes) y del disco salió " + hex32(readCrc) + " (" + std::to_string(file.size) + " bytes)";
+                log.push_back(file.path + ": copia mal (intento " + std::to_string(attempt) + " de " +
+                              std::to_string(kCopyAttempts) + "): " + last);
+            }
