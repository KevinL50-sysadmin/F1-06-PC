+    uint32_t crc32Update(uint32_t crc, const void *data, size_t size)
+    {
+        const auto &t = crcTables();
+        const auto *bytes = static_cast<const uint8_t *>(data);
+        uint32_t c = ~crc;
+        for (; size >= 8u; size -= 8u, bytes += 8u)
+        {
+            const uint32_t low = c ^ (static_cast<uint32_t>(bytes[0]) | (static_cast<uint32_t>(bytes[1]) << 8u) |
+                                      (static_cast<uint32_t>(bytes[2]) << 16u) | (static_cast<uint32_t>(bytes[3]) << 24u));
+            c = t[7][low & 0xFFu] ^ t[6][(low >> 8u) & 0xFFu] ^ t[5][(low >> 16u) & 0xFFu] ^ t[4][low >> 24u] ^
+                t[3][bytes[4]] ^ t[2][bytes[5]] ^ t[1][bytes[6]] ^ t[0][bytes[7]];
+        }
+        for (; size != 0u; --size, ++bytes)
+            c = t[0][(c ^ *bytes) & 0xFFu] ^ (c >> 8u);
+        return ~c;
+    }
