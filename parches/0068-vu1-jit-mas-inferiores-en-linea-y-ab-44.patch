+    // eax (reg 0) or ecx (reg 1) = host.readBranchVi(vi): the backup value when it is valid for that register.
+    inline void jitEmitReadBranchVi(JitEmitter &e, const JitHostLayout &h, uint8_t vi, uint8_t reg)
+    {
+        using B = JitEmitter;
+        if (vi == 0u)
+        {
+            e.bytes({0x31, static_cast<uint8_t>(0xC0u | (reg << 3) | reg)}); // xor reg, reg
+            return;
