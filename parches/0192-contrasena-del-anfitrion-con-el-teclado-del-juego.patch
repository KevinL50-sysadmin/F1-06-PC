+
+static_assert(ps2x::kGamePasswordMinSize == ps2x::netplay::kMinHostPasswordSize &&
+                  ps2x::kGamePasswordMaxSize <= ps2x::netplay::kMaxPasswordSize,
+              "the game's keyboard password fits the host's limits");
+
+bool PS2OptionsMenu::setGameNetplayPassword(const std::string &password)
+{
+    std::lock_guard<std::mutex> lock(g_modelMutex);
+    if (g_gameMenu == nullptr || netplayHostingWanted() || !ps2x::gamePasswordValid(password))
+        return false;
+    State &s = *g_gameMenu->m_state;
+    ensureNetplayPassword(s);
+    std::snprintf(s.netplayPassword, sizeof(s.netplayPassword), "%s", password.c_str());
+    std::cout << "[red] contrasena desde el juego: "
+              << (password.empty() ? std::string("una al azar al empezar")
+                                   : std::to_string(password.size()) + " caracteres")
+              << std::endl;
+    return true;
+}
+
+std::string PS2OptionsMenu::gameNetplayPassword()
+{
+    std::lock_guard<std::mutex> lock(g_modelMutex);
+    const ps2x::netplay::HostSessionStatus status = ps2x::netplay::hostSession().status();
+    if (status.hosting)
+        return status.password;
+    if (g_gameMenu == nullptr)
+        return std::string();
+    State &s = *g_gameMenu->m_state;
+    ensureNetplayPassword(s);
+    return s.netplayPassword;
+}
