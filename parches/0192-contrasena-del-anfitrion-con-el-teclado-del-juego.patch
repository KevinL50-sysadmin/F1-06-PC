+    // Nativizacion T16: the host's password typed on the game's own keyboard (OPTIONS > PC NETPLAY, PASSWORD). The
+    // page's Lua sends it one character code at a time (begin, add each code, finish), so no piece of it is left in
+    // the game's Lua heap as a key string. It is taken whole or not at all: printable ASCII, and empty (a new random
+    // one when the host starts, as in the F2 menu) or kGamePasswordMinSize to kGamePasswordMaxSize characters.
+    // finish (and begin) wipe the characters received.
+    constexpr size_t kGamePasswordMinSize = 8;  // ps2x::netplay::kMinHostPasswordSize
+    constexpr size_t kGamePasswordMaxSize = 32; // the keyboard's charLimit
+    inline bool gamePasswordValid(std::string_view password)
+    {
+        if (!password.empty() && (password.size() < kGamePasswordMinSize || password.size() > kGamePasswordMaxSize))
+            return false;
+        for (const char c : password)
+            if (c < 0x20 || c >= 0x7F)
+                return false;
+        return true;
+    }
+
+    class GamePasswordEntry
+    {
+    public:
+        ~GamePasswordEntry()
+        {
+            wipe();
+        }
+        void begin()
+        {
+            wipe();
+            m_open = true;
+        }
+        // code: a character code as the Lua number it came in; false (and the whole password refused) for anything
+        // but printable ASCII, past kGamePasswordMaxSize, or without begin.
+        bool add(float code)
+        {
+            if (!m_open)
+                return false;
+            if (!(code >= 32.0f && code <= 126.0f) || code != std::floor(code) || m_size >= m_chars.size())
+            {
+                m_refused = true;
+                return false;
+            }
+            m_chars[m_size++] = static_cast<char>(code);
+            return true;
+        }
+        // The password received, if it can be taken; false otherwise (password left as it was).
+        bool finish(std::string &password)
+        {
+            const bool taken = m_open && !m_refused && gamePasswordValid(std::string_view(m_chars.data(), m_size));
+            if (taken)
+                password.assign(m_chars.data(), m_size);
+            wipe();
+            return taken;
+        }
+        size_t size() const
+        {
+            return m_size;
+        }
+
+    private:
+        void wipe()
+        {
+            volatile char *chars = m_chars.data(); // volatile: the compiler may not drop it
+            for (size_t i = 0; i < m_chars.size(); ++i)
+                chars[i] = '\0';
+            m_size = 0u;
+            m_open = false;
+            m_refused = false;
+        }
+
+        std::array<char, kGamePasswordMaxSize> m_chars{};
+        size_t m_size = 0u;
+        bool m_open = false;
+        bool m_refused = false;
+    };
+
