+    // T4 (patch 0175): the game's force effects on the PC wheel. The 0x3C-byte effect of DownloadForceEffect and
+    // UpdateForceEffect (analisis/volante-liblgdev.md section 4): +0x00 u8 type, +0x04 duration in ms (0xFFFFFFFF =
+    // infinite), +0x08 0; type 0 constant (+0x0C magnitude +-255, +0x10 direction in degrees, envelope +0x14 attack
+    // time, +0x18 attack level, +0x1C fade time, +0x20 fade level); 1 ramp (+0x0C start, +0x10 end, +0x14 direction);
+    // 2 sine, 3 square, 4 triangle, 5 sawtooth up, 6 sawtooth down (+0x0C magnitude 0..255, +0x10 direction, +0x14
+    // period in ms (16 at least), +0x18 phase in degrees, +0x1C offset +-127, envelope at +0x20..+0x2C); 7 spring and
+    // 8 damper (+0x0C offset +-32767 in steering units, +0x10 dead band 0..65536, +0x14/+0x18 positive/negative
+    // saturation 0..255, +0x1C/+0x20 positive/negative coefficient +-255).
+    constexpr size_t kEffectSize = 0x3Cu;
+    constexpr uint32_t kInfinite = 0xFFFFFFFFu; // DirectInput's INFINITE
+    constexpr int32_t kForceMax = 10000;        // DI_FFNOMINALMAX
+
+    enum class ForceKind : uint8_t
+    {
+        None, Constant, Ramp, Sine, Square, Triangle, SawtoothUp, SawtoothDown, Spring, Damper
+    };
+
+    // An effect as DirectInput plays it on the steering axis alone (X): forces in -10000..10000, times in us, the phase
+    // in hundredths of a degree. The direction of the game's effect becomes the sign of the force on that axis (its
+    // sine: 90 = all of it towards +X, -90 towards -X, 0 none).
+    struct ForceParams
+    {
+        ForceKind kind = ForceKind::None;
+        uint32_t durationUs = kInfinite;
+        int32_t magnitude = 0; // constant: signed; periodic: 0..10000
+        int32_t rampStart = 0, rampEnd = 0;
+        int32_t offset = 0; // periodic or condition offset
+        uint32_t periodUs = 0, phase = 0;
+        int32_t positiveCoefficient = 0, negativeCoefficient = 0;
+        uint32_t positiveSaturation = 0, negativeSaturation = 0, deadBand = 0;
+        bool envelope = false;
+        uint32_t attackLevel = 0, attackTimeUs = 0, fadeLevel = 0, fadeTimeUs = 0;
+
+        bool operator==(const ForceParams &o) const
+        {
+            return kind == o.kind && durationUs == o.durationUs && magnitude == o.magnitude &&
+                   rampStart == o.rampStart && rampEnd == o.rampEnd && offset == o.offset && periodUs == o.periodUs &&
+                   phase == o.phase && positiveCoefficient == o.positiveCoefficient &&
+                   negativeCoefficient == o.negativeCoefficient && positiveSaturation == o.positiveSaturation &&
+                   negativeSaturation == o.negativeSaturation && deadBand == o.deadBand && envelope == o.envelope &&
+                   attackLevel == o.attackLevel && attackTimeUs == o.attackTimeUs && fadeLevel == o.fadeLevel &&
+                   fadeTimeUs == o.fadeTimeUs;
+        }
+        bool operator!=(const ForceParams &o) const { return !(*this == o); }
+    };
+
+    inline int32_t effectWord(const uint8_t *effect, size_t offset)
+    {
+        int32_t v = 0;
+        std::memcpy(&v, effect + offset, 4);
+        return v;
+    }
+
+    // v of full (clamped to +-full, or 0..full) as -10000..10000.
+    inline int32_t forceScale(double v, double full)
+    {
+        return static_cast<int32_t>(std::lround(std::clamp(v / full, -1.0, 1.0) * kForceMax));
+    }
+
+    inline uint32_t millisToMicros(int32_t ms)
+    {
+        return static_cast<uint32_t>(std::clamp<int64_t>(ms, 0, 4294967)) * 1000u;
+    }
+
+    // The share of a force on the steering axis: the sine of its direction (degrees), as the IRX's split into two
+    // axes (0x6510, the first one).
+    inline double axisShare(int32_t degrees)
+    {
+        const int32_t d = ((degrees % 360) + 360) % 360;
+        if (d == 0 || d == 180)
+            return 0.0;
+        if (d == 90)
+            return 1.0;
+        if (d == 270)
+            return -1.0;
+        return std::sin(static_cast<double>(d) * 3.14159265358979323846 / 180.0);
+    }
+
+    inline void effectEnvelope(const uint8_t *effect, size_t at, ForceParams &p)
+    {
+        const int32_t attackTime = effectWord(effect, at), fadeTime = effectWord(effect, at + 8);
+        if (attackTime <= 0 && fadeTime <= 0)
+            return;
+        p.envelope = true;
+        p.attackTimeUs = millisToMicros(attackTime);
+        p.attackLevel = static_cast<uint32_t>(forceScale(std::clamp(effectWord(effect, at + 4), 0, 255), 255.0));
+        p.fadeTimeUs = millisToMicros(fadeTime);
+        p.fadeLevel = static_cast<uint32_t>(forceScale(std::clamp(effectWord(effect, at + 12), 0, 255), 255.0));
+    }
+
+    // invert (F1_VOLANTE_INVERTIR_FUERZA=1): the forces the other way (constant, ramp and periodic; the spring and the
+    // damper act around a position and keep their sign).
+    inline ForceParams translateEffect(const uint8_t *effect, bool invert = false)
+    {
+        ForceParams p;
+        const uint8_t type = effect[0];
+        const uint32_t duration = static_cast<uint32_t>(effectWord(effect, 0x04));
+        p.durationUs = duration == 0xFFFFFFFFu ? kInfinite : millisToMicros(static_cast<int32_t>(
+                                                                 std::min<uint32_t>(duration, 0x7FFFFFFFu)));
+        const double sign = invert ? -1.0 : 1.0;
+        if (type == 0u)
+        {
+            p.kind = ForceKind::Constant;
+            const double magnitude = std::clamp(effectWord(effect, 0x0C), -255, 255);
+            p.magnitude = forceScale(sign * magnitude * axisShare(effectWord(effect, 0x10)), 255.0);
+            effectEnvelope(effect, 0x14, p);
+        }
+        else if (type == 1u)
+        {
+            p.kind = ForceKind::Ramp;
+            const double share = sign * axisShare(effectWord(effect, 0x14));
+            p.rampStart = forceScale(std::clamp(effectWord(effect, 0x0C), -255, 255) * share, 255.0);
+            p.rampEnd = forceScale(std::clamp(effectWord(effect, 0x10), -255, 255) * share, 255.0);
+        }
+        else if (type >= 2u && type <= 6u)
+        {
+            const ForceKind waves[5] = {ForceKind::Sine, ForceKind::Square, ForceKind::Triangle, ForceKind::SawtoothUp,
+                                        ForceKind::SawtoothDown};
+            p.kind = waves[type - 2u];
+            const double share = sign * axisShare(effectWord(effect, 0x10));
+            const double magnitude = std::clamp(effectWord(effect, 0x0C), 0, 255);
+            p.magnitude = forceScale(magnitude * std::fabs(share), 255.0);
+            p.offset = forceScale(std::clamp(effectWord(effect, 0x1C), -127, 127) * share, 255.0);
+            p.periodUs = millisToMicros(std::max(effectWord(effect, 0x14), 16));
+            const int32_t phase = ((effectWord(effect, 0x18) % 360) + 360) % 360;
+            p.phase = static_cast<uint32_t>((phase * 100 + (share < 0.0 ? 18000 : 0)) % 36000);
+            effectEnvelope(effect, 0x20, p);
+        }
+        else if (type == 7u || type == 8u)
+        {
+            p.kind = type == 7u ? ForceKind::Spring : ForceKind::Damper;
+            p.offset = forceScale(effectWord(effect, 0x0C), 32767.0);
+            const int32_t band = std::clamp(effectWord(effect, 0x10), 0, 0x10000);
+            p.deadBand = static_cast<uint32_t>(forceScale(band / 2, 32767.0));
+            p.positiveSaturation = static_cast<uint32_t>(forceScale(std::clamp(effectWord(effect, 0x14), 0, 255), 255.0));
+            p.negativeSaturation = static_cast<uint32_t>(forceScale(std::clamp(effectWord(effect, 0x18), 0, 255), 255.0));
+            p.positiveCoefficient = forceScale(effectWord(effect, 0x1C), 255.0);
+            p.negativeCoefficient = forceScale(effectWord(effect, 0x20), 255.0);
+        }
+        return p;
+    }
+
+    // The diagnostic text of an effect (F1_VOLANTE_DIAG=1): its type and fields as the game wrote them.
+    inline std::string describeEffect(const uint8_t *effect)
+    {
+        static const char *const kNames[9] = {"constante", "rampa",  "seno",   "cuadrada", "triangulo",
+                                              "sierra+",   "sierra-", "muelle", "amortiguador"};
+        const uint8_t type = effect[0];
+        auto w = [effect](size_t offset) { return static_cast<long>(effectWord(effect, offset)); };
+        char text[256];
+        if (type == 0u)
+            std::snprintf(text, sizeof(text), "constante magnitud=%ld direccion=%ld", w(0x0C), w(0x10));
+        else if (type == 1u)
+            std::snprintf(text, sizeof(text), "rampa inicio=%ld fin=%ld direccion=%ld", w(0x0C), w(0x10), w(0x14));
+        else if (type <= 6u)
+            std::snprintf(text, sizeof(text), "%s magnitud=%ld direccion=%ld periodo=%ld fase=%ld desplazamiento=%ld",
+                          kNames[type], w(0x0C), w(0x10), w(0x14), w(0x18), w(0x1C));
+        else if (type <= 8u)
+            std::snprintf(text, sizeof(text), "%s centro=%ld zona=%ld saturacion=%ld/%ld coeficiente=%ld/%ld",
+                          kNames[type], w(0x0C), w(0x10), w(0x14), w(0x18), w(0x1C), w(0x20));
+        else
+            std::snprintf(text, sizeof(text), "tipo %u desconocido", static_cast<unsigned>(type));
+        std::string out = text;
+        const uint32_t duration = static_cast<uint32_t>(effectWord(effect, 0x04));
+        out += duration == 0xFFFFFFFFu ? " duracion=inf" : " duracion=" + std::to_string(duration);
+        return out;
+    }
+
+    // The gain of every effect (0..10000): the game's (property 3, 0..255) times opciones.ini vibracion (0-100 %);
+    // 0 with controles.ini vibracion = 0 (enabled false), as the wheel rumble of patch 0107.
+    inline uint32_t forceGain(uint32_t gameGain, bool enabled, int percent)
+    {
+        if (!enabled)
+            return 0u;
+        const double gain = std::min(gameGain, 255u) / 255.0 * std::clamp(percent, 0, 100) / 100.0;
+        return static_cast<uint32_t>(std::lround(gain * kForceMax));
+    }
+
+    // Patch 0107: the DualShock 2 motors as a vibration of the wheel (0..10000, the large motor and half the small).
+    // With the native wheel the game drives the wheel's force itself: 0 (no second effect on the wheel).
+    inline int wheelRumble(float smallMotor, float largeMotor, bool nativeWheel)
+    {
+        if (nativeWheel)
+            return 0;
+        return static_cast<int>(std::clamp(std::max(largeMotor, smallMotor * 0.5f), 0.0f, 1.0f) * 10000.0f);
+    }
+
+    // One effect of the game on the host: its id, the DirectInput parameters, whether it plays and how many times the
+    // game started it (a start of a playing effect restarts it).
+    struct NativeForce
+    {
+        uint32_t id = 0u;
+        ForceParams params;
+        bool playing = false;
+        uint32_t starts = 0u;
+    };
+
+    // What the wheel must do now: the effects, the game's gain (property 3) and the wheel's own centring spring
+    // (property 2; on while the device is closed).
+    struct ForceState
+    {
+        std::vector<NativeForce> effects;
+        uint32_t gain = 255u;
+        bool autocenter = true;
+    };
+
+    // From the game's thread (publish) to the thread that drives the wheel (take): take gives the state when it changed
+    // since the version the caller saw.
+    class ForceBoard
+    {
+    public:
+        void publish(const ForceState &state)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_state = state;
+            ++m_version;
+        }
+
+        bool take(ForceState &out, uint32_t &seen)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (seen == m_version)
+                return false;
+            out = m_state;
+            seen = m_version;
+            return true;
+        }
+
+    private:
+        std::mutex m_mutex;
+        ForceState m_state;
+        uint32_t m_version = 0u;
+    };
+
+    inline ForceBoard &forceBoard()
+    {
+        static ForceBoard board;
+        return board;
+    }
