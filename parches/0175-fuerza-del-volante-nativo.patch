+                constant.lMagnitude = p.magnitude;
+                effect.cbTypeSpecificParams = sizeof(constant);
+                effect.lpvTypeSpecificParams = &constant;
+                break;
+            case ForceKind::Ramp:
+                ramp.lStart = p.rampStart;
+                ramp.lEnd = p.rampEnd;
+                effect.cbTypeSpecificParams = sizeof(ramp);
+                effect.lpvTypeSpecificParams = &ramp;
+                break;
+            case ForceKind::Spring:
+            case ForceKind::Damper:
+                condition.lOffset = p.offset;
+                condition.lPositiveCoefficient = p.positiveCoefficient;
+                condition.lNegativeCoefficient = p.negativeCoefficient;
+                condition.dwPositiveSaturation = p.positiveSaturation;
+                condition.dwNegativeSaturation = p.negativeSaturation;
+                condition.lDeadBand = static_cast<LONG>(p.deadBand);
+                effect.cbTypeSpecificParams = sizeof(condition);
+                effect.lpvTypeSpecificParams = &condition;
+                break;
+            default:
+                periodic.dwMagnitude = static_cast<DWORD>(std::max(p.magnitude, 0));
+                periodic.lOffset = p.offset;
+                periodic.dwPhase = p.phase;
+                periodic.dwPeriod = p.periodUs;
+                effect.cbTypeSpecificParams = sizeof(periodic);
+                effect.lpvTypeSpecificParams = &periodic;
+                break;
+            }
+        }
+    };
+
+    void releaseNativeEffect(NativeEffect &e)
+    {
+        if (e.effect)
+        {
+            e.effect->Stop();
+            e.effect->Unload();
+            e.effect->Release();
+            e.effect = nullptr;
+        }
+    }
+
+    // Propiedad 2 del juego: el muelle de centrado propio del volante (DIPROP_AUTOCENTER). Hay controladores que solo
+    // la aceptan sin adquirir: entonces se suelta el volante, se cambia y se vuelven a cargar los efectos.
+    void setAutocenter(bool on)
+    {
+        DIPROPDWORD prop{};
+        prop.diph.dwSize = sizeof(prop);
+        prop.diph.dwHeaderSize = sizeof(prop.diph);
+        prop.diph.dwHow = DIPH_DEVICE;
+        prop.dwData = on ? DIPROPAUTOCENTER_ON : DIPROPAUTOCENTER_OFF;
+        HRESULT hr = g_wheel->SetProperty(DIPROP_AUTOCENTER, &prop.diph);
+        if (hr == DIERR_ACQUIRED)
+        {
+            g_wheel->Unacquire();
+            hr = g_wheel->SetProperty(DIPROP_AUTOCENTER, &prop.diph);
+            g_wheel->Acquire();
+            for (NativeEffect &e : g_nativeEffects)
+                if (e.effect)
+                {
+                    e.effect->Download();
+                    if (e.playing)
+                        e.effect->Start(1, 0);
+                }
+        }
+        if (g_forceDiag)
+            std::fprintf(stderr, "[volante] centrado propio del volante: %s%s\n", on ? "si" : "no",
+                         SUCCEEDED(hr) ? "" : " (no se pudo cambiar)");
+    }
+
+    // Los efectos del juego en el volante: crea, cambia, arranca, para y quita los de DirectInput para que coincidan con
+    // los del juego, con su ganancia por la de opciones.ini (vibracion) y controles.ini (vibracion = 0: ninguna).
+    void applyNativeForces()
+    {
+        std::unique_lock<std::timed_mutex> lock(g_forceMutex, std::try_to_lock);
+        if (!lock.owns_lock() || g_forcesStopped.load(std::memory_order_relaxed))
+            return;
+        const bool changed = ps2x::lgdev::forceBoard().take(g_nativeState, g_nativeSeen);
+        const uint32_t gain = ps2x::lgdev::forceGain(g_nativeState.gain, g_rumbleEnabled.load(std::memory_order_relaxed),
+                                                     ps2x::rumbleIntensity());
+        const bool gainChanged = gain != g_nativeGain;
+        if (!changed && !gainChanged)
+            return;
+        g_nativeGain = gain;
+        const ps2x::lgdev::ForceState &state = g_nativeState;
+        // Los que el juego ya no tiene, o que cambian de tipo.
+        for (auto it = g_nativeEffects.begin(); it != g_nativeEffects.end();)
+        {
+            const auto wanted = std::find_if(state.effects.begin(), state.effects.end(),
+                                             [&](const ps2x::lgdev::NativeForce &f) { return f.id == it->id; });
+            if (wanted == state.effects.end() || wanted->params.kind != it->params.kind)
+            {
+                releaseNativeEffect(*it);
+                it = g_nativeEffects.erase(it);
+            }
+            else
+                ++it;
+        }
+        for (const ps2x::lgdev::NativeForce &f : state.effects)
+        {
+            if (f.params.kind == ps2x::lgdev::ForceKind::None)
+                continue;
+            auto it = std::find_if(g_nativeEffects.begin(), g_nativeEffects.end(),
+                                   [&](const NativeEffect &e) { return e.id == f.id; });
+            if (it == g_nativeEffects.end())
+            {
+                EffectData data(f.params, gain);
+                NativeEffect e;
+                e.id = f.id;
+                e.params = f.params;
+                const HRESULT hr = g_wheel->CreateEffect(forceGuid(f.params.kind), &data.effect, &e.effect, nullptr);
+                if (FAILED(hr))
+                {
+                    std::fprintf(stderr, "[volante] no se pudo crear el efecto 0x%x en el volante (0x%08lx)\n",
+                                 static_cast<unsigned>(f.id), static_cast<unsigned long>(hr));
+                    continue;
+                }
+                g_nativeEffects.push_back(e);
+                it = g_nativeEffects.end() - 1;
+            }
+            else if (it->params != f.params || gainChanged)
+            {
+                EffectData data(f.params, gain);
+                const bool condition = f.params.kind == ps2x::lgdev::ForceKind::Spring ||
+                                       f.params.kind == ps2x::lgdev::ForceKind::Damper;
+                it->effect->SetParameters(&data.effect, DIEP_DURATION | DIEP_GAIN | DIEP_TYPESPECIFICPARAMS |
+                                                            (condition ? 0u : static_cast<DWORD>(DIEP_ENVELOPE)));
+                it->params = f.params;
+            }
+            if (f.playing && (!it->playing || f.starts != it->starts))
+                it->effect->Start(1, 0);
+            else if (!f.playing && it->playing)
+                it->effect->Stop();
+            it->playing = f.playing;
+            it->starts = f.starts;
+        }
+        if (static_cast<int>(state.autocenter) != g_autocenterApplied)
+        {
+            g_autocenterApplied = state.autocenter ? 1 : 0;
+            setAutocenter(state.autocenter);
+        }
+    }
+
+    // Al salir del juego: ningun efecto se queda sonando en el volante (ni los del juego ni la vibracion del 0107).
+    void stopWheelForces()
+    {
+        std::unique_lock<std::timed_mutex> lock(g_forceMutex, std::defer_lock);
+        (void)lock.try_lock_for(std::chrono::milliseconds(200)); // aunque el lector no lo suelte, se paran igual
+        g_forcesStopped.store(true, std::memory_order_relaxed);
+        if (g_wheel)
+            g_wheel->SendForceFeedbackCommand(DISFFC_STOPALL);
+    }
