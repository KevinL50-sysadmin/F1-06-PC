+    // A 0x3C-byte effect of the game: type, duration (ms, 0xFFFFFFFF infinite) and words at their offsets.
+    using Effect = std::array<uint8_t, ps2x::lgdev::kEffectSize>;
+    Effect gameEffect(uint8_t type, std::initializer_list<std::pair<size_t, int32_t>> fields,
+                      uint32_t duration = 0xFFFFFFFFu)
+    {
+        Effect e{};
+        e[0] = type;
+        std::memcpy(e.data() + 4, &duration, 4);
+        for (const auto &f : fields)
+            std::memcpy(e.data() + f.first, &f.second, 4);
+        return e;
+    }
+
+    // The i-th effect of a state (an empty one if it has fewer).
+    ps2x::lgdev::NativeForce effectAt(const ps2x::lgdev::ForceState &state, size_t i)
+    {
+        return i < state.effects.size() ? state.effects[i] : ps2x::lgdev::NativeForce{};
+    }
